+    assert_eq!(reconciled, completed);
+    assert_eq!(
+        fs::read(path.join("objects/payload.arena")).unwrap(),
+        before
+    );
+    store
+        .retire_release(duty.operation, 30, deadline())
+        .unwrap();
+    for object in &duty.objects {
+        assert!(
+            store
+                .retire_object(object.operation, 30, None, deadline())
+                .unwrap()
+                .retired
+        );
+    }
