+scripts/ci/test_hash_use_contract.py:33:        with tempfile.TemporaryDirectory(prefix=\"hash-use-contract-\") as temporary:\n+scripts/ci/check_pq_research_integration.py:294:    \"scripts/ci/hash_use_contract.py\",\n+scripts/ci/check_pq_research_integration.py:295:    \"scripts/ci/test_hash_use_contract.py\",\n+scripts/ci/check_pq_research_integration.py:296:    \"config/pon/hash-use-contract-v1.json\",\n+scripts/ci/check_pq_research_integration.py:297:    \"docs/security/HASH_USE_CONTRACT_V1.md\",\n+docs/security/CONTENT_GRAPH_AND_HISTORY_READBACK_V1.md:9:The [hash-purpose contract](HASH_USE_CONTRACT_V1.md) distinguishes the protected\n+docs/security/CONTENT_GRAPH_AND_HISTORY_READBACK_V1.md:189:python3 scripts/ci/test_hash_use_contract.py\n+docs/security/CONTENT_GRAPH_AND_HISTORY_READBACK_V1.md:190:python3 scripts/ci/hash_use_contract.py\n+scripts/ci/test_ci_contract.py:3201:        'hash_use_contract': ('repository-truth', '    python3 scripts/ci/pq_authority_surface_scan.py --summary-only\\n', (\n+scripts/ci/test_ci_contract.py:3202:            '    python3 scripts/ci/test_hash_use_contract.py\\n',\n+scripts/ci/test_ci_contract.py:3203:            '    python3 scripts/ci/hash_use_contract.py\\n',\n+scripts/ci/test_ci_contract.py:3317:        self.reject_command_mutations('hash_use_contract')"},{"sha":"62e935ced1a341e8abdc59869315aea1e98e14e5","filename":"evidence/hash-use-current-source-review-20261114/consumer-excerpts/scripts--ci--check_ci_contract.py.excerpt","status":"added","additions":74,"deletions":0,"changes":74,"blob_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/blob/5df7ae6f482157c5f7fdcbcd52222117a965053f/evidence%2Fhash-use-current-source-review-20261114%2Fconsumer-excerpts%2Fscripts--ci--check_ci_contract.py.excerpt","raw_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/raw/5df7ae6f482157c5f7fdcbcd52222117a965053f/evidence%2Fhash-use-current-source-review-20261114%2Fconsumer-excerpts%2Fscripts--ci--check_ci_contract.py.excerpt","contents_url":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/contents/evidence%2Fhash-use-current-source-review-20261114%2Fconsumer-excerpts%2Fscripts--ci--check_ci_contract.py.excerpt?ref=5df7ae6f482157c5f7fdcbcd52222117a965053f","patch":"@@ -0,0 +1,74 @@\n+840:     python3 scripts/ci/test_w1_stark_route_audit.py\n+841:     python3 scripts/w1_stark_route_audit.py\n+842:     # Conditional iid counting does not establish the actual transcript distribution.\n+843:     python3 scripts/ci/test_w1_fri_ideal_sampler.py\n+844:     python3 scripts/w1_fri_query_replay.py --ideal-sampler-law\n+845:     # Current lifetime source observation is separate from historical positive replay.\n+846:     python3 scripts/ci/test_w1_lifetime_current_observation.py\n+847:     python3 scripts/w1_lifetime_current_observation.py\n+848:     python3 scripts/ci/test_w1_qrom_closure_current_controls.py\n+849:     python3 -m unittest discover -s scripts/ci -p 'test_pq_authority_surface_scan.py' -v\n+850:     python3 scripts/ci/pq_authority_surface_scan.py --summary-only\n+851:     python3 scripts/ci/test_hash_use_contract.py\n+852:     python3 scripts/ci/hash_use_contract.py\n+853:     python3 -m unittest discover -s scripts/ci -p 'test_pq_external_rollback_oracle.py' -v\n+854:     python3 -m unittest discover -s scripts/ci -p 'test_pq_quantum_daa_scenarios.py' -v\n+855:     # Public-input framing only: no seed proof or signature qualification.\n+856:     python3 -m unittest discover -s formal/pon-nakamoto-v1 -p 'test_pq_seed_recovery_v1.py' -v\n+857: \n+858:     # Conditional resource/event models retain unknown W1 hardware and protocol gates.\n+859:     python3 -m unittest discover -s formal/pon-nakamoto-v1 -p 'test_work_scale_contract.py' -v\n+860:     python3 -m unittest discover -s formal/pon-nakamoto-v1 -p 'test_fixed_probability_contract.py' -v\n+\n+1650:                 for command in code_lines(NATIVE_GROWTH_RELEASE_BLOCK)),\n+1651:             'native 65537-account growth must execute once in rust-baseline with a fresh export, exact nonempty release test and independent SQLite readback')\n+1652:     require(script.count('TRNM_NATIVE_GROWTH_EXPORT_DIRECTORY') ==\n+1653:             NATIVE_GROWTH_RELEASE_BLOCK.count('TRNM_NATIVE_GROWTH_EXPORT_DIRECTORY'),\n+1654:             'native growth export selector must remain in its one release/readback block')\n+1655:     require(NATIVE_GROWTH_V2_RELEASE_BLOCK in lanes['rust-baseline'] and\n+1656:             all(code_lines(script).count(command) == 1\n+1657:                 for command in code_lines(NATIVE_GROWTH_V2_RELEASE_BLOCK)),\n+1658:             'bounded native growth must execute once in rust-baseline with its fresh export and exact nonempty release test')\n+1659:     require(script.count('TRNM_NATIVE_GROWTH_V2_EXPORT_DIR') ==\n+1660:             NATIVE_GROWTH_V2_RELEASE_BLOCK.count('TRNM_NATIVE_GROWTH_V2_EXPORT_DIR'),\n+1661:             'bounded native growth export selector must remain in its one release block')\n+1662:     require(script.count(RUST_ALL_TARGETS) == 1, 'the full workspace observation suite must execute exactly once')\n+1663:     for selector in ['TRNM_MODEL_COMPOSITION_VECTORS', 'TRNM_MODEL_COMPOSITION_RUN_ID',\n+1664:                      'TRNM_OBLIGATION_RANGE_VECTORS', 'TRNM_ZERO_PAIRED_PREFIX_OUTPUT',\n+1665:                      'TRNM_DAA_EVIDENCE_DIR', 'TRNM_JOINT_DAA_EVIDENCE_DIR',\n+1666:                      'TRNM_MONOTONE_DAA_EVIDENCE_DIR']:\n+1667:         require(script.count(selector) == MODEL_OBSERVATION_BLOCK.count(selector),\n+1668:                 'native observation selectors must remain inside the single test/oracle subshell')\n+1669:     require(script.count(NATIVE_RELEASE_BLOCK) == 1,\n+1670:             'full-capacity, reference-growth, bounded-growth and account-verification release controls must execute once sequentially')\n+1671:     for command in CREDIT_MODEL_COMMANDS:\n+1672:         require(code_lines(lanes['repository-truth']).count(command) == 1\n+1673:                 and code_lines(script).count(command) == 1,\n+1674:                 'credit model controls must execute exactly once in repository-truth')\n+1675:     for command in ('python3 scripts/ci/test_hash_use_contract.py',\n+1676:                     'python3 scripts/ci/hash_use_contract.py'):\n+1677:         require(code_lines(lanes['repository-truth']).count(command) == 1\n+1678:                 and code_lines(script).count(command) == 1,\n+1679:                 'hash-purpose controls must execute exactly once in repository-truth')\n+1680:     for command in ('python3 scripts/ci/test_w1_qrom_current_implementation_audit.py',\n+1681:                     'python3 scripts/w1_qrom_current_implementation_audit.py',\n+1682:                     'python3 scripts/ci/test_w1_qrom_current_ci.py',\n+1683:                     'python3 scripts/ci/test_w1_lifetime_current_observation.py',\n+1684:                     'python3 scripts/w1_lifetime_current_observation.py',\n+1685:                     'python3 scripts/ci/test_w1_qrom_closure_current_controls.py'):\n+1686:         require(code_lines(lanes['repository-truth']).count(command) == 1\n+1687:                 and code_lines(script).count(command) == 1,\n+1688:                 'current W1 source mapping controls must execute exactly once in repository-truth')\n+1689:     for command in ('python3 scripts/ci/test_w1_stark_field_certificates.py',\n+1690:                     'python3 scripts/w1_stark_field_certificates.py',\n+1691:                     'python3 scripts/ci/test_w1_stark_route_audit.py',\n+1692:                     'python3 scripts/w1_stark_route_audit.py',\n+1693:                     'python3 scripts/ci/test_w1_fri_ideal_sampler.py',\n+1694:                     'python3 scripts/w1_fri_query_replay.py --ideal-sampler-law'):\n+1695:         require(code_lines(lanes['repository-truth']).count(command) == 1\n+1696:                 and code_lines(script).count(c