  expected_start:u64 = const() {"value":128}
  expected:u64 = int.add.wrap(expected_start,xi)
  expected_at:usize = int.cast(expected) {"mode":"wrap"}
  actual:u8 = buffer.load(xw,expected_at)
  widen:u64 = int.cast(actual) {"mode":"wrap"}
