  ta_compare_m:usize = select(ta_settle,ta_state_metadata,ta_metadata)
  ta_compare_n:u64 = select(ta_settle,ta_state_n,ta_all)
  ta_same:bool = call(ta_r,ta_m,ta_compare_r,ta_compare_m,ta_compare_n) {"function":"smr_eq_bound"}
  branch ta_same save(ta_r,ta_m,ta_w,ta_row,ta_len) refused()
block save(sv_r:readbuf,sv_m:mutbuf,sv_w:mutbuf,sv_row:u64,sv_len:u64)
  sv_src:u64 = const() {"value":100}
  sv_dst:u64 = const() {"value":354000}
  sv_width:u64 = const() {"value":72}
