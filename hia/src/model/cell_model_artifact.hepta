  b40_v:u8 = buffer.load(b40_r,b40_v_ix)
  b40_one:u64 = const() {"value":1}
  b40_next:u64 = int.add.wrap(b40_a,b40_one)
  b40_future:u64 = int.add.wrap(b40_i,b40_one)
  b40_cols:u64 = const() {"value":257}
  b40_final:bool = compare.eq(b40_future,b40_cols)
  branch b40_final close(b40_v,b40_next) comma_check(b40_r,b40_next,b40_n,b40_future,b40_v)
block comma_check(b41_r:readbuf,b41_a:u64,b41_n:u64,b41_i:u64,b41_v:u8)
  b41_comma:u8 = const() {"value":44}
  b41_ok:bool = compare.eq(b41_v,b41_comma)
  branch b41_ok columns(b41_r,b41_a,b41_n,b41_i) bad()
block close(b42_v:u8,b42_a:u64)
  b42_close:u8 = const() {"value":93}
  b42_ok:bool = compare.eq(b42_v,b42_close)
  b42_z:u64 = const() {"value":0}
  b42_result:u64 = select(b42_ok,b42_a,b42_z)
  ret(b42_result)
block bad()
  b43_z:u64 = const() {"value":0}
  ret(b43_z)
end

fn cell_number(b44_r:readbuf,b44_a:u64,b44_n:u64) -> (u64) effects(read,trap) entry(entry)
block entry(b44_r:readbuf,b44_a:u64,b44_n:u64)
  b44_fit:bool = compare.lt(b44_a,b44_n)
  branch b44_fit sign(b44_r,b44_a,b44_n) bad()
block sign(b45_r:readbuf,b45_a:u64,b45_n:u64)
  b45_v_ix:usize = int.cast(b45_a) {"mode":"wrap"}
  b45_v:u8 = buffer.load(b45_r,b45_v_ix)
  b45_minus:u8 = const() {"value":45}
  b45_neg:bool = compare.eq(b45_v,b45_minus)
  b45_one:u64 = const() {"value":1}
  b45_next:u64 = int.add.wrap(b45_a,b45_one)
  b45_has:bool = compare.lt(b45_next,b45_n)
  branch b45_neg negative_gate(b45_r,b45_next,b45_n,b45_has) unsigned(b45_r,b45_a,b45_n,b45_v)
block negative_gate(b46_r:readbuf,b46_a:u64,b46_n:u64,b46_has:bool)
  branch b46_has negative(b46_r,b46_a,b46_n) bad()
block negative(b47_r:readbuf,b47_a:u64,b47_n:u64)
  b47_v_ix:usize = int.cast(b47_a) {"mode":"wrap"}
  b47_v:u8 = buffer.load(b47_r,b47_v_ix)
  b47_z:u8 = const() {"value":48}
  b47_pos:bool = compare.gt(b47_v,b47_z)
  branch b47_pos first(b47_r,b47_a,b47_n,b47_v) bad()
block unsigned(b48_r:readbuf,b48_a:u64,b48_n:u64,b48_v:u8)
  b48_z:u8 = const() {"value":48}
  b48_zero_byte:bool = compare.eq(b48_v,b48_z)
  branch b48_zero_byte single_zero(b48_a) first(b48_r,b48_a,b48_n,b48_v)
block single_zero(b49_a:u64)
  b49_one:u64 = const() {"value":1}
  b49_next:u64 = int.add.wrap(b49_a,b49_one)
  ret(b49_next)
block first(b50_r:readbuf,b50_a:u64,b50_n:u64,b50_v:u8)
  b50_lo:u8 = const() {"value":49}
  b50_hi:u8 = const() {"value":57}
  b50_p:bool = compare.ge(b50_v,b50_lo)
  b50_q:bool = compare.le(b50_v,b50_hi)
  b50_valid:bool = bool.and(b50_p,b50_q)
  b50_one:u64 = const() {"value":1}
  b50_next:u64 = int.add.wrap(b50_a,b50_one)
  b50_val:u64 = int.cast(b50_v) {"mode":"wrap"}
  b50_ascii:u64 = const() {"value":48}
  b50_num:u64 = int.sub.wrap(b50_val,b50_ascii)
  branch b50_valid digits(b50_r,b50_next,b50_n,b50_num) bad()
block digits(b51_r:readbuf,b51_a:u64,b51_n:u64,b51_total:u64)
  b51_fit:bool = compare.lt(b51_a,b51_n)
  branch b51_fit peek(b51_r,b51_a,b51_n,b51_total) bad()
block peek(b52_r:readbuf,b52_a:u64,b52_n:u64,b52_total:u64)
  b52_v_ix:usize = int.cast(b52_a) {"mode":"wrap"}
  b52_v:u8 = buffer.load(b52_r,b52_v_ix)
  b52_lo:u8 = const() {"value":48}
  b52_hi:u8 = const() {"value":57}
  b52_low:bool = compare.ge(b52_v,b52_lo)
  b52_high:bool = compare.le(b52_v,b52_hi)
  b52_digit:bool = bool.and(b52_low,b52_high)
  branch b52_digit accum(b52_r,b52_a,b52_n,b52_total,b52_v) done(b52_a)
block accum(b53_r:readbuf,b53_a:u64,b53_n:u64,b53_total:u64,b53_v:u8)
  b53_ten:u64 = const() {"value":10}
  b53_ascii:u64 = const() {"value":48}
  b53_val:u64 = int.cast(b53_v) {"mode":"wrap"}
  b53_digit:u64 = int.sub.wrap(b53_val,b53_ascii)
  b53_times:u64 = int.mul.wrap(b53_total,b53_ten)
  b53_f:u64 = int.add.wrap(b53_times,b53_digit)
  b53_max:u64 = const() {"value":32767}
  b53_within:bool = compare.le(b53_f,b53_max)
  b53_one:u64 = const() {"value":1}
  b53_next:u64 = int.add.wrap(b53_a,b53_one)
  branch b53_within digits(b53_r,b53_next,b53_n,b53_f) bad()
block done(b54_a:u64)
  ret(b54_a)
block bad()
  b55_z:u64 = const() {"value":0}
  ret(b55_z)
end
