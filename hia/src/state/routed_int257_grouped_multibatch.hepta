  at_next2:u64 = int.add.wrap(at2,four2)
  done2:bool = compare.eq(nx2,four2)
  branch done2 finish(n2,tot2) slot(r2,at_next2,k2,n2,nx2,tot2)
block finish(n3:u64,tot3:u64)
  okay3:bool = compare.eq(n3,tot3)
  ret(okay3)
block bad()
