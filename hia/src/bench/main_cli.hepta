  branch large_classic ordinary_footprint_default(large_o,large_txs,large_keys) ordinary_no_file_large_parity(large_o,large_txs,large_keys)
block ordinary_no_file_large_parity(lp_o:mutbuf,lp_txs:u64,lp_keys:u64)
  cap_lp_n:u64 = const() {"value":20000}
