fn vs_frame_bytes(input:readbuf,base:u64,rel:u64,width:u64,work:mutbuf,pos:u64) -> (u64) effects(read,write,trap) entry(entry)
block entry(input:readbuf,base:u64,rel:u64,width:u64,work:mutbuf,pos:u64)
  prefix:u64 = const() {"value":8}
  target:u64 = call(work,pos,width,prefix) {"function":"rac_write_be"}
  start:u64 = int.add.wrap(base,rel)
  after:u64 = call(input,work,start,target,width) {"function":"rac_copy"}
  ret(after)
end

fn vs_frame_number(input:readbuf,base:u64,rel:u64,width:u64,work:mutbuf,pos:u64) -> (u64) effects(read,write,trap) entry(entry)
block entry(input:readbuf,base:u64,rel:u64,width:u64,work:mutbuf,pos:u64)
  prefix:u64 = const() {"value":8}
  target:u64 = call(work,pos,width,prefix) {"function":"rac_write_be"}
  value:u64 = call(input,base,rel,width) {"function":"vr_read"}
  after:u64 = call(work,target,value,width) {"function":"rac_write_be"}
  ret(after)
end
