+        let now = Instant::now();
+        let mut live = Fixture::new(now + Duration::from_secs(10), now + Duration::from_secs(30));
+        let done = live.finished(Err("PUBLIC_OUTPUT_LIMIT".into()));
+        apply_finished_connection(
+            &mut live.connections,
