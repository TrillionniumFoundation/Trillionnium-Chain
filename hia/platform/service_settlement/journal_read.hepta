fn sjr_command_id(entry_r:readbuf,entry_w:mutbuf,entry_len:u64) -> (u64) effects(read,write,trap) entry(entry)
block entry(entry_r:readbuf,entry_w:mutbuf,entry_len:u64)
  entry_source:u64 = const() {"value":24}
  entry_staged:u64 = const() {"value":2304}
  entry_copied:u64 = call(entry_r,entry_source,entry_w,entry_staged,entry_len) {"function":"cp_copy"}
  entry_end:u64 = int.add.wrap(entry_staged,entry_len)
  entry_tag_at:usize = const() {"value":2304}
  entry_tag:u8 = buffer.load(entry_w,entry_tag_at)
  entry_zero:u8 = const() {"value":0}
  entry_receipt:bool = compare.eq(entry_tag,entry_zero)
  branch entry_receipt parse_receipt(entry_w,entry_len,entry_end) check_rollup(entry_w,entry_len,entry_end,entry_tag)
block check_rollup(check_rollup_w:mutbuf,check_rollup_len:u64,check_rollup_end:u64,check_rollup_tag:u8)
  check_rollup_one:u8 = const() {"value":1}
  check_rollup_rollup:bool = compare.eq(check_rollup_tag,check_rollup_one)
  branch check_rollup_rollup parse_rollup(check_rollup_w,check_rollup_len,check_rollup_end) check_settle(check_rollup_w,check_rollup_len,check_rollup_end,check_rollup_tag)
block check_settle(check_settle_w:mutbuf,check_settle_len:u64,check_settle_end:u64,check_settle_tag:u8)
  check_settle_two:u8 = const() {"value":2}
  check_settle_settle:bool = compare.eq(check_settle_tag,check_settle_two)
  branch check_settle_settle parse_settle(check_settle_w,check_settle_len,check_settle_end) rejected()
block parse_receipt(parse_receipt_w:mutbuf,parse_receipt_len:u64,parse_receipt_end:u64)
  parse_receipt_body:u64 = const() {"value":2305}
  parse_receipt_parsed:u64 = call(parse_receipt_w,parse_receipt_body,parse_receipt_end) {"function":"srci_receipt"}
  parse_receipt_kind:u64 = const() {"value":24}
  jump compare_end(parse_receipt_w,parse_receipt_len,parse_receipt_end,parse_receipt_parsed,parse_receipt_kind)
block parse_rollup(parse_rollup_w:mutbuf,parse_rollup_len:u64,parse_rollup_end:u64)
  parse_rollup_body:u64 = const() {"value":2305}
  parse_rollup_parsed:u64 = call(parse_rollup_w,parse_rollup_body,parse_rollup_end) {"function":"srli_command"}
  parse_rollup_kind:u64 = const() {"value":25}
  jump compare_end(parse_rollup_w,parse_rollup_len,parse_rollup_end,parse_rollup_parsed,parse_rollup_kind)
block parse_settle(parse_settle_w:mutbuf,parse_settle_len:u64,parse_settle_end:u64)
  parse_settle_genesis:u64 = const() {"value":2307}
  parse_settle_context:u64 = call(parse_settle_w,parse_settle_genesis,parse_settle_end) {"function":"srci_context"}
  parse_settle_fields:u64 = const() {"value":156}
  parse_settle_parsed:u64 = call(parse_settle_context,parse_settle_end,parse_settle_fields) {"function":"srci_take"}
  parse_settle_kind:u64 = const() {"value":26}
  jump compare_end(parse_settle_w,parse_settle_len,parse_settle_end,parse_settle_parsed,parse_settle_kind)
block compare_end(compare_end_w:mutbuf,compare_end_len:u64,compare_end_end:u64,compare_end_parsed:u64,compare_end_kind:u64)
  compare_end_strict:bool = compare.eq(compare_end_parsed,compare_end_end)
  branch compare_end_strict hash_command(compare_end_w,compare_end_len,compare_end_kind) rejected()
block hash_command(hash_command_w:mutbuf,hash_command_len:u64,hash_command_kind:u64)
  hash_command_initialized:u64 = call(hash_command_w) {"function":"tr_sha_init"}
  hash_command_pw0:u64 = const() {"value":7885365840114090046}
  hash_command_p0a:u64 = const() {"value":2048}
  hash_command_p0x:u64 = call(hash_command_w,hash_command_p0a,hash_command_pw0) {"function":"cp_put"}
  hash_command_pw8:u64 = const() {"value":7809911856577867822}
  hash_command_p8a:u64 = const() {"value":2056}
  hash_command_p8x:u64 = call(hash_command_w,hash_command_p8a,hash_command_pw8) {"function":"cp_put"}
  hash_command_pw16:u64 = const() {"value":7957688116653207141}
  hash_command_p16a:u64 = const() {"value":2064}
  hash_command_p16x:u64 = call(hash_command_w,hash_command_p16a,hash_command_pw16) {"function":"cp_put"}
  hash_command_pw24:u64 = const() {"value":7957695015410300275}
  hash_command_p24a:u64 = const() {"value":2072}
  hash_command_p24x:u64 = call(hash_command_w,hash_command_p24a,hash_command_pw24) {"function":"cp_put"}
  hash_command_pw32:u64 = const() {"value":7882825970206733101}
  hash_command_p32a:u64 = const() {"value":2080}
  hash_command_p32x:u64 = call(hash_command_w,hash_command_p32a,hash_command_pw32) {"function":"cp_put"}
  hash_command_pw40:u64 = const() {"value":8243118315777846885}
  hash_command_p40a:u64 = const() {"value":2088}
  hash_command_p40x:u64 = call(hash_command_w,hash_command_p40a,hash_command_pw40) {"function":"cp_put"}
  hash_command_pw48:u64 = const() {"value":7017503696223827041}
  hash_command_p48a:u64 = const() {"value":2096}
  hash_command_p48x:u64 = call(hash_command_w,hash_command_p48a,hash_command_pw48) {"function":"cp_put"}
  hash_command_pw56:u64 = const() {"value":3343206260037739630}
  hash_command_p56a:u64 = const() {"value":2104}
  hash_command_p56x:u64 = call(hash_command_w,hash_command_p56a,hash_command_pw56) {"function":"cp_put"}
  hash_command_pw64:u64 = const() {"value":12662}
  hash_command_p64a:u64 = const() {"value":2112}
  hash_command_p64x:u64 = call(hash_command_w,hash_command_p64a,hash_command_pw64) {"function":"cp_put"}
  hash_command_domain_at:u64 = const() {"value":2048}
  hash_command_domain_size:u64 = const() {"value":66}
  hash_command_domain:u64 = call(hash_command_w,hash_command_domain_at,hash_command_domain_size) {"function":"tr_sha_update_work_full"}
  hash_command_raw_at:u64 = const() {"value":2304}
  hash_command_body:u64 = call(hash_command_w,hash_command_raw_at,hash_command_len) {"function":"tr_sha_update_work_full"}
  hash_command_final:u64 = call(hash_command_w) {"function":"tr_sha_final_full"}
  hash_command_zero:u64 = const() {"value":0}
  hash_command_first:u64 = bit.or(hash_command_initialized,hash_command_domain)
  hash_command_second:u64 = bit.or(hash_command_body,hash_command_final)
  hash_command_any:u64 = bit.or(hash_command_first,hash_command_second)
  hash_command_done:bool = compare.eq(hash_command_any,hash_command_zero)
  branch hash_command_done success(hash_command_kind) rejected()
block success(success_kind:u64)
  ret(success_kind)
block rejected()
  rejected_code:u64 = const() {"value":0}
  ret(rejected_code)
end
