fn rfr_be64(raw:readbuf,at:u64) -> (u64) effects(read,trap) entry(entry)
block entry(raw:readbuf,at:u64)
  start:u64 = const() {"value":0}
  eight:u64 = const() {"value":8}
  stop:u64 = int.add.wrap(at,eight)
  jump loop(raw,at,stop,start)
block loop(r:readbuf,p:u64,end:u64,v:u64)
  pos:usize = int.cast(p) {"mode":"wrap"}
  byte:u8 = buffer.load(r,pos)
  b:u64 = int.cast(byte) {"mode":"wrap"}
  shift:u64 = const() {"value":8}
  shifted:u64 = int.shl.checked(v,shift)
  joined:u64 = bit.or(shifted,b)
  inc:u64 = const() {"value":1}
  next:u64 = int.add.wrap(p,inc)
  done:bool = compare.eq(next,end)
  branch done result(joined) loop(r,next,end,joined)
block result(value:u64)
  ret(value)
end
fn rfr_alphabet(raw:readbuf,at:u64,end:u64) -> (bool) effects(read,trap) entry(entry)
block entry(raw:readbuf,at:u64,end:u64)
  jump loop(raw,at,end)
block loop(lr:readbuf,lp:u64,le:u64)
  done:bool = compare.eq(lp,le)
  branch done yes() load(lr,lp,le)
block load(r:readbuf,p:u64,e:u64)
  index:usize = int.cast(p) {"mode":"wrap"}
  b:u8 = buffer.load(r,index)
  lower_bit:u8 = const() {"value":32}
  folded:u8 = bit.or(b,lower_bit)
  a:u8 = const() {"value":97}
  z:u8 = const() {"value":122}
  first:bool = compare.le(a,folded)
  last:bool = compare.le(folded,z)
  letter:bool = bool.and(first,last)
  d0:u8 = const() {"value":48}
  d9:u8 = const() {"value":57}
  low_num:bool = compare.le(d0,b)
  high_num:bool = compare.le(b,d9)
  digit:bool = bool.and(low_num,high_num)
  dash:u8 = const() {"value":45}
  slash:u8 = const() {"value":47}
  low_punct:bool = compare.le(dash,b)
  high_punct:bool = compare.le(b,slash)
  punct:bool = bool.and(low_punct,high_punct)
  underscore:u8 = const() {"value":95}
  plus:u8 = const() {"value":43}
  is_underscore:bool = compare.eq(underscore,b)
  is_plus:bool = compare.eq(plus,b)
  two:bool = bool.or(is_underscore,is_plus)
  any_punct:bool = bool.or(punct,two)
  alphanum:bool = bool.or(letter,digit)
  allowed:bool = bool.or(alphanum,any_punct)
  one:u64 = const() {"value":1}
  next:u64 = int.add.wrap(p,one)
  branch allowed loop(r,next,e) no()
block yes()
  allow:bool = const() {"value":true}
  ret(allow)
block no()
  deny:bool = const() {"value":false}
  ret(deny)
end
