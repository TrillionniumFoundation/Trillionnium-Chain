  len:u64 = const() {"value":40}
  next:u64 = int.add.wrap(at,len)
  ret(next)
end

fn br_append_word(o:mutbuf,at:u64,bits:u64) -> (u64) effects(read,write,trap) entry(entry)
block entry(o:mutbuf,at:u64,bits:u64)
  _done:u64 = call(o,at,bits) {"function":"bench_put"}
  width:u64 = const() {"value":8}
  next:u64 = int.add.wrap(at,width)
  ret(next)
end

fn br_append_tail(o:mutbuf,at:u64,bits:u64,left:u64) -> (u64) effects(write,trap) entry(entry)
block entry(o:mutbuf,at:u64,bits:u64,left:u64)
  jump tail_next(o,at,bits,left)
block tail_next(o_n:mutbuf,at_n:u64,bits_n:u64,left_n:u64)
  zero_n:u64 = const() {"value":0}
  done_n:bool = compare.eq(left_n,zero_n)
  branch done_n tail_done(at_n) tail_byte(o_n,at_n,bits_n,left_n)
block tail_byte(o_b:mutbuf,at_b:u64,bits_b:u64,left_b:u64)
  at_mem:usize = int.cast(at_b) {"mode":"wrap"}
  octet:u8 = int.cast(bits_b) {"mode":"wrap"}
  _ = buffer.store(o_b,at_mem,octet)
  shift_b:u64 = const() {"value":8}
  one_b:u64 = const() {"value":1}
  next_b:u64 = int.add.wrap(at_b,one_b)
  rest_b:u64 = int.shr.checked(bits_b,shift_b)
  left_next:u64 = int.sub.wrap(left_b,one_b)
  jump tail_next(o_b,next_b,rest_b,left_next)
block tail_done(at_d:u64)
  ret(at_d)
end
