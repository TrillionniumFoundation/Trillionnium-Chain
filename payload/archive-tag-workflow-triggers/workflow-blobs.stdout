          printf 'Exact-source recent-window, bounded snapshots, statement reuse, authenticated recovery and migration scope only. Query bounds require their stated oracle and predictable-target assumptions. Whole baseline, full capacity, public Sybil fairness, physical power loss and WAN acceptance are separate. No cross-call verdict cache; whole-history quadratic traversal remains. A log inventory records only files present; absent logs do not establish native execution or a passing test. Earlier failed steps and the source verifier exit remain failures.\n' > "$out/SCOPE.txt"
          exit "$source_status"
      - name: Bind complete native cache observations to the unchanged tested source
        shell: bash
        run: |
          set -euo pipefail
          args=(--kind "$SOURCE_KIND" --expected-head "$EXPECTED_HEAD")
          if test "$SOURCE_KIND" = prospective-merge; then
            args+=(--expected-base "$EXPECTED_BASE" --expected-merge "$EXPECTED_MERGE")
          fi
          python3 scripts/ci/read_native_cache_observation.py "$OUT/cached_delta_complete_call_observation_keeps_checks_and_results.log" --source "$OUT/source.json" --source-after "$OUT/source-after.json" "${args[@]}" --output "$OUT/native-statement-cache-readback.json"
      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        if: always()
        with:
          name: recent-exact-${{ matrix.runner }}-${{ matrix.source }}-${{ github.event.pull_request.head.sha }}-${{ github.run_attempt }}
          path: ${{ runner.temp }}/recent-exact
          if-no-files-found: error
          retention-days: 30

