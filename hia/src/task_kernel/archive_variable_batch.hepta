fn ar_multi_order(raw:readbuf,w:mutbuf,me:u64,i:u64) -> (bool) effects(read,write,trap) entry(entry)
block entry(raw:readbuf,w:mutbuf,me:u64,i:u64)
  z:u64 = const() {"value":0}
  empty:bool = compare.eq(i,z)
  branch empty ok() dupes(raw,w,me,i,z)
block dupes(dr:readbuf,dw:mutbuf,de:u64,di:u64,dx:u64)
  at:u64 = call(dx) {"function":"ar_multi_row_at"}
  other:u64 = call(dw,at) {"function":"tr_get"}
  id_back:u64 = const() {"value":176}
  our_id:u64 = int.sub.wrap(de,id_back)
  other_id:u64 = int.sub.wrap(other,id_back)
  id_width:u64 = const() {"value":32}
  duplicate:bool = call(dr,our_id,other_id,id_width) {"function":"archive_equal"}
  branch duplicate no() next(dr,dw,de,di,dx,other)
block next(nr:readbuf,nw:mutbuf,ne:u64,ni:u64,nx:u64,noe:u64)
  nn_bias:u64 = const() {"value":1}
  nn:u64 = int.add.wrap(nx,nn_bias)
  last:bool = compare.eq(nn,ni)
  branch last positions(nr,ne,noe) dupes(nr,nw,ne,ni,nn)
block positions(pr:readbuf,pe:u64,po:u64)
  ours_bias:u64 = const() {"value":144}
  ours_at:u64 = int.sub.wrap(pe,ours_bias)
  ours:u64 = call(pr,ours_at) {"function":"tr_read"}
  theirs_bias:u64 = const() {"value":144}
  theirs_at:u64 = int.sub.wrap(po,theirs_bias)
  theirs:u64 = call(pr,theirs_at) {"function":"tr_read"}
  higher:bool = compare.gt(ours,theirs)
  same_height:bool = compare.eq(ours,theirs)
  branch higher ok() tie(pr,pe,po,same_height)
block tie(tr:readbuf,te:u64,to:u64,ts:bool)
  branch ts compare_id(tr,te,to) no()
block compare_id(cr:readbuf,ce:u64,co:u64)
  backoff:u64 = const() {"value":176}
  our:u64 = int.sub.wrap(ce,backoff)
  prev:u64 = int.sub.wrap(co,backoff)
  lex:bool = call(cr,prev,our) {"function":"ar_multi_lex"}
  ret(lex)
block ok()
  result:bool = const() {"value":true}
  ret(result)
block no()
  bad:bool = const() {"value":false}
  ret(bad)
end

fn ar_multi_lex(r:readbuf,left:u64,right:u64) -> (bool) effects(read,write,trap) entry(entry)
block entry(r:readbuf,left:u64,right:u64)
  zero:u64 = const() {"value":0}
  jump loop(r,left,right,zero)
block loop(lr:readbuf,ll:u64,rr:u64,li:u64)
  max:u64 = const() {"value":32}
  more:bool = compare.lt(li,max)
  branch more byte(lr,ll,rr,li) same()
block byte(br:readbuf,bl:u64,bb:u64,bi:u64)
  u:u64 = int.add.wrap(bl,bi)
  v:u64 = int.add.wrap(bb,bi)
  a:usize = int.cast(u) {"mode":"wrap"}
  b:usize = int.cast(v) {"mode":"wrap"}
  x:u8 = buffer.load(br,a)
  y:u8 = buffer.load(br,b)
  eq:bool = compare.eq(x,y)
  next_bias:u64 = const() {"value":1}
  next:u64 = int.add.wrap(bi,next_bias)
  branch eq loop(br,bl,bb,next) order(x,y)
block order(p:u8,q:u8)
  in_order:bool = compare.lt(p,q)
  ret(in_order)
block same()
  equal:bool = const() {"value":false}
  ret(equal)
end

fn ar_multi_totals(raw:readbuf,seal:u64,end:u64,b:u64,lo:u64,hi:u64) -> (bool) effects(read,write,trap) entry(entry)
block entry(raw:readbuf,seal:u64,end:u64,b:u64,lo:u64,hi:u64)
  limit_bias:u64 = const() {"value":16}
  limit_at:u64 = int.sub.wrap(seal,limit_bias)
  limit:u64 = call(raw,limit_at) {"function":"tr_read"}
  limit_ok:bool = compare.ge(limit,b)
  bytes_bias:u64 = const() {"value":56}
  bytes_at:u64 = int.sub.wrap(end,bytes_bias)
  bytes:u64 = call(raw,bytes_at) {"function":"tr_read"}
  bytes_ok:bool = compare.eq(bytes,b)
  low_bias:u64 = const() {"value":48}
  low_at:u64 = int.sub.wrap(end,low_bias)
  low:u64 = call(raw,low_at) {"function":"tr_read"}
  low_ok:bool = compare.eq(low,lo)
  high_bias:u64 = const() {"value":40}
  high_at:u64 = int.sub.wrap(end,high_bias)
  high:u64 = call(raw,high_at) {"function":"tr_read"}
  high_ok:bool = compare.eq(high,hi)
  verify0:bool = bool.and(limit_ok,bytes_ok)
  verify1:bool = bool.and(verify0,low_ok)
  verify2:bool = bool.and(verify1,high_ok)
  ret(verify2)
end

fn ar_multi_range(raw:readbuf,seal:u64,first:u64,last:u64) -> (bool) effects(read,write,trap) entry(entry)
block entry(raw:readbuf,seal:u64,first:u64,last:u64)
  first_height_bias:u64 = const() {"value":144}
  first_height_at:u64 = int.sub.wrap(first,first_height_bias)
  first_height:u64 = call(raw,first_height_at) {"function":"tr_read"}
  last_height_bias:u64 = const() {"value":144}
  last_height_at:u64 = int.sub.wrap(last,last_height_bias)
  last_height:u64 = call(raw,last_height_at) {"function":"tr_read"}
  seal_first_bias:u64 = const() {"value":140}
  seal_first_at:u64 = int.sub.wrap(seal,seal_first_bias)
  seal_first:u64 = call(raw,seal_first_at) {"function":"tr_read"}
  seal_last_bias:u64 = const() {"value":132}
  seal_last_at:u64 = int.sub.wrap(seal,seal_last_bias)
  seal_last:u64 = call(raw,seal_last_at) {"function":"tr_read"}
  fh:bool = compare.eq(first_height,seal_first)
  lh:bool = compare.eq(last_height,seal_last)
  firstid_bias:u64 = const() {"value":176}
  firstid:u64 = int.sub.wrap(first,firstid_bias)
  lastid_bias:u64 = const() {"value":176}
  lastid:u64 = int.sub.wrap(last,lastid_bias)
  sf_bias:u64 = const() {"value":124}
  sf:u64 = int.sub.wrap(seal,sf_bias)
  sl_bias:u64 = const() {"value":92}
  sl:u64 = int.sub.wrap(seal,sl_bias)
  ids:u64 = const() {"value":32}
  match_first:bool = call(raw,firstid,sf,ids) {"function":"archive_equal"}
  match_last:bool = call(raw,lastid,sl,ids) {"function":"archive_equal"}
  range0:bool = bool.and(fh,lh)
  range1:bool = bool.and(range0,match_first)
  range2:bool = bool.and(range1,match_last)
  ret(range2)
end

fn ar_multi_merkle(w:mutbuf,width:u64) -> (bool) effects(read,write,trap) entry(entry)
block entry(w:mutbuf,width:u64)
  z:u64 = const() {"value":0}
  jump level(w,width,z,z)
block level(lw:mutbuf,ln:u64,li:u64,lo:u64)
  one:u64 = const() {"value":1}
  more:bool = compare.gt(ln,one)
  branch more pair(lw,ln,li,lo) done()
block pair(pw:mutbuf,pn:u64,pi:u64,po:u64)
  next_child_bias:u64 = const() {"value":1}
  next_child:u64 = int.add.wrap(pi,next_child_bias)
  have_right:bool = compare.lt(next_child,pn)
  right_index:u64 = select(have_right,next_child,pi)
  left:u64 = call(pi) {"function":"ar_multi_leaf_at"}
  right:u64 = call(right_index) {"function":"ar_multi_leaf_at"}
  left_work:u64 = const() {"value":1280}
  right_work:u64 = const() {"value":1312}
  _left:u64 = call(pw,left,left_work) {"function":"ar_multi_copy"}
  _right:u64 = call(pw,right,right_work) {"function":"ar_multi_copy"}
  hashed:bool = call(pw) {"function":"archive_node_digest"}
  branch hashed advance(pw,pn,pi,po) failed()
block advance(aw:mutbuf,an:u64,ai:u64,ao:u64)
  slot:u64 = call(ao) {"function":"ar_multi_leaf_at"}
  dg:u64 = const() {"value":1168}
  _digest:u64 = call(aw,dg,slot) {"function":"ar_multi_copy"}
  next_child2_bias:u64 = const() {"value":2}
  next_child2:u64 = int.add.wrap(ai,next_child2_bias)
  next_parent_bias:u64 = const() {"value":1}
  next_parent:u64 = int.add.wrap(ao,next_parent_bias)
  same_level:bool = compare.lt(next_child2,an)
  a0:u64 = const() {"value":0}
  branch same_level pair(aw,an,next_child2,next_parent) level(aw,next_parent,a0,a0)
block done()
  success:bool = const() {"value":true}
  ret(success)
block failed()
  unsuccessful:bool = const() {"value":false}
  ret(unsuccessful)
end
