  size9_8:u64 = const() {"value":8}
  read9_8:u64 = call(vi9,pos9_8,size9_8) {"function":"bc_tail"}
  target9_8:u64 = const() {"value":7234299918472275318}
  match9_8:bool = compare.eq(read9_8,target9_8)
  off9_16:u64 = const() {"value":16}
  pos9_16:u64 = int.add.wrap(vp9,off9_16)
  size9_16:u64 = const() {"value":1}
  read9_16:u64 = call(vi9,pos9_16,size9_16) {"function":"bc_tail"}
  target9_16:u64 = const() {"value":121}
  match9_16:bool = compare.eq(read9_16,target9_16)
  last9:bool = bool.and(match9_8,match9_16)
  all9:bool = bool.and(match9_0,last9)
  index9:u64 = const() {"value":9}
  branch all9 success(index9) absent()
block success(result:u64)
  ret(result)
block absent()
  invalid:u64 = const() {"value":10}
  ret(invalid)
end

fn bc_marked(o:mutbuf) -> (bool) effects(read,write,trap) entry(entry)
block entry(o:mutbuf)
  off:u64 = const() {"value":24}
  bit:u64 = const() {"value":512}
  none:u64 = const() {"value":0}
  current:u64 = call(o,off) {"function":"bench_get"}
  selected:u64 = bit.and(current,bit)
  answer:bool = compare.ne(selected,none)
  ret(answer)
end

fn bc_special(i:readbuf,p:u64,w:u64) -> (u64) effects(read,trap) entry(entry)
block entry(i:readbuf,p:u64,w:u64)
  two:u64 = const() {"value":2}
  short:bool = compare.eq(w,two)
  branch short short_token(i,p,w) long_width(i,p,w)
block short_token(i_st:readbuf,p_st:u64,w_st:u64)
  code_st:u64 = call(i_st,p_st,w_st) {"function":"bc_tail"}
  short_help:u64 = const() {"value":26669}
  short_end:u64 = const() {"value":11565}
  short_he:bool = compare.eq(code_st,short_help)
  short_en:bool = compare.eq(code_st,short_end)
  end_st:u64 = const() {"value":2}
  none_st:u64 = const() {"value":0}
  select_st:u64 = select(short_en,end_st,none_st)
  branch short_he yes_help() chosen(select_st)
block long_width(i_lw:readbuf,p_lw:u64,w_lw:u64)
  six_lw:u64 = const() {"value":6}
  display_lw:bool = compare.eq(w_lw,six_lw)
  branch display_lw long_token(i_lw,p_lw,w_lw) no_choice()
block long_token(i_lt:readbuf,p_lt:u64,w_lt:u64)
  code_lt:u64 = call(i_lt,p_lt,w_lt) {"function":"bc_tail"}
  long_help:u64 = const() {"value":123610860105005}
  display_lt:bool = compare.eq(code_lt,long_help)
  branch display_lt yes_help() no_choice()
block chosen(answer:u64)
  ret(answer)
block no_choice()
  unknown:u64 = const() {"value":0}
  ret(unknown)
block yes_help()
  yes:u64 = const() {"value":1}
  ret(yes)
end


fn bc_numeric_echo(i:readbuf,o:mutbuf,p:u64,e:u64,d:u64) -> (bool) effects(read,write,trap) entry(entry)
block entry(i:readbuf,o:mutbuf,p:u64,e:u64,d:u64)
  jump loop(i,o,p,e,d)
block loop(i_l:readbuf,o_l:mutbuf,p_l:u64,e_l:u64,d_l:u64)
  done:bool = compare.eq(p_l,e_l)
  branch done good() check(i_l,o_l,p_l,e_l,d_l)
block check(i_c:readbuf,o_c:mutbuf,p_c:u64,e_c:u64,d_c:u64)
  at_c:usize = int.cast(p_c) {"mode":"wrap"}
  octet_c:u8 = buffer.load(i_c,at_c)
  lower_c:u8 = const() {"value":32}
  upper_c:u8 = const() {"value":126}
  above_c:bool = compare.ge(octet_c,lower_c)
  below_c:bool = compare.le(octet_c,upper_c)
  visible_c:bool = bool.and(above_c,below_c)
  branch visible_c save(i_c,o_c,p_c,e_c,d_c,octet_c) bad()
block save(i_s:readbuf,o_s:mutbuf,p_s:u64,e_s:u64,d_s:u64,b_s:u8)
  at_s:usize = int.cast(d_s) {"mode":"wrap"}
  _ = buffer.store(o_s,at_s,b_s)
  one_s:u64 = const() {"value":1}
  next_s:u64 = int.add.wrap(p_s,one_s)
  dest_s:u64 = int.add.wrap(d_s,one_s)
  jump loop(i_s,o_s,next_s,e_s,dest_s)
block good()
  yes:bool = const() {"value":true}
  ret(yes)
block bad()
  no:bool = const() {"value":false}
  ret(no)
end


fn bc_free_grammar(i:readbuf,p:u64,e:u64) -> (bool) effects(read,trap) entry(entry)
block entry(i:readbuf,p:u64,e:u64)
  jump scan(i,p,p,e)
block scan(i_s:readbuf,p_s:u64,j_s:u64,e_s:u64)
  done:bool = compare.eq(j_s,e_s)
  branch done yes() byte_check(i_s,p_s,j_s,e_s)
block byte_check(i_b:readbuf,p_b:u64,j_b:u64,e_b:u64)
  at:usize = int.cast(j_b) {"mode":"wrap"}
  b:u8 = buffer.load(i_b,at)
  A:u8 = const() {"value":65}
  Z:u8 = const() {"value":90}
  a:u8 = const() {"value":97}
  z:u8 = const() {"value":122}
  lo:u8 = const() {"value":48}
  hi:u8 = const() {"value":57}
  underscore:u8 = const() {"value":95}
  dash:u8 = const() {"value":45}
  Aok:bool = compare.ge(b,A)
  Zok:bool = compare.le(b,Z)
  aok:bool = compare.ge(b,a)
  zok:bool = compare.le(b,z)
  low_ok:bool = compare.ge(b,lo)
  high_ok:bool = compare.le(b,hi)
  upper:bool = bool.and(Aok,Zok)
  lower:bool = bool.and(aok,zok)
  digit:bool = bool.and(low_ok,high_ok)
  letter:bool = bool.or(upper,lower)
  id:bool = bool.or(digit,letter)
  under:bool = compare.eq(b,underscore)
  hyphen:bool = compare.eq(b,dash)
  later:bool = compare.gt(j_b,p_b)
  inner_dash:bool = bool.and(hyphen,later)
  word:bool = bool.or(id,under)
  allowed:bool = bool.or(word,inner_dash)
  one:u64 = const() {"value":1}
  next:u64 = int.add.wrap(j_b,one)
  branch allowed scan(i_b,p_b,next,e_b) no()
block yes()
  ok:bool = const() {"value":true}
  ret(ok)
block no()
  invalid:bool = const() {"value":false}
  ret(invalid)
end


fn bc_ascii_assignment(i:readbuf,p:u64,e:u64) -> (bool) effects(read,trap) entry(entry)
block entry(i:readbuf,p:u64,e:u64)
  jump next(i,p,e)
block next(i_n:readbuf,p_n:u64,e_n:u64)
  done:bool = compare.eq(p_n,e_n)
  branch done ok() byte_check(i_n,p_n,e_n)
block byte_check(i_b:readbuf,p_b:u64,e_b:u64)
  at:usize = int.cast(p_b) {"mode":"wrap"}
  c:u8 = buffer.load(i_b,at)
  min_c:u8 = const() {"value":32}
  max_c:u8 = const() {"value":126}
  lower:bool = compare.ge(c,min_c)
  upper:bool = compare.le(c,max_c)
  ascii:bool = bool.and(lower,upper)
  one:u64 = const() {"value":1}
  p_next:u64 = int.add.wrap(p_b,one)
  branch ascii next(i_b,p_next,e_b) fail()
block ok()
  yes:bool = const() {"value":true}
  ret(yes)
block fail()
  no:bool = const() {"value":false}
  ret(no)
end

fn bc_record_usage(o:mutbuf,field:u64) -> (u64) effects(read,write,trap) entry(entry)
block entry(o:mutbuf,field:u64)
  excluded:u64 = const() {"value":9}
  ordinary:bool = compare.lt(field,excluded)
  branch ordinary record(o,field) ignore()
block record(o_r:mutbuf,f_r:u64)
  history:u64 = const() {"value":80}
  old:u64 = call(o_r,history) {"function":"bench_get"}
  four:u64 = const() {"value":4}
  one:u64 = const() {"value":1}
  mask:u64 = const() {"value":15}
  roster:u64 = const() {"value":22086584625}
  r_shift:u64 = int.mul.wrap(f_r,four)
  entries:u64 = int.shr.checked(roster,r_shift)
  index:u64 = bit.and(entries,mask)
  count:u64 = bit.and(old,mask)
  next:u64 = int.add.wrap(count,one)
  shift:u64 = int.mul.wrap(next,four)
  word:u64 = int.shl.checked(index,shift)
  with_word:u64 = bit.or(old,word)
  value:u64 = int.add.wrap(with_word,one)
  updated:u64 = call(o_r,history,value) {"function":"bench_put"}
  ret(updated)
block ignore()
  zero:u64 = const() {"value":0}
  ret(zero)
end

fn bc_usage_for_echo(o:mutbuf,kind:u64,w:u64) -> (bool) effects(read,write,trap) entry(entry)
block entry(o:mutbuf,kind:u64,w:u64)
  flag:u64 = const() {"value":91}
  for_flag:bool = compare.eq(kind,flag)
  branch for_flag choose(o,w) valid()
block choose(o_c:mutbuf,w_c:u64)
  history:u64 = const() {"value":80}
  old:u64 = call(o_c,history) {"function":"bench_get"}
  four:u64 = const() {"value":4}
  one:u64 = const() {"value":1}
  mask:u64 = const() {"value":15}
  count:u64 = bit.and(old,mask)
  order:u64 = int.shr.checked(old,four)
  simple:bool = compare.le(count,one)
  branch simple legacy(o_c,order) limit(o_c,w_c,order)
block legacy(o_l:mutbuf,order_l:u64)
  at_l:usize = const() {"value":223}
  index_l:u8 = int.cast(order_l) {"mode":"wrap"}
  _ = buffer.store(o_l,at_l,index_l)
  jump valid()
block limit(o_m:mutbuf,w_m:u64,order_m:u64)
  cap_m:u64 = const() {"value":122}
  room_m:bool = compare.le(w_m,cap_m)
  branch room_m save(o_m,order_m) refuse()
block save(o_s:mutbuf,order_s:u64)
  marker:u64 = const() {"value":280375465082880}
  word_s:u64 = bit.or(order_s,marker)
  start_s:u64 = const() {"value":218}
  zero_s:u64 = const() {"value":0}
  jump write(o_s,word_s,start_s,zero_s)
block write(o_w:mutbuf,word_w:u64,at_w:u64,n_w:u64)
  byte_w:u8 = int.cast(word_w) {"mode":"wrap"}
  pos_w:usize = int.cast(at_w) {"mode":"wrap"}
  _ = buffer.store(o_w,pos_w,byte_w)
  step_w:u64 = const() {"value":1}
  shift_w:u64 = const() {"value":8}
  next_w:u64 = int.add.wrap(n_w,step_w)
  next_at_w:u64 = int.add.wrap(at_w,step_w)
  rest_w:u64 = int.shr.checked(word_w,shift_w)
  limit_w:u64 = const() {"value":6}
  done_w:bool = compare.eq(next_w,limit_w)
  branch done_w valid() write(o_w,rest_w,next_at_w,next_w)
block valid()
  pass:bool = const() {"value":true}
  ret(pass)
block refuse()
  fail:bool = const() {"value":false}
  ret(fail)
end
