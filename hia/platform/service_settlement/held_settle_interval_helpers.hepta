  checked:bool = call(mm,mb,mi,ms,mt) {"function":"hfs_check_marker"}
  branch checked advance(mm,mn,mi,mt,mv) bad()
block advance(am:mutbuf,an:u64,ai:u64,at:u64,av:bool)
  plus:u64 = const() {"value":1}
  after:u64 = int.add.wrap(ai,plus)
  done:bool = compare.eq(after,an)
  branch done terminal(at) read_marker(am,av,an,after,at)
block terminal(tn:u64)
  four:u64 = const() {"value":4}
  full:bool = compare.eq(tn,four)
  ret(full)
block bad()
  refuse:bool = const() {"value":false}
  ret(refuse)
end

fn hfs_roots(m:mutbuf,w:mutbuf) -> (bool) effects(read,write,trap) entry(entry)
block entry(m:mutbuf,w:mutbuf)
