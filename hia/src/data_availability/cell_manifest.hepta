fn cm_family_chars(input:readbuf,start:u64,length:u64) -> (bool) effects(read,trap) entry(entry)
block entry(input:readbuf,start:u64,length:u64)
  stop:u64 = int.add.wrap(start,length)
  jump step(input,start,stop)
block step(si:readbuf,sa:u64,se:u64)
  a:usize = int.cast(sa) {"mode":"wrap"}
  byte:u8 = buffer.load(si,a)
  a_start:u8 = const() {"value":65}
  a_end:u8 = const() {"value":90}
  b_start:u8 = const() {"value":97}
  b_end:u8 = const() {"value":122}
  n_start:u8 = const() {"value":48}
  n_end:u8 = const() {"value":57}
  dot:u8 = const() {"value":46}
  underscore:u8 = const() {"value":95}
  dash:u8 = const() {"value":45}
  a1:bool = compare.ge(byte,a_start)
  a2:bool = compare.le(byte,a_end)
  upper:bool = bool.and(a1,a2)
  b1:bool = compare.ge(byte,b_start)
  b2:bool = compare.le(byte,b_end)
  lower:bool = bool.and(b1,b2)
  n1:bool = compare.ge(byte,n_start)
  n2:bool = compare.le(byte,n_end)
  digit:bool = bool.and(n1,n2)
  dot_b:bool = compare.eq(byte,dot)
  under_b:bool = compare.eq(byte,underscore)
  hyphen_b:bool = compare.eq(byte,dash)
  p1:bool = bool.or(dot_b,under_b)
  p2:bool = bool.or(p1,hyphen_b)
  l1:bool = bool.or(upper,lower)
  core:bool = bool.or(l1,digit)
  valid:bool = bool.or(core,p2)
  one:u64 = const() {"value":1}
  after:u64 = int.add.wrap(sa,one)
  last:bool = compare.eq(after,se)
  branch valid advance(si,after,se,last) no()
block advance(ai:readbuf,aa:u64,ae:u64,done:bool)
  branch done yes() step(ai,aa,ae)
block yes()
  good:bool = const() {"value":true}
  ret(good)
block no()
  failed:bool = const() {"value":false}
  ret(failed)
end

fn cm_row_sizes(input:readbuf,start:u64,count:u64,chunk_size:u64,size:u64) -> (bool) effects(read,write,trap) entry(entry)
block entry(input:readbuf,start:u64,count:u64,chunk_size:u64,size:u64)
  jump step(input,start,count,chunk_size,size)
block step(si:readbuf,sa:u64,sn:u64,sk:u64,sz:u64)
