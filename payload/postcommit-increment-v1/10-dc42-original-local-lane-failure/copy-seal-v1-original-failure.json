h-published-dc42-v1/source-before.json\\\",\\\"size\\\":423,\\\"version\\\":\\\"66306:34755609:423:1794638776191575811:1794638776191575811\\\"}],\\\"destination_write\\\":{\\\"mode\\\":384,\\\"sha256\\\":\\\"c4891be8e0dc6ac1d45fffd793b0a08a90fa806f2863d132e27c6f578836babd\\\",\\\"size\\\":423,\\\"version\\\":\\\"16777233:606500752:423:1794639389006383798:1794639389006849921\\\",\\\"written\\\":423}},{\\\"name\\\":\\\"source-after.json\\\",\\\"source_path\\\":\\\"/home/qian-qi/chain-final-consolidation-20261114-root/final-repository-truth-published-dc42-v1/source-after.json\\\",\\\"expected_bytes\\\":423,\\\"expected_sha256\\\":\\\"c4891be8e0dc6ac1d45fffd793b0a08a90fa806f2863d132e27c6f578836babd\\\",\\\"chunks\\\":[{\\\"chunk_sha256\\\":\\\"c4891be8e0dc6ac1d45fffd793b0a08a90fa806f2863d132e27c6f578836babd\\\",\\\"eof\\\":true,\\\"next_offset\\\":423,\\\"offset\\\":0,\\\"path\\\":\\\"/home/qian-qi/chain-final-consolidation-20261114-root/final-repository-truth-published-dc42-v1/source-after.json\\\",\\\"size\\\":423,\\\"version\\\":\\\"66306:34755618:423:1794638793044260802:1794638793044260802\\\"}],\\\"destination_write\\\":{\\\"mode\\\":384,\\\"sha256\\\":\\\"c4891be8e0dc6ac1d45fffd793b0a08a90fa806f2863d132e27c6f578836babd\\\",\\\"size\\\":423,\\\"version\\\":\\\"16777233:606500680:423:1794639385574167541:1794639385574590123\\\",\\\"written\\\":423}}],\\\"source_only_reads\\\":true,\\\"rog_commands_executed\\\":[],\\\"tests_rerun\\\":false,\\\"missing_steps_json\\\":\\\"Original steps are embedded in summary.json. No separate steps.json existed in the listed source directory.\\\",\\\"errors\\\":[]}\")\nwith (root/\"transfer-receipts.json\").open(\"x\") as f:f.write(json.dumps(receipts,indent=2)+\"\\n\")\nwhitelist=json.loads((root/\"expected-whitelist.json\").read_text())\nactual=sorted(p.name for p in (root/\"original\").iterdir())\nassert actual==sorted(r[\"name\"] for r in whitelist[\"files\"]),actual\nrows=[]\nfor r in whitelist[\"files\"]:\n    path=root/\"original\"/r[\"name\"]; st=path.lstat();assert stat.S_ISREG(st.st_mode) and st.st_nlink==1\n    data=path.read_bytes();sha=hashlib.sha256(data).hexdigest()\n    assert len(data)==r[\"bytes\"] and sha==r[\"sha256\"],r[\"name\"]\n    rows.append({\"name\":r[\"name\"],\"bytes\":len(data),\"sha256\":sha,\"source_path\":r[\"path\"]})\nsummary=json.loads((root/\"original/summary.json\").read_text())\nassert summary[\"head\"]==\"dc42ce4df5cff79cc61c5addbaf01074b56b06ca\"\nassert summary[\"status\"]==\"failed\" and summary[\"lane_exit\"]==1\nassert (root/\"original/source-before.json\").read_bytes()==(root/\"original/source-after.json\").read_bytes()\nsource=json.loads((root/\"original/source-before.json\").read_text())\nenv=json.loads((root/\"original/conformance-environment.stdout\").read_text())\nreport={\"schema\":\"dc42-failed-lane-copy-verification-v1\",\"verified_at\":datetime.datetime.now(datetime.timezone.utc).isoformat(),\"source_directory\":receipts[\"source\"],\"destination_directory\":str(root),\"original_file_count\":len(rows),\"original_bytes\":sum(r[\"bytes\"] for r in rows),\"all_original_hashes_match\":True,\"source_receipts_identical\":True,\"original_lane\":{\"head\":summary[\"head\"],\"tree\":summary[\"tree\"],\"status\":summary[\"status\"],\"lane_exit\":summary[\"lane_exit\"],\"started_at\":summary[\"started_at\"],\"finished_at\":summary[\"finished_at\"],\"step_count\":len(summary[\"steps\"]),\"repository_truth_step\":next(s for s in summary[\"steps\"] if s[\"label\"]==\"repository-truth\"),\"hosted_ci_qualification\":summary[\"hosted_ci_qualification\"]},\"original_source_receipt\":source,\"original_environment_observation\":env,\"missing_original_steps_json\":True,\"copy_did_not_run_tests_or_rog_commands\":True,\"files\":rows}\nwith (root/\"copy-verification.json\").open(\"x\") as f:f.write(json.dumps(report,indent=2)+\"\\n\")\nreadme=\"\"\"# Exact dc42 failed Linux repository-truth original records\n\nThis directory contains 37 original files copied read-only from the explicitly requested ROG lane directory: 34 stdout/stderr streams for 17 steps, summary.json, and source-before.json/source-after.json. The original summary contains the step list; no separate steps.json was present, and none is synthesized.\n\nEach source file was read through the configured binary API with a fixed file version and independent chunk SHA256. Every Mac destination was created only if absent. All 37 final sizes and SHA256 values match the original summary or the fixed source-read receipt. The two original source-verification receipts are identical.\n\nThe original lane failed (exit 1) on exact dc42; its repository-truth child elapsed 6.677 seconds under the unchanged 2700-second bound. Source verification succeeded before and after. Copying these records grants neither a passing full lane nor hosted qualification.\n\nNo ROG shell command, ROG archive operation, source or Git ref write, test rerun, repair, or Host workload was performed for this copy. The initial multi-file read requested an absent steps.json and was rejected as a batch; this is recorded in expected-whitelist.json and did not modify or fabricate originals.\n\ncopy-verification.json, transfer-receipts.json and EVIDENCE_INDEX.json are new transfer metadata, not original lane output.\n\"\"\"\nwith (root/\"README.md\").open(\"x\") as f:f.write(readme)\nentries=[]\nfor p in sorted(root.rglob(\"*\")):\n    if p.is_file() and p.name!=\"EVIDENCE_INDEX.json\":\n        data=p.read_bytes();entries.append({\"path\":str(p.relative_to(root)),\"bytes\":len(data),\"sha256\":hashlib.sha256(data).hexdigest(),\"role\":\"original\" if p.parent.name==\"original\" else \"transfer_metadata\"})\nwith (root/\"EVIDENCE_INDEX.json\").open(\"x\") as f:f.write(json.dumps({\"schema\":\"failed-lane-original-copy-index-v1\",\"files\":entries},indent=2)+\"\\n\")\nprint(json.dumps({\"verified\":True,\"original_count\":len(rows),\"original_bytes\":report[\"original_bytes\"],\"directory\":str(root),\"files\":[{\"path\":str(root/n),\"bytes\":(root/n).stat().st_size,\"sha256\":hashlib.sha256((root/n).read_bytes()).hexdigest()} for n in [\"copy-verification.json\",\"transfer-receipts.json\",\"EVIDENCE_INDEX.json\"]],\"source\":source,\"conformance_environment\":env}))\n"
}
