fn rq_nonzero_id(i:readbuf,p:usize) -> (bool) effects(read,write,trap) entry(entry)
block entry(i:readbuf,p:usize)
  at1:usize = const() {"value":8}
  at2:usize = const() {"value":16}
  at3:usize = const() {"value":24}
  p1:usize = int.add.wrap(p,at1)
  p2:usize = int.add.wrap(p,at2)
  p3:usize = int.add.wrap(p,at3)
  id0:u64 = call(i,p) {"function":"cw_read64"}
  id1:u64 = call(i,p1) {"function":"cw_read64"}
  id2:u64 = call(i,p2) {"function":"cw_read64"}
  id3:u64 = call(i,p3) {"function":"cw_read64"}
