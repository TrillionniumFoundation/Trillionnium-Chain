{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trillionniumchain.dev/schemas/task_model_metadata.schema.json",
  "title": "Trillionnium Task + Model Metadata (Track D1/D2)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "task_type",
    "input_hash",
    "model",
    "provenance"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9:_-]{1,128}$"
    },
    "task_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^.*\\S.*$"
    },
    "input_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "model_digest",
        "version"
      ],
      "properties": {
        "model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^.*\\S.*$"
        },
        "model_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^.*\\S.*$"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer_did",
        "produced_at",
        "privacy_tier"
      ],
      "properties": {
        "producer_did": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        },
        "produced_at": {
          "type": "string",
          "format": "date-time"
        },
        "provenance_index": {
          "type": "string",
          "pattern": "^prov:[a-z0-9:_-]{8,128}$"
        },
        "privacy_tier": {
          "type": "string",
          "enum": [
            "public",
            "internal",
            "restricted"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "privacy_tier": {
                "const": "restricted"
              }
            }
          },
          "then": {
            "required": [
              "provenance_index"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "privacy_tier": {
                "const": "public"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "provenance_index"
              ]
            }
          }
        }
      ]
    }
  }
}
