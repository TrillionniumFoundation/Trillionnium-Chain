  bitmap:u64 = call(pf_o,marks) {"function":"bench_get"}
  true_pf:u64 = const() {"value":1}
  flag:u64 = int.shl.checked(true_pf,pf_field)
  already:u64 = bit.and(bitmap,flag)
  zero_pf:u64 = const() {"value":0}
  fresh_pf:bool = compare.eq(already,zero_pf)
  valid_pf:bool = bool.and(bare,fresh_pf)
  branch valid_pf keep_flag(pf_i,pf_o,pf_n,pf_k,pf_e,marks,bitmap,flag,pf_field) flag_reject(pf_i,pf_o,pf_n,pf_p,pf_k,pf_e,pf_at,pf_field,bare)
