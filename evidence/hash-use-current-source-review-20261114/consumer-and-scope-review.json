    "test_numeric_bounds_source_trust_and_scope_self_certification_refused",
    "test_wrapper_can_only_describe_the_old_digest_literal",
    "test_wrapper_cannot_claim_original_content_or_recovered_provenance",
    "test_small_inner_collision_survives_a_real_sha512_wrapper",
