fn hfs_linear_roots(m:mutbuf,w:mutbuf,rows:u64) -> (bool) effects(read,write,trap) entry(entry)
block entry(m:mutbuf,w:mutbuf,rows:u64)
  count_at:u64 = const() {"value":88}
  count:u64 = call(m,count_at) {"function":"cp_get"}
  one_c:u64 = const() {"value":1}
  cap_c:u64 = const() {"value":8}
  floor:u64 = const() {"value":3}
  extent:u64 = int.add.wrap(rows,one_c)
  exact:bool = compare.eq(count,extent)
  mode_at:u64 = const() {"value":349024}
  mode:u64 = call(m,mode_at) {"function":"cp_get"}
  bank:bool = call(mode) {"function":"hfs_bank_profile"}
  cap_bank:u64 = const() {"value":9}
  selected:u64 = select(bank,cap_bank,cap_c)
  below:bool = compare.le(rows,selected)
  above:bool = compare.ge(rows,floor)
  limits:bool = bool.and(below,above)
  safe:bool = bool.and(exact,limits)
  branch safe route(m,w,rows,bank) bad()
block route(rrm:mutbuf,rrw:mutbuf,rrn:u64,rrb:bool)
  branch rrb verify_bank(rrm,rrn) setup(rrm,rrw,rrn)
block verify_bank(bm:mutbuf,bn:u64)
  seen_at:u64 = const() {"value":459992}
  nine:u64 = const() {"value":9}
  zero_b:u64 = const() {"value":0}
  count_seen:u64 = call(bm,seen_at) {"function":"cp_get"}
  valid_seen:bool = compare.eq(count_seen,nine)
  exact_n:bool = compare.eq(bn,nine)
  ready:bool = bool.and(valid_seen,exact_n)
  branch ready walk(bm,zero_b,bn) bad()
block setup(sm:mutbuf,sw:mutbuf,sn:u64)
  stride:u64 = const() {"value":153}
  packed_bytes:u64 = int.mul.wrap(sn,stride)
  got:bool = call(sm,sw,sn,packed_bytes) {"function":"hfs_collect_roots"}
  zero:u64 = const() {"value":0}
  branch got walk(sm,zero,sn) bad()
block walk(vm:mutbuf,vi:u64,max:u64)
  first:u64 = const() {"value":0}
  unit:u64 = const() {"value":1}
  genesis:bool = compare.eq(vi,first)
  predecessor:u64 = int.sub.wrap(vi,unit)
  src:u64 = select(genesis,first,predecessor)
  marker:u64 = call(vi) {"function":"hfs_marker_offset"}
  checked:bool = call(vm,marker,vi,src,vi) {"function":"hfs_check_marker"}
  branch checked continue(vm,vi,max,unit) bad()
block continue(cm:mutbuf,ci:u64,cl:u64,cu:u64)
  end_c:bool = compare.eq(ci,cl)
  step:u64 = int.add.wrap(ci,cu)
  branch end_c good() walk(cm,step,cl)
block good()
  verified:bool = const() {"value":true}
  ret(verified)
block bad()
  refused:bool = const() {"value":false}
  ret(refused)
end

