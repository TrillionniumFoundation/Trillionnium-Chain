  _part7:u64 = call(h_out,h_need) {"function":"bmp_emit7"}
  from0:usize = const() {"value":0}
  to0:usize = const() {"value":3344}
  jump copy(h_src,h_out,h_n,from0,to0,h_need)
block copy(c_src:readbuf,c_out:mutbuf,c_n:usize,c_from:usize,c_to:usize,c_size:u64)
  at_end:bool = compare.eq(c_from,c_n)
  branch at_end ok(c_size) byte(c_src,c_out,c_n,c_from,c_to,c_size)
block byte(b_src:readbuf,b_out:mutbuf,b_n:usize,b_from:usize,b_to:usize,b_size:u64)
  octet:u8 = buffer.load(b_src,b_from)
  _ = buffer.store(b_out,b_to,octet)
  one:usize = const() {"value":1}
  c_next:usize = int.add.wrap(b_from,one)
  o_next:usize = int.add.wrap(b_to,one)
  jump copy(b_src,b_out,b_n,c_next,o_next,b_size)
block ok(size:u64)
  count:u32 = int.cast(size) {"mode":"wrap"}
  ret(count)
block refuse()
  failed:u32 = const() {"value":4294967294}
  ret(failed)
end

