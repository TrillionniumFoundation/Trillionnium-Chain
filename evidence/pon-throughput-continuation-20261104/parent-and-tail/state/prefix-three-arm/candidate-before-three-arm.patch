+/// Borrowed bytes are only supplied after comparison with this operation's
+/// immutable actual input. Preserve their original canonical Vec capacity when
+/// materializing a map: Vec::clone would shrink it and alter budget decisions.
+enum CanonicalRow<'a> {
+    Compared(&'a Vec<u8>),
+    Fresh(Vec<u8>),
+}
+impl CanonicalRow<'_> {
+    fn bytes(&self) -> &Vec<u8> {
+        match self {
+            Self::Compared(bytes) => bytes,
+            Self::Fresh(bytes) => bytes,
+        }
+    }
+    fn into_owned(self) -> Vec<u8> {
+        match self {
+            Self::Compared(bytes) => {
+                let mut owned = Vec::with_capacity(bytes.capacity());
+                owned.extend_from_slice(bytes);
+                owned
+            }
+            Self::Fresh(bytes) => bytes,
+        }
+    }
+}
