  end:u64 = call(er,ew,ep,en) {"function":"tar_primitive"}
  ambiguous:u64 = const() {"value":18446744073709551614}
  valid:bool = compare.lt(end,ambiguous)
  branch valid follow(er,ew,end,en,ec) pass(end)
block follow(fr:readbuf,fw:mutbuf,fp:u64,fn_:u64,fc:u64)
  sep:u64 = call(fr,fp,fn_) {"function":"oj_ws"}
  mark:u64 = call(fr,sep,fn_) {"function":"oj_peek"}
  close_f:u64 = const() {"value":93}
  ending:bool = compare.eq(mark,close_f)
  comma:u64 = const() {"value":44}
  continued:bool = compare.eq(mark,comma)
  one_f:u64 = const() {"value":1}
  after:u64 = int.add.wrap(sep,one_f)
  count:u64 = int.add.wrap(fc,one_f)
  branch ending done(sep) more(fr,fw,after,fn_,count,continued)
block more(mr:readbuf,mw:mutbuf,mp:u64,mn:u64,mc:u64,ok:bool)
  branch ok item(mr,mw,mp,mn,mc) invalid()
block done(past:u64)
  one_d:u64 = const() {"value":1}
  next_d:u64 = int.add.wrap(past,one_d)
  ret(next_d)
block pass(code:u64)
  ret(code)
block outside()
  cap_fail:u64 = const() {"value":18446744073709551614}
  ret(cap_fail)
block invalid()
  syntax:u64 = const() {"value":18446744073709551615}
  ret(syntax)
end

fn tar_primitive(r:readbuf,w:mutbuf,p:u64,n:u64) -> (u64) effects(read,write,trap) entry(entry)
block entry(r:readbuf,w:mutbuf,p:u64,n:u64)
  at:u64 = call(r,p,n) {"function":"oj_ws"}
  token:u64 = call(r,at,n) {"function":"oj_peek"}
  quote:u64 = const() {"value":34}
  is_string:bool = compare.eq(token,quote)
  brace:u64 = const() {"value":123}
  bracket:u64 = const() {"value":91}
  is_obj:bool = compare.eq(token,brace)
  is_arr:bool = compare.eq(token,bracket)
  nested:bool = bool.or(is_obj,is_arr)
  branch is_string string(r,w,at,n) choose(r,at,n,token,nested)
block string(sr:readbuf,sw:mutbuf,sp:u64,sn:u64)
  zero:u64 = const() {"value":0}
  after:u64,unused:u64 = call(sr,sw,sp,sn,zero,zero) {"function":"tar_string"}
  ret(after)
block choose(cr:readbuf,cp:u64,cn:u64,ct:u64,cdeep:bool)
  branch cdeep outside() num_or_lit(cr,cp,cn,ct)
block num_or_lit(nr:readbuf,np:u64,nn:u64,nt:u64)
  minus:u64 = const() {"value":45}
  neg:bool = compare.eq(nt,minus)
  d0:u64 = const() {"value":48}
  d9:u64 = const() {"value":57}
  lo:bool = compare.le(d0,nt)
  hi:bool = compare.le(nt,d9)
  digit:bool = bool.and(lo,hi)
  number:bool = bool.or(neg,digit)
  branch number magnitude(nr,np,nn,neg) literal(nr,np,nn)
block magnitude(mr:readbuf,mp:u64,mn:u64,mneg:bool)
  one:u64 = const() {"value":1}
  after_minus:u64 = int.add.wrap(mp,one)
  start:u64 = select(mneg,after_minus,mp)
  in_bounds:bool = compare.lt(start,mn)
  branch in_bounds digits(mr,start,mn,mneg) invalid()
block digits(dr:readbuf,dp:u64,dn:u64,dneg:bool)
  first:u64 = call(dr,dp,dn) {"function":"oj_peek"}
  d0_d:u64 = const() {"value":48}
  d9_d:u64 = const() {"value":57}
  low_d:bool = compare.le(d0_d,first)
  high_d:bool = compare.le(first,d9_d)
  valid_d:bool = bool.and(low_d,high_d)
  branch valid_d parse_int(dr,dp,dn,dneg) invalid()
block parse_int(pr:readbuf,pp:u64,pn:u64,pneg:bool)
  end:u64,numeric:u64 = call(pr,pn,pp) {"function":"hj_uint"}
  bound:u64 = const() {"value":9223372036854775808}
  upper:bool = compare.le(numeric,bound)
  one_i:u64 = const() {"value":1}
  lower:bool = compare.le(one_i,numeric)
  signed_ok:bool = bool.and(upper,lower)
  unsigned:bool = bool.not(pneg)
  legal:bool = bool.or(unsigned,signed_ok)
  branch legal return_at(end) invalid()
block literal(lr:readbuf,lp:u64,ln:u64)
  q:u64 = call(lr,lp,ln) {"function":"oj_ident"}
  ret(q)
block return_at(ra:u64)
  ret(ra)
block outside()
  wide:u64 = const() {"value":18446744073709551614}
  ret(wide)
block invalid()
  syntax:u64 = const() {"value":18446744073709551615}
  ret(syntax)
end

fn tar_mark(w:mutbuf,depth:u64,index:u64,p:u64) -> (u64) effects(read,write,trap) entry(entry)
block entry(w:mutbuf,depth:u64,index:u64,p:u64)
  flag_at:u64 = const() {"value":1208}
  flag:u64 = call(w,flag_at) {"function":"tr_get"}
  zero:u64 = const() {"value":0}
  enabled:bool = compare.ne(flag,zero)
  branch enabled record(w,depth,index,p) done()
block record(rw:mutbuf,rd:u64,ri:u64,rp:u64)
  root:u64 = const() {"value":9920}
  stride:u64 = const() {"value":256}
  width:u64 = const() {"value":8}
  group:u64 = int.mul.wrap(rd,stride)
  within:u64 = int.mul.wrap(ri,width)
  offset:u64 = int.add.wrap(group,within)
  at:u64 = int.add.wrap(root,offset)
  written:u64 = call(rw,at,rp) {"function":"tr_put"}
  ret(written)
block done()
  no_write:u64 = const() {"value":0}
  ret(no_write)
end

fn tar_count(w:mutbuf,depth:u64,count:u64) -> (u64) effects(read,write,trap) entry(entry)
block entry(w:mutbuf,depth:u64,count:u64)
  flag_at:u64 = const() {"value":1208}
  flag:u64 = call(w,flag_at) {"function":"tr_get"}
  zero:u64 = const() {"value":0}
  enabled:bool = compare.ne(flag,zero)
  branch enabled record(w,depth,count) done()
block record(rw:mutbuf,rd:u64,rc:u64)
  root:u64 = const() {"value":10432}
  width:u64 = const() {"value":8}
  shift:u64 = int.mul.wrap(rd,width)
  at:u64 = int.add.wrap(root,shift)
  written:u64 = call(rw,at,rc) {"function":"tr_put"}
  ret(written)
block done()
  no_write:u64 = const() {"value":0}
  ret(no_write)
end

fn tar_root_array(r:readbuf,w:mutbuf,n:u64,p:u64) -> (u32) effects(read,write,trap) entry(entry)
block entry(r:readbuf,w:mutbuf,n:u64,p:u64)
  one:u64 = const() {"value":1}
  first:u64 = int.add.wrap(p,one)
  start:u64 = call(r,first,n) {"function":"oj_ws"}
  token:u64 = call(r,start,n) {"function":"oj_peek"}
  close:u64 = const() {"value":93}
  empty:bool = compare.eq(token,close)
  zero:u64 = const() {"value":0}
  branch empty complete(r,w,n,start,zero) element(r,w,n,start,zero)
block element(er:readbuf,ew:mutbuf,en:u64,ep:u64,ek:u64)
  max:u64 = const() {"value":64}
  room:bool = compare.lt(ek,max)
  branch room item(er,ew,en,ep,ek) outside()
block item(ir:readbuf,iw:mutbuf,in:u64,ip:u64,ik:u64)
  token_i:u64 = call(ir,ip,in) {"function":"oj_peek"}
  brace:u64 = const() {"value":123}
  object:bool = compare.eq(token_i,brace)
  branch object named(ir,iw,in,ip,ik) regular(ir,iw,in,ip,ik)
block named(br:readbuf,bw:mutbuf,bn:u64,bp:u64,bk:u64)
  embedded:bool = const() {"value":true}
  status:u32,past:u64 = call(br,bw,bn,bp,embedded) {"function":"tar_object"}
  okay_b:u32 = const() {"value":0}
  valid:bool = compare.eq(status,okay_b)
  branch valid save(br,bw,bn,bp,bk,past) refusal(status)
block regular(rr:readbuf,rw:mutbuf,rn:u64,rp:u64,rk:u64)
  q:u64 = call(rr,rw,rp,rn) {"function":"tar_value"}
  bad_r:u64 = const() {"value":18446744073709551615}
  wide_r:u64 = const() {"value":18446744073709551614}
  ill:bool = compare.eq(q,bad_r)
  wide:bool = compare.eq(q,wide_r)
  branch ill invalid() cap(rr,rw,rn,rp,rk,q,wide)
block cap(ar:readbuf,aw:mutbuf,an:u64,ap:u64,ak:u64,aq:u64,af:bool)
  branch af outside() save(ar,aw,an,ap,ak,aq)
block save(sr:readbuf,sw:mutbuf,sn:u64,sp:u64,sk:u64,sq:u64)
  needed:u64 = const() {"value":13}
  store:bool = compare.lt(sk,needed)
  branch store store_index(sr,sw,sn,sp,sk,sq) follow(sr,sw,sn,sk,sq)
block store_index(xr:readbuf,xw:mutbuf,xn:u64,xp:u64,xk:u64,xq:u64)
  base:u64 = const() {"value":11872}
  stride:u64 = const() {"value":8}
  off:u64 = int.mul.wrap(xk,stride)
  pos:u64 = int.add.wrap(base,off)
  captured:u64 = call(xw,pos,xp) {"function":"tr_put"}
  jump follow(xr,xw,xn,xk,xq)
block follow(fr:readbuf,fw:mutbuf,fn_:u64,fk:u64,fq:u64)
  sep:u64 = call(fr,fq,fn_) {"function":"oj_ws"}
  byte:u64 = call(fr,sep,fn_) {"function":"oj_peek"}
  close_f:u64 = const() {"value":93}
  comma:u64 = const() {"value":44}
  done:bool = compare.eq(byte,close_f)
  more:bool = compare.eq(byte,comma)
  inc:u64 = const() {"value":1}
  count_f:u64 = int.add.wrap(fk,inc)
  branch done complete(fr,fw,fn_,sep,count_f) continuation(fr,fw,fn_,sep,count_f,more)
block continuation(cr:readbuf,cw:mutbuf,cn:u64,cp:u64,ck:u64,cc:bool)
  one_c:u64 = const() {"value":1}
  next:u64 = int.add.wrap(cp,one_c)
  next_field:u64 = call(cr,next,cn) {"function":"oj_ws"}
  branch cc element(cr,cw,cn,next_field,ck) invalid()
block complete(dr:readbuf,dw:mutbuf,dn:u64,dp:u64,dk:u64)
  one_d:u64 = const() {"value":1}
  end_d:u64 = int.add.wrap(dp,one_d)
  exact_end:u64 = call(dr,end_d,dn) {"function":"oj_ws"}
  exact:bool = compare.eq(exact_end,dn)
  branch exact passed(dw,dk) invalid()
block passed(pw:mutbuf,pk:u64)
  root:u64 = const() {"value":0}
  saved:u64 = call(pw,root,pk) {"function":"tar_count"}
  good:u32 = const() {"value":0}
  ret(good)
block invalid()
  syntax:u32 = const() {"value":2}
  ret(syntax)
block outside()
  profile:u32 = const() {"value":103}
  ret(profile)
block refusal(rs:u32)
  ret(rs)
end
