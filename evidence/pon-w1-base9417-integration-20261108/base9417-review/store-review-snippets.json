      "3946:        Ok(state)",
      "3947:    }",
      "3948:    fn recent(&self, parent: Hash) -> Result<Vec<(u64, Hash)>> {",
      "3949:        self.recent_with_progress(parent, &mut || Ok(()))",
      "3950:    }",
      "3951:    fn recent_with_progress(",
      "3952:        &self,",
      "3953:        mut parent: Hash,",
      "3954:        progress: &mut dyn FnMut() -> Result<()>,",
      "3955:    ) -> Result<Vec<(u64, Hash)>> {",
      "3956:        let mut out = Vec::new();",
      "3957:        let bound = self.settings.limit(\"retarget_interval\")?.max(11);",
      "3958:        while parent != self.settings.genesis() && out.len() < (bound as usize) {",
      "3959:            progress()?;",
      "3960:            // The per-link projection already validates the complete child and",
      "3961:            // parent record shapes. Batch the exact window, without keeping a",
      "3962:            // previous ancestry, time or target verdict across calls.",
      "3963:            let maximum = (bound - out.len() as u64).min(HISTORY_HEADER_BATCH);",
      "3964:            (parent, _) = self.visit_header_batch_limited(parent, maximum, &mut |_, link| {",
      "3965:                progress()?;",
      "3966:                out.push((link.header.timestamp, link.header.target));",
      "3967:                Ok(())",
      "3968:            })?;",
      "3969:        }",
      "3970:        if parent == self.settings.genesis() {",
      "3971:            out.push((",
      "3972:                self.settings.genesis_time(),",
      "3973:                self.settings.target(\"initial_target_hex\")?,",
      "3974:            ));",
      "3975:        }",
      "3976:        Ok(out)",
      "3977:    }",
      "3978:    /// The pool miner uses actual wall time, but admissibility is the native"
