fn r_hash(input:readbuf,work:mutbuf,nlen:u64,klen:u64,vlen:u64,val_at:u64) -> (bool) effects(read,write,trap) entry(entry)
block entry(input:readbuf,work:mutbuf,nlen:u64,klen:u64,vlen:u64,val_at:u64)
