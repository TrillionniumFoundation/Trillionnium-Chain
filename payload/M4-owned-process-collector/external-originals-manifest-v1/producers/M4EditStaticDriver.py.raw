proof_obj={"schema":"trnm-M4-original14-preservation-v1","base":H,"original_methods":14,"current_methods":16,"source_and_ast_identical":True,"methods":proof,"new_methods":sorted(set(after)-set(before)),"native_tests_executed":False}
