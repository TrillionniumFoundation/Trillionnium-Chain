  e_ok:bool = compare.eq(high,size)
  policy_ok:bool = select(rounded,r_ok,e_ok)
  and0:bool = bool.and(same_fs,same_dev)
  and1:bool = bool.and(and0,same_ino)
  and2:bool = bool.and(and1,same_size)
  and3:bool = bool.and(and2,same_blocks)
  and4:bool = bool.and(and3,within)
  and5:bool = bool.and(and4,file_ok)
  and6:bool = bool.and(and5,o_ok)
  and7:bool = bool.and(and6,c_ok)
  and8:bool = bool.and(and7,one_bind)
  and9:bool = bool.and(and8,growth_ok)
  and10:bool = bool.and(and9,valid_kind)
  and11:bool = bool.and(and10,known_gen)
  and12:bool = bool.and(and11,nonempty)
  and13:bool = bool.and(and12,valid_ino)
  and14:bool = bool.and(and13,events_ok)
  and15:bool = bool.and(and14,policy_ok)
  ret(and15)
end

