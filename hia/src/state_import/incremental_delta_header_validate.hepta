  target_protocol:u64 = const() {"value":272}
  base_root:u64 = const() {"value":576}
  source_root:u64 = const() {"value":144}
  target_root:u64 = const() {"value":640}
  context_target_root:u64 = const() {"value":384}
  chain_ok:bool = call(raw,source_chain,target_chain,words) {"function":"mhc_equal_pack"}
  protocol_ok:bool = call(raw,source_protocol,target_protocol,words) {"function":"mhc_equal_pack"}
  state_s_ok:bool = call(raw,base_root,source_root,words) {"function":"mhc_equal_pack"}
  state_t_ok:bool = call(raw,target_root,context_target_root,words) {"function":"mhc_equal_pack"}
  pair0:bool = bool.and(chain_ok,protocol_ok)
  pair1:bool = bool.and(state_s_ok,state_t_ok)
  digest_pairs:bool = bool.and(pair0,pair1)
  s_height_at:u64 = const() {"value":128}
  t_height_at:u64 = const() {"value":368}
  s_epoch_at:u64 = const() {"value":136}
  t_epoch_at:u64 = const() {"value":376}
  s_h:u64 = call(raw,s_height_at) {"function":"dh_be"}
  t_h:u64 = call(raw,t_height_at) {"function":"dh_be"}
  s_e:u64 = call(raw,s_epoch_at) {"function":"dh_be"}
  t_e:u64 = call(raw,t_epoch_at) {"function":"dh_be"}
  height_ok:bool = compare.gt(t_h,s_h)
  epoch_forward:bool = compare.ge(t_e,s_e)
  difference:u64 = int.sub.wrap(t_e,s_e)
