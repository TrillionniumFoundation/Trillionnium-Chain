  p_inc:u64 = int.add.wrap(p_ds,one_ds)
  invalid_ds:u64 = const() {"value":80}
  overflow_ds:u64 = const() {"value":96}
  error_ds:u64 = select(digit_ok,overflow_ds,invalid_ds)
  branch ok_ds after_digit(i_ds,o_ds,n_ds,p_inc,e_ds,k_ds,f_ds,s_ds,b_ds,combined,start_ds) numeric_failure(i_ds,o_ds,n_ds,start_ds,e_ds,k_ds,f_ds,error_ds)
block numeric_failure(nf_i:readbuf,nf_o:mutbuf,nf_n:u64,nf_p:u64,nf_e:u64,nf_k:u64,nf_f:u64,nf_error:u64)
