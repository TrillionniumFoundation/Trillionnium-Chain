block invalid(lane_bad:u64)
  z_bad:u64 = const() {"value":0}
  r_base:u32 = const() {"value":118}
  r_op:u32 = const() {"value":101}
  is_base:bool = compare.eq(lane_bad,z_bad)
  r_shape:u32 = select(is_base,r_base,r_op)
  ret(r_shape,z_bad,z_bad)
block order_bad()
  r_order:u32 = const() {"value":109}
  z_order:u64 = const() {"value":0}
  ret(r_order,z_order,z_order)
end
