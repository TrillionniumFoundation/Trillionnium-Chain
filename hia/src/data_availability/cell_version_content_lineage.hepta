  csize:u64 = call(i,cpos,four) {"function":"ca_read_be"}
  gpos:u64 = int.add.wrap(start,generation_at)
  gen:u64 = call(i,gpos,eight) {"function":"ca_read_be"}
  fpos:u64 = int.add.wrap(start,family_len_at)
  fn_:u64 = call(i,fpos,one) {"function":"rac_read_le"}
  fp:u64 = int.add.wrap(start,family_at)
  lpos0:u64 = int.add.wrap(start,lineage)
  lpos:u64 = int.add.wrap(lpos0,csize)
  ln:u64 = call(i,lpos,one) {"function":"rac_read_le"}
  lp:u64 = int.add.wrap(lpos,one)
  fp_hi:u64 = int.shl.checked(fp,eight)
  lp_hi:u64 = int.shl.checked(lp,eight)
  packed_f:u64 = bit.or(fp_hi,fn_)
  packed_l:u64 = bit.or(lp_hi,ln)
  ret(gen,packed_f,packed_l)
end

fn c3_parent_edges(i:readbuf,w:mutbuf,n:u64,gen:u64,fp:u64,fl:u64,ap:u64,ac:u64) -> (u32,u64) effects(read,write,trap) entry(entry)
block entry(i:readbuf,w:mutbuf,n:u64,gen:u64,fp:u64,fl:u64,ap:u64,ac:u64)
  z:u64 = const() {"value":0}
  empty:bool = compare.eq(ac,z)
  branch empty yes(z) resolve(i,w,n,gen,fp,fl,ap,ac,z)
block resolve(ri:readbuf,rw:mutbuf,rn:u64,rg:u64,rf:u64,rl:u64,rp:u64,rc:u64,rm:u64)
  found:u64,at:u64 = call(ri,rw,rn,rp) {"function":"c3_find"}
  outside:bool = compare.eq(found,rn)
  branch outside missing() relation(ri,rw,rn,rg,rf,rl,rp,rc,rm,found,at)
block relation(pi:readbuf,pw:mutbuf,pn:u64,pg:u64,pf:u64,pl:u64,pp:u64,pc:u64,pm:u64,px:u64,pt:u64)
  start:u64 = call(pw,pt) {"function":"tr_get"}
  gen_p:u64,family_p:u64,unused_lineage:u64 = call(pi,start) {"function":"c3_metadata"}
  pshift:u64 = const() {"value":8}
  pmask:u64 = const() {"value":255}
  fam_p:u64 = int.shr.checked(family_p,pshift)
  len_p:u64 = bit.and(family_p,pmask)
  older:bool = compare.lt(gen_p,pg)
  same_code:u64 = call(pi,pf,fam_p,pl,len_p) {"function":"sb_compare"}
  one_p:u64 = const() {"value":1}
  same:bool = compare.eq(same_code,one_p)
  good_p:bool = bool.and(older,same)
  branch good_p update(pi,pw,pn,pg,pf,pl,pp,pc,pm,px) relation_error()
block update(ui:readbuf,uw:mutbuf,un:u64,ug:u64,uf:u64,ul:u64,up:u64,uc:u64,um:u64,ux:u64)
  one_u:u64 = const() {"value":1}
  thirtytwo:u64 = const() {"value":32}
  b:u64 = int.shl.checked(one_u,ux)
  mask_u:u64 = bit.or(um,b)
  after:u64 = int.add.wrap(up,thirtytwo)
  rest:u64 = int.sub.wrap(uc,one_u)
  last_u:bool = compare.eq(uc,one_u)
  branch last_u yes(mask_u) resolve(ui,uw,un,ug,uf,ul,after,rest,mask_u)
block yes(edge:u64)
  out:u32 = const() {"value":0}
  ret(out,edge)
block missing()
  no_parent:u32 = const() {"value":229}
  z_m:u64 = const() {"value":0}
  ret(no_parent,z_m)
block relation_error()
  wrong:u32 = const() {"value":230}
  z_r:u64 = const() {"value":0}
  ret(wrong,z_r)
end

fn c3_find(i:readbuf,w:mutbuf,count:u64,alias:u64) -> (u64,u64) effects(read,write,trap) entry(entry)
block entry(i:readbuf,w:mutbuf,count:u64,alias:u64)
  start:u64 = const() {"value":131232}
  zero:u64 = const() {"value":0}
  jump test(i,w,count,alias,start,zero)
block test(ti:readbuf,tw:mutbuf,tn:u64,ta:u64,tt:u64,tx:u64)
  sixteen:u64 = const() {"value":16}
  thirtytwo:u64 = const() {"value":32}
  one_t:u64 = const() {"value":1}
  alias_at:u64 = int.add.wrap(tt,sixteen)
  same_code:u64 = call(ti,ta,tw,alias_at,thirtytwo) {"function":"ca_equal"}
  same_t:bool = compare.eq(same_code,one_t)
  branch same_t found(tx,tt) next(ti,tw,tn,ta,tt,tx,one_t)
block next(ni:readbuf,nw:mutbuf,nn:u64,na:u64,nt:u64,nx:u64,no:u64)
  stride:u64 = const() {"value":128}
  next_n:u64 = int.add.wrap(nx,no)
  next_a:u64 = int.add.wrap(nt,stride)
  done:bool = compare.eq(next_n,nn)
  branch done found(nn,next_a) test(ni,nw,nn,na,next_a,next_n)
block found(idx:u64,at:u64)
  ret(idx,at)
end

fn c3_reach(w:mutbuf,count:u64,roots:u64) -> (bool) effects(read,write,trap) entry(entry)
block entry(w:mutbuf,count:u64,roots:u64)
  one:u64 = const() {"value":1}
  top:u64 = int.shl.checked(one,count)
  all:u64 = int.sub.wrap(top,one)
  jump pass(w,count,roots,all)
block pass(pw:mutbuf,pn:u64,pm:u64,pa:u64)
  complete:bool = compare.eq(pm,pa)
  branch complete yes() sweep(pw,pn,pm,pa)
block sweep(sw:mutbuf,sn:u64,sm:u64,sa:u64)
  start:u64 = const() {"value":131344}
  zero:u64 = const() {"value":0}
  jump member(sw,sn,sm,sa,sm,start,zero)
block member(mw:mutbuf,mn:u64,mm:u64,ma:u64,after:u64,mt:u64,mx:u64)
  one_m:u64 = const() {"value":1}
  stride_m:u64 = const() {"value":128}
  zero_m:u64 = const() {"value":0}
  bit_m:u64 = int.shl.checked(one_m,mx)
  has_m:u64 = bit.and(after,bit_m)
  present_m:bool = compare.ne(has_m,zero_m)
  row_m:u64 = call(mw,mt) {"function":"tr_get"}
  edge_m:u64 = select(present_m,row_m,zero_m)
  merged_m:u64 = bit.or(after,edge_m)
  next_m:u64 = int.add.wrap(mx,one_m)
  at_m:u64 = int.add.wrap(mt,stride_m)
  stop_m:bool = compare.eq(next_m,mn)
  branch stop_m finish(mw,mn,mm,ma,merged_m) member(mw,mn,mm,ma,merged_m,at_m,next_m)
block finish(fw:mutbuf,fn_:u64,fm:u64,fa:u64,merged_f:u64)
  changed:bool = compare.ne(merged_f,fm)
  branch changed pass(fw,fn_,merged_f,fa) no()
block yes()
  all_nodes:bool = const() {"value":true}
  ret(all_nodes)
block no()
  orphan:bool = const() {"value":false}
  ret(orphan)
end

fn c3_tcv_content(c3_di:readbuf,c3_dw:mutbuf,c3_db:u64,c3_de:u64) -> (u32) effects(read,write,trap) entry(entry)
block entry(c3_di:readbuf,c3_dw:mutbuf,c3_db:u64,c3_de:u64)
  four:u64 = const() {"value":4}
  jump have_tag(c3_di,c3_dw,c3_de,four,c3_db)
block have_tag(i1:readbuf,w1:mutbuf,n1:u64,four1:u64,base1:u64)
  extent1:u64 = int.sub.wrap(n1,base1)
  fits:bool = compare.le(four1,extent1)
  branch fits tag(i1,w1,n1,four1,base1) truncated()
block tag(i2:readbuf,w2:mutbuf,n2:u64,four2:u64,base2:u64)
  wanted:u64 = const() {"value":844514132}
  got:u64 = call(i2,base2,four2) {"function":"rac_read_le"}
  equal:bool = compare.eq(got,wanted)
  offset2:u64 = int.add.wrap(base2,four2)
  branch equal version_frame(i2,w2,n2,offset2) namespace()
block version_frame(i3:readbuf,w3:mutbuf,n3:u64,four3:u64)
  start:u64,end:u64 = call(i3,four3,n3) {"function":"tc_frame"}
  z3:u64 = const() {"value":0}
  fits3:bool = compare.gt(start,z3)
  branch fits3 version(i3,w3,n3,start,end) truncated()
block version(i4:readbuf,w4:mutbuf,n4:u64,s4:u64,e4:u64)
  status:u32,model_files:u64 = call(i4,w4,s4,e4) {"function":"cs_tcv_span"}
  z4:u32 = const() {"value":0}
  valid:bool = compare.eq(status,z4)
  branch valid have_count(i4,w4,n4,s4,e4) fail(status)
block have_count(i5:readbuf,w5:mutbuf,n5:u64,s5:u64,e5:u64)
  two5:u64 = const() {"value":2}
  row5:u64 = int.add.wrap(e5,two5)
  fit5:bool = compare.le(row5,n5)
  branch fit5 count_value(i5,w5,n5,s5,e5,row5,two5) truncated()
block count_value(i6:readbuf,w6:mutbuf,n6:u64,s6:u64,e6:u64,row6:u64,two6:u64)
  four6:u64 = const() {"value":4}
  model_frame:u64 = int.add.wrap(s6,four6)
  mb:u64,me:u64 = call(i6,model_frame,e6) {"function":"tc_frame"}
  eb:u64,ee:u64 = call(i6,me,e6) {"function":"tc_frame"}
  manifests:u64 = int.add.wrap(ee,two6)
  expected:u64 = call(i6,ee,two6) {"function":"ca_read_be"}
  actual:u64 = call(i6,e6,two6) {"function":"ca_read_be"}
  count_ok:bool = compare.eq(actual,expected)
  branch count_ok records(i6,w6,n6,e6,expected,row6,manifests) coverage()
block records(i7:readbuf,w7:mutbuf,n7:u64,e7:u64,c7:u64,row7:u64,manifests7:u64)
  rc:u32 = call(i7,w7,manifests7,e7,row7,n7,c7) {"function":"cvc_bind"}
  z7:u32 = const() {"value":0}
  ok7:bool = compare.eq(rc,z7)
  branch ok7 nonzero(i7,w7,n7,c7,row7) fail(rc)
block nonzero(i8:readbuf,w8:mutbuf,n8:u64,c8:u64,row8:u64)
  valid8:bool = call(i8,row8,c8) {"function":"cvc_claims_nonzero"}
  branch valid8 validated() bad_binding()
block validated()
  accept:u32 = const() {"value":0}
  ret(accept)
block truncated()
  trunc_code:u32 = const() {"value":211}
  ret(trunc_code)
block namespace()
  namespace_code:u32 = const() {"value":212}
  ret(namespace_code)
block coverage()
  coverage_code:u32 = const() {"value":213}
  ret(coverage_code)
block bad_binding()
  digest_code:u32 = const() {"value":214}
  ret(digest_code)
block fail(reason:u32)
  ret(reason)
end
