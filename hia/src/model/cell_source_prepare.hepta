  blank_value:u8 = const() {"value":32}
  _ = buffer.store(pw,blank_at,blank_value)
  next_space:u64 = const() {"value":1}
  newdest:u64 = int.add.wrap(pd,next_space)
  jump out(pw,pp,newdest,pe,pv)
block out(ow:mutbuf,op:u64,od:u64,oe:u64,ov:u8)
