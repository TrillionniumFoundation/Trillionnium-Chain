  advance_following:u64 = int.add.wrap(advance_at,advance_one)
  advance_left:u64 = int.sub.wrap(advance_count,advance_one)
  jump loop(advance_i,advance_following,advance_left,advance_incoming)
block done(done_value:u64)
  done_yes:bool = const() {"value":true}
  ret(done_value,done_yes)
block invalid()
  invalid_zero:u64 = const() {"value":0}
  invalid_no:bool = const() {"value":false}
  ret(invalid_zero,invalid_no)
end

fn wtq_output(entry_i:readbuf,entry_o:mutbuf,entry_desc:readbuf,entry_at:u64,entry_count:u64) -> (u64) effects(read,write,trap) entry(entry)
block entry(entry_i:readbuf,entry_o:mutbuf,entry_desc:readbuf,entry_at:u64,entry_count:u64)
  entry_dry:bool = const() {"value":false}
  entry_needed:u64 = call(entry_i,entry_o,entry_desc,entry_at,entry_count,entry_dry) {"function":"wtq_hits"}
  ret(entry_needed)
end

fn wtq_hits(entry_i:readbuf,entry_o:mutbuf,entry_desc:readbuf,entry_at:u64,entry_count:u64,entry_write:bool) -> (u64) effects(read,write,trap) entry(entry)
block entry(entry_i:readbuf,entry_o:mutbuf,entry_desc:readbuf,entry_at:u64,entry_count:u64,entry_write:bool)
  entry_first_out:u64 = const() {"value":8}
  jump loop(entry_i,entry_o,entry_desc,entry_at,entry_count,entry_write,entry_first_out)
block loop(loop_i:readbuf,loop_o:mutbuf,loop_desc:readbuf,loop_at:u64,loop_count:u64,loop_write:bool,loop_out_at:u64)
  loop_zero:u64 = const() {"value":0}
  loop_more:bool = compare.ne(loop_count,loop_zero)
  branch loop_more hit(loop_i,loop_o,loop_desc,loop_at,loop_count,loop_write,loop_out_at) done(loop_out_at)
block hit(hit_i:readbuf,hit_o:mutbuf,hit_desc:readbuf,hit_at:u64,hit_count:u64,hit_write:bool,hit_out_at:u64)
  hit_word:u64 = const() {"value":4}
  hit_qword:u64 = const() {"value":8}
  hit_stride:u64 = const() {"value":24}
  hit_skip_two:u64 = const() {"value":16}
  hit_row:u64 = call(hit_i,hit_at,hit_word) {"function":"wa_read"}
  hit_entry_at:u64 = int.mul.wrap(hit_row,hit_stride)
  hit_mask_at:u64 = int.add.wrap(hit_entry_at,hit_qword)
  hit_length_at:u64 = int.add.wrap(hit_entry_at,hit_skip_two)
  hit_length:u64 = call(hit_desc,hit_length_at,hit_qword) {"function":"wa_read"}
  hit_next_out:u64 = int.add.wrap(hit_out_at,hit_qword)
  branch hit_write insert(hit_i,hit_o,hit_desc,hit_at,hit_count,hit_out_at,hit_next_out,hit_row,hit_length,hit_entry_at,hit_mask_at) measure(hit_i,hit_o,hit_desc,hit_at,hit_count,hit_next_out,hit_length)
block measure(measure_i:readbuf,measure_o:mutbuf,measure_desc:readbuf,measure_at:u64,measure_count:u64,measure_out_at:u64,measure_length:u64)
  measure_next:u64 = int.add.wrap(measure_out_at,measure_length)
  measure_no:bool = const() {"value":false}
  jump advance(measure_i,measure_o,measure_desc,measure_at,measure_count,measure_no,measure_next)
block insert(insert_i:readbuf,insert_o:mutbuf,insert_desc:readbuf,insert_at:u64,insert_count:u64,insert_out_at:u64,insert_row_at:u64,insert_row:u64,insert_length:u64,insert_entry_at:u64,insert_mask_at:u64)
  insert_word:u64 = const() {"value":4}
  insert_qword:u64 = const() {"value":8}
  insert_yes:bool = const() {"value":true}
  insert_length_at:u64 = int.add.wrap(insert_out_at,insert_word)
  _ignored6:u64 = call(insert_o,insert_out_at,insert_row,insert_word,insert_yes) {"function":"wa_word"}
  _ignored7:u64 = call(insert_o,insert_length_at,insert_length,insert_word,insert_yes) {"function":"wa_word"}
  insert_geometry:u64 = call(insert_desc,insert_entry_at,insert_qword) {"function":"wa_read"}
  insert_mask:u64 = call(insert_desc,insert_mask_at,insert_qword) {"function":"wa_read"}
  insert_next:u64 = call(insert_i,insert_o,insert_geometry,insert_mask,insert_yes,insert_row_at) {"function":"wj_row"}
  jump advance(insert_i,insert_o,insert_desc,insert_at,insert_count,insert_yes,insert_next)
block advance(advance_i:readbuf,advance_o:mutbuf,advance_desc:readbuf,advance_at:u64,advance_count:u64,advance_write:bool,advance_next:u64)
  advance_word:u64 = const() {"value":4}
  advance_one:u64 = const() {"value":1}
  advance_next_at:u64 = int.add.wrap(advance_at,advance_word)
  advance_left:u64 = int.sub.wrap(advance_count,advance_one)
  jump loop(advance_i,advance_o,advance_desc,advance_next_at,advance_left,advance_write,advance_next)
block done(done_extent:u64)
  ret(done_extent)
end
