  mask_at:u64 = const() {"value":459984}
  mask:u64 = call(em,mask_at) {"function":"cp_get"}
  one_e:u64 = const() {"value":1}
  bit_e:u64 = int.shl.checked(one_e,et)
  selected_e:u64 = bit.or(mask,bit_e)
  saved_e:u64 = call(em,mask_at,selected_e) {"function":"cp_put"}
  jump advance(em,en,ei,et,ev)
