  branch exact memory(si,so,sn,sf,sc) bad()
block memory(mi:readbuf,mo:mutbuf,mn:u64,mf:u64,mc:u64)
  a0:u64 = const() {"value":24}
  a1:u64 = const() {"value":32}
  a2:u64 = const() {"value":40}
