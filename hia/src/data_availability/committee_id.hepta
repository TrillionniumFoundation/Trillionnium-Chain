  d3:u64 = const() {"value":20}
  d4:u64 = const() {"value":24}
  bound1:u64 = call(r,end) {"function":"daav_u32"}
  at2:u64 = int.add.wrap(end,d1)
  bound2:u64 = call(r,at2) {"function":"tr_read"}
  at3:u64 = int.add.wrap(end,d2)
  bound3:u64 = call(r,at3) {"function":"tr_read"}
  at4:u64 = int.add.wrap(end,d3)
  bound4:u64 = call(r,at4) {"function":"daav_u32"}
  at5:u64 = int.add.wrap(end,d4)
  bound5:u64 = call(r,at5) {"function":"daav_u32"}
  sb:bool = compare.eq(schema,one)
  b1:bool = compare.ne(bound1,zero)
  b2:bool = compare.ne(bound2,zero)
  b3:bool = compare.ne(bound3,zero)
  b4:bool = compare.ne(bound4,zero)
  b5:bool = compare.ne(bound5,zero)
  c1:bool = bool.and(b1,b2)
  c2:bool = bool.and(b3,b4)
  c3:bool = bool.and(c1,c2)
  c4:bool = bool.and(sb,b5)
  okay:bool = bool.and(c3,c4)
  ret(okay)
end

