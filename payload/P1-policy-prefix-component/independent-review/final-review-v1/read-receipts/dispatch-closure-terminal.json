tive_growth {\\\\n56:             self.policy.growth_id()\\\\n57:         } else if self.arithmetic_facts.is_some() {\\\\n58:             self.policy.arithmetic_facts_id()\\\\n59:         } else {\\\\n60:             self.policy.id()\\\\n61:         }\\\\n62:     }\\\\n63: \\\\n64:     /// Retained Rust object-storage charge for this volatile arithmetic owner.\\\\n65:     /// Does not include allocator metadata, ordinary per-call verifier workspace,\\\\n66:     /// returned values or optional request-observer rows; never an RSS claim.\\\\n67:     pub fn arithmetic_facts_software_bytes(&self) -> Option<usize> {\\\\n68:         self.arithmetic_facts\\\\n69:             .as_ref()\\\\n70:             .map(ArithmeticFactCache::software_bytes)\\\\n71:     }\\\\n72: }\\\\n73: \\\\n74: /// Explicit client for the separately signed arithmetic profile. There is no\\\\n75: /// fallback to raw or another profile. The original client and its optional\\\\n76: /// absolute-deadline entry keep their exact expected r14 profile and behavior.\\\\n77: pub fn call_public_protected_v3_with_arithmetic_facts(\\\\n78:     address: SocketAddr,\\\\n79:     request: &Request,\\\\n80:     settings: &Settings,\\\\n81:     pinned_server: &str,\\\\n82:     caller: &DevelopmentIdentity,\\\\n83:     policy: PublicPolicy,\\\\n84:     outer_deadline: Option<Instant>,\\\\n85: ) -> (Result<PublicReply>, PublicClientMetrics) {\\\\n86:     call_public_protected_v3_with_profile(\\\\n87:         address,\\\\n88:         request,\\\\n89:         settings,\\\\n90:         pinned_server,\\\\n91:         caller,\\\\n92:         (policy, ClientProfile::ArithmeticFacts),\\\\n93:         outer_deadline,\\\\n94:     )\\\\n95: }\\\\n96: \\\\n97: /// Fixed per-request observation. These are actual path facts, not CPU estimates\\\\n98: /// and not additional work/payment/admission credit. None means unfinished or\\\\n99: /// unobserved, never a successful no-work shortcut.\\\\n100: #[derive(Clone, Copy, Debug, Serialize)]\\\",\\r\\n    \\\"growth_capture\\\": {\\r\\n      \\\"path\\\": \\\"/private/tmp/chain-public-policy-prefix-independent-review-20261114-v1/M8--trillionnium--crates--trnm-pon-node--src--ingress--public_v3--growth.rs.original\\\",\\r\\n      \\\"bytes\\\": 10762,\\r\\n      \\\"sha256\\\": \\\"2799bd30b73fae3b89b894e2c55f2dcb4c3231b670eb40f4f79a6e29d8362dbd\\\",\\r\\n      \\\"git_blob\\\": \\\"c3ff122d03708dc472dfa9ce21ce3729014aff08\\\"\\r\\n    },\\r\\n    \\\"growth_lines_1_to_60\\\": \\\"1: //! Explicit PGH2/PNP2 development slice on the original protected-v3 transport.\\\\n2: //! No pool, history-import service, automatic parent recovery or new supervisor.\\\\n3: //! Current eligibility walks retained ancestor headers under the original budget.\\\\n4: use super::*;\\\\n5: use crate::store::growth::GrowthWorkCheckedPacket;\\\\n6: use crate::{GrowthPacket, GrowthProgress};\\\\n7: \\\\n8: pub const GROWTH_PROFILE: &str = \\\\\\\"public-protected-growth-development-v1\\\\\\\";\\\\n9: \\\\n10: #[derive(Clone, Copy)]\\\\n11: pub(super) enum ClientProfile {\\\\n12:     Legacy,\\\\n13:     ArithmeticFacts,\\\\n14:     NativeGrowthV1,\\\\n15:     PqHistoryV4,\\\\n16: }\\\\n17: impl ClientProfile {\\\\n18:     pub(super) fn id(self, policy: PublicPolicy) -> Hash {\\\\n19:         match self {\\\\n20:             Self::Legacy => policy.id(),\\\\n21:             Self::ArithmeticFacts => policy.arithmetic_facts_id(),\\\\n22:             Self::NativeGrowthV1 => policy.growth_id(),\\\\n23:             Self::PqHistoryV4 => policy.pq_history_id(),\\\\n24:         }\\\\n25:     }\\\\n26:     pub(super) fn operation_allowed(self, op: u8) -> bool {\\\\n27:         match self {\\\\n28:             Self::Legacy | Self::ArithmeticFacts => (1..=5).contains(&op),\\\\n29:             Self::NativeGrowthV1 => (6..=8).contains(&op),\\\\n30:             Self::PqHistoryV4 => matches!(op, 2 | 3),\\\\n31:         }\\\\n32:     }\\\\n33: }\\\\n34: \\\\n35: impl PublicPolicy {\\\\n36:     /// Fresh explicit resource identity. The original v3 transport, ticket,\\\\n37:     /// CPU, queue, response and kernel limits remain bound through policy.id().\\\\n38:     pub fn growth_id(self) -> Hash {\\\\n39:         hash(b\\\\\\\"public-protected-growth-profile-v1\\\\\\\", &[\\\\n40:             GROWTH_PROFILE.as_bytes(), &self.id(),\\\\n41:             b\\\\\\\"PGH2-PNP2-permanent-account-growth-native-v2/original-node-network-parameters-genesis-namespace/ops6-growth_submit_v1-7-growth_packet_status_v1-8-growth_head_v1/other-ops-refused-before-cookie/no-pool-history-auto-parent-recovery-miner-or-poller/packet1048576-hex-body2097216/submit-and-exact-observation-original-paid-proof-queue-and-CPU-domain/head-original-read-queue-fixed-metadata-snapshot-no-State/response16384/exact-single-read-snapshot-full-retained-W1-M06-account-proof-deltas-active-membership-sql8193-no-authority/submit-current-context-owner-release-full-W1-original-owner-reacquire-current-clock-context-parent-and-epoch/no-State-cache/complete-work-key-domain-public-growth-complete-work-identity-v1-shares-original-fixed4096-set/admission-precommit-cancel/original-postcommit-activation-noncancellable-paid-outer-tail-reorg-depth-not-latency-qualified/no-new-credit-or-process-owner/ordinary-original-durable-service-epoch-fence/development-only-production-activation-false\\\\\\\",\\\\n42:         ])\\\\n43:     }\\\\n44: }\\\\n45: impl PublicServer {\\\\n46:     /// Trusted setup changes only the explicit profile. It preserves the same\\\\n47:     /// actual CPU/intake domain and starts no listener or owner.\\\\n48:     pub fn with_native_growth(mut self) -> Result<Self> {\\\\n49:         ensure(\\\\n50:             !self.identity.is_pq() && !self.native_growth && self.arithmetic_facts.is_none(),\\\\n51:             \\\\\\\"PUBLIC_GROWTH_PROFILE\\\\\\\",\\\\n52:         )?;\\\\n53:         self.native_growth = true;\\\\n54:         Ok(self)\\\\n55:     }\\\\n56:     pub(super) fn operation_allowed(&self, op: u8) -> bool {\\\\n57:         if self.identity.is_pq() {\\\\n58:             ClientProfile::PqHistoryV4.operation_allowed(op)\\\\n59:         } else if self.native_growth {\\\\n60:             ClientProfile::NativeGrowthV1.operation_allowed(op)\\\",\\r\\n    \\\"scope\\\": \\\"The three ordinary server call sites reach PublicPolicy::id through resource_profile. Other profile domains remain separate; unchanged bodies are not a claim of complete callgraph coverage.\\\",\\r\\n    \\\"tests_or_source_helpers_run\\\": false\\r\\n  }\\r\\n}\\r\\n\",\"text_is_lossy\":false,\"truncated_before_offset\":false,\"utf8_pending\":false}",
