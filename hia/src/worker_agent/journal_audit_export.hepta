  _ = loan.end(row_view)
  jump advance(ei,eo,es,ec,eb,er,json_end,md_end)
block advance(ai:readbuf,ao:mutbuf,as:mutbuf,ac:u64,ab:u64,ar:u64,aj:u64,am:u64)
  step:u64 = const() {"value":1}
  next_row:u64 = int.add.wrap(ar,step)
  next_bits:u64 = int.shr.checked(ab,step)
  jump rows(ai,ao,as,ac,next_bits,next_row,aj,am)
block finish()
  ret()
end
