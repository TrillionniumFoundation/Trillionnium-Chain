fn dh_relations(raw:readbuf) -> (bool) effects(read,write,trap) entry(entry)
block entry(raw:readbuf)
  words:u64 = const() {"value":4}
  source_chain:u64 = const() {"value":0}
  target_chain:u64 = const() {"value":240}
