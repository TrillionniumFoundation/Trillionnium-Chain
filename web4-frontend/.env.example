# Query API base URL used by dashboard API client
NEXT_PUBLIC_QUERY_API_BASE_URL=http://127.0.0.1:8080

# Optional defaults for dashboard read-only widgets
NEXT_PUBLIC_DASHBOARD_TASK_ID=341
NEXT_PUBLIC_DASHBOARD_AUDIT_SUBJECT=did:trnm:core-rpc

# Optional normalized audit event stream pagination controls
# positive integer, fallback default: 60
NEXT_PUBLIC_DASHBOARD_NORMALIZED_AUDIT_EVENT_LIMIT=60
# positive integer, fallback default: 4
NEXT_PUBLIC_DASHBOARD_NORMALIZED_AUDIT_MAX_PAGES=4
