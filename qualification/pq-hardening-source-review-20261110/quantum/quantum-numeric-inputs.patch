+def scenario_decimal(value: str) -> Decimal:
+    """Read a bounded decimal-text premise, without bool/float coercion.
+
+    The exponent bound is a calculator input limit, not a measured cost floor.
+    It also applies to encoded zero, before arithmetic or integer conversion.
+    """
+    if type(value) is not str or not 1 <= len(value) <= MAX_DECIMAL_CHARS:
+        raise ValueError("SCENARIO_DECIMAL")
+    try:
+        number = Decimal(value)
+    except InvalidOperation as error:
+        raise ValueError("SCENARIO_DECIMAL") from error
+    if number.is_finite() and abs(number.adjusted()) > MAX_DECIMAL_EXPONENT:
+        raise ValueError("SCENARIO_DECIMAL_RANGE")
+    return number
