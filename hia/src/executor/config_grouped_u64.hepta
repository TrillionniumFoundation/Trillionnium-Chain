fn ws_width(wi:readbuf,wp:usize,we:usize) -> (usize) effects(read,trap) entry(entry)
block entry(wi:readbuf,wp:usize,we:usize)
  has_one:bool = compare.lt(wp,we)
  branch has_one first(wi,wp,we) none()
block first(fi:readbuf,fp:usize,fe:usize)
  first:u8 = buffer.load(fi,fp)
  tab:u8 = const() {"value":9}
  cr:u8 = const() {"value":13}
  space:u8 = const() {"value":32}
  above:bool = compare.ge(first,tab)
  below:bool = compare.le(first,cr)
  tab_through_cr:bool = bool.and(above,below)
  ascii_space:bool = compare.eq(first,space)
  ascii_ws:bool = bool.or(ascii_space,tab_through_cr)
  branch ascii_ws one() multibyte(fi,fp,fe,first)
block multibyte(ui:readbuf,up:usize,ue:usize,ub:u8)
  mone:usize = const() {"value":1}
  next:usize = int.add.wrap(up,mone)
  has_two:bool = compare.lt(next,ue)
  branch has_two second(ui,next,ue,ub) none()
block second(ti:readbuf,tp:usize,te:usize,tb:u8)
  second_byte:u8 = buffer.load(ti,tp)
  hi:u32 = int.cast(tb) {"mode":"wrap"}
  lo:u32 = int.cast(second_byte) {"mode":"wrap"}
  shift:u32 = const() {"value":8}
  hi_shift:u32 = int.shl.checked(hi,shift)
  packed:u32 = bit.or(hi_shift,lo)
  nel:u32 = const() {"value":49797}
  is_nel:bool = compare.eq(packed,nel)
  nbsp:u32 = const() {"value":49824}
  is_nbsp:bool = compare.eq(packed,nbsp)
  double_ws:bool = bool.or(is_nel,is_nbsp)
  branch double_ws two() third_bound(ti,tp,te,packed)
block third_bound(di:readbuf,dp:usize,de:usize,dpacked:u32)
  done:usize = const() {"value":1}
  third_pos:usize = int.add.wrap(dp,done)
  has_three:bool = compare.lt(third_pos,de)
  branch has_three third(di,third_pos,dpacked) none()
block third(thi:readbuf,thp:usize,thpacked:u32)
  third_byte:u8 = buffer.load(thi,thp)
  third_low:u32 = int.cast(third_byte) {"mode":"wrap"}
  tshift:u32 = const() {"value":8}
  triple_hi:u32 = int.shl.checked(thpacked,tshift)
  triple:u32 = bit.or(triple_hi,third_low)
  ogham:u32 = const() {"value":14785152}
  is_ogham:bool = compare.eq(triple,ogham)
  line_sep:u32 = const() {"value":14844072}
  is_line_sep:bool = compare.eq(triple,line_sep)
  para_sep:u32 = const() {"value":14844073}
  is_para_sep:bool = compare.eq(triple,para_sep)
  narrow_nbsp:u32 = const() {"value":14844079}
  is_narrow_nbsp:bool = compare.eq(triple,narrow_nbsp)
  medium_space:u32 = const() {"value":14844319}
  is_medium_space:bool = compare.eq(triple,medium_space)
  ideographic:u32 = const() {"value":14909568}
  is_ideographic:bool = compare.eq(triple,ideographic)
  en_quad:u32 = const() {"value":14844032}
  hair_space:u32 = const() {"value":14844042}
