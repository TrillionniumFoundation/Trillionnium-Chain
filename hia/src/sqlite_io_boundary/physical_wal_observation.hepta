  same_dev:bool = compare.eq(a_dev,b_dev)
  same_ino:bool = compare.eq(a_ino,b_ino)
  progress_size:bool = compare.lt(a_size,b_size)
  progress_ops:bool = compare.lt(a_ops,b_ops)
  progress_ord:bool = compare.le(a_ord,b_ord)
  progress_clean:bool = compare.le(a_clean,b_clean)
  exact_growth:bool = compare.lt(a_growth,b_growth)
  rounded_growth:bool = compare.eq(a_growth,b_growth)
  policy_growth:bool = select(rounded,rounded_growth,exact_growth)
  exact_high:bool = compare.lt(a_high,b_high)
