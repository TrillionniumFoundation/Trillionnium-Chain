fn rfp_empty(r:readbuf,at:u64) -> (bool) effects(read,write,trap) entry(entry)
block entry(r:readbuf,at:u64)
  idx:usize = int.cast(at) {"mode":"wrap"}
  typ:u8 = buffer.load(r,idx)
  interpreter:u8 = const() {"value":0}
  native:u8 = const() {"value":3}
  launcher:u8 = const() {"value":7}
  i:bool = compare.eq(typ,interpreter)
  n:bool = compare.eq(typ,native)
  l:bool = compare.eq(typ,launcher)
  a:bool = bool.or(i,n)
  executable:bool = bool.or(a,l)
  not_exec:bool = bool.not(executable)
  nine:u64 = const() {"value":9}
  p0:u64 = int.add.wrap(at,nine)
  eight:u64 = const() {"value":8}
  p1:u64 = int.add.wrap(p0,eight)
  p2:u64 = int.add.wrap(p1,eight)
  p3:u64 = int.add.wrap(p2,eight)
  h0:u64 = call(r,p0) {"function":"tr_read"}
  h1:u64 = call(r,p1) {"function":"tr_read"}
  h2:u64 = call(r,p2) {"function":"tr_read"}
  h3:u64 = call(r,p3) {"function":"tr_read"}
  e0:u64 = const() {"value":1449310910991872227}
  e1:u64 = const() {"value":2646268962349054874}
  e2:u64 = const() {"value":5517924826087534119}
  e3:u64 = const() {"value":6176777564751238564}
  q0:bool = compare.eq(h0,e0)
  q1:bool = compare.eq(h1,e1)
  q2:bool = compare.eq(h2,e2)
  q3:bool = compare.eq(h3,e3)
  left:bool = bool.and(q0,q1)
  right:bool = bool.and(q2,q3)
  digest:bool = bool.and(left,right)
  empty_ok:bool = bool.and(not_exec,digest)
  ret(empty_ok)
end
