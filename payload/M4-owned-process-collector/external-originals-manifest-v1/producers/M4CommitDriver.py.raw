import pathlib,subprocess,os,json,datetime,hashlib,stat
W=pathlib.Path("/private/tmp/chain-M4-owned-process-collector-20261114")
E=pathlib.Path("/private/tmp/chain-M4-owned-process-collector-review-20261114-v1")
O=E/"commit-v1";O.mkdir(exist_ok=False)
D=W/"docs/audit/20261114-m4-closed-exec-gate"
P=pathlib.Path("/private/tmp/chain-consolidation-20261114-root/original-repository-truth-1a7afc-failure-copy-v1")
H="1a7afcdb820b051d1e4bfde3d436f96fc050c487"
env=dict(os.environ,PATH="/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin",GIT_NO_LAZY_FETCH="1",GIT_OPTIONAL_LOCKS="0",GIT_NO_REPLACE_OBJECTS="1",PYTHONDONTWRITEBYTECODE="1")
def run(argv,label,timeout=60):
 p=subprocess.run(argv,cwd=W,env=env,stdout=subprocess.PIPE,stderr=subprocess.PIPE,timeout=timeout)
 for suffix,r in (("stdout",p.stdout),("stderr",p.stderr)):(O/(label+"."+suffix)).write_bytes(r)
 assert p.returncode==0,(label,p.returncode,p.stderr.decode())
 return p.stdout
def git(*args):return subprocess.check_output(["/usr/bin/git","-C",str(W),*args],env=env,timeout=60)
assert git("rev-parse","HEAD").decode().strip()==H
run(["bash","scripts/project-preflight.sh"],"preflight-before-evidence")
spec=[
("original-repository-truth-1a7afc-failure-v1.zip","original-repository-truth-1a7afc-failure-v1.zip",152665,"c67721b25a546d73b25b498c6afbeb1e6338fb267eea202403d2e167f2bf469a"),
("EVIDENCE_INDEX.json","original-run-EVIDENCE_INDEX.json",14929,"d9be663934186c7c79b68f408841a2bc686b33a47dfba569307c3ad5f436b66e"),
("original-package-summary.json","original-run-package-summary.json",1111,"bff939e4545e35a75cb31991a4e2864c41dde622f097562901aec40be3415dcf"),
("copy-verification.json","original-run-copy-verification.json",2793,"f296c259e471a0bf1fce198b36482cba809f0bb784007242803000bc9507e4c1")]
copy_rows=[]
for src,name,n,h in spec:
 path=P/src;fd=os.open(path,os.O_RDONLY|os.O_CLOEXEC|os.O_NOFOLLOW|os.O_NONBLOCK)
 try:
  a=os.fstat(fd);assert stat.S_ISREG(a.st_mode) and a.st_nlink==1 and a.st_size==n
  with os.fdopen(fd,"rb",closefd=False) as f:r=f.read(n+1)
  b=os.fstat(fd);assert (a.st_dev,a.st_ino,a.st_size,a.st_mtime_ns,a.st_ctime_ns)==(b.st_dev,b.st_ino,b.st_size,b.st_mtime_ns,b.st_ctime_ns)
 finally:os.close(fd)
 assert len(r)==n and hashlib.sha256(r).hexdigest()==h
 with (D/name).open("xb") as f:f.write(r)
 assert (D/name).read_bytes()==r
 copy_rows.append({"source_path":str(path),"path":str((D/name).relative_to(W)),"bytes":n,"sha256":h})
readme=(D/"README.md").read_text()
readme+="\nThe [complete original failed run](original-repository-truth-1a7afc-failure-v1.zip), [original member index](original-run-EVIDENCE_INDEX.json), [package summary](original-run-package-summary.json) and [verified copy receipt](original-run-copy-verification.json) retain the coordinator's 42-member package. It contains 39 original execution files plus the original driver, packager and index. The original failure remains a failure; this copy does not qualify the changed collector or a later full lane.\n"
(D/"README.md").write_text(readme)
rows=[]
for f in sorted(D.iterdir()):
 if f.name=="EVIDENCE_INDEX.json":continue
 r=f.read_bytes();rows.append({"path":f.name,"bytes":len(r),"sha256":hashlib.sha256(r).hexdigest()})
(D/"EVIDENCE_INDEX.json").write_text(json.dumps({"schema":"trnm-M4-component-evidence-index-v1","base":H,"files":rows,"linux_execution_included":"original failed full lane only; no changed-source Linux run"},indent=2)+"\n")
sources=["scripts/w1_owned_process_collector_v1.py","scripts/test_w1_owned_process_collector_v1.py"]
allowed=sources+[str(f.relative_to(W)) for f in sorted(D.iterdir())]
assert set(git("diff","--name-only").decode().splitlines())==set(sources)
assert set(git("ls-files","--others","--exclude-standard").decode().splitlines())==set(allowed)-set(sources)
run(["/usr/bin/git","add","--",*allowed],"git-add")
assert set(git("diff","--cached","--name-only").decode().splitlines())==set(allowed)
run(["/usr/bin/git","diff","--cached","--check"],"staged-diff-check")
run(["bash","scripts/project-preflight.sh","--staged"],"preflight-staged")
staged=git("diff","--cached","--binary","--full-index");(O/"staged.patch").write_bytes(staged)
run(["/usr/bin/git","commit","-m","fix(ci): preserve closed exec gate refusal before cleanup escalation"],"git-commit",120)
head=git("rev-parse","HEAD").decode().strip();tree=git("rev-parse","HEAD^{tree}").decode().strip();parent=git("rev-parse","HEAD^").decode().strip();assert parent==H
assert not git("status","--porcelain=v1")
patch=git("diff","--binary","--full-index",H,head);assert patch==staged
(O/"commit.patch").write_bytes(patch)
raw_commit=git("cat-file","commit",head);(O/"commit-object.raw").write_bytes(raw_commit)
identities=[]
for path in allowed:
 r=git("show",head+":"+path);oid=git("rev-parse",head+":"+path).decode().strip()
 identities.append({"path":path,"bytes":len(r),"sha256":hashlib.sha256(r).hexdigest(),"git_blob":oid})
summary={"schema":"trnm-M4-closed-gate-component-commit-v1","committed_at":datetime.datetime.now(datetime.timezone.utc).isoformat(),"worktree":str(W),"branch":git("branch","--show-current").decode().strip(),"head":head,"tree":tree,"parent":parent,"clean":True,"paths":identities,"original14_source_ast_preserved":True,"added_deterministic_controls":2,"syntax_compilation_passed":True,"native_suite_run_on_changed_source":False,"full_lane_pass_on_changed_source":False,"remote_write":False,"coordinator_linux_validation_pending":True,"original_failed_receipt_copies":copy_rows,"patch":{"path":str(O/"commit.patch"),"bytes":len(patch),"sha256":hashlib.sha256(patch).hexdigest()}}
r=(json.dumps(summary,indent=2)+"\n").encode();(O/"commit-summary.json").write_bytes(r)
print(json.dumps({"head":head,"tree":tree,"parent":parent,"path_count":len(allowed),"clean":True,"summary":{"path":str(O/"commit-summary.json"),"bytes":len(r),"sha256":hashlib.sha256(r).hexdigest()},"patch":summary["patch"],"source_files":identities[:2]}))
