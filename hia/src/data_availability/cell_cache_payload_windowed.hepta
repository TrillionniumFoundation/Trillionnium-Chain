  feed_ok:bool = bool.and(feed_x,phase_live)
  branch feed_ok feed(xr,xw,xn) finish_check(xo,xw,xn,final_x,phase_live,phase_empty)
block feed(ur:readbuf,uw:mutbuf,un:u64)
  head_u:u64 = const() {"value":8}
  pos_u:u64 = const() {"value":1256}
  limit_u:u64 = const() {"value":4194304}
