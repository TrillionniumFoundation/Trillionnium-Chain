+          grep -E '^Ran 5 tests in ' "$OUT/verifier-reader-controls.log"
+          grep -x 'OK' "$OUT/verifier-reader-controls.log"
+      - name: Require strict owner-death evidence controls
+        shell: bash
+        run: |
+          set -euo pipefail
+          python3 -B scripts/ci/test_history_verifier_lifeline_v1.py 2>&1 | tee "$OUT/verifier-lifeline-reader-controls.log"
