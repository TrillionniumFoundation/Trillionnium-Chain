  idx:usize = int.cast(where) {"mode":"wrap"}
  label:u8 = int.cast(i) {"mode":"wrap"}
  _ = buffer.store(w,idx,label)
  one:u8 = const() {"value":1}
  next:u8 = int.add.wrap(count,one)
  _ = buffer.store(w,slot,next)
  ret(where)
end

