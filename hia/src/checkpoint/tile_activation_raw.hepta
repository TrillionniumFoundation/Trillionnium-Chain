  e2:u64 = const() {"value":24}
  e3:u64 = const() {"value":32}
  a0:u64 = const() {"value":1168}
  a1:u64 = const() {"value":1176}
  a2:u64 = const() {"value":1184}
  a3:u64 = const() {"value":1192}
