  z_row:u64 = const() {"value":0}
  bare:bool = compare.eq(reserved,z_row)
  nonempty:bool = compare.gt(a,z_row)
  numeric_floor:u64 = const() {"value":64}
  empty_ceiling:u64 = const() {"value":80}
  numeric:bool = compare.ge(l_code,numeric_floor)
  requires_text:bool = compare.ge(l_code,empty_ceiling)
  got_text:bool = compare.gt(l_vlen,z_row)
  token_shape:bool = compare.eq(requires_text,got_text)
  both:bool = bool.and(bare,nonempty)
  shape:bool = bool.and(both,token_shape)
  both_pieces:bool = compare.gt(b,z_row)
  correct_suf:bool = compare.eq(numeric,both_pieces)
  text_valid:bool = bool.and(shape,correct_suf)
  floor_data:u64 = const() {"value":960}
  in_data:bool = compare.ge(rel,floor_data)
  start:u64 = int.add.wrap(base,rel)
  p_end:u64 = int.add.wrap(start,a)
  s_end:u64 = int.add.wrap(p_end,b)
  extent:bool = compare.le(s_end,l_n)
  ab:u64 = int.add.wrap(a,b)
  total:u64 = int.add.wrap(ab,l_vlen)
  fit_out:bool = compare.le(total,l_cap)
  max_output:u64 = const() {"value":2048}
  hard_fit:bool = compare.le(total,max_output)
  data_ok:bool = bool.and(in_data,extent)
  fit_report:bool = bool.and(fit_out,hard_fit)
  fit_both:bool = bool.and(data_ok,fit_report)
  ready:bool = bool.and(text_valid,fit_both)
  branch ready token_policy(l_i,l_o,l_s,l_code,start,p_end,a,b,l_vlen,total,z_row) refuse()
