  exact:bool = bool.and(ab,cd)
  branch exact roots(m,base,source,target) bad()
block roots(rm:mutbuf,rb:u64,rs:u64,rt:u64)
  state_left:u64 = const() {"value":104}
  state_right:u64 = const() {"value":136}
  journal_left:u64 = const() {"value":168}
  journal_right:u64 = const() {"value":200}
  state_b:u64 = const() {"value":441000}
  journal_b:u64 = const() {"value":440000}
  w:u64 = const() {"value":32}
  s_ix:u64 = int.mul.wrap(rs,w)
  t_ix:u64 = int.mul.wrap(rt,w)
  ss:bool = call(rm,rb,state_left,state_b,s_ix) {"function":"hfs_check_root"}
  st:bool = call(rm,rb,state_right,state_b,t_ix) {"function":"hfs_check_root"}
  js:bool = call(rm,rb,journal_left,journal_b,s_ix) {"function":"hfs_check_root"}
  jt:bool = call(rm,rb,journal_right,journal_b,t_ix) {"function":"hfs_check_root"}
  s_ok:bool = bool.and(ss,st)
  j_ok:bool = bool.and(js,jt)
