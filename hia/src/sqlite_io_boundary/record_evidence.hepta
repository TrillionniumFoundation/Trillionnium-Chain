fn evidence_first_valid(tag:u64,code:u64) -> (bool) effects() entry(entry)
block entry(tag:u64,code:u64)
  zero:u64 = const() {"value":0}
  one:u64 = const() {"value":1}
  two:u64 = const() {"value":2}
  full:u64 = const() {"value":13}
  code_max:u64 = const() {"value":2147483647}
  none:bool = compare.eq(tag,zero)
  empty:bool = compare.eq(code,zero)
  unknown:bool = compare.eq(tag,two)
  positive:bool = compare.gt(code,zero)
  code_fit:bool = compare.le(code,code_max)
  record:bool = compare.eq(tag,one)
  rec_code:bool = compare.eq(code,full)
  pair_a:bool = bool.and(none,empty)
  pair_b:bool = bool.and(record,rec_code)
  code_ok:bool = bool.and(positive,code_fit)
  pair_c:bool = bool.and(unknown,code_ok)
  ab:bool = bool.or(pair_a,pair_b)
  yes:bool = bool.or(ab,pair_c)
  ret(yes)
end
