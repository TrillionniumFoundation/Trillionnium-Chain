  shift:u64 = const() {"value":8}
  sixteen:u64 = const() {"value":16}
  imd_tag:u64 = select(eu,typnum,typtxt)
  data_width:u64 = int.shl.checked(ew,shift)
  field_header:u64 = int.add.wrap(data_width,imd_tag)
  wrote:u64 = call(es,ed,ek,field_header) {"function":"imp_head"}
  destination:u64 = int.add.wrap(ed,sixteen)
  dstpos:usize = int.cast(destination) {"mode":"wrap"}
  _ = buffer.copy_range(es,ei,dstpos,eo,el)
  next:u64 = int.add.wrap(eb,ew)
  ret(next)
block no()
  refused:u64 = const() {"value":0}
  ret(refused)
