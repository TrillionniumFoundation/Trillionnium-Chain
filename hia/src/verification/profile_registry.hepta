fn f0(input:readbuf,output:mutbuf,scratch:mutbuf) -> (u32) effects(read,write,trap) entry(entry)
block entry(input:readbuf,output:mutbuf,scratch:mutbuf)
  extent:usize = buffer.len(input)
  minimum:usize = const() {"value":92}
  enough:bool = compare.ge(extent,minimum)
  branch enough header(input,output,extent) malformed()
block header(hi:readbuf,ho:mutbuf,hn:usize)
  zero:u64 = const() {"value":0}
  four:u64 = const() {"value":4}
  eight:u64 = const() {"value":8}
  magic:u64 = call(hi,zero,four) {"function":"rac_read_le"}
  expected_magic:u64 = const() {"value":827478102}
