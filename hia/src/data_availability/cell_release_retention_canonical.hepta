fn t2_config(b25_r:readbuf) -> (u32) effects(read,write,trap) entry(arena)
block arena(b25_r:readbuf)
  b25_store_pos:u64 = const() {"value":8}
  b25_store:bool = call(b25_r,b25_store_pos) {"function":"vrt_nonzero"}
  b25_capacity_pos:u64 = const() {"value":40}
  b25_capacity_width:u64 = const() {"value":8}
  b25_capacity:u64 = call(b25_r,b25_capacity_pos,b25_capacity_width) {"function":"ca_read_be"}
  b25_count_pos:u64 = const() {"value":48}
  b25_count_width:u64 = const() {"value":4}
  b25_count:u64 = call(b25_r,b25_count_pos,b25_count_width) {"function":"ca_read_be"}
  b25_min:u64 = const() {"value":4096}
  b25_max:u64 = const() {"value":68719476736}
  b25_lo_mask:u64 = const() {"value":4095}
  b25_z:u64 = const() {"value":0}
  b25_one:u64 = const() {"value":1}
  b25_floor:bool = compare.ge(b25_capacity,b25_min)
  b25_ceil:bool = compare.le(b25_capacity,b25_max)
  b25_size_ok:bool = bool.and(b25_floor,b25_ceil)
  b25_tail:u64 = bit.and(b25_capacity,b25_lo_mask)
  b25_align:bool = compare.eq(b25_tail,b25_z)
  b25_has_records:bool = compare.ge(b25_count,b25_one)
  b25_cap_records:bool = compare.le(b25_count,b25_min)
  b25_counts:bool = bool.and(b25_has_records,b25_cap_records)
  b25_store_ok:bool = bool.and(b25_store,b25_align)
  b25_bounded:bool = bool.and(b25_size_ok,b25_counts)
  b25_good:bool = bool.and(b25_store_ok,b25_bounded)
  branch b25_good config(b25_r) old_config()
block config(b51_r:readbuf)
  b51_versions_pos:u64 = const() {"value":52}
  b51_versions_width:u64 = const() {"value":4}
  b51_versions:u64 = call(b51_r,b51_versions_pos,b51_versions_width) {"function":"ca_read_be"}
  b51_one:u64 = const() {"value":1}
  b51_vcap:u64 = const() {"value":128}
  b51_vlo:bool = compare.ge(b51_versions,b51_one)
  b51_vhi:bool = compare.le(b51_versions,b51_vcap)
  b51_ev:bool = bool.and(b51_vlo,b51_vhi)
  branch b51_ev done() version_config()
block done()
  result:u32 = const() {"value":0}
  ret(result)
block old_config()
  bad0:u32 = const() {"value":320}
  ret(bad0)
block version_config()
  bad1:u32 = const() {"value":321}
  ret(bad1)
end

fn t2_unique(b304_r:readbuf,b304_w:mutbuf,b304_len:u64,b304_obj:u64) -> (bool) effects(read,write,trap) entry(e)
block e(b304_r:readbuf,b304_w:mutbuf,b304_len:u64,b304_obj:u64)
  b304_z:u64 = const() {"value":16032}
  jump scan(b304_r,b304_w,b304_len,b304_obj,b304_z)
block scan(b307_r:readbuf,b307_w:mutbuf,b307_len:u64,b307_obj:u64,b307_i:u64)
  b307_more:bool = compare.lt(b307_i,b307_len)
  branch b307_more probe(b307_r,b307_w,b307_len,b307_obj,b307_i) yes()
block probe(b310_r:readbuf,b310_w:mutbuf,b310_len:u64,b310_obj:u64,b310_i:u64)
  b310_wd:u64 = const() {"value":32}
  b310_eight:u64 = const() {"value":8}
  b310_z:u64 = const() {"value":0}
  b310_prior:u64 = call(b310_w,b310_i) {"function":"tr_get"}
  b310_prev_f:u64 = int.add.wrap(b310_prior,b310_wd)
  b310_this_f:u64 = int.add.wrap(b310_obj,b310_wd)
  b310_op:u64 = call(b310_r,b310_prior,b310_obj,b310_wd) {"function":"cp_equal_read"}
  b310_fund:u64 = call(b310_r,b310_prev_f,b310_this_f,b310_wd) {"function":"cp_equal_read"}
  b310_hit:u64 = bit.or(b310_op,b310_fund)
  b310_fresh:bool = compare.eq(b310_hit,b310_z)
  b310_j:u64 = int.add.wrap(b310_i,b310_eight)
  branch b310_fresh scan(b310_r,b310_w,b310_len,b310_obj,b310_j) no()
block yes()
  b323_ret_:bool = const() {"value":true}
  ret(b323_ret_)
block no()
