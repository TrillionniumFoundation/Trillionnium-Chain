fn cache_max_shm_bytes(database:u64,logical:u64,chunks:u64,manifests:u64) -> (u64) effects(trap) entry(entry)
block entry(database:u64,logical:u64,chunks:u64,manifests:u64)
  allowed:bool = call(database,logical,chunks,manifests) {"function":"cache_valid"}
  branch allowed size(database) invalid()
block size(size_database:u64)
  shift:u64 = const() {"value":12}
  pages:u64 = int.shr.checked(size_database,shift)
  padding:u64 = const() {"value":16}
  frames:u64 = int.add.checked(pages,padding)
  before_boundary:u64 = const() {"value":4095}
  rounded_frames:u64 = int.add.checked(frames,before_boundary)
  rounded_regions:u64 = int.shr.checked(rounded_frames,shift)
  first_region:u64 = const() {"value":1}
  all_regions:u64 = int.add.checked(rounded_regions,first_region)
