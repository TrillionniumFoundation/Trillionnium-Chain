  branch in_lower seek_out(no,subtraction) range_error()
block add(po:mutbuf,pb:u64,pa:u64)
  max_pos:u64 = const() {"value":18446744073709551615}
  left:u64 = int.sub.wrap(max_pos,pb)
  addition:u64 = int.add.wrap(pb,pa)
