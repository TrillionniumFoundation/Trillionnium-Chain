  end_at:u64 = call(count) {"function":"vr_row"}
  observed:u64 = int.cast(hn) {"mode":"wrap"}
  exact:bool = compare.eq(end_at,observed)
  well_formed:bool = bool.and(right_magic,typed_op)
  right_count:bool = bool.and(bounded,exact)
  valid:bool = bool.and(well_formed,right_count)
  branch valid registry(hi,ho,op,count) malformed()
block registry(ci:readbuf,co:mutbuf,cop:u64,count_c:u64)
  registry_status:u32 = call(ci,count_c) {"function":"vr_registry"}
  registry_ok:u32 = const() {"value":0}
  accepted:bool = compare.eq(registry_status,registry_ok)
  branch accepted dispatch(ci,co,cop) refuse(registry_status)
block dispatch(di:readbuf,doo:mutbuf,dop:u64)
  no_query:u64 = const() {"value":0}
  only_closed:bool = compare.eq(dop,no_query)
  branch only_closed publish(di,doo,no_query) resolve(di,doo)
block resolve(ri:readbuf,ro:mutbuf)
  id_at:u64 = const() {"value":16}
  version_at:u64 = const() {"value":48}
  digest_at:u64 = const() {"value":52}
