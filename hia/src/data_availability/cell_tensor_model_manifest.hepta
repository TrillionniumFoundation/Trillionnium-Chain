  b3_c0:u64 = const() {"value":0}
  b3_valid:bool = compare.eq(b3_c,b3_c0)
  branch b3_valid finish(b3_w) status(b3_c)
block finish(b4_w:mutbuf)
  b4_s:u64 = call(b4_w) {"function":"tr_sha_final"}
  ret(b4_s)
block status(b5_s:u64)
  ret(b5_s)
end

fn ma_tt_syntax(b1_i:readbuf,b1_n:u64,b1_files:u64,b1_start:u64) -> (u32,u64,bool) effects(read,write,trap) entry(entry)
block entry(b1_i:readbuf,b1_n:u64,b1_files:u64,b1_start:u64)
  b1_good:bool = const() {"value":true}
  b1_c0:u64 = const() {"value":0}
  jump next_file(b1_i,b1_n,b1_files,b1_start,b1_c0,b1_c0,b1_good)
block next_file(b2_i:readbuf,b2_n:u64,b2_files:u64,b2_p:u64,b2_t:u64,b2_pidx:u64,b2_ordered:bool)
  b2_c0:u64 = const() {"value":0}
  b2_end:bool = compare.eq(b2_files,b2_c0)
  branch b2_end suffix(b2_n,b2_p,b2_t,b2_ordered) file_extent(b2_i,b2_n,b2_files,b2_p,b2_t,b2_pidx,b2_ordered)
block file_extent(b3_i:readbuf,b3_n:u64,b3_files:u64,b3_p:u64,b3_t:u64,b3_pidx:u64,b3_ordered:bool)
  b3_c4:u64 = const() {"value":4}
  b3_fitsend:u64 = int.add.wrap(b3_p,b3_c4)
  b3_fits:bool = compare.le(b3_fitsend,b3_n)
  branch b3_fits header(b3_i,b3_n,b3_files,b3_p,b3_t,b3_pidx,b3_ordered) eof()
block header(b4_i:readbuf,b4_n:u64,b4_files:u64,b4_p:u64,b4_t:u64,b4_pidx:u64,b4_ordered:bool)
  b4_c2:u64 = const() {"value":2}
  b4_idx:u64 = call(b4_i,b4_p,b4_c2) {"function":"ca_read_be"}
  b4_count_at:u64 = int.add.wrap(b4_p,b4_c2)
  b4_count:u64 = call(b4_i,b4_count_at,b4_c2) {"function":"ca_read_be"}
  b4_total:u64 = int.add.wrap(b4_t,b4_count)
  b4_c0:u64 = const() {"value":0}
  b4_nonzero:bool = compare.lt(b4_c0,b4_count)
  b4_c16384:u64 = const() {"value":16384}
  b4_bounded:bool = compare.le(b4_total,b4_c16384)
  b4_valid:bool = bool.and(b4_nonzero,b4_bounded)
  b4_c40:u64 = const() {"value":0}
  b4_first:bool = compare.eq(b4_t,b4_c40)
  b4_growing:bool = compare.lt(b4_pidx,b4_idx)
  b4_asc:bool = bool.or(b4_first,b4_growing)
  b4_order:bool = bool.and(b4_ordered,b4_asc)
  branch b4_valid roster(b4_i,b4_n,b4_files,b4_p,b4_total,b4_idx,b4_order,b4_count) bad_count()
block roster(b5_i:readbuf,b5_n:u64,b5_files:u64,b5_p:u64,b5_total:u64,b5_idx:u64,b5_order:bool,b5_count:u64)
  b5_c4:u64 = const() {"value":4}
  b5_start:u64 = int.add.wrap(b5_p,b5_c4)
  b5_c5:u64 = const() {"value":5}
  b5_bytes:u64 = int.mul.wrap(b5_count,b5_c5)
  b5_minimum:u64 = int.add.wrap(b5_start,b5_bytes)
  b5_possible:bool = compare.le(b5_minimum,b5_n)
  branch b5_possible row(b5_i,b5_n,b5_files,b5_start,b5_total,b5_idx,b5_order,b5_count) truncated_roster()
block row(b6_i:readbuf,b6_n:u64,b6_files:u64,b6_p:u64,b6_total:u64,b6_idx:u64,b6_order:bool,b6_count:u64)
  b6_s:u32,b6_role:u64,b6_end:u64 = call(b6_i,b6_n,b6_p) {"function":"tt_row"}
  b6_zero:u32 = const() {"value":0}
  b6_ok:bool = compare.eq(b6_s,b6_zero)
  branch b6_ok row_done(b6_i,b6_n,b6_files,b6_end,b6_total,b6_idx,b6_order,b6_count) failure(b6_s)
block row_done(b7_i:readbuf,b7_n:u64,b7_files:u64,b7_end:u64,b7_total:u64,b7_idx:u64,b7_order:bool,b7_count:u64)
  b7_c1:u64 = const() {"value":1}
  b7_left:u64 = int.sub.wrap(b7_count,b7_c1)
  b7_c0:u64 = const() {"value":0}
  b7_done:bool = compare.eq(b7_left,b7_c0)
  b7_files_left:u64 = int.sub.wrap(b7_files,b7_c1)
  branch b7_done next_file(b7_i,b7_n,b7_files_left,b7_end,b7_total,b7_idx,b7_order) row(b7_i,b7_n,b7_files,b7_end,b7_total,b7_idx,b7_order,b7_left)
block suffix(b8_n:u64,b8_p:u64,b8_t:u64,b8_ordered:bool)
  b8_exact:bool = compare.eq(b8_p,b8_n)
  branch b8_exact ok(b8_t,b8_ordered) bad_suffix()
block ok(b9_t:u64,b9_ordered:bool)
  b9_s:u32 = const() {"value":0}
  ret(b9_s,b9_t,b9_ordered)
block eof()
  b10_s:u32 = const() {"value":6}
  jump failure(b10_s)
block bad_count()
  b11_s:u32 = const() {"value":7}
  jump failure(b11_s)
block truncated_roster()
  b12_s:u32 = const() {"value":8}
  jump failure(b12_s)
block bad_suffix()
  b13_s:u32 = const() {"value":13}
  jump failure(b13_s)
block failure(b14_s:u32)
  b14_bad:bool = const() {"value":false}
  b14_c0:u64 = const() {"value":0}
  ret(b14_s,b14_c0,b14_bad)
end

fn ma_tt_semantics(b1_i:readbuf,b1_n:u64,b1_files:u64,b1_start:u64) -> (u32) effects(read,write,trap) entry(entry)
block entry(b1_i:readbuf,b1_n:u64,b1_files:u64,b1_start:u64)
  jump file(b1_i,b1_n,b1_files,b1_start)
block file(b2_i:readbuf,b2_n:u64,b2_files:u64,b2_p:u64)
  b2_c2:u64 = const() {"value":2}
  b2_idx:u64 = call(b2_i,b2_p,b2_c2) {"function":"ca_read_be"}
  b2_c256:u64 = const() {"value":256}
  b2_valid:bool = compare.lt(b2_idx,b2_c256)
  branch b2_valid header(b2_i,b2_n,b2_files,b2_p) bad_file()
block header(b3_i:readbuf,b3_n:u64,b3_files:u64,b3_p:u64)
  b3_c2:u64 = const() {"value":2}
  b3_c:u64 = int.add.wrap(b3_p,b3_c2)
  b3_count:u64 = call(b3_i,b3_c,b3_c2) {"function":"ca_read_be"}
  b3_c4:u64 = const() {"value":4}
  b3_start:u64 = int.add.wrap(b3_p,b3_c4)
  b3_s:u32,b3_end:u64 = call(b3_i,b3_n,b3_start,b3_count) {"function":"tt_names"}
  b3_zero:u32 = const() {"value":0}
  b3_ok:bool = compare.eq(b3_s,b3_zero)
  branch b3_ok values(b3_i,b3_n,b3_files,b3_start,b3_count,b3_end) failure(b3_s)
block values(b4_i:readbuf,b4_n:u64,b4_files:u64,b4_start:u64,b4_count:u64,b4_end:u64)
  b4_s:u32 = call(b4_i,b4_n,b4_start,b4_count) {"function":"tt_values"}
  b4_zero:u32 = const() {"value":0}
  b4_ok:bool = compare.eq(b4_s,b4_zero)
  branch b4_ok complete(b4_i,b4_n,b4_files,b4_end) failure(b4_s)
block complete(b5_i:readbuf,b5_n:u64,b5_files:u64,b5_end:u64)
  b5_c1:u64 = const() {"value":1}
  b5_left:u64 = int.sub.wrap(b5_files,b5_c1)
  b5_c0:u64 = const() {"value":0}
  b5_done:bool = compare.eq(b5_left,b5_c0)
  branch b5_done yes() file(b5_i,b5_n,b5_left,b5_end)
block yes()
  b6_status:u32 = const() {"value":0}
  ret(b6_status)
block bad_file()
  b7_status:u32 = const() {"value":17}
  ret(b7_status)
block failure(b8_s:u32)
  ret(b8_s)
end
