  enough:bool = compare.ge(extent,min_a)
  branch enough decode(ei,eo,ew,en) short()
block decode(di:readbuf,do:mutbuf,dw:mutbuf,dn:usize)
  fits:bool = call(di,dw,dn) {"function":"sp_decode"}
  branch fits utf8(di,do,dw,dn) hex_bad()
block utf8(ui:readbuf,uo:mutbuf,uw:mutbuf,un:usize)
