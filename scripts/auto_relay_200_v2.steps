# Trillionnium 200-step v2 pipeline (report + soak + governance + ecosystem)
#
# The historical manifest contained 200 manually expanded invocations.  Keep the
# exact block order and iteration counts, but express each repeated block once.
# auto_relay.sh still records one fail-fast step per block and preserves the
# STOP_ON_ERROR/ROUNDS contract.

# Steps 001-050: report block, repeated ten times.
bash -lc 'set -e; for _ in $(seq 1 10); do bash scripts/v2/generate_monthly_benchmark_report.sh; (cd trillionnium && python3 ./scripts/render_nightly_summary.py && python3 ./scripts/summarize_aggressive_profile.py && python3 ./scripts/executor_profile_report.py && ./scripts/nightly_attribution.sh); done'

# Steps 051-110: soak/preflight block, repeated twelve times.
bash -lc 'set -e; for _ in $(seq 1 12); do bash scripts/v2/soak_chunk.sh; (cd trillionnium && ./scripts/check_nightly_green_streak.sh ProfAlexQI TrillionniumChain 3 && ./scripts/enforce_ci_thresholds.sh && ./scripts/testnet_preflight.sh && ./scripts/check_parallel_flaky.sh); done'

# Steps 111-160: governance/challenge protocol block, repeated ten times.
bash -lc 'set -e; for _ in $(seq 1 10); do bash scripts/v2/gov_mvp_simulation.sh; bash ./scripts/challenge_reexec_template_smoke.sh; bash ./scripts/worker_onchain_contract_smoke.sh; (cd trillionnium && ./scripts/run_v1_protocol_gates.sh && ./scripts/check_event_fields.sh); done'

# Steps 161-200: ecosystem/benchmark block, repeated eight times.
bash -lc 'set -e; for _ in $(seq 1 8); do bash scripts/v2/ecosystem_alpha_check.sh; bash ./scripts/demo_storyline.sh; (cd trillionnium && ./scripts/run_bench_regression_matrix.sh && ./scripts/run_bench_regression_mixed_sweep.sh && python3 ./scripts/analyze_mixed_sweep_correlation.py); done'
