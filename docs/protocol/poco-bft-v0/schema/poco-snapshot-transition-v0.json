        {"op": "eq", "left": "payload.consumer_id", "right": "identity.consumer_id"},
        {"op": "eq", "left": "payload.consumer_key_id", "right": "identity.consumer_key_id"},
        {"op": "none_or_gt", "left": "payload.revoked_at", "right": "payload.active_from"}
      ]
    },
    {
      "id": 3,
      "name": "consumer_nonce",
      "identity": {
        "encoding": "CEV0",
        "fields": [
          {"name": "consumer_id", "type": "Bytes", "semantic": "id", "minimum_bytes": 1, "maximum_bytes": 128},
          {"name": "consumer_key_id", "type": "Bytes", "semantic": "id", "minimum_bytes": 1, "maximum_bytes": 128},
          {"name": "provider_id", "type": "Bytes", "semantic": "id", "minimum_bytes": 1, "maximum_bytes": 128}
