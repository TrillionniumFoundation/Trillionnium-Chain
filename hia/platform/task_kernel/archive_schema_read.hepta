  code:u64,after:u64 = call(fr,fa) {"function":"arc_codepoint"}
  whitespace:bool = call(code) {"function":"arc_space"}
  branch whitespace compare(fr,fw,fn0,after,fd,fi) ascii(fr,fw,fn0,after,fd,fi,code)
block ascii(ar:readbuf,aw:mutbuf,an:u64,aa:u64,ad:u64,ai:u64,ax:u64)
  valid_i:bool = compare.lt(ai,ad)
  branch valid_i equal(ar,aw,an,aa,ad,ai,ax) no()
block equal(xr:readbuf,xw:mutbuf,xn:u64,xa:u64,xd:u64,xi:u64,xc:u64)
