      "lines": [
        {
          "line": 1,
          "text": "name: trnm-required-baseline"
        },
        {
          "line": 2,
          "text": "on:"
        },
        {
          "line": 3,
          "text": "  pull_request:"
        },
        {
          "line": 4,
          "text": "  push:"
        },
        {
          "line": 5,
          "text": "    branches: [main]"
        },
        {
          "line": 6,
          "text": "  workflow_dispatch:"
        },
        {
          "line": 7,
          "text": "permissions:"
        },
        {
          "line": 8,
          "text": "  contents: read"
        },
        {
          "line": 9,
          "text": "concurrency:"
        },
        {
          "line": 10,
          "text": "  group: portable-${{ github.workflow }}-${{ github.ref }}"
        },
        {
          "line": 11,
          "text": "  cancel-in-progress: true"
        },
        {
          "line": 12,
          "text": "env:"
        },
        {
          "line": 13,
          "text": "  CI: \"true\""
        },
        {
          "line": 14,
          "text": "  CARGO_INCREMENTAL: \"0\""
        },
        {
          "line": 15,
          "text": "  CARGO_BUILD_JOBS: \"2\""
        },
        {
          "line": 16,
          "text": "  RUST_TEST_THREADS: \"1\""
        },
        {
          "line": 17,
          "text": "  CARGO_TERM_COLOR: never"
        },
        {
          "line": 18,
          "text": "  PYTHONDONTWRITEBYTECODE: \"1\""
        },
        {
          "line": 19,
          "text": "  TRNM_EXPECTED_SOURCE_SHA: ${{ github.event_name == 'pull_request' && github.event.pull_request.head.sha || github.sha }}"
        },
        {
          "line": 20,
          "text": "jobs:"
        },
        {
          "line": 21,
          "text": "  repository-truth:"
        },
        {
          "line": 22,
          "text": "    name: repository-truth"
        },
        {
          "line": 23,
          "text": "    runs-on: ubuntu-24.04"
        },
        {
          "line": 24,
          "text": "    timeout-minutes: 45"
        },
        {
          "line": 25,
          "text": "    steps:"
        },
        {
          "line": 26,
          "text": "      - name: Checkout exact candidate"
        },
        {
          "line": 27,
          "text": "        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262"
        },
        {
          "line": 28,
          "text": "        with:"
        },
        {
          "line": 29,
          "text": "          ref: ${{ env.TRNM_EXPECTED_SOURCE_SHA }}"
        },
        {
          "line": 30,
          "text": "          fetch-depth: 0"
        },
        {
          "line": 31,
          "text": "          persist-credentials: false"
        },
        {
          "line": 32,
          "text": "      - name: Verify immutable source identity"
        },
        {
          "line": 33,
          "text": "        run: test \"$(git rev-parse HEAD)\" = \"$TRNM_EXPECTED_SOURCE_SHA\""
        },
        {
          "line": 34,
          "text": "      - name: Set isolated Cargo paths after runner allocation"
        },
        {
          "line": 35,
          "text": "        shell: bash"
        },
        {
          "line": 36,
          "text": "        run: |"
        },
        {
          "line": 37,
          "text": "          set -euo pipefail"
        },
        {
          "line": 38,
          "text": "          printf 'CARGO_HOME=%s/cargo-%s\\n' \"$RUNNER_TEMP\" \"$GITHUB_JOB\" >> \"$GITHUB_ENV\""
        },
        {
          "line": 39,
          "text": "          printf 'CARGO_TARGET_DIR=%s/target-%s\\n' \"$RUNNER_TEMP\" \"$GITHUB_JOB\" >> \"$GITHUB_ENV\""
        },
        {
          "line": 40,
          "text": "      - name: Run actual repository-truth checks"
        }
