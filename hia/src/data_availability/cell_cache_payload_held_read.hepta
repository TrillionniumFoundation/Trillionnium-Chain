  branch valid plan(mi,mo,mw,mn_,mb,rows,rc) error(st)
block plan(pi:readbuf,po:mutbuf,pw:mutbuf,pn:u64,pb:u64,pr:u64,pc:u64)
  zero:u64 = const() {"value":0}
  eight:u64 = const() {"value":8}
  size_dist:u64 = const() {"value":48}
  size_pos:u64 = int.sub.wrap(pr,size_dist)
  size:u64 = call(pi,size_pos,eight) {"function":"ca_read_be"}
  pos:u64 = call(pi,zero,eight) {"function":"rac_read_le"}
  want:u64 = call(pi,eight,eight) {"function":"rac_read_le"}
  nonempty:bool = compare.lt(zero,want)
  more:bool = compare.lt(pos,size)
  needs:bool = bool.and(nonempty,more)
  branch needs select_row(pi,po,pw,pn,pb,pr,pc,pos,want) empty(po,pos)
block select_row(si:readbuf,so:mutbuf,sw:mutbuf,sn:u64,sb:u64,sr:u64,sc:u64,sp:u64,sq:u64)
  row:u64,off:u64,count:u64 = call(si,sp,sq,sr,sc) {"function":"ch_plan"}
  num0:u64 = const() {"value":0}
