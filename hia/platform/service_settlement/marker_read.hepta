  entry_q:bool = bool.and(entry_input,entry_done)
  entry_r:bool = bool.and(entry_p,entry_q)
  branch entry_r copy(entry_m,entry_w) no()
block copy(copy_m:mutbuf,copy_w:mutbuf)
  copy_digest:usize = const() {"value":1168}
  copy_out:usize = const() {"value":6104}
  copy_left:u64 = const() {"value":32}
  jump transfer(copy_m,copy_w,copy_digest,copy_out,copy_left)
block transfer(transfer_m:mutbuf,transfer_w:mutbuf,transfer_a:usize,transfer_b:usize,transfer_n:u64)
  transfer_octet:u8 = buffer.load(transfer_w,transfer_a)
  _ = buffer.store(transfer_m,transfer_b,transfer_octet)
  transfer_one:usize = const() {"value":1}
  transfer_off:u64 = const() {"value":1}
  transfer_zero:u64 = const() {"value":0}
  transfer_aa:usize = int.add.wrap(transfer_a,transfer_one)
  transfer_bb:usize = int.add.wrap(transfer_b,transfer_one)
  transfer_left:u64 = int.sub.wrap(transfer_n,transfer_off)
  transfer_end:bool = compare.eq(transfer_left,transfer_zero)
  branch transfer_end yes() transfer(transfer_m,transfer_w,transfer_aa,transfer_bb,transfer_left)
