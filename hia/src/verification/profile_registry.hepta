  stored:u64 = call(mi,row,version_at,version_len) {"function":"vr_read"}
  both_version:bool = compare.eq(stored,mv)
  equal:bool = bool.and(both_id,both_version)
  one:u64 = const() {"value":1}
  next:u64 = int.add.wrap(midx,one)
  branch equal found(row) loop(mi,mid,mv,next)
