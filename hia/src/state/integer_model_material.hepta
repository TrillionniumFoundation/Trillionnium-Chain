  count:bool = call(si,chunks_at,chunks_key,count_expect) {"function":"imd_number"}
  rhs:bool = bool.and(size,count)
  branch rhs texts(si,sb,sv) no()
block texts(ti:readbuf,tb:u64,tv:bool)
  family_rel:u64 = const() {"value":161}
  family_at:u64 = int.add.wrap(tb,family_rel)
  schema_rel:u64 = const() {"value":241}
  schema_at:u64 = int.add.wrap(tb,schema_rel)
  fam_key:u64 = const() {"value":133506532204902}
  sch_key:u64 = const() {"value":107122480669555}
