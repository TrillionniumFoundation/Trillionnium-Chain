fn rah_size_valid(declared_bytes:u64) -> (bool) effects() entry(entry)
block entry(declared_bytes:u64)
  zero_size:u64 = const() {"value":0}
  release_artifact_max:u64 = const() {"value":137438953472}
  positive:bool = compare.gt(declared_bytes,zero_size)
  within:bool = compare.le(declared_bytes,release_artifact_max)
  valid:bool = bool.and(positive,within)
  ret(valid)
end
