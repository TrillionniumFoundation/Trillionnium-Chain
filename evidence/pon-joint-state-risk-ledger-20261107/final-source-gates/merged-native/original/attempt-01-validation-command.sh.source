assert pre.returncode==0
out.mkdir(exist_ok=False)
(out/'initial-preflight.log').write_bytes(pre.stdout)
env=os.environ.copy()
toolchain='/home/qian-qi/.rustup/toolchains/1.95.0-x86_64-unknown-linux-gnu'
venv='/home/qian-qi/work/chain-pon-lifecycle-closure-20261107/venv'
