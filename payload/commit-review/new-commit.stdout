  \"sha256\": \"1913065a325e540797df6bf1b7319b331d76ac1c7c2ea1920d19a822e702654a\"\n+    },\n+    \"trillionnium/crates/trnm-protocol/src/pon_state.rs\": {\n+      \"bytes\": 19189,\n+      \"sha256\": \"96af0abf3ced5c462c16c1daceb657cc86eb8bf9e4e48b6af4cd666926dfa9bb\"\n+    },\n+    \"trillionnium/crates/trnm-protocol/src/pon_wire.rs\": {\n+      \"bytes\": 32654,\n+      \"sha256\": \"ee443e739da946fc023f119e7f3b882f373b3787820295b29b182ef0ee3ef83b\"\n+    },\n+    \"trillionnium/crates/trnm-protocol/src/pq_frame.rs\": {\n+      \"bytes\": 13891,\n+      \"sha256\": \"9fd553c520759f05e0f81b5d740a25a045a8c0424349aa94ff786f74b881a429\"\n+    },\n+    \"trillionnium/crates/trnm-protocol/src/pq_transaction.rs\": {\n+      \"bytes\": 6151,\n+      \"sha256\": \"1e5bb25a4d538374bd68b7409c32b7d6aa8e675e3ea172f9a708f36bd6e1c3e3\"\n+    },\n+    \"trillionnium/crates/trnm-release-bundle/src/content_v1.rs\": {\n+      \"bytes\": 5453,\n+      \"sha256\": \"dd4755bab39ba4f60887f298b7616493c389c39e299aa1e05eb22d4573d0e3cc\"\n+    },\n+    \"trillionnium/crates/trnm-data-availability/src/cell.rs\": {\n+      \"bytes\": 14762,\n+      \"sha256\": \"af920ebe2fc0d998c5083418b6d2e312aa90e4109b84241e44ee585c656c2739\"\n+    },\n+    \"trillionnium/crates/trnm-data-availability/src/cell/content_graph_v3.rs\": {\n+      \"bytes\": 23468,\n+      \"sha256\": \"de64c85b8a961bf5cf3b5df2e445b9992edaa20ad818024e921fbca0c38bfacc\"\n+    },\n+    \"trillionnium/crates/trnm-mvcc-fee/src/content_commitment_v1/history_v2.rs\": {\n+      \"bytes\": 10548,\n+      \"sha256\": \"7ff08fc23a7086a1a74671f85afd2f3919b982c11c0f0c3e69054fcc5ddbdc5b\"\n+    },\n+    \"trillionnium/crates/trnm-pon-node/src/store.rs\": {\n+      \"bytes\": 387798,\n+      \"sha256\": \"df2e303798678fe0b7437cf707bdc1d9cd6559ece47fcf2dd8c7ba8de0b29a17\"\n+    },\n+    \"trillionnium/crates/trnm-pon-node/src/store/migration_history_v2.rs\": {\n+      \"bytes\": 13942,\n+      \"sha256\": \"afcb6583ba4367325f2ea540f389a50700a6136decddd280e34b0686abf05156\"\n+    }\n+  }\n+}"},{"sha":"0c8e2ac894a8a36a70ba69d10e8146c930541010","filename":"evidence/hash-use-current-source-review-20261114/historical-57b069ae/reader.py","status":"added","additions":376,"deletions":0,"changes":376,"blob_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/blob/5df7ae6f482157c5f7fdcbcd52222117a965053f/evidence%2Fhash-use-current-source-review-20261114%2Fhistorical-57b069ae%2Freader.py","raw_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/raw/5df7ae6f482157c5f7fdcbcd52222117a965053f/evidence%2Fhash-use-current-source-review-20261114%2Fhistorical-57b069ae%2Freader.py","contents_url":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/contents/evidence%2Fhash-use-current-source-review-20261114%2Fhistorical-57b069ae%2Freader.py?ref=5df7ae6f482157c5f7fdcbcd52222117a965053f","patch":"@@ -0,0 +1,376 @@\n+#!/usr/bin/env python3\n+\"\"\"Inspect the reviewed per-purpose hash contract; never qualify cryptography.\n+\n+Hash output width, copied parameter labels and source checksums establish no\n+security bound. This fixed inventory separates attack games and the bytes\n+actually committed. It cannot authorize a format migration or external effect.\n+\"\"\"\n+from __future__ import annotations\n+\n+import argparse\n+import hashlib\n+import json\n+from pathlib import Path\n+import re\n+import sys\n+\n+import pq_lifetime_budget as lifetime\n+from pq_source_reader import SourceReadError, read_regular\n+\n+SCHEMA = \"trnm-hash-use-contract-v1\"\n+RESULT_SCHEMA = \"trnm-hash-use-contract-result-v1\"\n+DEFAULT_MANIFEST = \"config/pon/hash-use-contract-v1.json\"\n+REVIEW_BASE = \"e4abb172147e941b62483652b0ceabaae4317624\"\n+MAX_BYTES = 1024 * 1024\n+MAX_SOURCE_BYTES = 2 * 1024 * 1024\n+MAX_DEPTH = 64\n+# These are reviewed input identities, not cryptographic security assumptions.\n+# Changing source or semantics requires a new review; inspect never regenerates.\n+REVIEWED_SEMANTICS_SHA256 = \"29189f8e96a255472577479d46204b2b403a1f8e27806da6aa616e417ced0b5b\"\n+# Preserve the 31-path/19-use semantics. At 975ab093, five selected source\n+# identities and the proof descriptor's 140-input W1 map were separately reviewed.\n+# New exported APIs outside these declared uses are not a complete callgraph\n+# review or current-use approval. The selected upstream profile remains withdrawn.\n+REVIEWED_SOURCE_MAP_SHA256 = \"4c52b9ee94afcc67992da56ce88f0705bd4b5c6dd99f29fc56b4b894ed484cbf\"\n+\n+USES = {\n+    \"model-legacy-root\": \"model\",\n+    \"model-full-payload\": \"model\",\n+    \"model-direct-dependencies\": \"model\",\n+    \"model-declared-transitive-graph\": \"model\",\n+    \"transaction-root\": \"transaction\",\n+    \"state-root\": \"state\",\n+    \"history-block-anchor\": \"history\",\n+    \"signature-key-identity\": \"signature\",\n+    \"signature-tpq1-payload\": \"signature\",\n+    \"signature-cpq1-content\": \"signature\",\n+    \"storage-cell-chunks\": \"storage\",\n+    \"storage-bep52-root\": \"storage\",\n+    \"migration-full-state\": \"migration\",\n+    \"migration-bounded-state-history\": \"migration\",\n+    \"release-artifact\": \"release\",\n+    \"profile-byte-commitment\": \"profile\",\n+    \"work-threshold\": \"work\",\n+    \"proof-risc0-selected\": \"proof\",\n+    \"proof-p3-tagged-reference\": \"proof\",\n+}\n+GAMES = {\n+    \"fixed-target-preimage\": {\n+        \"selection_order\": \"target-digest-fixed-before-search\",\n+        \"attacker_output\": \"one-accepted-preimage-of-that-target\",\n+        \"qualification\": \"target-distribution-and-valid-input-domain-unqualified\",\n+    },\n+    \"fixed-message-second-preimage\": {\n+        \"selection_order\": \"complete-original-object-fixed-before-replacement-search\",\n+        \"attacker_output\": \"different-valid-object-with-the-fixed-original-digest\",\n+        \"qualification\": \"message-length-target-population-and-advice-unqualified\",\n+    },\n+    \"chosen-pair-collision\": {\n+        \"selection_order\": \"attacker-selects-both-objects-before-one-is-authorized\",\n+        \"attacker_output\": \"two-distinct-valid-objects-with-one-digest\",\n+        \"qualification\": \"valid-object-domain-and-authorization-reduction-unqualified\",\n+    },\n+    \"merkle-binding\": {\n+        \"selection_order\": \"depends-on-fixed-root-or-attacker-prepared-tree-game\",\n+        \"attacker_output\": \"conflicting-leaf-content-position-or-tree-opening\",\n+        \"qualification\": \"leaf-node-empty-shape-and-openings-reduction-unqualified\",\n+    },\n+    \"work-threshold-search\": {\n+        \"selection_order\": \"branch-context-and-threshold-fixed-before-each-search\",\n+        \"attacker_output\": \"legal-complete-W1-candidate-with-ticket-at-most-target\",\n+        \"qualification\": \"target-is-a-set-not-a-single-digest-and-work-cost-is-unqualified\",\n+    },\n+    \"proof-soundness-qrom\": {\n+        \"selection_order\": \"adaptive-statements-and-transcripts-in-a-complete-proof-game\",\n+        \"attacker_output\": \"accepting-proof-of-a-false-complete-statement\",\n+        \"qualification\": \"PCS-FS-recursion-extraction-and-concrete-oracle-losses-unqualified\",\n+    },\n+}\n+PRIMITIVES = {\n+    \"sha256\": {\"construction\": \"FIPS180-4/SHA-256\", \"output_bits\": 256},\n+    \"sha384\": {\"construction\": \"FIPS180-4/SHA-384\", \"output_bits\": 384},\n+    \"sha512\": {\"construction\": \"FIPS180-4/SHA-512\", \"output_bits\": 512},\n+    \"sha3-512\": {\"construction\": \"FIPS202/SHA3-512\", \"output_bits\": 512},\n+    \"risc0-poseidon2\": {\n+        \"construction\": \"risc0-3.0.6/Poseidon2/BabyBear\",\n+        \"output_bits\": None,\n+    },\n+}\n+MIGRATION_REQUIREMENTS = [\n+    \"new-versioned-domain-and-exact-canonical-encoding\",\n+    \"actual-original-content-before-any-full-content-claim\",\n+    \"independently-authenticated-expected-object-and-profile\",\n+    \"fresh-current-owner-authorization-for-the-new-format\",\n+    \"explicit-handling-of-every-retained-legacy-reference\",\n+    \"nonrewinding-recovery-frontier-and-surviving-liabilities\",\n+    \"explicit-retirement-and-downgrade-policy-before-adoption\",\n+]\n+QUALIFICATION = {\n+    \"actual_lifetime_failure_bound\": None,\n+    \"security_bits\": None,\n+    \"whole_chain_hash_query_scope_closed\": False,\n+    \"composition_coverage_proved\": False,\n+    \"whole_chain_pq_qualified\": False,\n+    \"production_activation\": False,\n+}\n+MATERIAL_SCOPES = {\n+    \"unchanged-existing-format\": \"existing-format-only\",\n+    \"legacy-digest-wrapper\": \"literal-digest-only\",\n+    \"actual-full-content\": \"direct-encoded-content-only\",\n+    \"actual-declared-direct-objects\": \"declared-direct-object-set-only\",\n+    \"actual-declared-transitive-objects\": \"declared-typed-graph-only\",\n+    \"actual-genesis-state-history\": \"bounded-genesis-to-checkpoint-state-bytes\",\n+}\n+\n+\n+class ContractError(ValueError):\n+    \"\"\"Reject changed, malformed, ambiguous or overclaiming declarations.\"\"\"\n+\n+\n+def require(condition, message):\n+    if not condition:\n+        raise ContractError(message)\n+\n+\n+def fields(value, expected, where):\n+    require(type(value) is dict and set(value) == set(expected),\n+            \"unexpected or missing fields: \" + where)\n+\n+\n+def exact(value, expected, where):\n+    \"\"\"Closed recursive comparison, including bool/int distinctions.\"\"\"\n+    require(type(value) is type(expected), \"wrong type: \" + where)\n+    if type(expected) is dict:\n+        fields(value, expected, where)\n+        for key, item in expected.items():\n+            exact(value[key], item, where + \".\" + key)\n+    elif type(expected) is list:\n+        require(len(value) == len(expected), \"wrong list length: \" + where)\n+        for index, item in enumerate(expected):\n+            exact(value[index], item, where + \".\" + str(index))\n+    else:\n+        require(value == expected, \"changed reviewed value: \" + where)\n+\n+\n+def canonical(value):\n+    return json.dumps(value, sort_keys=True, separators=(\",\", \":\"),\n+                      ensure_ascii=True, allow_nan=False).encode(\"utf-8\")\n+\n+\n+def sha(value):\n+    return hashlib.sha256(value).hexdigest()\n+\n+\n+def strings(value, where, *, nonempty=True):\n+    require(type(value) is list and int(nonempty) <= len(value) <= 128,\n+            \"invalid string list: \" + where)\n+    for item in value:\n+        lifetime.string(item, where)\n+    require(len(set(value)) == len(value), \"duplicate item: \" + where)\n+\n+\n+def strict_json(raw):\n+    \"\"\"Reuse the strict budget decoder with a lexical nesting ceiling first.\"\"\"\n+    require(type(raw) is bytes and len(raw) <= MAX_BYTES, \"invalid/oversize JSON input\")\n+    depth, quoted, escaped = 0, False, False\n+    for byte in raw:\n+        if quoted:\n+            if escaped:\n+                escaped = False\n+            elif byte == 92:\n+                escaped = True\n+            elif byte == 34:\n+                quoted = False\n+        elif byte == 34:\n+            quoted = True\n+        elif byte in (91, 123):\n+            depth += 1\n+            require(depth <= MAX_DEPTH, \"JSON nesting limit\")\n+        elif byte in (93, 125):\n+            depth -= 1\n+            require(depth >= 0, \"invalid JSON nesting\")\n+    try:\n+        return lifetime.strict_json(raw)\n+    except lifetime.BudgetError as error:\n+        raise ContractError(str(error)) from error\n+\n+\n+def review_migration(data):\n+    \"\"\"Check declared prerequisites; never establish their runtime fulfillment.\n+\n+The literal wrapper of an old digest can bind only that literal. A full-byte\n+recomputation gives a new direct-content obligation; it cannot strengthen the\n+old commitment, authenticate lost history, or establish transitive closure.\n+\"\"\"\n+    fields(data, (\"input_material\", \"claimed_scope\", \"original_bytes_required\",\n+                  \"old_commitment_strengthened\", \"historical_provenance_restored\",\n+                  \"transitive_dependency_closure_proved\", \"adoption_status\",\n+                  \"requirements\"), \"migration\")\n+    material = data[\"input_material\"]\n+    require(type(material) is str and material in MATERIAL_SCOPES,\n+            \"unsupported migration material\")\n+    exact(data[\"claimed_scope\"], MATERIAL_SCOPES[material], \"migration.claimed_scope\")\n+    actual = material in (\"actual-full-content\", \"actual-declared-direct-objects\",\n+                          \"actual-declared-transitive-objects\", \"actual-genesis-state-history\")\n+    exact(data[\"original_bytes_required\"], actual, \"migration.original_bytes_required\")\n+    for key in (\"old_commitment_strengthened\", \"historical_provenance_restored\",\n+                \"transitive_dependency_closure_proved\"):\n+        exact(data[key], False, \"migration.\" + key)\n+    exact(data[\"adoption_status\"], \"not-established\", \"migration.adoption_status\")\n+    exact(data[\"requirements\"], MIGRATION_REQUIREMENTS, \"migration.requirements\")\n+    return {\n+        \"declared_scope\": MATERIAL_SCOPES[material],\n+        \"full_content_recomputation_required\": actual,\n+        \"old_commitment_collision_risk_removed\": False,\n+        \"wrapper_preserves_every_inner_collision\": material == \"legacy-digest-wrapper\",\n+        \"prerequisites_fulfilled\": False,\n+        \"migration_authorized\": False,\n+    }\n+\n+\n+def _validate(data):\n+    fields(data, (\"schema\", \"purpose\", \"review_base_revision\", \"source_binding\",\n+                  \"primitives\", \"games\", \"uses\", \"migration_requirements\",\n+                  \"query_model_notes\", \"proof_profiles\", \"qualification\", \"source_files\"),\n+           \"manifest\")\n+    exact(data[\"schema\"], SCHEMA, \"schema\")\n+    exact(data[\"purpose\"], \"reviewed-source-obligation-inventory\", \"purpose\")\n+    exact(data[\"review_base_revision\"], REVIEW_BASE, \"review_base_revision\")\n+    exact(data[\"source_binding\"], \"declared-path-bytes-only-not-authenticated-history\", \"source_binding\")\n+    exact(data[\"primitives\"], PRIMITIVES, \"primitives\")\n+    exact(data[\"games\"], GAMES, \"games\")\n+    exact(data[\"migration_requirements\"], MIGRATION_REQUIREMENTS, \"migration_requirements\")\n+    exact(data[\"qualification\"], QUALIFICATION, \"qualification\")\n+    fields(data[\"uses\"], USES, \"uses\")\n+    source_paths = set()\n+    reports = {}\n+    required_binding_games = {\"fixed-message-second-preimage\", \"chosen-pair-collision\"}\n+    for identity, category in USES.items():\n+        row = data[\"uses\"][identity]\n+        fields(row, (\"category\", \"source_paths\", \"symbols\", \"primitives\", \"consumed_outputs\", \"encoding\",\n+                     \"attack_games\", \"attacker_control\", \"input_scope\",\n+                     \"legacy_reference_roles\", \"migration\", \"open_obligations\"), identity)\n+        exact(row[\"category\"], category, identity + \".category\")\n+        for key in (\"source_paths\", \"symbols\", \"primitives\", \"attack_games\", \"open_obligations\"):\n+            strings(row[key], identity + \".\" + key)\n+        strings(row[\"legacy_reference_roles\"], identity + \".legacy_reference_roles\", nonempty=False)\n+        require(set(row[\"primitives\"]) <= set(PRIMITIVES), \"unknown primitive: \" + identity)\n+        outputs = row[\"consumed_outputs\"]\n+        require(type(outputs) is dict and 0 < len(outputs) <= 32,\n+                \"missing or invalid consumed output roles: \" + identity)\n+        for role, output in outputs.items():\n+            lifetime.string(role, identity + \".output role\")\n+            fields(output, (\"primitive\", \"consumed_bits\", \"truncation\", \"notes\"),\n+                   identity + \".output.\" + role)\n+            lifetime.string(output[\"notes\"], identity + \".output notes\")\n+            primitive, bits, truncation = output[\"primitive\"], output[\"consumed_bits\"], output[\"truncation\"]\n+            if primitive is None:\n+                require(bits is None and truncation == \"not-mapped\",\n+                        \"unmapped output cannot acquire a width: \" + identity)\n+                continue\n+            require(type(primitive) is str and primitive in row[\"primitives\"],\n+                    \"output role uses an undeclared primitive: \" + identity)\n+            width = PRIMITIVES[primitive][\"output_bits\"]\n+            if width is None:\n+                require(bits is None and truncation == \"not-mapped\",\n+                        \"field/construction output requires its own mapping: \" + identity)\n+            else:\n+                require(type(bits) is int and 0 < bits <= width,\n+                        \"invalid consumed output width: \" + identity)\n+                require((bits == width and truncation == \"none\")\n+                        or (bits < width and truncation == \"explicit-bit-prefix\"),\n+                        \"truncation cannot retain the original output width: \" + identity)\n+        games = set(row[\"attack_games\"])\n+        require(games <= set(GAMES), \"unknown attack game: \" + identity)\n+        if category == \"work\":\n+            exact(row[\"attack_games\"], [\"work-threshold-search\"], identity + \".attack_games\")\n+        elif category == \"proof\":\n+            require({\"proof-soundness-qrom\", \"merkle-binding\"} <= games,\n+                    \"proof hash game is not the complete proof game\")\n+        else:\n+            require(required_binding_games <= games, \"binding attack games omitted: \" + identity)\n+        for path in row[\"source_paths\"]:\n+            source_paths.add(lifetime.relative_path(path, identity + \".source_path\"))\n+        fields(row[\"encoding\"], (\"record\", \"framing\", \"domains\"), identity + \".encoding\")\n+        lifetime.string(row[\"encoding\"][\"record\"], identity + \".record\")\n+        lifetime.string(row[\"encoding\"][\"framing\"], identity + \".framing\")\n+        strings(row[\"encoding\"][\"domains\"], identity + \".domains\")\n+        for key in (\"attacker_control\", \"input_scope\"):\n+            lifetime.string(row[key], identity + \".\" + key)\n+        reports[identity] = review_migration(row[\"migration\"])\n+    files = data[\"source_files\"]\n+    require(type(files) is dict and 0 < len(files) <= 128, \"invalid source inventory\")\n+    require(source_paths == set(files), \"source roster differs from declared uses\")\n+    for path, pin in files.items():\n+        lifetime.relative_path(path, \"source path\")\n+        fields(pin, (\"bytes\", \"sha256\"), \"source pin\")\n+        require(type(pin[\"bytes\"]) is int and 0 < pin[\"bytes\"] <= MAX_SOURCE_BYTES,\n+                \"invalid source size: \" + path)\n+        require(type(pin[\"sha256\"]) is str\n+                and re.fullmatch(r\"[0-9a-f]{64}\", pin[\"sha256\"]) is not None,\n+                \"invalid source digest: \" + path)\n+    require(sha(canonical(files)) == REVIEWED_SOURCE_MAP_SHA256,\n+            \"source map differs from reviewed identity; automatic repinning refused\")\n+    semantics = {key: value for key, value in data.items() if key != \"source_files\"}\n+    require(sha(canonical(semantics)) == REVIEWED_SEMANTICS_SHA256,\n+            \"purpose/game/encoding/parameter semantics differ from reviewed identity\")\n+    return {\n+        \"schema\": RESULT_SCHEMA, \"status\": \"HOLD_NO_GO\", \"contract_satisfied\": True,\n+        \"review_base_revision\": REVIEW_BASE,\n+        \"declared_use_count\": len(USES), \"declared_source_count\": len(files),\n+        \"source_files_checked\": False, \"source_revision_authenticated\": False,\n+        \"complete_callgraph_coverage_proved\": False,\n+        \"source_semantics_refinement_proved\": False,\n+        \"per_use_migration_review\": reports,\n+        \"query_exponents_are_failure_probabilities\": False,\n+        \"source_hashes_supply_security_bits\": False,\n+        \"proof_parameter_labels_establish_qrom_soundness\": False,\n+        **QUALIFICATION,\n+    }\n+\n+\n+def validate_manifest(data):\n+    \"\"\"Validate only declarations; source_files_checked remains false.\"\"\"\n+    try:\n+        return _validate(data)\n+    except (lifetime.BudgetError, KeyError, TypeError, ValueError, RecursionError) as error:\n+        raise ContractError(str(error)) from error\n+\n+\n+def inspect(root, manifest_path=DEFAULT_MANIFEST):\n+    \"\"\"Read exactly the declared paths with descriptor-bound regular-file checks.\"\"\"\n+    try:\n+        root = Path(root)\n+        path = lifetime.relative_path(manifest_path, \"manifest\")\n+        raw = read_regular(root, path, MAX_BYTES)\n+        data = strict_json(raw)\n+        result = validate_manifest(data)\n+        for source, pin in data[\"source_files\"].items():\n+            content = read_regular(root, source, MAX_SOURCE_BYTES)\n+            require(len(content) == pin[\"bytes\"] and sha(content) == pin[\"sha256\"],\n+                    \"reviewed source bytes differ: \" + source)\n+        result.update({\"manifest_sha256\": sha(raw), \"source_files_checked\": True,\n+                       \"reviewed_source_map_sha256\": REVIEWED_SOURCE_MAP_SHA256,\n+                       \"reviewed_semantics_sha256\": REVIEWED_SEMANTICS_SHA256})\n+        return result\n+    except (SourceReadError, lifetime.BudgetError, OSError, TypeError, ValueError) as error:\n+        raise ContractError(str(error)) from error\n+\n+\n+def main(argv=None):\n+    parser = argparse.ArgumentParser(description=__doc__)\n+    parser.add_argument(\"--root\", type=Path, default=Path(__file__).resolve().parents[2])\n+    parser.add_argument(\"--manifest\", default=DEFAULT_MANIFEST)\n+    args = parser.parse_args(argv)\n+    try:\n+        result = inspect(args.root, args.manifest)\n+    except ContractError as error:\n+        print(json.dumps({\"schema\": RESULT_SCHEMA, \"status\": \"REFUSE\", \"error\": str(error),\n+                          **QUALIFICATION}, sort_keys=True))\n+        return 2\n+    print(json.dumps(result, sort_keys=True))\n+    return 0\n+\n+\n+if __name__ == \"__main__\":\n+    sys.exit(main())"},{"sha":"25dd6d15a910ffe8900cfc4f167d96d8df86de55","filename":"evidence/hash-use-current-source-review-20261114/historical-57b069ae/tests.py","status":"added","additions":404,"deletions":0,"changes":404,"blob_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/blob/5df7ae6f482157c5f7fdcbcd52222117a965053f/evidence%2Fhash-use-current-source-review-20261114%2Fhistorical-57b069ae%2Ftests.py","raw_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/raw/5df7ae6f482157c5f7fdcbcd52222117a965053f/evidence%2Fhash-use-current-source-review-20261114%2Fhistorical-57b069ae%2Ftests.py","contents_url":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/contents/evidence%2Fhash-use-current-source-review-20261114%2Fhistorical-57b069ae%2Ftests.py?ref=5df7ae6f482157c5f7fdcbcd52222117a965053f","patch":"@@ -0,0 +1,404 @@\n+#!/usr/bin/env python3\n+\"\"\"Adversarial controls for the per-purpose hash inventory, not crypto proofs.\"\"\"\n+from __future__ import annotations\n+\n+import contextlib\n+import copy\n+import hashlib\n+import io\n+import json\n+import os\n+from pathlib import Path\n+import tempfile\n+import unittest\n+\n+import hash_use_contract as contract\n+\n+ROOT = Path(__file__).resolve().parents[2]\n+\n+\n+class HashUseContractTests(unittest.TestCase):\n+    @classmethod\n+    def setUpClass(cls):\n+        cls.raw = (ROOT / contract.DEFAULT_MANIFEST).read_bytes()\n+        cls.manifest = contract.strict_json(cls.raw)\n+        cls.sources = {path: (ROOT / path).read_bytes()\n+                       for path in cls.manifest[\"source_files\"]}\n+\n+    def data(self):\n+        return copy.deepcopy(self.manifest)\n+\n+    @contextlib.contextmanager\n+    def fixture(self):\n+        with tempfile.TemporaryDirectory(prefix=\"hash-use-contract-\") as temporary:\n+            root = Path(temporary).resolve()\n+            for path, raw in {contract.DEFAULT_MANIFEST: self.raw, **self.sources}.items():\n+                target = root / path\n+                target.parent.mkdir(parents=True, exist_ok=True)\n+                target.write_bytes(raw)\n+            yield root\n+\n+    def refused(self, data):\n+        with self.assertRaises(contract.ContractError):\n+            contract.validate_manifest(data)\n+\n+    def test_declaration_validation_never_claims_source_inspection_or_security(self):\n+        result = contract.validate_manifest(self.data())\n+        self.assertEqual(result[\"status\"], \"HOLD_NO_GO\")\n+        self.assertFalse(result[\"source_files_checked\"])\n+        self.assertFalse(result[\"source_semantics_refinement_proved\"])\n+        self.assertFalse(result[\"complete_callgraph_coverage_proved\"])\n+        self.assertIsNone(result[\"actual_lifetime_failure_bound\"])\n+        self.assertIsNone(result[\"security_bits\"])\n+        self.assertFalse(result[\"production_activation\"])\n+\n+    def test_actual_reviewed_source_inspection_preserves_hold(self):\n+        result = contract.inspect(ROOT)\n+        self.assertTrue(result[\"source_files_checked\"])\n+        self.assertEqual(result[\"declared_use_count\"], 19)\n+        self.assertEqual(result[\"declared_source_count\"], 31)\n+        self.assertFalse(result[\"source_revision_authenticated\"])\n+        self.assertFalse(result[\"whole_chain_hash_query_scope_closed\"])\n+        self.assertFalse(result[\"whole_chain_pq_qualified\"])\n+\n+    def test_missing_or_added_use_cannot_narrow_or_expand_the_review(self):\n+        for key in (\"model-legacy-root\", \"transaction-root\", \"history-block-anchor\",\n+                    \"signature-tpq1-payload\", \"storage-cell-chunks\"):\n+            with self.subTest(key=key):\n+                data = self.data()\n+                del data[\"uses\"][key]\n+                self.refused(data)\n+        data = self.data()\n+        data[\"uses\"][\"new-live-owner\"] = copy.deepcopy(data[\"uses\"][\"transaction-root\"])\n+        self.refused(data)\n+\n+    def test_attack_selection_orders_are_distinct_and_not_interchangeable(self):\n+        data = self.data()\n+        goals = data[\"games\"]\n+        orders = [goals[name][\"selection_order\"] for name in (\n+            \"fixed-target-preimage\", \"fixed-message-second-preimage\", \"chosen-pair-collision\")]\n+        self.assertEqual(len(set(orders)), 3)\n+        goals[\"chosen-pair-collision\"] = copy.deepcopy(goals[\"fixed-target-preimage\"])\n+        self.refused(data)\n+\n+    def test_collision_game_cannot_be_omitted_for_signature_or_root_binding(self):\n+        for key in (\"model-full-payload\", \"transaction-root\", \"signature-tpq1-payload\"):\n+            with self.subTest(key=key):\n+                data = self.data()\n+                data[\"uses\"][key][\"attack_games\"].remove(\"chosen-pair-collision\")\n+                self.refused(data)\n+\n+    def test_work_threshold_cannot_be_replaced_by_a_single_target_hash_game(self):\n+        data = self.data()\n+        data[\"uses\"][\"work-threshold\"][\"attack_games\"] = [\"fixed-target-preimage\"]\n+        self.refused(data)\n+\n+    def test_width_exponent_is_not_a_lifetime_probability_or_concrete_bit_claim(self):\n+        notes = self.data()[\"query_model_notes\"]\n+        row = notes[\"ideal_output_width_examples\"][0]\n+        self.assertEqual(row[\"output_bits\"], 256)\n+        self.assertEqual(row[\"collision_exponent\"], {\"numerator\": \"256\", \"denominator\": \"3\"})\n+        self.assertEqual(row[\"preimage_exponent\"], {\"numerator\": \"256\", \"denominator\": \"2\"})\n+        for key in (\"examples_are_security_bits\", \"examples_are_lifetime_failure_bounds\"):\n+            data = self.data()\n+            data[\"query_model_notes\"][key] = True\n+            self.refused(data)\n+\n+    def test_primitive_relabel_width_change_and_unknown_algorithm_refused(self):\n+        for key, value in ((\"output_bits\", 512), (\"construction\", \"SHA-256-is-PQ128-everywhere\")):\n+            data = self.data()\n+            data[\"primitives\"][\"sha256\"][key] = value\n+            self.refused(data)\n+        data = self.data()\n+        data[\"uses\"][\"model-legacy-root\"][\"primitives\"] = [\"unknown-secure-hash\"]\n+        self.refused(data)\n+\n+    def test_domain_omission_or_transfer_requires_a_new_review(self):\n+        for key in (\"transaction-root\", \"storage-bep52-root\", \"profile-byte-commitment\"):\n+            data = self.data()\n+            data[\"uses\"][key][\"encoding\"][\"domains\"] = [\"CCH1 domains inherited automatically\"]\n+            self.refused(data)\n+\n+    def test_consumed_width_cannot_hide_truncation_or_drop_a_role(self):\n+        data = self.data()\n+        outputs = data[\"uses\"][\"signature-tpq1-payload\"][\"consumed_outputs\"]\n+        outputs[\"payload_commitment\"][\"consumed_bits\"] = 256\n+        self.refused(data)\n+        outputs[\"payload_commitment\"][\"truncation\"] = \"explicit-bit-prefix\"\n+        self.refused(data)  # Even explicit truncation changes the reviewed consumer.\n+        data = self.data()\n+        data[\"uses\"][\"signature-tpq1-payload\"][\"consumed_outputs\"].pop(\"qtx1_owner_context\")\n+        self.refused(data)\n+\n+    def test_unmapped_proof_output_cannot_inherit_digest_width(self):\n+        data = self.data()\n+        output = data[\"uses\"][\"proof-risc0-selected\"][\"consumed_outputs\"][\"risc0_merkle_and_transcript_outputs\"]\n+        output.update(consumed_bits=256, truncation=\"none\")\n+        self.refused(data)\n+        data = self.data()\n+        output = data[\"uses\"][\"proof-p3-tagged-reference\"][\"consumed_outputs\"][\"sampled_fiat_shamir_field_challenges\"]\n+        output.update(consumed_bits=512, truncation=\"none\")\n+        self.refused(data)\n+        data = self.data()\n+        outputs = data[\"uses\"][\"work-threshold\"][\"consumed_outputs\"]\n+        self.assertEqual(outputs[\"raw_noise_hash_output\"][\"consumed_bits\"], 256)\n+        self.assertIsNone(outputs[\"sampled_noise_field_words\"][\"consumed_bits\"])\n+        outputs[\"sampled_noise_field_words\"].update(\n+            primitive=\"sha256\", consumed_bits=256, truncation=\"none\")\n+        self.refused(data)\n+\n+    def test_literal_metadata_cannot_be_claimed_as_transitive_full_content(self):\n+        data = self.data()\n+        data[\"uses\"][\"model-full-payload\"][\"legacy_reference_roles\"] = []\n+        self.refused(data)\n+        data = self.data()\n+        data[\"uses\"][\"model-direct-dependencies\"][\"migration\"][\"transitive_dependency_closure_proved\"] = True\n+        self.refused(data)\n+\n+    def test_proof_parameter_profiles_cannot_be_pooled_or_replaced(self):\n+        for change in (\"pool\", \"queries\", \"profile\"):\n+            data = self.data()\n+            proof = data[\"proof_profiles\"]\n+            if change == \"pool\":\n+                proof[\"parameter_sets_may_be_combined_for_qualification\"] = True\n+            elif change == \"queries\":\n+                proof[\"selected_risc0\"][\"expected_identity\"][\"fri\"][\"queries\"] = 64\n+            else:\n+                proof[\"selected_risc0\"][\"profile_id\"] = proof[\"tagged_p3_reference\"][\"profile_id\"]\n+            self.refused(data)\n+\n+    def test_proof_width_or_fri_parameters_cannot_supply_soundness(self):\n+        data = self.data()\n+        data[\"proof_profiles\"][\"tagged_p3_reference\"][\"qrom_soundness_bound\"] = \"2^-128\"\n+        self.refused(data)\n+        data = self.data()\n+        data[\"uses\"][\"proof-risc0-selected\"][\"attack_games\"] = [\"merkle-binding\"]\n+        self.refused(data)\n+\n+    def test_source_map_cannot_self_repin_changed_source(self):\n+        data = self.data()\n+        first = next(iter(data[\"source_files\"]))\n+        data[\"source_files\"][first][\"sha256\"] = hashlib.sha256(b\"replacement\").hexdigest()\n+        data[\"source_files\"][first][\"bytes\"] = len(b\"replacement\")\n+        self.refused(data)\n+\n+    def test_source_paths_cannot_be_removed_redirected_or_duplicated(self):\n+        for path in (\"../outside\", \"/outside\", \"file\\\\outside\", \"./inside\", \"inside\\x00suffix\"):\n+            data = self.data()\n+            data[\"uses\"][\"transaction-root\"][\"source_paths\"] = [path]\n+            self.refused(data)\n+        data = self.data()\n+        paths = data[\"uses\"][\"transaction-root\"][\"source_paths\"]\n+        paths.append(paths[0])\n+        self.refused(data)\n+        data = self.data()\n+        data[\"source_files\"].pop(next(iter(data[\"source_files\"])))\n+        self.refused(data)\n+\n+    def test_bool_int_aliases_wrong_types_and_extra_fields_refused(self):\n+        for field, value in ((\"production_activation\", 0), (\"security_bits\", False)):\n+            data = self.data()\n+            data[\"qualification\"][field] = value\n+            self.refused(data)\n+        data = self.data()\n+        data[\"source_files\"][next(iter(data[\"source_files\"]))][\"bytes\"] = True\n+        self.refused(data)\n+        for data in ([], {**self.data(), \"approved\": True}):\n+            self.refused(data)\n+\n+    def test_numeric_bounds_source_trust_and_scope_self_certification_refused(self):\n+        for key in self.manifest[\"qualification\"]:\n+            data = self.data()\n+            data[\"qualification\"][key] = \"128\" if data[\"qualification\"][key] is None else True\n+            self.refused(data)\n+        data = self.data()\n+        data[\"source_binding\"] = \"source-hash-proves-pq-security\"\n+        self.refused(data)\n+\n+    def test_wrapper_can_only_describe_the_old_digest_literal(self):\n+        migration = self.data()[\"uses\"][\"model-legacy-root\"][\"migration\"]\n+        migration.update(input_material=\"legacy-digest-wrapper\", claimed_scope=\"literal-digest-only\")\n+        result = contract.review_migration(migration)\n+        self.assertTrue(result[\"wrapper_preserves_every_inner_collision\"])\n+        self.assertFalse(result[\"old_commitment_collision_risk_removed\"])\n+        self.assertFalse(result[\"migration_authorized\"])\n+\n+    def test_wrapper_cannot_claim_original_content_or_recovered_provenance(self):\n+        migration = self.data()[\"uses\"][\"model-legacy-root\"][\"migration\"]\n+        migration.update(input_material=\"legacy-digest-wrapper\", claimed_scope=\"literal-digest-only\")\n+        for key, value in ((\"claimed_scope\", \"direct-encoded-content-only\"),\n+                           (\"original_bytes_required\", True),\n+                           (\"old_commitment_strengthened\", True),\n+                           (\"historical_provenance_restored\", True)):\n+            bad = copy.deepcopy(migration)\n+            bad[key] = value\n+            with self.assertRaises(contract.ContractError):\n+                contract.review_migration(bad)\n+\n+    def test_small_inner_collision_survives_a_real_sha512_wrapper(self):\n+        # A deliberately 8-bit toy inner digest, not a SHA-256 collision claim.\n+        # Pigeonhole search is bounded to 257 distinct messages.\n+        seen = {}\n+        pair = None\n+        for index in range(257):\n+            message = index.to_bytes(4, \"big\")\n+            inner = hashlib.sha256(message).digest()[:1]\n+            if inner in seen:\n+                pair = seen[inner], message\n+                break\n+            seen[inner] = message\n+        self.assertIsNotNone(pair)\n+        left, right = pair\n+        self.assertNotEqual(left, right)\n+        wrapper = lambda message: hashlib.sha512(hashlib.sha256(message).digest()[:1]).digest()\n+        self.assertEqual(wrapper(left), wrapper(right))\n+        # This one explicit pair separates under a direct full-byte SHA-512.\n+        # It neither proves SHA-512 security nor authenticates either message.\n+        self.assertNotEqual(hashlib.sha512(left).digest(), hashlib.sha512(right).digest())\n+\n+    def test_direct_recomputation_still_grants_no_old_history_or_adoption(self):\n+        migration = self.data()[\"uses\"][\"model-direct-dependencies\"][\"migration\"]\n+        result = contract.review_migration(migration)\n+        self.assertTrue(result[\"full_content_recomputation_required\"])\n+        self.assertFalse(result[\"prerequisites_fulfilled\"])\n+        self.assertFalse(result[\"old_commitment_collision_risk_removed\"])\n+        self.assertFalse(result[\"migration_authorized\"])\n+\n+    def test_new_byte_readbacks_have_explicit_narrow_scopes(self):\n+        expected = {\n+            \"model-declared-transitive-graph\": \"declared-typed-graph-only\",\n+            \"migration-bounded-state-history\": \"bounded-genesis-to-checkpoint-state-bytes\",\n+        }\n+        for name, scope in expected.items():\n+            with self.subTest(name=name):\n+                migration = self.data()[\"uses\"][name][\"migration\"]\n+                result = contract.review_migration(migration)\n+                self.assertEqual(result[\"declared_scope\"], scope)\n+                self.assertTrue(result[\"full_content_recomputation_required\"])\n+                self.assertFalse(result[\"old_commitment_collision_risk_removed\"])\n+                self.assertFalse(result[\"migration_authorized\"])\n+                self.assertFalse(result[\"prerequisites_fulfilled\"])\n+\n+    def test_typed_graph_and_history_cannot_promote_missing_authority(self):\n+        for name in (\"model-declared-transitive-graph\", \"migration-bounded-state-history\"):\n+            for field in (\"old_commitment_strengthened\", \"historical_provenance_restored\",\n+                          \"transitive_dependency_closure_proved\"):\n+                with self.subTest(name=name, field=field):\n+                    migration = self.data()[\"uses\"][name][\"migration\"]\n+                    migration[field] = True\n+                    with self.assertRaises(contract.ContractError):\n+                        contract.review_migration(migration)\n+\n+    def test_finite_or_declared_readback_cannot_claim_whole_chain_scope(self):\n+        for name in (\"model-declared-transitive-graph\", \"migration-bounded-state-history\"):\n+            for scope in (\"all-loader-dependencies\", \"all-historical-state-and-effects\",\n+                          \"historical-provenance-restored\"):\n+                with self.subTest(name=name, scope=scope):\n+                    migration = self.data()[\"uses\"][name][\"migration\"]\n+                    migration[\"claimed_scope\"] = scope\n+                    with self.assertRaises(contract.ContractError):\n+                        contract.review_migration(migration)\n+\n+    def test_missing_migration_prerequisite_and_unknown_material_refused(self):\n+        original = self.data()[\"uses\"][\"migration-full-state\"][\"migration\"]\n+        for index in range(len(original[\"requirements\"])):\n+            value = copy.deepcopy(original)\n+            value[\"requirements\"].pop(index)\n+            with self.assertRaises(contract.ContractError):\n+                contract.review_migration(value)\n+        for material in (\"automatic-upgrade\", [], None):\n+            value = copy.deepcopy(original)\n+            value[\"input_material\"] = material\n+            with self.assertRaises(contract.ContractError):\n+                contract.review_migration(value)\n+\n+    def test_strict_json_refuses_duplicate_numeric_unicode_and_nesting_ambiguity(self):\n+        for raw in (b'{\"uses\":{},\"uses\":{}}', b'{\"x\":NaN}', b'{\"x\":Infinity}',\n+                    b'{\"x\":1.0}', b'{\"x\":123456789012345678901}',\n+                    b'{\"x\":\"\\\\ud800\"}', b'{\"x\":\"\\xff\"}', b'[]',\n+                    b'{\"x\":' + b'[' * 65 + b'0' + b']' * 65 + b'}',\n+                    b' ' * (contract.MAX_BYTES + 1)):\n+            with self.subTest(raw=raw[:35]):\n+                with self.assertRaises(contract.ContractError):\n+                    contract.strict_json(raw)\n+\n+    def test_missing_source_and_same_size_source_mutation_refused(self):\n+        selected = next(iter(self.manifest[\"source_files\"]))\n+        with self.fixture() as root:\n+            target = root / selected\n+            raw = target.read_bytes()\n+            target.unlink()\n+            with self.assertRaisesRegex(contract.ContractError, \"missing source\"):\n+                contract.inspect(root)\n+            target.write_bytes(bytes([raw[0] ^ 1]) + raw[1:])\n+            with self.assertRaisesRegex(contract.ContractError, \"source bytes differ\"):\n+                contract.inspect(root)\n+\n+    def test_symlink_source_and_symlink_manifest_refused(self):\n+        selected = next(iter(self.manifest[\"source_files\"]))\n+        with self.fixture() as root:\n+            target = root / selected\n+            retained = root / \"original-source\"\n+            target.rename(retained)\n+            target.symlink_to(retained)\n+            with self.assertRaisesRegex(contract.ContractError, \"symlink\"):\n+                contract.inspect(root)\n+            target.unlink()\n+            retained.rename(target)\n+            manifest = root / contract.DEFAULT_MANIFEST\n+            retained = root / \"original-manifest\"\n+            manifest.rename(retained)\n+            manifest.symlink_to(retained)\n+            with self.assertRaisesRegex(contract.ContractError, \"symlink\"):\n+                contract.inspect(root)\n+\n+    def test_symlink_repository_ancestor_refused(self):\n+        with self.fixture() as root:\n+            with tempfile.TemporaryDirectory(prefix=\"hash-root-alias-\") as temporary:\n+                alias = Path(temporary).resolve() / \"alias\"\n+                alias.symlink_to(root, target_is_directory=True)\n+                with self.assertRaisesRegex(contract.ContractError, \"symlink\"):\n+                    contract.inspect(alias)\n+\n+    def test_nonregular_fifo_and_oversize_source_refused_without_blocking(self):\n+        selected = next(iter(self.manifest[\"source_files\"]))\n+        with self.fixture() as root:\n+            target = root / selected\n+            target.unlink()\n+            os.mkfifo(target)\n+            with self.assertRaisesRegex(contract.ContractError, \"nonregular\"):\n+                contract.inspect(root)\n+            target.unlink()\n+            with target.open(\"wb\") as stream:\n+                stream.truncate(contract.MAX_SOURCE_BYTES + 1)\n+            with self.assertRaisesRegex(contract.ContractError, \"oversize\"):\n+                contract.inspect(root)\n+\n+    def test_cli_success_is_hold_and_failure_is_refuse_exit_two(self):\n+        with self.fixture() as root:\n+            output = io.StringIO()\n+            with contextlib.redirect_stdout(output):\n+                self.assertEqual(contract.main([\"--root\", str(root)]), 0)\n+            result = json.loads(output.getvalue())\n+            self.assertEqual(result[\"status\"], \"HOLD_NO_GO\")\n+            self.assertFalse(result[\"whole_chain_pq_qualified\"])\n+            (root / contract.DEFAULT_MANIFEST).write_bytes(b'{\"schema\":1,\"schema\":2}')\n+            output = io.StringIO()\n+            with contextlib.redirect_stdout(output):\n+                self.assertEqual(contract.main([\"--root\", str(root)]), 2)\n+            result = json.loads(output.getvalue())\n+            self.assertEqual(result[\"status\"], \"REFUSE\")\n+            self.assertIsNone(result[\"actual_lifetime_failure_bound\"])\n+            self.assertFalse(result[\"production_activation\"])\n+\n+    def test_manifest_path_traversal_and_changed_review_base_refused(self):\n+        data = self.data()\n+        data[\"review_base_revision\"] = \"0\" * 40\n+        self.refused(data)\n+        for path in (\"../outside.json\", \"/tmp/outside.json\", \"config/../outside.json\"):\n+            with self.assertRaises(contract.ContractError):\n+                contract.inspect(ROOT, path)\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()"},{"sha":"277d32fa141b4e194a01194b5e23eef5fc0d93ec","filename":"evidence/hash-use-current-source-review-20261114/minimal-edit-proof.json","status":"added","additions":37,"deletions":0,"changes":37,"blob_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/blob/5df7ae6f482157c5f7fdcbcd52222117a965053f/evidence%2Fhash-use-current-source-review-20261114%2Fminimal-edit-proof.json","raw_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/raw/5df7ae6f482157c5f7fdcbcd52222117a965053f/evidence%2Fhash-use-current-source-review-20261114%2Fminimal-edit-proof.json","contents_url":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/contents/evidence%2Fhash-use-current-source-review-20261114%2Fminimal-edit-proof.json?ref=5df7ae6f482157c5f7fdcbcd52222117a965053f","patch":"@@ -0,0 +1,37 @@\n+{\n+  \"all_33_original_tests_raw_unchanged\": true,\n+  \"base_head\": \"7d8d4c59fcd01480a12e1c64835b202079091800\",\n+  \"changed_current_metadata_paths\": [\n+    \"config/pon/hash-use-contract-v1.json\",\n+    \"scripts/ci/hash_use_contract.py\",\n+    \"docs/security/HASH_USE_CONTRACT_V1.md\"\n+  ],\n+  \"changed_source_pins\": [\n+    \"config/pon/pq-proof-profile-binding-v1.json\",\n+    \"trillionnium/crates/trnm-crypto-primitives/src/pon_work.rs\",\n+    \"trillionnium/crates/trnm-data-availability/src/cell/store.rs\",\n+    \"trillionnium/crates/trnm-pon-node/src/lib.rs\",\n+    \"trillionnium/crates/trnm-data-availability/src/cell.