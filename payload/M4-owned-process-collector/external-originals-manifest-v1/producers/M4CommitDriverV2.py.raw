import pathlib,subprocess,os,json,datetime,hashlib,ast
W=pathlib.Path("/private/tmp/chain-M4-owned-process-collector-20261114")
E=pathlib.Path("/private/tmp/chain-M4-owned-process-collector-review-20261114-v1")
D=W/"docs/audit/20261114-m4-closed-exec-gate"
O=E/"commit-v2";O.mkdir(exist_ok=False)
H="1a7afcdb820b051d1e4bfde3d436f96fc050c487"
env=dict(os.environ,PATH="/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin",GIT_NO_LAZY_FETCH="1",GIT_OPTIONAL_LOCKS="0",GIT_NO_REPLACE_OBJECTS="1",PYTHONDONTWRITEBYTECODE="1")
def git(*args):return subprocess.check_output(["/usr/bin/git","-C",str(W),*args],env=env,timeout=60)
def run(argv,label,timeout=60):
 p=subprocess.run(argv,cwd=W,env=env,stdout=subprocess.PIPE,stderr=subprocess.PIPE,timeout=timeout)
 for suffix,r in (("stdout",p.stdout),("stderr",p.stderr)):(O/(label+"."+suffix)).write_bytes(r)
 assert p.returncode==0,(label,p.returncode,p.stderr.decode())
 return p.stdout
def dump(path,obj,exclusive=False):
 r=(json.dumps(obj,indent=2)+"\n").encode()
 with path.open("xb" if exclusive else "wb") as f:f.write(r)
 return {"path":str(path),"bytes":len(r),"sha256":hashlib.sha256(r).hexdigest()}
assert git("rev-parse","HEAD").decode().strip()==H
run(["bash","scripts/project-preflight.sh"],"preflight-before-portable-mock")
T=W/"scripts/test_w1_owned_process_collector_v1.py";old=T.read_text()
assert hashlib.sha256(old.encode()).hexdigest()=="20ba82854ae08211195a4a7ceb677b72cda3f0ebb152c4e4c94ea77438528224"
needle='mock.patch.object(collector.signal, "pidfd_send_signal")'
assert old.count(needle)==2
new=old.replace(needle,'mock.patch.object(collector.signal, "pidfd_send_signal", create=True)')
T.write_text(new)
source_paths=["scripts/w1_owned_process_collector_v1.py","scripts/test_w1_owned_process_collector_v1.py"]
for path in source_paths:compile((W/path).read_bytes(),path,"exec",dont_inherit=True,optimize=0)
old_test=git("show",H+":"+source_paths[1]).decode()
def original_methods(s):
 tree=ast.parse(s);cl=next(x for x in tree.body if isinstance(x,ast.ClassDef) and x.name=="CollectorControls")
 return {x.name:(ast.get_source_segment(s,x),ast.dump(x,include_attributes=False)) for x in cl.body if isinstance(x,ast.FunctionDef) and x.name.startswith("test_")}
assert original_methods(old_test)==original_methods(new) and len(original_methods(new))==14
# Only source paths enter this current two-file patch, including already staged portions.
patch=git("diff","--binary","--full-index",H,"--",*source_paths)
(O/"source-and-tests.patch").write_bytes(patch)
initial=(D/"source-and-tests.patch").read_bytes()
assert hashlib.sha256(initial).hexdigest()=="a8c3d5ecbf2b563efde4ac4bb535309e9657145e59c45c3957ca2ecf7e131b91"
dump(D/"source-and-tests-initial.patch.json",{"schema":"trnm-exact-patch-json-carrier-v1","original_bytes":len(initial),"original_sha256":hashlib.sha256(initial).hexdigest(),"patch":initial.decode()},True)
dump(D/"source-and-tests-current.patch.json",{"schema":"trnm-exact-patch-json-carrier-v1","original_bytes":len(patch),"original_sha256":hashlib.sha256(patch).hexdigest(),"patch":patch.decode()},True)
(D/"source-and-tests.patch").unlink()
failure=(E/"commit-v1/staged-diff-check.stdout").read_bytes()
with (D/"initial-staged-patch-whitespace.stdout.raw").open("xb") as f:f.write(failure)
rows=[]
for path in source_paths:
 r=(W/path).read_bytes();rows.append({"path":path,"bytes":len(r),"sha256":hashlib.sha256(r).hexdigest(),"git_blob":git("hash-object","--no-filters",path).decode().strip()})
static={"schema":"trnm-M4-portable-signal-recorder-static-v2","base":H,"source_files":rows,"change":"Only the two new signal recorder mocks add create=True; runtime9-line approved patch unchanged.","original14_source_and_ast_equal":True,"syntax_compilation_passed":True,"modules_imported":False,"tests_executed":False,"linux16_pending":True,"full_lane_passed":False,"initial_patch_preserved_sha256":hashlib.sha256(initial).hexdigest(),"current_patch":{"path":str(O/"source-and-tests.patch"),"bytes":len(patch),"sha256":hashlib.sha256(patch).hexdigest()},"initial_staged_whitespace_failure":{"source":str(E/"commit-v1/staged-diff-check.stdout"),"bytes":len(failure),"sha256":hashlib.sha256(failure).hexdigest()},"observed_at":datetime.datetime.now(datetime.timezone.utc).isoformat()}
dump(D/"source-static-validation-v2.json",static,True);dump(O/"static-summary.json",static,True)
readme=(D/"README.md").read_text().replace("[patch](source-and-tests.patch)","[current exact patch carrier](source-and-tests-current.patch.json)")
readme+="\nThe two new signal recorders explicitly use create=True so their logic does not depend on macOS exposing Linux pidfd_send_signal. Production requirements and all original Linux controls remain unchanged. The initial static patch is retained in a separate exact JSON carrier. The first staging check rejected unified-diff context spaces in the plain patch copy; the JSON carriers preserve its complete original bytes and SHA without weakening Git whitespace checks.\n"
(D/"README.md").write_text(readme)
entries=[]
for f in sorted(D.iterdir()):
 if f.name=="EVIDENCE_INDEX.json":continue
 r=f.read_bytes();entries.append({"path":f.name,"bytes":len(r),"sha256":hashlib.sha256(r).hexdigest()})
dump(D/"EVIDENCE_INDEX.json",{"schema":"trnm-M4-component-evidence-index-v2","base":H,"files":entries,"linux_execution_included":"original failed full lane only; no changed-source Linux run"})
allowed=source_paths+[str(f.relative_to(W)) for f in sorted(D.iterdir())]
run(["/usr/bin/git","add","--",*source_paths],"git-add-source")
run(["/usr/bin/git","add","-A","--",str(D.relative_to(W))],"git-add-component")
assert set(git("diff","--cached","--name-only").decode().splitlines())==set(allowed)
run(["/usr/bin/git","diff","--cached","--check"],"staged-diff-check")
run(["bash","scripts/project-preflight.sh","--staged"],"preflight-staged")
staged=git("diff","--cached","--binary","--full-index");(O/"staged.patch").write_bytes(staged)
run(["/usr/bin/git","commit","-m","fix(ci): preserve closed exec gate refusal before cleanup escalation"],"git-commit",120)
head=git("rev-parse","HEAD").decode().strip();tree=git("rev-parse","HEAD^{tree}").decode().strip()
assert git("rev-parse","HEAD^").decode().strip()==H and not git("status","--porcelain=v1")
committed=git("diff","--binary","--full-index",H,head);assert committed==staged;(O/"commit.patch").write_bytes(committed)
(O/"commit-object.raw").write_bytes(git("cat-file","commit",head))
paths=[]
for path in allowed:
 r=git("show",head+":"+path);paths.append({"path":path,"bytes":len(r),"sha256":hashlib.sha256(r).hexdigest(),"git_blob":git("rev-parse",head+":"+path).decode().strip()})
s={"schema":"trnm-M4-closed-gate-component-commit-v2","head":head,"tree":tree,"parent":H,"branch":git("branch","--show-current").decode().strip(),"clean":True,"paths":paths,"runtime_patch_matches_approved_design":True,"original14_source_and_ast_preserved":True,"added_deterministic_signal_controls":2,"portable_mock_create_true":True,"syntax_compilation_passed":True,"staged_preflight_passed":True,"changed_source_linux_tests_executed":False,"full_lane_passed":False,"remote_write":False,"coordinator_linux_validation_pending":True,"patch":{"path":str(O/"commit.patch"),"bytes":len(committed),"sha256":hashlib.sha256(committed).hexdigest()},"two_source_patch":static["current_patch"],"committed_at":datetime.datetime.now(datetime.timezone.utc).isoformat()}
sm=dump(O/"commit-summary.json",s,True)
print(json.dumps({"summary":sm,"head":head,"tree":tree,"parent":H,"paths":len(paths),"source_files":paths[:2],"patch":s["patch"],"two_source_patch":s["two_source_patch"],"clean":True}))
