  min_negative:u64 = const() {"value":4294934529}
  positive_ok:bool = compare.le(raw,bound)
  negative_ok:bool = compare.ge(raw,min_negative)
  ok_delta:bool = bool.or(positive_ok,negative_ok)
  branch ok_delta accumulate(ii,io,ip,il,raw,negative_ok) value_error()
block accumulate(ai:readbuf,ao:mutbuf,ap:usize,al:u64,av:u64,an:bool)
  absval:u64 = call(av,an) {"function":"iln_abs"}
  divisor:u64 = call(absval) {"function":"iln_divisor"}
  digits:u64 = call(divisor) {"function":"iln_digits"}
  one_sign:u64 = const() {"value":1}
  no_sign:u64 = const() {"value":0}
