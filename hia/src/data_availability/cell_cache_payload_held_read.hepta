fn ch_plan(ci:readbuf,cpos:u64,creq:u64,crows:u64,ccount:u64) -> (u64,u64,u64) effects(read,write,trap) entry(entry)
block entry(ci:readbuf,cpos:u64,creq:u64,crows:u64,ccount:u64)
  row_size_bytes:u64 = const() {"value":4}
  width:u64 = call(ci,crows,row_size_bytes) {"function":"ca_read_be"}
  index:u64 = int.div.checked(cpos,width)
  within:bool = compare.lt(index,ccount)
  off_in_chunk:u64 = int.rem.checked(cpos,width)
  branch within read_count(ci,creq,crows,index,off_in_chunk) internal()
block read_count(ki:readbuf,kreq:u64,kr:u64,kindex:u64,koff:u64)
  stride:u64 = const() {"value":36}
  sizelen:u64 = const() {"value":4}
  delta:u64 = int.mul.wrap(kindex,stride)
  row:u64 = int.add.wrap(kr,delta)
  got:u64 = call(ki,row,sizelen) {"function":"ca_read_be"}
  valid_off:bool = compare.lt(koff,got)
  left_chunk:u64 = int.sub.wrap(got,koff)
  limited:bool = compare.le(kreq,left_chunk)
  count_bytes:u64 = select(limited,kreq,left_chunk)
  branch valid_off found(row,koff,count_bytes) internal()
block found(row_at:u64,offset:u64,count:u64)
  ret(row_at,offset,count)
block internal()
  z:u64 = const() {"value":0}
  ret(z,z,z)
end
