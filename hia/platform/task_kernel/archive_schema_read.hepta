  payload:u64 = const() {"value":24}
  ddl:u64 = int.add.wrap(payload,k)
  enough:bool = compare.le(ddl,n)
  branch enough prefix(r,w,n,k,d,payload,ddl) no()
block prefix(pr:readbuf,pw:mutbuf,pn:u64,pk:u64,pd:u64,pa:u64,ps:u64)
  zero:u64 = const() {"value":0}
  literal:bool = call(pr,pw,pa,zero,pk) {"function":"arc_literal"}
  branch literal encoding(pr,pw,pn,ps,pd) no()
block encoding(er:readbuf,ew:mutbuf,en:u64,es:u64,ed:u64)
  width:u64 = int.sub.wrap(en,es)
  utf:u64 = call(er,es,width) {"function":"value_utf8"}
  one:u64 = const() {"value":1}
  valid:bool = compare.eq(utf,one)
  init:u64 = const() {"value":0}
  branch valid compare(er,ew,en,es,ed,init) no()
block compare(cr:readbuf,cw:mutbuf,cn:u64,ca:u64,cd:u64,ci:u64)
  more:bool = compare.lt(ca,cn)
  branch more classify(cr,cw,cn,ca,cd,ci) done(cd,ci)
