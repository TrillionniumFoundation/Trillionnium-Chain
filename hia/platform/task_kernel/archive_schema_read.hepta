  three_max:u64 = const() {"value":240}
  two:bool = compare.lt(mb,two_max)
  three:bool = compare.lt(mb,three_max)
  branch two pair(mr,mb,ma) longer(mr,mb,ma,three)
block pair(pr:readbuf,pb:u64,pa:u64)
  mask:u64 = const() {"value":31}
  leading:u64 = bit.and(pb,mask)
  full:u64,after:u64 = call(pr,leading,pa) {"function":"arc_cont_byte"}
  ret(full,after)
block longer(lr:readbuf,lb:u64,la:u64,lt:bool)
  branch lt triplet(lr,lb,la) quadruplet(la)
block triplet(tr:readbuf,tb:u64,ta:u64)
  bits:u64 = const() {"value":15}
  top:u64 = bit.and(tb,bits)
  a:u64,i:u64 = call(tr,top,ta) {"function":"arc_cont_byte"}
  whole:u64,end_at:u64 = call(tr,a,i) {"function":"arc_cont_byte"}
  ret(whole,end_at)
block quadruplet(qa:u64)
  unmatched:u64 = const() {"value":1114112}
  remain:u64 = const() {"value":3}
  last:u64 = int.add.wrap(qa,remain)
  ret(unmatched,last)
block done(x:u64,nx:u64)
  ret(x,nx)
end

fn arc_cont_byte(r:readbuf,acc:u64,i:u64) -> (u64,u64) effects(read,write,trap) entry(entry)
block entry(r:readbuf,acc:u64,i:u64)
  idx:usize = int.cast(i) {"mode":"wrap"}
  tail:u8 = buffer.load(r,idx)
  b:u64 = int.cast(tail) {"mode":"wrap"}
  mask:u64 = const() {"value":63}
  part:u64 = bit.and(b,mask)
  six:u64 = const() {"value":6}
  top:u64 = int.shl.checked(acc,six)
  val:u64 = bit.or(top,part)
  one:u64 = const() {"value":1}
  following:u64 = int.add.wrap(i,one)
  ret(val,following)
end

fn arc_space(c:u64) -> (bool) effects(read,write,trap) entry(entry)
block entry(c:u64)
  tab0:u64 = const() {"value":9}
  tab1:u64 = const() {"value":13}
  ctrl0:bool = compare.ge(c,tab0)
  ctrl1:bool = compare.le(c,tab1)
  ctrl:bool = bool.and(ctrl0,ctrl1)
  special0:u64 = const() {"value":8192}
  special1:u64 = const() {"value":8202}
  sp0:bool = compare.ge(c,special0)
  sp1:bool = compare.le(c,special1)
  sp:bool = bool.and(sp0,sp1)
  kind0:bool = bool.or(ctrl,sp)
  e1:u64 = const() {"value":32}
  p1:bool = compare.eq(c,e1)
  kind1:bool = bool.or(kind0,p1)
  e2:u64 = const() {"value":133}
  p2:bool = compare.eq(c,e2)
  kind2:bool = bool.or(kind1,p2)
  e3:u64 = const() {"value":160}
  p3:bool = compare.eq(c,e3)
  kind3:bool = bool.or(kind2,p3)
  e4:u64 = const() {"value":5760}
  p4:bool = compare.eq(c,e4)
  kind4:bool = bool.or(kind3,p4)
  e5:u64 = const() {"value":8232}
  p5:bool = compare.eq(c,e5)
  kind5:bool = bool.or(kind4,p5)
  e6:u64 = const() {"value":8233}
  p6:bool = compare.eq(c,e6)
  kind6:bool = bool.or(kind5,p6)
  e7:u64 = const() {"value":8239}
  p7:bool = compare.eq(c,e7)
  kind7:bool = bool.or(kind6,p7)
  e8:u64 = const() {"value":8287}
  p8:bool = compare.eq(c,e8)
  kind8:bool = bool.or(kind7,p8)
  e9:u64 = const() {"value":12288}
  p9:bool = compare.eq(c,e9)
  kind9:bool = bool.or(kind8,p9)
  ret(kind9)
end

fn arc_lower(c:u64) -> (u64) effects(read,write,trap) entry(entry)
block entry(c:u64)
  aa:u64 = const() {"value":65}
  zz:u64 = const() {"value":90}
  lo:bool = compare.ge(c,aa)
  hi:bool = compare.le(c,zz)
  upper:bool = bool.and(lo,hi)
  delta:u64 = const() {"value":32}
  ascii:u64 = int.add.wrap(c,delta)
  lower:u64 = select(upper,ascii,c)
  kelvin:u64 = const() {"value":8490}
  k:u64 = const() {"value":107}
  special:bool = compare.eq(c,kelvin)
  result:u64 = select(special,k,lower)
  ret(result)
end
