stage('risk-reader-tests-25',[py,'-m','unittest','discover','-s','formal/pon-nakamoto-v1','-p','test_native_risk_ledger.py','-v'])
stage('actual-certificate-composition-join',[py,'formal/pon-nakamoto-v1/certificate_composition_evidence.py','--native-run',env['NATIVE_OWNER_JOURNAL_RUN'],'--output-dir',str(out/'composition')])
stage('certificate-composition-tests-16',[py,'formal/pon-nakamoto-v1/certificate_composition_tests.py','-v'])
assert stage('final-head',['git','rev-parse','HEAD'])==head
