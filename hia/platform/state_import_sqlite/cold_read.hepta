end

fn sr_match64(ir:readbuf,is:mutbuf,ifrom:usize,istart:usize,iend:usize) -> (bool) effects(read,write,trap) entry(entry)
block entry(ir:readbuf,is:mutbuf,ifrom:usize,istart:usize,iend:usize)
  jump loop(ir,is,ifrom,istart,iend)
block loop(r:readbuf,s:mutbuf,from:usize,start:usize,end_at:usize)
  actual:u8 = buffer.load(r,from)
  expected:u8 = buffer.load(s,start)
  match:bool = compare.eq(actual,expected)
  branch match next(r,s,from,start,end_at) bad()
block next(nr:readbuf,ns:mutbuf,nf:usize,nb:usize,ne:usize)
  one:usize = const() {"value":1}
  next_r:usize = int.add.wrap(nf,one)
  next_s:usize = int.add.wrap(nb,one)
  done:bool = compare.eq(next_s,ne)
  branch done good() loop(nr,ns,next_r,next_s,ne)
block good()
  yes:bool = const() {"value":true}
  ret(yes)
block bad()
  no:bool = const() {"value":false}
  ret(no)
end

fn sr_append(r:readbuf,s:mutbuf,n:usize) -> (bool) effects(read,write,trap) entry(entry)
block entry(r:readbuf,s:mutbuf,n:usize)
  source:u64 = const() {"value":24}
  position:u64 = const() {"value":56}
  next:u64 = call(s,position) {"function":"cp_get"}
  width:u64 = int.cast(n) {"mode":"wrap"}
  bytes:u64 = int.sub.wrap(width,source)
  available:u64 = const() {"value":1048576}
  remain:u64 = int.sub.wrap(available,next)
  fits:bool = compare.le(bytes,remain)
  branch fits copy(r,s,next,bytes,source,position) bad()
block copy(cr:readbuf,cs:mutbuf,at:u64,cn:u64,src:u64,pos:u64)
  _data:u64 = call(cr,src,cs,at,cn) {"function":"cp_copy"}
  new:u64 = int.add.wrap(at,cn)
  _end:u64 = call(cs,pos,new) {"function":"cp_put"}
  yes:bool = const() {"value":true}
  ret(yes)
block bad()
  no:bool = const() {"value":false}
  ret(no)
end
