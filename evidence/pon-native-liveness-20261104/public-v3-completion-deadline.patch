+            assert!(!row.response_frame_complete);
+            let m = self.metrics.lock().unwrap();
+            assert_eq!(m.executor_refusals, 0);
+            assert_eq!(m.work_failed, 0);
+            assert_eq!(m.mutation_cpu_charged_ns, 0);
+        }
+    }
