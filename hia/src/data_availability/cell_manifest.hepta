  one:u64 = const() {"value":1}
  last:bool = compare.eq(sn,one)
  stride:u64 = const() {"value":36}
  after:u64 = int.add.wrap(sa,stride)
  left_n:u64 = int.sub.wrap(sn,one)
  left_bytes:u64 = int.sub.wrap(sz,expected)
  branch okay advance(si,after,left_n,sk,left_bytes,last) no()
block advance(ai:readbuf,aa:u64,an:u64,ak:u64,az:u64,done:bool)
  branch done yes() step(ai,aa,an,ak,az)
block yes()
  good:bool = const() {"value":true}
  ret(good)
block no()
  bad:bool = const() {"value":false}
  ret(bad)
end

