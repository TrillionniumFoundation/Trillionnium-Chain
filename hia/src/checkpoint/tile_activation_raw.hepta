  d1:u64 = call(w,a1) {"function":"tr_get"}
  d2:u64 = call(w,a2) {"function":"tr_get"}
  d3:u64 = call(w,a3) {"function":"tr_get"}
  x0:u64 = bit.xor(h0,d0)
  x1:u64 = bit.xor(h1,d1)
  x2:u64 = bit.xor(h2,d2)
  x3:u64 = bit.xor(h3,d3)
  first:u64 = bit.or(x0,x1)
  second:u64 = bit.or(x2,x3)
  both:u64 = bit.or(first,second)
