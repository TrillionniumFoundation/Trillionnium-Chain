  "priorities": [
    {
      "id": "parallel_prepare_deterministic_commit",
      "title": "无状态准备并行、状态结果确定性提交",
      "implemented": [
        {
          "text": "M06 已用有界 scoped workers 准备和验签，workers 只接受 1/2/4/8。全部已启动 workers 在返回前 join，结果按原交易索引排序；错误在原位置消耗。",
          "sources": [
            "m06",
            "m06_apply"
          ]
        },
        {
          "text": "余额、nonce、费用、receipts 按原顺序应用；冲突在当前状态 canonical replay 一次，不重复主签名验证。Growth partial view、PQ accounts V2、单 worker、全同 sender 使用串行状态路径，独立准备/验签仍可并行。",
          "sources": [
            "m06",
            "m06_apply"
          ]
        },
        {
          "text": "普通 shared admission 可在私有 prepared artifact 形成后释放 Node mutex 执行 M06，再获取 owner 并由 commit_shared_admission 重验 epoch/current context；子阶段仍使用同一原 deadline 和 CPU 账户。",
          "sources": [
            "ordinary_admission",
            "detached_commit"
          ]
        }
      ],
      "limitations_and_next_work": [
        {
          "text": "detached_execution_supported 排除 owner_policy、mining_owner、continuous_owner、PermanentAccountGrowthV2、Growth profile、active root rejection cache，不能声称所有入口都脱离 owner 锁。",
          "sources": [
            "detached_support"
          ]
        },
        {
          "text": "需按真实普通入口量化 prepare、owner wait、state read/commit、全部 worker CPU。同一共享 0.25 CPU 下多线程本身不增加容量；已有并行代码不是公网 TPS 证明。",
          "sources": [
            "ordinary_admission",
            "m06"
          ]
        }
      ]
    },
    {
      "id": "model_data_control_isolation",
      "title": "模型传输与控制资源分离",
      "implemented": [
        {
          "text": "Cell 下载已有有限连接、响应字节、重试和绝对 deadline。bounded serving 使用有界 workers、独立已验证只读 cache reader，不持 SQLite lock 跨 socket I/O。",
          "sources": [
            "cell_fetch",
            "cell_serve"
          ]
        },
        {
          "text": "repair_native_cell 要求绑定 CPU、下载字节、attempt reservation，在 effect window 内执行；其结果只是单次 invocation observation，不是 durable whole-lifecycle receipt。",
          "sources": [
            "cell_repair"
          ]
        },
        {
          "text": "material runtime bridge 精确绑定材料、plan、contract，解决 provenance/runtime 兼容边界；不能据此推导主机资源隔离。",
          "sources": [
            "material_bridge"
          ]
        }
      ],
      "limitations_and_next_work": [
        {
          "text": "Cell serving 源码明确不承诺攻击者占满全部 slots 时仍公平服务；独立模块和 bounded queues 不能证明 CPU、NIC、磁盘竞争下的链业务 deadline。",
          "sources": [
            "cell_fairness_scope"
          ]
        },
        {
          "text": "需同一固定 Host 同时运行大 Cell 传输/模型加载及真实签名确认、撤回、恢复，分别报告 Cell GB/s、冷/热加载分位数、链业务完成率与延迟和共同预算中的资源消耗。",
          "sources": [
            "cell_fetch",
            "cell_serve",
            "cell_repair"
          ]
        }
      ]
    },
    {
      "id": "adversarial_fairness",
      "title": "恶意负载下的诚实业务完成率",
      "implemented": [
        {
          "text": "同一 CPU domain epoch 内跨 listeners 共享连接、body/output、read/mutation grants 和 challenges。原连接 64、paid body 8 MiB；read body reserve 128 KiB、control output reserve 512 KiB 从原总量分区。",
          "sources": [
            "intake",
            "public_caps"
          ]
        },
        {
