  loop_value:u64 = int.add.wrap(loop_old,loop_d)
  loop_next:u64 = int.add.wrap(loop_a,loop_one)
  loop_more:bool = compare.lt(loop_next,loop_stop)
  branch loop_more loop(loop_r,loop_next,loop_stop,loop_value) finish(loop_value)
block finish(finish_v:u64)
  ret(finish_v)
end

