{
  "schema": "trnm-project-boundary-v2",
  "project_id": "trillionnium-chain",
  "canonical_repository": "TrillionniumFoundation/Trillionnium-Chain",
  "lane": "chain-consensus", "lifecycle": "active",
  "repository": {
    "current_visibility": "public", "visibility_change_requires_owner_decision": true,
    "default_branch": "main", "required_protected_branches": ["main"],
    "required_pull_request_reviews": 2, "require_code_owner_review": true,
    "require_last_push_approval": true, "block_force_push": true, "block_branch_deletion": true
  },
  "consensus": {
    "development_target": "pon-nakamoto-v1", "active_implementation": null,
    "production_candidate": false, "production_consensus_activation": false,
    "external_consensus_engines_allowed": false, "fallback_consensus_engines_allowed": false
  },
  "cargo": {
    "workspace_manifest": "trillionnium/Cargo.toml",
    "source_inventory": "config/portability-inventory-v1.json",
    "forbidden_external_path_dependencies": true
  },
  "authoritative_status": "config/consensus-mainline.json",
  "authoritative_plan": "docs/development/TRNM_AI_NATIVE_BLOCKCHAIN_DEVELOPMENT_PLAN.md",
  "canonical_dir": "trillionnium-chain", "development": true,
  "remote": {"policy": "required", "canonical_slug": "TrillionniumFoundation/Trillionnium-Chain", "upstream_required": true},
  "branch": {"protected": ["main"], "development_regex": "^(feature|fix|chore|docs|test)/chain-[a-z0-9][a-z0-9._-]*$"},
  "owned_surfaces": ["chain protocol", "portable application and storage", "node and client contracts", "release and evidence tooling"],
  "excluded_surfaces": ["World gameplay", "Hepta owned stores", "Nakama match state", "cross-repository orchestration"],
  "deny_changed_paths_regex": "^trillionnium/crates/(trnm-first-contact|trnm-game-server|trnm-campaign-core|trnm-rts-|trnm-online-|trnm-economy-)"
}
