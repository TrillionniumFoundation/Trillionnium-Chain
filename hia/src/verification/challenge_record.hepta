  dec_at:u64 = int.add.wrap(record,dec_offset)
  app_at:u64 = int.add.wrap(record,app_offset)
  width:u64 = const() {"value":8}
  next:u64 = call(input,argument_at,width) {"function":"rac_read_le"}
  old_dec:u64 = call(input,dec_at,width) {"function":"rac_read_le"}
  old_app:u64 = call(input,app_at,width) {"function":"rac_read_le"}
  dec:u64 = select(rewrites,next,old_dec)
  app:u64 = select(rewrites,next,old_app)
  ret(dec,app)
end

fn cx_pack(phase:u64,used:u64,outcome:u64) -> (u64) effects(trap) entry(entry)
block entry(phase:u64,used:u64,outcome:u64)
  phase_shift:u64 = const() {"value":8}
  used_shift:u64 = const() {"value":16}
  outcome_shift:u64 = const() {"value":24}
  a:u64 = int.shl.checked(phase,phase_shift)
  b:u64 = int.shl.checked(used,used_shift)
  c:u64 = int.shl.checked(outcome,outcome_shift)
  d:u64 = bit.or(a,b)
  packed:u64 = bit.or(d,c)
  ret(packed)
end

fn cx_write_le(out:mutbuf,start:u64,value:u64,count:u64) -> (u64) effects(write,trap) entry(entry)
block entry(out:mutbuf,start:u64,value:u64,count:u64)
  zero:u64 = const() {"value":0}
  jump loop(out,start,value,count,zero)
block loop(lo:mutbuf,ls:u64,lv:u64,ln:u64,li:u64)
  more:bool = compare.lt(li,ln)
  branch more copy(lo,ls,lv,ln,li) finished(ls,ln)
block copy(co:mutbuf,cs:u64,cv:u64,cn:u64,ci:u64)
  index:u64 = int.add.wrap(cs,ci)
  pointer:usize = int.cast(index) {"mode":"wrap"}
  byte:u8 = int.cast(cv) {"mode":"wrap"}
  _ = buffer.store(co,pointer,byte)
  eight:u64 = const() {"value":8}
  one:u64 = const() {"value":1}
  remaining:u64 = int.shr.checked(cv,eight)
  next:u64 = int.add.wrap(ci,one)
  jump loop(co,cs,remaining,cn,next)
block finished(fs:u64,fn_:u64)
  end_offset:u64 = int.add.wrap(fs,fn_)
  ret(end_offset)
end

fn cx_frame_number(work:mutbuf,pos:u64,value:u64,width:u64) -> (u64) effects(write,trap) entry(entry)
block entry(work:mutbuf,pos:u64,value:u64,width:u64)
  eight:u64 = const() {"value":8}
  at:u64 = call(work,pos,width,eight) {"function":"rac_write_be"}
  end_offset:u64 = call(work,at,value,width) {"function":"rac_write_be"}
  ret(end_offset)
end

fn cx_frame_digest(input:readbuf,work:mutbuf,pos:u64,source:u64) -> (u64) effects(read,write,trap) entry(entry)
block entry(input:readbuf,work:mutbuf,pos:u64,source:u64)
  eight:u64 = const() {"value":8}
  width:u64 = const() {"value":32}
  at:u64 = call(work,pos,width,eight) {"function":"rac_write_be"}
  end_offset:u64 = call(input,work,source,at,width) {"function":"rac_copy"}
  ret(end_offset)
end

fn cx_hash(input:readbuf,work:mutbuf,packed:u64,decision:u64,appeal:u64) -> (u64) effects(read,write,trap) entry(entry)
block entry(input:readbuf,work:mutbuf,packed:u64,decision:u64,appeal:u64)
  record_at:u64 = const() {"value":24}
  result:u64 = call(input,work,packed,decision,appeal,record_at) {"function":"cx_hash_at"}
  ret(result)
end

fn cx_hash_at(input:readbuf,work:mutbuf,packed:u64,decision:u64,appeal:u64,record:u64) -> (u64) effects(read,write,trap) entry(entry)
block entry(input:readbuf,work:mutbuf,packed:u64,decision:u64,appeal:u64,record:u64)
  init:u64 = call(work) {"function":"tr_sha_init"}
  zero:u64 = const() {"value":0}
  okay:bool = compare.eq(init,zero)
  branch okay transcript(input,work,packed,decision,appeal,record) refused(init)
block transcript(ti:readbuf,tw:mutbuf,tp:u64,td:u64,ta:u64,tr:u64)
  base:u64 = const() {"value":1208}
  eight:u64 = const() {"value":8}
  one:u64 = const() {"value":1}
  width:u64 = const() {"value":29}
  at:u64 = call(tw,base,width,eight) {"function":"rac_write_be"}
  word_0:u64 = const() {"value":7147889007692509812}
  _w_0:u64 = call(tw,at,word_0) {"function":"tr_put"}
  word_1:u64 = const() {"value":7954883529566348078}
  place_1:u64 = const() {"value":1224}
  _w_1:u64 = call(tw,place_1,word_1) {"function":"tr_put"}
  word_2:u64 = const() {"value":8245918730097091943}
  place_2:u64 = const() {"value":1232}
  _w_2:u64 = call(tw,place_2,word_2) {"function":"tr_put"}
  word_3:u64 = const() {"value":829828708}
  place_3:u64 = const() {"value":1240}
  _w_3:u64 = call(tw,place_3,word_3) {"function":"tr_put"}
  after_domain:u64 = int.add.wrap(at,width)
  result_position:u64 = const() {"value":32}
  result_at:u64 = int.add.wrap(tr,result_position)
  actor_position:u64 = const() {"value":64}
  actor_at:u64 = int.add.wrap(tr,actor_position)
  after_challenge:u64 = call(ti,tw,after_domain,tr) {"function":"cx_frame_digest"}
  after_result:u64 = call(ti,tw,after_challenge,result_at) {"function":"cx_frame_digest"}
  after_actor:u64 = call(ti,tw,after_result,actor_at) {"function":"cx_frame_digest"}
  used_shift:u64 = const() {"value":16}
  outcome_shift:u64 = const() {"value":24}
  mask:u64 = const() {"value":255}
  phase_bits:u64 = int.shr.checked(tp,eight)
  used_bits:u64 = int.shr.checked(tp,used_shift)
  outcome_bits:u64 = int.shr.checked(tp,outcome_shift)
  phase:u64 = bit.and(phase_bits,mask)
  used:u64 = bit.and(used_bits,mask)
  outcome:u64 = bit.and(outcome_bits,mask)
  after_phase:u64 = call(tw,after_actor,phase,one) {"function":"cx_frame_number"}
  opened_position:u64 = const() {"value":96}
  opened_at:u64 = int.add.wrap(tr,opened_position)
  opened:u64 = call(ti,opened_at,eight) {"function":"rac_read_le"}
  after_opened:u64 = call(tw,after_phase,opened,eight) {"function":"cx_frame_number"}
  evidence_position:u64 = const() {"value":104}
  evidence_at:u64 = int.add.wrap(tr,evidence_position)
  evidence:u64 = call(ti,evidence_at,eight) {"function":"rac_read_le"}
  after_evidence:u64 = call(tw,after_opened,evidence,eight) {"function":"cx_frame_number"}
  response_position:u64 = const() {"value":112}
  response_at:u64 = int.add.wrap(tr,response_position)
  response:u64 = call(ti,response_at,eight) {"function":"rac_read_le"}
  after_response:u64 = call(tw,after_evidence,response,eight) {"function":"cx_frame_number"}
  after_decision:u64 = call(tw,after_response,td,eight) {"function":"cx_frame_number"}
  after_appeal:u64 = call(tw,after_decision,ta,eight) {"function":"cx_frame_number"}
  after_used:u64 = call(tw,after_appeal,used,one) {"function":"cx_frame_number"}
  after_outcome:u64 = call(tw,after_used,outcome,one) {"function":"cx_frame_number"}
  extent:u64 = int.sub.wrap(after_outcome,base)
  updated:u64 = call(tw,base,extent) {"function":"tr_sha_update_work"}
  clear:u64 = const() {"value":0}
  done:bool = compare.eq(updated,clear)
  branch done finish(tw) refused(updated)
block finish(fw:mutbuf)
  digest_status:u64 = call(fw) {"function":"tr_sha_final"}
  ret(digest_status)
block refused(code:u64)
  ret(code)
end
