block read_plan(ri:readbuf,ro:mutbuf,rs:u64,rp:u64,rn:u64,rr:u64,rc:u64)
  rz:u64 = const() {"value":0}
  nonempty:bool = compare.lt(rz,rn)
  more:bool = compare.lt(rp,rs)
  needed:bool = bool.and(nonempty,more)
  branch needed chunk(ri,ro,rp,rn,rr,rc) read_out(ro,rz,rz,rz,rp)
block chunk(ci:readbuf,co:mutbuf,cpos:u64,creq:u64,crows:u64,ccount:u64)
  row_size_bytes:u64 = const() {"value":4}
  width:u64 = call(ci,crows,row_size_bytes) {"function":"ca_read_be"}
