fn csw_matches(w:mutbuf) -> (bool) effects(read,write,trap) entry(entry)
block entry(w:mutbuf)
  a:u64 = const() {"value":1168}
  b:u64 = const() {"value":1264}
  n:u64 = const() {"value":4}
  jump loop(w,a,b,n)
block loop(lw:mutbuf,la:u64,lb:u64,ln:u64)
  x:u64 = call(lw,la) {"function":"tr_get"}
  y:u64 = call(lw,lb) {"function":"tr_get"}
  equal:bool = compare.eq(x,y)
  branch equal more(lw,la,lb,ln) wrong()
block more(mw:mutbuf,ma:u64,mb:u64,mn:u64)
  eight:u64 = const() {"value":8}
  one:u64 = const() {"value":1}
  na:u64 = int.add.wrap(ma,eight)
  nb:u64 = int.add.wrap(mb,eight)
  nn:u64 = int.sub.wrap(mn,one)
  done:bool = compare.eq(mn,one)
  branch done good() loop(mw,na,nb,nn)
block wrong()
  no:bool = const() {"value":false}
  ret(no)
block good()
  yes:bool = const() {"value":true}
  ret(yes)
end
