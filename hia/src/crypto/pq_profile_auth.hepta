fn ca_hash_owned(o:mutbuf,at:u64,count:u64,w:mutbuf) -> (u64) effects(read,write,trap) entry(entry)
block entry(o:mutbuf,at:u64,count:u64,w:mutbuf)
  initial:u64 = call(w) {"function":"s512_init"}
  read:readbuf = borrow.read(o)
  updated:u64 = call(read,at,count,w) {"function":"s512_update"}
  _ = loan.end(read)
  final:u64 = call(w) {"function":"s512_final"}
  first:u64 = bit.or(initial,updated)
  result:u64 = bit.or(first,final)
  ret(result)
end
fn ca_hash_prefix(o:mutbuf,prefix:u64,prefix_size:u64,s:readbuf,at:u64,count:u64,w:mutbuf) -> (u64) effects(read,write,trap) entry(entry)
block entry(o:mutbuf,prefix:u64,prefix_size:u64,s:readbuf,at:u64,count:u64,w:mutbuf)
  initial:u64 = call(w) {"function":"s512_init"}
  read:readbuf = borrow.read(o)
  part:u64 = call(read,prefix,prefix_size,w) {"function":"s512_update"}
  _ = loan.end(read)
  updated:u64 = call(s,at,count,w) {"function":"s512_update"}
  final:u64 = call(w) {"function":"s512_final"}
  first:u64 = bit.or(initial,part)
  second:u64 = bit.or(first,updated)
  result:u64 = bit.or(second,final)
  ret(result)
end
fn ca_verify_one(o:mutbuf,s:readbuf,w:mutbuf,parameter:u64,pk:u64,sig:u64,message:u64,count:u64) -> (u64) effects(read,write,trap) entry(entry)
block entry(o:mutbuf,s:readbuf,w:mutbuf,parameter:u64,pk:u64,sig:u64,message:u64,count:u64)
  read:readbuf = borrow.read(o)
  result:u64 = call(read,s,s,w,parameter,pk,sig,message,count) {"function":"mo_verify_parts"}
  _ = loan.end(read)
  ret(result)
end
