fn wid_equal(entry_i:readbuf,entry_s:mutbuf,entry_a:u64,entry_b:u64,entry_n:u64) -> (bool) effects(read,trap) entry(entry)
block entry(entry_i:readbuf,entry_s:mutbuf,entry_a:u64,entry_b:u64,entry_n:u64)
  jump loop(entry_i,entry_s,entry_a,entry_b,entry_n)
block loop(loop_i:readbuf,loop_s:mutbuf,loop_a:u64,loop_b:u64,loop_n:u64)
  loop_zero:u64 = const() {"value":0}
