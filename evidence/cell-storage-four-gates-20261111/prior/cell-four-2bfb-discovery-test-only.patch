+#[test]
+fn authenticated_v3_all_withholding_sources_refuse_with_original_deadline_and_counters() {
+    let now = epoch_now();
+    let tmp = tempfile::tempdir().unwrap();
+    let (_, provider_pin) = key_and_pin(71);
+    let request = request([20; 32], now);
+    let withholding: Vec<_> = (72..74).map(WithholdingSource::start).collect();
+    let options = options(request, &withholding, None, &[]);
+    let directory = CellProviderDirectoryV3::open(
+        &tmp.path().join("directory"),
+        context(),
+        CellPqKeyPinsV2::new(vec![provider_pin]).unwrap(),
+        options.source_pins().unwrap(),
+    )
+    .unwrap();
+    let store = CellStoreV1::open(&tmp.path().join("consumer"), cache()).unwrap();
+    let output = tmp.path().join("missing");
+    let limits = CellPeerLimitsV1 {
+        max_connections: 4,
+        ..limits()
+    };
+    let started = Instant::now();
+    let original_deadline = started + Duration::from_secs(2);
+    let failure = fetch_authenticated_discovered_cell_to_file_pq_observed(
+        &store,
+        &directory,
+        &options,
+        limits,
+        original_deadline,
+        &output,
+    )
+    .unwrap_err();
+    let finished = Instant::now();
+    let observed_queries: Vec<_> = withholding
+        .into_iter()
+        .map(|source| source.finish())
+        .collect();
+    eprintln!(
+        "authenticated-v3 all-withholding: elapsed={:?}, query_counts={:?}, failure={failure:?}",
+        finished.duration_since(started),
+        observed_queries.iter().map(Vec::len).collect::<Vec<_>>(),
+    );
+    assert!(finished < original_deadline);
+    assert!(matches!(
+        failure.cause,
+        CellErrorV1::Invalid("authenticated discovery has no admissible provider")
+    ));
+    assert_eq!(failure.discovery.connection_attempts, 4);
+    assert_eq!(failure.discovery.bootstrap_validation_attempts, 4);
+    assert_eq!(failure.discovery.record_validation_attempts, 0);
+    assert_eq!(failure.discovery.rejected_bootstraps, 4);
+    assert_eq!(failure.discovery.ineligible_bootstraps, 0);
+    assert_eq!(failure.total_connection_attempts, 4);
+    assert_eq!(failure.total_received_response_bytes, Some(0));
+    assert!(!output.exists());
+    for nonces in observed_queries {
+        assert_eq!(nonces.len(), 2);
+        assert_ne!(nonces[0], nonces[1]);
+    }
+    assert_eq!(
+        directory
+            .usage_at(wall_now().unwrap().as_secs(), deadline())
+            .unwrap()
+            .retained_identities,
+        0
+    );
+}
