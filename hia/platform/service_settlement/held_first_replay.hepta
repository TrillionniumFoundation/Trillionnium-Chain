block usual_parent(up_r:readbuf,up_m:mutbuf,up_w:mutbuf,up_i:u64,up_f:bool,up_l:bool,up_n:u64,up_p:usize,up_ok:bool,up_var:bool)
  branch up_var variable_parent(up_r,up_m,up_w,up_i,up_f,up_l,up_n,up_p) fixed_parent(up_r,up_m,up_w,up_i,up_l,up_n,up_ok)
