  reduced_k:u64 = int.div.checked(nk,reduced_d)
  choose:u64 = int.mul.checked(reduced_k,reduced_n)
  sum:u64 = int.add.checked(ns,choose)
  jump terms(nd,nl,divisor,choose,sum)
block finish(fs:u64)
  ret(fs)
end
fn pes_gate(n:i64,g:u64,w:u64,l:u64,c:u64,m:u64) -> (u64) effects(trap) entry(entry)
block entry(n:i64,g:u64,w:u64,l:u64,c:u64,m:u64)
  z_s:i64 = const() {"value":0}
  positive:bool = compare.lt(z_s,n)
  enough:bool = compare.le(m,g)
  directional:bool = compare.lt(l,w)
  decision:bool = bool.and(positive,directional)
  possible:bool = bool.and(decision,enough)
  branch possible exact(w,l,c) reject()
block exact(ew:u64,el:u64,ec:u64)
  d:u64 = int.add.wrap(ew,el)
  tail:u64 = call(d,el) {"function":"pes_tail"}
  twenty:u64 = const() {"value":20}
  divisor:u64 = int.mul.wrap(ec,twenty)
  full:u64 = const() {"value":64}
  wide:bool = compare.eq(d,full)
  branch wide wide_limit(tail,divisor) narrow_limit(tail,divisor,d)
block wide_limit(wt:u64,wd:u64)
  mx:u64 = const() {"value":18446744073709551615}
  quotient:u64 = int.div.checked(mx,wd)
  rem:u64 = int.rem.checked(mx,wd)
  one:u64 = const() {"value":1}
  zero:u64 = const() {"value":0}
  next:u64 = int.add.wrap(rem,one)
  carry:bool = compare.eq(next,wd)
  inc:u64 = select(carry,one,zero)
  wide_threshold:u64 = int.add.wrap(quotient,inc)
  jump compare_tail(wt,wide_threshold)
block narrow_limit(nt:u64,nd:u64,ni:u64)
  n_one:u64 = const() {"value":1}
  power:u64 = int.shl.checked(n_one,ni)
  threshold:u64 = int.div.checked(power,nd)
  jump compare_tail(nt,threshold)
block compare_tail(ct:u64,limit:u64)
  pass:bool = compare.le(ct,limit)
  gy:u64 = const() {"value":1}
  gn:u64 = const() {"value":0}
  bit:u64 = select(pass,gy,gn)
  ret(bit)
block reject()
  no:u64 = const() {"value":0}
  ret(no)
end
fn pes_store(o:mutbuf,at:u64,v:u64) -> () effects(write,trap) entry(entry)
block entry(o:mutbuf,at:u64,v:u64)
  size:u64 = const() {"value":8}
  end:u64 = int.add.wrap(at,size)
  jump loop(o,at,end,v)
block loop(lo:mutbuf,la:u64,le:u64,lv:u64)
  done:bool = compare.eq(la,le)
  branch done finish() byte(lo,la,le,lv)
block byte(bo:mutbuf,ba:u64,be:u64,bv:u64)
  place:usize = int.cast(ba) {"mode":"wrap"}
  low:u8 = int.cast(bv) {"mode":"wrap"}
  _ = buffer.store(bo,place,low)
  one:u64 = const() {"value":1}
  at_next:u64 = int.add.wrap(ba,one)
  eight:u64 = const() {"value":8}
  high:u64 = int.shr.checked(bv,eight)
  jump loop(bo,at_next,be,high)
block finish()
  ret()
end
fn pes_score(r:readbuf,o:mutbuf,c:u64,m:u64,f:u64,start:u64,end:u64,stride:u64,choice:u64) -> () effects(read,write,trap) entry(entry)
block entry(r:readbuf,o:mutbuf,c:u64,m:u64,f:u64,start:u64,end:u64,stride:u64,choice:u64)
  zero:u64 = const() {"value":0}
  zero_s:i64 = const() {"value":0}
  den:u64 = const() {"value":1}
  jump loop(r,o,c,m,f,end,start,zero,zero,zero,zero_s,den,start,stride,choice)
block loop(lr:readbuf,lo:mutbuf,lc:u64,lm:u64,lf:u64,le:u64,la:u64,lg:u64,lw:u64,ll:u64,ln:i64,ld:u64,lstart:u64,lstep:u64,lchoice:u64)
  done:bool = compare.eq(la,le)
  branch done normalize(lo,lc,lm,lf,lg,lw,ll,ln,ld) test(lr,lo,lc,lm,lf,le,la,lg,lw,ll,ln,ld,lstart,lstep,lchoice)
block test(tr:readbuf,to:mutbuf,tc:u64,tm:u64,tf:u64,te:u64,ta:u64,tg:u64,tw:u64,tl:u64,tn:i64,td:u64,tstart:u64,tstep:u64,tchoice:u64)
  key:u64 = call(tr,ta) {"function":"pes_group_at"}
  group:bool = const() {"value":true}
  seen:bool = call(tr,tstart,ta,key,group) {"function":"pes_seen"}
  width:u64 = const() {"value":104}
  next:u64 = int.add.wrap(ta,width)
  branch seen loop(tr,to,tc,tm,tf,te,next,tg,tw,tl,tn,td,tstart,tstep,tchoice) sum(tr,to,tc,tm,tf,te,ta,tg,tw,tl,tn,td,key,tstart,tstep,tchoice)
block sum(sr:readbuf,so:mutbuf,sc:u64,sm:u64,sf:u64,se:u64,sa:u64,sg:u64,sw:u64,sl:u64,sn:i64,sd:u64,sk:u64,sstart:u64,sstep:u64,schoice:u64)
  row_width:u64 = const() {"value":104}
  offset:u64 = int.sub.wrap(sa,sstart)
  ordinal:u64 = int.div.checked(offset,row_width)
  side_delta:u64 = int.mul.wrap(ordinal,sstep)
  side:u64 = int.add.wrap(se,side_delta)
  sx:u64 = int.add.wrap(sa,row_width)
  packed:u64 = call(sr,sa,se,sk,side,sstep,schoice) {"function":"pes_group"}
  radix:u64 = const() {"value":256}
  sz:u64 = int.div.checked(packed,radix)
  biased:u64 = int.rem.checked(packed,radix)
  signed_biased:i64 = int.cast(biased) {"mode":"wrap"}
  bias:i64 = const() {"value":64}
  delta:i64 = int.sub.wrap(signed_biased,bias)
  zs:i64 = const() {"value":0}
  pos:bool = compare.lt(zs,delta)
  neg:bool = compare.lt(delta,zs)
  one:u64 = const() {"value":1}
  zero_inc:u64 = const() {"value":0}
  wi:u64 = select(pos,one,zero_inc)
  li:u64 = select(neg,one,zero_inc)
  ng:u64 = int.add.wrap(sg,one)
  nw:u64 = int.add.wrap(sw,wi)
  nl:u64 = int.add.wrap(sl,li)
  ns:u64 = int.mul.checked(sd,sz)
  sz_s:i64 = int.cast(sz) {"mode":"wrap"}
  sd_s:i64 = int.cast(sd) {"mode":"wrap"}
  left:i64 = int.mul.checked(sn,sz_s)
  right:i64 = int.mul.checked(delta,sd_s)
  nnum:i64 = int.add.checked(left,right)
  jump loop(sr,so,sc,sm,sf,se,sx,ng,nw,nl,nnum,ns,sstart,sstep,schoice)
block normalize(no:mutbuf,nc:u64,nm:u64,nf:u64,ngroup:u64,nwins:u64,nloss:u64,nn:i64,nd:u64)
  negated:i64 = int.neg.checked(nn)
  signed_zero:i64 = const() {"value":0}
  negative:bool = compare.lt(nn,signed_zero)
  abs_signed:i64 = select(negative,negated,nn)
  abs_num:u64 = int.cast(abs_signed) {"mode":"wrap"}
  denom:u64 = int.mul.checked(nd,ngroup)
  common:u64 = call(abs_num,denom) {"function":"pes_gcd"}
  numer:u64 = int.div.checked(abs_num,common)
  reduced:u64 = int.div.checked(denom,common)
  sign_num:i64 = int.cast(numer) {"mode":"wrap"}
  neg_num:i64 = int.neg.checked(sign_num)
  signed_num:i64 = select(negative,neg_num,sign_num)
  out_num:u64 = int.cast(signed_num) {"mode":"wrap"}
  gate:u64 = call(nn,ngroup,nwins,nloss,nc,nm) {"function":"pes_gate"}
  factor:u64 = const() {"value":1000000}
  scaled:u64 = int.mul.checked(numer,factor)
  score:u64 = int.div.checked(scaled,reduced)
  uz:u64 = const() {"value":0}
  scored:bool = compare.lt(uz,gate)
  out_score:u64 = select(scored,score,uz)
  off1:u64 = const() {"value":8}
  off2:u64 = const() {"value":16}
  off3:u64 = const() {"value":24}
  off4:u64 = const() {"value":32}
  off5:u64 = const() {"value":40}
  off6:u64 = const() {"value":48}
  off7:u64 = const() {"value":56}
  off8:u64 = const() {"value":64}
  off9:u64 = const() {"value":72}
  off10:u64 = const() {"value":80}
  _ = call(no,uz,ngroup) {"function":"pes_store"}
  _ = call(no,off1,nwins) {"function":"pes_store"}
  _ = call(no,off2,nloss) {"function":"pes_store"}
  _ = call(no,off3,nc) {"function":"pes_store"}
  _ = call(no,off4,gate) {"function":"pes_store"}
  _ = call(no,off5,out_num) {"function":"pes_store"}
  _ = call(no,off6,reduced) {"function":"pes_store"}
  _ = call(no,off7,out_score) {"function":"pes_store"}
  _ = call(no,off8,uz) {"function":"pes_store"}
  _ = call(no,off9,nf) {"function":"pes_store"}
  _ = call(no,off10,uz) {"function":"pes_store"}
  ret()
end
