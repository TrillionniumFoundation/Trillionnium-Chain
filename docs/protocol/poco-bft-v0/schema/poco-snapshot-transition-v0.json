{
  "schema": "trnm.poco-bft.snapshot-transition.v0",
  "schema_version": 0,
  "status": "B2-H3a-atomic-transition-kernel+B2-H3b1-production-persistence-seal",
  "authority_boundary": {
    "establishes": [
      "exact semantic decoding and logical-key binding for all 15 PoCO snapshot value kinds",
      "canonical compare-and-set mutation commitments",
      "one exact next-version atomic in-memory JMT update with conditional live-manifest preservation or target-version refresh",
      "a reusable private-field PoCO state-head kernel derived from an authenticated cutoff",
      "exact physical namespace-8 admission at in-memory codecs, SQLite precommit/startup/migration, and ABCI snapshot restore"
    ],
    "does_not_establish": [
      "runtime or profile authorization",
      "complete cross-entry business semantics",
      "checkpoint body execution",
      "authenticated B2-G candidate selection",
      "handoff, activation, or Core epoch transition authority"
    ]
  },
  "cev0": {
    "integer_encoding": "unsigned-big-endian",
    "bytes_encoding": ["length:u32", "data:length bytes"],
    "optional_encoding": {
      "tag_type": "u8",
      "none": {"tag": 0, "following_bytes": 0},
      "some": {"tag": 1, "following_value": "exact declared type"},
      "other_tags": "reject"
    },
    "exact_decode": true,
    "trailing_bytes": "reject"
  },
  "domain_hash": {
    "algorithm": "SHA-256",
    "hash_prefix_ascii": "trnm.cev0.hash.v0",
    "input": [
      "CEV0 Bytes(hash_prefix_ascii)",
      "CEV0 Bytes(domain_ascii)",
      "CEV0 Bytes(encoded_object)"
    ]
  },
  "value_envelope": {
    "encoding": "CEV0",
    "fields": [
      {"name": "schema_version", "type": "u16", "const": 0},
      {"name": "kind", "type": "u8", "minimum": 1, "maximum": 15},
      {"name": "revision", "type": "u64", "minimum": 1},
      {"name": "identity", "type": "Bytes", "minimum_bytes": 1, "maximum_bytes": 452},
      {"name": "payload", "type": "Bytes", "minimum_bytes": 1, "maximum_bytes": 65384}
    ],
    "encoded_size": {
      "fixed_and_length_prefix_bytes": 19,
      "formula": "19 + identity.length + payload.length",
      "maximum_bytes": 65536,
      "checked_independently_of_field_maxima": true
    },
    "exact_decode": true,
    "trailing_bytes": "reject"
  },
  "logical_key": {
    "type": "Hash32",
    "domain_ascii": "trnm.poco-bft.snapshot-value-identity.v0",
    "preimage_encoding": "CEV0",
    "preimage_fields": [
      {"name": "schema_version", "type": "u16", "const": 0},
      {"name": "kind", "type": "u8", "minimum": 1, "maximum": 15},
      {"name": "identity", "type": "Bytes", "minimum_bytes": 1, "maximum_bytes": 452}
    ],
    "constraint": "entry.logical_key equals the domain hash of the exact preimage"
  },
  "external_exact_objects": {
    "ConsumptionCertificateV0": {
      "decoder": "decode_consumption_certificate_v0_exact",
      "exact_decode": true,
      "trailing_bytes": "reject"
    },
    "ValidatorKeyProofOfPossessionV0": {
      "decoder": "decode_validator_key_proof_of_possession_v0_exact",
      "fields": [
        {"name": "schema_version", "type": "u16", "const": 0},
        {"name": "genesis_hash", "type": "Hash32", "nonzero": true},
        {"name": "chain_id", "type": "ConsensusString", "minimum_bytes": 1, "maximum_bytes": 128, "grammar": "ChainId v0"},
        {"name": "target_epoch", "type": "u64"},
        {"name": "validator_id", "type": "Bytes", "semantic": "id", "minimum_bytes": 1, "maximum_bytes": 128},
        {"name": "public_key", "type": "PublicKey32", "nonzero": true},
        {"name": "registration_nonce", "type": "u64"},
        {"name": "signature", "type": "FixedBytes", "exact_bytes": 64}
      ],
      "exact_decode": true,
      "trailing_bytes": "reject",
      "cryptographic_signature_verification": false
    },
    "ValidatorSetV0": {
      "decoder": "decode_validator_set_v0_exact",
      "exact_decode": true,
      "trailing_bytes": "reject",
      "constraints": [
        {"op": "all_nonzero", "path": "validators[*].public_key"}
      ]
    },
    "ConsensusParametersV0": {
      "decoder": "decode_consensus_parameters_v0_exact",
      "exact_decode": true,
      "trailing_bytes": "reject",
      "semantic_constraints": [
        "snapshot_lead_blocks >= finality_certified_chain_length",
        "epoch_length_blocks > snapshot_lead_blocks + epoch_seal_blocks"
      ]
    }
  },
  "kinds": [
    {
      "id": 1,
      "name": "consumption_certificate",
