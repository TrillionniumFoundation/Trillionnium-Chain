fn br_semantics_line(s:mutbuf,at:u64) -> (u64) effects(read,write,trap) entry(entry)
block entry(s:mutbuf,at:u64)
  off0:u64 = const() {"value":0}
  pos0:u64 = int.add.wrap(at,off0)
  word0:u64 = const() {"value":7308345369373991795}
  _word0:u64 = call(s,pos0,word0) {"function":"bench_put"}
  off8:u64 = const() {"value":8}
  pos8:u64 = int.add.wrap(at,off8)
  word8:u64 = const() {"value":7598819836007117663}
  _word8:u64 = call(s,pos8,word8) {"function":"bench_put"}
  off16:u64 = const() {"value":16}
