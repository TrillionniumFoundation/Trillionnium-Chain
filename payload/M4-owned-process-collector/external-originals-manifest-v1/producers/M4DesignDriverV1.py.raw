O=pathlib.Path("/private/tmp/chain-M4-owned-process-collector-review-20261114-v1/design-v1");O.mkdir(exist_ok=False)
def put(n,r):
 r=r.encode() if isinstance(r,str) else r
 with (O/n).open("xb") as f:f.write(r)
 return {"path":str(O/n),"bytes":len(r),"sha256":hashlib.sha256(r).hexdigest()}
assert hashlib.sha256(P["old"].encode()).hexdigest()=="e250f1a75794c35d9583e55e56f159366b5d15fa13118d7a142d10a38fd6394f"
ast.parse(P["new"])
patch="".join(difflib.unified_diff(P["old"].splitlines(keepends=True),P["new"].splitlines(keepends=True),fromfile="a/scripts/w1_owned_process_collector_v1.py",tofile="b/scripts/w1_owned_process_collector_v1.py"))
rows=[put("proposed-source.patch",patch),put("proposed-collector.py.raw",P["new"]),put("original-failure-extract.json",json.dumps(P["original_failure_extract"],indent=2)+"\n")]
