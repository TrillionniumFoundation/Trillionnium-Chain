class TypedPendingWorkerWiringTests(unittest.TestCase):
    # Deliberately independent of the checker's reviewed module/method roster.
    GROUPS = (
        ('test_llm_runtime_exit_initial_pending', 'InitialTerminalPendingTests', 14),
        ('test_llm_runtime_exit_binding_pending', 'BindingTerminalPendingTests', 10),
        ('test_llm_runtime_exit_post_binding_retirement', 'PostBindingRetirementTests', 12),
    )

    def setUp(self):
        temporary = tempfile.TemporaryDirectory(prefix='trnm-typed-pending-wiring-')
        self.addCleanup(temporary.cleanup)
        self.root = Path(temporary.name).resolve(strict=True)
        (self.root / 'scripts').mkdir()
        for path in ['scripts/test_llm_runtime_pilot.py'] + [
                'scripts/' + module + '.py' for module, _, _ in self.GROUPS]:
            (self.root / path).write_bytes((ROOT / path).read_bytes())

    def test_actual_pilot_registers_all_36_original_controls_once(self):
        result = check_typed_pending_worker_controls(self.root)
        self.assertEqual(result['selected_original_controls'], 36)
        self.assertEqual(result['original_controls'],
                         {module: count for module, _, count in self.GROUPS})
        self.assertIs(result['tests_executed'], False)

    def test_each_original_import_must_be_present_unconditional_and_unique(self):
        check_typed_pending_worker_controls(self.root)
        target = self.root / 'scripts/test_llm_runtime_pilot.py'
        original = target.read_text()
        for module, class_name, _ in self.GROUPS:
            line = 'from ' + module + ' import ' + class_name + '\n'
            self.assertEqual(original.count(line), 1)
            for label, replacement in (
                    ('missing', ''), ('duplicate', line + line),
                    ('conditional', 'if False:\n    ' + line),
                    ('alias', 'from ' + module + ' import ' + class_name + ' as omitted\n')):
                try:
                    target.write_text(original.replace(line, replacement, 1))
                    with self.subTest(module=module, mutation=label), self.assertRaises(ValueError):
                        check_typed_pending_worker_controls(self.root)
                finally:
                    target.write_text(original)

    def test_each_original_module_refuses_missing_renamed_duplicate_skipped_or_stubbed_controls(self):
        check_typed_pending_worker_controls(self.root)
        for module, class_name, _ in self.GROUPS:
            target = self.root / 'scripts' / (module + '.py')
            original = target.read_text()
            tree = ast.parse(original)
            cls = next(node for node in tree.body
                       if isinstance(node, ast.ClassDef) and node.name == class_name)
            method = next(node for node in cls.body
                          if isinstance(node, ast.FunctionDef) and node.name.startswith('test_'))
            lines = original.splitlines(keepends=True)
            exact = ''.join(lines[method.lineno - 1:method.end_lineno])
            for label, replacement in (
                    ('missing', ''), ('duplicate', exact + exact),
                    ('renamed', exact.replace(method.name, 'omitted_' + method.name, 1)),
                    ('skipped', '    @unittest.skip("explicit negative fixture")\n' + exact),
                    ('stubbed', '    def ' + method.name + '(self):\n        pass\n')):
                try:
                    changed = original.replace(exact, replacement, 1)
                    self.assertNotEqual(changed, original)
                    target.write_text(changed)
                    with self.subTest(module=module, mutation=label), self.assertRaises(ValueError):
                        check_typed_pending_worker_controls(self.root)
                finally:
                    target.write_text(original)

    def test_existing_pilot_ci_command_cannot_be_removed_duplicated_hidden_or_moved(self):
        script = (ROOT / 'scripts/ci/ci_job.sh').read_text()
        required = {'repository-truth', 'protocol-contract', 'fuzz-smoke',
                    'rust-baseline', 'external-evidence-contract'}
        check_independent_conformance(script, required)
        command = '    python3 scripts/test_llm_runtime_pilot.py\n'
        self.assertEqual(script.count(command), 1)
        for label, changed in (
                ('missing', script.replace(command, '', 1)),
                ('duplicate', script.replace(command, command + command, 1)),
                ('commented', script.replace(command, '    # ' + command.strip() + '\n', 1)),
                ('hidden', script.replace(command, '    if false; then\n' + command + '    fi\n', 1)),
                ('moved', script.replace(command, '', 1).replace(
                    '  repository-truth)\n', '  repository-truth)\n' + command, 1))):
            with self.subTest(mutation=label), self.assertRaises(ValueError):
                check_independent_conformance(changed, required)


class ManualResearchWorkflowTests(unittest.TestCase):
    # Keep the two reviewed paths explicit and independent of the checker map.
    WORKFLOWS = ('pon-native-campaign-qualification.yml',
                 'pon-fixed-host-root-f0.yml')

    def setUp(self):
        directory = tempfile.TemporaryDirectory(prefix='trnm-manual-research-')
        self.addCleanup(directory.cleanup)
        self.root = Path(directory.name)
        self.directory = self.root / '.github/workflows'
        self.directory.mkdir(parents=True)
        for name in self.WORKFLOWS:
            (self.directory / name).write_bytes(
                (ROOT / '.github/workflows' / name).read_bytes())

    def reject(self, name, changed):
        path = self.directory / name
        original = path.read_bytes()
        try:
            path.write_text(changed)
            with self.assertRaisesRegex(ValueError, 'manual research workflow'):
                check_manual_research_workflows(self.root)
        finally:
            path.write_bytes(original)

    def test_actual_two_workflows_are_manual_only(self):
        check_manual_research_workflows(ROOT)
        check_manual_research_workflows(self.root)

    def test_each_automatic_or_indirect_event_is_rejected(self):
        events = ('push', 'pull_request', 'pull_request_target', 'schedule',
                  'workflow_run', 'workflow_call', 'repository_dispatch',
                  'release', 'deployment', 'deployment_status')
        for name in self.WORKFLOWS:
            original = (self.directory / name).read_text()
            for event in events:
                with self.subTest(workflow=name, event=event):
                    self.reject(name, original.replace(
                        '  workflow_dispatch:\npermissions:\n',
                        '  workflow_dispatch:\n  ' + event + ':\npermissions:\n', 1))

    def test_alternative_or_duplicate_event_syntax_is_rejected(self):
        event = 'on:\n  workflow_dispatch:\n'
        alternatives = (
            'on: workflow_dispatch\n',
            'on: [workflow_dispatch]\n',
            '"on":\n  workflow_dispatch:\n',
            "'on':\n  workflow_dispatch:\n",
            'on: &manual\n  workflow_dispatch:\n',
            'on:\n  <<: *manual\n',
        )
        tails = (
            '\non:\n  pull_request:\n',
            '\n"on":\n  push:\n',
            '\n<<: *events\n',
            '\n---\non:\n  workflow_dispatch:\n',
        )
        for name in self.WORKFLOWS:
            original = (self.directory / name).read_text()
            for replacement in alternatives:
                with self.subTest(workflow=name, replacement=replacement):
                    self.reject(name, original.replace(event, replacement, 1))
            for tail in tails:
                with self.subTest(workflow=name, tail=tail):
                    self.reject(name, original + tail)

    def test_missing_and_symlinked_workflows_are_rejected(self):
        for name in self.WORKFLOWS:
            path = self.directory / name
            original = path.read_bytes()
            path.unlink()
            try:
                with self.subTest(workflow=name, case='missing'):
                    with self.assertRaisesRegex(ValueError, 'regular file'):
                        check_manual_research_workflows(self.root)
                path.symlink_to(ROOT / '.github/workflows' / name)
                with self.subTest(workflow=name, case='symlink'):
                    with self.assertRaisesRegex(ValueError, 'regular file'):
                        check_manual_research_workflows(self.root)
            finally:
                if path.is_symlink():
                    path.unlink()
                path.write_bytes(original)

    def test_manual_entrypoint_configuration_is_exact(self):
        for name in self.WORKFLOWS:
            original = (self.directory / name).read_text()
            changes = (
                original.replace('  workflow_dispatch:\n', '', 1),
                original.replace('  workflow_dispatch:\n',
                                 '  workflow_dispatch:\n    inputs:\n      mode:\n        type: string\n', 1),
                original.replace('permissions:\n', 'permissions: {}\n', 1),
                original + '\njobs:\n',
            )
            for changed in changes:
                with self.subTest(workflow=name, changed=changed[:100]):
                    self.reject(name, changed)

    def test_nested_event_conditions_and_comments_remain_allowed(self):
        # The retained F0 job already mentions PR events in its source guard.
        f0 = (self.directory / self.WORKFLOWS[1]).read_text()
        self.assertIn("github.event_name == 'pull_request'", f0)
        for name in self.WORKFLOWS:
            path = self.directory / name
            path.write_text(path.read_text() +
                            '\n      # on: [push, pull_request] is only a nested comment.\n')
        check_manual_research_workflows(self.root)


class RustBaselineReceiptRetentionTests(unittest.TestCase):
    def test_fallback_receipt_root_reaches_child_and_preserves_original_failure(self):
        # Real shell and child environment, synthetic Cargo exit only. This is
        # not a native service or workspace-runtime acceptance observation.
        script = (ROOT / 'scripts/ci/ci_job.sh').read_text()
        lane = script.split('  rust-baseline)\n', 1)[1]
        prefix = lane.split('    (\n', 1)[1].split(
            '      unset TRNM_ZERO_PAIRED_PREFIX_OUTPUT\n', 1)[0]
        prelude = """set -euo pipefail
cargo() {
  test "$1" = test
  command python3 - <<'PY_RECEIPT_CONTROL'
import json
import os
from pathlib import Path
root = Path(os.environ['TRNM_CI_RECEIPT_DIR'])
value = {'receipt_root': str(root), 'scope': 'synthetic shell export control only'}
(root / 'synthetic-retention-control.json').write_text(json.dumps(value))
print(json.dumps(value))
PY_RECEIPT_CONTROL
  return 101
}
"""
        for explicit in (False, True):
            with self.subTest(explicit=explicit), tempfile.TemporaryDirectory(
                    prefix='trnm-receipt-retention-') as directory:
                root = Path(directory)
                env = dict(os.environ, RUNNER_TEMP=str(root / 'runner temp with spaces'))
                env.pop('TRNM_CI_RECEIPT_DIR', None)
                if explicit:
                    env['TRNM_CI_RECEIPT_DIR'] = str(root / 'explicit receipts with spaces')
                result = subprocess.run(['bash', '-c', prelude + prefix +
                    'touch "$trnm_model_receipt_root/incorrect-success"\n'],
                    cwd=ROOT, env=env, capture_output=True, text=True, timeout=10)
                self.assertEqual(result.returncode, 101, result.stderr)
                receipts = (Path(env['TRNM_CI_RECEIPT_DIR']) if explicit else
                            next((root / 'runner temp with spaces').glob('trnm-ci-*')))
                retained = json.loads((receipts / 'synthetic-retention-control.json').read_text())
                self.assertEqual(retained['receipt_root'], str(receipts))
                self.assertTrue((receipts / 'workspace-tests.log').is_file())
                self.assertIn(str(receipts), (receipts / 'workspace-tests.log').read_text())
                self.assertFalse((receipts / 'incorrect-success').exists())



class InlineSourcePinTests(unittest.TestCase):
    def test_actual_workflow_guards_bind_current_bytes(self):
        self.assertGreater(check_inline_source_pins(ROOT), 0)

    def test_stale_missing_and_bypassed_literal_guards_are_rejected(self):
        with tempfile.TemporaryDirectory(prefix='trnm-inline-source-') as directory:
            root = Path(directory)
            (root / '.github/workflows').mkdir(parents=True)
            source = root / 'source.rs'
            raw = b'const WORK: bool = true;\n'
            source.write_bytes(raw)
            blob = hashlib.sha1(b'blob ' + str(len(raw)).encode() + b'\0' + raw,
                                usedforsecurity=False).hexdigest()
            guard = f'          test "$(git hash-object source.rs)" = {blob}\n'
            workflow = root / '.github/workflows/control.yml'
            workflow.write_text(guard)
            self.assertEqual(check_inline_source_pins(root), 1)
            source.write_bytes(raw.replace(b'true', b'TRUE'))
            with self.assertRaisesRegex(ValueError, 'inline source pin differs'):
                check_inline_source_pins(root)
            source.unlink()
            with self.assertRaisesRegex(ValueError, 'missing regular inline source'):
                check_inline_source_pins(root)
            source.write_bytes(raw)
            workflow.write_text(guard.rstrip() + ' || true\n')
            with self.assertRaisesRegex(ValueError, 'unsupported inline source guard'):
                check_inline_source_pins(root)

    def test_recent_log_inventory_retains_absence_and_source_failure(self):
        text = (ROOT / '.github/workflows/pon-recent-batch-acceptance.yml').read_text()
        section = text.split('      - name: Recheck unchanged exact source and hash all native logs\n', 1)[1]
        self.assertTrue(section.startswith('        if: always()\n'))
        script = section.split('        run: |\n', 1)[1].split('\n      - ', 1)[0]
        script = '\n'.join(line[10:] for line in script.splitlines()) + '\n'
        for source_status, logs in ((0, {}), (0, {'first.log': b'actual bytes\n',
                                              'with space.log': b'failed native attempt\n'}),
                                    (7, {}), (7, {'failed.log': b'failure retained\n'})):
            with self.subTest(source_status=source_status, logs=list(logs)), \
                    tempfile.TemporaryDirectory(prefix='trnm-recent-log-test-') as directory:
                output = Path(directory) / 'retained'
                output.mkdir()
                for name, data in logs.items():
                    (output / name).write_bytes(data)
                # Only the source verifier is substituted. The actual workflow
                # shell handles no logs, real file bytes and a failed verifier.
                prefix = 'python3() { return ' + str(source_status) + '; }\n'
                env = dict(os.environ, OUT=str(output), SOURCE_KIND='head',
                           EXPECTED_HEAD='1' * 40)
                result = subprocess.run(['bash', '-c', prefix + script], env=env,
                                        capture_output=True, text=True)
                self.assertEqual(result.returncode, source_status, result.stderr)
                inventory = json.loads((output / 'log-inventory.json').read_text())
                self.assertEqual(inventory['retained_log_files'], len(logs))
                self.assertEqual(inventory['source_identity_exit_code'], source_status)
                self.assertEqual(inventory['status'], 'logs-retained' if logs else 'no-logs-retained')
                self.assertFalse(inventory['native_execution_established_by_inventory'])
                self.assertEqual(inventory['qualification'], 'unknown')
                checksums = (output / 'logs.sha256').read_text().splitlines()
                self.assertEqual(len(checksums), len(logs))
                for name, data in logs.items():
                    self.assertIn(hashlib.sha256(data).hexdigest() + '  ' + str(output / name), checksums)
                self.assertTrue((output / 'SCOPE.txt').is_file())


