  room:usize = buffer.len(po)
  enough_out:bool = compare.ge(room,minimum_out)
  branch enough_out write_header(pi,po,prow,has_row) short()
block write_header(wi:readbuf,wo:mutbuf,wrow:u64,whas:bool)
  begin:usize = const() {"value":0}
