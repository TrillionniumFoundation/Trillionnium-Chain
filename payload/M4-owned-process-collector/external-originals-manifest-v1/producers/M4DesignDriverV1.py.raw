for node in ast.walk(tree):
 if isinstance(node,(ast.FunctionDef,ast.AsyncFunctionDef)) and node.name in wanted:
  segments.append({"function":node.name,"first_line":node.lineno,"last_line":node.end_lineno,"source":ast.get_source_segment(P["old"],node)})
rows.append(put("original-relevant-functions.json",json.dumps(segments,indent=2)+"\n"))
report={"schema":"trnm-M4-closed-gate-ordering-minimal-design-v1","observed_at":datetime.datetime.now(datetime.timezone.utc).isoformat(),"source_head":"1a7afcdb820b051d1e4bfde3d436f96fc050c487","source_tree":"18c3d20df915f5c31ee38c7037775c61e5c12e3f","source_modified":False,"tests_executed":False,"approved_full_lane_pass":False,"mechanism":["Parent launch finally closes gate writer; child requires scheduling to read EOF and _exit(125).","With read fault main records launch-error, then loop reaps, discovers and immediately sends SIGTERM to still-live unreleased root.","The 1a7afc original14 failure records -15, exactly permitted by this competing signal path; source-level causality does not claim retained child-level events that were not saved."],"guard_proof":["New closed boolean is false until successful parent os.close(gate_writer).","Successful G write sets root_exec_released before any subsequent emit; released roots never receive deferral.","Pre-finally FD errors leave gate_closed false and receive ordinary cleanup.","Only original SIGTERM phase for exact unreleased root is deferred; all descendants and released roots preserve signals.","Original kill threshold min(250000000,cleanup_grace_seconds*500000000) and total cleanup bound unchanged; no additional wait, no returncode rewriting."],"deterministic_controls_proposed":["Hold monotonic elapsed at 0 and threshold-1; invoke original signal_owned against unreleased root plus descendant; verify no root TERM while descendant receives TERM.","At exact original threshold root receives KILL; repeated invocation does not duplicate; released root and unconfirmed gate never exempt."],"original14_source_ast_unchanged_required":True,"original_budgets_unchanged_required":True,"files":rows}
info=put("design-summary.json",json.dumps(report,indent=2)+"\n"); print(json.dumps({"summary":info,"files":rows,"patch":patch}))
