[package]
name = "trnm-peer-lease"
version = "0.1.0"
edition.workspace = true
license.workspace = true
authors.workspace = true
publish = false

[features]
default = []
# M04: explicit local candidate process surface, never a production adapter.
candidate-recovery-socket = []

[[bin]]
name = "trnm-payload-replay-recovery-owner-v1"
path = "src/bin/trnm-payload-replay-recovery-owner-v1.rs"
required-features = ["candidate-recovery-socket"]

[[test]]
name = "payload_replay_recovery_owner_socket"
path = "tests/payload_replay_recovery_owner_socket.rs"
required-features = ["candidate-recovery-socket"]

[package.metadata.trnm]
local_private_key_handling = false
host_attestation = false
consensus_runtime = false
consensus_payload_transport = false
core_safety_authority = false
payload_replay_core_ack_atomic_with_core = false
payload_replay_recovery_production_activation = false
production_candidate = false
payload_replay_append_only_hash_chain = true
payload_replay_candidate = true
payload_replay_body_store_candidate = true
payload_replay_body_store_production_activation = false
payload_replay_external_recovery_owner_candidate = true
payload_replay_recovery_socket_candidate = true
payload_replay_recovery_socket_peer_credentials = true
payload_replay_recovery_socket_mac = false
payload_replay_recovery_socket_production_activation = false
payload_replay_recovery_socket_client_transport_errors_non_fatal = true
payload_replay_recovery_socket_max_concurrent_connections = 1
payload_replay_core_ack_ledger_candidate = true
payload_replay_bounded_wal_replay_memory = true
payload_replay_bounded_temporary_scan = true
payload_replay_generation_overflow_fail_closed = true
module = "M04"
role = "portable-component"
profile = "portable-local-v2"
production_activation = false
consensus_authority = false

[dependencies]
fs2 = "0.4"
libc = "0.2"
rustix = { version = "1.1.4", features = ["event", "net", "process"] }
sha2 = { version = "0.10", default-features = false }

[dev-dependencies]
tempfile = "3"
