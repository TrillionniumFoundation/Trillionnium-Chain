block profile_flag(pf_i:readbuf,pf_o:mutbuf,pf_n:u64,pf_p:u64,pf_k:u64,pf_e:u64,pf_at:u64,pf_field:u64)
  bare:bool = compare.eq(pf_e,pf_at)
