fn mje_string(r:readbuf,w:mutbuf,p:u64,last:u64,start:u64) -> (u64) effects(read,write,trap) entry(entry)
block entry(r:readbuf,w:mutbuf,p:u64,last:u64,start:u64)
  qn:u64 = const() {"value":1}
  qw:u64 = const() {"value":34}
  qlen:u64 = call(w,p,qn,qw) {"function":"value_word"}
  qend:u64 = int.add.wrap(p,qlen)
  jump loop(r,w,start,last,qend)
block loop(lr:readbuf,lw:mutbuf,li:u64,ll:u64,lp:u64)
  more:bool = compare.lt(li,ll)
  branch more next(lr,lw,li,ll,lp) close(lw,lp)
block next(nr:readbuf,nw:mutbuf,ni:u64,nl:u64,np:u64)
  ix:usize = int.cast(ni) {"mode":"wrap"}
  ch:u8 = buffer.load(nr,ix)
  byte:u64 = int.cast(ch) {"mode":"wrap"}
  after:u64 = call(nw,np,byte) {"function":"mje_escape"}
  one:u64 = const() {"value":1}
  nexti:u64 = int.add.wrap(ni,one)
  jump loop(nr,nw,nexti,nl,after)
block close(cw:mutbuf,cp:u64)
  dqn:u64 = const() {"value":1}
  dqw:u64 = const() {"value":34}
  dqlen:u64 = call(cw,cp,dqn,dqw) {"function":"value_word"}
  dqend:u64 = int.add.wrap(cp,dqlen)
  ret(dqend)
end

fn mje_escape(w:mutbuf,p:u64,x:u64) -> (u64) effects(read,write,trap) entry(entry)
block entry(w:mutbuf,p:u64,x:u64)
  short:u64 = call(x) {"function":"json_short_escape"}
  z:u64 = const() {"value":0}
  quote:u64 = const() {"value":34}
  slash:u64 = const() {"value":92}
  is_quote:bool = compare.eq(x,quote)
  is_slash:bool = compare.eq(x,slash)
  escaped_punctuation:bool = bool.or(is_quote,is_slash)
  escape_byte:u64 = select(escaped_punctuation,x,short)
  has:bool = compare.ne(escape_byte,z)
  branch has escaped(w,p,escape_byte) plain_or_hex(w,p,x)
block escaped(ew:mutbuf,ep:u64,es:u64)
  backslash:u64 = const() {"value":92}
  eight:u64 = const() {"value":8}
  two:u64 = const() {"value":2}
  second:u64 = int.shl.checked(es,eight)
  both:u64 = bit.or(backslash,second)
  escn:u64 = call(ew,ep,two,both) {"function":"value_word"}
  esce:u64 = int.add.wrap(ep,escn)
  ret(esce)
block plain_or_hex(ow:mutbuf,op:u64,ox:u64)
  control:u64 = const() {"value":32}
  usehex:bool = compare.lt(ox,control)
  branch usehex hex(ow,op,ox) plain(ow,op,ox)
block plain(pw:mutbuf,pp:u64,px:u64)
  single:u64 = const() {"value":1}
  pn:u64 = call(pw,pp,single,px) {"function":"value_word"}
  pend:u64 = int.add.wrap(pp,pn)
  ret(pend)
block hex(hw:mutbuf,hp:u64,hx:u64)
  un:u64 = const() {"value":4}
  uw:u64 = const() {"value":808482140}
  ulen:u64 = call(hw,hp,un,uw) {"function":"value_word"}
  uend:u64 = int.add.wrap(hp,ulen)
  four:u64 = const() {"value":4}
  mask:u64 = const() {"value":15}
  hi:u64 = int.shr.checked(hx,four)
  lo:u64 = bit.and(hx,mask)
  hib:u64 = call(hi) {"function":"mje_hex_digit"}
  lob:u64 = call(lo) {"function":"mje_hex_digit"}
  shift8:u64 = const() {"value":8}
  hen:u64 = const() {"value":2}
  highword:u64 = int.shl.checked(lob,shift8)
  word:u64 = bit.or(highword,hib)
  hexn:u64 = call(hw,uend,hen,word) {"function":"value_word"}
  hexend:u64 = int.add.wrap(uend,hexn)
  ret(hexend)
end

fn mje_hex_digit(n:u64) -> (u64) effects() entry(entry)
block entry(n:u64)
  ten:u64 = const() {"value":10}
  zero_ascii:u64 = const() {"value":48}
  alpha_base:u64 = const() {"value":87}
  digit:bool = compare.lt(n,ten)
  base:u64 = select(digit,zero_ascii,alpha_base)
  ascii:u64 = int.add.wrap(n,base)
  ret(ascii)
end
