fn f0(i:readbuf,o:mutbuf,w:mutbuf) -> (u32) effects(read,write,trap) entry(entry)
block entry(i:readbuf,o:mutbuf,w:mutbuf)
  n:usize = buffer.len(i)
  frame_n:u64 = int.cast(n) {"mode":"wrap"}
  first:u64 = const() {"value":48}
  enough:bool = compare.le(first,frame_n)
  branch enough header(i,o,frame_n,first) bad()
block header(hi:readbuf,ho:mutbuf,hn:u64,hf:u64)
  z:u64 = const() {"value":0}
  count_at:u64 = const() {"value":8}
  tag:u64 = const() {"value":3544385890922157123}
  m:u64 = call(hi,z) {"function":"cp_read"}
  c:u64 = call(hi,count_at) {"function":"cp_read"}
