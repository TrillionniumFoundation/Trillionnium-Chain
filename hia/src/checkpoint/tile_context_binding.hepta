fn tcb_nonzero(r:readbuf,p:u64) -> (bool) effects(read,write,trap) entry(entry)
block entry(r:readbuf,p:u64)
  eight:u64 = const() {"value":8}
  sixteen:u64 = const() {"value":16}
  twentyfour:u64 = const() {"value":24}
  b:u64 = int.add.wrap(p,eight)
  c:u64 = int.add.wrap(p,sixteen)
  d:u64 = int.add.wrap(p,twentyfour)
  aa:u64 = call(r,p) {"function":"tr_read"}
  bb:u64 = call(r,b) {"function":"tr_read"}
  cc:u64 = call(r,c) {"function":"tr_read"}
  dd:u64 = call(r,d) {"function":"tr_read"}
  ab:u64 = bit.or(aa,bb)
  cd:u64 = bit.or(cc,dd)
  all:u64 = bit.or(ab,cd)
  z:u64 = const() {"value":0}
  some:bool = compare.ne(all,z)
  ret(some)
end
