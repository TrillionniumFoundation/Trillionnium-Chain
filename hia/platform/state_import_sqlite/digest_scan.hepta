  one_n:u64 = const() {"value":1}
  next_count:u64 = int.sub.wrap(al,one_n)
  one_at:usize = const() {"value":1}
  next_at:usize = int.add.wrap(as_,one_at)
  no_more:bool = compare.eq(al,one_n)
