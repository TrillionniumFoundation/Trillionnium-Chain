fn f0(i:readbuf,o:mutbuf,w:mutbuf) -> (u32) effects(read,write,trap) entry(entry)
block entry(i:readbuf,o:mutbuf,w:mutbuf)
  nn:usize = buffer.len(i)
  n:u64 = int.cast(nn) {"mode":"wrap"}
  fixed:u64 = const() {"value":20}
  cap:u64 = const() {"value":1048576}
  lower:bool = compare.le(fixed,n)
  upper:bool = compare.le(n,cap)
  okay:bool = bool.and(lower,upper)
  branch okay frame(i,o,w,n,fixed) envelope()
block frame(fi:readbuf,fo:mutbuf,fw:mutbuf,fn_:u64,fh:u64)
  mln:u64 = const() {"value":16}
  len4:u64 = const() {"value":4}
  mn:u64 = call(fi,mln,len4) {"function":"rac_read_le"}
