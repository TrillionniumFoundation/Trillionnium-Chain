  digit_last:u64 = const() {"value":57}
  lo_d:bool = compare.ge(value,digit_first)
  hi_d:bool = compare.le(value,digit_last)
  digit:bool = bool.and(lo_d,hi_d)
  letter_first:u64 = const() {"value":97}
  letter_last:u64 = const() {"value":102}
  lo_l:bool = compare.ge(value,letter_first)
  hi_l:bool = compare.le(value,letter_last)
  letter:bool = bool.and(lo_l,hi_l)
  a:u64 = int.sub.wrap(value,digit_first)
  letter_base:u64 = const() {"value":87}
  b:u64 = int.sub.wrap(value,letter_base)
  sentinel:u64 = const() {"value":16}
  l:u64 = select(letter,b,sentinel)
  decoded:u64 = select(digit,a,l)
  ret(decoded)
end

fn il_hex(n:u64) -> (u8) effects() entry(entry)
block entry(n:u64)
