  key_start:u64 = int.add.wrap(ca,four)
  tag_at:u64 = int.add.wrap(key_start,cl)
  len_at:u64 = int.add.wrap(tag_at,one)
  body:u64 = int.add.wrap(tag_at,five)
  left:u64 = int.sub.wrap(ce,body)
  n:u64 = call(ci,ca,four) {"function":"rac_read_le"}
  seen_key:u64 = call(ci,key_start,cl) {"function":"rac_read_le"}
  seen_type:u64 = call(ci,tag_at,one) {"function":"rac_read_le"}
  seen_width:u64 = call(ci,len_at,four) {"function":"rac_read_le"}
  key_size:bool = compare.eq(n,cl)
  exact_key:bool = compare.eq(seen_key,ck)
  type_ok:bool = compare.eq(seen_type,ct)
