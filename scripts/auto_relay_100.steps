# Trillionnium 100-step automation pipeline (parameterized)
# Repeated benchmark/analysis blocks are expressed as fail-fast shell loops.
# The security and protocol gates remain in their original order.

# Baseline gates and benchmark smoke checks (steps 1-10)
bash -lc 'cd trillionnium && ./scripts/run_v1_protocol_gates.sh'
bash -lc 'export PATH="/opt/homebrew/opt/rustup/bin:$PATH"; cd trillionnium && cargo test --workspace --quiet'
bash -lc 'cd trillionnium && ./scripts/check_event_fields.sh'
bash -lc 'cd trillionnium && ./scripts/check_event_replay_smoke.sh'
bash -lc 'cd trillionnium && ./scripts/check_parallel_flaky.sh'
bash -lc 'cd trillionnium && ./scripts/run_bench_matrix.sh'
bash -lc 'cd trillionnium && ./scripts/run_bench_mixed_matrix.sh'
bash -lc 'cd trillionnium && ./scripts/run_bench_regression_matrix.sh'
bash -lc 'cd trillionnium && ./scripts/check_aggressive_regression.sh'
bash -lc 'cd trillionnium && ./scripts/testnet_preflight.sh'

# Regression matrix: 3 transaction sizes x 5 key sets (15 invocations)
bash -lc 'set -e; cd trillionnium; for txs in 10000 20000 40000; do for keys in 64 128 256 512 1024; do TXS_LIST="$txs" KEYS_LIST="$keys" ./scripts/run_bench_regression_matrix.sh; done; done'

# Mixed regression sweep: 3 transaction sizes x 5 key sets (15 invocations)
bash -lc 'set -e; cd trillionnium; for txs in 10000 20000 40000; do for keys in 2000 1000 500 200 100; do TXS_LIST="$txs" KEYS_LIST="$keys" ./scripts/run_bench_regression_mixed_sweep.sh; done; done'

# Executor experiments repeated five times (20 invocations)
bash -lc 'set -e; cd trillionnium; for _ in 1 2 3 4 5; do ./scripts/run_executor_strategy_experiment.sh; ./scripts/run_executor_hotspot_experiment.sh; ./scripts/run_hot_bucket_sweep.sh; ./scripts/run_auto_adaptive_threshold_sweep.sh; done'

# Correlation and attribution reports repeated five times (20 invocations)
bash -lc 'set -e; cd trillionnium; for _ in 1 2 3 4 5; do python3 ./scripts/analyze_mixed_sweep_correlation.py; python3 ./scripts/analyze_aggressive_scan_correlation.py; python3 ./scripts/suggest_auto_adaptive_thresholds.py; ./scripts/nightly_attribution.sh; done'

# Security threshold/preflight and on-chain smoke gates repeated five times (20 invocations)
bash -lc 'set -e; for _ in 1 2 3 4 5; do (cd trillionnium && ./scripts/enforce_ci_thresholds.sh && ./scripts/testnet_preflight.sh); bash ./scripts/challenge_reexec_template_smoke.sh; bash ./scripts/worker_onchain_contract_smoke.sh; done'
