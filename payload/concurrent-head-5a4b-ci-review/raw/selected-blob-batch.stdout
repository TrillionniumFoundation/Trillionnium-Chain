def is_pq_source(parts: tuple[str, ...]) -> bool:
    """Recognize versioned pq3 modules, pq.rs, cell_pq and older prefixes."""
    return any(
        part.startswith(("pq_", "pqg_", "pql"))
        or re.search(r"(?:^|_)pq(?:[0-9]+)?(?:_|$)", Path(part).stem)
        for part in parts
    )

