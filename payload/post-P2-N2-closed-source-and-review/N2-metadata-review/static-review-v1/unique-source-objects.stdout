use std::{
    fs::{self, File, OpenOptions},
    io::{Read, Write},
    path::{Path, PathBuf},
    sync::atomic::{AtomicU64, Ordering},
    time::Instant,
};

use rusqlite::{params, Connection, OpenFlags, OptionalExtension};
use sha2::{Digest, Sha256};

use super::{
    manifest::MAX_MANIFEST_BYTES, require, CellChunkV1, CellContextV1, CellDigestV1, CellErrorV1,
    CellManifestV1, CellReleaseManifestV1, CellResultV1, MAX_CELL_BYTES, MAX_CHUNK_BYTES,
};

static OUTPUT_SEQUENCE: AtomicU64 = AtomicU64::new(0);

mod discard;

#[cfg(test)]
#[path = "cache_manifest_chunk_batch_tests.rs"]
mod manifest_chunk_batch_tests;
#[cfg(test)]
#[path = "cache_wal_tests.rs"]
mod wal_tests;
// One short FULL transaction retains at most 32 MiB of already received bytes.
// The caller must collect the batch before taking the SQLite writer lock.
pub(super) const MAX_CHUNK_COMMIT_BATCH: usize = 8;

/// One release owner's finite verification reservation. Shared chunks count
/// once per member reference because full payload verification reads them again.
/// Filesystem calls are cooperative and cannot be interrupted by the deadline.
#[derive(Clone, Copy, Debug)]
pub struct CellReleaseLimitsV1 {
    pub max_payload_bytes: u64,
    pub max_chunks: u64,
    pub deadline: Instant,
}

/// A separate, disposable byte cache; never a ledger or release authority.
pub struct CellStoreV1 {
    connection: Connection,
    read_only: bool,
    pub(super) config: super::CellCacheConfigV4,
    pub(super) path: PathBuf,
    writer_identity: Option<File>,
}

impl CellStoreV1 {
    pub fn open(path: &Path, config: super::CellCacheConfigV4) -> CellResultV1<Self> {
        config.validate()?;
        let deadline = Instant::now() + super::cache_wal::WRITER_BUDGET;
        let (path, identity) = super::cache_wal::writer_identity(path)?;
        let permit = super::cache_wal::acquire(&identity, deadline)?;
        super::cache_wal::check_sidecars(&path, config)?;
        let connection = Connection::open_with_flags(
            &path,
            OpenFlags::SQLITE_OPEN_READ_WRITE
                | OpenFlags::SQLITE_OPEN_CREATE
                | OpenFlags::SQLITE_OPEN_NOFOLLOW,
        )?;
        // A PRAGMA setter may query and reject the cold schema. Prevent its
        // error-path connection drop from checkpointing unvalidated WAL pages.
        super::cache_wal::prevent_close_checkpoint(&connection)?;
        connection.busy_timeout(super::cache_wal::remaining(deadline)?)?;
        connection.pragma_update(None, "trusted_schema", false)?;
        super::cache_wal::configure(&connection)?;
        let application: i64 =
            connection.pragma_query_value(None, "application_id", |r| r.get(0))?;
        let version: i64 = connection.pragma_query_value(None, "user_version", |r| r.get(0))?;
        let fresh = application == 0 && version == 0;
        if !fresh {
            require(
                application == super::cache_budget::APPLICATION_ID && version == 4,
                "cache namespace",
            )?;
            // Reject changed schema/configuration/counters before a checkpoint
            // could copy externally corrupted WAL pages into the main image.
            super::cache_budget::open(&connection, Some(config), false)?;
            super::cache_wal::checkpoint_zero(&connection, &path)?;
            connection.busy_timeout(super::cache_wal::remaining(deadline)?)?;
        }
        super::cache_budget::open(&connection, Some(config), true)?;
        connection.pragma_update(None, "journal_mode", "WAL")?;
        super::cache_wal::checkpoint_zero(&connection, &path)?;
        super::cache_wal::check_sidecars(&path, config)?;
        drop(permit);
        Ok(Self {
            connection,
            read_only: false,
            config,
            path,
            writer_identity: Some(identity),
        })
    }

    /// Existing disposable cache only; serving never creates or repairs a DB.
    pub fn open_read_only(path: &Path) -> CellResultV1<Self> {
        super::cache_wal::check_path(path)?;
        let connection = Connection::open_with_flags(
            path,
            OpenFlags::SQLITE_OPEN_READ_ONLY | OpenFlags::SQLITE_OPEN_NOFOLLOW,
        )?;
        super::cache_wal::prevent_close_checkpoint(&connection)?;
        connection.busy_timeout(std::time::Duration::ZERO)?;
        connection.pragma_update(None, "trusted_schema", false)?;
        super::cache_budget::open(&connection, None, false)?;
        let config = super::cache_budget::config(&connection)?;
        super::cache_wal::check_sidecars(path, config)?;
        Ok(Self {
            connection,
            read_only: true,
            config,
            path: path.to_owned(),
            writer_identity: None,
        })
    }

    #[cfg(test)]
    fn write<T>(&self, operation: impl FnOnce(&Connection) -> CellResultV1<T>) -> CellResultV1<T> {
        self.write_with_deadline(None, operation)
    }

    /// Network callers keep their original absolute deadline through local
    /// contention and publication. Standalone cache APIs retain their original
    /// five-second writer allowance. Blocking filesystem/SQLite calls remain
    /// cooperative; an observed expiry before COMMIT rolls back this batch.
    fn write_with_deadline<T>(
        &self,
        caller_deadline: Option<Instant>,
        operation: impl FnOnce(&Connection) -> CellResultV1<T>,
    ) -> CellResultV1<T> {
        let identity = self
            .writer_identity
            .as_ref()
            .ok_or(CellErrorV1::Invalid("read-only cache"))?;
        let writer_deadline = Instant::now() + super::cache_wal::WRITER_BUDGET;
        let deadline = caller_deadline.map_or(writer_deadline, |end| end.min(writer_deadline));
        super::cache_wal::remaining(deadline)?;
        let _permit = super::cache_wal::acquire(identity, deadline)?;
        // A lock released at expiry must not admit a late local write.
        super::cache_wal::remaining(deadline)?;
        super::cache_wal::check_path(&self.path)?;
        super::cache_wal::check_sidecars(&self.path, self.config)?;
        if caller_deadline.is_some() {
            // Do not inherit a previous standalone write's five-second SQLite
            // busy handler while reasserting the pager/checkpoint policy.
            self.connection.busy_timeout(std::time::Duration::ZERO)?;
        }
        super::cache_wal::configure(&self.connection)?;
        super::cache_wal::checkpoint_zero(&self.connection, &self.path)?;
        self.connection
            .busy_timeout(super::cache_wal::remaining(deadline)?)?;
        let transaction = rusqlite::Transaction::new_unchecked(
            &self.connection,
            rusqlite::TransactionBehavior::Immediate,
        )?;
        let value = operation(&transaction)?;
        if caller_deadline.is_some() {
            super::cache_wal::remaining(deadline)?;
        }
        transaction.commit()?;
        super::cache_wal::check_sidecars(&self.path, self.config)?;
        Ok(value)
    }

    pub fn cache_usage(&self) -> CellResultV1<super::CellCacheUsageV2> {
        let transaction = rusqlite::Transaction::new_unchecked(
            &self.connection,
            rusqlite::TransactionBehavior::Deferred,
        )?;
        let usage = super::cache_budget::audit(&transaction, None)?;
        transaction.commit()?;
        Ok(usage)
    }

    pub fn put_manifest(&self, pinned: CellDigestV1, wire: &[u8]) -> CellResultV1<CellManifestV1> {
        self.put_manifest_with_deadline(pinned, wire, None)
    }

    pub(super) fn put_manifest_with_deadline(
        &self,
        pinned: CellDigestV1,
        wire: &[u8],
        deadline: Option<Instant>,
    ) -> CellResultV1<CellManifestV1> {
        check_data_deadline(deadline)?;
        let manifest = CellManifestV1::decode(wire)?;
        require(manifest.id() == pinned, "manifest digest")?;
        check_data_deadline(deadline)?;
        self.write_with_deadline(deadline, |connection| {
            connection.execute(
                "INSERT INTO cell_manifests_v1(id, wire) VALUES (?1, ?2)
             ON CONFLICT(id) DO UPDATE SET wire = excluded.wire",
                params![pinned.as_slice(), wire],
            )?;
            Ok(())
        })?;
        Ok(manifest)
    }

    pub fn manifest(&self, pinned: CellDigestV1) -> CellResultV1<Option<CellManifestV1>> {
        self.manifest_with_deadline(pinned, None)
    }

    pub(super) fn manifest_with_deadline(
        &self,
        pinned: CellDigestV1,
        deadline: Option<Instant>,
    ) -> CellResultV1<Option<CellManifestV1>> {
        check_data_deadline(deadline)?;
        let wire: Option<Option<Vec<u8>>> = self
            .connection
            .query_row(
                "SELECT CASE WHEN length(wire) <= ?2 THEN wire ELSE NULL END
             FROM cell_manifests_v1 WHERE id = ?1",
                params![pinned.as_slice(), MAX_MANIFEST_BYTES as i64],
                |r| r.get(0),
            )
            .optional()?;
        check_data_deadline(deadline)?;
        match wire {
            None => Ok(None),
            Some(None) => Err(CellErrorV1::Invalid("cached manifest length")),
            Some(Some(bytes)) => {
                let manifest = CellManifestV1::decode(&bytes)?;
                require(manifest.id() == pinned, "cached manifest digest")?;
                check_data_deadline(deadline)?;
                Ok(Some(manifest))
            }
        }
    }

    pub fn put_chunk(&self, expected: &CellChunkV1, bytes: &[u8]) -> CellResultV1<()> {
        self.put_chunk_with_deadline(expected, bytes, None)
    }

    pub(super) fn put_chunk_with_deadline(
        &self,
        expected: &CellChunkV1,
        bytes: &[u8],
        deadline: Option<Instant>,
    ) -> CellResultV1<()> {
        verify_chunk_with_deadline(expected, bytes, deadline)?;
        self.write_with_deadline(deadline, |connection| {
            connection.execute(
                "INSERT INTO cell_chunks_v1(hash, bytes) VALUES (?1, ?2)
             ON CONFLICT(hash) DO UPDATE SET bytes = excluded.bytes",
                params![expected.sha256.as_slice(), bytes],
            )?;
            Ok(())
        })
    }

    /// Availability is only a scheduling hint. Matching lengths never replace
    /// the full hash checks on actual reads or final payload verification.
    pub(super) fn chunk_present(&self, expected: &CellChunkV1) -> CellResultV1<bool> {
        Ok(self
            .connection
            .query_row(
                "SELECT length(bytes) = ?2 FROM cell_chunks_v1 WHERE hash = ?1",
                params![expected.sha256.as_slice(), expected.size],
                |row| row.get(0),
            )
            .optional()?
            .unwrap_or(false))
    }

    #[cfg(test)]
    pub(super) fn put_chunk_batch(&self, chunks: &[(&CellChunkV1, &[u8])]) -> CellResultV1<()> {
        self.put_chunk_batch_with_deadline(chunks, None)
    }

    pub(super) fn put_chunk_batch_with_deadline(
        &self,
        chunks: &[(&CellChunkV1, &[u8])],
        deadline: Option<Instant>,
    ) -> CellResultV1<()> {
        require(
            !chunks.is_empty() && chunks.len() <= MAX_CHUNK_COMMIT_BATCH,
            "chunk commit batch bound",
        )?;
        // Reject a malformed member before changing even the first cache row.
        // Per-chunk lengths also bound this batch by 8 * MAX_CHUNK_BYTES.
        for (expected, bytes) in chunks {
            verify_chunk_with_deadline(expected, bytes, deadline)?;
        }
        self.write_with_deadline(deadline, |transaction| {
            {
                let mut statement = transaction.prepare_cached(
                    "INSERT INTO cell_chunks_v1(hash, bytes) VALUES (?1, ?2)
                 ON CONFLICT(hash) DO UPDATE SET bytes = excluded.bytes",
                )?;
                for (expected, bytes) in chunks {
                    require(
                        statement.execute(params![expected.sha256.as_slice(), bytes])? == 1,
                        "cache chunk write",
                    )?;
                }
            }
            // synchronous=FULL is unchanged. No network operation or wait occurs
            // inside this transaction; a failure rolls back this batch only.
            Ok(())
        })
    }

    /// Stage complete one-chunk manifests under the caller's absolute deadline.
    /// Both internal batch entry points share the same prevalidation and FULL
    /// transaction, including the combined wire/payload and quota bounds.
    pub(super) fn put_single_chunk_manifests_with_deadline(
        &self,
        entries: &[(CellDigestV1, &[u8], &[u8])],
        deadline: Instant,
    ) -> CellResultV1<()> {
        self.put_manifest_chunk_batch_with_deadline(entries, Some(deadline))
    }

    /// Atomically cache a bounded set of complete single-chunk cells. All
    /// manifest pins and full payloads are checked before taking the writer
    /// permit; a later member or quota failure cannot publish a prefix.
    pub(super) fn put_manifest_chunk_batch_with_deadline(
        &self,
        cells: &[(CellDigestV1, &[u8], &[u8])],
        deadline: Option<Instant>,
    ) -> CellResultV1<()> {
        check_data_deadline(deadline)?;
        require(
            !cells.is_empty() && cells.len() <= MAX_CHUNK_COMMIT_BATCH,
            "manifest chunk commit batch bound",
        )?;
        let bytes = cells
            .iter()
            .try_fold(0_usize, |total, (_, wire, payload)| {
                total
                    .checked_add(wire.len())
                    .and_then(|total| total.checked_add(payload.len()))
                    .ok_or(CellErrorV1::Invalid("manifest chunk commit batch bytes"))
            })?;
        require(
            bytes <= MAX_CHUNK_COMMIT_BATCH * MAX_CHUNK_BYTES as usize,
            "manifest chunk commit batch bytes",
        )?;
        let mut manifests = Vec::with_capacity(cells.len());
        for (pinned, wire, payload) in cells {
            check_data_deadline(deadline)?;
            let manifest = CellManifestV1::decode(wire)?;
            require(manifest.id() == *pinned, "manifest digest")?;
            require(
                manifest.chunks().len() == 1
                    && manifest.payload_sha256() == manifest.chunks()[0].sha256,
                "single-chunk manifest payload",
            )?;
            verify_chunk_with_deadline(&manifest.chunks()[0], payload, deadline)?;
            manifests.push(manifest);
        }
        self.write_with_deadline(deadline, |transaction| {
            let mut write_manifest = transaction.prepare_cached(
                "INSERT INTO cell_manifests_v1(id, wire) VALUES (?1, ?2)
                 ON CONFLICT(id) DO UPDATE SET wire = excluded.wire",
            )?;
            let mut write_chunk = transaction.prepare_cached(
                "INSERT INTO cell_chunks_v1(hash, bytes) VALUES (?1, ?2)
                 ON CONFLICT(hash) DO UPDATE SET bytes = excluded.bytes",
            )?;
            for ((pinned, wire, payload), manifest) in cells.iter().zip(&manifests) {
                check_data_deadline(deadline)?;
                require(
                    write_manifest.execute(params![pinned.as_slice(), wire])? == 1,
                    "cache manifest write",
                )?;
                require(
                    write_chunk
                        .execute(params![manifest.chunks()[0].sha256.as_slice(), payload])?
                        == 1,
                    "cache chunk write",
                )?;
            }
            // The existing two-table quota triggers and FULL pager are retained.
            // The shared writer retains the original five-second cap, checks
            // the caller's absolute deadline before COMMIT and does not wait
            // for network or payload construction while holding the writer.
            Ok(())
        })
    }

    /// Every read hashes the actual bytes. A corrupt disposable chunk is removed
    /// and becomes missing, so the ordinary fetch path can repair it.
    pub fn chunk(&self, hash: CellDigestV1) -> CellResultV1<Option<Vec<u8>>> {
        self.chunk_with_deadline(hash, None)
    }

    pub(super) fn chunk_with_deadline(
        &self,
        hash: CellDigestV1,
        deadline: Option<Instant>,
    ) -> CellResultV1<Option<Vec<u8>>> {
        check_data_deadline(deadline)?;
        let row: Option<Option<Vec<u8>>> = self
            .connection
            .query_row(
                "SELECT CASE WHEN length(bytes) BETWEEN 1 AND ?2 THEN bytes ELSE NULL END
             FROM cell_chunks_v1 WHERE hash = ?1",
                params![hash.as_slice(), i64::from(MAX_CHUNK_BYTES)],
                |r| r.get(0),
            )
            .optional()?;
        check_data_deadline(deadline)?;
        let Some(row) = row else {
            return Ok(None);
        };
        if let Some(bytes) = row {
            let actual = <[u8; 32]>::from(Sha256::digest(&bytes));
            check_data_deadline(deadline)?;
            if actual == hash {
                return Ok(Some(bytes));
            }
        }
        if !self.read_only {
            return self.write_with_deadline(deadline, |connection| {
                let current: Option<Vec<u8>> = connection.query_row(
                    "SELECT CASE WHEN length(bytes) BETWEEN 1 AND ?2 THEN bytes ELSE NULL END FROM cell_chunks_v1 WHERE hash=?1",
                    params![hash.as_slice(), i64::from(MAX_CHUNK_BYTES)], |r| r.get::<_, Option<Vec<u8>>>(0),
                ).optional()?.flatten();
                check_data_deadline(deadline)?;
                if let Some(bytes) = current {
                    let actual = <[u8; 32]>::from(Sha256::digest(&bytes));
                    check_data_deadline(deadline)?;
                    if actual == hash { return Ok(Some(bytes)); }
                }
                connection.execute("DELETE FROM cell_chunks_v1 WHERE hash = ?1", [hash.as_slice()])?;
                Ok(None)
            });
        }
        Ok(None)
    }

    /// Private runtime consumer only. This deletes disposable cache rows after
    /// their exact bytes were fsynced to the admitted destination. It does not
    /// retire a provider lease, retention row, release authority or disk charge.
    #[cfg(unix)]
    pub(super) fn retire_consumed_runtime_segment(
        &self,
        manifest: &CellManifestV1,
        deadline: Instant,
    ) -> CellResultV1<()> {
        self.write_with_deadline(Some(deadline), |connection| {
            for chunk in manifest.chunks() {
                connection.execute(
                    "DELETE FROM cell_chunks_v1 WHERE hash=?1",
                    [chunk.sha256.as_slice()],
                )?;
            }
            connection.execute(
                "DELETE FROM cell_manifests_v1 WHERE id=?1",
                [manifest.id().as_slice()],
            )?;
            Ok(())
        })
    }

    pub fn pack_file(
        &self,
        path: &Path,
        context: CellContextV1,
        chunk_bytes: u32,
    ) -> CellResultV1<CellManifestV1> {
        context.validate()?;
        require(
            (16_384..=MAX_CHUNK_BYTES).contains(&chunk_bytes) && chunk_bytes.is_power_of_two(),
            "chunk size",
        )?;
        let mut file = File::open(path)?;
        let metadata = file.metadata()?;
        require(
            metadata.is_file() && (1..=MAX_CELL_BYTES).contains(&metadata.len()),
            "input file size/type",
        )?;
        require(
            metadata.len().div_ceil(u64::from(chunk_bytes)) <= 16_384,
            "chunk count",
        )?;
        let mut total = 0_u64;
        let mut full = Sha256::new();
        let mut chunks = Vec::new();
        let mut bytes = vec![0; chunk_bytes as usize];
        while total < metadata.len() {
            let count = (metadata.len() - total).min(u64::from(chunk_bytes)) as usize;
            file.read_exact(&mut bytes[..count])?;
            let chunk = CellChunkV1 {
                size: count as u32,
                sha256: Sha256::digest(&bytes[..count]).into(),
            };
            self.put_chunk(&chunk, &bytes[..count])?;
            full.update(&bytes[..count]);
            total += count as u64;
            chunks.push(chunk);
        }
        require(file.read(&mut [0; 1])? == 0, "input grew during pack")?;
        let manifest =
            CellManifestV1::new(context, total, full.finalize().into(), chunk_bytes, chunks)?;
        self.put_manifest(manifest.id(), &manifest.encode())
    }

    pub fn verify_complete(&self, manifest: &CellManifestV1) -> CellResultV1<()> {
        self.write_verified(manifest, &mut std::io::sink(), None)
    }

    /// Verify every member of the release owner's declared required-cell set
    /// from the local cache. The caller must pin the release manifest and its
    /// completeness through its release owner; this cache cannot infer missing
    /// dependencies, select a release, or authorize loading it.
    pub fn verify_release_complete(
        &self,
        release: &CellReleaseManifestV1,
        limits: CellReleaseLimitsV1,
    ) -> CellResultV1<()> {
        release.validate()?;
        require(limits.max_payload_bytes > 0, "release payload budget")?;
        require(limits.max_chunks > 0, "release chunk budget")?;
        let check_deadline = || {
            require(
                Instant::now() <= limits.deadline,
                "release verification deadline",
            )
        };
        check_deadline()?;
        let mut payload_bytes = 0_u64;
        let mut chunks = 0_u64;
        // Inspect all pinned manifests before reading any payload. Do not retain
        // an unbounded collection of decoded manifests or read a large first
        // member before discovering an over-budget later member.
        for digest in release.cells() {
            check_deadline()?;
            let manifest = self.manifest(*digest)?.ok_or(CellErrorV1::Unavailable)?;
            require(
                manifest.context() == release.context(),
                "release cell context",
            )?;
            payload_bytes = payload_bytes
                .checked_add(manifest.size())
                .ok_or(CellErrorV1::Invalid("release payload budget"))?;
            require(
                payload_bytes <= limits.max_payload_bytes,
                "release payload budget",
            )?;
            chunks = chunks
                .checked_add(manifest.chunks().len() as u64)
                .ok_or(CellErrorV1::Invalid("release chunk budget"))?;
            require(chunks <= limits.max_chunks, "release chunk budget")?;
        }
        for digest in release.cells() {
            check_deadline()?;
            // Content addressing binds this re-read to the preflight manifest.
            let manifest = self.manifest(*digest)?.ok_or(CellErrorV1::Unavailable)?;
            self.verify_complete_until(&manifest, limits.deadline)?;
        }
        check_deadline()?;
        Ok(())
    }

    pub(super) fn verify_complete_until(
        &self,
        manifest: &CellManifestV1,
        deadline: Instant,
    ) -> CellResultV1<()> {
        self.write_verified(manifest, &mut std::io::sink(), Some(deadline))
    }

    /// Publish only after checking the complete ordered payload. The output must
    /// be absent; neither a partial download nor an existing path is published.
    pub fn materialize(&self, manifest: &CellManifestV1, output: &Path) -> CellResultV1<()> {
        self.materialize_with_deadline(manifest, output, None)
    }

    /// Recheck bytes and publish against the caller's original absolute deadline.
    /// Filesystem I/O is not preemptible. Expiry before the publication checkpoint
    /// leaves no output; once the no-replace link begins, durability and cleanup
    /// finish without treating a complete published file as a removable partial.
    pub fn materialize_until(
        &self,
        manifest: &CellManifestV1,
        output: &Path,
        deadline: Instant,
    ) -> CellResultV1<()> {
        self.materialize_with_deadline(manifest, output, Some(deadline))
    }

    fn materialize_with_deadline(
        &self,
        manifest: &CellManifestV1,
        output: &Path,
        deadline: Option<Instant>,
    ) -> CellResultV1<()> {
        let check_deadline = || {
            require(
                deadline.is_none_or(|end| Instant::now() <= end),
                "materialization deadline",
            )
        };
        check_deadline()?;
        let parent = output
            .parent()
            .filter(|p| !p.as_os_str().is_empty())
            .unwrap_or(Path::new("."));
        let sequence = OUTPUT_SEQUENCE.fetch_add(1, Ordering::Relaxed);
        let temporary = parent.join(format!(
            ".trnm-cell-{}-{sequence}.partial",
            std::process::id()
        ));
        let mut file = OpenOptions::new()
            .write(true)
            .create_new(true)
            .open(&temporary)?;
        let result: CellResultV1<()> = (|| {
            self.write_verified(manifest, &mut file, deadline)?;
            check_deadline()?;
            file.sync_all()?;
            #[cfg(test)]
            super::tests::before_materialize_publication(deadline);
            check_deadline()?;
            fs::hard_link(&temporary, output)?;
            File::open(parent)?.sync_all()?;
            Ok(())
        })();
        drop(file);
        let cleanup = fs::remove_file(&temporary);
        result?;
        cleanup?;
        Ok(())
    }

    fn write_verified(
        &self,
        manifest: &CellManifestV1,
        writer: &mut impl Write,
        deadline: Option<Instant>,
    ) -> CellResultV1<()> {
        manifest.validate()?;
        let mut full = Sha256::new();
        let mut total = 0_u64;
        for expected in manifest.chunks() {
            require(
                deadline.is_none_or(|end| Instant::now() <= end),
                "verification deadline",
            )?;
            let bytes = self
                .chunk_with_deadline(expected.sha256, deadline)?
                .ok_or(CellErrorV1::Unavailable)?;
            // chunk() just hashed these actual bytes against expected.sha256.
            // Retain the manifest's length relation and the ordered payload
            // hash without hashing the same immutable buffer a second time.
            verify_chunk_length(expected, &bytes)?;
            full.update(&bytes);
            check_data_deadline(deadline)?;
            total += bytes.len() as u64;
            writer.write_all(&bytes)?;
            check_data_deadline(deadline)?;
        }
        require(
            total == manifest.size()
                && <[u8; 32]>::from(full.finalize()) == manifest.payload_sha256(),
            "complete payload digest",
        )
    }
}

pub(super) fn verify_chunk(expected: &CellChunkV1, bytes: &[u8]) -> CellResultV1<()> {
    verify_chunk_with_deadline(expected, bytes, None)
}

// Cache content is immutable by identity, but CPU time is an invocation-local
// resource. Never let a valid cache hit renew the caller's expired work budget.
// A digest covers at most MAX_CHUNK_BYTES; SQLite and hashing are cooperative.
pub(super) fn verify_chunk_with_deadline(
    expected: &CellChunkV1,
    bytes: &[u8],
    deadline: Option<Instant>,
) -> CellResultV1<()> {
    check_data_deadline(deadline)?;
    verify_chunk_length(expected, bytes)?;
    let actual = <[u8; 32]>::from(Sha256::digest(bytes));
    check_data_deadline(deadline)?;
    require(actual == expected.sha256, "chunk digest")
}

fn check_data_deadline(deadline: Option<Instant>) -> CellResultV1<()> {
    if let Some(deadline) = deadline {
        super::network::remaining(deadline)?;
    }
    Ok(())
}

pub(super) fn verify_chunk_length(expected: &CellChunkV1, bytes: &[u8]) -> CellResultV1<()> {
    require(
        expected.size > 0
            && expected.size <= MAX_CHUNK_BYTES
            && bytes.len() == expected.size as usize,
        "chunk length",
    )
}

