  normal_width:bool = select(unsigned,width_number,within_cap)
  a:bool = bool.and(key_size,exact_key)
  b:bool = bool.and(a,type_ok)
  c:bool = bool.and(b,within_val)
  d:bool = bool.and(c,normal_width)
  branch d value(ci,cs,cd,ck,body,seen_width,unsigned) no()
block value(vi:readbuf,vs:mutbuf,vd:u64,vk:u64,vb:u64,vw:u64,vu:bool)
  start:usize = int.cast(vb) {"mode":"wrap"}
  size:usize = int.cast(vw) {"mode":"wrap"}
  branch vu encode(vi,vs,vd,vk,vb,vw,vu,start,size) text(vi,vs,vd,vk,vb,vw,vu,start,size)
block text(ti:readbuf,ts:mutbuf,td:u64,tk:u64,tb:u64,tw:u64,tu:bool,to:usize,tl:usize)
  valid_utf8:bool = call(ti,to,tl) {"function":"utf8"}
  branch valid_utf8 encode(ti,ts,td,tk,tb,tw,tu,to,tl) no()
block encode(ei:readbuf,es:mutbuf,ed:u64,ek:u64,eb:u64,ew:u64,eu:bool,eo:usize,el:usize)
  typnum:u64 = const() {"value":3}
