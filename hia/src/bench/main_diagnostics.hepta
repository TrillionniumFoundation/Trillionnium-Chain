  branch none_g render(gd_i,gd_o,gd_start,gd_after,gd_a,gd_b,gd_len,gd_total) bound_flag_tip(gd_i,gd_o,gd_start,gd_after,gd_a,gd_b,gd_len,gd_winner)
block bound_flag_tip(h_i:readbuf,h_o:mutbuf,h_start:u64,h_after:u64,h_a:u64,h_b:u64,h_len:u64,h_winner:u64)
  offset_h:u64 = const() {"value":9}
  tail_index:u64 = int.add.wrap(h_winner,offset_h)
  leader_index:u64 = const() {"value":31}
  leader:u64 = call(h_i,leader_index) {"function":"jaro_label"}
  tail:u64 = call(h_i,tail_index) {"function":"jaro_label"}
  m_h:u64 = const() {"value":65535}
  leader_len:u64 = bit.and(leader,m_h)
  tail_len:u64 = bit.and(tail,m_h)
  leader_size:u64 = const() {"value":46}
  footer_h:u64 = const() {"value":38}
  min_tail:u64 = const() {"value":1}
  max_tail:u64 = const() {"value":96}
  leader_ok:bool = compare.eq(leader_len,leader_size)
  tail_positive:bool = compare.ge(tail_len,min_tail)
  tail_bounded:bool = compare.le(tail_len,max_tail)
  tail_ok:bool = bool.and(tail_positive,tail_bounded)
  token_end:u64 = int.add.wrap(h_a,h_len)
  tip_size:u64 = int.add.wrap(leader_len,tail_len)
  appendix_size:u64 = int.add.wrap(tip_size,footer_h)
  new_size:u64 = int.add.wrap(token_end,appendix_size)
  buf_size_h:usize = buffer.len(h_o)
  out_cap_h:u64 = int.cast(buf_size_h) {"mode":"wrap"}
  hard_cap_h:u64 = const() {"value":2048}
  out_fit:bool = compare.le(new_size,out_cap_h)
  hard_fit_h:bool = compare.le(new_size,hard_cap_h)
  both_fit_h:bool = bool.and(out_fit,hard_fit_h)
  assets_ok:bool = bool.and(leader_ok,tail_ok)
  valid_h:bool = bool.and(assets_ok,both_fit_h)
  branch valid_h write_flag_tip(h_i,h_o,h_start,h_after,h_a,h_b,h_len,leader,tail,new_size) refuse()
block write_flag_tip(q_i:readbuf,q_o:mutbuf,q_start:u64,q_after:u64,q_a:u64,q_b:u64,q_len:u64,q_leader:u64,q_tail:u64,q_total:u64)
  zero_q:u64 = const() {"value":0}
  token_q:u64 = const() {"value":16}
  mask_q:u64 = const() {"value":65535}
  end_q:u64 = const() {"value":38}
  l_at:u64 = int.shr.checked(q_leader,token_q)
  leader_n_q:u64 = bit.and(q_leader,mask_q)
  q_at:u64 = int.shr.checked(q_tail,token_q)
  q_n:u64 = bit.and(q_tail,mask_q)
  _pre_q:u64 = call(q_i,q_o,q_start,zero_q,q_a) {"function":"diag_copy"}
  q1:u64 = call(q_i,q_o,token_q,q_a,q_len) {"function":"diag_copy"}
  q2:u64 = call(q_i,q_o,l_at,q1,leader_n_q) {"function":"diag_copy"}
  q3:u64 = call(q_i,q_o,q_at,q2,q_n) {"function":"diag_copy"}
  tail_q:u64 = int.sub.wrap(q_b,end_q)
  end_at_q:u64 = int.add.wrap(q_after,tail_q)
  _written_q:u64 = call(q_i,q_o,end_at_q,q3,end_q) {"function":"diag_copy"}
  result_q:u32 = int.cast(q_total) {"mode":"wrap"}
  ret(result_q)
block choose_tip(j_i:readbuf,j_o:mutbuf,j_s:mutbuf,j_code:u64,j_start:u64,j_after:u64,j_a:u64,j_b:u64,j_len:u64,j_total:u64)
  best:u64 = call(j_i,j_s,j_len,j_code) {"function":"jaro_choice"}
  zero_j:u64 = const() {"value":0}
  has_tip:bool = compare.ne(best,zero_j)
  branch has_tip bound_tip(j_i,j_o,j_start,j_after,j_a,j_b,j_len,j_total,best) render(j_i,j_o,j_start,j_after,j_a,j_b,j_len,j_total)
block bound_tip(p_i:readbuf,p_o:mutbuf,p_start:u64,p_after:u64,p_a:u64,p_b:u64,p_len:u64,p_total:u64,p_tip:u64)
  mask:u64 = const() {"value":65535}
  word_len:u64 = bit.and(p_tip,mask)
  tip_index:u64 = const() {"value":10}
  label:u64 = call(p_i,tip_index) {"function":"jaro_label"}
  tip_len:u64 = bit.and(label,mask)
  extra:u64 = int.add.wrap(word_len,tip_len)
  quote:u64 = const() {"value":1}
  appendix:u64 = int.add.wrap(extra,quote)
  n_new:u64 = int.add.wrap(p_total,appendix)
  tip_out_len:usize = buffer.len(p_o)
  cap_out:u64 = int.cast(tip_out_len) {"mode":"wrap"}
  output_max:u64 = const() {"value":2048}
  cap_ok:bool = compare.le(n_new,cap_out)
  tip_max_ok:bool = compare.le(n_new,output_max)
  label_known:u64 = const() {"value":34}
  label_ok:bool = compare.eq(tip_len,label_known)
  fits_both:bool = bool.and(cap_ok,tip_max_ok)
  tip_ok:bool = bool.and(fits_both,label_ok)
  branch tip_ok write_tip(p_i,p_o,p_start,p_after,p_a,p_b,p_len,label,p_tip,n_new) refuse()
block write_tip(w_i:readbuf,w_o:mutbuf,w_start:u64,w_after:u64,w_a:u64,w_b:u64,w_len:u64,w_label:u64,w_tip:u64,w_total:u64)
  zero_w:u64 = const() {"value":0}
  token_w:u64 = const() {"value":16}
  mask_w:u64 = const() {"value":65535}
  end_w:u64 = const() {"value":38}
  tail_w:u64 = int.sub.wrap(w_b,end_w)
  t_at:u64 = int.shr.checked(w_label,token_w)
  t_n:u64 = bit.and(w_label,mask_w)
  word_at:u64 = int.shr.checked(w_tip,token_w)
  word_n:u64 = bit.and(w_tip,mask_w)
  _head:u64 = call(w_i,w_o,w_start,zero_w,w_a) {"function":"diag_copy"}
  d_a:u64 = call(w_i,w_o,token_w,w_a,w_len) {"function":"diag_copy"}
  d_b:u64 = call(w_i,w_o,w_after,d_a,tail_w) {"function":"diag_copy"}
  d_c:u64 = call(w_i,w_o,t_at,d_b,t_n) {"function":"diag_copy"}
  d_d:u64 = call(w_i,w_o,word_at,d_c,word_n) {"function":"diag_copy"}
  quote_at:usize = int.cast(d_d) {"mode":"wrap"}
  quote_b:u8 = const() {"value":39}
  _ = buffer.store(w_o,quote_at,quote_b)
  one_w:u64 = const() {"value":1}
  quote_end:u64 = int.add.wrap(d_d,one_w)
  end_at:u64 = int.add.wrap(w_after,tail_w)
  _footer:u64 = call(w_i,w_o,end_at,quote_end,end_w) {"function":"diag_copy"}
  final_size:u32 = int.cast(w_total) {"mode":"wrap"}
  ret(final_size)
block render(e_i:readbuf,e_o:mutbuf,e_start:u64,e_after:u64,e_a:u64,e_b:u64,e_vlen:u64,e_total:u64)
  zero_e:u64 = const() {"value":0}
  token_e:u64 = const() {"value":16}
  _pre:u64 = call(e_i,e_o,e_start,zero_e,e_a) {"function":"diag_copy"}
  suf_at:u64 = call(e_i,e_o,token_e,e_a,e_vlen) {"function":"diag_copy"}
  _suf:u64 = call(e_i,e_o,e_after,suf_at,e_b) {"function":"diag_copy"}
  n_out:u32 = int.cast(e_total) {"mode":"wrap"}
  ret(n_out)
block refuse()
  invalid:u32 = const() {"value":4294967294}
  ret(invalid)
end

fn diag_copy(i:readbuf,o:mutbuf,from:u64,to:u64,n:u64) -> (u64) effects(read,write,trap) entry(entry)
block entry(i:readbuf,o:mutbuf,from:u64,to:u64,n:u64)
  jump loop(i,o,from,to,n)
block loop(l_i:readbuf,l_o:mutbuf,l_r:u64,l_w:u64,l_n:u64)
  z:u64 = const() {"value":0}
  done:bool = compare.eq(l_n,z)
  branch done exit(l_w) byte(l_i,l_o,l_r,l_w,l_n)
block byte(b_i:readbuf,b_o:mutbuf,b_from:u64,b_to:u64,b_count:u64)
  rd:usize = int.cast(b_from) {"mode":"wrap"}
  wt:usize = int.cast(b_to) {"mode":"wrap"}
  v:u8 = buffer.load(b_i,rd)
  _ = buffer.store(b_o,wt,v)
  one:u64 = const() {"value":1}
  next_r:u64 = int.add.wrap(b_from,one)
  next_w:u64 = int.add.wrap(b_to,one)
  remaining:u64 = int.sub.wrap(b_count,one)
  jump loop(b_i,b_o,next_r,next_w,remaining)
block exit(out_end:u64)
  ret(out_end)
end

fn diag_u16(i:readbuf,p:u64) -> (u64) effects(read,trap) entry(entry)
block entry(i:readbuf,p:u64)
  at:usize = int.cast(p) {"mode":"wrap"}
  one:usize = const() {"value":1}
  plus:usize = int.add.wrap(at,one)
  a:u8 = buffer.load(i,at)
  b:u8 = buffer.load(i,plus)
  aa:u64 = int.cast(a) {"mode":"wrap"}
  bb:u64 = int.cast(b) {"mode":"wrap"}
  eight:u64 = const() {"value":8}
  high:u64 = int.shl.checked(bb,eight)
  v:u64 = bit.or(high,aa)
  ret(v)
end

fn jaro_fraction(n:u64,d:u64) -> (u64) effects(trap) entry(entry)
block entry(n:u64,d:u64)
  initial:u64 = const() {"value":1023}
  jump normalize(n,d,initial)
block normalize(nn:u64,nd:u64,ne:u64)
  ready:bool = compare.ge(nn,nd)
  branch ready exact(nn,nd,ne) widen(nn,nd,ne)
block widen(wn:u64,wd:u64,we:u64)
  one:u64 = const() {"value":1}
  x:u64 = int.shl.checked(wn,one)
  exp:u64 = int.sub.wrap(we,one)
  jump normalize(x,wd,exp)
block exact(xn:u64,xd:u64,xe:u64)
  sh:u64 = const() {"value":52}
  ext:u64 = int.shl.checked(xn,sh)
  ans:u64 = call(ext,xd,xe) {"function":"jaro_rounded_div"}
  ret(ans)
end

fn jaro_rounded_div(n:u64,d:u64,e:u64) -> (u64) effects(trap) entry(entry)
block entry(n:u64,d:u64,e:u64)
  q:u64 = int.div.checked(n,d)
  prod:u64 = int.mul.wrap(q,d)
  r:u64 = int.sub.wrap(n,prod)
  answer:u64 = call(q,r,d,e) {"function":"jaro_round"}
  ret(answer)
end

fn jaro_round(q:u64,r:u64,d:u64,e:u64) -> (u64) effects(trap) entry(entry)
block entry(q:u64,r:u64,d:u64,e:u64)
  one:u64 = const() {"value":1}
  zero:u64 = const() {"value":0}
  twice:u64 = int.shl.checked(r,one)
  greater:bool = compare.gt(twice,d)
  equal:bool = compare.eq(twice,d)
  low:u64 = bit.and(q,one)
  odd:bool = compare.ne(low,zero)
  even_tie:bool = bool.and(equal,odd)
  increment:bool = bool.or(greater,even_tie)
  plus:u64 = select(increment,one,zero)
  rounded:u64 = int.add.wrap(q,plus)
  two:u64 = const() {"value":9007199254740992}
  carry:bool = compare.eq(rounded,two)
  wide:u64 = select(carry,one,zero)
  shifted:u64 = int.shr.checked(rounded,wide)
  adjusted:u64 = int.add.wrap(e,wide)
  mask:u64 = const() {"value":4503599627370495}
  frac:u64 = bit.and(shifted,mask)
  exp_sh:u64 = const() {"value":52}
  exp:u64 = int.shl.checked(adjusted,exp_sh)
  answer:u64 = bit.or(exp,frac)
  ret(answer)
end

fn jaro_add(a:u64,b:u64) -> (u64) effects(trap) entry(entry)
block entry(a:u64,b:u64)
  ordered:bool = compare.ge(a,b)
  big:u64 = select(ordered,a,b)
  small:u64 = select(ordered,b,a)
  exp_sh:u64 = const() {"value":52}
  eb:u64 = int.shr.checked(big,exp_sh)
  es:u64 = int.shr.checked(small,exp_sh)
  delta:u64 = int.sub.wrap(eb,es)
  mask:u64 = const() {"value":4503599627370495}
  hidden:u64 = const() {"value":4503599627370496}
  mbits:u64 = bit.and(big,mask)
  sbits:u64 = bit.and(small,mask)
  mb:u64 = bit.or(mbits,hidden)
  ms:u64 = bit.or(sbits,hidden)
  aligned:u64 = int.shl.checked(mb,delta)
  sum:u64 = int.add.wrap(aligned,ms)
  boundary:u64 = const() {"value":9007199254740992}
  bound:u64 = int.shl.checked(boundary,delta)
  carry:bool = compare.ge(sum,bound)
  one_norm:u64 = const() {"value":1}
  zero_norm:u64 = const() {"value":0}
  norm:u64 = select(carry,one_norm,zero_norm)
  cut:u64 = int.add.wrap(delta,norm)
  one:u64 = const() {"value":1}
  den:u64 = int.shl.checked(one,cut)
  e:u64 = int.add.wrap(eb,norm)
  result:u64 = call(sum,den,e) {"function":"jaro_rounded_div"}
  ret(result)
end

fn jaro_third(a:u64) -> (u64) effects(trap) entry(entry)
block entry(a:u64)
  exp_sh:u64 = const() {"value":52}
  exp:u64 = int.shr.checked(a,exp_sh)
  mask:u64 = const() {"value":4503599627370495}
  hidden:u64 = const() {"value":4503599627370496}
  bits:u64 = bit.and(a,mask)
  actual:u64 = bit.or(bits,hidden)
  cross:u64 = const() {"value":6755399441055744}
  one:u64 = const() {"value":1}
  two:u64 = const() {"value":2}
  three:u64 = const() {"value":3}
  near:bool = compare.ge(actual,cross)
  shift:u64 = select(near,one,two)
  e:u64 = int.sub.wrap(exp,shift)
  lifted:u64 = int.shl.checked(actual,shift)
  ans:u64 = call(lifted,three,e) {"function":"jaro_rounded_div"}
  ret(ans)
end

fn jaro_formula(a:u64,b:u64,m:u64,trans:u64) -> (u64) effects(trap) entry(entry)
block entry(a:u64,b:u64,m:u64,trans:u64)
  one:u64 = const() {"value":1}
  half:u64 = int.shr.checked(trans,one)
  matching:u64 = int.sub.wrap(m,half)
  p:u64 = call(m,a) {"function":"jaro_fraction"}
  q:u64 = call(m,b) {"function":"jaro_fraction"}
  r:u64 = call(matching,m) {"function":"jaro_fraction"}
  pq:u64 = call(p,q) {"function":"jaro_add"}
  total:u64 = call(pq,r) {"function":"jaro_add"}
  result:u64 = call(total) {"function":"jaro_third"}
  ret(result)
end

fn jaro_score(i:readbuf,s:mutbuf,a:u64,b_at:u64,b:u64) -> (u64) effects(read,write,trap) entry(entry)
block entry(i:readbuf,s:mutbuf,a:u64,b_at:u64,b:u64)
  z:usize = const() {"value":0}
  jump clear(i,s,a,b_at,b,z)
block clear(c_i:readbuf,c_s:mutbuf,c_a:u64,c_b_at:u64,c_b:u64,c_idx:usize)
  stop:usize = const() {"value":149}
  done:bool = compare.eq(c_idx,stop)
  branch done begin(c_i,c_s,c_a,c_b_at,c_b) clear_byte(c_i,c_s,c_a,c_b_at,c_b,c_idx)
block clear_byte(e_i:readbuf,e_s:mutbuf,e_a:u64,e_b_at:u64,e_b:u64,e_idx:usize)
  no:u8 = const() {"value":0}
  _ = buffer.store(e_s,e_idx,no)
  one:usize = const() {"value":1}
  next:usize = int.add.wrap(e_idx,one)
  jump clear(e_i,e_s,e_a,e_b_at,e_b,next)
block begin(b_i:readbuf,b_s:mutbuf,b_a:u64,b_b_at:u64,b_b:u64)
  one_b:u64 = const() {"value":1}
  zero_b:u64 = const() {"value":0}
  ag:bool = compare.ge(b_a,b_b)
  big:u64 = select(ag,b_a,b_b)
  h:u64 = int.shr.checked(big,one_b)
  has_range:bool = compare.gt(h,zero_b)
  raw:u64 = int.sub.wrap(h,one_b)
  range:u64 = select(has_range,raw,zero_b)
  m:u64 = call(b_i,b_s,b_a,b_b_at,b_b,range) {"function":"jaro_match"}
  any:bool = compare.gt(m,zero_b)
  branch any calculate(b_i,b_s,b_a,b_b_at,b_b,m) no_score()
block calculate(ca_i:readbuf,ca_s:mutbuf,ca_a:u64,ca_b_at:u64,ca_b:u64,ca_m:u64)
  tr:u64 = call(ca_i,ca_s,ca_a,ca_b_at,ca_b) {"function":"jaro_trans"}
  bits:u64 = call(ca_a,ca_b,ca_m,tr) {"function":"jaro_formula"}
  ret(bits)
block no_score()
  none_score:u64 = const() {"value":0}
  ret(none_score)
end

fn jaro_match(i:readbuf,s:mutbuf,a:u64,b_at:u64,b:u64,range:u64) -> (u64) effects(read,write,trap) entry(entry)
block entry(i:readbuf,s:mutbuf,a:u64,b_at:u64,b:u64,range:u64)
  z:u64 = const() {"value":0}
  jump scan(i,s,a,b_at,b,range,z,z)
block scan(sc_i:readbuf,sc_s:mutbuf,sc_a:u64,sc_b_at:u64,sc_b:u64,sc_range:u64,sc_j:u64,sc_m:u64)
  done:bool = compare.eq(sc_a,sc_j)
  branch done count(sc_m) window(sc_i,sc_s,sc_a,sc_b_at,sc_b,sc_range,sc_j,sc_m)
block window(w_i:readbuf,w_s:mutbuf,w_a:u64,w_b_at:u64,w_b:u64,w_range:u64,w_j:u64,w_m:u64)
  z_w:u64 = const() {"value":0}
  one_w:u64 = const() {"value":1}
  token_w:u64 = const() {"value":16}
  left:bool = compare.gt(w_j,w_range)
  minus:u64 = int.sub.wrap(w_j,w_range)
  from:u64 = select(left,minus,z_w)
  next_w:u64 = int.add.wrap(w_j,one_w)
  large_w:u64 = int.add.wrap(next_w,w_range)
  enough:bool = compare.lt(large_w,w_b)
  to:u64 = select(enough,large_w,w_b)
  ap:u64 = int.add.wrap(w_j,token_w)
  ai:usize = int.cast(ap) {"mode":"wrap"}
  letter:u8 = buffer.load(w_i,ai)
  pos:u64 = call(w_i,w_s,w_b_at,from,to,letter) {"function":"jaro_find"}
  miss:u64 = const() {"value":255}
  matched:bool = compare.ne(pos,miss)
  branch matched record(w_i,w_s,w_a,w_b_at,w_b,w_range,w_j,next_w,w_m,pos) scan(w_i,w_s,w_a,w_b_at,w_b,w_range,next_w,w_m)
block record(r_i:readbuf,r_s:mutbuf,r_a:u64,r_b_at:u64,r_b:u64,r_range:u64,r_j:u64,r_next:u64,r_m:u64,r_pos:u64)
  yes:u8 = const() {"value":1}
  one_r:u64 = const() {"value":1}
  bflags:u64 = const() {"value":128}
  bp:u64 = int.add.wrap(bflags,r_pos)
  af:usize = int.cast(r_j) {"mode":"wrap"}
  bf:usize = int.cast(bp) {"mode":"wrap"}
  _ = buffer.store(r_s,af,yes)
  _ = buffer.store(r_s,bf,yes)
  new_m:u64 = int.add.wrap(r_m,one_r)
  jump scan(r_i,r_s,r_a,r_b_at,r_b,r_range,r_next,new_m)
block count(m:u64)
  ret(m)
end

fn jaro_find(i:readbuf,s:mutbuf,b_at:u64,from:u64,to:u64,letter:u8) -> (u64) effects(read,write,trap) entry(entry)
block entry(i:readbuf,s:mutbuf,b_at:u64,from:u64,to:u64,letter:u8)
  jump scan(i,s,b_at,from,to,letter)
block scan(f_i:readbuf,f_s:mutbuf,f_b_at:u64,f_from:u64,f_to:u64,f_letter:u8)
  has:bool = compare.lt(f_from,f_to)
  branch has check(f_i,f_s,f_b_at,f_from,f_to,f_letter) miss()
block check(c_i:readbuf,c_s:mutbuf,c_b_at:u64,c_from:u64,c_to:u64,c_letter:u8)
  bflags:u64 = const() {"value":128}
  flag:u64 = int.add.wrap(bflags,c_from)
  fl_at:usize = int.cast(flag) {"mode":"wrap"}
  fl:u8 = buffer.load(c_s,fl_at)
  zero_c:u8 = const() {"value":0}
  fresh:bool = compare.eq(fl,zero_c)
  rel:u64 = int.add.wrap(c_b_at,c_from)
  at:usize = int.cast(rel) {"mode":"wrap"}
  item:u8 = buffer.load(c_i,at)
  same:bool = compare.eq(item,c_letter)
  yes:bool = bool.and(fresh,same)
  one:u64 = const() {"value":1}
  next:u64 = int.add.wrap(c_from,one)
  branch yes hit(c_from) scan(c_i,c_s,c_b_at,next,c_to,c_letter)
block hit(found:u64)
  ret(found)
block miss()
  no:u64 = const() {"value":255}
  ret(no)
end

fn jaro_trans(i:readbuf,s:mutbuf,a:u64,b_at:u64,b:u64) -> (u64) effects(read,write,trap) entry(entry)
block entry(i:readbuf,s:mutbuf,a:u64,b_at:u64,b:u64)
  z:u64 = const() {"value":0}
  jump scan(i,s,a,b_at,b,z,z,z)
block scan(s_i:readbuf,s_s:mutbuf,s_a:u64,s_b_at:u64,s_b:u64,s_x:u64,s_y:u64,s_count:u64)
  done:bool = compare.eq(s_a,s_x)
  branch done answer(s_count) check(s_i,s_s,s_a,s_b_at,s_b,s_x,s_y,s_count)
block check(c_i:readbuf,c_s:mutbuf,c_a:u64,c_b_at:u64,c_b:u64,c_x:u64,c_y:u64,c_count:u64)
  at_x:usize = int.cast(c_x) {"mode":"wrap"}
  mark:u8 = buffer.load(c_s,at_x)
  no:u8 = const() {"value":0}
  active:bool = compare.ne(mark,no)
  one:u64 = const() {"value":1}
  next:u64 = int.add.wrap(c_x,one)
  branch active seek(c_i,c_s,c_a,c_b_at,c_b,c_x,next,c_y,c_count) scan(c_i,c_s,c_a,c_b_at,c_b,next,c_y,c_count)
block seek(k_i:readbuf,k_s:mutbuf,k_a:u64,k_b_at:u64,k_b:u64,k_x:u64,k_next:u64,k_y:u64,k_count:u64)
  has:bool = compare.lt(k_y,k_b)
  branch has next_b(k_i,k_s,k_a,k_b_at,k_b,k_x,k_next,k_y,k_count) answer(k_count)
block next_b(n_i:readbuf,n_s:mutbuf,n_a:u64,n_b_at:u64,n_b:u64,n_x:u64,n_next:u64,n_y:u64,n_count:u64)
  bflags:u64 = const() {"value":128}
  p_flag:u64 = int.add.wrap(bflags,n_y)
  f_idx:usize = int.cast(p_flag) {"mode":"wrap"}
  b_mark:u8 = buffer.load(n_s,f_idx)
  z_n:u8 = const() {"value":0}
  selected:bool = compare.ne(b_mark,z_n)
  one_n:u64 = const() {"value":1}
  advance:u64 = int.add.wrap(n_y,one_n)
  branch selected compare_order(n_i,n_s,n_a,n_b_at,n_b,n_x,n_next,n_y,advance,n_count) seek(n_i,n_s,n_a,n_b_at,n_b,n_x,n_next,advance,n_count)
block compare_order(o_i:readbuf,o_s:mutbuf,o_a:u64,o_b_at:u64,o_b:u64,o_x:u64,o_next:u64,o_y:u64,o_advance:u64,o_count:u64)
  token:u64 = const() {"value":16}
  p:u64 = int.add.wrap(token,o_x)
  q:u64 = int.add.wrap(o_b_at,o_y)
  aa:usize = int.cast(p) {"mode":"wrap"}
  bb:usize = int.cast(q) {"mode":"wrap"}
  actual_a:u8 = buffer.load(o_i,aa)
  actual_b:u8 = buffer.load(o_i,bb)
  different:bool = compare.ne(actual_a,actual_b)
  one_o:u64 = const() {"value":1}
  none_o:u64 = const() {"value":0}
  inc:u64 = select(different,one_o,none_o)
  count_o:u64 = int.add.wrap(o_count,inc)
  jump scan(o_i,o_s,o_a,o_b_at,o_b,o_next,o_advance,count_o)
block answer(r_count:u64)
  ret(r_count)
end

fn jaro_choice(i:readbuf,s:mutbuf,len:u64,code:u64) -> (u64) effects(read,write,trap) entry(entry)
block entry(i:readbuf,s:mutbuf,len:u64,code:u64)
  workload:u64 = const() {"value":102}
  enabled:bool = compare.eq(code,workload)
  three:u64 = const() {"value":3}
  ten:u64 = const() {"value":10}
  z:u64 = const() {"value":0}
  start:u64 = select(enabled,z,three)
  stop:u64 = select(enabled,three,ten)
  selected:u64 = call(i,s,len,start,stop) {"function":"jaro_index"}
  invalid_value:u64 = const() {"value":65535}
  has_match:bool = compare.ne(selected,z)
  valid_result:bool = compare.ne(selected,invalid_value)
  has_valid_match:bool = bool.and(has_match,valid_result)
  branch has_valid_match label(i,selected) none()
block label(l_i:readbuf,l_selected:u64)
  one_l:u64 = const() {"value":1}
  index_l:u64 = int.sub.wrap(l_selected,one_l)
  result_l:u64 = call(l_i,index_l) {"function":"jaro_label"}
  ret(result_l)
block none()
  zero_n:u64 = const() {"value":0}
  ret(zero_n)
end

fn jaro_index(i:readbuf,s:mutbuf,len:u64,start:u64,stop:u64) -> (u64) effects(read,write,trap) entry(entry)
block entry(i:readbuf,s:mutbuf,len:u64,start:u64,stop:u64)
  zero:u64 = const() {"value":0}
  threshold:u64 = const() {"value":4604480259023595110}
  jump scan(i,s,len,start,stop,threshold,zero)
block scan(c_i:readbuf,c_s:mutbuf,c_len:u64,c_j:u64,c_stop:u64,c_best:u64,c_name:u64)
  done:bool = compare.eq(c_j,c_stop)
  branch done chosen(c_name) candidate(c_i,c_s,c_len,c_j,c_stop,c_best,c_name)
block candidate(a_i:readbuf,a_s:mutbuf,a_len:u64,a_j:u64,a_stop:u64,a_best:u64,a_name:u64)
  offset_len:u64 = call(a_i,a_j) {"function":"jaro_label"}
  mask:u64 = const() {"value":65535}
  count:u64 = bit.and(offset_len,mask)
  zero_a:u64 = const() {"value":0}
  max_len:u64 = const() {"value":21}
  have:bool = compare.gt(count,zero_a)
  fits:bool = compare.le(count,max_len)
  valid:bool = bool.and(have,fits)
  branch valid compare_candidate(a_i,a_s,a_len,a_j,a_stop,a_best,a_name,offset_len,count) invalid()
block compare_candidate(k_i:readbuf,k_s:mutbuf,k_len:u64,k_j:u64,k_stop:u64,k_best:u64,k_name:u64,k_row:u64,k_count:u64)
  sixteen:u64 = const() {"value":16}
  at_name:u64 = int.shr.checked(k_row,sixteen)
  bits:u64 = call(k_i,k_s,k_len,at_name,k_count) {"function":"jaro_score"}
  threshold_k:u64 = const() {"value":4604480259023595110}
  passed:bool = compare.gt(bits,threshold_k)
  at_least:bool = compare.ge(bits,k_best)
  new_best:bool = bool.and(passed,at_least)
  best:u64 = select(new_best,bits,k_best)
  one_k:u64 = const() {"value":1}
  next:u64 = int.add.wrap(k_j,one_k)
  index:u64 = select(new_best,next,k_name)
  jump scan(k_i,k_s,k_len,next,k_stop,best,index)
block chosen(found:u64)
  ret(found)
block invalid()
  sentinel:u64 = const() {"value":65535}
  ret(sentinel)
end

fn jaro_label(i:readbuf,index:u64) -> (u64) effects(read,trap) entry(entry)
block entry(i:readbuf,index:u64)
  directory:u64 = const() {"value":976}
  width:u64 = const() {"value":4}
  slot:u64 = int.mul.wrap(index,width)
  row:u64 = int.add.wrap(directory,slot)
  two:u64 = const() {"value":2}
  n_at:u64 = int.add.wrap(row,two)
  offset:u64 = call(i,row) {"function":"diag_u16"}
  name_len:u64 = call(i,n_at) {"function":"diag_u16"}
  floor_label:u64 = const() {"value":960}
  after_directory:bool = compare.ge(offset,floor_label)
  h:u64 = const() {"value":144}
  at:u64 = int.add.wrap(offset,h)
  end:u64 = int.add.wrap(at,name_len)
  extent:usize = buffer.len(i)
  cap:u64 = int.cast(extent) {"mode":"wrap"}
  fits:bool = compare.le(end,cap)
  valid:bool = bool.and(fits,after_directory)
  shift:u64 = const() {"value":16}
  left:u64 = int.shl.checked(at,shift)
  combined:u64 = bit.or(left,name_len)
  absent:u64 = const() {"value":0}
  result:u64 = select(valid,combined,absent)
  ret(result)
end

fn flag_usage_plan(i:readbuf,order:u64) -> (u64) effects(read,trap) entry(entry)
block entry(i:readbuf,order:u64)
  zero:u64 = const() {"value":0}
  jump next(i,order,zero,zero)
block next(i_n:readbuf,o_n:u64,s_n:u64,l_n:u64)
  zero_n:u64 = const() {"value":0}
  done_n:bool = compare.eq(o_n,zero_n)
  branch done_n finish(s_n,l_n) member(i_n,o_n,s_n,l_n)
block member(i_m:readbuf,o_m:u64,s_m:u64,l_m:u64)
  mask_m:u64 = const() {"value":15}
  max_m:u64 = const() {"value":9}
  one_m:u64 = const() {"value":1}
  zero_m:u64 = const() {"value":0}
  item_m:u64 = bit.and(o_m,mask_m)
  bit_m:u64 = int.shl.checked(one_m,item_m)
  old_m:u64 = bit.and(s_m,bit_m)
  fresh_m:bool = compare.eq(old_m,zero_m)
  valid_m:bool = compare.le(item_m,max_m)
  input_m:bool = bool.and(fresh_m,valid_m)
  piece_m:u64 = call(i_m,item_m) {"function":"flag_usage_piece"}
  found_m:bool = compare.ne(piece_m,zero_m)
  accept_m:bool = bool.and(input_m,found_m)
  branch accept_m accumulate(i_m,o_m,s_m,l_m,piece_m,bit_m) invalid()
block accumulate(i_a:readbuf,o_a:u64,s_a:u64,l_a:u64,p_a:u64,b_a:u64)
  four_a:u64 = const() {"value":4}
  mask_a:u64 = const() {"value":65535}
  rest_a:u64 = int.shr.checked(o_a,four_a)
  new_seen:u64 = bit.or(s_a,b_a)
  width_a:u64 = bit.and(p_a,mask_a)
  new_len:u64 = int.add.wrap(l_a,width_a)
  jump next(i_a,rest_a,new_seen,new_len)
block finish(s_f:u64,len_f:u64)
  shift_f:u64 = const() {"value":16}
  hi_f:u64 = int.shl.checked(s_f,shift_f)
  value_f:u64 = bit.or(hi_f,len_f)
  ret(value_f)
block invalid()
  empty:u64 = const() {"value":0}
  ret(empty)
end

fn flag_usage_render(i:readbuf,o:mutbuf,to:u64,order:u64) -> (u64) effects(read,write,trap) entry(entry)
block entry(i:readbuf,o:mutbuf,to:u64,order:u64)
  jump next(i,o,to,order)
block next(i_n:readbuf,o_n:mutbuf,t_n:u64,a_n:u64)
  zero_n:u64 = const() {"value":0}
  done_n:bool = compare.eq(a_n,zero_n)
  branch done_n finish(t_n) member(i_n,o_n,t_n,a_n)
block member(i_m:readbuf,o_m:mutbuf,t_m:u64,a_m:u64)
  four_m:u64 = const() {"value":4}
  mask_m:u64 = const() {"value":15}
  item_m:u64 = bit.and(a_m,mask_m)
  rest_m:u64 = int.shr.checked(a_m,four_m)
  piece_m:u64 = call(i_m,item_m) {"function":"flag_usage_piece"}
  again_m:u64 = call(i_m,o_m,t_m,piece_m) {"function":"diag_copy_piece"}
  jump next(i_m,o_m,again_m,rest_m)
block finish(t_f:u64)
  ret(t_f)
end

fn flag_usage_piece(i:readbuf,idx:u64) -> (u64) effects(read,trap) entry(entry)
block entry(i:readbuf,idx:u64)
  one:u64 = const() {"value":1}
  ten:u64 = const() {"value":10}
  bounded_lo:bool = compare.ge(idx,one)
  bounded_hi:bool = compare.le(idx,ten)
  bounded:bool = bool.and(bounded_lo,bounded_hi)
  branch bounded inspect(i,idx) fail()
block inspect(i_f:readbuf,idx_f:u64)
  names:u64 = const() {"value":10}
  tails:u64 = const() {"value":20}
  stem:u64 = const() {"value":20}
  mask:u64 = const() {"value":65535}
  shift:u64 = const() {"value":16}
  at_name:u64 = int.add.wrap(idx_f,names)
  at_tail:u64 = int.add.wrap(idx_f,tails)
  name:u64 = call(i_f,at_name) {"function":"jaro_label"}
  tail:u64 = call(i_f,at_tail) {"function":"jaro_label"}
  n_name:u64 = bit.and(name,mask)
  n_tail:u64 = bit.and(tail,mask)
  minimum:u64 = const() {"value":1}
  max_name:u64 = const() {"value":21}
  max_tail:u64 = const() {"value":96}
  cut:u64 = int.add.wrap(n_name,stem)
  name_enter:bool = compare.ge(n_name,minimum)
  name_close:bool = compare.le(n_name,max_name)
  tail_has_usage:bool = compare.gt(n_tail,cut)
  tail_closed:bool = compare.le(n_tail,max_tail)
  name_ok:bool = bool.and(name_enter,name_close)
  tail_ok:bool = bool.and(tail_has_usage,tail_closed)
  raw:u64 = int.shr.checked(tail,shift)
  from:u64 = int.add.wrap(raw,cut)
  packed:u64 = int.shl.checked(from,shift)
  length:u64 = int.sub.wrap(n_tail,cut)
  descriptor:u64 = bit.or(packed,length)
  safe:bool = bool.and(name_ok,tail_ok)
  branch safe ok(descriptor) fail()
block ok(found:u64)
  ret(found)
block fail()
  zero:u64 = const() {"value":0}
  ret(zero)
end

fn diag_copy_piece(i:readbuf,o:mutbuf,to:u64,piece:u64) -> (u64) effects(read,write,trap) entry(entry)
block entry(i:readbuf,o:mutbuf,to:u64,piece:u64)
  width:u64 = const() {"value":16}
  mask:u64 = const() {"value":65535}
  at:u64 = int.shr.checked(piece,width)
  n:u64 = bit.and(piece,mask)
  end:u64 = call(i,o,at,to,n) {"function":"diag_copy"}
  ret(end)
end
