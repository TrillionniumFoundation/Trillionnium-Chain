credit) ... ok\n+test_credit_quality_is_not_count_quality (test_joint_consensus_qualification.JointQualificationTests.test_credit_quality_is_not_count_quality) ... ok\n+test_current_contract_keeps_all_actual_probabilities_unknown (test_joint_consensus_qualification.JointQualificationTests.test_current_contract_keeps_all_actual_probabilities_unknown) ... ok\n+test_declaring_an_obligation_proved_does_not_promote_it (test_joint_consensus_qualification.JointQualificationTests.test_declaring_an_obligation_proved_does_not_promote_it) ... ok\n+test_duplicate_json_float_nonfinite_and_oversize_are_refused (test_joint_consensus_qualification.JointQualificationTests.test_duplicate_json_float_nonfinite_and_oversize_are_refused) ... ok\n+test_every_open_obligation_is_mandatory (test_joint_consensus_qualification.JointQualificationTests.test_every_open_obligation_is_mandatory) ... ok\n+test_header_time_is_not_a_real_cost_clock (test_joint_consensus_qualification.JointQualificationTests.test_header_time_is_not_a_real_cost_clock) ... ok\n+test_height_only_confirmation_is_refused (test_joint_consensus_qualification.JointQualificationTests.test_height_only_confirmation_is_refused) ... ok\n+test_incomplete_model_contract_reference_fails (test_joint_consensus_qualification.JointQualificationTests.test_incomplete_model_contract_reference_fails) ... ok\n+test_missing_owner_pin_or_extra_source_pin_is_refused (test_joint_consensus_qualification.JointQualificationTests.test_missing_owner_pin_or_extra_source_pin_is_refused) ... ok\n+test_native_metrics_cannot_be_silently_changed (test_joint_consensus_qualification.JointQualificationTests.test_native_metrics_cannot_be_silently_changed) ... ok\n+test_numeric_lifetime_bound_is_refused_even_if_zero (test_joint_consensus_qualification.JointQualificationTests.test_numeric_lifetime_bound_is_refused_even_if_zero) ... ok\n+test_parameter_manifest_cannot_override_installed_policy (test_joint_consensus_qualification.JointQualificationTests.test_paramet