fn sp_normalize(w:mutbuf,n:u64) -> (u64) effects(read,write,trap) entry(entry)
block entry(w:mutbuf,n:u64)
  start:u64 = const() {"value":1208}
  target:u64 = const() {"value":5304}
  top:u64 = int.add.wrap(start,n)
  no_gap:bool = const() {"value":false}
  jump scan(w,start,target,top,no_gap)
block scan(sw:mutbuf,sp:u64,sd:u64,se:u64,sg:bool)
  ended:bool = compare.eq(sp,se)
  branch ended done(sd) ch(sw,sp,sd,se,sg)
block ch(cw:mutbuf,cp:u64,cd:u64,ce:u64,cg:bool)
  at:usize = int.cast(cp) {"mode":"wrap"}
