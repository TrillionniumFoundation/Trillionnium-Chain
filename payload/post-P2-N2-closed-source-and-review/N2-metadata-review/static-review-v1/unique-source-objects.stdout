//! Owner-pinned dependency/file plan over existing TCM1 and TCR1 identities.
//!
//! This validates a declared graph, portable names and exact loader context. It
//! cannot infer dependencies omitted by the release owner, parse tensors, select
//! CURRENT, authorize export or mint FinalUse. The safe loader still owns those
//! decisions and supplies its expected closure/profile/generation independently.

use std::{
    collections::BTreeSet,
    io::{Cursor, Read},
};

use sha2::{Digest, Sha256};

use super::{
    require, CellContextV1, CellDigestV1, CellErrorV1, CellManifestV1, CellReleaseManifestV1,
    CellResultV1, MAX_CELL_BYTES,
};

pub const MAX_CELL_CLOSURE_BYTES_V1: usize = 1024 * 1024;
pub const MAX_CELL_CLOSURE_FILES_V1: usize = 256;
const MAX_GRAPH_DEPTH: usize = 16;
const MAX_PATH_BYTES: usize = 255;

/// Data roles only. No role requests code execution or supplies a dynamic loader.
#[derive(Clone, Copy, Debug, Eq, Ord, PartialEq, PartialOrd)]
#[repr(u8)]
pub enum CellFileRoleV1 {
    Base = 1,
    Tokenizer = 2,
    Preprocessor = 3,
    Adapter = 4,
    Router = 5,
    Configuration = 6,
}

impl CellFileRoleV1 {
    fn decode(value: u8) -> CellResultV1<Self> {
        match value {
            1 => Ok(Self::Base),
            2 => Ok(Self::Tokenizer),
            3 => Ok(Self::Preprocessor),
            4 => Ok(Self::Adapter),
            5 => Ok(Self::Router),
            6 => Ok(Self::Configuration),
            _ => Err(CellErrorV1::Invalid("closure role")),
        }
    }
}

/// An immutable data-file mapping. Dependencies are indices in canonical path order.
#[derive(Clone, Debug, Eq, PartialEq)]
pub struct CellClosureFileV1 {
    pub path: String,
    pub role: CellFileRoleV1,
    pub manifest: CellDigestV1,
    pub payload_sha256: CellDigestV1,
    pub payload_bytes: u64,
    pub dependencies: Vec<u16>,
}

/// Expected values from the existing release/loader owner, never peer discovery.
/// A matching profile identifies the loader's format/shape/ABI policy; it does
/// not prove that a tensor parser has executed or that use is authorized.
#[derive(Clone, Debug)]
pub struct CellLoaderContextV1 {
    pub closure_id: CellDigestV1,
    pub context: CellContextV1,
    pub selected_generation: u64,
    pub loader_profile: CellDigestV1,
    pub required_roles: Vec<CellFileRoleV1>,
    pub max_payload_bytes: u64,
    pub max_chunks: u64,
}

#[derive(Clone, Debug, Eq, PartialEq)]
pub struct CellReleaseClosureV1 {
    release: CellReleaseManifestV1,
    selected_generation: u64,
    loader_profile: CellDigestV1,
    roots: Vec<u16>,
    files: Vec<CellClosureFileV1>,
}

impl CellReleaseClosureV1 {
    /// Order is part of the wire contract. Do not silently sort paths/indices.
    pub fn new(
        context: CellContextV1,
        selected_generation: u64,
        loader_profile: CellDigestV1,
        roots: Vec<u16>,
        files: Vec<CellClosureFileV1>,
    ) -> CellResultV1<Self> {
        require(
            !files.is_empty() && files.len() <= MAX_CELL_CLOSURE_FILES_V1,
            "closure file count",
        )?;
        let release =
            CellReleaseManifestV1::new(context, files.iter().map(|file| file.manifest).collect())?;
        let value = Self {
            release,
            selected_generation,
            loader_profile,
            roots,
            files,
        };
        value.validate()?;
        Ok(value)
    }

    pub fn release(&self) -> &CellReleaseManifestV1 {
        &self.release
    }
    pub fn files(&self) -> &[CellClosureFileV1] {
        &self.files
    }
    pub fn roots(&self) -> &[u16] {
        &self.roots
    }
    pub fn selected_generation(&self) -> u64 {
        self.selected_generation
    }
    pub fn loader_profile(&self) -> CellDigestV1 {
        self.loader_profile
    }

    pub fn validate(&self) -> CellResultV1<()> {
        self.release.validate()?;
        require(self.selected_generation > 0, "closure generation")?;
        require(self.loader_profile != [0; 32], "closure loader profile")?;
        require(
            !self.files.is_empty() && self.files.len() <= MAX_CELL_CLOSURE_FILES_V1,
            "closure file count",
        )?;
        validate_indices(&self.roots, self.files.len(), "closure roots")?;
        require(!self.roots.is_empty(), "closure roots")?;
        require(
            self.files
                .windows(2)
                .all(|pair| pair[0].path < pair[1].path),
            "closure canonical paths",
        )?;
        // Preserve the owner's exact names (including README.md), while
        // rejecting aliases on case-insensitive filesystems.
        let paths: BTreeSet<String> = self
            .files
            .iter()
            .map(|file| file.path.to_ascii_lowercase())
            .collect();
        require(
            paths.len() == self.files.len(),
            "closure case-fold path alias",
        )?;
        let mut manifests = BTreeSet::new();
        for (index, file) in self.files.iter().enumerate() {
            validate_path(&file.path)?;
            let folded = file.path.to_ascii_lowercase();
            for (offset, _) in folded.match_indices('/') {
                require(
                    !paths.contains(&folded[..offset]),
                    "closure file/directory alias",
                )?;
            }
            require(
                file.manifest != [0; 32]
                    && file.payload_sha256 != [0; 32]
                    && (1..=MAX_CELL_BYTES).contains(&file.payload_bytes),
                "closure payload identity",
            )?;
            require(manifests.insert(file.manifest), "closure manifest alias")?;
            validate_indices(&file.dependencies, self.files.len(), "closure dependency")?;
            require(
                !file.dependencies.contains(&(index as u16)),
                "closure self dependency",
            )?;
        }
        require(
            manifests
                .into_iter()
                .eq(self.release.cells().iter().copied()),
            "closure release membership",
        )?;
        let mut states = vec![0; self.files.len()];
        let mut heights = vec![0; self.files.len()];
        for root in &self.roots {
            visit(
                usize::from(*root),
                &self.files,
                &mut states,
                &mut heights,
                1,
            )?;
        }
        require(
            states.iter().all(|state| *state == 2),
            "closure unreachable file",
        )?;
        require(
            self.encode().len() <= MAX_CELL_CLOSURE_BYTES_V1,
            "closure wire length",
        )
    }

    /// This is byte-plan admission only. It intentionally returns no use token.
    pub fn verify_for_loader(&self, expected: &CellLoaderContextV1) -> CellResultV1<()> {
        self.validate()?;
        require(
            self.id() == expected.closure_id
                && self.release.context() == &expected.context
                && self.selected_generation == expected.selected_generation
                && self.loader_profile == expected.loader_profile,
            "closure loader context",
        )?;
        require(
            expected.max_payload_bytes > 0 && expected.max_chunks > 0,
            "closure loader budget",
        )?;
        let required: BTreeSet<_> = expected.required_roles.iter().copied().collect();
        require(
            !required.is_empty() && required.len() == expected.required_roles.len(),
            "closure required roles",
        )?;
        require(
            required
                .iter()
                .all(|role| self.files.iter().any(|file| file.role == *role)),
            "closure missing required role",
        )?;
        let total = self.files.iter().try_fold(0u64, |total, file| {
            total
                .checked_add(file.payload_bytes)
                .ok_or(CellErrorV1::Invalid("closure payload budget"))
        })?;
        require(
            total <= expected.max_payload_bytes,
            "closure payload budget",
        )
    }

    /// Check exact TCM1 metadata before any member payload acquisition.
    pub(crate) fn verify_manifest(&self, manifest: &CellManifestV1) -> CellResultV1<()> {
        manifest.validate()?;
        let id = manifest.id();
        let file = self
            .files
            .iter()
            .find(|file| file.manifest == id)
            .ok_or(CellErrorV1::Invalid("closure unexpected manifest"))?;
        require(
            manifest.context() == self.release.context()
                && manifest.payload_sha256() == file.payload_sha256
                && manifest.size() == file.payload_bytes,
            "closure manifest payload",
        )
    }

    pub fn id(&self) -> CellDigestV1 {
        let mut hash = Sha256::new();
        hash.update(b"trnm.cell-dependency-closure.v1\0");
        hash.update(self.encode());
        hash.finalize().into()
    }

    pub fn encode(&self) -> Vec<u8> {
        let release = self.release.encode();
        let mut out = Vec::new();
        out.extend_from_slice(b"TCD1");
        out.extend_from_slice(&self.selected_generation.to_be_bytes());
        out.extend_from_slice(&self.loader_profile);
        out.extend_from_slice(&(release.len() as u32).to_be_bytes());
        out.extend_from_slice(&release);
        out.extend_from_slice(&(self.roots.len() as u16).to_be_bytes());
        for root in &self.roots {
            out.extend_from_slice(&root.to_be_bytes());
        }
        out.extend_from_slice(&(self.files.len() as u16).to_be_bytes());
        for file in &self.files {
            out.extend_from_slice(&(file.path.len() as u16).to_be_bytes());
            out.extend_from_slice(file.path.as_bytes());
            out.push(file.role as u8);
            out.extend_from_slice(&file.manifest);
            out.extend_from_slice(&file.payload_sha256);
            out.extend_from_slice(&file.payload_bytes.to_be_bytes());
            out.extend_from_slice(&(file.dependencies.len() as u16).to_be_bytes());
            for dependency in &file.dependencies {
                out.extend_from_slice(&dependency.to_be_bytes());
            }
        }
        out
    }

    pub fn decode(bytes: &[u8]) -> CellResultV1<Self> {
        require(
            bytes.len() <= MAX_CELL_CLOSURE_BYTES_V1,
            "closure wire length",
        )?;
        let mut input = Cursor::new(bytes);
        require(read_array::<4>(&mut input)? == *b"TCD1", "closure version")?;
        let selected_generation = u64::from_be_bytes(read_array(&mut input)?);
        let loader_profile = read_array(&mut input)?;
        let release_size = u32::from_be_bytes(read_array(&mut input)?) as usize;
        require(
            release_size <= MAX_CELL_CLOSURE_BYTES_V1,
            "closure release length",
        )?;
        let start = input.position() as usize;
        let end = start
            .checked_add(release_size)
            .ok_or(CellErrorV1::Invalid("closure release length"))?;
        require(end <= bytes.len(), "closure release length")?;
        let release = CellReleaseManifestV1::decode(&bytes[start..end])?;
        input.set_position(end as u64);
        let roots = read_indices(&mut input)?;
        let count = usize::from(u16::from_be_bytes(read_array(&mut input)?));
        require(
            (1..=MAX_CELL_CLOSURE_FILES_V1).contains(&count),
            "closure file count",
        )?;
        let mut files = Vec::with_capacity(count);
        for _ in 0..count {
            let length = usize::from(u16::from_be_bytes(read_array(&mut input)?));
            require(
                (1..=MAX_PATH_BYTES).contains(&length),
                "closure path length",
            )?;
            let mut path = vec![0; length];
            input.read_exact(&mut path)?;
            let path = String::from_utf8(path)
                .map_err(|_| CellErrorV1::Invalid("closure path encoding"))?;
            let role = CellFileRoleV1::decode(read_array::<1>(&mut input)?[0])?;
            files.push(CellClosureFileV1 {
                path,
                role,
                manifest: read_array(&mut input)?,
                payload_sha256: read_array(&mut input)?,
                payload_bytes: u64::from_be_bytes(read_array(&mut input)?),
                dependencies: read_indices(&mut input)?,
            });
        }
        require(
            input.position() == bytes.len() as u64,
            "closure trailing bytes",
        )?;
        let value = Self {
            release,
            selected_generation,
            loader_profile,
            roots,
            files,
        };
        value.validate()?;
        Ok(value)
    }
}

fn validate_indices(indices: &[u16], count: usize, reason: &'static str) -> CellResultV1<()> {
    require(
        indices.len() <= MAX_CELL_CLOSURE_FILES_V1
            && indices.iter().all(|index| usize::from(*index) < count)
            && indices.windows(2).all(|pair| pair[0] < pair[1]),
        reason,
    )
}

fn visit(
    index: usize,
    files: &[CellClosureFileV1],
    states: &mut [u8],
    heights: &mut [usize],
    depth: usize,
) -> CellResultV1<usize> {
    require(depth <= MAX_GRAPH_DEPTH, "closure graph depth")?;
    require(states[index] != 1, "closure dependency cycle")?;
    if states[index] == 2 {
        return Ok(heights[index]);
    }
    states[index] = 1;
    let mut height = 1;
    for dependency in &files[index].dependencies {
        height =
            height.max(1 + visit(usize::from(*dependency), files, states, heights, depth + 1)?);
        require(height <= MAX_GRAPH_DEPTH, "closure graph depth")?;
    }
    states[index] = 2;
    heights[index] = height;
    Ok(height)
}

fn validate_path(path: &str) -> CellResultV1<()> {
    require(
        !path.is_empty()
            && path.len() <= MAX_PATH_BYTES
            && path
                .bytes()
                .all(|byte| byte.is_ascii_alphanumeric() || b"._-/".contains(&byte)),
        "closure portable path",
    )?;
    let parts: Vec<_> = path.split('/').collect();
    require(parts.len() <= 8, "closure path depth")?;
    for part in parts {
        require(
            !part.is_empty() && part.len() <= 64 && !part.starts_with('.') && !part.ends_with('.'),
            "closure path component",
        )?;
        let stem = part.split('.').next().unwrap_or("").to_ascii_lowercase();
        let reserved = matches!(stem.as_str(), "con" | "prn" | "aux" | "nul")
            || ((stem.starts_with("com") || stem.starts_with("lpt"))
                && stem.len() == 4
                && matches!(stem.as_bytes()[3], b'1'..=b'9'));
        require(!reserved, "closure reserved path")?;
    }
    Ok(())
}

fn read_array<const N: usize>(input: &mut Cursor<&[u8]>) -> CellResultV1<[u8; N]> {
    let mut value = [0; N];
    input.read_exact(&mut value)?;
    Ok(value)
}

fn read_indices(input: &mut Cursor<&[u8]>) -> CellResultV1<Vec<u16>> {
    let count = usize::from(u16::from_be_bytes(read_array(input)?));
    require(count <= MAX_CELL_CLOSURE_FILES_V1, "closure index count")?;
    (0..count)
        .map(|_| Ok(u16::from_be_bytes(read_array(input)?)))
        .collect()
}

07537462b6a2a57f8b29b2bb59c16862b770aa91 blob 13891
//! Strict native TPQ1 research wire preflight; **not** a signature verifier.
//!
//! No value returned by this module is an authenticated identity, a verified
//! transaction, VerifiedWork, authorization, final-use or release capability.
//! A separately reviewed ML-DSA-65 verifier and state/nonce owner MUST follow.
//! This module deliberately does not alter the installed legacy PoN wire.
use sha2::{Digest, Sha256, Sha384};

pub const TPQ1_UNSIGNED_BYTES: usize = 176;
pub const ML_DSA_65_SIGNATURE_BYTES: usize = 3_309;
pub const ML_DSA_65_PUBLIC_KEY_BYTES: usize = 1_952;
pub const ML_DSA_65_SPKI_BYTES: usize = 1_974;
// Strict DER SPKI: SEQUENCE(1970), SEQUENCE(id-ml-dsa-65 OID), BIT STRING(1953).
// This checks framing/algorithm identity only; it is NOT ML-DSA public-key validation.
pub(crate) const ML_DSA_65_SPKI_PREFIX: [u8; 22] = [
    0x30, 0x82, 0x07, 0xb2, 0x30, 0x0b, 0x06, 0x09, 0x60, 0x86, 0x48, 0x01, 0x65, 0x03, 0x04, 0x03,
    0x12, 0x03, 0x82, 0x07, 0xa1, 0x00,
];
pub(crate) const PUBLIC_KEY_ID_DOMAIN: &[u8] = b"TRNM/PoN/PQKey/v1\0";
pub const TPQ1_SIGNED_BYTES: usize = TPQ1_UNSIGNED_BYTES + 2 + ML_DSA_65_SIGNATURE_BYTES;
pub const TPQ1_MAX_PAYLOAD_BYTES: usize = 64 * 1024 * 1024;
pub(crate) const DOMAIN: &[u8] = b"TRNM/PoN/PQAuth/ML-DSA-65/v1\0";
pub(crate) const PAYLOAD_TAG: &[u8] = b"payload\0";
pub(crate) const TPQ1_MAGIC: &[u8; 4] = b"TPQ1";
pub(crate) const TPQ1_VERSION: u8 = 1;
pub(crate) const TPQ1_ALGORITHM: u8 = 0x65;
pub(crate) const FIRST_PURPOSE: u8 = 1;
pub(crate) const LAST_PURPOSE: u8 = 6;

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum PqFrameError {
    FrameLength,
    HeaderVersionAlgorithm,
    PurposeOrReserved,
    ContextOrIdentity,
    LifetimeOrSequence,
    Expired,
    PayloadSize,
    PayloadDigest,
    SignatureLength,
    PublicKeyDer,
}

/// Independently pinned caller expectations. In particular, the key ID does
/// not come from the untrusted frame; the future crypto owner must derive it
/// from a strict ML-DSA-65 SPKI public key before using this preflight.
#[derive(Debug, Clone)]
pub struct PqFrameExpectation<'a> {
    pub purpose: u8,
    pub network: [u8; 32],
    pub owner_context: [u8; 32],
    pub signer_key_id: [u8; 32],
    pub owner_generation: u64,
    pub operation_sequence: u64,
    pub expires_at: u64,
    pub now: u64,
    pub payload: &'a [u8],
}

/// These are UNVERIFIED bytes; never use this as a boolean proof of signature,
/// chain authority, user permission, model quality or state transition.
#[derive(Debug)]
pub struct UnverifiedPqFrame<'a> {
    statement: &'a [u8],
    signature: &'a [u8],
}

impl<'a> UnverifiedPqFrame<'a> {
    pub fn unsigned_statement(&self) -> &'a [u8] {
        self.statement
    }

    pub fn unverified_signature(&self) -> &'a [u8] {
        self.signature
    }
}

fn u64_at(input: &[u8], start: usize) -> u64 {
    let mut bytes = [0u8; 8];
    bytes.copy_from_slice(&input[start..start + 8]);
    u64::from_be_bytes(bytes)
}

/// The exact v1 Python research payload commitment:
/// SHA384(DOMAIN || "payload\0" || BE64(len) || payload).
pub fn payload_commitment(payload: &[u8]) -> Result<[u8; 48], PqFrameError> {
    if payload.len() > TPQ1_MAX_PAYLOAD_BYTES {
        return Err(PqFrameError::PayloadSize);
    }
    let mut h = Sha384::new();
    h.update(DOMAIN);
    h.update(PAYLOAD_TAG);
    h.update((payload.len() as u64).to_be_bytes());
    h.update(payload);
    Ok(h.finalize().into())
}

/// Derive the reference identity from one exact ML-DSA-65 DER SPKI.
///
/// Restrict both the ASN.1 structure and OID before hashing: this rejects
/// alternative algorithms, optional parameters, non-minimal length encodings,
/// padding changes, truncation and appended bytes. The 1,952 key bytes are
/// NOT checked for cryptographic validity here; a real ML-DSA-65 verifier
/// remains mandatory before any trust or authorization can be established.
pub fn ml_dsa_65_key_id_from_spki(spki: &[u8]) -> Result<[u8; 32], PqFrameError> {
    if spki.len() != ML_DSA_65_SPKI_BYTES || !spki.starts_with(&ML_DSA_65_SPKI_PREFIX) {
        return Err(PqFrameError::PublicKeyDer);
    }
    let mut digest = Sha256::new();
    digest.update(PUBLIC_KEY_ID_DOMAIN);
    digest.update(spki);
    Ok(digest.finalize().into())
}

/// Reject malformed/unbound TPQ1 before invoking an independently implemented
/// ML-DSA-65 verifier. Success is NEVER signature verification. Keeping this
/// result unverified avoids a forged Boolean being converted to an authority.
pub fn preflight_unverified<'a>(
    bytes: &'a [u8],
    expected: &PqFrameExpectation<'_>,
) -> Result<UnverifiedPqFrame<'a>, PqFrameError> {
    if bytes.len() != TPQ1_SIGNED_BYTES {
        return Err(PqFrameError::FrameLength);
    }
    if &bytes[..4] != TPQ1_MAGIC || bytes[4] != TPQ1_VERSION || bytes[5] != TPQ1_ALGORITHM {
        return Err(PqFrameError::HeaderVersionAlgorithm);
    }
    if !(FIRST_PURPOSE..=LAST_PURPOSE).contains(&bytes[6])
        || bytes[6] != expected.purpose
        || bytes[7] != 0
    {
        return Err(PqFrameError::PurposeOrReserved);
    }
    if &bytes[8..40] != expected.network.as_slice()
        || &bytes[40..72] != expected.owner_context.as_slice()
        || &bytes[72..104] != expected.signer_key_id.as_slice()
    {
        return Err(PqFrameError::ContextOrIdentity);
    }
    let generation = u64_at(bytes, 104);
    let sequence = u64_at(bytes, 112);
    let expiry = u64_at(bytes, 120);
    if generation == 0
        || sequence == 0
        || expiry == 0
        || generation != expected.owner_generation
        || sequence != expected.operation_sequence
        || expiry != expected.expires_at
    {
        return Err(PqFrameError::LifetimeOrSequence);
    }
    if expected.now > expiry {
        return Err(PqFrameError::Expired);
    }
    if &bytes[128..176] != payload_commitment(expected.payload)?.as_slice() {
        return Err(PqFrameError::PayloadDigest);
    }
    let len = u16::from_be_bytes([bytes[176], bytes[177]]) as usize;
    if len != ML_DSA_65_SIGNATURE_BYTES {
        return Err(PqFrameError::SignatureLength);
    }
    Ok(UnverifiedPqFrame {
        statement: &bytes[..TPQ1_UNSIGNED_BYTES],
        signature: &bytes[TPQ1_UNSIGNED_BYTES + 2..],
    })
}

/// Preflight a TPQ1 frame against a caller-pinned actual DER SPKI,
/// rather than trusting a key ID copied from an untrusted frame.
///
/// The caller must independently authenticate expected (including the key ID)
/// and supply the nominated public key out-of-band. Neither this check nor the
/// simpler preflight_unverified verifies a signature, signer possession,
/// nonce consumption, or any Chain/Hepta authority.
pub fn preflight_unverified_with_spki<'a>(
    bytes: &'a [u8],
    expected: &PqFrameExpectation<'_>,
    pinned_spki: &[u8],
) -> Result<UnverifiedPqFrame<'a>, PqFrameError> {
    let actual_key_id = ml_dsa_65_key_id_from_spki(pinned_spki)?;
    if actual_key_id != expected.signer_key_id {
        return Err(PqFrameError::ContextOrIdentity);
    }
    preflight_unverified(bytes, expected)
}

#[cfg(test)]
mod tests {
    use super::*;

    fn case<'a>(payload: &'a [u8]) -> (Vec<u8>, PqFrameExpectation<'a>) {
        let e = PqFrameExpectation {
            purpose: 4,
            network: [1; 32],
            owner_context: [2; 32],
            signer_key_id: [3; 32],
            owner_generation: 7,
            operation_sequence: 19,
            expires_at: 4000,
            now: 3999,
            payload,
        };
        let mut v = vec![0xab; TPQ1_SIGNED_BYTES];
        v[..4].copy_from_slice(b"TPQ1");
        v[4] = 1;
        v[5] = 0x65;
        v[6] = e.purpose;
        v[7] = 0;
        v[8..40].copy_from_slice(&e.network);
        v[40..72].copy_from_slice(&e.owner_context);
        v[72..104].copy_from_slice(&e.signer_key_id);
        v[104..112].copy_from_slice(&e.owner_generation.to_be_bytes());
        v[112..120].copy_from_slice(&e.operation_sequence.to_be_bytes());
        v[120..128].copy_from_slice(&e.expires_at.to_be_bytes());
        v[128..176].copy_from_slice(&payload_commitment(payload).unwrap());
        v[176..178].copy_from_slice(&(ML_DSA_65_SIGNATURE_BYTES as u16).to_be_bytes());
        (v, e)
    }

    #[test]
    fn entire_statement_has_one_exact_canonical_preflight_binding() {
        let (v, e) = case(b"public Cell release manifest hash and consent");
        let checked = preflight_unverified(&v, &e).unwrap();
        assert_eq!(checked.unsigned_statement().len(), 176);
        assert_eq!(checked.unverified_signature().len(), 3309);
        for idx in 0..TPQ1_UNSIGNED_BYTES {
            let mut mutated = v.clone();
            mutated[idx] ^= 1;
            assert!(
                preflight_unverified(&mutated, &e).is_err(),
                "field byte {idx}"
            );
        }
    }

    #[test]
    fn zero_lifetimes_bad_length_and_classical_downgrade_reject() {
        let (v, e) = case(b"test");
        for end in [0, 175, 3486, 3488] {
            let mut bad = v.clone();
            bad.resize(end, 0);
            assert_eq!(
                preflight_unverified(&bad, &e).unwrap_err(),
                PqFrameError::FrameLength
            );
        }
        let mut bad = v.clone();
        bad[5] = 0x19; // Ed25519 is not a PQ signature algorithm.
        assert_eq!(
            preflight_unverified(&bad, &e).unwrap_err(),
            PqFrameError::HeaderVersionAlgorithm
        );
        for range in [104..112, 112..120, 120..128] {
            let mut bad = v.clone();
            bad[range].fill(0);
            assert_eq!(
                preflight_unverified(&bad, &e).unwrap_err(),
                PqFrameError::LifetimeOrSequence
            );
        }
    }

    #[test]
    fn stale_payload_and_signature_size_refuse() {
        let (v, mut e) = case(b"test");
        e.now = 4001;
        assert_eq!(
            preflight_unverified(&v, &e).unwrap_err(),
            PqFrameError::Expired
        );
        e.now = 3999;
        e.payload = b"other";
        assert_eq!(
            preflight_unverified(&v, &e).unwrap_err(),
            PqFrameError::PayloadDigest
        );
        e.payload = b"test";
        let mut bad = v.clone();
        bad[176] = 0;
        assert_eq!(
            preflight_unverified(&bad, &e).unwrap_err(),
            PqFrameError::SignatureLength
        );
    }

    #[test]
    fn unverified_signature_change_never_grants_authority() {
        let (v, e) = case(b"test");
        let mut fake = v.clone();
        fake[178] ^= 1;
        let a = preflight_unverified(&v, &e).unwrap();
        let b = preflight_unverified(&fake, &e).unwrap();
        assert_ne!(a.unverified_signature(), b.unverified_signature());
        // Both are merely unverified frames: no cryptographic success is offered.
    }

    #[test]
    fn sha384_payload_commitment_matches_independent_python_oracle() {
        let payload = b"public Cell release manifest hash and consent";
        let digest = payload_commitment(payload).unwrap();
        assert_eq!(
            hex::encode(digest),
            "2ceb9c0f29a40392386f5644c998adedaf5ae91f46b2faff977a66ad8153cbfe2bc62af16fd4125e7f516fc09a1382e4"
        );
    }

    fn spki_with_payload_byte(value: u8) -> Vec<u8> {
        let mut result = ML_DSA_65_SPKI_PREFIX.to_vec();
        result.extend_from_slice(&vec![value; ML_DSA_65_PUBLIC_KEY_BYTES]);
        result
    }

    #[test]
    fn pinned_mldsa_spki_identity_matches_independent_sha256_vector() {
        let spki = spki_with_payload_byte(0x42);
        assert_eq!(spki.len(), ML_DSA_65_SPKI_BYTES);
        let id = ml_dsa_65_key_id_from_spki(&spki).unwrap();
        assert_eq!(
            hex::encode(id),
            "afc295d8a2307875be792894d57b195f2f9513ede37ac98162232d2a09ca0989"
        );
        let (mut frame, mut expected) = case(b"pinned model");
        expected.signer_key_id = id;
        frame[72..104].copy_from_slice(&id);
        let unverified = preflight_unverified_with_spki(&frame, &expected, &spki).unwrap();
        assert_eq!(unverified.unsigned_statement().len(), TPQ1_UNSIGNED_BYTES);
        assert_eq!(
            unverified.unverified_signature().len(),
            ML_DSA_65_SIGNATURE_BYTES
        );

        // A second structurally well-formed key cannot substitute for the pinned key.
        let alternative = spki_with_payload_byte(0);
        assert_eq!(
            preflight_unverified_with_spki(&frame, &expected, &alternative).unwrap_err(),
            PqFrameError::ContextOrIdentity
        );
        frame[178..].fill(0);
        // Even an all-zero alleged signature passes syntax-only preflight:
        // cryptographic verification must still run before trust is granted.
        assert!(preflight_unverified_with_spki(&frame, &expected, &spki).is_ok());
    }

    #[test]
    fn malformed_spki_or_classical_key_never_binds_pq_identity() {
        let good = spki_with_payload_byte(0x42);
        let mut variants = vec![
            good[..good.len() - 1].to_vec(),
            [good.as_slice(), &[0]].concat(),
            [good.as_slice(), &[0x30, 0]].concat(),
        ];
        for index in [0usize, 3, 15, 20, 21] {
            let mut changed = good.clone();
            changed[index] ^= 1;
            variants.push(changed);
        }
        // Ed25519's SPKI shape and OID differ fundamentally from ML-DSA.
        variants.push(vec![0x30, 0x2a, 0x30, 5, 6, 3, 0x2b, 0x65, 0x70]);
        for der in variants {
            assert_eq!(
                ml_dsa_65_key_id_from_spki(&der).unwrap_err(),
                PqFrameError::PublicKeyDer
            );
        }
    }

    #[test]
    fn old_devnet_transaction_size_cannot_hold_pq_signature() {
        const {
            assert!(TPQ1_SIGNED_BYTES > 2048);
            assert!(ML_DSA_65_SIGNATURE_BYTES > 2048);
        }
    }
}

12fac3738fa388a633ff1634195632b04a20ff26 blob 10447
//! Candidate whole-payload model commitments, in the separate TCM2 namespace.
//!
//! TCM2 retains the complete V1 family and dependency-locator metadata, but
//! commits the actual complete payload through CCH1/SHA-512. The five old
//! dependency locators are aliases only: neither their inclusion nor the new
//! outer commitment upgrades the referenced dependencies. Each dependency still
//! needs its own full-content verification and independently trusted authority.
//! TCC2 (`CellContentClosureV2`) adds actual complete commitments/readback for
//! all five named dependency slots; a TCM2 readback alone does not cover them.
//!
//! The manifest is itself observed under ModelManifest, separately from the
//! payload's ModelPayload domain. Readback requires a caller-pinned *complete*
//! manifest claim, never a short ID received alongside the content. No returned
//! value authorizes installation, CURRENT, FinalUse, or production activation.
//! This module does not change the TCM1 chunk/transport/cache formats, implement
//! a Merkle tree, authenticate provenance, or freeze a mutable source file.

use std::{fmt, io::Read};

use trnm_protocol::content_commitment::{
    observe_bytes, observe_reader, ContentClaimV1, ContentCommitmentError, ContentContextV1,
    ContentKind, ContentReadBudget, ObservedContentV1, CONTENT_CLAIM_BYTES,
};

use super::{CellContextV1, CellErrorV1, MAX_CELL_BYTES};

mod cached;
mod closure;
pub use closure::{
    CellContentClosureReadbackV2, CellContentClosureV2, CellContentDependencyV2,
    CELL_CONTENT_DEPENDENCY_COUNT_V2, MAX_CELL_CONTENT_CLOSURE_BYTES_V2,
};

const MAGIC: &[u8; 4] = b"TCM2";
const LEGACY_ALIAS_COUNT: usize = 5;
const LEGACY_ALIAS_BYTES: usize = LEGACY_ALIAS_COUNT * 32;
const FIXED_BYTES: usize = 4 + 1 + LEGACY_ALIAS_BYTES + CONTENT_CLAIM_BYTES;
pub const MAX_CELL_CONTENT_MANIFEST_BYTES_V2: usize = FIXED_BYTES + 64;

/// A candidate content-format error, with read failures preserved as causes.
#[derive(Debug)]
pub enum CellContentErrorV2 {
    Invalid(&'static str),
    Metadata(CellErrorV1),
    Commitment(ContentCommitmentError),
}

impl fmt::Display for CellContentErrorV2 {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        match self {
            Self::Invalid(reason) => write!(f, "cell content v2 rejected: {reason}"),
            Self::Metadata(error) => write!(f, "cell content v2 metadata: {error}"),
            Self::Commitment(error) => write!(f, "cell content v2: {error}"),
        }
    }
}

impl std::error::Error for CellContentErrorV2 {
    fn source(&self) -> Option<&(dyn std::error::Error + 'static)> {
        match self {
            Self::Invalid(_) => None,
            Self::Metadata(error) => Some(error),
            Self::Commitment(error) => Some(error),
        }
    }
}

impl From<ContentCommitmentError> for CellContentErrorV2 {
    fn from(error: ContentCommitmentError) -> Self {
        Self::Commitment(error)
    }
}

/// Canonical TCM2 metadata and a *claimed* complete payload commitment.
///
/// Decoding establishes only a well-formed declaration. The payload claim is
/// checked against a fresh, complete read by `verify_payload_reader`. To create
/// a declaration locally, `from_observed_payload` requires an actual complete
/// observation; there is no constructor from a legacy digest.
#[derive(Clone, Debug, Eq, PartialEq)]
pub struct CellContentManifestV2 {
    legacy_metadata: CellContextV1,
    payload: ContentClaimV1,
}

impl CellContentManifestV2 {
    pub fn from_observed_payload(
        legacy_metadata: CellContextV1,
        payload: &ObservedContentV1,
    ) -> Result<Self, CellContentErrorV2> {
        let value = Self {
            legacy_metadata,
            payload: payload.claim().clone(),
        };
        value.validate()?;
        Ok(value)
    }

    /// The original family and five locator aliases, not dependency authority.
    pub fn legacy_metadata(&self) -> &CellContextV1 {
        &self.legacy_metadata
    }

    pub fn payload_claim(&self) -> &ContentClaimV1 {
        &self.payload
    }

    pub fn validate(&self) -> Result<(), CellContentErrorV2> {
        self.legacy_metadata
            .validate()
            .map_err(CellContentErrorV2::Metadata)?;
        require(
            self.payload.context().kind() == ContentKind::ModelPayload,
            "payload purpose",
        )?;
        require(
            (1..=MAX_CELL_BYTES).contains(&self.payload.content_len()),
            "payload size",
        )
    }

    /// Exact wire: TCM2, U8 family length, ASCII family, five 32-byte legacy
    /// aliases (base/parent/tokenizer/layout/runtime), one 213-byte CCH1 payload
    /// claim. Length and all context fields live inside that full claim.
    pub fn encode(&self) -> Vec<u8> {
        let mut out = Vec::with_capacity(FIXED_BYTES + self.legacy_metadata.family.len());
        out.extend_from_slice(MAGIC);
        out.push(self.legacy_metadata.family.len() as u8);
        out.extend_from_slice(self.legacy_metadata.family.as_bytes());
        for alias in [
            self.legacy_metadata.base,
            self.legacy_metadata.parent,
            self.legacy_metadata.tokenizer,
            self.legacy_metadata.layout,
            self.legacy_metadata.runtime,
        ] {
            out.extend_from_slice(&alias);
        }
        out.extend_from_slice(&self.payload.encode());
        out
    }

    pub fn decode(bytes: &[u8]) -> Result<Self, CellContentErrorV2> {
        require(
            (FIXED_BYTES + 1..=MAX_CELL_CONTENT_MANIFEST_BYTES_V2).contains(&bytes.len()),
            "manifest length",
        )?;
        require(&bytes[..4] == MAGIC, "manifest version")?;
        let family_len = usize::from(bytes[4]);
        require((1..=64).contains(&family_len), "family length")?;
        require(
            bytes.len() == FIXED_BYTES + family_len,
            "manifest exact coverage",
        )?;
        let family_end = 5 + family_len;
        let family = std::str::from_utf8(&bytes[5..family_end])
            .map_err(|_| CellContentErrorV2::Invalid("family encoding"))?
            .to_owned();
        let mut aliases = [[0u8; 32]; LEGACY_ALIAS_COUNT];
        for (index, alias) in aliases.iter_mut().enumerate() {
            let start = family_end + index * 32;
            alias.copy_from_slice(&bytes[start..start + 32]);
        }
        let [base, parent, tokenizer, layout, runtime] = aliases;
        let payload = ContentClaimV1::decode(&bytes[family_end + LEGACY_ALIAS_BYTES..])?;
        let value = Self {
            legacy_metadata: CellContextV1 {
                family,
                base,
                parent,
                tokenizer,
                layout,
                runtime,
            },
            payload,
        };
        value.validate()?;
        require(value.encode() == bytes, "canonical manifest encoding")?;
        Ok(value)
    }

    /// Observe these complete canonical manifest bytes under the independently
    /// selected manifest context. This does not re-read the declared payload.
    pub fn observe_manifest(
        &self,
        context: &ContentContextV1,
        budget: &mut ContentReadBudget,
    ) -> Result<ObservedContentV1, CellContentErrorV2> {
        self.validate()?;
        self.check_manifest_context(context)?;
        Ok(observe_bytes(context, budget, &self.encode())?)
    }

    /// Verify an independently pinned complete manifest claim, then read and
    /// verify every payload byte plus EOF. The pin must come from the caller's
    /// trusted owner; a claim carried by the same untrusted input is no pin.
    ///
    /// Short data, any I/O error, an extra byte, a different payload, or any
    /// profile/instance/generation mismatch refuses the entire readback. The
    /// common budget charges both reads, including their EOF probes, and is not
    /// refunded on failure. The owner supplies cancellation and time limits.
    pub fn verify_payload_reader<R: Read + ?Sized>(
        &self,
        expected_manifest: &ContentClaimV1,
        budget: &mut ContentReadBudget,
        reader: &mut R,
    ) -> Result<CellContentReadbackV2, CellContentErrorV2> {
        let manifest = self.observe_manifest(expected_manifest.context(), budget)?;
        expected_manifest.verify(&manifest)?;
        let payload = observe_reader(
            self.payload.context(),
            budget,
            self.payload.content_len(),
            reader,
        )?;
        self.payload.verify(&payload)?;
        Ok(CellContentReadbackV2 { manifest, payload })
    }

    pub fn verify_payload_bytes(
        &self,
        expected_manifest: &ContentClaimV1,
        budget: &mut ContentReadBudget,
        bytes: &[u8],
    ) -> Result<CellContentReadbackV2, CellContentErrorV2> {
        self.verify_payload_reader(expected_manifest, budget, &mut std::io::Cursor::new(bytes))
    }

    fn check_manifest_context(&self, context: &ContentContextV1) -> Result<(), CellContentErrorV2> {
        require(
            context.kind() == ContentKind::ModelManifest,
            "manifest purpose",
        )?;
        let payload_context = self.payload.context();
        require(
            context.profile_id() == payload_context.profile_id()
                && context.instance() == payload_context.instance()
                && context.generation() == payload_context.generation(),
            "manifest/payload context",
        )
    }
}

/// Two complete reads matched the pinned manifest and its payload claim. This
/// value has no deserializer or public constructor and is not an authorization
/// token, fresh custody attestation, or evidence that the payload is executable.
#[derive(Debug)]
pub struct CellContentReadbackV2 {
    manifest: ObservedContentV1,
    payload: ObservedContentV1,
}

impl CellContentReadbackV2 {
    pub fn manifest_observation(&self) -> &ObservedContentV1 {
        &self.manifest
    }

    pub fn payload_observation(&self) -> &ObservedContentV1 {
        &self.payload
    }

    pub fn manifest_claim(&self) -> &ContentClaimV1 {
        self.manifest.claim()
    }

    pub fn payload_claim(&self) -> &ContentClaimV1 {
        self.payload.claim()
    }
}

fn require(condition: bool, reason: &'static str) -> Result<(), CellContentErrorV2> {
    if condition {
        Ok(())
    } else {
        Err(CellContentErrorV2::Invalid(reason))
    }
}

#[cfg(test)]
mod tests;

