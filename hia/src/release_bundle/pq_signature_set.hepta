block visit(vi:readbuf,vw:mutbuf,vc:u64,used:u64,done:u64)
  complete:bool = compare.eq(done,vc)
  branch complete finalize(vw) hash_key(vi,vw,vc,used,done)
block hash_key(ki:readbuf,kw:mutbuf,kc:u64,ku:u64,kd:u64)
  index:u64 = call(ki,kc,ku) {"function":"ps_select"}
  row:u64 = call(index) {"function":"ps_row"}
  key_width:u64 = const() {"value":32}
