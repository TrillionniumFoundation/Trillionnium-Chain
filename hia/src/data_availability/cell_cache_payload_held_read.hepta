  address:u64 = int.add.wrap(ob,of)
  next_pos:u64 = int.add.wrap(op,oc)
  pref:u64 = call(oo,next_pos,oc) {"function":"ch_output"}
  copied:u64 = call(oi,address,oo,oh,oc) {"function":"cp_copy"}
  jump success()
block empty(eo2:mutbuf,ep2:u64)
  full:usize = buffer.len(eo2)
