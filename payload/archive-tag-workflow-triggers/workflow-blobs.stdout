name: Cell learning business readback controls
on:
  push:
    branches: [fix/chain-learning-business-closure-20261109-1a404f66]
  pull_request:
    paths:
      - .github/workflows/cell-learning-business-readback.yml
      - scripts/ci/run_cell_learning_business_readback.py
      - scripts/ci/verify_ci_source.py
      - scripts/ci/ci_job.sh
      - scripts/ci/check_ci_contract.py
      - scripts/ci/test_ci_contract.py
      - scripts/cell_adoption_readback.py
      - scripts/cell_learning_iteration_join.py
      - scripts/cell_learning_completion_join.py
      - scripts/cell_learning_scope_join.py
      - scripts/cell_learning_business_economics.py
      - scripts/cell_learning_business_join.py
      - scripts/test_cell_adoption_readback.py
      - scripts/test_cell_learning_iteration_join.py
      - scripts/test_cell_learning_completion_join.py
      - scripts/test_cell_learning_business_economics.py
      - scripts/test_cell_learning_business_join.py
      - scripts/test_cell_learning_training_no_update_join.py
      - evidence/heplcp03-interop-20261111/**
      - evidence/next-use-provenance-20261110/**
      - evidence/cell-adoption-20261108/native-readbacks/**
      - evidence/cell-learning-iteration-20261108/native-readbacks/**
      - evidence/cell-learning-completion-20261108/native-readbacks/**
      - evidence/smollm-cell-replica-research-v1/actual/research-result.json
      - evidence/hepta-real-native-adoption-20261108/chain-reader/**
      - evidence/cell-learning-business-readback-20261109/**
permissions:
  contents: read
concurrency:
  group: cell-learning-business-readback-${{ github.ref }}
  cancel-in-progress: false
env:
  PYTHONDONTWRITEBYTECODE: "1"
  TRNM_EXPECTED_SOURCE_SHA: ${{ github.event_name == 'pull_request' && github.event.pull_request.head.sha || github.sha }}
jobs:
  readback-controls:
    name: Cell learning business readback (head, unqualified)
    runs-on: ubuntu-24.04
    timeout-minutes: 30
    steps:
      - name: Checkout exact candidate
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ env.TRNM_EXPECTED_SOURCE_SHA }}
          fetch-depth: 0
          persist-credentials: false
      - name: Verify full tracked source before execution
        run: python3 scripts/ci/verify_ci_source.py --kind head --expected-head "$TRNM_EXPECTED_SOURCE_SHA" --output "$RUNNER_TEMP/cell-learning-business-readback/source-before.json"
      - name: Execute seven control suites and two original-material readbacks
        run: python3 scripts/ci/run_cell_learning_business_readback.py --expected-head "$TRNM_EXPECTED_SOURCE_SHA" --output "$RUNNER_TEMP/cell-learning-business-readback/commands"
      - name: Verify full tracked source after execution
        if: always()
        run: python3 scripts/ci/verify_ci_source.py --kind head --expected-head "$TRNM_EXPECTED_SOURCE_SHA" --output "$RUNNER_TEMP/cell-learning-business-readback/source-after.json"
      - name: Retain all outputs and failures without granting qualification
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: cell-learning-business-readback-${{ env.TRNM_EXPECTED_SOURCE_SHA }}-${{ github.run_id }}-${{ github.run_attempt }}
          path: ${{ runner.temp }}/cell-learning-business-readback/
          if-no-files-found: error
          retention-days: 30

a75e1609ff0a07e8dea5b83990e22d08035f0769 blob 3133
name: HEPLCP04 structural readback
on:
  pull_request:
    paths:
      - .github/workflows/cell-learning-local-decision-readback.yml
      - scripts/cell_learning_local_decision_join.py
      - scripts/test_cell_learning_local_decision_join.py
      - scripts/cell_adoption_readback.py
      - scripts/cell_learning_iteration_join.py
      - scripts/cell_learning_scope_join.py
      - scripts/cell_learning_completion_join.py
      - scripts/test_cell_learning_iteration_join.py
      - scripts/test_cell_learning_scope_join.py
      - scripts/ci/verify_ci_source.py
      - scripts/project-preflight.sh
      - scripts/ci/project_boundary.py
      - PROJECT_BOUNDARY.json
      - PROJECT_ID
      - evidence/heplcp04-interop-20261111/**
permissions:
  contents: read
jobs:
  structural-readback:
    runs-on: ubuntu-24.04
    timeout-minutes: 10
    strategy:
      fail-fast: false
      matrix:
        lane: [head, prospective-merge]
    env:
      PYTHONDONTWRITEBYTECODE: "1"
      SOURCE: ${{ github.event.pull_request.head.sha }}
      BASE: ${{ github.event.pull_request.base.sha }}
      TESTED: ${{ matrix.lane == 'head' && github.event.pull_request.head.sha || github.sha }}
      LANE: ${{ matrix.lane }}
    steps:
      - uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd
        with:
          ref: ${{ env.TESTED }}
          fetch-depth: 0
          persist-credentials: false
      - name: Observe the actual source
        run: |
          set -euo pipefail
          args=(--kind "$LANE" --expected-head "$SOURCE")
          if test "$LANE" = prospective-merge; then
            args+=(--expected-base "$BASE" --expected-merge "$TESTED")
          fi
          python3 scripts/ci/verify_ci_source.py "${args[@]}" --output "$RUNNER_TEMP/heplcp04-source-before.json"
          cat "$RUNNER_TEMP/heplcp04-source-before.json"
          bash scripts/project-preflight.sh --audit
      - name: Replay retained native vectors and structural negative controls
        run: |
          set -euo pipefail
          python3 -B scripts/test_cell_learning_local_decision_join.py -v 2>&1 | tee "$RUNNER_TEMP/heplcp04-tests.log"
      - name: Recheck the actual source
        if: always()
        run: |
          set -euo pipefail
          args=(--kind "$LANE" --expected-head "$SOURCE")
          if test "$LANE" = prospective-merge; then
            args+=(--expected-base "$BASE" --expected-merge "$TESTED")
          fi
          python3 scripts/ci/verify_ci_source.py "${args[@]}" --output "$RUNNER_TEMP/heplcp04-source-after.json"
          cat "$RUNNER_TEMP/heplcp04-source-after.json"
          git diff --exit-code
      - name: Retain structural replay logs
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: heplcp04-structural-${{ matrix.lane }}-${{ github.run_id }}
          path: |
            ${{ runner.temp }}/heplcp04-source-before.json
            ${{ runner.temp }}/heplcp04-source-after.json
            ${{ runner.temp }}/heplcp04-tests.log
          if-no-files-found: error
          retention-days: 30

