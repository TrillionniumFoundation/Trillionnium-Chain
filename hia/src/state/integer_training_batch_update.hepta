  strict_m:bool = compare.lt(mn,md)
  max_md:u64 = const() {"value":65536}
  md_ok:bool = compare.le(md,max_md)
  min_clip:bool = compare.le(p_one,clip)
  max_clip:u64 = const() {"value":1099511627776}
  clip_ok:bool = compare.le(clip,max_clip)
  loss_per_row:u64 = const() {"value":54476154403160832}
  loss_max:u64 = int.mul.wrap(pc,loss_per_row)
  loss_ok:bool = compare.le(pl,loss_max)
  policy_check0:bool = bool.and(lrn_ok,min_lrd)
  policy_check1:bool = bool.and(policy_check0,lrd_ok)
  policy_check2:bool = bool.and(policy_check1,strict_m)
  policy_check3:bool = bool.and(policy_check2,md_ok)
  policy_check4:bool = bool.and(policy_check3,min_clip)
  policy_check5:bool = bool.and(policy_check4,clip_ok)
  policy_check6:bool = bool.and(policy_check5,loss_ok)
  gradient_per_row:u64 = const() {"value":2156068608}
  gradient_max:u64 = int.mul.wrap(pc,gradient_per_row)
  first_coord:usize = const() {"value":80}
