  max14:bool = compare.le(actual14,max)
  check14:bool = bool.and(min14,max14)
  key15:u64 = const() {"value":15}
  actual15:u64 = call(w,key15) {"function":"tac_word"}
  min15:bool = compare.le(one,actual15)
  max15:bool = compare.le(actual15,max)
  check15:bool = bool.and(min15,max15)
  key16:u64 = const() {"value":16}
  actual16:u64 = call(w,key16) {"function":"tac_word"}
  min16:bool = compare.le(one,actual16)
  max16:bool = compare.le(actual16,max)
  check16:bool = bool.and(min16,max16)
  key17:u64 = const() {"value":17}
  actual17:u64 = call(w,key17) {"function":"tac_word"}
  min17:bool = compare.le(one,actual17)
  max17:bool = compare.le(actual17,max)
  check17:bool = bool.and(min17,max17)
  key18:u64 = const() {"value":18}
  actual18:u64 = call(w,key18) {"function":"tac_word"}
  min18:bool = compare.le(one,actual18)
  max18:bool = compare.le(actual18,max)
  check18:bool = bool.and(min18,max18)
  joined0:bool = bool.and(check13,check27)
  joined1:bool = bool.and(joined0,check19)
  joined2:bool = bool.and(joined1,check20)
  joined3:bool = bool.and(joined2,check21)
  joined4:bool = bool.and(joined3,check22)
  joined5:bool = bool.and(joined4,check23)
  joined6:bool = bool.and(joined5,check24)
  joined7:bool = bool.and(joined6,check25)
  joined8:bool = bool.and(joined7,check26)
  joined9:bool = bool.and(joined8,check14)
  joined10:bool = bool.and(joined9,check15)
  joined11:bool = bool.and(joined10,check16)
  joined12:bool = bool.and(joined11,check17)
  joined13:bool = bool.and(joined12,check18)
  ret(joined13)
end

fn tac_digest(w:mutbuf,i:u64) -> (bool) effects(read,write,trap) entry(entry)
block entry(w:mutbuf,i:u64)
  p:u64 = call(w,i) {"function":"tac_at"}
  n:u64 = call(w,p) {"function":"tr_get"}
  sixty_four:u64 = const() {"value":64}
  exact:bool = compare.eq(n,sixty_four)
  eight:u64 = const() {"value":8}
  start:u64 = int.add.wrap(p,eight)
  branch exact decode(w,start,n) no()
block decode(dw:mutbuf,dp:u64,dn:u64)
  ok:bool = call(dw,dp,dn) {"function":"tac_hex"}
  ret(ok)
block no()
  result:bool = const() {"value":false}
  ret(result)
end

fn tac_match_pin(r:readbuf,w:mutbuf,p:u64,q:u64) -> (bool) effects(read,write,trap) entry(entry)
block entry(r:readbuf,w:mutbuf,p:u64,q:u64)
  count:u64 = const() {"value":4}
  diff:u64 = const() {"value":0}
  jump loop(r,w,p,q,count,diff)
block loop(lr:readbuf,lw:mutbuf,lp:u64,lq:u64,lc:u64,ld:u64)
  a:u64 = call(lr,lp) {"function":"tr_read"}
  b:u64 = call(lw,lq) {"function":"tr_get"}
  mismatch:u64 = bit.xor(a,b)
  accumulated:u64 = bit.or(ld,mismatch)
  stride:u64 = const() {"value":8}
  one:u64 = const() {"value":1}
  zero:u64 = const() {"value":0}
  np:u64 = int.add.wrap(lp,stride)
  nq:u64 = int.add.wrap(lq,stride)
  rem:u64 = int.sub.wrap(lc,one)
  done:bool = compare.eq(rem,zero)
  branch done exact(accumulated) loop(lr,lw,np,nq,rem,accumulated)
block exact(value:u64)
  no_diff:u64 = const() {"value":0}
  eq:bool = compare.eq(value,no_diff)
  ret(eq)
end

fn tac_hex(w:mutbuf,p:u64,n:u64) -> (bool) effects(read,write,trap) entry(entry)
block entry(w:mutbuf,p:u64,n:u64)
  past:u64 = int.add.wrap(p,n)
  jump loop(w,p,past,p)
block loop(lw:mutbuf,lp:u64,le:u64,ld:u64)
  done:bool = compare.eq(lp,le)
  branch done yes() pair(lw,lp,le,ld)
block pair(pw:mutbuf,pp:u64,pe:u64,pd:u64)
  one:u64 = const() {"value":1}
  later:u64 = int.add.wrap(pp,one)
  ip:usize = int.cast(pp) {"mode":"wrap"}
  iq:usize = int.cast(later) {"mode":"wrap"}
  p0:u8 = buffer.load(pw,ip)
  p1:u8 = buffer.load(pw,iq)
  v0:u64 = call(p0) {"function":"tac_nibble"}
  v1:u64 = call(p1) {"function":"tac_nibble"}
  top:u64 = const() {"value":16}
  a:bool = compare.lt(v0,top)
  b:bool = compare.lt(v1,top)
  good:bool = bool.and(a,b)
  branch good emit(pw,pp,pe,pd,v0,v1) no()
block emit(ew:mutbuf,ep:u64,ee:u64,ed:u64,ea:u64,eb:u64)
  shift:u64 = const() {"value":4}
  hi:u64 = int.shl.checked(ea,shift)
  packed:u64 = bit.or(hi,eb)
  byte:u8 = int.cast(packed) {"mode":"wrap"}
  pos:usize = int.cast(ed) {"mode":"wrap"}
  _ = buffer.store(ew,pos,byte)
  step:u64 = const() {"value":2}
  inc:u64 = const() {"value":1}
  next_p:u64 = int.add.wrap(ep,step)
  next_d:u64 = int.add.wrap(ed,inc)
  jump loop(ew,next_p,ee,next_d)
block yes()
  ok:bool = const() {"value":true}
  ret(ok)
block no()
  refuse:bool = const() {"value":false}
  ret(refuse)
end

fn tac_nibble(b:u8) -> (u64) effects(trap) entry(entry)
block entry(b:u8)
  x:u64 = int.cast(b) {"mode":"wrap"}
  d0:u64 = const() {"value":48}
  d9:u64 = const() {"value":57}
  a:u64 = const() {"value":97}
  f:u64 = const() {"value":102}
  dl:bool = compare.le(d0,x)
  dh:bool = compare.le(x,d9)
  al:bool = compare.le(a,x)
  ah:bool = compare.le(x,f)
  digit:bool = bool.and(dl,dh)
  letter:bool = bool.and(al,ah)
  numeric:u64 = int.sub.wrap(x,d0)
  delta:u64 = const() {"value":87}
  alpha:u64 = int.sub.wrap(x,delta)
  invalid:u64 = const() {"value":16}
  fallback:u64 = select(letter,alpha,invalid)
  value:u64 = select(digit,numeric,fallback)
  ret(value)
end
