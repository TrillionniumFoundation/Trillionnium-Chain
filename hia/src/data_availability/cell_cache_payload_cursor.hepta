hia-asm.v1 hepta.hia.program.v8 trnm_cell_cache_payload_cursor_v1
fn f0(i:readbuf,o:mutbuf,w:mutbuf) -> (u32) effects(read,write,trap) entry(entry)
block entry(i:readbuf,o:mutbuf,w:mutbuf)
