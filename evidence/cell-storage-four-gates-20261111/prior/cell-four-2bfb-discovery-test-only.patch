+#[test]
+fn authenticated_v3_time_sharing_never_refunds_exhausted_connection_budget() {
+    let now = epoch_now();
+    let tmp = tempfile::tempdir().unwrap();
+    let (_, provider_pin) = key_and_pin(71);
+    let request = request([20; 32], now);
+    let withholding = vec![WithholdingSource::start(72)];
+    let honest = SignedSource::start(75, vec![0], Duration::ZERO, 1);
+    let options = options(request, &withholding, Some(&honest), &[]);
+    let directory = CellProviderDirectoryV3::open(
+        &tmp.path().join("directory"),
+        context(),
+        CellPqKeyPinsV2::new(vec![provider_pin]).unwrap(),
+        options.source_pins().unwrap(),
+    )
+    .unwrap();
+    let store = CellStoreV1::open(&tmp.path().join("consumer"), cache()).unwrap();
+    let output = tmp.path().join("missing");
+    let limits = CellPeerLimitsV1 {
+        max_connections: 1,
+        ..limits()
+    };
+    let original_deadline = Instant::now() + Duration::from_secs(2);
+    let failure = fetch_authenticated_discovered_cell_to_file_pq_observed(
+        &store,
+        &directory,
+        &options,
+        limits,
+        original_deadline,
+        &output,
+    )
+    .unwrap_err();
+    assert!(Instant::now() < original_deadline);
+    assert_eq!(failure.discovery.connection_attempts, 1);
+    assert_eq!(failure.discovery.bootstrap_validation_attempts, 1);
+    assert_eq!(failure.discovery.record_validation_attempts, 0);
+    assert_eq!(failure.total_connection_attempts, 1);
+    assert_eq!(failure.total_received_response_bytes, Some(0));
+    assert!(!output.exists());
+    assert_eq!(withholding.into_iter().next().unwrap().finish().len(), 1);
+    assert!(honest.finish().is_empty());
+}
