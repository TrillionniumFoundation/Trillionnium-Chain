fn rif_contract(r:readbuf,rank:u64,up:u64,down:u64) -> (i64) effects(read,trap) entry(entry)
block entry(r:readbuf,rank:u64,up:u64,down:u64)
  zero:i64 = const() {"value":0}
  jump term(r,rank,up,down,zero)
block term(r1:readbuf,left1:u64,up1:u64,down1:u64,sum1:i64)
  b1:i64 = call(r1,up1) {"function":"rio_i32"}
