  jump request(sv_m,sv_w,sv_row,sv_len)
block request(req_m:mutbuf,req_w:mutbuf,req_row:u64,req_len:u64)
  req_profile_at:u64 = const() {"value":349024}
  req_profile:u64 = call(req_m,req_profile_at) {"function":"cp_get"}
  req_variable:bool = call(req_profile) {"function":"hfs_variable"}
  branch req_variable variable_request(req_m,req_w,req_row,req_len) fixed_request(req_m,req_w,req_row,req_len)
block variable_request(vq_m:mutbuf,vq_w:mutbuf,vq_row:u64,vq_len:u64)
  vq_status:u32 = call(vq_m,vq_w,vq_row,vq_len) {"function":"hfv_request"}
  ret(vq_status)
block fixed_request(qm:mutbuf,qw:mutbuf,qrow:u64,qlen:u64)
  trust_at:u64 = const() {"value":8224}
  qbase:u64 = const() {"value":360000}
  qlength_at:u64 = const() {"value":349016}
  qhead:u64 = const() {"value":1053}
  qlength:u64 = int.add.wrap(qhead,qlen)
  qlensave:u64 = call(qm,qlength_at,qlength) {"function":"cp_put"}
  qrowseq:u64 = call(qm,qbase,qrow) {"function":"cp_put"}
  payload:u64 = const() {"value":360008}
  trust_n:u64 = const() {"value":882}
  first_end:u64 = call(qm,trust_at,payload,trust_n) {"function":"cp_wcopy"}
  ex_at:usize = const() {"value":140000}
  ex_out:usize = int.cast(first_end) {"mode":"wrap"}
  ex_n:u64 = const() {"value":163}
  x:u64 = call(qw,qm,ex_at,ex_out,ex_n) {"function":"sscid_copy"}
  cmd_at:usize = const() {"value":73728}
  cmd_out:usize = const() {"value":361053}
  y:u64 = call(qw,qm,cmd_at,cmd_out,qlen) {"function":"sscid_copy"}
  awaiting_loc:u64 = const() {"value":349000}
  awaiting:u64 = const() {"value":1}
  marked:u64 = call(qm,awaiting_loc,awaiting) {"function":"cp_put"}
  engine_step:u32 = const() {"value":199}
  ret(engine_step)
block verify(vr0:readbuf,vm0:mutbuf,va0:u64)
  vh_at:u64 = const() {"value":349032}
  vh_old:u64 = call(vm0,vh_at) {"function":"cp_get"}
  vh_one:u64 = const() {"value":1}
  vh_count:u64 = int.add.wrap(vh_old,vh_one)
  vh_first:bool = compare.eq(vh_count,vh_one)
  vh_first_width:usize = const() {"value":1268}
  vh_pair_width:usize = const() {"value":2217}
  vh_same_width:usize = const() {"value":2244}
  vh_mode_at:u64 = const() {"value":349024}
  vh_mode:u64 = call(vm0,vh_mode_at) {"function":"cp_get"}
  vh_same:bool = call(vh_mode) {"function":"hfs_same_profile"}
  vh_second_width:usize = select(vh_same,vh_same_width,vh_pair_width)
  vh_two:u64 = const() {"value":2}
  vh_second:bool = compare.eq(vh_count,vh_two)
  vh_third_width:usize = const() {"value":3257}
  vh_three:u64 = const() {"value":3}
  vh_is_third:bool = compare.eq(vh_count,vh_three)
  vh_fourth_width:usize = const() {"value":4942}
  vh_late_width:usize = select(vh_is_third,vh_third_width,vh_fourth_width)
  vh_later_width:usize = select(vh_second,vh_second_width,vh_late_width)
  vh_width:usize = select(vh_first,vh_first_width,vh_later_width)
  vh_limit_at:u64 = const() {"value":349024}
  vh_limit:u64 = call(vm0,vh_limit_at) {"function":"cp_get"}
  vh_extra:usize = const() {"value":32}
  vh_fourcase:bool = call(vh_limit) {"function":"hfs_settled"}
  vh_linear:bool = call(vh_limit) {"function":"hfs_linear_profile"}
  vh_old_profile:bool = bool.or(vh_fourcase,vh_same)
  vh_profile:bool = bool.or(vh_old_profile,vh_linear)
  vh_plus:usize = int.add.wrap(vh_width,vh_extra)
  vh_fixed:usize = select(vh_profile,vh_plus,vh_width)
  vh_variable:bool = call(vh_mode) {"function":"hfs_variable"}
  vh_state_at:u64 = const() {"value":349008}
  vh_state:u64 = call(vm0,vh_state_at) {"function":"cp_get"}
  vh_head:u64 = const() {"value":72}
  vh_total:u64 = int.add.wrap(vh_state,vh_head)
  vh_raw_dynamic:usize = int.cast(vh_total) {"mode":"wrap"}
  vh_dynamic_plus:usize = int.add.wrap(vh_raw_dynamic,vh_extra)
  vh_dynamic:usize = select(vh_profile,vh_dynamic_plus,vh_raw_dynamic)
  vh_need:usize = select(vh_variable,vh_dynamic,vh_fixed)
  vh_actual:usize = buffer.len(vr0)
  vh_exact:bool = compare.eq(vh_actual,vh_need)
  vh_var_pair:u64 = const() {"value":7}
  vh_normal_pair:bool = compare.eq(vh_mode,vh_var_pair)
  vh_measured_same:bool = bool.and(vh_variable,vh_same)
  vh_pair:bool = bool.or(vh_normal_pair,vh_measured_same)
  vh_var_settle:bool = bool.and(vh_variable,vh_fourcase)
  vh_limit4:u64 = const() {"value":4}
  vh_not_last:bool = compare.lt(vh_count,vh_limit4)
  vh_before_settle:bool = bool.and(vh_var_settle,vh_not_last)
  vh_before_pair:bool = bool.and(vh_pair,vh_first)
  vh_expected:u64 = call(vm0,vh_limit) {"function":"hfs_actual_limit"}
  vh_more:bool = compare.lt(vh_count,vh_expected)
  vh_before_linear:bool = bool.and(vh_linear,vh_more)
  vh_old_interm:bool = bool.or(vh_before_pair,vh_before_settle)
  vh_intermediate:bool = bool.or(vh_old_interm,vh_before_linear)
  vh_min_raw:usize = const() {"value":183}
  vh_max_raw:usize = const() {"value":16456}
  vh_min_plus:usize = int.add.wrap(vh_min_raw,vh_extra)
  vh_max_plus:usize = int.add.wrap(vh_max_raw,vh_extra)
  vh_min:usize = select(vh_profile,vh_min_plus,vh_min_raw)
  vh_max:usize = select(vh_profile,vh_max_plus,vh_max_raw)
  vh_above:bool = compare.ge(vh_actual,vh_min)
  vh_below:bool = compare.le(vh_actual,vh_max)
  vh_bounded:bool = bool.and(vh_above,vh_below)
  vh_shaped:bool = select(vh_intermediate,vh_bounded,vh_exact)
  vh_actual_core:usize = int.sub.wrap(vh_actual,vh_extra)
  vh_new_parent:bool = bool.or(vh_var_settle,vh_measured_same)
  vh_dynamic_parent:bool = bool.or(vh_new_parent,vh_linear)
  vh_parent_off:usize = select(vh_dynamic_parent,vh_actual_core,vh_width)
  branch vh_shaped replay_shape(vr0,vm0,va0,vh_count,vh_parent_off,vh_profile) refused()
block replay_shape(vs_r:readbuf,vs_m:mutbuf,vs_a:u64,vs_n:u64,vs_len:usize,vs_ex:bool)
  branch vs_ex compare_engine_parent(vs_r,vs_m,vs_a,vs_n,vs_len) compare_replay(vs_r,vs_m,vs_a,vs_n)
block compare_engine_parent(ve_r:readbuf,ve_m:mutbuf,ve_a:u64,ve_n:u64,ve_len:usize)
  ve_valid:bool = call(ve_r,ve_m,ve_n,ve_len) {"function":"hfs_capture_engine"}
  branch ve_valid compare_replay(ve_r,ve_m,ve_a,ve_n) refused()
block compare_replay(kr:readbuf,km:mutbuf,ka:u64,kh:u64)
  zero_k:u64 = const() {"value":0}
  hist:u64 = call(kr,zero_k) {"function":"tr_read"}
  hist_ok:bool = compare.eq(hist,kh)
  ki:usize = const() {"value":8}
  si:usize = const() {"value":176}
  bytes32:u64 = const() {"value":32}
  kid:bool = call(kr,km,ki,si,bytes32) {"function":"smr_eq_bound"}
  rk:usize = const() {"value":40}
  mk:usize = const() {"value":354040}
  root_ok:bool = call(kr,km,rk,mk,bytes32) {"function":"smr_eq_bound"}
  first_pair:bool = bool.and(hist_ok,kid)
  k_all:bool = bool.and(first_pair,root_ok)
  branch k_all compare_tail(kr,km,ka,kh) refused()
block compare_tail(ct_r:readbuf,ct_m:mutbuf,ct_a:u64,ct_h:u64)
  ct_at:u64 = const() {"value":349024}
  ct_profile:u64 = call(ct_m,ct_at) {"function":"cp_get"}
  ct_limit:u64 = call(ct_m,ct_profile) {"function":"hfs_actual_limit"}
  ct_is_last:bool = compare.eq(ct_h,ct_limit)
  branch ct_is_last compare_state(ct_r,ct_m,ct_a,ct_h) resume(ct_m,ct_a,ct_h)
block compare_state(cs2_r:readbuf,cs2_m:mutbuf,cs2_a:u64,cs2_h:u64)
  ks:usize = const() {"value":72}
  ms:usize = const() {"value":400000}
  cs2_size_at:u64 = const() {"value":349008}
  size_s:u64 = call(cs2_m,cs2_size_at) {"function":"cp_get"}
  state_ok:bool = call(cs2_r,cs2_m,ks,ms,size_s) {"function":"smr_eq_bound"}
  branch state_ok resume(cs2_m,cs2_a,cs2_h) refused()
block resume(um:mutbuf,ua:u64,uh:u64)
  verified_count_at:u64 = const() {"value":349032}
  count_saved:u64 = call(um,verified_count_at,uh) {"function":"cp_put"}
  no_pending:u64 = const() {"value":0}
  recorded:u64 = call(um,ua,no_pending) {"function":"cp_put"}
  resume_sql:u32 = const() {"value":198}
  ret(resume_sql)
block delegate(dr:readbuf,dm:mutbuf,dw:mutbuf,dp:u64)
  prefer:u64 = const() {"value":4}
  rc:u32 = call(dr,dm,dw,prefer) {"function":"sjr_reader"}
  success:u32 = const() {"value":0}
  complete:bool = compare.eq(rc,success)
  vg_at:u64 = const() {"value":349032}
  vl_at:u64 = const() {"value":349024}
  verified_count:u64 = call(dm,vg_at) {"function":"cp_get"}
  exit_profile:u64 = call(dm,vl_at) {"function":"cp_get"}
  limit:u64 = call(dm,exit_profile) {"function":"hfs_actual_limit"}
  verified:bool = compare.eq(verified_count,limit)
  pending_bad:bool = bool.not(verified)
  unsafe_result:bool = bool.and(complete,pending_bad)
  branch unsafe_result refused() reply(rc)
block reply(status:u32)
  ret(status)
block refused()
  err:u32 = const() {"value":100}
  ret(err)
end

fn hfv_width(c:u64,e:u64,a:u64) -> (bool) effects() entry(entry)
block entry(c:u64,e:u64,a:u64)
  cmin:u64 = const() {"value":106}
  max:u64 = const() {"value":8192}
  emin:u64 = const() {"value":154}
  emax:u64 = const() {"value":4250}
  one:u64 = const() {"value":1}
  c0:bool = compare.ge(c,cmin)
  c1:bool = compare.le(c,max)
  e0:bool = compare.ge(e,emin)
  e1:bool = compare.le(e,emax)
  a0:bool = compare.ge(a,one)
  a1:bool = compare.le(a,max)
  ca:bool = bool.and(c0,c1)
  ea:bool = bool.and(e0,e1)
  aa:bool = bool.and(a0,a1)
  ce:bool = bool.and(ca,ea)
  allowed:bool = bool.and(ce,aa)
  ret(allowed)
end

fn hfv_parent(r:readbuf,m:mutbuf,w:mutbuf,first:bool,prev:u64) -> (bool) effects(read,write,trap) entry(entry)
block entry(r:readbuf,m:mutbuf,w:mutbuf,first:bool,prev:u64)
  branch first genesis(r,m,w) preceding(r,m,w,prev)
block preceding(pr:readbuf,pm:mutbuf,pw:mutbuf,previous:u64)
  exec_len_at:u64 = const() {"value":248}
  extent:u64 = call(pm,exec_len_at) {"function":"cp_get"}
  pp_at:u64 = const() {"value":349024}
  pp_profile:u64 = call(pm,pp_at) {"function":"cp_get"}
  same_predecessor:bool = call(pp_profile) {"function":"hfs_same_profile"}
  jump compare(pr,pm,pw,previous,extent,same_predecessor)
block genesis(gr:readbuf,gm:mutbuf,gw:mutbuf)
  cbase:u64 = const() {"value":8192}
  cb:u64 = const() {"value":8226}
  cn_at:u64 = const() {"value":104}
  en_at:u64 = const() {"value":248}
  cn:u64 = call(gm,cn_at) {"function":"cp_get"}
  en:u64 = call(gm,en_at) {"function":"cp_get"}
  ce:u64 = int.add.wrap(cbase,cn)
  ge:u64 = call(gm,cb,ce) {"function":"srci_context"}
  size:u64 = const() {"value":40}
  avail:u64 = call(ge,ce,size) {"function":"srci_take"}
  valid:bool = compare.le(avail,ce)
  branch valid record_genesis(gr,gm,gw,ge,en) bad()
block record_genesis(hg_r:readbuf,hg_m:mutbuf,hg_w:mutbuf,hg_pos:u64,hg_extent:u64)
  hg_exact:u64 = call(hg_m,hg_pos) {"function":"cp_get"}
  hg_slot:u64 = const() {"value":349040}
  hg_saved:u64 = call(hg_m,hg_slot,hg_exact) {"function":"cp_put"}
  same_genesis:bool = const() {"value":false}
  jump compare(hg_r,hg_m,hg_w,hg_pos,hg_extent,same_genesis)
block compare(cr:readbuf,cm:mutbuf,cw:mutbuf,cg:u64,cn2:u64,same_coord:bool)
  exec:u64 = const() {"value":140000}
  ext:u64 = const() {"value":80}
  right:u64 = int.add.wrap(exec,cn2)
  parent_at:u64 = int.sub.wrap(right,ext)
  from:usize = int.cast(parent_at) {"mode":"wrap"}
  into:usize = const() {"value":354080}
  width:u64 = const() {"value":40}
  staged:u64 = call(cw,cm,from,into,width) {"function":"sscid_copy"}
  genesis:usize = int.cast(cg) {"mode":"wrap"}
  parent_ok:bool = call(cm,into,genesis,width) {"function":"smk_eq"}
  old:u64 = call(cm,cg) {"function":"cp_get"}
  height_at:u64 = const() {"value":100}
  height:u64 = call(cr,height_at) {"function":"tr_read"}
  one2:u64 = const() {"value":1}
  next:u64 = int.add.wrap(old,one2)
  step:bool = compare.eq(height,next)
  inc:bool = compare.gt(height,old)
  direct:bool = bool.and(step,inc)
  unchanged:bool = compare.eq(height,old)
  matches:bool = select(same_coord,unchanged,direct)
  good:bool = bool.and(parent_ok,matches)
  ret(good)
block bad()
  refuse:bool = const() {"value":false}
  ret(refuse)
end

