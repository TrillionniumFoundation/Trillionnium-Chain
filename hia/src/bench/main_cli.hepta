  cp_original_order:bool = compare.eq(cp_strategy,cp_at0)
  cp_writer_first:u64 = const() {"value":2}
  cp_writer_first_order:bool = compare.eq(cp_strategy,cp_writer_first)
  cp_original_or_hot:bool = bool.or(cp_original_order,cp_hot_order)
  cp_admitted_order:bool = bool.or(cp_original_or_hot,cp_writer_first_order)
  cp_admitted:bool = bool.and(cp_default,cp_admitted_order)
  cp_footprint:u64 = const() {"value":1}
  cp_is_footprint:bool = compare.eq(cp_strategy,cp_footprint)
  cp_is_mixed:bool = compare.eq(cp_kind,cp_footprint)
  cp_footprint_scope:bool = bool.and(cp_is_mixed,cp_default)
  branch cp_is_footprint corrected_footprint(cp_footprint_scope) corrected_compat(cp_o,cp_fanout,cp_admitted)
