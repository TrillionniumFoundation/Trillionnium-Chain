  done:bool = compare.eq(step,de)
  branch done finish(sum) dot(di,dw,step,feat_step,de,sum)
block finish(result:u64)
  ret(result)
end

fn cc_mask(i:readbuf) -> (bool) effects(read,write,trap) entry(entry)
block entry(i:readbuf)
  lo:usize = const() {"value":80296}
  tail:u64 = const() {"value":80552}
  exact:u64 = const() {"value":1}
  bytes:u64 = call(i,tail) {"function":"cp_read"}
  valid:bool = compare.eq(bytes,exact)
  branch valid mask(i,lo) no()
block mask(mi:readbuf,mp:usize)
  b:u8 = buffer.load(mi,mp)
  one:u8 = const() {"value":1}
  within:bool = compare.le(b,one)
  branch within next(mi,mp,b) no()
block next(ni:readbuf,np:usize,nb:u8)
  last:usize = const() {"value":80552}
  done:bool = compare.eq(np,last)
  one_step:usize = const() {"value":1}
  forward:usize = int.add.wrap(np,one_step)
  branch done yes(nb) mask(ni,forward)
block yes(y:u8)
  mask_on:u8 = const() {"value":1}
  bias:bool = compare.eq(y,mask_on)
  ret(bias)
block no()
  bad:bool = const() {"value":false}
  ret(bad)
end

fn cc_decode(i:readbuf,w:mutbuf,n:usize,hex:usize) -> (bool) effects(read,write,trap) entry(entry)
block entry(i:readbuf,w:mutbuf,n:usize,hex:usize)
  raw:usize = const() {"value":1208}
  end_pos:usize = int.add.wrap(hex,n)
  jump pair(i,w,hex,raw,end_pos)
block pair(pi:readbuf,pw:mutbuf,pp:usize,pr:usize,pe:usize)
  one:usize = const() {"value":1}
  after_first:usize = int.add.wrap(pp,one)
  lower:u8 = buffer.load(pi,pp)
  upper:u8 = buffer.load(pi,after_first)
  a:u64 = call(lower) {"function":"il_unhex"}
  b:u64 = call(upper) {"function":"il_unhex"}
  lim:u64 = const() {"value":16}
  aok:bool = compare.lt(a,lim)
  bok:bool = compare.lt(b,lim)
  ok:bool = bool.and(aok,bok)
  branch ok stage(pi,pw,after_first,pr,pe,a,b) no()
block stage(si:readbuf,sw:mutbuf,sp:usize,sr:usize,se:usize,sa:u64,sb:u64)
  four:u64 = const() {"value":4}
  nib:u64 = int.shl.checked(sa,four)
  word:u64 = bit.or(nib,sb)
  ch:u8 = int.cast(word) {"mode":"wrap"}
  _ = buffer.store(sw,sr,ch)
  one_step:usize = const() {"value":1}
  next_in:usize = int.add.wrap(sp,one_step)
  next_out:usize = int.add.wrap(sr,one_step)
  end:bool = compare.eq(next_in,se)
  branch end yes() pair(si,sw,next_in,next_out,se)
block yes()
  ok_flag:bool = const() {"value":true}
  ret(ok_flag)
block no()
  fail_flag:bool = const() {"value":false}
  ret(fail_flag)
end

fn cc_vectors(i:readbuf,w:mutbuf,n:u64,used:u64) -> (u64) effects(read,write,trap) entry(entry)
block entry(i:readbuf,w:mutbuf,n:u64,used:u64)
  p0:u64 = const() {"value":15552}
  p1:u64 = const() {"value":15560}
  _n:u64 = call(w,p0,n) {"function":"tr_put"}
  _u:u64 = call(w,p1,used) {"function":"tr_put"}
  z:u64 = const() {"value":0}
  jump lanes(i,w,z)
block lanes(li:readbuf,lw:mutbuf,lx:u64)
  width:u64 = const() {"value":8}
  lane:u64 = int.mul.wrap(lx,width)
  cb:u64 = const() {"value":13496}
  cp:u64 = int.add.wrap(cb,lane)
  raw:u64 = call(lw,cp) {"function":"tr_get"}
  low:u64 = const() {"value":1016}
  high:u64 = const() {"value":1032}
  below:bool = compare.lt(raw,low)
  above:bool = compare.gt(raw,high)
  lo_clip:u64 = select(below,low,raw)
  clip:u64 = select(above,high,lo_clip)
  bias:u64 = const() {"value":1024}
  v:u64 = int.sub.wrap(clip,bias)
  last:u64 = const() {"value":256}
  end:bool = compare.eq(lx,last)
  data_bias:u64 = const() {"value":8}
  final_word:u64 = select(end,data_bias,v)
  input_mask_base:u64 = const() {"value":80296}
  ix:u64 = int.add.wrap(lx,input_mask_base)
  at:usize = int.cast(ix) {"mode":"wrap"}
  mask:u8 = buffer.load(li,at)
  one8:u8 = const() {"value":1}
  enabled:bool = compare.eq(mask,one8)
  zero:u64 = const() {"value":0}
  filtered:u64 = select(enabled,final_word,zero)
  as_is:u64 = const() {"value":15600}
  masked:u64 = const() {"value":17656}
  us:u64 = int.add.wrap(as_is,lane)
  ms:u64 = int.add.wrap(masked,lane)
  _raw:u64 = call(lw,us,final_word) {"function":"tr_put"}
  _mask:u64 = call(lw,ms,filtered) {"function":"tr_put"}
  one:u64 = const() {"value":1}
  next_lane:u64 = int.add.wrap(lx,one)
  branch end ready() lanes(li,lw,next_lane)
block ready()
  ret_zero:u64 = const() {"value":0}
  ret(ret_zero)
end

fn cc_route(i:mutbuf,p:u64) -> (u64) effects(read,write,trap) entry(entry)
block entry(i:mutbuf,p:u64)
  r0:u64 = const() {"value":40}
  r1:u64 = const() {"value":48}
  r2:u64 = const() {"value":56}
  off0:u64 = int.add.wrap(p,r0)
  off1:u64 = int.add.wrap(p,r1)
  off2:u64 = int.add.wrap(p,r2)
  mask:u64 = call(i,p) {"function":"tr_get"}
  a:u64 = call(i,off0) {"function":"tr_get"}
  b:u64 = call(i,off1) {"function":"tr_get"}
  c:u64 = call(i,off2) {"function":"tr_get"}
  x0:i64 = int.cast(a) {"mode":"wrap"}
  x1:i64 = int.cast(b) {"mode":"wrap"}
  x2:i64 = int.cast(c) {"mode":"wrap"}
  z:u64 = const() {"value":0}
  one:u64 = const() {"value":1}
  two:u64 = const() {"value":2}
  four:u64 = const() {"value":4}
  m0:u64 = bit.and(mask,one)
  m1:u64 = bit.and(mask,two)
  m2:u64 = bit.and(mask,four)
  y0:bool = compare.ne(m0,z)
  y1:bool = compare.ne(m1,z)
  y2:bool = compare.ne(m2,z)
  floor:i64 = const() {"value":-67368953}
  s0:i64 = select(y0,x0,floor)
  s1:i64 = select(y1,x1,floor)
  s2:i64 = select(y2,x2,floor)
  bigger1:bool = compare.gt(s1,s0)
  best:i64 = select(bigger1,s1,s0)
  idx:u64 = select(bigger1,one,z)
  bigger2:bool = compare.gt(s2,best)
  route:u64 = select(bigger2,two,idx)
  ret(route)
end

fn cc_class(i:mutbuf,p:u64,route:u64,class:u64,old:u64) -> (u64,u64) effects(read,write,trap) entry(entry)
block entry(i:mutbuf,p:u64,route:u64,class:u64,old:u64)
  eight:u64 = const() {"value":8}
  b0:u64 = const() {"value":16}
  d0:u64 = const() {"value":64}
  rsize:u64 = const() {"value":24}
  delta_class:u64 = int.mul.wrap(class,eight)
  base:u64 = int.add.wrap(p,b0)
  base_at:u64 = int.add.wrap(base,delta_class)
  route_delta:u64 = int.mul.wrap(route,rsize)
  delta_base:u64 = int.add.wrap(p,d0)
  selected:u64 = int.add.wrap(delta_base,route_delta)
  delta_at:u64 = int.add.wrap(selected,delta_class)
  base_word:u64 = call(i,base_at) {"function":"tr_get"}
  delta_word:u64 = call(i,delta_at) {"function":"tr_get"}
  merged:u64 = int.add.wrap(base_word,delta_word)
  logit:u64 = int.add.wrap(merged,old)
  signed:i64 = int.cast(logit) {"mode":"wrap"}
  z:i64 = const() {"value":0}
  below:bool = compare.lt(signed,z)
  above:bool = compare.gt(signed,z)
  negative:u64 = const() {"value":18446744073709543424}
  positive:u64 = const() {"value":8192}
  nil:u64 = const() {"value":0}
  up:u64 = select(above,positive,nil)
  direction:u64 = select(below,negative,up)
  three:u64 = const() {"value":3}
  bias:u64 = const() {"value":32768}
  floor_divisor:u64 = const() {"value":4}
  old3:u64 = int.mul.wrap(old,three)
  mix:u64 = int.add.wrap(old3,direction)
  nonnegative:u64 = int.add.wrap(mix,bias)
  quart:u64 = int.div.checked(nonnegative,floor_divisor)
  memory:u64 = int.sub.wrap(quart,positive)
  ret(logit,memory)
end

fn cc_records(o:mutbuf,count:u64,p:u64,d:u64,t:u64,m0:u64,m1:u64,m2:u64) -> (u64,u64,u64) effects(read,write,trap) entry(entry)
block entry(o:mutbuf,count:u64,p:u64,d:u64,t:u64,m0:u64,m1:u64,m2:u64)
  jump loop(o,count,p,d,t,m0,m1,m2)
block loop(lo:mutbuf,lc:u64,lp:u64,ld:u64,lt:u64,lm0:u64,lm1:u64,lm2:u64)
  z:u64 = const() {"value":0}
  done:bool = compare.eq(lc,z)
  branch done final(lm0,lm1,lm2) row(lo,lc,lp,ld,lt,lm0,lm1,lm2)
block row(ro:mutbuf,rc:u64,rp:u64,rd:u64,rt:u64,rm0:u64,rm1:u64,rm2:u64)
  c0:u64 = const() {"value":0}
  c1:u64 = const() {"value":1}
  c2:u64 = const() {"value":2}
  eight:u64 = const() {"value":8}
  sixteen:u64 = const() {"value":16}
  route:u64 = call(ro,rp) {"function":"cc_route"}
  lab_at:u64 = int.add.wrap(rp,eight)
  lab:u64 = call(ro,lab_at) {"function":"tr_get"}
  l0:u64,mm0:u64 = call(ro,rp,route,c0,rm0) {"function":"cc_class"}
  l1:u64,mm1:u64 = call(ro,rp,route,c1,rm1) {"function":"cc_class"}
  l2:u64,mm2:u64 = call(ro,rp,route,c2,rm2) {"function":"cc_class"}
  label_out:u64 = int.add.wrap(rd,eight)
  logits_out:u64 = int.add.wrap(rd,sixteen)
  feat_out0:u64 = const() {"value":40}
  feat_in0:u64 = const() {"value":136}
  feat_count:u64 = const() {"value":2056}
  fo:u64 = int.add.wrap(rd,feat_out0)
  fi:u64 = int.add.wrap(rp,feat_in0)
  put_route:u64 = call(ro,rd,route) {"function":"cp_put"}
  put_label:u64 = call(ro,label_out,lab) {"function":"cp_put"}
  put_logits:u64 = call(ro,logits_out,l0,l1,l2) {"function":"cr_store3"}
  put_memory:u64 = call(ro,rt,mm0,mm1,mm2) {"function":"cr_store3"}
  copy_feat:u64 = call(ro,fi,fo,feat_count) {"function":"cc_copy"}
  in_size:u64 = const() {"value":2192}
  out_size:u64 = const() {"value":2096}
  trace_size:u64 = const() {"value":24}
  ip:u64 = int.add.wrap(rp,in_size)
  op:u64 = int.add.wrap(rd,out_size)
  tp:u64 = int.add.wrap(rt,trace_size)
  n:u64 = int.sub.wrap(rc,c1)
  jump loop(ro,n,ip,op,tp,mm0,mm1,mm2)
block final(f0_:u64,f1_:u64,f2_:u64)
  ret(f0_,f1_,f2_)
end

fn cc_prepared(i:readbuf,w:mutbuf,first:u64,count:u64,left:u64,m0:u64,m1:u64,m2:u64,bw:u64) -> (u32) effects(read,write,trap) entry(entry)
block entry(i:readbuf,w:mutbuf,first:u64,count:u64,left:u64,m0:u64,m1:u64,m2:u64,bw:u64)
  start:u64 = const() {"value":262144}
  after_bw:u64 = const() {"value":123432}
  trace:u64 = int.add.wrap(bw,after_bw)
  last_m0:u64,last_m1:u64,last_m2:u64 = call(w,count,first,start,trace,m0,m1,m2) {"function":"cc_records"}
  hsize:u64 = const() {"value":40}
  off8:u64 = const() {"value":8}
  off16:u64 = const() {"value":16}
  h:u64 = int.sub.wrap(trace,hsize)
  l:u64 = int.add.wrap(h,off8)
  m:u64 = int.add.wrap(h,off16)
  wrote_n:u64 = call(w,h,count) {"function":"cp_put"}
  wrote_r:u64 = call(w,l,left) {"function":"cp_put"}
  wrote_m:u64 = call(w,m,last_m0,last_m1,last_m2) {"function":"cr_store3"}
  row_n:u64 = const() {"value":2096}
  bytes_:u64 = int.mul.wrap(count,row_n)
  end_:u64 = int.add.wrap(start,bytes_)
  begin:usize = int.cast(start) {"mode":"wrap"}
  end0:usize = int.cast(end_) {"mode":"wrap"}
  result:u32 = call(i,w,begin,end0) {"function":"train_backward"}
  ret(result)
end
