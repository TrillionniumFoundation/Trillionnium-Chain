  w8:u64 = const() {"value":13}
  same8:bool = compare.eq(kn8,w8)
  branch same8 v8(ki8,kp8) k9(ki8,kp8,kn8)
block v8(vi8:readbuf,vp8:u64)
  off8_0:u64 = const() {"value":0}
  pos8_0:u64 = int.add.wrap(vp8,off8_0)
  size8_0:u64 = const() {"value":8}
  read8_0:u64 = call(vi8,pos8_0,size8_0) {"function":"bc_tail"}
  target8_0:u64 = const() {"value":7017840967121401185}
  match8_0:bool = compare.eq(read8_0,target8_0)
  off8_8:u64 = const() {"value":8}
  pos8_8:u64 = int.add.wrap(vp8,off8_8)
  size8_8:u64 = const() {"value":5}
  read8_8:u64 = call(vi8,pos8_8,size8_8) {"function":"bc_tail"}
  target8_8:u64 = const() {"value":435778319472}
  match8_8:bool = compare.eq(read8_8,target8_8)
  all8:bool = bool.and(match8_0,match8_8)
  index8:u64 = const() {"value":8}
  branch all8 success(index8) absent()
block k9(ki9:readbuf,kp9:u64,kn9:u64)
  w9:u64 = const() {"value":17}
  same9:bool = compare.eq(kn9,w9)
  branch same9 v9(ki9,kp9) absent()
block v9(vi9:readbuf,vp9:u64)
  off9_0:u64 = const() {"value":0}
  pos9_0:u64 = int.add.wrap(vp9,off9_0)
  size9_0:u64 = const() {"value":8}
  read9_0:u64 = call(vi9,pos9_0,size9_0) {"function":"bc_tail"}
  target9_0:u64 = const() {"value":7598543875852429153}
  match9_0:bool = compare.eq(read9_0,target9_0)
  off9_8:u64 = const() {"value":8}
  pos9_8:u64 = int.add.wrap(vp9,off9_8)
  size9_8:u64 = const() {"value":8}
  read9_8:u64 = call(vi9,pos9_8,size9_8) {"function":"bc_tail"}
  target9_8:u64 = const() {"value":7234299918472275318}
  match9_8:bool = compare.eq(read9_8,target9_8)
  off9_16:u64 = const() {"value":16}
  pos9_16:u64 = int.add.wrap(vp9,off9_16)
