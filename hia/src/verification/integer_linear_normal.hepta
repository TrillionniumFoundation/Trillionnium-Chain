fn iln_read(input:readbuf, offset:usize) -> (u64) effects(read,trap) entry(entry)
block entry(input:readbuf, offset:usize)
  raw_0:u8 = buffer.load(input,offset)
  byte_0:u64 = int.cast(raw_0) {"mode":"wrap"}
