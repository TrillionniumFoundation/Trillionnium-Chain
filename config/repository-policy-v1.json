{
  "schema": "trnm-repository-policy-v1",
  "repository": "TrillionniumFoundation/Trillionnium-Chain",
  "default_branch": "main",
  "consensus_mainline": "native-poco-bft",
  "protocol_target": "poco-bft-v0",
  "baseline_workflow": ".github/workflows/trnm-required-baseline.yml",
  "required_check_names": [
    "repository-truth",
    "protocol-contract",
    "fuzz-smoke",
    "rust-baseline",
    "external-evidence-contract"
  ],
  "required_review_policy": {
    "approvals": 2,
    "code_owner_review": true,
    "last_push_approval": true,
    "dismiss_stale_reviews": true,
    "author_cannot_supply_independent_acceptance": true
  },
  "required_merge_policy": {
    "pull_request_only": true,
    "force_push": false,
    "branch_deletion": false,
    "merge_commit": false,
    "squash_merge": true,
    "rebase_merge": true
  },
  "release_truth": {
    "g0_exit": false,
    "g1_exit": false,
    "g1_5_exit": false,
    "g2_0_exit": false,
    "g2_exit": false,
    "g3_exit": false,
    "g4_exit": false,
    "g5_exit": false,
    "public_testnet_ready": false,
    "production_candidate": false,
    "production_consensus_activation": false,
    "release_ready": false
  },
  "external_blockers": [
    "EXT-REVIEW-001",
    "EXT-G1-CAMPAIGN-001",
    "EXT-ANCHOR-HSM-001",
    "EXT-POWERLOSS-001",
    "EXT-AUDIT-001",
    "EXT-SOAK-ACTIVATION-001"
  ],
  "required_paths": [
    ".github/CODEOWNERS",
    ".github/pull_request_template.md",
    ".github/workflows/trnm-documentation-truth.yml",
    ".github/workflows/trnm-required-baseline.yml",
    "PROJECT_BOUNDARY.json",
    "PROJECT_BOUNDARY.md",
    "README.md",
    "SECURITY.md",
    "config/blocker-execution-v1.json",
    "config/build-closures-v1.toml",
    "config/consensus-mainline.json",
    "config/documentation-truth-v1.json",
    "config/module-coverage-v1.toml",
    "config/node-decomposition-v1.toml",
    "docs/architecture/TRNM_POCO_NODE_DECOMPOSITION_V1.md",
    "docs/development/CURRENT_SNAPSHOT_V1.json",
    "docs/development/TRNM_AI_NATIVE_BLOCKCHAIN_DEVELOPMENT_PLAN.md",
    "docs/development/module-registry-v1.toml",
    "docs/development/plan-manifest-v1.toml",
    "docs/development/release-train-v1.toml",
    "docs/modules/TRNM_MODULE_TECHNICAL_REFERENCE_V1.md",
    "rust-toolchain.toml",
    "scripts/ci/check_blocker_execution_v1.py",
    "scripts/ci/check_build_closures_v1.py",
    "scripts/ci/check_canonical_development_plan.sh",
    "scripts/ci/check_documentation_reference_closure_v1.py",
    "scripts/ci/check_module_coverage_v1.py",
    "scripts/ci/check_node_decomposition_v1.py",
    "scripts/ci/check_required_baseline_closure_v1.py",
    "scripts/ci/check_required_protocol_contract_v1.py",
    "trillionnium/Cargo.lock",
    "trillionnium/Cargo.toml",
    "trillionnium/crates/trnm-control-plane-v0/Cargo.toml",
    "trillionnium/crates/trnm-durable-file-adapters-v0/Cargo.toml",
    "trillionnium/crates/trnm-migration-v0/Cargo.toml",
    "trillionnium/crates/trnm-node-boundary-v0/Cargo.toml",
    "trillionnium/crates/trnm-poco-node-authority/Cargo.toml",
    "trillionnium/crates/trnm-poco-node-cli/Cargo.toml",
    "trillionnium/crates/trnm-poco-node-host/Cargo.toml",
    "trillionnium/crates/trnm-poco-node-io/Cargo.toml",
    "trillionnium/crates/trnm-poco-node-production-v0/Cargo.toml",
    "trillionnium/crates/trnm-production-adapter-conformance-v0/Cargo.toml",
    "trillionnium/crates/trnm-release-bundle-v0/Cargo.toml",
    "trillionnium/crates/trnm-state-sync-v0/Cargo.toml",
    "trillionnium/crates/trnm-tx-lifecycle-v0/Cargo.toml"
  ]
}
