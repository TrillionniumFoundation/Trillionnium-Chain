//! TCC2 is the candidate direct-dependency closure for a TCM2 payload.
//!
//! The top-level ModelManifest commitment covers the entire canonical TCM2 and
//! five explicitly ordered, tagged CCH1 dependency claims. Each dependency is
//! observed from its actual complete bytes under ModelPayload; its role is bound
//! by its fixed slot in TCC2. Old locator aliases are never verification keys.
//!
//! This format requires all five nonempty dependency objects. It does not claim
//! that their declarations exhaust transitive dependencies, establish provenance
//! or ancestry, satisfy a loader, or confer installation/CURRENT/FinalUse rights.

use std::io::Read;

use trnm_protocol::content_commitment::{
    observe_bytes, observe_reader, ContentClaimV1, ContentContextV1, ContentKind,
    ContentReadBudget, ObservedContentV1, CONTENT_CLAIM_BYTES,
};

use super::{
    require, CellContentErrorV2, CellContentManifestV2, CellContextV1, FIXED_BYTES, MAX_CELL_BYTES,
    MAX_CELL_CONTENT_MANIFEST_BYTES_V2,
};

const MAGIC: &[u8; 4] = b"TCC2";
pub const CELL_CONTENT_DEPENDENCY_COUNT_V2: usize = 5;
const SLOT_BYTES: usize = 1 + CONTENT_CLAIM_BYTES;
const OUTSIDE_MANIFEST_BYTES: usize = 8 + CELL_CONTENT_DEPENDENCY_COUNT_V2 * SLOT_BYTES;
pub const MAX_CELL_CONTENT_CLOSURE_BYTES_V2: usize =
    OUTSIDE_MANIFEST_BYTES + MAX_CELL_CONTENT_MANIFEST_BYTES_V2;

/// Canonical dependency positions. All five are required, without silent
/// sorting, omission, duplicate elimination, or a legacy-locator fallback.
#[derive(Clone, Copy, Debug, Eq, PartialEq)]
#[repr(u8)]
pub enum CellContentDependencyV2 {
    Base = 1,
    Parent = 2,
    Tokenizer = 3,
    Layout = 4,
    Runtime = 5,
}

impl CellContentDependencyV2 {
    pub const ALL: [Self; CELL_CONTENT_DEPENDENCY_COUNT_V2] = [
        Self::Base,
        Self::Parent,
        Self::Tokenizer,
        Self::Layout,
        Self::Runtime,
    ];

    fn index(self) -> usize {
        self as usize - 1
    }
}

/// An untrusted, canonical direct-dependency declaration until all actual
/// contents pass `verify_readers` under an independently pinned closure claim.
#[derive(Clone, Debug, Eq, PartialEq)]
pub struct CellContentClosureV2 {
    manifest: CellContentManifestV2,
    dependencies: [ContentClaimV1; CELL_CONTENT_DEPENDENCY_COUNT_V2],
}

impl CellContentClosureV2 {
    /// Construct from actual complete observations in Base, Parent, Tokenizer,
    /// Layout, Runtime order. Claims cannot be substituted for observations.
    /// The caller remains responsible for the declared dependency relationships.
    pub fn from_observed_contents(
        legacy_metadata: CellContextV1,
        payload: &ObservedContentV1,
        dependencies: [&ObservedContentV1; CELL_CONTENT_DEPENDENCY_COUNT_V2],
    ) -> Result<Self, CellContentErrorV2> {
        let value = Self {
            manifest: CellContentManifestV2::from_observed_payload(legacy_metadata, payload)?,
            dependencies: dependencies.map(|observation| observation.claim().clone()),
        };
        value.validate()?;
        Ok(value)
    }

    pub fn manifest(&self) -> &CellContentManifestV2 {
        &self.manifest
    }

    pub fn dependency_claim(&self, role: CellContentDependencyV2) -> &ContentClaimV1 {
        &self.dependencies[role.index()]
    }

    pub fn validate(&self) -> Result<(), CellContentErrorV2> {
        self.manifest.validate()?;
        let expected_profile = self.manifest.payload_claim().context().profile_id();
        for dependency in &self.dependencies {
            require(
                dependency.context().kind() == ContentKind::ModelPayload,
                "dependency purpose",
            )?;
            require(
                dependency.context().profile_id() == expected_profile,
                "dependency profile",
            )?;
            require(
                (1..=MAX_CELL_BYTES).contains(&dependency.content_len()),
                "dependency size",
            )?;
        }
        Ok(())
    }

    /// Exact wire: TCC2, BE32 TCM2 length, complete TCM2 bytes, five fixed
    /// (U8 role, 213-byte CCH1) slots. No trailing bytes or absent slots exist.
    pub fn encode(&self) -> Vec<u8> {
        let manifest = self.manifest.encode();
        let mut out = Vec::with_capacity(OUTSIDE_MANIFEST_BYTES + manifest.len());
        out.extend_from_slice(MAGIC);
        out.extend_from_slice(&(manifest.len() as u32).to_be_bytes());
        out.extend_from_slice(&manifest);
        for role in CellContentDependencyV2::ALL {
            out.push(role as u8);
            out.extend_from_slice(&self.dependency_claim(role).encode());
        }
        out
    }

    pub fn decode(bytes: &[u8]) -> Result<Self, CellContentErrorV2> {
        require(
            (OUTSIDE_MANIFEST_BYTES + FIXED_BYTES + 1..=MAX_CELL_CONTENT_CLOSURE_BYTES_V2)
                .contains(&bytes.len()),
            "closure length",
        )?;
        require(&bytes[..4] == MAGIC, "closure version")?;
        let manifest_len = u32::from_be_bytes(
            bytes[4..8]
                .try_into()
                .map_err(|_| CellContentErrorV2::Invalid("closure manifest length"))?,
        ) as usize;
        require(
            (FIXED_BYTES + 1..=MAX_CELL_CONTENT_MANIFEST_BYTES_V2).contains(&manifest_len)
                && bytes.len() == OUTSIDE_MANIFEST_BYTES + manifest_len,
            "closure exact coverage",
        )?;
        let manifest = CellContentManifestV2::decode(&bytes[8..8 + manifest_len])?;
        let mut dependencies = Vec::with_capacity(CELL_CONTENT_DEPENDENCY_COUNT_V2);
        let mut at = 8 + manifest_len;
        for role in CellContentDependencyV2::ALL {
            require(bytes[at] == role as u8, "closure canonical role order")?;
            at += 1;
            dependencies.push(ContentClaimV1::decode(
                &bytes[at..at + CONTENT_CLAIM_BYTES],
            )?);
            at += CONTENT_CLAIM_BYTES;
        }
        let value = Self {
            manifest,
            dependencies: dependencies
                .try_into()
                .map_err(|_| CellContentErrorV2::Invalid("closure dependency coverage"))?,
        };
        value.validate()?;
        require(value.encode() == bytes, "canonical closure encoding")?;
        Ok(value)
    }

    /// Observe the complete closure *declaration* under the independently
    /// selected ModelManifest context. This alone never re-reads its contents
    /// and cannot create a `CellContentClosureReadbackV2`.
    pub fn observe_closure(
        &self,
        context: &ContentContextV1,
        budget: &mut ContentReadBudget,
    ) -> Result<ObservedContentV1, CellContentErrorV2> {
        self.validate()?;
        self.manifest.check_manifest_context(context)?;
        Ok(observe_bytes(context, budget, &self.encode())?)
    }

    /// Verify an independently pinned full closure claim, the actual complete
    /// model payload, then Base/Parent/Tokenizer/Layout/Runtime actual bytes.
    /// Every read shares one reservation budget; any failure returns no closure
    /// readback and refunds none of the earlier reservations.
    ///
    /// Each dependency has its own complete, top-level-pinned instance and
    /// generation. Role changes require a different closure claim. Time limits,
    /// source stability, owner freshness, and irreversible effects belong to
    /// their existing owners. No old locator can satisfy any content read.
    pub fn verify_readers<R: Read + ?Sized>(
        &self,
        expected_closure: &ContentClaimV1,
        budget: &mut ContentReadBudget,
        payload_reader: &mut R,
        dependency_readers: [&mut dyn Read; CELL_CONTENT_DEPENDENCY_COUNT_V2],
    ) -> Result<CellContentClosureReadbackV2, CellContentErrorV2> {
        let closure = self.observe_closure(expected_closure.context(), budget)?;
        expected_closure.verify(&closure)?;
        let payload_claim = self.manifest.payload_claim();
        let payload = observe_reader(
            payload_claim.context(),
            budget,
            payload_claim.content_len(),
            payload_reader,
        )?;
        payload_claim.verify(&payload)?;
        let mut dependencies = Vec::with_capacity(CELL_CONTENT_DEPENDENCY_COUNT_V2);
        for (claim, reader) in self.dependencies.iter().zip(dependency_readers) {
            let observation = observe_reader(claim.context(), budget, claim.content_len(), reader)?;
            claim.verify(&observation)?;
            dependencies.push(observation);
        }
        Ok(CellContentClosureReadbackV2 {
            closure,
            payload,
            dependencies: dependencies
                .try_into()
                .map_err(|_| CellContentErrorV2::Invalid("closure readback coverage"))?,
        })
    }
}

/// A pinned closure and all six actual content objects were completely read
/// and matched. Private construction and no deserializer prevent a metadata-only
/// or TCM2-only observation from being promoted to this stronger readback type.
/// The observations can be joined to CPQ1 mathematical signature verification;
/// they still provide no authority to install, execute, or select CURRENT.
///
/// ```compile_fail
/// use trnm_data_availability::cell::{CellContentClosureReadbackV2, CellContentReadbackV2};
/// fn promote_payload_only(value: CellContentReadbackV2) -> CellContentClosureReadbackV2 {
///     value
/// }
/// ```
#[derive(Debug)]
pub struct CellContentClosureReadbackV2 {
    closure: ObservedContentV1,
    payload: ObservedContentV1,
    dependencies: [ObservedContentV1; CELL_CONTENT_DEPENDENCY_COUNT_V2],
}

impl CellContentClosureReadbackV2 {
    pub fn closure_observation(&self) -> &ObservedContentV1 {
        &self.closure
    }

    pub fn payload_observation(&self) -> &ObservedContentV1 {
        &self.payload
    }

    pub fn dependency_observation(&self, role: CellContentDependencyV2) -> &ObservedContentV1 {
        &self.dependencies[role.index()]
    }
}

#[cfg(test)]
mod tests;

e073b728532e695cc6d0a31d115cba15b0d8d7bd blob 6915
//! Immutable model identity around the existing, unchanged TCD1 byte plan.
//! A root is pinned by the release owner. Neither its hash nor a successful
//! fetch supplies publisher authentication, CURRENT selection or FinalUse.
//! The embedded loader profile is an opaque owner pin: TMR1 itself does not
//! parse tensor formats or prove that a declared file set is a usable model.

use std::io::{Cursor, Read};

use sha2::{Digest, Sha256};

use super::{
    require, CellDigestV1, CellErrorV1, CellFileRoleV1, CellLoaderContextV1, CellReleaseClosureV1,
    CellResultV1, MAX_CELL_CLOSURE_BYTES_V1,
};

const MAX_PARENTS: usize = 16;
pub const MAX_MODEL_RELEASE_ROOT_BYTES_V1: usize =
    MAX_CELL_CLOSURE_BYTES_V1 + 4 + 4 + 32 + 1 + MAX_PARENTS * 32;

/// TMR1 commits the entire TCD1 closure, an explicit router-roster commitment
/// (including the empty roster), and canonical direct parent release roots.
/// Family, base, parent model, tokenizer, layout, runtime, loader profile and
/// generation remain bound by the embedded original closure.
#[derive(Clone, Debug, Eq, PartialEq)]
pub struct CellModelReleaseRootV1 {
    closure: CellReleaseClosureV1,
    router: CellDigestV1,
    lineage: Vec<CellDigestV1>,
}

impl CellModelReleaseRootV1 {
    /// Lineage order is canonical. Do not silently sort or deduplicate inputs.
    pub fn new(closure: CellReleaseClosureV1, lineage: Vec<CellDigestV1>) -> CellResultV1<Self> {
        let value = Self {
            router: router_commitment(&closure),
            closure,
            lineage,
        };
        value.validate()?;
        Ok(value)
    }

    pub fn closure(&self) -> &CellReleaseClosureV1 {
        &self.closure
    }

    pub fn router_commitment(&self) -> CellDigestV1 {
        self.router
    }

    pub fn lineage(&self) -> &[CellDigestV1] {
        &self.lineage
    }

    pub fn validate(&self) -> CellResultV1<()> {
        self.closure.validate()?;
        require(
            self.lineage.len() <= MAX_PARENTS,
            "model root lineage count",
        )?;
        require(
            self.lineage.iter().all(|id| *id != [0; 32])
                && self.lineage.windows(2).all(|pair| pair[0] < pair[1]),
            "model root canonical lineage",
        )?;
        require(
            self.router == router_commitment(&self.closure),
            "model root router roster",
        )?;
        require(
            self.encode().len() <= MAX_MODEL_RELEASE_ROOT_BYTES_V1,
            "model root length",
        )
    }

    /// Validate every declared direct parent against actual parent root bytes.
    /// Empty lineage explicitly declares an origin. Transitive ancestry and
    /// authorization still belong to the caller's release/lineage owner.
    pub fn verify_parent_roots(&self, parents: &[Self]) -> CellResultV1<()> {
        self.validate()?;
        require(
            parents.len() == self.lineage.len(),
            "model root parent coverage",
        )?;
        for (expected, parent) in self.lineage.iter().zip(parents) {
            parent.validate()?;
            require(
                parent.id() == *expected
                    && parent.closure.release().context().family
                        == self.closure.release().context().family
                    && parent.closure.selected_generation() < self.closure.selected_generation(),
                "model root parent identity/generation",
            )?;
        }
        Ok(())
    }

    /// Admission of a declared byte plan only. The independent root pin and
    /// original loader context must both match; no use token is returned.
    pub fn verify_for_loader(
        &self,
        pinned: CellDigestV1,
        expected: &CellLoaderContextV1,
    ) -> CellResultV1<()> {
        self.validate()?;
        require(self.id() == pinned, "model root pin")?;
        self.closure.verify_for_loader(expected)
    }

    pub fn encode(&self) -> Vec<u8> {
        let closure = self.closure.encode();
        let mut out = Vec::with_capacity(41 + closure.len() + 32 * self.lineage.len());
        out.extend_from_slice(b"TMR1");
        out.extend_from_slice(&(closure.len() as u32).to_be_bytes());
        out.extend_from_slice(&closure);
        out.extend_from_slice(&self.router);
        out.push(self.lineage.len() as u8);
        for parent in &self.lineage {
            out.extend_from_slice(parent);
        }
        out
    }

    pub fn id(&self) -> CellDigestV1 {
        let mut hash = Sha256::new();
        hash.update(b"trnm.cell-model-release-root.v1\0");
        hash.update(self.encode());
        hash.finalize().into()
    }

    pub fn decode(bytes: &[u8]) -> CellResultV1<Self> {
        require(
            bytes.len() <= MAX_MODEL_RELEASE_ROOT_BYTES_V1,
            "model root length",
        )?;
        let mut input = Cursor::new(bytes);
        require(read::<4>(&mut input)? == *b"TMR1", "model root version")?;
        let count = u32::from_be_bytes(read(&mut input)?) as usize;
        require(
            count <= MAX_CELL_CLOSURE_BYTES_V1
                && bytes
                    .len()
                    .checked_sub(8)
                    .is_some_and(|left| left >= count + 33),
            "model root closure length",
        )?;
        let closure = CellReleaseClosureV1::decode(&bytes[8..8 + count])?;
        input.set_position((8 + count) as u64);
        let router = read(&mut input)?;
        let count = usize::from(read::<1>(&mut input)?[0]);
        require(
            count <= MAX_PARENTS
                && (bytes.len() as u64).checked_sub(input.position()) == Some(count as u64 * 32),
            "model root lineage length",
        )?;
        let mut lineage = Vec::with_capacity(count);
        for _ in 0..count {
            lineage.push(read(&mut input)?);
        }
        let value = Self {
            closure,
            router,
            lineage,
        };
        value.validate()?;
        require(value.encode() == bytes, "model root canonical encoding")?;
        Ok(value)
    }
}

fn router_commitment(closure: &CellReleaseClosureV1) -> CellDigestV1 {
    let routers: Vec<_> = closure
        .files()
        .iter()
        .filter(|file| file.role == CellFileRoleV1::Router)
        .collect();
    let mut hash = Sha256::new();
    hash.update(b"trnm.cell-model-router-roster.v1\0");
    hash.update((routers.len() as u16).to_be_bytes());
    for router in routers {
        hash.update((router.path.len() as u16).to_be_bytes());
        hash.update(router.path.as_bytes());
        hash.update(router.manifest);
        hash.update(router.payload_sha256);
        hash.update(router.payload_bytes.to_be_bytes());
    }
    hash.finalize().into()
}

fn read<const N: usize>(input: &mut Cursor<&[u8]>) -> CellResultV1<[u8; N]> {
    let mut value = [0; N];
    input.read_exact(&mut value).map_err(CellErrorV1::Io)?;
    Ok(value)
}

e3ff2fa1f3ef4600e5198a69821e1bc3614e5650 blob 9650
//! Candidate full-content commitments. CCH1 does not change CPQ1 profile IDs,
//! legacy encodings, native work, proof transcripts, or any live authorizer.
//!
//! A claim is untrusted data. An observation is created only after reading the
//! exact declared bytes and EOF; it establishes byte equality, not provenance,
//! freshness, durable custody, or permission to execute. Typed subsystem
//! adapters must supply their actual complete content rather than old digests.

use crate::crypto_profile::{BoundCryptoProfile, CryptoProfileId};
use sha2::{Digest, Sha512};
use std::io::{self, Cursor, Read};

const DOMAIN: &[u8] = b"TRNM/CPQ1/FullContent/SHA512/v1\0";
const MAGIC: &[u8; 4] = b"CCH1";
pub const CONTENT_CLAIM_BYTES: usize = 213;
const HEADER_BYTES: usize = CONTENT_CLAIM_BYTES - 64;

#[derive(Clone, Copy, Debug, Eq, PartialEq)]
#[repr(u8)]
pub enum ContentKind {
    StateSnapshot = 1,
    ReleaseArtifact = 2,
    ModelManifest = 3,
    ModelPayload = 4,
    MigrationCheckpoint = 5,
}
impl ContentKind {
    fn decode(value: u8) -> Result<Self, ContentCommitmentError> {
        match value {
            1 => Ok(Self::StateSnapshot),
            2 => Ok(Self::ReleaseArtifact),
            3 => Ok(Self::ModelManifest),
            4 => Ok(Self::ModelPayload),
            5 => Ok(Self::MigrationCheckpoint),
            _ => Err(ContentCommitmentError::Encoding),
        }
    }
}

#[derive(Debug)]
pub enum ContentCommitmentError {
    CandidateOnly,
    InvalidContext,
    Encoding,
    Budget,
    Truncated,
    TrailingBytes,
    Mismatch,
    Io(io::Error),
}
impl std::fmt::Display for ContentCommitmentError {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(f, "full-content commitment rejected: {self:?}")
    }
}
impl std::error::Error for ContentCommitmentError {
    fn source(&self) -> Option<&(dyn std::error::Error + 'static)> {
        match self {
            Self::Io(error) => Some(error),
            _ => None,
        }
    }
}
impl From<io::Error> for ContentCommitmentError {
    fn from(error: io::Error) -> Self {
        Self::Io(error)
    }
}

/// Owner-supplied context; construction does not authenticate the owner. A
/// decoded claim also contains this type, with an untrusted declared profile ID.
/// Observation always uses this fixed SHA-512 suite; an ID never negotiates a
/// verifier. The signature join separately requires an independently pinned
/// candidate profile, and must not trust a context received with its content.
#[derive(Clone, Copy, Debug, Eq, PartialEq)]
pub struct ContentContextV1 {
    profile_id: CryptoProfileId,
    kind: ContentKind,
    instance: [u8; 64],
    generation: u64,
}
impl ContentContextV1 {
    pub fn new(
        profile: &BoundCryptoProfile,
        kind: ContentKind,
        instance: [u8; 64],
        generation: u64,
    ) -> Result<Self, ContentCommitmentError> {
        if !profile.profile().is_candidate() {
            return Err(ContentCommitmentError::CandidateOnly);
        }
        if instance == [0; 64] {
            return Err(ContentCommitmentError::InvalidContext);
        }
        Ok(Self {
            profile_id: profile.id(),
            kind,
            instance,
            generation,
        })
    }
    pub fn profile_id(&self) -> CryptoProfileId {
        self.profile_id
    }
    pub fn kind(&self) -> ContentKind {
        self.kind
    }
    pub fn instance(&self) -> &[u8; 64] {
        &self.instance
    }
    pub fn generation(&self) -> u64 {
        self.generation
    }
    fn header(&self, content_len: u64) -> Vec<u8> {
        let mut out = Vec::with_capacity(HEADER_BYTES);
        out.extend_from_slice(MAGIC);
        out.extend_from_slice(self.profile_id.as_bytes());
        out.push(self.kind as u8);
        out.extend_from_slice(&self.instance);
        out.extend_from_slice(&self.generation.to_be_bytes());
        out.extend_from_slice(&content_len.to_be_bytes());
        out
    }
}

/// An expected or received claim. Decoding alone is never content verification.
#[derive(Clone, Debug, Eq, PartialEq)]
pub struct ContentClaimV1 {
    context: ContentContextV1,
    content_len: u64,
    digest: [u8; 64],
}
impl ContentClaimV1 {
    pub fn context(&self) -> &ContentContextV1 {
        &self.context
    }
    pub fn content_len(&self) -> u64 {
        self.content_len
    }
    pub fn digest(&self) -> &[u8; 64] {
        &self.digest
    }
    pub fn encode(&self) -> Vec<u8> {
        let mut out = self.context.header(self.content_len);
        out.extend_from_slice(&self.digest);
        out
    }
    pub fn decode(bytes: &[u8]) -> Result<Self, ContentCommitmentError> {
        if bytes.len() != CONTENT_CLAIM_BYTES || &bytes[..4] != MAGIC {
            return Err(ContentCommitmentError::Encoding);
        }
        let profile_id = CryptoProfileId::from_hex(&hex::encode(&bytes[4..68]))
            .map_err(|_| ContentCommitmentError::Encoding)?;
        let kind = ContentKind::decode(bytes[68])?;
        let instance: [u8; 64] = bytes[69..133].try_into().expect("fixed context");
        if profile_id.as_bytes() == &[0; 64] || instance == [0; 64] {
            return Err(ContentCommitmentError::InvalidContext);
        }
        Ok(Self {
            context: ContentContextV1 {
                profile_id,
                kind,
                instance,
                generation: u64::from_be_bytes(
                    bytes[133..141].try_into().expect("fixed generation"),
                ),
            },
            content_len: u64::from_be_bytes(bytes[141..149].try_into().expect("fixed length")),
            digest: bytes[149..213].try_into().expect("fixed digest"),
        })
    }
    pub fn verify(&self, observed: &ObservedContentV1) -> Result<(), ContentCommitmentError> {
        if self == observed.claim() {
            Ok(())
        } else {
            Err(ContentCommitmentError::Mismatch)
        }
    }
}

/// The bytes returned by a particular complete read, not an immutable file or
/// current authorization. This type has no public constructor or deserializer.
#[derive(Debug)]
pub struct ObservedContentV1 {
    claim: ContentClaimV1,
}
impl ObservedContentV1 {
    pub fn claim(&self) -> &ContentClaimV1 {
        &self.claim
    }
}

/// A caller-owned cumulative read reservation. Declared length plus one EOF
/// probe is charged before reading; errors are never refunded. It is not a
/// CPU deadline, memory measurement, production resource policy, or attestation.
#[derive(Debug)]
pub struct ContentReadBudget {
    max_reads: u64,
    max_bytes: u64,
    reads: u64,
    bytes: u64,
    exhausted: bool,
}
impl ContentReadBudget {
    pub fn new(max_reads: u64, max_bytes: u64) -> Result<Self, ContentCommitmentError> {
        if max_reads == 0 || max_bytes == 0 {
            return Err(ContentCommitmentError::Budget);
        }
        Ok(Self {
            max_reads,
            max_bytes,
            reads: 0,
            bytes: 0,
            exhausted: false,
        })
    }
    pub fn reads_reserved(&self) -> u64 {
        self.reads
    }
    pub fn bytes_reserved(&self) -> u64 {
        self.bytes
    }
    pub fn exhausted(&self) -> bool {
        self.exhausted
    }
    fn reserve(&mut self, declared_len: u64) -> Result<(), ContentCommitmentError> {
        let reads = self.reads.checked_add(1);
        let bytes = declared_len
            .checked_add(1)
            .and_then(|n| self.bytes.checked_add(n));
        if self.exhausted
            || reads.is_none_or(|n| n > self.max_reads)
            || bytes.is_none_or(|n| n > self.max_bytes)
        {
            self.exhausted = true;
            self.reads = self.max_reads;
            self.bytes = self.max_bytes;
            return Err(ContentCommitmentError::Budget);
        }
        self.reads = reads.expect("checked reservation");
        self.bytes = bytes.expect("checked reservation");
        Ok(())
    }
}

pub fn observe_bytes(
    context: &ContentContextV1,
    budget: &mut ContentReadBudget,
    bytes: &[u8],
) -> Result<ObservedContentV1, ContentCommitmentError> {
    observe_reader(context, budget, bytes.len() as u64, &mut Cursor::new(bytes))
}

/// Hash actual reader bytes directly, with fixed memory. A short read, any I/O
/// error (including Interrupted), or any extra byte refuses the entire result.
/// The owner supplies cancellation/deadline and stable-object/provenance checks.
pub fn observe_reader<R: Read + ?Sized>(
    context: &ContentContextV1,
    budget: &mut ContentReadBudget,
    declared_len: u64,
    reader: &mut R,
) -> Result<ObservedContentV1, ContentCommitmentError> {
    budget.reserve(declared_len)?;
    let mut hasher = Sha512::new();
    hasher.update(DOMAIN);
    hasher.update(context.header(declared_len));
    let mut remaining = declared_len;
    let mut buffer = [0u8; 8192];
    while remaining > 0 {
        let requested = remaining.min(buffer.len() as u64) as usize;
        let count = reader.read(&mut buffer[..requested])?;
        if count == 0 {
            return Err(ContentCommitmentError::Truncated);
        }
        if count > requested {
            return Err(ContentCommitmentError::Encoding);
        }
        hasher.update(&buffer[..count]);
        remaining -= count as u64;
    }
    if reader.read(&mut buffer[..1])? != 0 {
        return Err(ContentCommitmentError::TrailingBytes);
    }
    Ok(ObservedContentV1 {
        claim: ContentClaimV1 {
            context: *context,
            content_len: declared_len,
            digest: hasher.finalize().into(),
        },
    })
}

