  good:bool = bool.and(good_family,good_schema)
  ret(good)
block no()
  bad:bool = const() {"value":false}
  ret(bad)
end

fn imd_number(input:readbuf,field:u64,key:u64,value:u64) -> (bool) effects(read,trap) entry(entry)
block entry(input:readbuf,field:u64,key:u64,value:u64)
  eight:u64 = const() {"value":8}
  seen:u64 = call(input,field,eight) {"function":"rac_read_le"}
  same:bool = compare.eq(seen,key)
  header_at:u64 = int.add.wrap(field,eight)
  number_header:u64 = call(input,header_at,eight) {"function":"rac_read_le"}
  expected:u64 = const() {"value":2051}
  typed:bool = compare.eq(number_header,expected)
  sixteen:u64 = const() {"value":16}
  data_at:u64 = int.add.wrap(field,sixteen)
  data:u64 = call(input,data_at,eight) {"function":"rac_read_le"}
  equal:bool = compare.eq(data,value)
  h:bool = bool.and(same,typed)
  all:bool = bool.and(h,equal)
  ret(all)
end

fn imd_text(input:readbuf,field:u64,key:u64,length:u64) -> (bool) effects(read,trap) entry(entry)
block entry(input:readbuf,field:u64,key:u64,length:u64)
  eight:u64 = const() {"value":8}
  seen:u64 = call(input,field,eight) {"function":"rac_read_le"}
  same:bool = compare.eq(seen,key)
  header_at:u64 = int.add.wrap(field,eight)
  header:u64 = call(input,header_at,eight) {"function":"rac_read_le"}
  shifted:u64 = int.shl.checked(length,eight)
  one:u64 = const() {"value":1}
  type_want:u64 = int.add.wrap(shifted,one)
  typed:bool = compare.eq(header,type_want)
  all:bool = bool.and(same,typed)
  ret(all)
end

fn imd_schema(input:readbuf,at:u64,v3:bool) -> (bool) effects(read,trap) entry(entry)
block entry(input:readbuf,at:u64,v3:bool)
  eight:u64 = const() {"value":8}
  sixteen:u64 = const() {"value":16}
  seven:u64 = const() {"value":7}
  second:u64 = int.add.wrap(at,eight)
  last:u64 = int.add.wrap(at,sixteen)
  a:u64 = call(input,at,eight) {"function":"rac_read_le"}
  b:u64 = call(input,second,eight) {"function":"rac_read_le"}
  c:u64 = call(input,last,seven) {"function":"rac_read_le"}
  wa:u64 = const() {"value":3274791373809938025}
  wb:u64 = const() {"value":7521905746219659117}
  wc2:u64 = const() {"value":14203686417559157}
  wc3:u64 = const() {"value":14485161394269813}
  wc:u64 = select(v3,wc3,wc2)
  ab:bool = compare.eq(a,wa)
  bb:bool = compare.eq(b,wb)
  cb:bool = compare.eq(c,wc)
  first:bool = bool.and(ab,bb)
  total:bool = bool.and(first,cb)
  ret(total)
end

fn imd_family(input:readbuf,at:u64) -> (bool) effects(read,trap) entry(entry)
block entry(input:readbuf,at:u64)
  start:u64 = const() {"value":8}
  jump each(input,at,start)
block each(ei:readbuf,ea:u64,ef:u64)
  one:u64 = const() {"value":1}
  two:u64 = const() {"value":2}
  expected:u64 = call(ei,ef,one) {"function":"rac_read_le"}
  raw:u64 = call(ei,ea) {"function":"imd_pair"}
  equal:bool = compare.eq(expected,raw)
  next_a:u64 = int.add.wrap(ea,two)
  next_f:u64 = int.add.wrap(ef,one)
  limit:u64 = const() {"value":40}
  done:bool = compare.eq(next_f,limit)
  branch equal advance(ei,next_a,next_f,done) no()
block advance(ai:readbuf,aa:u64,af:u64,fin:bool)
  branch fin yes() each(ai,aa,af)
block yes()
  good:bool = const() {"value":true}
  ret(good)
block no()
  bad:bool = const() {"value":false}
  ret(bad)
end

fn imd_pair(input:readbuf,at:u64) -> (u64) effects(read,trap) entry(entry)
block entry(input:readbuf,at:u64)
  one:u64 = const() {"value":1}
  second:u64 = int.add.wrap(at,one)
  a:usize = int.cast(at) {"mode":"wrap"}
  b:usize = int.cast(second) {"mode":"wrap"}
  raw_a:u8 = buffer.load(input,a)
  raw_b:u8 = buffer.load(input,b)
  x:u64 = call(raw_a) {"function":"il_unhex"}
  y:u64 = call(raw_b) {"function":"il_unhex"}
  limit:u64 = const() {"value":16}
  av:bool = compare.lt(x,limit)
  bv:bool = compare.lt(y,limit)
  valid:bool = bool.and(av,bv)
  hi:u64 = int.mul.wrap(x,limit)
  value:u64 = int.add.wrap(hi,y)
  sentinel:u64 = const() {"value":256}
  result:u64 = select(valid,value,sentinel)
  ret(result)
end

