fn benv_launcher_name(i:readbuf,p:usize) -> (u64) effects(read,trap) entry(entry)
block entry(i:readbuf,p:usize)
  z:u64 = const() {"value":0}
  jump scan(i,p,z,z)
block scan(si:readbuf,sp:usize,shift:u64,value:u64)
  max:u64 = const() {"value":64}
  done:bool = compare.eq(shift,max)
  branch done finish(value) byte(si,sp,shift,value)
block byte(bi:readbuf,bp:usize,bs:u64,bv:u64)
  c:u8 = buffer.load(bi,bp)
  n:u64 = int.cast(c) {"mode":"wrap"}
  bits:u64 = int.shl.checked(n,bs)
  v:u64 = bit.or(bv,bits)
  eight:u64 = const() {"value":8}
  one:usize = const() {"value":1}
  next_shift:u64 = int.add.wrap(bs,eight)
  next_pos:usize = int.add.wrap(bp,one)
  jump scan(bi,next_pos,next_shift,v)
block finish(x:u64)
  ret(x)
end
