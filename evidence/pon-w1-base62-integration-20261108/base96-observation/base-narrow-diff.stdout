diff --git a/scripts/ci/run_history_diagnostic.py b/scripts/ci/run_history_diagnostic.py
new file mode 100644
index 000000000..cc24abee4
--- /dev/null
+++ b/scripts/ci/run_history_diagnostic.py
@@ -0,0 +1,457 @@
+#!/usr/bin/env python3
+"""Independent instrumented 4105-block History diagnostic in its fixed CI Host.
+
+Preparation is outside native measurement. Execution runs the whole diagnostic
+test, including block generation, in one Host service. This adapter checks the
+existing native outcome; it supplies neither a State oracle nor qualification.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import signal
+import stat
+import subprocess
+import sys
+
+sys.dont_write_bytecode = True
+from check_required_native_test import validate as validate_named_test
+from public_host_ci_observation import write_new
+from replay_pinned_native import json_load, require
+from verify_ci_source import verify as verify_source
+
+ROOT = Path(__file__).resolve().parents[2]
+SCRIPT = 'scripts/ci/run_history_diagnostic.py'
+TARGET = 'history_stage_diagnostic'
+SOURCE = 'trillionnium/crates/trnm-pon-node/tests/' + TARGET + '.rs'
+SELECTOR = 'actual_v3_long_chain_public_full_sync_reopen_and_corrupt_index_refusal'
+PREPARATION_SCHEMA = 'trnm-ci-history-diagnostic-build-preparation-v1'
+EXECUTION_SCHEMA = 'trnm-ci-history-diagnostic-execution-v1'
+SUMMARY_SCHEMA = 'native-history-stage-diagnostic-v1'
+JSON_LIMIT = 1024 * 1024
+LOG_LIMIT = 128 * 1024 * 1024
+BINARY_LIMIT = 512 * 1024 * 1024
+FALSE_FLAGS = ('public_network_ready', 'hardness_accepted', 'independent_accepted',
+               'production_activation', 'resource_qualification')
+BUILD_ENVIRONMENT = (
+    'CARGO_HOME', 'CARGO_TARGET_DIR', 'CARGO_BUILD_JOBS', 'CARGO_INCREMENTAL',
+    'RUSTFLAGS', 'CARGO_ENCODED_RUSTFLAGS', 'RUSTUP_TOOLCHAIN',
+    'OPENSSL_DIR', 'OPENSSL_STATIC', 'OPENSSL_CONF', 'OPENSSL_MODULES',
+    'TRNM_PQ_OPENSSL', 'TRNM_PQ_OPENSSL_SHA256', 'TRNM_PQ_OPENSSL_VERSION',
+)
+
+
+def file_observation(path: Path, limit: int, *, retain: bool = False) -> tuple[dict, bytes]:
+    """Bounded regular-file observations, including replacement during hashing."""
+    require(path.is_absolute() and path.resolve(strict=True) == path,
+            'HISTORY_CANONICAL_FILE_REQUIRED')
+    flags = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK
+    with os.fdopen(os.open(path, flags), 'rb') as stream:
+        before = os.fstat(stream.fileno())
+        require(stat.S_ISREG(before.st_mode) and 0 < before.st_size <= limit,
+                'HISTORY_REGULAR_FILE_BOUND')
+        fingerprint = lambda value: (value.st_dev, value.st_ino, value.st_mode,
+                                     value.st_size, value.st_mtime_ns, value.st_ctime_ns)
+        require(fingerprint(path.lstat()) == fingerprint(before), 'HISTORY_FILE_CHANGED')
+        digest, chunks, remaining = hashlib.sha256(), [], before.st_size
+        while remaining:
+            chunk = stream.read(min(1024 * 1024, remaining))
+            require(bool(chunk), 'HISTORY_FILE_TRUNCATED')
+            digest.update(chunk)
+            if retain:
+                chunks.append(chunk)
+            remaining -= len(chunk)
+        require(not stream.read(1) and fingerprint(os.fstat(stream.fileno())) == fingerprint(before)
+                and fingerprint(path.lstat()) == fingerprint(before), 'HISTORY_FILE_CHANGED')
+    return ({'path': str(path), 'sha256': digest.hexdigest(), 'size_bytes': before.st_size,
+             'device': before.st_dev, 'inode': before.st_ino,
+             'mtime_ns': before.st_mtime_ns, 'ctime_ns': before.st_ctime_ns}, b''.join(chunks))
+
+
+def load_object(path: Path) -> tuple[dict, dict]:
+    observation, raw = file_observation(path, JSON_LIMIT, retain=True)
+    value = json_load(raw)
+    require(type(value) is dict, 'HISTORY_JSON_OBJECT_REQUIRED')
+    return value, observation
+
+
+def output_path(out: Path) -> Path:
+    require(out.is_absolute() and out.resolve() == out and not out.is_relative_to(ROOT),
+            'OUTPUT_MUST_BE_CANONICAL_OUTSIDE_CHECKOUT')
+    receipts = Path(os.environ.get('TRNM_CI_RECEIPT_DIR', ''))
+    require(receipts.is_absolute() and receipts.resolve(strict=True) == receipts
+            and receipts.is_dir() and out == receipts / 'history-diagnostic',
+            'HISTORY_CURRENT_RECEIPT_DIRECTORY_REQUIRED')
+    return out
+
+
+def job_identity() -> dict:
+    result = {name: os.environ.get(name, '') for name in (
+        'GITHUB_RUN_ID', 'GITHUB_RUN_ATTEMPT', 'GITHUB_JOB')}
+    require(result['GITHUB_RUN_ID'].isdecimal() and result['GITHUB_RUN_ATTEMPT'].isdecimal()
+            and re.fullmatch(r'[A-Za-z0-9_-]{1,80}', result['GITHUB_JOB']) is not None,
+            'HISTORY_CURRENT_JOB_REQUIRED')
+    return result
+
+
+def source_identity() -> dict:
+    """Recheck the workflow's event-bound receipt; never choose bare HEAD as expected."""
+    expected = os.environ.get('TRNM_EXPECTED_SOURCE_SHA')
+    require(type(expected) is str and re.fullmatch('[0-9a-f]{40}', expected) is not None,
+            'HISTORY_EXPECTED_SOURCE_REQUIRED')
+    receipt, _ = load_object(Path(os.environ['TRNM_CI_RECEIPT_DIR']) / 'source.json')
+    require(receipt.get('schema') == 'trnm-ci-source-v1'
+            and receipt.get('tested_commit') == expected
+            and receipt.get('tracked_worktree_verified') is True
+            and receipt.get('tests_executed_by_identity_check') is False,
+            'HISTORY_WORKFLOW_SOURCE_RECEIPT_REQUIRED')
+    actual = verify_source(receipt.get('kind'), receipt.get('candidate'),
+                           receipt.get('base'), receipt.get('prospective_merge'), root=ROOT)
+    require(actual == receipt, 'HISTORY_WORKFLOW_SOURCE_MISMATCH')
+    test, _ = file_observation(ROOT / SOURCE, JSON_LIMIT)
+    return {'commit': expected, 'tree': actual['tested_tree'],
+            'tracked_source_identity': actual, 'test_sha256': test['sha256']}
+
+
+def build_command() -> list[str]:
+    # This is the existing history build. No from-zero 900-second bound is added.
+    return ['cargo', '+1.95.0', 'test', '--release', '--locked', '--manifest-path',
+            'trillionnium/Cargo.toml', '-p', 'trnm-pon-node', '--test', TARGET,
+            '--no-run', '--message-format=json']
+
+
+def select_binary(raw: bytes) -> Path:
+    paths = []
+    finished = False
+    for line in raw.decode('utf-8').splitlines():
+        if not line.startswith('{'):
+            continue
+        row = json_load(line)
+        require(type(row) is dict, 'HISTORY_BUILD_JSON_OBJECT')
+        require(not finished, 'HISTORY_BUILD_RECORD_AFTER_FINISH')
+        if row.get('reason') == 'build-finished':
+            require(row.get('success') is True, 'HISTORY_SUCCESSFUL_BUILD_FINISH_REQUIRED')
+            finished = True
+        elif row.get('reason') == 'compiler-artifact':
+            target, profile = row.get('target'), row.get('profile')
+            require(type(target) is dict and type(profile) is dict, 'HISTORY_BUILD_ARTIFACT_OBJECT')
+            if target.get('name') != TARGET:
+                continue
+            require(target.get('src_path') == str(ROOT / SOURCE)
+                    and target.get('kind') == ['test'] and target.get('crate_types') == ['bin']
+                    and target.get('test') is True
+                    and row.get('manifest_path') == str(ROOT / 'trillionnium/crates/trnm-pon-node/Cargo.toml'),
+                    'HISTORY_BUILD_TARGET_SOURCE')
+            require(profile.get('test') is True and profile.get('opt_level') == '3',
+                    'HISTORY_RELEASE_TEST_PROFILE_REQUIRED')
+            require(type(row.get('executable')) is str and type(row.get('filenames')) is list
+                    and row['executable'] in row['filenames'], 'HISTORY_BUILD_EXECUTABLE_BINDING')
+            paths.append(Path(row['executable']))
+    require(finished, 'HISTORY_SUCCESSFUL_BUILD_FINISH_REQUIRED')
+    require(len(paths) == 1, 'HISTORY_EXACT_NEW_BINARY_REQUIRED')
+    file_observation(paths[0], BINARY_LIMIT)
+    require(os.access(paths[0], os.X_OK), 'HISTORY_EXECUTABLE_REQUIRED')
+    return paths[0]
+
+
+def run_process(command: list[str], log: Path, *, environment: dict | None = None,
+                stderr: Path | None = None) -> dict:
+    """No new execution timeout; the original workflow/native owners keep theirs."""
+    result = {'command': command, 'started': False, 'pid': None, 'exit_code': None,
+              'failure': None, 'cleanup_errors': []}
+    child = None
+    error_stream = None
+    try:
+        with log.open('xb') as stream:
+            if stderr is not None:
+                error_stream = stderr.open('xb')
+            child = subprocess.Popen(command, cwd=ROOT, env=environment, stdout=stream,
+                                     stderr=error_stream if stderr is not None else subprocess.STDOUT,
+                                     start_new_session=True)
+            result.update(started=True, pid=child.pid)
+            result['exit_code'] = child.wait()
+    except BaseException as error:
+        result['failure'] = type(error).__name__ + ':' + str(error)
+        if child is not None:
+            # Only this newly started process group is owned. Unknown exit stays null.
+            try:
+                if child.poll() is None:
+                    os.killpg(child.pid, signal.SIGKILL)
+            except BaseException as cleanup:
+                result['cleanup_errors'].append(type(cleanup).__name__ + ':' + str(cleanup))
+            try:
+                result['exit_code'] = child.wait(timeout=5)
+            except BaseException as cleanup:
+                result['cleanup_errors'].append(type(cleanup).__name__ + ':' + str(cleanup))
+                result['exit_code'] = child.returncode
+    finally:
+        if error_stream is not None:
+            try:
+                error_stream.close()
+            except BaseException as error:
+                failure = type(error).__name__ + ':' + str(error)
+                if result['failure'] is None:
+                    result['failure'] = failure
+                else:
+                    result['cleanup_errors'].append(failure)
+    return result
+
+
+def process_succeeded(process: dict, command: list[str]) -> bool:
+    return (process.get('command') == command and process.get('started') is True
+            and type(process.get('pid')) is int and process['pid'] > 0
+            and type(process.get('exit_code')) is int and process['exit_code'] == 0
+            and process.get('failure') is None and process.get('cleanup_errors') == [])
+
+
+def prepare(out: Path) -> dict:
+    out = output_path(out)
+    out.mkdir(exist_ok=False)
+    result = {'schema': PREPARATION_SCHEMA, 'target': TARGET, 'selector': SELECTOR,
+              'job': None, 'source_before': None, 'source_after': None, 'process': None,
+              'binary': None, 'build_log': None, 'failures': [], 'completed': False,
+              'build_env': {key: os.environ.get(key) for key in BUILD_ENVIRONMENT},
+              'native_tests_executed': False, 'service_resource_observation': False}
+    try:
+        result['job'] = job_identity()
+        result['source_before'] = source_identity()
+        result['process'] = run_process(build_command(), out / 'build.jsonl',
+                                        stderr=out / 'build.stderr')
+        require(process_succeeded(result['process'], build_command()), 'HISTORY_SOURCE_BUILD_FAILED')
+        result['build_log'], raw = file_observation(out / 'build.jsonl', LOG_LIMIT, retain=True)
+        binary = select_binary(raw)
+        result['binary'], _ = file_observation(binary, BINARY_LIMIT)
+    except BaseException as error:
+        result['failures'].append(type(error).__name__ + ':' + str(error))
+    finally:
+        try:
+            result['source_after'] = source_identity()
+            require(result['source_before'] == result['source_after'], 'HISTORY_BUILD_SOURCE_CHANGED')
+        except BaseException as error:
+            result['failures'].append(type(error).__name__ + ':' + str(error))
+        result['completed'] = not result['failures'] and result['binary'] is not None
+        write_new(out / 'preparation.json', result)
+    return result
+
+
+def validate_preparation(out: Path, current_source: dict | None = None) -> dict:
+    out = output_path(out)
+    result, _ = load_object(out / 'preparation.json')
+    require(result.get('schema') == PREPARATION_SCHEMA and result.get('target') == TARGET
+            and result.get('selector') == SELECTOR and result.get('completed') is True
+            and result.get('failures') == [] and result.get('native_tests_executed') is False
+            and result.get('service_resource_observation') is False,
+            'HISTORY_COMPLETE_PREPARATION_REQUIRED')
+    require(result.get('job') == job_identity(), 'HISTORY_PREPARATION_JOB_CHANGED')
+    require(result.get('build_env') == {key: os.environ.get(key) for key in BUILD_ENVIRONMENT},
+            'HISTORY_PREPARATION_BUILD_ENV_CHANGED')
+    source = source_identity() if current_source is None else current_source
+    require(result.get('source_before') == result.get('source_after') == source,
+            'HISTORY_PREPARATION_SOURCE_CHANGED')
+    require(process_succeeded(result.get('process') or {}, build_command()),
+            'HISTORY_SOURCE_BUILD_FAILED')
+    log, raw = file_observation(out / 'build.jsonl', LOG_LIMIT, retain=True)
+    require(log == result.get('build_log'), 'HISTORY_BUILD_LOG_CHANGED')
+    binary, _ = file_observation(select_binary(raw), BINARY_LIMIT)
+    require(binary == result.get('binary'), 'HISTORY_PREPARED_BINARY_CHANGED')
+    return result
+
+
+def native_command(out: Path, binary: Path) -> list[str]:
+    return ['/usr/bin/time', '-v', '-o', str(out / 'history-resources.txt'),
+            str(binary), SELECTOR, '--exact', '--ignored', '--show-output']
+
+
+def validate_diagnostic_log(raw: str) -> None:
+    records = []
+    for line in raw.splitlines():
+        if not line.startswith('{'):
+            continue
+        value = json.loads(line)
+        if value.get('schema') == 'native-ancestry-independent-sync-exit-evidence-v1':
+            records.append(value)
+    require(len(records) == 1, 'DIAGNOSTIC_EXIT_RECORD_REQUIRED')
+    record = records[0]
+    require(record.get('diagnostic_only') is True and record.get('sync_error') is None,
+            'DIAGNOSTIC_REPLAY_FAILED')
+    rpc, imports = record.get('diagnostic_history_rpc'), record.get('diagnostic_import')
+    require(isinstance(rpc, list) and isinstance(imports, list)
+            and len(rpc) == len(imports) == 4105, 'DIAGNOSTIC_ALL_CALLS_REQUIRED')
+    for row in rpc + imports:
+        require(row.get('ok') is True and row.get('error') is None
+                and type(row.get('elapsed_ns')) is int and row['elapsed_ns'] >= 0,
+                'DIAGNOSTIC_CALL_FAILED_OR_UNKNOWN')
+    for row in imports:
+        observation = row['observation']
+        require(observation.get('measurement_failures') == 0
+                and observation.get('supplied_packets') == 1
+                and len(observation.get('packets', [])) == 1, 'DIAGNOSTIC_MEASUREMENT_FAILED')
+        hosts = observation.get('host_checks', [])
+        require(len(hosts) == 4 and {host.get('phase') for host in hosts} == {'resolve', 'initial', 'checkpoint', 'final'}, 'DIAGNOSTIC_HOST_PHASES_REQUIRED')
+        for host in hosts:
+            require(host['calls_started'] == host['calls_completed'] == host['calls_accepted']
+                    and host['calls_started'] > 0 and host['calls_unfinished'] == 0
+                    and host['calls_rejected'] == 0 and host['cpu_clock_unknown_calls'] == 0
+                    and host['wall_clock_unknown_calls'] == 0, 'DIAGNOSTIC_HOST_MEASUREMENT_FAILED')
+        for index, phases in enumerate([observation['phases'], observation['packets'][0]['phases']]):
+            names = [phase['phase'] for phase in phases]
+            expected = {'decode', 'context_owner_wait', 'context', 'work', 'admission_owner_wait', 'admission', 'submit_result', 'admission_prepare', 'execution', 'commit_owner_wait', 'commit', 'cpu_wait', 'body_decode', 'response_encoding', 'history_epoch_open', 'history_epoch_close', 'history_import', 'cpu_settle', 'root_commitment'}
+            require(len(names) == 19 and set(names) == expected, 'DIAGNOSTIC_PHASE_ROSTER_REQUIRED')
+            required = {'history_import', 'context', 'history_epoch_open', 'history_epoch_close'} if index == 0 else {'history_import', 'work', 'admission', 'cpu_wait', 'cpu_settle'}
+            require(required <= {phase['phase'] for phase in phases if phase['started']},
+                    'DIAGNOSTIC_MANDATORY_PHASE_MISSING')
+            for phase in phases:
+                if phase['started']:
+                    require(phase['completed'] and phase['accepted'] is True
+                            and type(phase['wall_ns']) is int
+                            and type(phase['thread_cpu_ns']) is int,
+                            'DIAGNOSTIC_ENTERED_PHASE_UNKNOWN')
+
+
+def validate_summary(summary: dict) -> None:
+    require(summary.get('diagnostic_only') is True and summary.get('resource_qualification') is False, 'DIAGNOSTIC_SCOPE_REQUIRED')
+    # The unchanged native test owns full State, partial activation and reopen assertions.
+    require(summary.get('schema') == SUMMARY_SCHEMA and summary.get('passed') is True,
+            'HISTORY_NATIVE_COMPLETION_REQUIRED')
+    require(type(summary.get('blocks')) is int and type(summary.get('confirmed_packets')) is int
+            and summary['blocks'] == summary['confirmed_packets'] == 4105,
+            'HISTORY_COMPLETE_4105_REQUIRED')
+    require(type(summary.get('renewals')) is int and summary['renewals'] == 4
+            and summary.get('corrupt_active_index_reopen_refused') is True,
+            'HISTORY_RENEWAL_AND_CORRUPTION_REQUIRED')
+    require(all(summary.get(key) is False for key in FALSE_FLAGS), 'HISTORY_SCOPE_PROMOTION')
+
+
+def execution(out: Path) -> dict:
+    out = output_path(out)
+    # Create-only entry prevents a second attempt borrowing any previous native output.
+    write_new(out / 'execution-start.json', {'schema': EXECUTION_SCHEMA, 'completed': False})
+    result = {'schema': EXECUTION_SCHEMA, 'target': TARGET, 'selector': SELECTOR,
+              'job': None, 'preparation_sha256': None, 'source_before': None, 'source_after': None,
+              'binary_before': None, 'binary_after': None, 'process': None,
+              'log': None, 'resources': None, 'summary_file': None, 'summary': None,
+              'named_execution': None, 'failures': [], 'passed': False,
+              'compilation_in_native_measurement': False, 'whole_test_command_preserved': True,
+              'native_execution_authenticated': False, **{key: False for key in FALSE_FLAGS}}
+    binary = None
+    try:
+        result['job'] = job_identity()
+        result['source_before'] = source_identity()
+        prepared = validate_preparation(out, result['source_before'])
+        result['preparation_sha256'] = load_object(out / 'preparation.json')[1]['sha256']
+        binary = Path(prepared['binary']['path'])
+        result['binary_before'], _ = file_observation(binary, BINARY_LIMIT)
+        require(not (out / 'long-history').exists(), 'HISTORY_OUTPUT_ALREADY_EXISTS')
+        environment = dict(os.environ)
+        environment['TRNM_INDEX_EVIDENCE_DIRECTORY'] = str(out / 'long-history')
+        result['process'] = run_process(native_command(out, binary), out / 'history.log',
+                                        environment=environment)
+        require(process_succeeded(result['process'], native_command(out, binary)),
+                'HISTORY_NATIVE_PROCESS_REQUIRED')
+    except BaseException as error:
+        result['failures'].append(type(error).__name__ + ':' + str(error))
+    finally:
+        # Each observation survives failure in another; no missing exit, report or identity is PASS.
+        def observe(action):
+            try:
+                action()
+            except BaseException as error:
+                result['failures'].append(type(error).__name__ + ':' + str(error))
+
+        def source_after():
+            result['source_after'] = source_identity()
+            require(result['source_before'] == result['source_after'], 'HISTORY_EXECUTION_SOURCE_CHANGED')
+
+        def binary_after():
+            if binary is not None:
+                result['binary_after'], _ = file_observation(binary, BINARY_LIMIT)
+                require(result['binary_before'] == result['binary_after'], 'HISTORY_EXECUTION_BINARY_CHANGED')
+
+        def read_log():
+            result['log'], raw = file_observation(out / 'history.log', LOG_LIMIT, retain=True)
+            result['named_execution'] = validate_named_test(raw.decode('utf-8').splitlines(), SELECTOR)
+            validate_diagnostic_log(raw.decode('utf-8'))
+
+        def read_resources():
+            result['resources'], _ = file_observation(out / 'history-resources.txt', JSON_LIMIT)
+
+        def read_summary():
+            result['summary'], result['summary_file'] = load_object(out / 'long-history/summary.json')
+            validate_summary(result['summary'])
+
+        for observation in (source_after, binary_after, read_log, read_resources, read_summary):
+            observe(observation)
+        result['passed'] = not result['failures'] and result['process'] is not None
+        write_new(out / 'manifest.json', result)
+    return result
+
+
+def bind_execution(prepared: dict, out: Path) -> dict:
+    """Re-read the actual outcome after Host observation; never trust a flag alone."""
+    require(validate_preparation(out) == prepared, 'HISTORY_PREPARATION_CHANGED')
+    result, manifest = load_object(out / 'manifest.json')
+    require(result.get('schema') == EXECUTION_SCHEMA and result.get('target') == TARGET
+            and result.get('selector') == SELECTOR and result.get('job') == job_identity()
+            and result.get('passed') is True and result.get('failures') == []
+            and result.get('compilation_in_native_measurement') is False
+            and result.get('whole_test_command_preserved') is True
+            and result.get('native_execution_authenticated') is False
+            and all(result.get(key) is False for key in FALSE_FLAGS),
+            'HISTORY_EXACT_EXECUTION_REQUIRED')
+    require(result.get('preparation_sha256') == load_object(out / 'preparation.json')[1]['sha256']
+            and prepared['source_before'] == result.get('source_before') == result.get('source_after')
+            and prepared['binary'] == result.get('binary_before') == result.get('binary_after'),
+            'HISTORY_BUILD_EXECUTION_BINDING')
+    require(process_succeeded(result.get('process') or {},
+                              native_command(out, Path(prepared['binary']['path']))),
+            'HISTORY_NATIVE_PROCESS_REQUIRED')
+    log, raw = file_observation(out / 'history.log', LOG_LIMIT, retain=True)
+    require(log == result.get('log')
+            and validate_named_test(raw.decode('utf-8').splitlines(), SELECTOR)
+            == result.get('named_execution'), 'HISTORY_NATIVE_LOG_CHANGED')
+    resources, _ = file_observation(out / 'history-resources.txt', JSON_LIMIT)
+    summary, summary_file = load_object(out / 'long-history/summary.json')
+    validate_summary(summary)
+    validate_diagnostic_log(raw.decode('utf-8'))
+    require(resources == result.get('resources') and summary_file == result.get('summary_file')
+            and summary == result.get('summary'), 'HISTORY_NATIVE_REPORT_CHANGED')
+    return {'schema': 'trnm-ci-history-build-execution-binding-v1',
+            'manifest_sha256': manifest['sha256'], 'source_commit': prepared['source_before']['commit'],
+            'binary_sha256': prepared['binary']['sha256'], 'exact_selector': SELECTOR,
+            'compilation_in_native_measurement': False, 'runtime_limits_or_deadlines_changed': False}
+
+
+class HistorySignal(Exception):
+    pass
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--prepare', action='store_true')
+    parser.add_argument('--out', type=Path, required=True)
+    args = parser.parse_args()
+
+    def interrupted(number, _frame):
+        raise HistorySignal(str(number))
+
+    previous = {number: signal.signal(number, interrupted)
+                for number in (signal.SIGINT, signal.SIGTERM)}
+    try:
+        result = prepare(args.out) if args.prepare else execution(args.out)
+        print(json.dumps({'schema': result['schema'], 'passed': result.get('completed', result.get('passed')),
+                          'failures': result['failures'], 'target': TARGET, 'selector': SELECTOR}, sort_keys=True))
+        return 0 if result.get('completed', result.get('passed')) is True else 1
+    except (OSError, ValueError, KeyError, TypeError, HistorySignal) as error:
+        print(json.dumps({'passed': False, 'failure': type(error).__name__ + ':' + str(error)}))
+        return 1
+    finally:
+        for number, handler in previous.items():
+            signal.signal(number, handler)
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
diff --git a/scripts/ci/test_history_stage_diagnostic.py b/scripts/ci/test_history_stage_diagnostic.py
new file mode 100644
index 000000000..748b8417d
--- /dev/null
+++ b/scripts/ci/test_history_stage_diagnostic.py
@@ -0,0 +1,85 @@
+#!/usr/bin/env python3
+"""Local controls only: never provision resources or claim History qualification."""
+import copy
+import json
+import os
+import tempfile
+from pathlib import Path
+import unittest
+from unittest.mock import patch
+import run_history_native as original
+import run_history_diagnostic as diagnostic
+import run_from_zero_host as host
+ROOT=Path(__file__).resolve().parents[2]
+class Controls(unittest.TestCase):
+    def summary(self):
+        return dict(schema=diagnostic.SUMMARY_SCHEMA,passed=True,blocks=4105,
+            confirmed_packets=4105,renewals=4,corrupt_active_index_reopen_refused=True,
+            diagnostic_only=True,**{k:False for k in diagnostic.FALSE_FLAGS})
+    def test_output_path_is_diagnostic_only(self):
+        with tempfile.TemporaryDirectory() as directory:
+            root=Path(directory).resolve()
+            with patch.dict(os.environ, {'TRNM_CI_RECEIPT_DIR':str(root)}):
+                self.assertEqual(diagnostic.output_path(root/'history-diagnostic'),root/'history-diagnostic')
+                for path in [root/'history-native',root/'other',ROOT/'history-diagnostic']:
+                    with self.assertRaises(ValueError):diagnostic.output_path(path)
+                with self.assertRaises(ValueError):original.output_path(root/'history-diagnostic')
+    def test_diagnostic_log_denominators_fail_closed(self):
+        names=['decode','context_owner_wait','context','work','admission_owner_wait','admission','submit_result','admission_prepare','execution','commit_owner_wait','commit','cpu_wait','body_decode','response_encoding','history_epoch_open','history_epoch_close','history_import','cpu_settle','root_commitment']
+        phases=[dict(phase=name,started=True,completed=True,accepted=True,wall_ns=1,thread_cpu_ns=1) for name in names]
+        host=dict(calls_started=1,calls_completed=1,calls_accepted=1,calls_unfinished=0,
+                  calls_rejected=0,cpu_clock_unknown_calls=0,wall_clock_unknown_calls=0)
+        obs=dict(measurement_failures=0,supplied_packets=1,packets=[dict(phases=phases)],
+                 phases=phases,host_checks=[dict(host,phase=name) for name in ['resolve','initial','checkpoint','final']])
+        host=obs['host_checks'][0]
+        row=dict(ok=True,error=None,elapsed_ns=1,observation=obs)
+        record=dict(schema='native-ancestry-independent-sync-exit-evidence-v1',diagnostic_only=True,
+                    sync_error=None,diagnostic_history_rpc=[row]*4105,diagnostic_import=[row]*4105)
+        encode=lambda:json.dumps(record)+'\n'
+        diagnostic.validate_diagnostic_log(encode())
+        with self.assertRaises(ValueError):diagnostic.validate_diagnostic_log('')
+        with self.assertRaises(ValueError):diagnostic.validate_diagnostic_log(encode()+encode())
+        record['diagnostic_import']=record['diagnostic_import'][:-1]
+        with self.assertRaises(ValueError):diagnostic.validate_diagnostic_log(encode())
+        record['diagnostic_import']=[row]*4105
+        for target,key,value in [(obs,'measurement_failures',1),(host,'calls_unfinished',1),
+                                  (host,'cpu_clock_unknown_calls',1),(host,'phase','initial'),(phases[16],'started',False),(row,'ok',False)]:
+            old=target[key];target[key]=value
+            with self.assertRaises(ValueError):diagnostic.validate_diagnostic_log(encode())
+            target[key]=old
+    def test_scope_and_complete_denominator(self):
+        diagnostic.validate_summary(self.summary())
+        for key,value in [('blocks',4104),('confirmed_packets',2800),('passed',False),
+                          ('resource_qualification',True),('diagnostic_only',False),
+                          ('schema',original.SUMMARY_SCHEMA)]:
+            s=self.summary();s[key]=value
+            with self.assertRaises(ValueError):diagnostic.validate_summary(s)
+        with self.assertRaises(ValueError):original.validate_summary(self.summary())
+    def test_exact_host_routing_and_unknown_refusal(self):
+        out=Path('/tmp/independent-history-diagnostic')
+        cmd=['python3',diagnostic.SCRIPT,'--out',str(out)]
+        self.assertEqual(host.validate_command(cmd),out)
+        with patch.object(diagnostic,'validate_preparation',return_value={'diagnostic':True}) as f:
+            self.assertEqual(host.prepare_command(cmd,out,Path('/tmp/receipt')),{'diagnostic':True});f.assert_called_once_with(out)
+        with patch.object(diagnostic,'bind_execution',return_value={'bound':True}) as f:
+            self.assertEqual(host.bind_command(cmd,{},out),{'bound':True});f.assert_called_once_with({},out)
+        for bad in [cmd+['--skip-host'],['python3','scripts/ci/arbitrary.py','--out',str(out)]]:
+            with self.assertRaises(ValueError):host.validate_command(bad)
+    def test_exact_original_limits_and_error_recording(self):
+        s=(ROOT/diagnostic.SOURCE).read_text()
+        self.assertIn('const BLOCKS: u64 = 4105;',s)
+        self.assertIn('Duration::from_secs(1800)',s)
+        self.assertIn('Instant::now() + Duration::from_secs(30)',s)
+        self.assertLess(s.index('while after != tip'),s.index('let observer = ingress::HistoryImportObserver::new()'))
+        self.assertLess(s.index('diagnostic_rpc.push'),s.index('let reply = reply_result?'))
+        self.assertLess(s.index('diagnostic_import.push'),s.index('after = import_result?'))
+        for check in ['PARTIAL_SYNC_ACTIVATED','CONFIRMER_REOPEN','CONFIRMATION_STATE','GUEST_DURABLE_IDENTITY']:
+            self.assertIn(check,s)
+        self.assertNotEqual(diagnostic.TARGET,original.TARGET)
+        self.assertNotEqual(diagnostic.EXECUTION_SCHEMA,original.EXECUTION_SCHEMA)
+    def test_workflow_retains_all_replicas_and_failure_artifacts(self):
+        s=(ROOT/'.github/workflows/pon-history-stage-diagnostic.yml').read_text()
+        for text in ['fail-fast: false','replica: [1, 2]','if: always()','if-no-files-found: error','cancel-in-progress: false','--prepare','not qualification']:
+            self.assertIn(text,s)
+        self.assertNotIn('continue-on-error',s)
+if __name__=='__main__':unittest.main()
diff --git a/trillionnium/crates/trnm-pon-node/tests/history_stage_diagnostic.rs b/trillionnium/crates/trnm-pon-node/tests/history_stage_diagnostic.rs
new file mode 100644
index 000000000..d6650671c
--- /dev/null
+++ b/trillionnium/crates/trnm-pon-node/tests/history_stage_diagnostic.rs
@@ -0,0 +1,488 @@
+//! Actual >4096-block V3 continuity plus unknown-caller public History and a
+//! separate native verifier. This is a local logical-time experiment, not WAN,
+//! sustained public readiness or independent hardware measurement.
+use serde_json::json;
+use std::{
+    fs,
+    net::TcpListener,
+    path::Path,
+    sync::{
+        atomic::{AtomicBool, Ordering},
+        Arc,
+    },
+    thread,
+    time::{Duration, Instant},
+};
+use trnm_crypto_primitives::{
+    qualified_work_task::{
+        lifecycle_v2::verify_lifecycle_admission, DevelopmentTaskAdmission, TaskMaterial,
+    },
+    sign_hex, signing_key_from_hex,
+};
+use trnm_mvcc_fee::qualified_task_lifecycle::slot_key;
+use trnm_pon_node::{
+    development_public,
+    ingress::{
+        self,
+        public_v2::{self, PublicPolicy, PublicServer},
+        DevelopmentIdentity, Page, Request,
+    },
+    Node, Packet, Result, Settings,
+};
+use trnm_protocol::{
+    pon_wire::{hash, Envelope},
+    qualified_work_task::{
+        lifecycle_v2::{DemandLeaseV2, SignedLifecycleTaskV2},
+        lifecycle_v3::{AtomicRenewTaskV3, ATOMIC_RENEW_TAG, PROFILE},
+    },
+};
+const BLOCKS: u64 = 4105;
+fn codec<E: std::fmt::Debug>(e: E) -> trnm_pon_node::Error {
+    format!("CODEC:{e:?}").into()
+}
+fn signature(who: u64, message: &[u8]) -> Result<[u8; 64]> {
+    let key = signing_key_from_hex(&hex::encode(hash(b"DEV-ONLY-KEY", &[&who.to_le_bytes()])))
+        .map_err(codec)?;
+    Ok(hex::decode(sign_hex(&key, message))
+        .map_err(codec)?
+        .try_into()
+        .map_err(|_| "SIGNATURE")?)
+}
+fn material<'a>(model: &'a [u8], input: &'a [u8], a: &'a [u32], b: &'a [u32]) -> TaskMaterial<'a> {
+    TaskMaterial { model, input, a, b }
+}
+fn admission(
+    signed: &SignedLifecycleTaskV2,
+    lease: &DemandLeaseV2,
+    material: TaskMaterial<'_>,
+    height: u64,
+) -> Result<DevelopmentTaskAdmission> {
+    verify_lifecycle_admission(&signed.encode().map_err(codec)?, material, lease, height)
+        .map_err(|e| format!("TASK_ADMISSION:{e:?}").into())
+}
+fn renewal(
+    node: &Node,
+    signed: &SignedLifecycleTaskV2,
+    lease: &DemandLeaseV2,
+    height: u64,
+) -> Result<(Vec<u8>, DemandLeaseV2, SignedLifecycleTaskV2)> {
+    let mut renewed = lease.clone();
+    renewed.revision += 1;
+    renewed.not_before = height;
+    renewed.expires = height + 1000;
+    renewed.available_until = renewed.expires + 100;
+    let sequence = node.read_active()?.2[&slot_key(0)?]["source_sequence"]
+        .as_u64()
+        .ok_or("SEQUENCE")?
+        + 1;
+    let mut manifest = signed.manifest.clone();
+    manifest.source_record = renewed.bound_source_record().map_err(codec)?;
+    manifest.withdrawal_head = renewed.withdrawal_frontier().map_err(codec)?;
+    manifest.not_before = renewed.not_before;
+    manifest.expires = renewed.expires;
+    manifest.available_until = renewed.available_until;
+    manifest.demand_nonce = sequence;
+    let mut replacement = SignedLifecycleTaskV2 {
+        lease_id: renewed.id().map_err(codec)?,
+        manifest,
+        signature: [0; 64],
+    };
+    replacement.signature = signature(0, &replacement.signing_message().map_err(codec)?)?;
+    let atomic = AtomicRenewTaskV3 {
+        lease: renewed.clone(),
+        signed: replacement.clone(),
+    };
+    let sender = development_public(1)?;
+    let mut tx = Envelope {
+        network: node.settings().network(),
+        sender,
+        nonce: node.next_nonce(sender)?,
+        expiry: height + 100,
+        fee_limit: 1_000_000,
+        tag: ATOMIC_RENEW_TAG,
+        payload: atomic.encode().map_err(codec)?,
+        signature: [0; 64],
+    };
+    tx.signature = signature(1, &tx.signing_digest().map_err(codec)?)?;
+    Ok((tx.encode().map_err(codec)?, renewed, replacement))
+}
+fn identity(n: u8) -> DevelopmentIdentity {
+    DevelopmentIdentity::from_secret_hex(&hex::encode([n; 32])).unwrap()
+}
+fn run(directory: &Path) -> Result<serde_json::Value> {
+    let started = Instant::now();
+    let wall = ingress::now()?;
+    let genesis = wall - (BLOCKS + 8) * 10;
+    let settings = Settings::development_with_profiles(
+        Some(genesis),
+        "native-public-evaluation-dev-v1",
+        PROFILE,
+    )?;
+    fs::create_dir(directory.join("packets"))?;
+    let source = json!({"schema":"native-ancestry-long-sync-source-v1","integration_lineage_base":"56a7dfea51669cd829df95c64cbecbe2c4080e56","source_scope":"compiled native observation; exact executed source and binary must be bound by the external runner","index_source":hex::encode(hash(b"ancestry-long-source-v1",&[include_bytes!("../src/ancestry_index.rs")])),"test_source":hex::encode(hash(b"ancestry-long-source-v1",&[include_bytes!("ancestry_long_sync.rs")])),"public_network_ready":false,"hardness_accepted":false,"independent_accepted":false});
+    fs::write(
+        directory.join("source.json"),
+        serde_json::to_vec_pretty(&source)?,
+    )?;
+    fs::write(
+        directory.join("config.json"),
+        serde_json::to_vec_pretty(
+            &json!({"blocks":BLOCKS,"renew_every":900,"task_profile":PROFILE,"evaluation_policy":"native-public-evaluation-dev-v1","genesis_timestamp":genesis,"network":hex::encode(settings.network()),"parameters":hex::encode(settings.parameters()),"genesis":hex::encode(settings.genesis()),"clock_scope":"10-second logical headers under observed wall clock; no real-time long-window claim","public_network_ready":false,"hardness_accepted":false,"production_activation":false}),
+        )?,
+    )?;
+    let bootstrap = settings.bootstrap_lifecycle_task()?;
+    let (model, input, a, b) = settings.bootstrap_task_material()?;
+    let mut lease = bootstrap.lease;
+    let mut signed = bootstrap.signed;
+    let mut node = Node::open(&directory.join("validator"), settings.clone(), 2)?;
+    let mut renewals = 0;
+    let mut proof_bytes = 0_u64;
+    let mut packet_bytes = 0_u64;
+    let mut first = None;
+    for height in 1..=BLOCKS {
+        let active = node.active()?.0;
+        let current = admission(&signed, &lease, material(&model, &input, &a, &b), height)?;
+        let mut next = None;
+        let txs = if height.is_multiple_of(900) {
+            let (raw, newlease, newsigned) = renewal(&node, &signed, &lease, height)?;
+            next = Some((newlease, newsigned));
+            renewals += 1;
+            vec![raw]
+        } else {
+            vec![]
+        };
+        let packet = node.make_with_task(
+            active,
+            txs,
+            development_public(3)?,
+            genesis + height * 10,
+            4096,
+            &current,
+            material(&model, &input, &a, &b),
+        )?;
+        let encoded = packet.encode()?;
+        proof_bytes += packet.proof.len() as u64;
+        packet_bytes += encoded.len() as u64;
+        fs::write(
+            directory.join("packets").join(format!("{height:05}.bin")),
+            encoded,
+        )?;
+        let id = node.admit(&packet, ingress::now()?)?;
+        node.activate_observed(id, ingress::now()?)?;
+        if height == 1 {
+            first = Some(id);
+        }
+        if let Some((newlease, newsigned)) = next {
+            lease = newlease;
+            signed = newsigned;
+        }
+        if height.is_multiple_of(900) || height == 1001 || height == 4097 {
+            let before = node.read_active()?;
+            drop(node);
+            node = Node::open(&directory.join("validator"), settings.clone(), 2)?;
+            if node.read_active()? != before {
+                return Err("REOPEN_STATE".into());
+            }
+        }
+        if height.is_multiple_of(500) {
+            println!(
+                "{}",
+                json!({"kind":"actual-pnw1-progress","height":height,"elapsed_ns":started.elapsed().as_nanos()})
+            );
+        }
+    }
+    let tip = node.active()?.0;
+    let expected = node.read_active()?;
+    drop(node);
+    // A random altered active-row seal must refuse reopen without repair.
+    let db = rusqlite::Connection::open(directory.join("validator/native.sqlite"))?;
+    let seal: Vec<u8> = db.query_row(
+        "SELECT seal FROM ancestry_jump WHERE block=? AND level=12",
+        [tip.as_slice()],
+        |r| r.get(0),
+    )?;
+    db.execute(
+        "UPDATE ancestry_jump SET seal=? WHERE block=? AND level=12",
+        rusqlite::params![[0_u8; 32].as_slice(), tip.as_slice()],
+    )?;
+    drop(db);
+    let rejected = Node::open(&directory.join("validator"), settings.clone(), 2)
+        .err()
+        .ok_or("CORRUPTION_ACCEPTED")?;
+    if rejected.to_string() != "ANCESTRY_INDEX_SEAL" {
+        return Err(format!("CORRUPTION_ERROR:{rejected}").into());
+    }
+    let db = rusqlite::Connection::open(directory.join("validator/native.sqlite"))?;
+    db.execute(
+        "UPDATE ancestry_jump SET seal=? WHERE block=? AND level=12",
+        rusqlite::params![seal, tip.as_slice()],
+    )?;
+    drop(db);
+    let node = Node::open(&directory.join("validator"), settings.clone(), 2)?;
+    let listener = TcpListener::bind("127.0.0.1:0")?;
+    let address = listener.local_addr()?;
+    let stop = Arc::new(AtomicBool::new(false));
+    let signal = stop.clone();
+    let server_pin = identity(111).public_key().to_owned();
+    let policy = PublicPolicy::new(8, Duration::from_secs(2))?;
+    let worker = thread::spawn(move || {
+        let service_started = Instant::now();
+        let stop_when_exited = signal.clone();
+        let service_result = public_v2::serve_public_protected_v2(
+            listener,
+            node,
+            Duration::from_secs(1800),
+            signal,
+            PublicServer::new(identity(111), policy).unwrap(),
+        );
+        let server_error = service_result.as_ref().err().map(ToString::to_string);
+        let loop_exit = service_result
+            .as_ref()
+            .ok()
+            .and_then(|metrics| metrics.loop_exit.as_ref());
+        // Retain the original finite lifetime and all RPC/proof budgets.
+        // An observed refusal alone cannot distinguish a timed server exit
+        // from a transport failure unless the real server exit is recorded.
+        // The legacy post-return stop field includes the server's own cleanup;
+        // only loop_exit observes the termination condition before that write.
+        println!(
+            "{}",
+            json!({
+                "schema": "native-ancestry-public-server-exit-evidence-v1",
+                "configured_lifetime_seconds": 1800,
+                "service_elapsed_ns": service_started.elapsed().as_nanos(),
+                "stop_requested_when_exited": stop_when_exited.load(Ordering::SeqCst),
+                "loop_exit_before_internal_shutdown": loop_exit,
+                "server_exit_ok": service_result.is_ok(),
+                "server_exit_error": server_error,
+                "scope": "actual native loopback server; observation only, not a readiness or qualification verdict",
+                "production_activation": false
+            })
+        );
+        service_result
+    });
+    // Retain only fixed-size location/timing state while the original calls run.
+    // Emit it with the existing exit record, after success or failure returns.
+    let mut sync_stage = "open-confirmer";
+    let mut completed_import_calls = 0_u64;
+    let mut last_successful_after = None;
+    let mut last_requested_after = None;
+    let mut advertised_page_complete = None;
+    let mut head_rpc_elapsed_ns = None;
+    let mut history_rpc_elapsed_ns = None;
+    let mut import_call_elapsed_ns = None;
+    let mut legacy_reorg_observation_enabled = None;
+    let mut legacy_reorg_observation_before = None;
+    let mut legacy_reorg_observation_after = None;
+    // Independent diagnostic build: retain every attempted call, including failure.
+    let mut diagnostic_rpc = Vec::new();
+    let mut diagnostic_import = Vec::new();
+    let sync_result = (|| -> Result<(u64, u64, u64)> {
+        let mut confirmer = Node::open(&directory.join("confirmer"), settings.clone(), 2)?;
+        legacy_reorg_observation_enabled = Some(confirmer.enable_native_legacy_reorg_observation());
+        legacy_reorg_observation_before = Some(confirmer.native_history_arithmetic_observation());
+        let replay_result: Result<_> = (|| {
+            let caller = identity(112);
+            sync_stage = "head-rpc";
+            let call_started = Instant::now();
+            let head_result = public_v2::call_public_protected_v2(
+                address,
+                &Request::Head,
+                &settings,
+                &server_pin,
+                &caller,
+                policy,
+            );
+            head_rpc_elapsed_ns = Some(call_started.elapsed().as_nanos());
+            let head = head_result?;
+            sync_stage = "head-response-check";
+            if !head.ok || head.value["tip"] != hex::encode(tip) || head.value["height"] != BLOCKS {
+                return Err("PUBLIC_HEAD".into());
+            }
+            let mut after = settings.genesis();
+            last_successful_after = Some(after);
+            let mut count = 0;
+            let mut trials = 0;
+            let mut solve_ns = 0;
+            while after != tip {
+                sync_stage = "history-rpc";
+                last_requested_after = Some(after);
+                advertised_page_complete = None;
+                import_call_elapsed_ns = None;
+                let call_started = Instant::now();
+                let reply_result = public_v2::call_public_protected_v2(
+                    address,
+                    &Request::History {
+                        tip: hex::encode(tip),
+                        after: hex::encode(after),
+                    },
+                    &settings,
+                    &server_pin,
+                    &caller,
+                    policy,
+                );
+                history_rpc_elapsed_ns = Some(call_started.elapsed().as_nanos());
+                diagnostic_rpc.push(json!({"after":hex::encode(after), "elapsed_ns":history_rpc_elapsed_ns, "ok":reply_result.is_ok(), "error":reply_result.as_ref().err().map(ToString::to_string)}));
+                let reply = reply_result?;
+                sync_stage = "history-response-check";
+                if !reply.ok {
+                    return Err(format!("PUBLIC_HISTORY_REFUSED:{}", reply.value).into());
+                }
+                trials += reply.solve_trials;
+                solve_ns += reply.solve_elapsed_ns;
+                sync_stage = "decode-page";
+                let page: Page = serde_json::from_value(reply.value)?;
+                advertised_page_complete = Some(page.complete);
+                sync_stage = "page-count-check";
+                if page.packets.len() != 1 {
+                    return Err("PAGE_COUNT".into());
+                }
+                sync_stage = "first-packet-check";
+                if count == 0
+                    && Packet::decode(&hex::decode(&page.packets[0]).map_err(codec)?)?.id()?
+                        != first.ok_or("FIRST")?
+                {
+                    return Err("LONG_FIRST_PAGE".into());
+                }
+                sync_stage = "import-call-expression";
+                let observer = ingress::HistoryImportObserver::new();
+                let call_started = Instant::now();
+                let clock = ingress::now()?;
+                let import_result = ingress::receive_public_page_from_before_observed(
+                    &mut confirmer,
+                    address,
+                    page,
+                    tip,
+                    after,
+                    clock,
+                    Instant::now() + Duration::from_secs(30),
+                    Some(&observer),
+                );
+                import_call_elapsed_ns = Some(call_started.elapsed().as_nanos());
+                diagnostic_import.push(json!({"after":hex::encode(after), "elapsed_ns":import_call_elapsed_ns, "ok":import_result.is_ok(), "error":import_result.as_ref().err().map(ToString::to_string), "observation":observer.snapshot()}));
+                after = import_result?;
+                count += 1;
+                completed_import_calls = count;
+                last_successful_after = Some(after);
+                sync_stage = "partial-active-check";
+                if count < BLOCKS && confirmer.active()?.0 != settings.genesis() {
+                    return Err("PARTIAL_SYNC_ACTIVATED".into());
+                }
+                if count.is_multiple_of(500) {
+                    println!(
+                        "{}",
+                        json!({"kind":"independent-native-fullsync-progress","height":count,"elapsed_ns":started.elapsed().as_nanos()})
+                    );
+                }
+            }
+            sync_stage = "final-active-read";
+            let confirmed = confirmer.read_active()?;
+            sync_stage = "final-state-check";
+            if count != BLOCKS || confirmed.0 != expected.0 || confirmed.2 != expected.2 {
+                return Err("CONFIRMATION_STATE".into());
+            }
+            Ok((count, trials, solve_ns, confirmed))
+        })();
+        // Preserve the original replay Result through diagnostic readback.
+        // No reset, clock verdict or new error is introduced before propagation.
+        legacy_reorg_observation_after = Some(confirmer.native_history_arithmetic_observation());
+        let (count, trials, solve_ns, confirmed) = replay_result?;
+        drop(confirmer);
+        sync_stage = "reopen-read-and-compare";
+        if Node::open(&directory.join("confirmer"), settings.clone(), 2)?.read_active()?
+            != confirmed
+        {
+            return Err("CONFIRMER_REOPEN".into());
+        }
+        Ok((count, trials, solve_ns))
+    })();
+    // Preserve the failing independent-replay error before requesting the
+    // original server shutdown. No test assertion or acceptance is weakened.
+    println!(
+        "{}",
+        json!({
+            "schema": "native-ancestry-independent-sync-exit-evidence-v1",
+            "diagnostic_only": true,
+            "diagnostic_scope": "instrumented campaign; retains all attempted calls; nested phase and Host CPU are not additive; buffering and observer overhead remain included in service lifetime; not original resource qualification",
+            "diagnostic_history_rpc": diagnostic_rpc,
+            "diagnostic_import": diagnostic_import,
+            "elapsed_ns": started.elapsed().as_nanos(),
+            "sync_error": sync_result.as_ref().err().map(ToString::to_string),
+            "native_legacy_reorg_observation": {
+                "schema": "native-ancestry-legacy-reorg-observation-pair-v1",
+                "enabled": legacy_reorg_observation_enabled,
+                "before": legacy_reorg_observation_before,
+                "after": legacy_reorg_observation_after,
+                "scope": "Two cumulative snapshots of the same confirmer after its first open and after the original replay Result returns, before its first close. Cold reopen and Node drop are outside this pair. No reset or per-call history is retained; native errors and unreturned observations are not replaced.",
+                "delta_computed": false,
+                "production_activation": false
+            },
+            "failure_location": sync_result.as_ref().err().map(|_| json!({
+                "schema": "native-ancestry-independent-sync-failure-location-v1",
+                "stage": sync_stage,
+                "completed_import_calls": completed_import_calls,
+                "last_successful_after": last_successful_after.map(hex::encode),
+                "last_requested_after": last_requested_after.map(hex::encode),
+                "pinned_tip": hex::encode(tip),
+                "advertised_page_complete": advertised_page_complete,
+                "head_rpc_elapsed_ns": head_rpc_elapsed_ns,
+                "last_history_rpc_elapsed_ns": history_rpc_elapsed_ns,
+                "last_import_call_expression_elapsed_ns": import_call_elapsed_ns,
+                "durable_committed_blocks": null,
+                "activation_cursor": null,
+                "scope": "Original returning call expressions before confirmer cleanup; import includes existing clock argument preparation. Completed imports are successful returns, not durable commit counts. Page completion is the unvalidated reply value; unreturned call timing remains null.",
+                "production_activation": false
+            })),
+            "scope": "observed signed full-history replay, not a qualification verdict",
+            "production_activation": false
+        })
+    );
+    stop.store(true, Ordering::SeqCst);
+    let metrics = worker.join().map_err(|_| "SERVER_JOIN")??;
+    let (confirmed, solve_trials, solve_ns) = sync_result?;
+    let stats = Node::open(&directory.join("validator"), settings.clone(), 2)?.stats()?;
+    for key in [
+        "authenticated_sessions",
+        "authenticated_pending",
+        "authenticated_audit_rows",
+        "authenticated_outbox_sessions",
+        "authenticated_outbox_pending",
+    ] {
+        if stats[key] != 0 {
+            return Err("GUEST_DURABLE_IDENTITY".into());
+        }
+    }
+    Ok(
+        json!({"schema":"native-history-stage-diagnostic-v1","diagnostic_only":true,"resource_qualification":false,"passed":true,"blocks":BLOCKS,"confirmed_packets":confirmed,"renewals":renewals,"proof_bytes":proof_bytes,"packet_bytes":packet_bytes,"per_page_sql_hard_cap":1024,"pinned_tip":hex::encode(tip),"public_solver_trials":solve_trials,"public_solver_ns":solve_ns,"public_metrics":metrics,"corrupt_active_index_reopen_refused":true,"elapsed_ns":started.elapsed().as_nanos(),"scope":"actual PNW1/native ledger/V3 renewals and separate verifier over paid loopback public RPC; logical header time, development source keys, single host, no WAN or independent measurement claim","public_network_ready":false,"hardness_accepted":false,"independent_accepted":false,"production_activation":false}),
+    )
+}
+#[test]
+#[ignore = "release actual 4105-PNW1 block V3 chain and 4105 paid public full-sync pages; run in a quiet resource window"]
+fn actual_v3_long_chain_public_full_sync_reopen_and_corrupt_index_refusal() {
+    let temporary = tempfile::tempdir().unwrap();
+    let directory = match std::env::var_os("TRNM_INDEX_EVIDENCE_DIRECTORY") {
+        Some(path) => {
+            let p = std::path::PathBuf::from(path);
+            fs::create_dir(&p).unwrap();
+            p
+        }
+        None => temporary.path().join("observation"),
+    };
+    if !directory.exists() {
+        fs::create_dir(&directory).unwrap();
+    }
+    let result = run(&directory);
+    let summary = match &result {
+        Ok(value) => value.clone(),
+        Err(error) => {
+            json!({"schema":"native-history-stage-diagnostic-v1","diagnostic_only":true,"resource_qualification":false,"passed":false,"error":error.to_string(),"public_network_ready":false,"hardness_accepted":false,"independent_accepted":false,"production_activation":false})
+        }
+    };
+    fs::write(
+        directory.join("summary.json"),
+        serde_json::to_vec_pretty(&summary).unwrap(),
+    )
+    .unwrap();
+    println!("{}", summary);
+    result.unwrap();
+}
