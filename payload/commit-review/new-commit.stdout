work.rs\"\n+old=(D/\"changed\"/(p.replace(\"/\",\"--\")+\".before\")).read_bytes()\n+new=(D/\"changed\"/(p.replace(\"/\",\"--\")+\".current\")).read_bytes()\n+anchor=b\"    let (a, tail) = matrices.split_at(CELLS);\"\n+old_tail=old.index(anchor,old.index(b\"fn verify_with_kernel<\"))\n+new_tail=new.index(anchor,new.index(b\"fn verify_checked_with_kernel<\"))\n+body_same=old[old_tail:]==new[new_tail:]\n+assert body_same\n+after={\"head\":git([\"rev-parse\",\"HEAD\"]).decode().strip(),\"tree\":git([\"rev-parse\",\"HEAD^{tree}\"]).decode().strip(),\"status\":git([\"status\",\"--porcelain=v1\",\"--untracked-files=all\"]).decode()}\n+assert before==after\n+result={\"schema\":\"hash-use-current-provenance-consumer-scope-readonly-v1\",\"source_before\":before,\"source_after\":after,\"proposal\":schema,\"originals\":originals,\"original_test_roster\":roster,\"profile_version_provenance\":profile_versions,\"all_profile_fields_except_mapping_contract_unchanged\":True,\"direct_consumer_search\":search,\"direct_consumer_excerpts\":excerpts,\"exact_declared_function_spans\":function_checks,\"pon_work_entire_suffix_from_checked_matrices_unchanged\":body_same,\"no_tests_run\":True,\"no_source_edits\":True,\"review_note\":\"Review-base remains the historical semantic context. A manually reviewed new selected-source map is a new observation of current bytes, not a rewrite of a historical result. No whole-callgraph or cryptographic qualification.\"}\n+meta=dump(\"summary.json\",result)\n+print(json.dumps({\"summary\":meta,\"proposal\":schema,\"originals_same\":all(x[\"whole_raw_same\"] for x in originals.values()),\"functions_same\":all(x[\"same_raw_span\"] for x in function_checks),\"tests_run\":False}),flush=True)"},{"sha":"e85178188920b8af81075d6f1a660d6257f0fade","filename":"evidence/hash-use-current-source-review-20261114/diagnostics/scope-v1-failure.json","status":"added","additions":9,"deletions":0,"changes":9,"blob_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/blob/5df7ae6f482157c5f7fdcbcd52222117a965053f/evidence%2Fhash-use-current-source-review-20261114%2Fdiagnostics%2Fscope-v1-failure.json","raw_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/raw/5df7ae6f482157c5f7fdcbcd52222117a965053f/evidence%2Fhash-use-current-source-review-20261114%2Fdiagnostics%2Fscope-v1-failure.json","contents_url":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/contents/evidence%2Fhash-use-current-source-review-20261114%2Fdiagnostics%2Fscope-v1-failure.json?ref=5df7ae6f482157c5f7fdcbcd52222117a965053f","patch":"@@ -0,0 +1,9 @@\n+{\n+  \"schema\": \"readonly-hash-use-diagnostic-failure-v1\",\n+  \"project_tests_run\": false,\n+  \"source_modified\": false,\n+  \"reason\": \"The broad byte anchor occurs in more than one function; the read-only diagnostic stopped at its uniqueness assertion. The next diagnostic scopes the anchor to the named verifier function.\",\n+  \"pty_session\": \"dpty-2ccc25866aa3141e352cdca4800551e42ba4fa653a99c9db4ad043e9fe05ebe0\",\n+  \"pty_exit\": 1,\n+  \"original_pty_text\": \"Traceback (most recent call last):\\r\\n  File \\^[[35m\\\"<string>\\\"\\^[[0m, line \\^[[35m74\\^[[0m, in \\^[[35m<module>\\^[[0m\\r\\n    assert \\^[[1;31mold.count(anchor)==new.count(anchor)==1\\^[[0m\\r\\n           \\^[[1;31m^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\\^[[0m\\r\\n\\^[[1;35mAssertionError\\^[[0m\\r\\n\"\n+}"},{"sha":"b5c9a849709a8b4609d6d9922a726b9329e9a79a","filename":"evidence/hash-use-current-source-review-20261114/diagnostics/validation_driver.py","status":"added","additions":62,"deletions":0,"changes":62,"blob_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/blob/5df7ae6f482157c5f7fdcbcd52222117a965053f/evidence%2Fhash-use-current-source-review-20261114%2Fdiagnostics%2Fvalidation_driver.py","raw_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/raw/5df7ae6f482157c5f7fdcbcd52222117a965053f/evidence%2Fhash-use-current-source-review-20261114%2Fdiagnostics%2Fvalidation_driver.py","contents_url":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/contents/evidence%2Fhash-use-current-source-review-20261114%2Fdiagnostics%2Fvalidation_driver.py?ref=5df7ae6f482157c5f7fdcbcd52222117a965053f","patch":"@@ -0,0 +1,62 @@\n+import ast, datetime, hashlib, json, os, pathlib, re, subprocess, sys, time\n+sys.dont_write_bytecode=True\n+W=pathlib.Path(\"/private/tmp/chain-hash-use-current-binding-20261114\")\n+E=pathlib.Path(\"/private/tmp/chain-hash-use-current-binding-evidence-20261114\")\n+V=E/\"validation-v1\";V.mkdir();T=V/\"tmp\";T.mkdir()\n+HEAD=\"7d8d4c59fcd01480a12e1c64835b202079091800\"\n+env=dict(os.environ,PATH=\"/Users/qianqi/.rustup/toolchains/1.95.0-aarch64-apple-darwin/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin\",GIT_NO_REPLACE_OBJECTS=\"1\",GIT_NO_LAZY_FETCH=\"1\",GIT_OPTIONAL_LOCKS=\"0\",GIT_TERMINAL_PROMPT=\"0\",PYTHONDONTWRITEBYTECODE=\"1\",PYTHONOPTIMIZE=\"0\",TMPDIR=str(T))\n+steps=[];started=datetime.datetime.now(datetime.timezone.utc).isoformat()\n+def sh(b):return hashlib.sha256(b).hexdigest()\n+def save(name,b):\n+ p=V/name\n+ with p.open(\"xb\") as f:f.write(b)\n+ return {\"path\":str(p),\"bytes\":len(b),\"sha256\":sh(b)}\n+def dump(name,v):return save(name,(json.dumps(v,indent=2,sort_keys=True)+\"\\n\").encode())\n+def run(label,args,timeout=120):\n+ t=time.monotonic();r=subprocess.run(args,cwd=W,env=env,stdout=subprocess.PIPE,stderr=subprocess.PIPE,timeout=timeout)\n+ step={\"label\":label,\"argv\":args,\"cwd\":str(W),\"exit_code\":r.returncode,\"elapsed_seconds\":round(time.monotonic()-t,3),\"timeout_seconds\":timeout,\"stdout\":save(label+\".stdout\",r.stdout),\"stderr\":save(label+\".stderr\",r.stderr)}\n+ steps.append(step);dump(\"step-\"+str(len(steps)).zfill(2)+\".json\",step)\n+ print(json.dumps({\"label\":label,\"exit_code\":r.returncode,\"seconds\":step[\"elapsed_seconds\"]}),flush=True)\n+ return r\n+sys.path.insert(0,str(W/\"scripts/ci\"))\n+from pq_source_reader import read_regular\n+m=json.loads((W/\"config/pon/hash-use-contract-v1.json\").read_bytes())\n+extra=[\"config/pon/hash-use-contract-v1.json\",\"scripts/ci/hash_use_contract.py\",\"scripts/ci/test_hash_use_contract.py\",\"scripts/ci/check_ci_contract.py\",\"scripts/ci/test_ci_contract.py\",\"docs/security/HASH_USE_CONTRACT_V1.md\"]\n+paths=sorted(set(m[\"source_files\"])|set(extra))\n+def snapshot():\n+ rows=[]\n+ for path in paths:\n+  b=read_regular(W,path,2*1024*1024)\n+  rows.append({\"path\":path,\"bytes\":len(b),\"sha256\":sh(b)})\n+ return rows\n+before=snapshot();dump(\"source-before.json\",before)\n+try:\n+ assert run(\"head\",[\"/usr/bin/git\",\"rev-parse\",\"HEAD\"]).stdout.decode().strip()==HEAD\n+ assert run(\"preflight\",[\"/bin/bash\",\"scripts/project-preflight.sh\"]).returncode==0\n+ run(\"python-version\",[sys.executable,\"-B\",\"-c\",\"import sys,json; print(json.dumps({'version':sys.version,'executable':sys.executable,'optimize':sys.flags.optimize}))\"])\n+ tests=run(\"original-33-controls\",[sys.executable,\"-B\",\"scripts/ci/test_hash_use_contract.py\",\"-v\"])\n+ actual=run(\"actual-hash-use-inspection\",[sys.executable,\"-B\",\"scripts/ci/hash_use_contract.py\"])\n+ target=\"test_hash_use_commands_cannot_change_position_multiplicity_or_failure_policy\"\n+ tree=ast.parse((W/\"scripts/ci/test_ci_contract.py\").read_text())\n+ holders=[node.name for node in tree.body if isinstance(node,ast.ClassDef) and any(isinstance(f,ast.FunctionDef) and f.name==target for f in node.body)]\n+ assert len(holders)==1\n+ selector=holders[0]+\".\"+target\n+ ci_negative=run(\"original-hash-ci-command-refusals\",[sys.executable,\"-B\",\"scripts/ci/test_ci_contract.py\",selector,\"-v\"])\n+ ci_actual=run(\"actual-ci-contract\",[sys.executable,\"-B\",\"scripts/ci/check_ci_contract.py\"])\n+ diffcheck=run(\"changed-source-diff-check\",[\"/usr/bin/git\",\"diff\",\"--check\",\"--\",\"config/pon/hash-use-contract-v1.json\",\"scripts/ci/hash_use_contract.py\",\"docs/security/HASH_USE_CONTRACT_V1.md\"])\n+ after=snapshot();dump(\"source-after.json\",after);assert before==after\n+ results=re.findall(rb\"Ran ([0-9]+) tests? in\",tests.stderr);assert results==[b\"33\"]\n+ ci_results=re.findall(rb\"Ran ([0-9]+) tests? in\",ci_negative.stderr);assert ci_results==[b\"1\"]\n+ actual_report=json.loads(actual.stdout)\n+ assert actual_report[\"status\"]==\"HOLD_NO_GO\" and actual_report[\"declared_use_count\"]==19 and actual_report[\"declared_source_count\"]==31\n+ assert actual_report[\"source_files_checked\"] is True and actual_report[\"production_activation\"] is False and actual_report[\"whole_chain_pq_qualified\"] is False\n+ assert actual_report[\"reviewed_source_map_sha256\"]==\"15a8d91e0b2c50908d17c6bb9743e8ef5a44927814e59354874d77d9654f9ee7\"\n+ all_pass=all(s[\"exit_code\"]==0 for s in steps)\n+ summary={\"schema\":\"hash-use-reviewed-current-map-validation-v1\",\"started_utc\":started,\"finished_utc\":datetime.datetime.now(datetime.timezone.utc).isoformat(),\"base_head\":HEAD,\"working_source_changed_only_by_reviewed_patch\":True,\"status\":\"PASS\" if all_pass else \"FAIL\",\"steps\":steps,\"original_hash_use_tests\":33,\"original_hash_use_test_methods_changed\":0,\"original_ci_command_guard_test\":selector,\"original_ci_command_guard_methods\":1,\"actual_inspect_status\":actual_report[\"status\"],\"actual_inspect_source_count\":actual_report[\"declared_source_count\"],\"source_snapshot_unique_inputs\":len(before),\"source_before_after_equal\":before==after,\"full_repository_truth_lane_run\":False,\"root_diagnostic_122_commands_rerun\":False,\"native_or_hosted_tests_run\":False,\"corpus_and_soleplan_pending_root_composition\":True,\"original_7d8_full_lane_failure_unchanged\":True}\n+ meta=dump(\"summary.json\",summary);dump(\"steps.json\",steps)\n+ print(json.dumps({\"summary\":meta,\"status\":summary[\"status\"],\"original_controls\":33,\"direct_ci_guard\":1,\"source_inputs\":len(before),\"full_lane_run\":False}),flush=True)\n+ sys.exit(0 if all_pass else 1)\n+except BaseException as ex:\n+ if isinstance(ex,SystemExit):raise\n+ dump(\"failure.json\",{\"type\":type(ex).__name__,\"error\":str(ex),\"steps\":steps})\n+ raise"},{"sha":"d912dc2e923b1e39bab1661d5616e90873c74522","filename":"evidence/hash-use-current-source-review-20261114/historical-57b069ae/contract.md.original","status":"added","additions":181,"deletions":0,"changes":181,"blob_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/blob/5df7ae6f482157c5f7fdcbcd52222117a965053f/evidence%2Fhash-use-current-source-review-20261114%2Fhistorical-57b069ae%2Fcontract.md.original","raw_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/raw/5df7ae6f482157c5f7fdcbcd52222117a965053f/evidence%2Fhash-use-current-source-review-20261114%2Fhistorical-57b069ae%2Fcontract.md.original","contents_url":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/contents/evidence%2Fhash-use-current-source-review-20261114%2Fhistorical-57b069ae%2Fcontract.md.original?ref=5df7ae6f482157c5f7fdcbcd52222117a965053f","patch":"@@ -0,0 +1,181 @@\n+# Hash purposes, inputs and migration contract V1\n+\n+Status: **HOLD / NO-GO**. This is a source-bound review contract, not a\n+cryptographic qualification or a change to an active network format.\n+\n+The [manifest](../../config/pon/hash-use-contract-v1.json) and\n+[checker](../../scripts/ci/hash_use_contract.py) make the distinction between\n+hash purposes executable. A named algorithm, output width, valid signature or\n+consistent source digest must not silently become a claim about all objects\n+reachable through that digest. Both the checker and its\n+[negative controls](../../scripts/ci/test_hash_use_contract.py) run in the\n+mandatory `repository-truth` lane.\n+\n+## Composed W1 mapping review, 2026-11-12 America/New_York\n+\n+The integration combines the 19-use, 31-source TCG3/CMH2 review from #927\n+with #935's fixed 139-input mapping and #931's upstream withdrawal policy.\n+Only the proof-binding descriptor pin changes inside the 31-source table:\n+its 2,378 bytes now hash to\n+`48606e3eb29fb1a8b2613f268bc828c120bd4720b40398afc1c6bf55d1981de2`.\n+All other table entries match their reviewed source bytes; the purpose/game\n+semantics digest remains unchanged. The resulting fixed source-map digest is\n+`5255345f514f5ac0e0abc92a9c756f35c81eed4c880c0108019be408b0fd4d69`.\n+\n+Both profile readers pin the same 44,427-byte mapping. Its selected historical\n+proof identity is still withdrawn: the approved-current-profile list remains\n+empty and `--require-current` refuses it. This source reconciliation executes no\n+proof verifier and supplies no current proof-use or production qualification.\n+\n+## Candidate and existing work\n+\n+This continuation starts from PR #876 at\n+`e4abb172147e941b62483652b0ceabaae4317624`. Its native hash owners, signed domains,\n+stored schemas and production activation policy remain the baseline. The\n+existing [CCH1 full-content interfaces](CPQ1_FULL_CONTENT_COMMITMENTS_V1.md)\n+already distinguish observed bytes from old digest wrappers. They are existing\n+implementation, not a new result of this contract.\n+\n+The separate PR #844 at `f7be5b9dc06faa3c4882819adbe238cbe48c3438`\n+adds lifetime composition and query-budget-overrun accounting. PR #864 at\n+`7b7826c5c9623a1310969d1cbb636b4c66c1bc6d` reviews five archived content-to-use\n+records. Neither branch is an ancestor of this baseline. Their test counts and\n+observations are not transferred to this candidate. This contract supplements\n+the baseline [lifetime budget](PQ128_LIFETIME_BUDGET_V1.md) and\n+[root lifetime obligations](PQ_ROOT_LIFETIME_GAPS_V2.md); it does not replace\n+their missing reductions with generic query exponents.\n+\n+## Current composition scope\n+\n+The account, TLS and Root continuation retained the original 17-use / 26-path\n+contract. The typed content/history continuation preserves those 17 use\n+definitions and adds two explicitly scoped uses, giving 19 uses and 31 reviewed\n+source paths. Its [TCG3 and CMH2 contract](CONTENT_GRAPH_AND_HISTORY_READBACK_V1.md)\n+distinguishes declared typed-graph traversal and a bounded complete-State\n+ancestry archive from live adoption and historical provenance. The added V5 Root witness enrollment,\n+policy binding, request digest and receipt obligations are recorded separately\n+by the [41-path Root dependency register](PQ_ROOT_DEPENDENCY_REGISTER_V3.md).\n+Account development-scope checks restrict executable configurations without\n+changing the retained hash encodings. These inventories do not establish their\n+union as a complete call graph, shared-query allocation or lifetime failure\n+bound. The V5 typed owner is not an installed witness daemon or effect sink.\n+\n+## The security game comes before the bit count\n+\n+| Purpose | Attacker's choice and protected event | Required distinction |\n+| --- | --- | --- |\n+| Fixed-target preimage | A target output is fixed independently of the search; find an accepted input | The exact accepted domain, number of targets and oracle must be fixed |\n+| Second preimage | A specific original object is fixed before the replacement search | Preprocessing, advice, message length and the original selection procedure matter |\n+| Chosen-pair collision | Prepare two different objects, obtain acceptance of one, then substitute the other | A later signature does not make the earlier chosen-pair search a fixed-target game |\n+| Merkle/content binding | Open an accepted commitment to a different object or ordered tree | Include leaf/node roles, framing, tree shape, index, count and all digest dependencies |\n+| Signature authorization | An unauthorized message is accepted under a permitted key/role | Message binding is one component; the signature and current authority need their own games |\n+| Work threshold | Find a valid ticket satisfying the actual target and full relation | Generic preimage or collision estimates do not establish the cheapest legal mining strategy |\n+| Fiat-Shamir/PCS | A verifier accepts a false statement in the actual proof system | Fix the transcript, parameters, oracle model, recursion and project reduction |\n+\n+For sufficiently large-domain ideal random functions at constant success\n+probability, single-target preimage search has a generic query exponent near\n+`n/2`; chosen-pair collision search has one near `n/3`. Thus 256-bit outputs\n+suggest 128 and 85.33... respectively; 384 suggests 192 and 128; 512 suggests\n+256 and 170.66.... These are illustrative query-work exponents. They are not\n+actual SHA security probabilities, circuit costs, or lifetime PQ128 guarantees.\n+\n+In particular, reaching constant success after about `2^128` queries is a\n+different assertion from lifetime failure probability at most `2^-128`.\n+Unknown query counts, constants, multi-target factors, model replacement and\n+reduction losses remain unknown. Domain or epoch changes do not create a new\n+independent public SHA primitive or erase preprocessing already performed.\n+\n+## Actual owners and migration boundary\n+\n+The machine register binds the reviewed source bytes and the exact uses in its\n+declared roster. It is deliberately not an automatically proved whole-repository\n+call graph. Its digest checks establish source consistency, not an independent\n+review of those bytes or an authenticated deployment.\n+\n+| Owner/use in the baseline | What is actually committed | Consequence for migration |\n+| --- | --- | --- |\n+| TCM1/TCR1/TMR1 and router references | Legacy SHA-256 manifests and nested payload/dependency identifiers | A SHA-512 wrapper over these encodings does not strengthen the referenced content |\n+| Transaction sequence root | Leaves bind LE64 position and transaction bytes; empty/leaf/node tags differ and odd layers duplicate the last leaf | No explicit outer count field exists; tree shape, indexed leaves and accepted transaction bytes need their own binding analysis |\n+| Header/block history | SHA-256 block identity and 32-byte parent references | A new checkpoint commitment does not rebuild or authenticate all ancestors |\n+| TPQ1 verification and candidate content signature join | The complete TPQ1 unsigned frame or CPQ1 envelope containing a complete CCH1 record, under separately selected key/profile rules | These are signature observations; a digest's width does not establish current signing authority, custody, freshness or FinalUse |\n+| BEP52 pieces and internal nodes | The prescribed SHA-256 piece/tree format; node hashing has no CCH1 domain tag | Keep the format's actual geometry and verification rules; do not invent inherited domain separation |\n+| CCH1, TCM2/TCC2, CST1 and CMG1 | Actual bytes covered by their individually specified candidate adapters | Retain each adapter's direct-content, dependency and ancestry limits |\n+\n+For any deterministic wrapper `W`, `h(x) == h(y)` implies\n+`W(h(x)) == W(h(y))`. Length framing and a fresh outer domain do not recover\n+the distinction lost by `h`. A regression fixture can demonstrate this using\n+an explicitly short toy digest; that demonstrates the composition property,\n+not a practical SHA-256 collision.\n+\n+Computing a new content commitment requires the actual canonical object bytes\n+and the newly specified encoding. Production migration additionally needs an\n+independently pinned expected commitment, complete applicable dependency\n+readback, current migration authorization, retirement of obsolete authority\n+and owner/recovery state that cannot rewind consumed liabilities. These are\n+adoption obligations, not runtime properties proved by this checker. Historical\n+ambiguity, consumed effects, revocations and unknown external effects do not\n+disappear because new bytes have been hashed.\n+The existing CMG1 adapter still treats embedded ancestry IDs as references;\n+the existing TCC2 adapter covers its five declared direct dependencies, not\n+every transitive dependency of those objects.\n+\n+TCG3 separately parses every reachable typed node only after that node's actual\n+complete CCH1 readback, then follows all encoded edges. It does not discover\n+undeclared loader dependencies or establish that an absent ancestor never\n+existed. CMH2 separately reads actual genesis State/configuration and every\n+Header/trace/State through its selected checkpoint, within the explicit\n+32-block/32-MiB limits. Its Node adapter uses a single read snapshot. It does\n+not commit transaction/proof/receipt bodies or external effect journals,\n+reauthenticate lost history, reverify W1, authorize cutover or truncate a\n+longer history. Complete new expectations must be pinned independently.\n+\n+## Proof-system qualification remains separate\n+\n+The proof mapping records the concrete reviewed source and profile. A backend\n+label such as STARK, FRI or zkVM is not sufficient. Qualification must bind\n+the field and extension, degree bounds, rate/blowup, folding schedule, query\n+count and sampling, Merkle hash and consumed output length, transcript and\n+challenge mapping, grinding, batching, recursion depth, program/verifier key,\n+implementation and build. Shared hash calls and failed/helper work belong in\n+the same lifetime accounting where the common experiment requires it.\n+\n+A QROM theorem for one protocol class is not an automatic theorem for a\n+different multi-round IOP, recursive verifier or SHA implementation. Concrete\n+FRI work also distinguishes proved guarantees from conjectured security. This\n+register never fills these gaps by assigning zero loss or converting an output\n+width into a whole-chain security flag.\n+\n+## Validation and remaining obligations\n+\n+The checker rejects malformed/ambiguous contracts, incomplete declared rosters,\n+source drift, inconsistent game/selection claims and unsupported upgrades from\n+old digest references. Its source checks and unit controls are mandatory, once\n+each, in the straight-line `repository-truth` lane. The existing CI-contract\n+controls reject removal, duplication, movement, hidden branches and suppressed\n+failures. The corpus also pins the new contract and its implementation.\n+\n+```sh\n+python3 scripts/ci/test_hash_use_contract.py\n+python3 scripts/ci/hash_use_contract.py\n+python3 scripts/ci/test_ci_contract.py\n+python3 scripts/ci/check_ci_contract.py\n+python3 scripts/ci/test_pq_research_integration.py\n+python3 scripts/ci/check_pq_research_integration.py\n+```\n+\n+Successful execution establishes only the declared structural checks. Actual\n+security bits and lifetime failure remain null; whole-chain hash-scope closure,\n+PQ qualification and production activation remain false. A release still needs\n+the complete effect-bearing dependency map, applicable concrete reductions and\n+attacker-resource bounds, independently authorized migration/recovery, and\n+tests of the exact adopted joint candidate. The evidence packet records which\n+commands actually ran; commands documented here are not execution receipts.\n+\n+## Primary references\n+\n+- [Grover, database search](https://arxiv.org/abs/quant-ph/9605043): square-root search; this reference alone does not establish collision complexity.\n+- [Brassard, Hoyer and Tapp, collision problem](https://arxiv.org/abs/quant-ph/9705002): the r-to-one collision algorithm and time-space tradeoff.\n+- [Zhandry, quantum collision and set equality](https://arxiv.org/abs/1312.1027): random-function query bounds and their domain/range conditions.\n+- [NIST PQ evaluation criteria](https://csrc.nist.gov/Projects/Post-Quantum-Cryptography/Post-Quantum-Cryptography-Standardization/Evaluation-Criteria/Security-%28Evaluation-Criteria%29): security definitions and comparative resource categories, not a universal quantum bit conversion.\n+- [Don, Fehr, Majenz and Schaffner, Fiat-Shamir in the QROM](https://arxiv.org/abs/1902.07556): protocol-specific conditions for the quantum-oracle reduction.\n+- [Block and Tiwari, concrete non-interactive FRI](https://eprint.iacr.org/2024/1161): parameter-sensitive proved versus conjectured guarantees; not a project QROM qualification."},{"sha":"c2f7552fded037e2e6ff6a91609112ad7aa6b301","filename":"evidence/hash-use-current-source-review-20261114/historical-57b069ae/manifest.json","status":"added","additions":1669,"deletions":0,"changes":1669,"blob_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/blob/5df7ae6f482157c5f7fdcbcd52222117a965053f/evidence%2Fhash-use-current-source-review-20261114%2Fhistorical-57b069ae%2Fmanifest.json","raw_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/raw/5df7ae6f482157c5f7fdcbcd52222117a965053f/evidence%2Fhash-use-current-source-review-20261114%2Fhistorical-57b069ae%2Fmanifest.json","contents_url":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/contents/evidence%2Fhash-use-current-source-review-20261114%2Fhistorical-57b069ae%2Fmanifest.json?ref=5df7ae6f482157c5f7fdcbcd52222117a965053f","patch":"@@ -0,0 +1,1669 @@\n+{\n+  \"schema\": \"trnm-hash-use-contract-v1\",\n+  \"purpose\": \"reviewed-source-obligation-inventory\",\n+  \"review_base_revision\": \"e4abb172147e941b62483652b0ceabaae4317624\",\n+  \"source_binding\": \"declared-path-bytes-only-not-authenticated-history\",\n+  \"primitives\": {\n+    \"sha256\": {\n+      \"construction\": \"FIPS180-4/SHA-256\",\n+      \"output_bits\": 256\n+    },\n+    \"sha384\": {\n+      \"construction\": \"FIPS180-4/SHA-384\",\n+      \"output_bits\": 384\n+    },\n+    \"sha512\": {\n+      \"construction\": \"FIPS180-4/SHA-512\",\n+      \"output_bits\": 512\n+    },\n+    \"sha3-512\": {\n+      \"construction\": \"FIPS202/SHA3-512\",\n+      \"output_bits\": 512\n+    },\n+    \"risc0-poseidon2\": {\n+      \"construction\": \"risc0-3.0.6/Poseidon2/BabyBear\",\n+      \"output_bits\": null\n+    }\n+  },\n+  \"games\": {\n+    \"fixed-target-preimage\": {\n+      \"selection_order\": \"target-digest-fixed-before-search\",\n+      \"attacker_output\": \"one-accepted-preimage-of-that-target\",\n+      \"qualification\": \"target-distribution-and-valid-input-domain-unqualified\"\n+    },\n+    \"fixed-message-second-preimage\": {\n+      \"selection_order\": \"complete-original-object-fixed-before-replacement-search\",\n+      \"attacker_output\": \"different-valid-object-with-the-fixed-original-digest\",\n+      \"qualification\": \"message-length-target-population-and-advice-unqualified\"\n+    },\n+    \"chosen-pair-collision\": {\n+      \"selection_order\": \"attacker-selects-both-objects-before-one-is-authorized\",\n+      \"attacker_output\": \"two-distinct-valid-objects-with-one-digest\",\n+      \"qualification\": \"valid-object-domain-and-authorization-reduction-unqualified\"\n+    },\n+    \"merkle-binding\": {\n+      \"selection_order\": \"depends-on-fixed-root-or-attacker-prepared-tree-game\",\n+      \"attacker_output\": \"conflicting-leaf-content-position-or-tree-opening\",\n+      \"qualification\": \"leaf-node-empty-shape-and-openings-reduction-unqualified\"\n+    },\n+    \"work-threshold-search\": {\n+      \"selection_order\": \"branch-context-and-threshold-fixed-before-each-search\",\n+      \"attacker_output\": \"legal-complete-W1-candidate-with-ticket-at-most-target\",\n+      \"qualification\": \"target-is-a-set-not-a-single-digest-and-work-cost-is-unqualified\"\n+    },\n+    \"proof-soundness-qrom\": {\n+      \"selection_order\": \"adaptive-statements-and-transcripts-in-a-complete-proof-game\",\n+      \"attacker_output\": \"accepting-proof-of-a-false-complete-statement\",\n+      \"qualification\": \"PCS-FS-recursion-extraction-and-concrete-oracle-losses-unqualified\"\n+    }\n+  },\n+  \"uses\": {\n+    \"model-legacy-root\": {\n+      \"category\": \"model\",\n+      \"source_paths\": [\n+        \"trillionnium/crates/trnm-data-availability/src/cell/model_root.rs\",\n+        \"trillionnium/crates/trnm-data-availability/src/cell/manifest.rs\",\n+        \"trillionnium/crates/trnm-data-availability/src/cell/closure.rs\"\n+      ],\n+      \"symbols\": [\n+        \"CellModelReleaseRootV1::id\",\n+        \"router_commitment\",\n+        \"CellManifestV1::id\",\n+        \"CellReleaseManifestV1::id\"\n+      ],\n+      \"primitives\": [\n+        \"sha256\"\n+      ],\n+      \"encoding\": {\n+        \"record\": \"TMR1/TCD1/TCM1/TCR1\",\n+        \"framing\": \"Versioned encodings with lengths; TMR1 embeds the closure, router digest and canonical ordered direct lineage IDs.\",\n+        \"domains\": [\n+          \"trnm.cell-model-release-root.v1\\\\0\",\n+          \"trnm.cell-model-router-roster.v1\\\\0\",\n+          \"trnm.cell-manifest.v1\\\\0\",\n+          \"trnm.cell-release-manifest.v1\\\\0\"\n+        ]\n+      },\n+      \"attack_games\": [\n+        \"fixed-message-second-preimage\",\n+        \"chosen-pair-collision\"\n+      ],\n+      \"attacker_control\": \"A fixed accepted object gives a replacement game; an attacker who prepares both valid candidates before authorization gives a different collision game. Validity and actual owner authority remain separate constraints.\",\n+      \"input_scope\": \"The manifest/root literal bytes are hashed; embedded payload, chunk and dependency digests do not re-read their referenced objects.\",\n+      \"legacy_reference_roles\": [\n+        \"payload\",\n+        \"chunks\",\n+        \"base\",\n+        \"parent\",\n+        \"tokenizer\",\n+        \"layout\",\n+        \"runtime\",\n+        \"router\",\n+        \"lineage\"\n+      ],\n+      \"migration\": {\n+        \"input_material\": \"unchanged-existing-format\",\n+        \"claimed_scope\": \"existing-format-only\",\n+        \"original_bytes_required\": false,\n+        \"old_commitment_strengthened\": false,\n+        \"historical_provenance_restored\": false,\n+        \"transitive_dependency_closure_proved\": false,\n+        \"adoption_status\": \"not-established\",\n+        \"requirements\": [\n+          \"new-versioned-domain-and-exact-canonical-encoding\",\n+          \"actual-original-content-before-any-full-content-claim\",\n+          \"independently-authenticated-expected-object-and-profile\",\n+          \"fresh-current-owner-authorization-for-the-new-format\",\n+          \"explicit-handling-of-every-retained-legacy-reference\",\n+          \"nonrewinding-recovery-frontier-and-surviving-liabilities\",\n+          \"explicit-retirement-and-downgrade-policy-before-adoption\"\n+        ]\n+      },\n+      \"open_obligations\": [\n+        \"Per-object replacement/collision game and valid model constraints.\",\n+        \"Fresh versioned full-content owner adoption; no automatic widening of TMR1 IDs.\"\n+      ],\n+      \"consumed_outputs\": {\n+        \"manifest_release_model_and_router_ids\": {\n+          \"primitive\": \"sha256\",\n+          \"consumed_bits\": 256,\n+          \"truncation\": \"none\",\n+          \"notes\": \"CellDigestV1 retains the complete 32-byte SHA-256 output.\"\n+        },\n+        \"embedded_payload_chunk_and_lineage_references\": {\n+          \"primitive\": \"sha256\",\n+          \"consumed_bits\": 256,\n+          \"truncation\": \"none\",\n+          \"notes\": \"Referenced legacy 32-byte digests remain 256-bit inputs; an outer root does not widen them.\"\n+        }\n+      }\n+    },\n+    \"model-full-payload\": {\n+      \"category\": \"model\",\n+      \"source_paths\": [\n+        \"trillionnium/crates/trnm-protocol/src/content_commitment.rs\",\n+        \"trillionnium/crates/trnm-data-availability/src/cell/content_v2.rs\"\n+      ],\n+      \"symbols\": [\n+        \"observe_reader\",\n+        \"CellContentManifestV2::verify_payload_reader\"\n+      ],\n+      \"primitives\": [\n+        \"sha512\"\n+      ],\n+      \"encoding\": {\n+        \"record\": \"CCH1/TCM2\",\n+        \"framing\": \"CCH1 header binds profile, content kind, instance, generation and exact length; TCM2 embeds the full payload claim.\",\n+        \"domains\": [\n+          \"TRNM/CPQ1/FullContent/SHA512/v1\\\\0\",\n+          \"CCH1 kind 3 ModelManifest\",\n+          \"CCH1 kind 4 ModelPayload\"\n+        ]\n+      },\n+      \"attack_games\": [\n+        \"fixed-message-second-preimage\",\n+        \"chosen-pair-collision\"\n+      ],\n+      \"attacker_control\": \"A fixed accepted object gives a replacement game; an attacker who prepares both valid candidates before authorization gives a different collision game. Validity and actual owner authority remain separate constraints.\",\n+      \"input_scope\": \"The typed adapter checks a separately pinned manifest claim and re-reads the actual complete payload; its five old dependency aliases are literal metadata.\",\n+      \"legacy_reference_roles\": [\n+        \"base\",\n+        \"parent\",\n+        \"tokenizer\",\n+        \"layout\",\n+        \"runtime\"\n+      ],\n+      \"migration\": {\n+        \"input_material\": \"actual-full-content\",\n+        \"claimed_scope\": \"direct-encoded-content-only\",\n+        \"original_bytes_required\": true,\n+        \"old_commitment_strengthened\": false,\n+        \"historical_provenance_restored\": false,\n+        \"transitive_dependency_closure_proved\": false,\n+        \"adoption_status\": \"not-established\",\n+        \"requirements\": [\n+          \"new-versioned-domain-and-exact-canonical-encoding\",\n+          \"actual-original-content-before-any-full-content-claim\",\n+          \"independently-authenticated-expected-object-and-profile\",\n+          \"fresh-current-owner-authorization-for-the-new-format\",\n+          \"explicit-handling-of-every-retained-legacy-reference\",\n+          \"nonrewinding-recovery-frontier-and-surviving-liabilities\",\n+          \"explicit-retirement-and-downgrade-policy-before-adoption\"\n+        ]\n+      },\n+      \"open_obligations\": [\n+        \"Independent current manifest expectation and live owner integration.\",\n+        \"Five dependency aliases alone supply no dependency-content authority.\"\n+      ],\n+      \"consumed_outputs\": {\n+        \"manifest_digest\": {\n+          \"primitive\": \"sha512\",\n+          \"consumed_bits\": 512,\n+          \"truncation\": \"none\",\n+          \"notes\": \"The CCH1 ModelManifest record retains all 64 digest bytes.\"\n+        },\n+        \"payload_digest\": {\n+          \"primitive\": \"sha512\",\n+          \"consumed_bits\": 512,\n+          \"truncation\": \"none\",\n+          \"notes\": \"The CCH1 ModelPayload record retains all 64 digest bytes.\"\n+        }\n+      }\n+    },\n+    \"model-direct-dependencies\": {\n+      \"category\": \"model\",\n+      \"source_paths\": [\n+        \"trillionnium/crates/trnm-protocol/src/content_commitment.rs\",\n+        \"trillionnium/crates/trnm-data-availability/src/cell/content_v2.rs\",\n+        \"trillionnium/crates/trnm-data-availability/src/cell/content_v2/closure.rs\"\n+      ],\n+      \"symbols\": [\n+        \"CellContentClosureV2::verify_readers\",\n+        \"CellContentDependencyV2::ALL\"\n+      ],\n+      \"primitives\": [\n+        \"sha512\"\n+      ],\n+      \"encoding\": {\n+        \"record\": \"TCC2\",\n+        \"framing\": \"Complete TCM2 plus five fixed ordered role-tagged CCH1 records: Base, Parent, Tokenizer, Layout, Runtime.\",\n+        \"domains\": [\n+          \"TRNM/CPQ1/FullContent/SHA512/v1\\\\0\",\n+          \"TCC2 role slots 1..5\"\n+        ]\n+      },\n+      \"attack_games\": [\n+        \"fixed-message-second-preimage\",\n+        \"chosen-pair-collision\"\n+      ],\n+      \"attacker_control\": \"A fixed accepted object gives a replacement game; an attacker who prepares both valid candidates before authorization gives a different collision game. Validity and actual owner authority remain separate constraints.\",\n+      \"input_scope\": \"Readback requires the model payload and each of the five complete declared dependency objects under one shared budget.\",\n+      \"legacy_reference_roles\": [\n+        \"embedded metadata aliases\",\n+        \"undeclared transitive dependencies\"\n+      ],\n+      \"migration\": {\n+        \"input_material\": \"actual-declared-direct-objects\",\n+        \"claimed_scope\": \"declared-direct-object-set-only\",\n+        \"original_bytes_required\": true,\n+        \"old_commitment_strengthened\": false,\n+        \"historical_provenance_restored\": false,\n+        \"transitive_dependency_closure_proved\": false,\n+        \"adoption_status\": \"not-established\",\n+        \"requirements\": [\n+          \"new-versioned-domain-and-exact-canonical-encoding\",\n+          \"actual-original-content-before-any-full-content-claim\",\n+          \"independently-authenticated-expected-object-and-profile\",\n+          \"fresh-current-owner-authorization-for-the-new-format\",\n+          \"explicit-handling-of-every-retained-legacy-reference\",\n+          \"nonrewinding-recovery-frontier-and-surviving-liabilities\",\n+          \"explicit-retirement-and-downgrade-policy-before-adoption\"\n+        ]\n+      },\n+      \"open_obligations\": [\n+        \"Completeness of transitive dependencies and semantic compatibility are unproved.\",\n+        \"Byte readback is not CURRENT, installation or FinalUse.\"\n+      ],\n+      \"consumed_outputs\": {\n+        \"closure_digest\": {\n+          \"primitive\": \"sha512\",\n+          \"consumed_bits\": 512,\n+          \"truncation\": \"none\",\n+          \"notes\": \"The enclosing CCH1 ModelManifest digest retains 64 bytes.\"\n+        },\n+        \"each_direct_dependency_digest\": {\n+          \"primitive\": \"sha512\",\n+          \"consumed_bits\": 512,\n+          \"truncation\": \"none\",\n+          \"notes\": \"Each of the five full CCH1 dependency records carries a 64-byte digest.\"\n+        }\n+      }\n+    },\n+    \"transaction-root\": {\n+      \"category\": \"transaction\",\n+      \"source_paths\": [\n+        \"trillionnium/crates/trnm-pon-node/src/lib.rs\",\n+        \"trillionnium/crates/trnm-protocol/src/pon_wire.rs\"\n+      ],\n+      \"symbols\": [\n+        \"sequence_root\",\n+        \"pon_wire::hash\"\n+      ],\n+      \"primitives\": [\n+        \"sha256\"\n+      ],\n+      \"encoding\": {\n+        \"record\": \"PNW1 transaction sequence\",\n+        \"framing\": \"Leaf binds LE64 index and complete transaction bytes; odd levels duplicate the final hash. Empty, leaf and internal node use different tags. No separate outer leaf-count field.\",\n+        \"domains\": [\n+          \"TRNM-PON1\\\\0\",\n+          \"transactions-empty\",\n+          \"transactions-leaf\",\n+          \"transactions-node\"\n+        ]\n+      },\n+      \"attack_games\": [\n+        \"fixed-message-second-preimage\",\n+        \"chosen-pair-collision\",\n+        \"merkle-binding\"\n+      ],\n+      \"attacker_control\": \"A fixed accepted object gives a replacement game; an attacker who prepares both valid candidates before authorization gives a different collision game. Validity and actual owner authority remain separate constraints.\",\n+      \"input_scope\": \"The root covers the supplied ordered transaction byte sequence. It does not validate signatures, execution, or the semantic dependencies inside each transaction.\",\n+      \"legacy_reference_roles\": [\n+        \"transaction-internal identity and content references\"\n+      ],\n+      \"migration\": {\n+        \"input_material\": \"unchanged-existing-format\",\n+        \"claimed_scope\": \"existing-format-only\",\n+        \"original_bytes_required\": false,\n+        \"old_commitment_strengthened\": false,\n+        \"historical_provenance_restored\": false,\n+        \"transitive_dependency_closure_proved\": false,\n+        \"adoption_status\": \"not-established\",\n+        \"requirements\": [\n+          \"new-versioned-domain-and-exact-canonical-encoding\",\n+          \"actual-original-content-before-any-full-content-claim\",\n+          \"independently-authenticated-expected-object-and-profile\",\n+          \"fresh-current-owner-authorization-for-the-new-format\",\n+          \"explicit-handling-of-every-retained-legacy-reference\",\n+          \"nonrewinding-recovery-frontier-and-surviving-liabilities\",\n+          \"explicit-retirement-and-downgrade-policy-before-adoption\"\n+        ]\n+      },\n+      \"open_obligations\": [\n+        \"Prove shape/position and bounded-size binding for this exact indexed duplicate-last tree.\",\n+        \"A new 64-byte tree needs fresh encoding, exact proofs and owner activation.\"\n+      ],\n+      \"consumed_outputs\": {\n+        \"leaf_node_and_root_digest\": {\n+          \"primitive\": \"sha256\",\n+          \"consumed_bits\": 256,\n+          \"truncation\": \"none\",\n+          \"notes\": \"Hash aliases are [u8;32]; no 64-byte transaction-root consumer exists in this contract.\"\n+        }\n+      }\n+    },\n+    \"state-root\": {\n+      \"category\": \"state\",\n+      \"source_paths\": [\n+        \"trillionnium/crates/trnm-protocol/src/pon_wire.rs\",\n+        \"trillionnium/crates/trnm-protocol/src/pon_state.rs\"\n+      ],\n+      \"symbols\": [\n+        \"state_root_from_entries\",\n+        \"state_node_hash\",\n+        \"account_archive_root_from_accounts\"\n+      ],\n+      \"primitives\": [\n+        \"sha256\"\n+      ],\n+      \"encoding\": {\n+        \"record\": \"PNW1 sparse state and account archive\",\n+        \"framing\": \"Domain-tagged hashed paths and exact leaf bytes; sorted unique hash paths; fixed-depth empty/branch grammar.\",\n+        \"domains\": [\n+          \"TRNM-PON1\\\\0\",\n+          \"state-key\",\n+          \"state-leaf\",\n+          \"state-node\",\n+          \"state-empty\",\n+          \"account-archive-key-v1\",\n+          \"account-archive-leaf-v1\",\n+          \"account-archive-branch-v1\",\n+          \"account-archive-empty-v1\"\n+        ]\n+      },\n+      \"attack_games\": [\n+        \"fixed-message-second-preimage\",\n+        \"chosen-pair-collision\",\n+        \"merkle-binding\"\n+      ],\n+      \"attacker_control\": \"A fixed accepted object gives a replacement game; an attacker who prepares both valid candidates before authorization gives a different collision game. Validity and actual owner authority remain separate constraints.\",\n+      \"input_scope\": \"The supplied state rows or account tuples are committed by the existing 32-byte sparse tree. CST1 is a separate candidate format, not a replacement of this root.\",\n+      \"legacy_reference_roles\": [\n+        \"identity fields and values that themselves contain old digests\"\n+      ],\n+      \"migration\": {\n+        \"input_material\": \"unchanged-existing-format\",\n+        \"claimed_scope\": \"existing-format-only\",\n+        \"original_bytes_required\": false,\n+        \"old_commitment_strengthened\": false,\n+        \"historical_provenance_restored\": false,\n+        \"transitive_dependency_closure_proved\": false,\n+        \"adoption_status\": \"not-established\",\n+        \"requirements\": [\n+          \"new-versioned-domain-and-exact-canonical-encoding\",\n+          \"actual-original-content-before-any-full-content-claim\",\n+          \"independently-authenticated-expected-object-and-profile\",\n+          \"fresh-current-owner-authorization-for-the-new-format\",\n+          \"explicit-handling-of-every-retained-legacy-reference\",\n+          \"nonrewinding-recovery-frontier-and-surviving-liabilities\",\n+          \"explicit-retirement-and-downgrade-policy-before-adoption\"\n+        ]\n+      },\n+      \"open_obligations\": [\n+        \"Exact sparse-tree collision/replacement and all state owner paths.\",\n+        \"Do not substitute a hash of this old root for a complete CST1 re-read.\"\n+      ],\n+      \"consumed_outputs\": {\n+        \"state_and_account_sparse_tree_digest\": {\n+          \"primitive\": \"sha256\",\n+          \"consumed_bits\": 256,\n+          \"truncation\": \"none\",\n+          \"notes\": \"All sparse-tree paths, leaves, branches and resulting roots use [u8;32].\"\n+        }\n+      }\n+    },\n+    \"history-block-anchor\": {\n+      \"category\": \"history\",\n+      \"source_paths\": [\n+        \"trillionnium/crates/trnm-protocol/src/pon_wire.rs\",\n+        \"trillionnium/crates/trnm-pon-node/src/store/history_page.rs\"\n+      ],\n+      \"symbols\": [\n+        \"Header::block_id\",\n+        \"Header::challenge\",\n+        \"Node::history_with_progress\"\n+      ],\n+      \"primitives\": [\n+        \"sha256\"\n+      ],\n+      \"encoding\": {\n+        \"record\": \"PNH1 block IDs and parent ancestry\",\n+        \"framing\": \"Block ID hashes the complete header and trace. Parent, transaction, state, receipt and task fields remain 32-byte references.\",\n+        \"domains\": [\n+          \"TRNM-PON1\\\\0\",\n+          \"block\",\n+          \"challenge\"\n+        ]\n+      },\n+      \"attack_games\": [\n+        \"fixed-message-second-preimage\",\n+        \"chosen-pair-collision\"\n+      ],\n+      \"attacker_control\": \"A fixed accepted object gives a replacement game; an attacker who prepares both valid candidates before authorization gives a different collision game. Validity and actual owner authority remain separate constraints.\",\n+      \"input_scope\": \"The block anchor commits header/trace literals. History traverses and validates retained ancestry; there is no migrated 64-byte standalone history-root format in this inventory.\",\n+      \"legacy_reference_roles\": [\n+        \"parent ancestry\",\n+        \"transaction root\",\n+        \"state root\",\n+        \"receipt root\",\n+        \"work task\"\n+      ],\n+      \"migration\": {\n+        \"input_material\": \"unchanged-existing-format\",\n+        \"claimed_scope\": \"existing-format-only\",\n+        \"original_bytes_required\": false,\n+        \"old_commitment_strengthened\": false,\n+        \"historical_provenance_restored\": false,\n+        \"transitive_dependency_closure_proved\": false,\n+        \"adoption_status\": \"not-established\",\n+        \"requirements\": [\n+          \"new-versioned-domain-and-exact-canonical-encoding\",\n+          \"actual-original-content-before-any-full-content-claim\",\n+          \"independently-authenticated-expected-object-and-profile\",\n+          \"fresh-current-owner-authorization-for-the-new-format\",\n+          \"explicit-handling-of-every-retained-legacy-reference\",\n+          \"nonrewinding-recovery-frontier-and-surviving-liabilities\",\n+          \"explicit-retirement-and-downgrade-policy-before-adoption\"\n+        ]\n+      },\n+      \"open_obligations\": [\n+        \"Full historical content/finality and surviving liability reconstruction.\",\n+        \"An outer SHA-512 anchor cannot repair a collision in an old ancestor commitment.\"\n+      ],\n+      \"consumed_outputs\": {\n+        \"header_block_id_and_parent_reference\": {\n+          \"primitive\": \"sha256\",\n+          \"consumed_bits\": 256,\n+          \"truncation\": \"none\",\n+          \"notes\": \"Header::block_id returns Hash=[u8;32], and parent/trace references remain 32 bytes.\"\n+        }\n+      }\n+    },\n+    \"signature-key-identity\": {\n+      \"category\": \"signature\",\n+      \"source_paths\": [\n+        \"trillionnium/crates/trnm-protocol/src/pq_frame.rs\"\n+      ],\n+      \"symbols\": [\n+        \"ml_dsa_65_key_id_from_spki\"\n+      ],\n+      \"primitives\": [\n+        \"sha256\"\n+      ],\n+      \"encoding\": {\n+        \"record\": \"TPQ1 ML-DSA-65 SPKI key identifier\",\n+        \"framing\": \"Fixed key-ID domain followed by exact strict DER ML-DSA-65 SPKI bytes.\",\n+        \"domains\": [\n+          \"TRNM/PoN/PQKey/v1\\\\0\"\n+        ]\n+      },\n+      \"attack_games\": [\n+        \"fixed-target-preimage\",\n+        \"fixed-message-second-preimage\",\n+        \"chosen-pair-collision\"\n+      ],\n+      \"attacker_control\": \"A fixed accepted object gives a replacement game; an attacker who prepares both valid candidates before authorization gives a different collision game. Validity and actual owner authority remain separate constraints.\",\n+      \"input_scope\": \"The ID binds one exact SPKI encoding. Cryptographic key validation and independently pinned authority are separate.\",\n+      \"legacy_reference_roles\": [\n+        \"32-byte network and owner identities\"\n+      ],\n+      \"migration\": {\n+        \"input_material\": \"unchanged-existing-format\",\n+        \"claimed_scope\": \"existing-format-only\",\n+        \"original_bytes_required\": false,\n+        \"old_commitment_strengthened\": false,\n+        \"historical_provenance_restored\": false,\n+        \"transitive_dependency_closure_proved\": false,\n+        \"adoption_status\": \"not-established\",\n+        \"requirements\": [\n+          \"new-versioned-domain-and-exact-canonical-encoding\",\n+          \"actual-original-content-before-any-full-content-claim\",\n+          \"independently-authenticated-expected-object-and-profile\",\n+          \"fresh-current-owner-authorization-for-the-new-format\",\n+          \"explicit-handling-of-every-retained-legacy-reference\",\n+          \"nonrewinding-recovery-frontier-and-surviving-liabilities\",\n+          \"explicit-retirement-and-downgrade-policy-before-adoption\"\n+        ]\n+      },\n+      \"open_obligations\": [\n+        \"A fixed digest preimage game, known original SPKI second-preimage game and attacker-prepared key-pair collision game have different input/control assumptions.\",\n+        \"An arbitrary digest preimage is not necessarily a valid authorized signing key.\"\n+      ],\n+      \"consumed_outputs\": {\n+        \"tpq1_key_id\": {\n+          \"primitive\": \"sha256\",\n+          \"consumed_bits\": 256,\n+          \"truncation\": \"none\",\n+          \"notes\": \"ml_dsa_65_key_id_from_spki returns all 32 bytes and TPQ1 stores the complete field.\"\n+        }\n+      }\n+    },\n+    \"signature-tpq1-payload\": {\n+      \"category\": \"signature\",\n+      \"source_paths\": [\n+        \"trillionnium/crates/trnm-protocol/src/pq_frame.rs\",\n+        \"trillionnium/crates/trnm-protocol/src/pq_transaction.rs\"\n+      ],\n+      \"symbols\": [\n+        \"payload_commitment\",\n+        \"Transfer::unsigned_statement\",\n+        \"Transfer::logical_id\"\n+      ],\n+      \"primitives\": [\n+        \"sha384\",\n+        \"sha256\"\n+      ],\n+      \"encoding\": {\n+        \"record\": \"TPQ1/QTX1\",\n+        \"framing\": \"SHA-384 payload input is DOMAIN || payload tag || BE64 length || actual body; QTX1 logical ID hashes domain, BE32 body length, body and key ID. SHA-256 separately derives QTX1 owner context.\",\n+        \"domains\": [\n+          \"TRNM/PoN/PQAuth/ML-DSA-65/v1\\\\0\",\n+          \"payload\\\\0\",\n+          \"TRNM/PoN/QTX1Identity/v1\\\\0\",\n+          \"TRNM/PoN/QTX1Context/v1\\\\0\"\n+        ]\n+      },\n+      \"attack_games\": [\n+        \"fixed-message-second-preimage\",\n+        \"chosen-pair-collision\"\n+      ],\n+      \"attacker_control\": \"A fixed accepted object gives a replacement game; an attacker who prepares both valid candidates before authorization gives a different collision game. Validity and actual owner authority remain separate constraints.\",\n+      \"input_scope\": \"Payload and operation identity hash actual body bytes. TPQ1 still carries 32-byte key, owner and network identities; the outer signature does not expand their binding strength.\",\n+      \"legacy_reference_roles\": [\n+        \"signer key ID\",\n+        \"owner context\",\n+        \"network\",\n+        \"sender\",\n+        \"recipient\"\n+      ],\n+      \"migration\": {\n+        \"input_material\": \"unchanged-existing-format\",\n+        \"claimed_scope\": \"existing-format-only\",\n+        \"original_bytes_required\": false,\n+        \"old_commitment_strengthened\": false,\n+        \"historical_provenance_restored\": false,\n+        \"transitive_dependency_closure_proved\": false,\n+        \"adoption_status\": \"not-established\",\n+        \"requirements\": [\n+          \"new-versioned-domain-and-exact-canonical-encoding\",\n+          \"actual-original-content-before-any-full-content-claim\",\n+          \"independently-authenticated-expected-object-and-profile\",\n+          \"fresh-current-owner-authorization-for-the-new-format\",\n+          \"explicit-handling-of-every-retained-legacy-reference\",\n+          \"nonrewinding-recovery-frontier-and-surviving-liabilities\",\n+          \"explicit-retirement-and-downgrade-policy-before-adoption\"\n+        ]\n+      },\n+      \"open_obligations\": [\n+        \"Full signature-forgery and valid-owner reduction, with distinct hash roles.\",\n+        \"SHA-384 ideal collision query scaling is not a lifetime failure probability.\"\n+      ],\n+      \"consumed_outputs\": {\n+        \"payload_commitment\": {\n+          \"primitive\": \"sha384\",\n+          \"consumed_bits\": 384,\n+          \"truncation\": \"none\",\n+          \"notes\": \"TPQ1 unsigned bytes[128..176] consume all 48 SHA-384 bytes.\"\n+        },\n+        \"qtx1_logical_id\": {\n+          \"primitive\": \"sha384\",\n+          \"consumed_bits\": 384,\n+          \"truncation\": \"none\",\n+          \"notes\": \"Transfer::logical_id returns all 48 SHA-384 bytes.\"\n+        },\n+        \"qtx1_owner_context\": {\n+          \"primitive\": \"sha256\",\n+          \"consumed_bits\": 256,\n+          \"truncation\": \"none\",\n+          \"notes\": \"Transfer::context returns all 32 SHA-256 bytes; the payload width does not widen this field.\"\n+        }\n+      }\n+    },\n+    \"signature-cpq1-content\": {\n+      \"category\": \"signature\",\n+      \"source_paths\": [\n+        \"trillionnium/crates/trnm-crypto-primitives/src/pq_content_auth.rs\",\n+        \"trillionnium/crates/trnm-crypto-primitives/src/pq_profile_auth.rs\",\n+        \"trillionnium/crates/trnm-protocol/src/content_commitment.rs\",\n+        \"trillionnium/crates/trnm-protocol/src/crypto_profile.rs\"\n+      ],\n+      \"symbols\": [\n+        \"verify_candidate_content\",\n+        \"CandidateProfileVerifier::verify\",\n+        \"CandidateEnvelope\",\n+        \"observe_reader\"\n+      ],\n+      \"primitives\": [\n+        \"sha512\"\n+      ],\n+      \"encoding\": {\n+        \"record\": \"CPQ1 envelope with complete CCH1 payload\",\n+        \"framing\": \"Content join compares exact 213-byte CCH1 record, observation, profile, kind-purpose and generation before the mathematical signature result is returned.\",\n+        \"domains\": [\n+          \"TRNM/CPQ1/FullContent/SHA512/v1\\\\0\",\n+          \"CPQ1 envelope domains in bound crypto profile\"\n+        ]\n+      },\n+      \"attack_games\": [\n+        \"fixed-message-second-preimage\",\n+        \"chosen-pair-collision\"\n+      ],\n+      \"attacker_control\": \"A fixed accepted object gives a replacement game; an attacker who prepares both valid candidates before authorization gives a different collision game. Validity and actual owner authority remain separate constraints.\",\n+      \"input_scope\": \"A complete read observation is joined to a complete signed claim. This is not a new HashML-DSA variant and does not establish current effect authority.\",\n+      \"legacy_reference_roles\": [\n+        \"profile descriptor identity literals\",\n+        \"content-specific referenced objects\"\n+      ],\n+      \"migration\": {\n+        \"input_material\": \"actual-full-content\",\n+        \"claimed_scope\": \"direct-encoded-content-only\",\n+        \"original_bytes_required\": true,\n+        \"old_commitment_strengthened\": false,\n+        \"historical_provenance_restored\": false,\n+        \"transitive_dependency_closure_proved\": false,\n+        \"adoption_status\": \"not-established\",\n+        \"requirements\": [\n+          \"new-versioned-domain-and-exact-canonical-encoding\",\n+          \"actual-original-content-before-any-full-content-claim\",\n+          \"independently-authenticated-expected-object-and-profile\",\n+          \"fresh-current-owner-authorization-for-the-new-format\",\n+          \"explicit-handling-of-every-retained-legacy-reference\",\n+          \"nonrewinding-recovery-frontier-and-surviving-liabilities\",\n+          \"explicit-retirement-and-downgrade-policy-before-adoption\"\n+        ]\n+      },\n+      \"open_obligations\": [\n+        \"Whole ML-DSA internal primitive dependencies remain in their own signature register.\",\n+        \"Current roles/quorum, revocation, recovery and FinalUse are independent owner obligations.\"\n+      ],\n+      \"consumed_outputs\": {\n+        \"cch1_digest\": {\n+          \"primitive\": \"sha512\",\n+          \"consumed_bits\": 512,\n+          \"truncation\": \"none\",\n+          \"notes\": \"The complete 213-byte signed CCH1 record contains a 64-byte content digest.\"\n+        },\n+        \"cpq1_profile_id\": {\n+          \"primitive\": \"sha512\",\n+          \"consumed_bits\": 512,\n+          \"truncation\": \"none\",\n+          \"notes\": \"BoundCryptoProfile uses the complete 64-byte SHA-512 configuration ID.\"\n+        },\n+        \"ml_dsa_internal_hashes\": {\n+          \"primitive\": null,\n+          \"consumed_bits\": null,\n+          \"truncation\": \"not-mapped\",\n+          \"notes\": \"SHAKE internals are separate signature-algorithm dependencies; their role-specific outputs are not mapped by the CCH1 digest width.\"\n+        }\n+      }\n+    },\n+    \"storage-cell-chunks\": {\n+      \"category\": \"storage\",\n+      \"source_paths\": [\n+        \"trillionnium/crates/trnm-data-availability/src/cell/manifest.rs\",\n+        \"trillionnium/crates/trnm-data-availability/src/cell/store.rs\"\n+      ],\n+      \"symbols\": [\n+        \"CellChunkV1\",\n+        \"CellManifestV1::id\",\n+        \"verify_chunk\"\n+      ],\n+      \"primitives\": [\n+        \"sha256\"\n+      ],\n+      \"encoding\": {\n+        \"record\": \"TCM1 chunk and payload checks\",\n+        \"framing\": \"Chunk and payload digests hash raw bytes without a per-chunk hash domain; TCM1 binds the size, ordered chunk sizes/digests and payload digest.\",\n+        \"domains\": [\n+          \"raw SHA-256 for chunk/payload bytes: no domain tag\",\n+          \"trnm.cell-manifest.v1\\\\0\"\n+        ]\n+      },\n+      \"attack_games\": [\n+        \"fixed-message-second-preimage\",\n+        \"chosen-pair-collision\",\n+        \"merkle-binding\"\n+      ],\n+      \"attacker_control\": \"A fixed accepted object gives a replacement game; an attacker who prepares both valid candidates before authorization gives a different collision game. Validity and actual owner authority remain separate constraints.\",\n+      \"input_scope\": \"Legacy transport/cache verification compares actual raw chunk and payload bytes to old manifest digests.\",\n+      \"legacy_reference_roles\": [\n+        \"payload digest\",\n+        \"chunk digest\",\n+        \"dependency aliases\"\n+      ],\n+      \"migration\": {\n+        \"input_material\": \"unchanged-existing-format\",\n+        \"claimed_scope\": \"existing-format-only\",\n+        \"original_bytes_required\": false,\n+        \"old_commitment_strengthened\": false,\n+        \"historical_provenance_restored\": false,\n+        \"transitive_dependency_closure_proved\": false,\n+        \"adoption_status\": \"not-established\",\n+        \"requirements\": [\n+          \"new-versioned-domain-and-exact-canonical-encoding\",\n+          \"actual-original-content-before-any-full-content-claim\",\n+          \"independently-authenticated-expected-object-and-profile\",\n+          \"fresh-current-owner-authorization-for-the-new-format\",\n+          \"explicit-handling-of-every-retained-legacy-reference\",\n+          \"nonrewinding-recovery-frontier-and-surviving-liabilities\",\n+          \"explicit-retirement-and-downgrade-policy-before-adoption\"\n+        ]\n+      },\n+      \"open_obligations\": [\n+        \"Per-chunk target populations, positions and lifetime usage.\",\n+        \"Keep legacy transport hashes separate from a newly pinned full-payload CCH1 claim.\"\n+      ],\n+      \"consumed_outputs\": {\n+        \"payload_and_chunk_checks\": {\n+          \"primitive\": \"sha256\",\n+          \"consumed_bits\": 256,\n+          \"truncation\": \"none\",\n+          \"notes\": \"TCM1 and the actual raw-byte readers compare complete 32-byte SHA-256 digests.\"\n+        }\n+      }\n+    },\n+    \"storage-bep52-root\": {\n+      \"category\": \"storage\",\n+      \"source_paths\": [\n+        \"trillionnium/crates/trnm-data-availability/src/cell/bep52.rs\",\n+        \"trillionnium/crates/trnm-data-availability/src/cell/manifest.rs\",\n+        \"trillionnium/crates/trnm-data-availability/src/cell/store.rs\"\n+      ],\n+      \"symbols\": [\n+        \"CellBep52BindingV1::from_pinned_manifest\",\n+        \"CellBep52BindingV1::verify_chunk\",\n+        \"hash_pair\"\n+      ],\n+      \"primitives\": [\n+        \"sha256\"\n+      ],\n+      \"encoding\": {\n+        \"record\": \"BEP52 single-file research transport binding\",\n+        \"framing\": \"Raw SHA-256(left32 || right32), zero padding leaves and fixed-size proof siblings; proof and pinned manifest enforce index, leaf count and exact byte lengths. Info-hash commits canonical info bytes.\",\n+        \"domains\": [\n+          \"BEP52 raw pair hashing: no custom leaf/node domain tag\",\n+          \"BEP52 canonical info dictionary\"\n+        ]\n+      },\n+      \"attack_games\": [\n+        \"fixed-message-second-preimage\",\n+        \"chosen-pair-collision\",\n+        \"merkle-binding\"\n+      ],\n+      \"attacker_control\": \"A fixed accepted object gives a replacement game; an attacker who prepares both valid candidates before authorization gives a different collision game. Validity and actual owner authority remain separate constraints.\",\n+      \"input_scope\": \"BEP52 hashes bind transport material under its exact existing grammar. They do not inherit CCH1 domains or establish model/dependency authority.\",\n+      \"legacy_reference_roles\": [\n+        \"TCM1 manifest ID\",\n+        \"piece root\",\n+        \"info hash\"\n+      ],\n+      \"migration\": {\n+        \"input_material\": \"unchanged-existing-format\",\n+        \"claimed_scope\": \"existing-format-only\",\n+        \"original_bytes_required\": false,\n+        \"old_commitment_strengthened\": false,\n+        \"historical_provenance_restored\": false,\n+        \"transitive_dependency_closure_proved\": false,\n+        \"adoption_status\": \"not-established\",\n+        \"requirements\": [\n+          \"new-versioned-domain-and-exact-canonical-encoding\",\n+          \"actual-original-content-before-any-full-content-claim\",\n+          \"independently-authenticated-expected-object-and-profile\",\n+          \"fresh-current-owner-authorization-for-the-new-format\",\n+          \"explicit-handling-of-every-retained-legacy-reference\",\n+          \"nonrewinding-recovery-frontier-and-surviving-liabilities\",\n+          \"explicit-retirement-and-downgrade-policy-before-adoption\"\n+        ]\n+      },\n+      \"open_obligations\": [\n+        \"Exact BEP52 tree/padding/opening analysis and valid transport population.\",\n+        \"A magnet or successful chunk download cannot stand in for a full independent CCH1 expectation.\"\n+      ],\n+      \"consumed_outputs\": {\n+        \"leaf_branch_and_piece_root\": {\n+          \"primitive\": \"sha256\",\n+          \"consumed_bits\": 256,\n+          \"truncation\": \"none\",\n+          \"notes\": \"Each CellDigestV1 is exactly 32 bytes; hash_pair consumes two complete digests.\"\n+        },\n+        \"bep52_info_hash\": {\n+          \"primitive\": \"sha256\",\n+          \"consumed_bits\": 256,\n+          \"truncation\": \"none\",\n+          \"notes\": \"Magnet btmh:1220 identifies the complete 32-byte SHA-256 info-hash.\"\n+        }\n+      }\n+    },\n+    \"migration-full-state\": {\n+      \"category\": \"migration\",\n+      \"source_paths\": [\n+        \"trillionnium/crates/trnm-mvcc-fee/src/content_commitment_v1.rs\",\n+        \"trillionnium/crates/trnm-protocol/src/content_commitment.rs\",\n+        \"trillionnium/crates/trnm-protocol/src/pon_wire.rs\"\n+      ],\n+      \"symbols\": [\n+        \"observe_migration_checkpoint_v1\",\n+        \"observe_state_snapshot_v1\"\n+      ],\n+      \"primitives\": [\n+        \"sha512\",\n+        \"sha256\"\n+      ],\n+      \"encoding\": {\n+        \"record\": \"CMG1/CST1/SCF1\",\n+        \"framing\": \"CMG1 includes old locator, actual header/genesis/trace, sorted source accounts and full SPKIs; CST1 streams complete supported state/configuration.\",\n+        \"domains\": [\n+          \"CMG1\",\n+          \"CST1\",\n+          \"SCF1\",\n+          \"TRNM/CPQ1/FullContent/SHA512/v1\\\\0\"\n+        ]\n+      },\n+      \"attack_games\": [\n+        \"fixed-message-second-preimage\",\n+        \"chosen-pair-collision\"\n+      ],\n+      \"attacker_control\": \"A fixed accepted object gives a replacement game; an attacker who prepares both valid candidates before authorization gives a different collision game. Validity and actual owner authority remain separate constraints.\",\n+      \"input_scope\": \"Actual current material is re-read; old checkpoint/ancestry fields remain literal references. Unsupported opaque state configurations are refused.\",\n+      \"legacy_reference_roles\": [\n+        \"old checkpoint\",\n+        \"header parent and other root fields\",\n+        \"configuration identity literals\"\n+      ],\n+      \"migration\": {\n+        \"input_material\": \"actual-full-content\",\n+        \"claimed_scope\": \"direct-encoded-content-only\",\n+        \"original_bytes_required\": true,\n+        \"old_commitment_strengthened\": false,\n+        \"historical_provenance_restored\": false,\n+        \"transitive_dependency_closure_proved\": false,\n+        \"adoption_status\": \"not-established\",\n+        \"requirements\": [\n+          \"new-versioned-domain-and-exact-canonical-encoding\",\n+          \"actual-original-content-before-any-full-content-claim\",\n+          \"independently-authenticated-expected-object-and-profile\",\n+          \"fresh-current-owner-authorization-for-the-new-format\",\n+          \"explicit-handling-of-every-retained-legacy-reference\",\n+          \"nonrewinding-recovery-frontier-and-surviving-liabilities\",\n+          \"explicit-retirement-and-downgrade-policy-before-adoption\"\n+        ]\n+      },\n+      \"open_obligations\": [\n+        \"Source finality, historical ownership and anti-rollback custody remain unproved by rehashing.\",\n+        \"Lost history requires independent fresh migration authorization; no legacy-anchor wrapper fallback.\"\n+      ],\n+      \"consumed_outputs\": {\n+        \"new_cmg1_cst1_digest\": {\n+          \"primitive\": \"sha512\",\n+          \"consumed_bits\": 512,\n+          \"truncation\": \"none\",\n+          \"notes\": \"CCH1 retains the full 64-byte digest of actual supported migration/state content.\"\n+        },\n+        \"legacy_checkpoint_check\": {\n+          \"primitive\": \"sha256\",\n+          \"consumed_bits\": 256,\n+          \"truncation\": \"none\",\n+          \"notes\": \"The old checkpoint identity is still a 32-byte Header::block_id, included as a literal reference.\"\n+        }\n+      }\n+    },\n+    \"release-artifact\": {\n+      \"category\": \"release\",\n+      \"source_paths\": [\n+        \"trillionnium/crates/trnm-release-bundle/src/content_v1.rs\",\n+        \"trillionnium/crates/trnm-protocol/src/content_commitment.rs\"\n+      ],\n+      \"symbols\": [\n+        \"observe_release_artifact_v1\",\n+        \"verify_release_artifact_v1\",\n+        \"observe_release_file_v1\"\n+      ],\n+      \"primitives\": [\n+        \"sha512\",\n+        \"sha256\"\n+      ],\n+      \"encoding\": {\n+        \"record\": \"RAC1/CCH1\",\n+        \"framing\": \"Complete framed artifact entry and actual file bytes feed CCH1; old SHA-256 is checked only for compatibility.\",\n+        \"domains\": [\n+          \"RAC1\",\n+          \"TRNM/CPQ1/FullContent/SHA512/v1\\\\0\"\n+        ]\n+      },\n+      \"attack_games\": [\n+        \"fixed-message-second-preimage\",\n+        \"chosen-pair-collision\"\n+      ],\n+      \"attacker_control\": \"A fixed accepted object gives a replacement game; an attacker who prepares both valid candidates before authorization gives a different collision game. Validity and actual owner authority remain separate constraints.\",\n+      \"input_scope\": \"The directly read artifact and metadata are committed. Build inputs, external labels and current release role authority are not reconstructed.\",\n+      \"legacy_reference_roles\": [\n+        \"legacy artifact digest\",\n+        \"platform/source-path labels\",\n+        \"external build dependency identities\"\n+      ],\n+      \"migration\": {\n+        \"input_material\": \"actual-full-content\",\n+        \"claimed_scope\": \"direct-encoded-content-only\",\n+        \"original_bytes_required\": true,\n+        \"old_commitment_strengthened\": false,\n+        \"historical_provenance_restored\": false,\n+        \"transitive_dependency_closure_proved\": false,\n+        \"adoption_status\": \"not-established\",\n+        \"requirements\": [\n+          \"new-versioned-domain-and-exact-canonical-encoding\",\n+          \"actual-original-content-before-any-full-content-claim\",\n+          \"independently-authenticated-expected-object-and-profile\",\n+          \"fresh-current-owner-authorization-for-the-new-format\",\n+          \"explicit-handling-of-every-retained-legacy-reference\",\n+          \"nonrewinding-recovery-frontier-and-surviving-liabilities\",\n+          \"explicit-retirement-and-downgrade-policy-before-adoption\"\n+        ]\n+      },\n+      \"open_obligations\": [\n+        \"Independent expected claim and immutable/current file custody.\",\n+        \"Full build/dependency closure and live release adoption remain separate.\"\n+      ],\n+      \"consumed_outputs\": {\n+        \"new_rac1_content_digest\": {\n+          \"primitive\": \"sha512\",\n+          \"consumed_bits\": 512,\n+          \"truncation\": \"none\",\n+          \"notes\": \"RAC1 streams into a full 64-byte CCH1 digest.\"\n+        },\n+        \"compatibility_artifact_digest\": {\n+          \"primitive\": \"sha256\",\n+          \"consumed_bits\": 256,\n+          \"truncation\": \"none\",\n+          \"notes\": \"Legacy artifact SHA-256 comparison remains a complete 32-byte compatibility check.\"\n+        }\n+      }\n+    },\n+    \"profile-byte-commitment\": {\n+      \"category\": \"profile\",\n+      \"source_paths\": [\n+        \"trillionnium/crates/trnm-protocol/src/crypto_profile.rs\"\n+      ],\n+      \"symbols\": [\n+        \"BoundCryptoProfile::commitment\",\n+        \"CryptoProfile::hash_rule\"\n+      ],\n+      \"primitives\": [\n+        \"sha512\"\n+      ],\n+      \"encoding\": {\n+        \"record\": \"Generic CPQ1 per-purpose byte commitment\",\n+        \"framing\": \"Domain, full profile ID, purpose byte, BE64 input length and caller-supplied bytes; WorkChallenge/WorkTicket are refused.\",\n+        \"domains\": [\n+          \"TRNM/CryptoProfile/Commitment/v1\\\\0\"\n+        ]\n+      },\n+      \"attack_games\": [\n+        \"fixed-message-second-preimage\",\n+        \"chosen-pair-collision\"\n+      ],\n+      \"attacker_control\": \"A fixed accepted object gives a replacement game; an attacker who prepares both valid candidates before authorization gives a different collision game. Validity and actual owner authority remain separate constraints.\",\n+      \"input_scope\": \"Only the supplied literal bytes are committed. A 32-byte payload is indistinguishable from a 32-byte old digest without a typed object contract.\",\n+      \"legacy_reference_roles\": [\n+        \"arbitrary caller-supplied nested digests\"\n+      ],\n+      \"migration\": {\n+        \"input_material\": \"unchanged-existing-format\",\n+        \"claimed_scope\": \"existing-format-only\",\n+        \"original_bytes_required\": false,\n+        \"old_commitment_strengthened\": false,\n+        \"historical_provenance_restored\": false,\n+        \"transitive_dependency_closure_proved\": false,\n+        \"adoption_status\": \"not-established\",\n+        \"requirements\": [\n+          \"new-versioned-domain-and-exact-canonical-encoding\",\n+          \"actual-original-content-before-any-full-content-claim\",\n+          \"independently-authenticated-expected-object-and-profile\",\n+          \"fresh-current-owner-authorization-for-the-new-format\",\n+          \"explicit-handling-of-every-retained-legacy-reference\",\n+          \"nonrewinding-recovery-frontier-and-surviving-liabilities\",\n+          \"explicit-retirement-and-downgrade-policy-before-adoption\"\n+        ]\n+      },\n+      \"open_obligations\": [\n+        \"Every caller needs its own object meaning, independently fixed expectation and input-completeness review.\",\n+        \"A longer output does not prove full-content recomputation or transitive binding.\"\n+      ],\n+      \"consumed_outputs\": {\n+        \"generic_candidate_commitment\": {\n+          \"primitive\": \"sha512\",\n+          \"consumed_bits\": 512,\n+          \"truncation\": \"none\",\n+          \"notes\": \"BoundCryptoProfile::commitment returns [u8;64]; the input may still be an old short digest.\"\n+        }\n+      }\n+    },\n+    \"work-threshold\": {\n+      \"category\": \"work\",\n+      \"source_paths\": [\n+        \"trillionnium/crates/trnm-crypto-primitives/src/pon_work.rs\",\n+        \"trillionnium/crates/trnm-protocol/src/pon_wire.rs\"\n+      ],\n+      \"symbols\": [\n+        \"pon_work::hash\",\n+        \"precheck_proof_statement\",\n+        \"verify\",\n+        \"Header::challenge\"\n+      ],\n+      \"primitives\": [\n+        \"sha256\"\n+      ],\n+      \"encoding\": {\n+        \"record\": \"PNW1 work transcript and threshold ticket\",\n+        \"framing\": \"Canonical W1 task/noise/transcript/ticket with the full header-derived challenge; ticket accepted when at most the branch target.\",\n+        \"domains\": [\n+          \"TRNM-PON1\\\\0\",\n+          \"TRNM-PON-TRACE1\\\\0\",\n+          \"task\",\n+          \"noise\",\n+          \"ticket\",\n+          \"challenge\"\n+        ]\n+      },\n+      \"attack_games\": [\n+        \"work-threshold-search\"\n+      ],\n+      \"attacker_control\": \"A miner searches valid candidates for an acceptance set determined by target and branch context; neither arbitrary hash collisions nor a free primitive query are automatically valid blocks.\",\n+      \"input_scope\": \"Complete W1 relation and target search remain distinct from generic fixed-digest preimage or arbitrary collision finding.\",\n+      \"legacy_reference_roles\": [\n+        \"header roots and identity fields\"\n+      ],\n+      \"migration\": {\n+        \"input_material\": \"unchanged-existing-format\",\n+        \"claimed_scope\": \"existing-format-only\",\n+        \"original_bytes_required\": false,\n+        \"old_commitment_strengthened\": false,\n+        \"historical_provenance_restored\": false,\n+        \"transitive_dependency_closure_proved\": false,\n+        \"adoption_status\": \"not-established\",\n+        \"requirements\": [\n+          \"new-versioned-domain-and-exact-canonical-encoding\",\n+          \"actual-original-content-before-any-full-content-claim\",\n+          \"independently-authenticated-expected-object-and-profile\",\n+          \"fresh-current-owner-authorization-for-the-new-format\",\n+          \"explicit-handling-of-every-retained-legacy-reference\",\n+          \"nonrewinding-recovery-frontier-and-surviving-liabilities\",\n+          \"explicit-retirement-and-downgrade-policy-before-adoption\"\n+        ]\n+      },\n+      \"open_obligations\": [\n+        \"Joint cheapest legal strategy, parallelism, memory, DAA, timestamp, chainwork and fork model.\",\n+        \"No 2^(n/2) claim ignores target acceptance density or supplies a physical work lower bound.\"\n+      ],\n+      \"consumed_outputs\": {\n+        \"challenge_task_trace_and_ticket\": {\n+          \"primitive\": \"sha256\",\n+          \"consumed_bits\": 256,\n+          \"truncation\": \"none\",\n+          \"notes\": \"Each challenge, task, trace and ticket Hash is [u8;32]; target density and valid W1 computation determine the search game.\"\n+        },\n+        \"raw_noise_hash_output\": {\n+          \"primitive\": \"sha256\",\n+          \"consumed_bits\": 256,\n+          \"truncation\": \"none\",\n+          \"notes\": \"The raw hash(noise, challenge, label, counter) output is 32 bytes before the separate rejection-sampling and early-stop consumer.\"\n+        },\n+        \"sampled_noise_field_words\": {\n+          \"primitive\": null,\n+          \"consumed_bits\": null,\n+          \"truncation\": \"not-mapped\",\n+          \"notes\": \"expand_with_progress splits each raw SHA-256 digest into eight little-endian u32 candidates, retains only v < 4294967291, and stops at the requested output length; the final digest may be partially consumed. Each retained field word is encoded as 32 bits; this is not an entropy or security claim.\"\n+        }\n+      }\n+    },\n+    \"proof-risc0-selected\": {\n+      \"category\": \"proof\",\n+      \"source_paths\": [\n+        \"config/pon/pq-proof-profile-binding-v1.json\",\n+        \"formal/pon-nakamoto-v1/w1_v2_verifier/src/main.rs\",\n+        \"formal/pon-nakamoto-v1/w1_v2_verifier/src/image.rs\",\n+        \"formal/pon-nakamoto-v1/w1_hardened_verifier/src/profile.rs\"\n+      ],\n+      \"symbols\": [\n+        \"PROFILE_ID\",\n+        \"IMAGE_ID\",\n+        \"expected_identity\"\n+      ],\n+      \"primitives\": [\n+        \"sha256\",\n+        \"risc0-poseidon2\"\n+      ],\n+      \"encoding\": {\n+        \"record\": \"trnm-w1-risc0-3.0.6-poseidon2-join-v2\",\n+        \"framing\": \"Selected composite proof route and pinned SDK/image/control/parameter identities; exact local source mapping remains separate from proof security.\",\n+        \"domains\": [\n+          \"RISC Zero 3.0.6 route-specific Poseidon2/SHA-256 roles; no CCH1 replacement\"\n+        ]\n+      },\n+      \"attack_games\": [\n+        \"merkle-binding\",\n+        \"proof-soundness-qrom\"\n+      ],\n+      \"attacker_control\": \"The attacker may choose adaptive statements, proof bytes, transcripts and recursive material. The owner independently pins the exact verifier, profile, image/control IDs and parameters. Acceptance requires the complete verifier; Merkle binding and QROM soundness need distinct project reductions.\",\n+      \"input_scope\": \"The selected parameter descriptor is an inspected source declaration, not a verifier execution or composed quantum soundness theorem.\",\n+      \"legacy_reference_roles\": [\n+        \"image ID\",\n+        \"control ID\",\n+        \"verifier parameters digest\",\n+        \"recursive proof commitments\"\n+      ],\n+      \"migration\": {\n+        \"input_material\": \"unchanged-existing-format\",\n+        \"claimed_scope\": \"existing-format-only\",\n+        \"original_bytes_required\": false,\n+        \"old_commitment_strengthened\": false,\n+        \"historical_provenance_restored\": false,\n+        \"transitive_dependency_closure_proved\": false,\n+        \"adoption_status\": \"not-established\",\n+        \"requirements\": [\n+          \"new-versioned-domain-and-exact-canonical-encoding\",\n+          \"actual-original-content-before-any-full-content-claim\",\n+          \"independently-authenticated-expected-object-and-profile\",\n+          \"fresh-current-owner-authorization-for-the-new-format\",\n+          \"explicit-handling-of-every-retained-legacy-reference\",\n+          \"nonrewinding-recovery-frontier-and-surviving-liabilities\",\n+          \"explicit-retirement-and-downgrade-policy-before-adoption\"\n+        ]\n+      },\n+      \"open_obligations\": [\n+        \"Concrete PCS/Merkle/Fiat-Shamir/adaptive recursion/knowledge extraction and oracle-instantiation losses.\",\n+        \"Current theorem-version equivalence and whole-lifetime query/statement populations remain unproved.\"\n+      ],\n+      \"consumed_outputs\": {\n+        \"native_w1_sha256_values\": {\n+          \"primitive\": \"sha256\",\n+          \"consumed_bits\": 256,\n+          \"truncation\": \"none\",\n+          \"notes\": \"Native statement hashes carried into the proof remain 32-byte values.\"\n+        },\n+        \"risc0_merkle_and_transcript_outputs\": {\n+          \"primitive\": \"risc0-poseidon2\",\n+          \"consumed_bits\": null,\n+          \"truncation\": \"not-mapped\",\n+          \"notes\": \"Exact field-element encoding, output consumption and effective codomain need the selected route mapping; raw byte width is not entropy.\"\n+        },\n+        \"recursive_and_final_verifier_roles\": {\n+          \"primitive\": null,\n+          \"consumed_bits\": null,\n+          \"truncation\": \"not-mapped\",\n+          \"notes\": \"A complete route-by-route consumer/truncation map is still an open proof obligation.\"\n+        }\n+      }\n+    },\n+    \"proof-p3-tagged-reference\": {\n+      \"category\": \"proof\",\n+      \"source_paths\": [\n+        \"formal/pon-nakamoto-v1/w1_public_stark_research/src/tagged_sha3.rs\",\n+        \"formal/pon-nakamoto-v1/w1_public_stark_research/src/proof_config.rs\"\n+      ],\n+      \"symbols\": [\n+        \"tagged_sha3::PROFILE_ID\",\n+        \"FRAME_MAGIC\",\n+        \"DESCRIPTOR\",\n+        \"frame_header\",\n+        \"Role\"\n+      ],\n+      \"primitives\": [\n+        \"sha3-512\"\n+      ],\n+      \"encoding\": {\n+        \"record\": \"TRNM-W1-P3-SHA3-512-TAGGED-R1\",\n+        \"framing\": \"Version/profile/descriptor/component/role/context framing with exact payload length; leaf, branch, transcript and statement-context roles remain one concrete SHA3-512 substrate.\",\n+        \"domains\": [\n+          \"TRNM-W1-SHARED-HASH\\\\0\",\n+          \"Leaf=1\",\n+          \"Branch=2\",\n+          \"Transcript=3\",\n+          \"StatementContext=4\"\n+        ]\n+      },\n+      \"attack_games\": [\n+        \"merkle-binding\",\n+        \"proof-soundness-qrom\"\n+      ],\n+      \"attacker_control\": \"The attacker may choose statement, proof and transcript bytes. The owner independently pins the exact P3 profile, component, descriptor, expected header and expected artifacts. This route supplies no recursive SHA3 verifier; recursion would require a separately qualified extension. Complete verification, Merkle binding and QROM reductions remain distinct obligations.\",\n+      \"input_scope\": \"A distinct research reference profile; it is not the selected RISC Zero route and its 512-bit output is not a transferable proof-security bound.\",\n+      \"legacy_reference_roles\": [\n+        \"statement/public input commitments\"\n+      ],\n+      \"migration\": {\n+        \"input_material\": \"unchanged-existing-format\",\n+        \"claimed_scope\": \"existing-format-only\",\n+        \"original_bytes_required\": false,\n+        \"old_commitment_strengthened\": false,\n+        \"historical_provenance_restored\": false,\n+        \"transitive_dependency_closure_proved\": false,\n+        \"adoption_status\": \"not-established\",\n+        \"requirements\": [\n+          \"new-versioned-domain-and-exact-canonical-encoding\",\n+          \"actual-original-content-before-any-full-content-claim\",\n+          \"independently-authenticated-expected-object-and-profile\",\n+          \"fresh-current-owner-authorization-for-the-new-format\",\n+          \"explicit-handling-of-every-retained-legacy-reference\",\n+          \"nonrewinding-recovery-frontier-and-surviving-liabilities\",\n+          \"explicit-retirement-and-downgrade-policy-before-adoption\"\n+        ]\n+      },\n+      \"open_obligations\": [\n+        \"FRI finite-field error, transcript sampling, recursive SHA3 relation and exact QROM reduction.\",\n+        \"Domain tags do not establish independent random oracles.\"\n+      ],\n+      \"consumed_outputs\": {\n+        \"merkle_leaf_branch_and_statement_context_digest\": {\n+          \"primitive\": \"sha3-512\",\n+          \"consumed_bits\": 512,\n+          \"truncation\": \"none\",\n+          \"notes\": \"Eight raw little-endian u64 words preserve every output bit; they are not reduced modulo Goldilocks.\"\n+        },\n+        \"transcript_hash_output\": {\n+          \"primitive\": \"sha3-512\",\n+          \"consumed_bits\": 512,\n+          \"truncation\": \"none\",\n+          \"notes\": \"The framed transcript hasher emits the full SHA3-512 digest.\"\n+        },\n+        \"sampled_fiat_shamir_field_challenges\": {\n+          \"primitive\": null,\n+          \"consumed_bits\": null,\n+          \"truncation\": \"not-mapped\",\n+          \"notes\": \"Sampling and extension-field consumption are separate from digest width and need the concrete FS reduction.\"\n+        }\n+      }\n+    },\n+    \"migration-bounded-state-history\": {\n+      \"attack_games\": [\n+        \"fixed-message-second-preimage\",\n+        \"chosen-pair-collision\"\n+      ],\n+      \"attacker_control\": \"A fixed accepted object gives a replacement game; an attacker who prepares both valid candidates before authorization gives a different collision game. Validity and actual owner authority remain separate constraints.\",\n+      \"category\": \"migration\",\n+      \"consumed_outputs\": {\n+        \"legacy_consistency_relations\": {\n+          \"consumed_bits\": 256,\n+          \"notes\": \"Original genesis, parent block ID and configured State root checks retain their 32-byte legacy meanings; passing them does not authenticate prior history.\",\n+          \"primitive\": \"sha256\",\n+          \"truncation\": \"none\"\n+        },\n+        \"new_complete_history_digest\": {\n+          \"consumed_bits\": 512,\n+          \"notes\": \"CCH1 commits the actual entire bounded CMH2 stream directly; no old digest substitutes for State rows.\",\n+          \"primitive\": \"sha512\",\n+          \"truncation\": \"none\"\n+        }\n+      },\n+      \"encoding\": {\n+        \"domains\": [\n+          \"CMH2\",\n+          \"HST2\",\n+          \"CST1\",\n+          \"SCF1\",\n+          \"TRNM/CPQ1/FullContent/SHA512/v1\\\\0\"\n+        ],\n+        \"framing\": \"Explicit genesis and selected tip, count and timestamp; complete initial State/configuration and every ordered full Header/trace/State/configuration, with exact length prefixes.\",\n+        \"record\": \"CMH2/HST2/CST1/SCF1\"\n+      },\n+      \"input_scope\": \"Bounded genesis-to-checkpoint Header/trace and full State/configuration bytes, at most 32 non-genesis blocks and 32 MiB; existing legacy roots/parents are checked but historical provenance is not reconstructed.\",\n+      \"legacy_reference_roles\": [\n+        \"genesis and checkpoint compatibility locators\",\n+        \"legacy parent/state/transaction/receipt/work identifiers\",\n+        \"external objects and effects named by state rows\"\n+      ],\n+      \"migration\": {\n+        \"adoption_status\": \"not-established\",\n+        \"claimed_scope\": \"bounded-genesis-to-checkpoint-state-bytes\",\n+        \"historical_provenance_restored\": false,\n+        \"input_material\": \"actual-genesis-state-history\",\n+        \"old_commitment_strengthened\": false,\n+        \"original_bytes_required\": true,\n+        \"requirements\": [\n+          \"new-versioned-domain-and-exact-canonical-encoding\",\n+          \"actual-original-content-before-any-full-content-claim\",\n+          \"independently-authenticated-expected-object-and-profile\",\n+          \"fresh-current-owner-authorization-for-the-new-format\",\n+          \"explicit-handling-of-every-retained-legacy-reference\",\n+          \"nonrewinding-recovery-frontier-and-surviving-liabilities\",\n+          \"explicit-retirement-and-downgrade-policy-before-adoption\"\n+        ],\n+        \"transitive_dependency_closure_proved\": false\n+      },\n+      \"open_obligations\": [\n+        \"Actual long-chain archival/continuation format; longer branches are refused, never truncated.\",\n+        \"Complete transaction/proof/receipt bodies and external effect/revocation histories are not migrated.\",\n+        \"Independent historical authorization, current cutover authority, source retirement and non-co-restored freshness remain separate.\",\n+        \"Original work and transaction replay belong to existing consensus/authenticated migration owners.\"\n+      ],\n+      \"primitives\": [\n+        \"sha512\",\n+        \"sha256\"\n+      ],\n+      \"source_paths\": [\n+        \"trillionnium/crates/trnm-mvcc-fee/src/content_commitment_v1.rs\",\n+        \"trillionnium/crates/trnm-mvcc-fee/src/content_commitment_v1/history_v2.rs\",\n+        \"trillionnium/crates/trnm-pon-node/src/store/migration_history_v2.rs\",\n+        \"trillionnium/crates/trnm-pon-node/src/store.rs\",\n+        \"trillionnium/crates/trnm-protocol/src/pon_wire.rs\"\n+      ],\n+      \"symbols\": [\n+        \"observe_migration_history_v2\",\n+        \"verify_migration_history_v2\",\n+        \"MigrationHistoryReadbackV2\",\n+        \"Node::observe_migration_history_v2\"\n+      ]\n+    },\n+    \"model-declared-transitive-graph\": {\n+      \"attack_games\": [\n+        \"fixed-message-second-preimage\",\n+        \"chosen-pair-collision\"\n+      ],\n+      \"attacker_control\": \"A fixed accepted object gives a replacement game; an attacker who prepares both valid candidates before authorization gives a different collision game. Validity and actual owner authority remain separate constraints.\",\n+      \"category\": \"model\",\n+      \"consumed_outputs\": {\n+        \"node_and_leaf_content_digests\": {\n+          \"consumed_bits\": 512,\n+          \"notes\": \"Every node and leaf retains its complete 213-byte CCH1 record and full 64-byte digest.\",\n+          \"primitive\": \"sha512\",\n+          \"truncation\": \"none\"\n+        }\n+      },\n+      \"encoding\": {\n+        \"domains\": [\n+          \"TCG3\",\n+          \"TRNM/CPQ1/FullContent/SHA512/v1\\\\0\",\n+          \"CCH1 kind 3 ModelManifest\",\n+          \"CCH1 kind 4 ModelPayload\"\n+        ],\n+        \"framing\": \"Complete CCH1 ModelManifest node bytes contain a payload claim and five ordered typed role slots; all graph edges are decoded only after node content verification.\",\n+        \"record\": \"TCG3/CCH1\"\n+      },\n+      \"input_scope\": \"Every reachable typed declared node and leaf is actually read through EOF and matched to a full CCH1 claim; unknown loader dependencies and historical absence/provenance are not inferred.\",\n+      \"legacy_reference_roles\": [],\n+      \"migration\": {\n+        \"adoption_status\": \"not-established\",\n+        \"claimed_scope\": \"declared-typed-graph-only\",\n+        \"historical_provenance_restored\": false,\n+        \"input_material\": \"actual-declared-transitive-objects\",\n+        \"old_commitment_strengthened\": false,\n+        \"original_bytes_required\": true,\n+        \"requirements\": [\n+          \"new-versioned-domain-and-exact-canonical-encoding\",\n+          \"actual-original-content-before-any-full-content-claim\",\n+          \"independently-authenticated-expected-object-and-profile\",\n+          \"fresh-current-owner-authorization-for-the-new-format\",\n+          \"explicit-handling-of-every-retained-legacy-reference\",\n+          \"nonrewinding-recovery-frontier-and-surviving-liabilities\",\n+          \"explicit-retirement-and-downgrade-policy-before-adoption\"\n+        ],\n+        \"transitive_dependency_closure_proved\": false\n+      },\n+      \"open_obligations\": [\n+        \"Independently authenticated expected root and current owner authorization.\",\n+        \"Actual loader/executable/library/device dependency discovery and compatibility remain separate.\",\n+        \"Source custody, deadline enforcement and ordinary product adoption remain separate.\"\n+      ],\n+      \"primitives\": [\n+        \"sha512\"\n+      ],\n+      \"source_paths\": [\n+        \"trillionnium/crates/trnm-data-availability/src/cell/content_graph_v3.rs\",\n+        \"trillionnium/crates/trnm-data-availability/src/cell.rs\",\n+        \"trillionnium/crates/trnm-protocol/src/content_commitment.rs\"\n+      ],\n+      \"symbols\": [\n+        \"CellContentGraphNodeV3\",\n+        \"verify_cell_content_graph_v3\",\n+        \"CellContentGraphReadbackV3\"\n+      ]\n+    }\n+  },\n+  \"migration_requirements\": [\n+    \"new-versioned-domain-and-exact-canonical-encoding\",\n+    \"actual-original-content-before-any-full-content-claim\",\n+    \"independently-authenticated-expected-object-and-profile\",\n+    \"fresh-current-owner-authorization-for-the-new-format\",\n+    \"explicit-handling-of-every-retained-legacy-reference\",\n+    \"nonrewinding-recovery-frontier-and-surviving-liabilities\",\n+    \"explicit-retirement-and-downgrade-policy-before-adoption\"\n+  ],\n+  \"query_model_notes\": {\n+    \"generic_ideal_constant_success_queries\": \"Single-target preimage has square-root and random-function collision has cube-root query scaling under their respective ideal models.\",\n+    \"examples_are_security_bits\": false,\n+    \"examples_are_lifetime_failure_bounds\": false,\n+    \"ideal_output_width_examples\": [\n+      {\n+        \"output_bits\": 256,\n+        \"preimage_exponent\": {\n+          \"numerator\": \"256\",\n+          \"denominator\": \"2\"\n+        },\n+        \"collision_exponent\": {\n+          \"numerator\": \"256\",\n+          \"denominator\": \"3\"\n+        }\n+      },\n+      {\n+        \"output_bits\": 384,\n+        \"preimage_exponent\": {\n+          \"numerator\": \"384\",\n+          \"denominator\": \"2\"\n+        },\n+        \"collision_exponent\": {\n+          \"numerator\": \"384\",\n+          \"denominator\": \"3\"\n+        }\n+      },\n+      {\n+        \"output_bits\": 512,\n+        \"preimage_exponent\": {\n+          \"numerator\": \"512\",\n+          \"denominator\": \"2\"\n+        },\n+        \"collision_exponent\": {\n+          \"numerator\": \"512\",\n+          \"denominator\": \"3\"\n+        }\n+      }\n+    ],\n+    \"second_preimage_requires_its_own_message_length_and_target_model\": true,\n+    \"multi_target_preprocessing_advice_and_reduction_losses_included_in_proof\": false,\n+    \"adversary_query_maximum\": null,\n+    \"query_budget_overrun_probability\": null,\n+    \"physical_memory_circuit_and_fault_tolerance_costs_calibrated\": false,\n+    \"shared_primitive_queries_reset_at_domain_key_or_epoch\": false,\n+    \"primary_references\": [\n+      \"https://arxiv.org/abs/quant-ph/9605043\",\n+      \"https://arxiv.org/abs/quant-ph/9705002\",\n+      \"https://arxiv.org/abs/1312.1027\"\n+    ]\n+  },\n+  \"proof_profiles\": {\n+    \"selected_risc0\": {\n+      \"profile_id\": \"trnm-w1-risc0-3.0.6-poseidon2-join-v2\",\n+      \"expected_identity\": {\n+        \"sdk\": \"3.0.6\",\n+        \"image_id\": [\n+          1958252411,\n+          3287394615,\n+          1805488136,\n+          1516578702,\n+          78549041,\n+          790278610,\n+          301018785,\n+          4279049364\n+        ],\n+        \"hash_suite\": \"poseidon2\",\n+        \"final_control_id\": \"7a8f24092c34ed3eb81b3d0a0b796c588c615d3488ef9e61c21dbd1e4b83ea6e\",\n+        \"verifier_parameters_digest\": \"ece5e9b8ae2cd6ea6b1827b464ff0348f9a7f4decd269c0087fdfd75098da013\",\n+        \"field\": {\n+          \"base_modulus\": \"2013265921\",\n+          \"extension_degree\": 4,\n+          \"extension_polynomial\": \"X^4 + 11\"\n+        },\n+        \"fri\": {\n+          \"queries\": 50,\n+          \"inverse_rate\": 4,\n+          \"folding_factor\": 16,\n+          \"final_min_degree\": 256\n+        }\n+      },\n+      \"status\": \"selected-source-declaration-only\",\n+      \"qrom_soundness_bound\": null,\n+      \"theorem_version_equivalence_verified\": false\n+    },\n+    \"tagged_p3_reference\": {\n+      \"profile_id\": \"TRNM-W1-P3-SHA3-512-TAGGED-R1\",\n+      \"sdk\": \"0.8.0\",\n+      \"hash\": \"SHA3-512\",\n+      \"output_bits\": 512,\n+      \"sponge_rate_bits\": 576,\n+      \"sponge_capacity_bits\": 1024,\n+      \"field_modulus\": \"18446744069414584321\",\n+      \"extension_polynomial\": \"X^2-7\",\n+      \"fri_queries\": 64,\n+      \"log_blowup\": 2,\n+      \"log_final_poly_len\": 0,\n+      \"max_log_arity\": 1,\n+      \"status\": \"separate-research-reference-only\",\n+      \"qrom_soundness_bound\": null\n+    },\n+    \"parameter_sets_may_be_combined_for_qualification\": false,\n+    \"source_parameter_binding_proves_implementation_refinement\": false\n+  },\n+  \"qualification\": {\n+    \"actual_lifetime_failure_bound\": null,\n+    \"security_bits\": null,\n+    \"whole_chain_hash_query_scope_closed\": false,\n+    \"composition_coverage_proved\": false,\n+    \"whole_chain_pq_qualified\": false,\n+    \"production_activation\": false\n+  },\n+  \"source_files\": {\n+    \"config/pon/pq-proof-profile-binding-v1.json\": {\n+      \"bytes\": 2378,\n+      \"sha256\": \"e2b13c985b1e00ad0d9e4bc6c41b6a2cb2c870da379db77fa2882defd79f8a23\"\n+    },\n+    \"formal/pon-nakamoto-v1/w1_hardened_verifier/src/profile.rs\": {\n+      \"bytes\": 5246,\n+      \"sha256\": \"b4f4f35fc69f8846e465928052d1ee006d262d05baedfbce00703ea8fa11a6a9\"\n+    },\n+    \"formal/pon-nakamoto-v1/w1_public_stark_research/src/proof_config.rs\": {\n+      \"bytes\": 13329,\n+      \"sha256\": \"98876ea9e223f90079f69bd6f1f75f6a17b9988ed9412fdda8a16bc40367aebf\"\n+    },\n+    \"formal/pon-nakamoto-v1/w1_public_stark_research/src/tagged_sha3.rs\": {\n+      \"bytes\": 11732,\n+      \"sha256\": \"b6bf9e1d77e0e1711f3a8c667223afc5a7262b7658011d3fbbf6006ccd5b0847\"\n+    },\n+    \"formal/pon-nakamoto-v1/w1_v2_verifier/src/image.rs\": {\n+      \"bytes\": 284,\n+      \"sha256\": \"c972778fe557d3e1a23470423c46c899ade1633ba76cac48268129b2af5d1ddb\"\n+    },\n+    \"formal/pon-nakamoto-v1/w1_v2_verifier/src/main.rs\": {\n+      \"bytes\": 11172,\n+      \"sha256\": \"5e102fcbe4881e3d163c7a8b65364304b14d080ae64f23b0d5032daa84208aa7\"\n+    },\n+    \"trillionnium/crates/trnm-crypto-primitives/src/pon_work.rs\": {\n+      \"bytes\": 104121,\n+      \"sha256\": \"33cb571d1338a949677092d0dc3f6c955cd8ad6d3524cee0cd5b528e1c146d03\"\n+    },\n+    \"trillionnium/crates/trnm-crypto-primitives/src/pq_content_auth.rs\": {\n+      \"bytes\": 3525,\n+      \"sha256\": \"5d7cb197c4296777ac00708b6b260cf2ee27aac17b778b43bbd71b9009b708d9\"\n+    },\n+    \"trillionnium/crates/trnm-crypto-primitives/src/pq_profile_auth.rs\": {\n+      \"bytes\": 11609,\n+      \"sha256\": \"e91a1c00a2b5e1cc598a8ca615a8f19adb51470f0575106140891e60b6d4ca37\"\n+    },\n+    \"trillionnium/crates/trnm-data-availability/src/cell/bep52.rs\": {\n+      \"bytes\": 12578,\n+      \"sha256\": \"c33ff4435a2227d1de962b40d3e7bb5cb913b6a13c2a442aed1399fe36732447\"\n+    },\n+    \"trillionnium/crates/trnm-data-availability/src/cell/closure.rs\": {\n+      \"bytes