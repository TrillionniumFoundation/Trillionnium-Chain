  branch sane present_chunk(si,so,sw,sn,sb,row,off,count,sp) internal()
block present_chunk(ai:readbuf,ao:mutbuf,aw:mutbuf,an:u64,ab:u64,ar:u64,af:u64,ac:u64,ap:u64)
  payload_n:u64 = int.sub.wrap(an,ab)
  nil:u64 = const() {"value":0}
