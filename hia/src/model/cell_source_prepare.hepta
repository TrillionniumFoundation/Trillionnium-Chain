  base:u64 = const() {"value":1208}
  hashed:bool = call(hw,base,hr) {"function":"sp_hash"}
  branch hashed tokens(hi,ho,hw,hn,hs) internal()
block tokens(ti:readbuf,to:mutbuf,tw:mutbuf,tn:u64,ts:u64)
