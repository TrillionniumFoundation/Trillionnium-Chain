  offset_4:u64 = const() {"value":128}
  after_4:u64 = call(bi,bs,offset_4,version_width,bw,after_3) {"function":"vs_frame_number"}
  offset_5:u64 = const() {"value":132}
  after_5:u64 = call(bi,bs,offset_5,digest_width,bw,after_4) {"function":"vs_frame_bytes"}
  offset_6:u64 = const() {"value":164}
  after_6:u64 = call(bi,bs,offset_6,digest_width,bw,after_5) {"function":"vs_frame_bytes"}
  offset_7:u64 = const() {"value":196}
  after_7:u64 = call(bi,bs,offset_7,digest_width,bw,after_6) {"function":"vs_frame_bytes"}
  offset_8:u64 = const() {"value":228}
  after_8:u64 = call(bi,bs,offset_8,eight,bw,after_7) {"function":"vs_frame_number"}
  offset_9:u64 = const() {"value":236}
  after_9:u64 = call(bi,bs,offset_9,eight,bw,after_8) {"function":"vs_frame_number"}
  offset_10:u64 = const() {"value":244}
  after_10:u64 = call(bi,bs,offset_10,eight,bw,after_9) {"function":"vs_frame_number"}
  extent:u64 = int.sub.wrap(after_10,base)
