name: Chain Hepta closure evidence contracts
on:
  pull_request:
    paths:
      - .github/workflows/chain-hepta-closure-candidate.yml
      - scripts/cell_learning_scope_join.py
      - scripts/test_cell_learning_scope_join.py
      - scripts/cell_learning_iteration_join.py
      - scripts/cell_learning_completion_join.py
      - scripts/cell_learning_business_join.py
      - scripts/cell_learning_business_economics.py
      - scripts/test_cell_learning_business_join.py
      - scripts/test_cell_learning_business_economics.py
      - scripts/test_cell_learning_training_no_update_join.py
      - scripts/ci/pq_proof_profile_binding.py
      - scripts/ci/test_pq_proof_profile_binding.py
      - scripts/ci/w1_upstream_security.py
      - scripts/ci/test_w1_upstream_security.py
      - scripts/ci/audit_native_campaign_outcomes.py
      - scripts/ci/test_audit_native_campaign_outcomes.py
      - config/pon/pq-proof-profile-binding-v1.json
      - config/pon/w1-upstream-security-v1.json
      - config/pon/w1-qrom-implementation-current-v2.json
      - config/pon/pq128-lifetime-budget-v1.json
      - evidence/**
      - formal/pon-nakamoto-v1/**
      - trillionnium/**
permissions:
  contents: read
jobs:
  contracts:
    runs-on: ubuntu-24.04
    timeout-minutes: 10
    strategy:
      fail-fast: false
      matrix:
        suite: [scope, proof-profile, campaign-reader]
        lane: [head, prospective-merge]
    env:
      PYTHONDONTWRITEBYTECODE: "1"
      SOURCE: ${{ github.event.pull_request.head.sha }}
      BASE: ${{ github.event.pull_request.base.sha }}
      TESTED: ${{ matrix.lane == 'head' && github.event.pull_request.head.sha || github.sha }}
      LANE: ${{ matrix.lane }}
      SUITE: ${{ matrix.suite }}
    steps:
      - uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd
        with:
          ref: ${{ env.TESTED }}
          fetch-depth: 0
          persist-credentials: false
      - name: Observe the actual source
        run: |
          set -euo pipefail
          args=(--kind "$LANE" --expected-head "$SOURCE")
          if test "$LANE" = prospective-merge; then
            args+=(--expected-base "$BASE" --expected-merge "$TESTED")
          fi
          python3 scripts/ci/verify_ci_source.py "${args[@]}" --output "$RUNNER_TEMP/closure-source-before.json"
          cat "$RUNNER_TEMP/closure-source-before.json"
          bash scripts/project-preflight.sh --audit
      - name: Check the selected evidence contract
        run: |
          set -euo pipefail
          case "$SUITE" in
            scope)
              python3 scripts/test_cell_learning_scope_join.py -v
              python3 scripts/test_cell_learning_training_no_update_join.py -v
              ;;
            proof-profile)
              python3 scripts/ci/test_pq_proof_profile_binding.py -v
              python3 scripts/ci/pq_proof_profile_binding.py \
                --expected-profile-descriptor-sha256 8e95754db175bf8f2c4b3ffc0afe46f7b1eff476479d15fb2c005bf6d79dd0f1
              ;;
            campaign-reader)
              python3 scripts/ci/test_audit_native_campaign_outcomes.py -v
              ;;
            *) exit 2 ;;
          esac
      - name: Recheck the actual source
        if: always()
        run: |
          set -euo pipefail
          args=(--kind "$LANE" --expected-head "$SOURCE")
          if test "$LANE" = prospective-merge; then
            args+=(--expected-base "$BASE" --expected-merge "$TESTED")
          fi
          python3 scripts/ci/verify_ci_source.py "${args[@]}" --output "$RUNNER_TEMP/closure-source-after.json"
          cat "$RUNNER_TEMP/closure-source-after.json"
          git diff --exit-code

6ff6dcc7adcb9005d1570e1dcf4064f2e1e05edc blob 3293
name: CodeQL exact-source analysis export
on:
  pull_request:
  workflow_dispatch:
    inputs:
      pr_number:
        description: Same-repository open PR whose current source should be exported
        required: true
        type: string
permissions:
  contents: read
  security-events: read
  checks: read
  pull-requests: read
concurrency:
  group: codeql-analysis-export-${{ github.event.pull_request.number || inputs.pr_number }}
  cancel-in-progress: false
jobs:
  export:
    if: github.event_name == 'workflow_dispatch' || github.event.pull_request.head.repo.full_name == github.repository
    runs-on: ubuntu-24.04
    timeout-minutes: 30
    env:
      PYTHONDONTWRITEBYTECODE: "1"
      EXPORTER_HEAD: ${{ github.event.pull_request.head.sha || github.sha }}
      EXPORT_PR_NUMBER: ${{ inputs.pr_number }}
    steps:
      - name: Reserve a fresh evidence directory
        shell: bash
        run: |
          set -euo pipefail
          out="$RUNNER_TEMP/codeql-export-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          mkdir "$out"
          printf 'OUT=%s\n' "$out" >> "$GITHUB_ENV"
      - name: Checkout the immutable exporter source
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ env.EXPORTER_HEAD }}
          fetch-depth: 0
          persist-credentials: false
      - name: Verify exporter source before reading existing analyses
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/ci/verify_ci_source.py --kind head --expected-head "$EXPORTER_HEAD" --output "$OUT/exporter-source-before.json"
          bash scripts/project-preflight.sh --audit 2>&1 | tee "$OUT/preflight.log"
          python3 scripts/test_export_codeql_analysis.py 2>&1 | tee "$OUT/exporter-offline-tests.log"
      - name: Export exact PR analyses with the existing read-only token
        env:
          GITHUB_TOKEN: ${{ github.token }}
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/export_codeql_analysis.py --out "$OUT/analysis" --wait-seconds 1200 --poll-seconds 30
      - name: Verify unchanged exporter source
        if: always()
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/ci/verify_ci_source.py --kind head --expected-head "$EXPORTER_HEAD" --output "$OUT/exporter-source-after.json"
      - name: Hash all available evidence, including failures
        if: always()
        shell: bash
        run: |
          set -euo pipefail
          python3 - <<'PY'
          import hashlib, json, os
          from pathlib import Path
          out = Path(os.environ['OUT'])
          hashes = {str(p.relative_to(out)): hashlib.sha256(p.read_bytes()).hexdigest()
                    for p in sorted(out.rglob('*')) if p.is_file() and p.name != 'sha256.json'}
          (out / 'sha256.json').write_text(json.dumps(hashes, indent=2) + '\n')
          PY
      - name: Preserve metadata, API SARIF subsets and partial failures
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: codeql-analysis-export-${{ github.run_id }}-${{ github.run_attempt }}
          path: ${{ env.OUT }}
          if-no-files-found: error
          retention-days: 30

9cea88c15ec764ed5627c70dcab73416e96d6b6d blob 10546
# Run real CodeQL queries for immutable source-head and prospective-merge SHAs.
# Default setup owns Code Scanning uploads. GitHub rejects advanced-configuration
# uploads while it is enabled; retain this lane's exact-source SARIF separately.
name: CodeQL exact-source analysis and SARIF retention
on:
  push:
    branches:
      - main
      - fix/chain-six-axis-performance-20261103
      - fix/chain-native-codeql-source-scan-20261106-gpt6
  # Match the read-only export lane's ordinary PR scope, including stacked bases.
  # This local SARIF lane does not supply the exporter's Code Scanning API results.
  pull_request:
permissions:
  contents: read
jobs:
  codeql:
    # Same-repository PRs are scanned independently at immutable head and prospective merge.
    # Push events have only a branch head; no untrusted fork code is executed.
    if: github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository
    name: CodeQL local SARIF (${{ matrix.language }}, ${{ matrix.source }})
    runs-on: ubuntu-24.04
    timeout-minutes: 120
    permissions:
      contents: read
      actions: read
      security-events: read
    strategy:
      fail-fast: false
      matrix:
        language: [rust, python, actions]
        source: ${{ github.event_name == 'pull_request' && fromJSON('["head","prospective-merge"]') || fromJSON('["head"]') }}
    steps:
      - name: Checkout exact event source
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ matrix.source == 'head' && github.event_name == 'pull_request' && github.event.pull_request.head.sha || github.sha }}
          fetch-depth: 0
          persist-credentials: false
      - name: Refuse any other source identity
        id: source_before
        shell: bash
        env:
          EXPECTED_SOURCE_SHA: ${{ matrix.source == 'head' && github.event_name == 'pull_request' && github.event.pull_request.head.sha || github.sha }}
          EXPECTED_CANDIDATE_SHA: ${{ github.event.pull_request.head.sha || github.sha }}
          EXPECTED_BASE_SHA: ${{ github.event.pull_request.base.sha }}
          SOURCE_KIND: ${{ matrix.source }}
        run: |
          set -euo pipefail
          test "$(git rev-parse HEAD)" = "$EXPECTED_SOURCE_SHA"
          test -z "$(git status --porcelain)"
          identity="$RUNNER_TEMP/codeql-identity/${{ matrix.language }}/${{ matrix.source }}"
          mkdir -p "$identity"
          args=(--kind "$SOURCE_KIND" --expected-head "$EXPECTED_CANDIDATE_SHA")
          if test "$SOURCE_KIND" = prospective-merge; then
            args+=(--expected-base "$EXPECTED_BASE_SHA" --expected-merge "$EXPECTED_SOURCE_SHA")
          fi
          python3 -B scripts/ci/verify_ci_source.py "${args[@]}" --output "$identity/source-before.json" 2>&1 | tee "$identity/source-before.log"
          printf 'CODEQL_EVENT_SHA=%s CODEQL_SOURCE_SHA=%s CODEQL_SOURCE_KIND=%s CODEQL_LANGUAGE=%s\n' "$GITHUB_SHA" "$(git rev-parse HEAD)" "$SOURCE_KIND" '${{ matrix.language }}'
      - name: Require local SARIF retention failure controls
        id: retention_controls
        run: python3 -B scripts/ci/test_codeql_retention.py
      - name: Initialize pinned official CodeQL
        id: codeql_init
        uses: github/codeql-action/init@1fc58d04a4d4374f921bdac573c3811c240f9c26 # v4.39.2
        with:
          languages: ${{ matrix.language }}
          build-mode: none
      - name: Generate local exact-source SARIF for exact source SHA
        id: codeql
        uses: github/codeql-action/analyze@1fc58d04a4d4374f921bdac573c3811c240f9c26 # v4.39.2
        with:
          category: /language:${{ matrix.language }}/source:${{ matrix.source }}
          output: ${{ runner.temp }}/codeql-results/${{ matrix.language }}/${{ matrix.source }}
          ref: ${{ github.event_name == 'pull_request' && matrix.source == 'head' && format('refs/pull/{0}/head', github.event.pull_request.number) || github.ref }}
          sha: ${{ github.event_name == 'pull_request' && matrix.source == 'head' && github.event.pull_request.head.sha || github.sha }}
          upload: never
          upload-database: false
      - name: Verify generated SARIF is present and parseable
        id: sarif_verify
        if: always() && steps.codeql.outcome != 'skipped'
        shell: bash
        env:
          SARIF_DIR: ${{ runner.temp }}/codeql-results/${{ matrix.language }}/${{ matrix.source }}
        run: |
          set -euo pipefail
          python3 - "$SARIF_DIR" <<'PY'
          import json, pathlib, sys
          root = pathlib.Path(sys.argv[1])
          files = sorted(root.glob('*.sarif'))
          if not files:
              raise SystemExit('CODEQL_SARIF_MISSING')
          for path in files:
              value = json.loads(path.read_text(encoding='utf-8'))
              if value.get('version') != '2.1.0' or not isinstance(value.get('runs'), list) or not value['runs']:
                  raise SystemExit(f'CODEQL_SARIF_INVALID:{path.name}')
          print(f'CODEQL_SARIF_FILES={len(files)} CODEQL_LANGUAGE=${{ matrix.language }}')
          PY
      - name: Retain post-analysis worktree observations
        if: always() && steps.codeql.outcome != 'skipped'
        shell: bash
        run: |
          set -euo pipefail
          identity="$RUNNER_TEMP/codeql-identity/${{ matrix.language }}/${{ matrix.source }}"
          mkdir -p "$identity"
          git --no-replace-objects status --porcelain=v1 -z --untracked-files=all --ignore-submodules=none > "$identity/worktree-status.z"
          git --no-replace-objects diff --no-ext-diff --no-textconv --name-status -z HEAD > "$identity/worktree-diff-names.z"
          git --no-replace-objects diff --no-ext-diff --no-textconv --stat HEAD > "$identity/worktree-diff-stat.txt"
      - name: Recheck exact source after analysis
        id: source_after
        if: always() && steps.codeql.outcome != 'skipped'
        shell: bash
        env:
          EXPECTED_SOURCE_SHA: ${{ matrix.source == 'head' && github.event_name == 'pull_request' && github.event.pull_request.head.sha || github.sha }}
          EXPECTED_CANDIDATE_SHA: ${{ github.event.pull_request.head.sha || github.sha }}
          EXPECTED_BASE_SHA: ${{ github.event.pull_request.base.sha }}
          SOURCE_KIND: ${{ matrix.source }}
        run: |
          set -euo pipefail
          identity="$RUNNER_TEMP/codeql-identity/${{ matrix.language }}/${{ matrix.source }}"
          args=(--kind "$SOURCE_KIND" --expected-head "$EXPECTED_CANDIDATE_SHA")
          if test "$SOURCE_KIND" = prospective-merge; then
            args+=(--expected-base "$EXPECTED_BASE_SHA" --expected-merge "$EXPECTED_SOURCE_SHA")
          fi
          # Preserve the failure scene before the strict identity check; do not repair it.
          git --no-replace-objects status --porcelain=v1 --untracked-files=all --ignore-submodules=none > "$identity/worktree-status-after.txt"
          git --no-replace-objects diff --no-ext-diff --no-textconv --binary -- > "$identity/tracked-worktree-after.patch"
          git --no-replace-objects diff --no-ext-diff --no-textconv --binary --cached -- > "$identity/tracked-index-after.patch"
          python3 -B scripts/ci/verify_ci_source.py "${args[@]}" --output "$identity/source-after.json" 2>&1 | tee "$identity/source-after.log"
          cmp "$identity/source-before.json" "$identity/source-after.json" 2>&1 | tee "$identity/source-comparison.log"
      - name: Record source and analysis outcomes
        if: always()
        shell: bash
        env:
          IDENTITY_DIR: ${{ runner.temp }}/codeql-identity/${{ matrix.language }}/${{ matrix.source }}
          SOURCE_KIND: ${{ matrix.source }}
          CODEQL_LANGUAGE: ${{ matrix.language }}
          EXPECTED_SOURCE_SHA: ${{ matrix.source == 'head' && github.event_name == 'pull_request' && github.event.pull_request.head.sha || github.sha }}
          SOURCE_BEFORE_OUTCOME: ${{ steps.source_before.outcome }}
          RETENTION_CONTROLS_OUTCOME: ${{ steps.retention_controls.outcome }}
          INITIALIZE_OUTCOME: ${{ steps.codeql_init.outcome }}
          ANALYZE_OUTCOME: ${{ steps.codeql.outcome }}
          SARIF_VERIFY_OUTCOME: ${{ steps.sarif_verify.outcome }}
          SOURCE_AFTER_OUTCOME: ${{ steps.source_after.outcome }}
        run: |
          set -euo pipefail
          python3 - <<'PY_OUTCOME'
          import json, os, pathlib
          root = pathlib.Path(os.environ['IDENTITY_DIR'])
          root.mkdir(parents=True, exist_ok=True)
          stages = ('source_before', 'retention_controls', 'initialize',
                    'analyze', 'sarif_verify', 'source_after')
          value = {
              'schema': 'trnm-codeql-local-evidence-v1',
              'language': os.environ['CODEQL_LANGUAGE'], 'source_kind': os.environ['SOURCE_KIND'],
              'event_commit': os.environ['GITHUB_SHA'],
              'expected_source_commit': os.environ['EXPECTED_SOURCE_SHA'],
              'code_scanning_upload': 'never',
              'outcomes': {stage: os.environ[stage.upper() + '_OUTCOME'] for stage in stages},
          }
          (root / 'step-outcomes.json').write_text(json.dumps(value, sort_keys=True, indent=2) + '\n')
          PY_OUTCOME
      - name: Retain exact-source local SARIF for independent review
        # Preserve analysis/source failures; identity files alone never satisfy SARIF retention.
        if: ${{ always() && steps.sarif_verify.outcome == 'success' }}
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
        with:
          name: codeql-sarif-${{ matrix.language }}-${{ matrix.source }}-${{ github.sha }}
          path: |
            ${{ runner.temp }}/codeql-results/${{ matrix.language }}/${{ matrix.source }}/*.sarif
            ${{ runner.temp }}/codeql-identity/${{ matrix.language }}/${{ matrix.source }}/
          if-no-files-found: error
          retention-days: 14
      - name: Retain diagnostics when no valid SARIF was produced
        # This separate artifact cannot stand in for an analyzed SARIF result.
        if: ${{ always() && steps.sarif_verify.outcome != 'success' }}
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
        with:
          name: codeql-diagnostics-${{ matrix.language }}-${{ matrix.source }}-${{ github.sha }}
          path: ${{ runner.temp }}/codeql-identity/${{ matrix.language }}/${{ matrix.source }}/
          if-no-files-found: error
          retention-days: 14

d942705a245ed392e1dcb186bd2c1899f04b9d4f blob 5746
name: CPQ1 complete content bindings
on:
  push:
    branches: [feature/chain-cpq1-content-commitments-20261108]
  pull_request:
    paths:
      - trillionnium/crates/trnm-protocol/**
      - trillionnium/crates/trnm-crypto-primitives/**
      - trillionnium/crates/trnm-data-availability/**
      - trillionnium/crates/trnm-mvcc-fee/**
      - trillionnium/crates/trnm-release-bundle/**
      - trillionnium/crates/trnm-pon-node/src/store.rs
      - trillionnium/crates/trnm-pon-node/src/store/migration_history_v2.rs
      - trillionnium/crates/trnm-pon-node/src/store/migration_history_v2/**
      - config/pon/cpq1-content-commitments-v1.json
      - config/pon/hash-use-contract-v1.json
      - tests/fixtures/cpq1-content-v1/**
      - tests/fixtures/cell-content-graph-v3/**
      - scripts/ci/check_content_commitment_vectors.py
      - scripts/ci/check_cell_content_graph_vectors_v3.py
      - scripts/ci/hash_use_contract.py
      - scripts/ci/test_hash_use_contract.py
      - docs/security/CONTENT_GRAPH_AND_HISTORY_READBACK_V1.md
      - .github/workflows/cpq1-full-content.yml
permissions:
  contents: read
jobs:
  native-components:
    strategy:
      fail-fast: false
      matrix:
        runner: [ubuntu-24.04, ubuntu-24.04-arm]
    runs-on: ${{ matrix.runner }}
    timeout-minutes: 40
    env:
      CARGO_BUILD_JOBS: "2"
      CARGO_INCREMENTAL: "0"
      RUST_TEST_THREADS: "1"
      PYTHONDONTWRITEBYTECODE: "1"
      EXPECTED_HEAD: ${{ github.event.pull_request.head.sha || github.sha }}
    steps:
      - uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd
        with:
          ref: ${{ github.event.pull_request.head.sha || github.sha }}
          fetch-depth: 0
          persist-credentials: false
      - name: Install pinned compiler and original quality tools
        run: rustup toolchain install 1.95.0 --profile minimal --component rustfmt --component clippy
      - name: Prepare and record the pinned optional-feature provider
        shell: bash
        run: |
          set -euo pipefail
          bash scripts/project-preflight.sh --audit
          out="$RUNNER_TEMP/cpq1-full-content-provider"
          mkdir "$out"
          export TRNM_CI_RECEIPT_DIR="$out"
          python3 scripts/ci/record_pq_native_command.py --kind head --candidate "$EXPECTED_HEAD" --tested "$EXPECTED_HEAD" --label provider --output "$out" -- bash scripts/ci/prepare_pq_provider.sh
      - name: Validate exact-source content implementations
        shell: bash
        run: |
          set -euo pipefail
          out="$RUNNER_TEMP/cpq1-full-content"
          mkdir "$out"
          export CARGO_TARGET_DIR="$RUNNER_TEMP/cpq1-full-content-target"
          packages=(-p trnm-protocol -p trnm-crypto-primitives -p trnm-data-availability -p trnm-mvcc-fee -p trnm-release-bundle)
          record() {
            label="$1"
            shift
            python3 scripts/ci/record_pq_native_command.py --kind head --candidate "$EXPECTED_HEAD" --tested "$EXPECTED_HEAD" --label "$label" --output "$out" -- "$@"
          }
          bash scripts/project-preflight.sh --audit
          record compiler rustc +1.95.0 -Vv
          record locked-graph cargo +1.95.0 metadata --locked --manifest-path trillionnium/Cargo.toml --format-version 1
          record locked-fuzz-graph cargo +1.95.0 metadata --locked --manifest-path tests/fuzz/Cargo.toml --format-version 1
          record vectors python3 scripts/ci/check_content_commitment_vectors.py
          record graph-vectors python3 scripts/ci/check_cell_content_graph_vectors_v3.py
          record hash-purpose-controls python3 scripts/ci/test_hash_use_contract.py
          record hash-purpose-source python3 scripts/ci/hash_use_contract.py
          record source-integrity python3 scripts/ci/check_pq_research_integration.py
          record source-controls python3 -m unittest discover -s scripts/ci -p test_pq_research_integration.py -v
          record recorder-controls python3 -m unittest discover -s scripts/ci -p test_record_pq_native_command.py -v
          record repository python3 scripts/ci/check_repository.py
          record inventory python3 scripts/refresh_distributed_source_inventory.py --check
          record retained-libraries cargo +1.95.0 test --locked --manifest-path trillionnium/Cargo.toml "${packages[@]}" --lib
          record retained-feature-libraries cargo +1.95.0 test --locked --manifest-path trillionnium/Cargo.toml "${packages[@]}" --all-features --lib
          record retained-docs cargo +1.95.0 test --locked --manifest-path trillionnium/Cargo.toml "${packages[@]}" --doc
          record native-history cargo +1.95.0 test --locked --manifest-path trillionnium/Cargo.toml -p trnm-pon-node --lib store::migration_history_v2 -- --test-threads=1
          record native-history-features cargo +1.95.0 test --locked --manifest-path trillionnium/Cargo.toml -p trnm-pon-node --all-features --lib store::migration_history_v2 -- --test-threads=1
          record format cargo +1.95.0 fmt --manifest-path trillionnium/Cargo.toml --all -- --check
          record strict-clippy cargo +1.95.0 clippy --locked --manifest-path trillionnium/Cargo.toml "${packages[@]}" -p trnm-pon-node --all-targets --all-features -- -D warnings
      - name: Retain complete command records and failures
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: cpq1-full-content-${{ matrix.runner }}-${{ github.event.pull_request.head.sha || github.sha }}-${{ github.run_attempt }}
          path: |
            ${{ runner.temp }}/cpq1-full-content/
            ${{ runner.temp }}/cpq1-full-content-provider/
          if-no-files-found: error
          retention-days: 14

c758f5d0e10be8972e9b9fcc250e07d3a852877d blob 26186
name: PoN baseline diagnostic readback
on:
  pull_request:
    paths:
      - .github/workflows/pon-baseline-diagnostic-readback.yml
      - trillionnium/**
permissions:
  contents: read
  actions: read
jobs:
  retained-failure:
    runs-on: ubuntu-24.04
    timeout-minutes: 5
    steps:
      - name: Read the exact failed baseline without executing repository code
        env:
          GH_TOKEN: ${{ github.token }}
          OUT: ${{ runner.temp }}/baseline-diagnostic-readback
        shell: bash
        run: |
          set -euo pipefail
          mkdir "$OUT"
          api=https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain
          curl --fail --silent --show-error --location --proto '=https' --proto-redir '=https' --retry 2 --max-time 60 --max-filesize 1048576 -H "Authorization: Bearer $GH_TOKEN" "$api/actions/runs/37861647184" -o "$OUT/run.json"
          curl --fail --silent --show-error --location --proto '=https' --proto-redir '=https' --retry 2 --max-time 60 --max-filesize 1048576 -H "Authorization: Bearer $GH_TOKEN" "$api/actions/jobs/113599036245" -o "$OUT/job.json"
          python3 - <<'PY'
          import json, os
          from pathlib import Path
          root = Path(os.environ['OUT'])
          run = json.loads((root / 'run.json').read_text())
          job = json.loads((root / 'job.json').read_text())
          assert run['id'] == job['run_id'] == 37861647184
          assert run['head_sha'] == '544dc613753ac7760af97d378d84da3e2db4e3ff'
          assert job['id'] == 113599036245 and job['conclusion'] == 'failure'
          PY
          # curl does not forward Authorization to another host on a redirect.
          curl --fail --silent --show-error --location --proto '=https' --proto-redir '=https' --retry 2 --max-time 120 --max-filesize 67108864 -H "Authorization: Bearer $GH_TOKEN" "$api/actions/jobs/113599036245/logs" -o "$OUT/failed-baseline.log"
          python3 - <<'PY'
          import hashlib, json, os, re
          from pathlib import Path
          root = Path(os.environ['OUT'])
          raw = (root / 'failed-baseline.log').read_bytes()
          assert raw and len(raw) <= 64 * 1024 * 1024
          lines = raw.decode('utf-8', errors='replace').splitlines()
          selected = set()
          for i, line in enumerate(lines):
              if re.search(r'error(?:\[[^]]+\])?:|panicked at|Caused by:', line):
                  selected.update(range(max(0, i - 3), min(len(lines), i + 14)))
          excerpt = '\n'.join(lines[i] for i in sorted(selected)[-180:])[-24000:]
          (root / 'diagnostic-excerpt.txt').write_text(excerpt + '\n')
          record = dict(schema='pon-retained-baseline-diagnostic-v1',
                        source='544dc613753ac7760af97d378d84da3e2db4e3ff',
                        run=37861647184, job=113599036245,
                        log_sha256=hashlib.sha256(raw).hexdigest(), log_bytes=len(raw),
                        source_tests_executed=False, acceptance_granted=False)
          (root / 'readback.json').write_text(json.dumps(record, indent=2) + '\n')
          print(json.dumps(record))
          print(excerpt)
          PY
      - name: Preserve original failure and bounded diagnostic excerpt
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: retained-baseline-diagnostic-${{ github.event.pull_request.head.sha }}-${{ github.run_attempt }}
          path: ${{ runner.temp }}/baseline-diagnostic-readback/
          if-no-files-found: error
          retention-days: 30
  retained-throughput:
    name: Retained complete-cost failure readback
    if: github.repository == 'TrillionniumFoundation/Trillionnium-Chain' && github.event_name == 'pull_request' && github.event.pull_request.number == 688
    runs-on: ubuntu-24.04
    timeout-minutes: 5
    permissions:
      contents: read
      actions: read
    steps:
      - name: Read pinned F0 and campaign artifacts without executing repository code
        env:
          GH_TOKEN: ${{ github.token }}
          OUT: ${{ runner.temp }}/throughput-diagnostic-readback
        shell: bash
        run: |
          set -euo pipefail
          mkdir -p "$OUT/raw" "$OUT/readback"
          api=https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain
          while read -r label run job artifact; do
            for pair in "run actions/runs/$run" "job actions/jobs/$job" "artifact actions/artifacts/$artifact"; do
              read -r kind endpoint <<< "$pair"
              curl --fail --silent --show-error --location --proto '=https' --proto-redir '=https' --retry 2 --max-time 60 --max-filesize 1048576 -H "Authorization: Bearer $GH_TOKEN" "$api/$endpoint" -o "$OUT/readback/$label-$kind.json"
            done
            # Authorization is not forwarded to another host by curl on redirects.
            curl --fail --silent --show-error --location --proto '=https' --proto-redir '=https' --retry 2 --max-time 120 --max-filesize 67108864 -H "Authorization: Bearer $GH_TOKEN" "$api/actions/artifacts/$artifact/zip" -o "$OUT/raw/$label.zip"
          done <<'CASES'
          f0 41753071420 126323929045 13286673364
          campaign 41753071468 126326178742 13288600275
          CASES
          python3 - <<'PY' | tee "$OUT/readback/summary.jsonl"
          import hashlib
          import json
          import os
          import zipfile
          from pathlib import Path
          
          HEAD = 'be0d5f978dc86008115524a6be85c38e03982b33'
          TREE = '0042b3212d0960d10e31fdbe8a92a57c50dedd90'
          CASES = [{"label":"f0","run":41753071420,"job":126323929045,"artifact":13286673364,"name":"pon-fixed-host-root-f0-x64-head-be0d5f978dc86008115524a6be85c38e03982b33-1","size":15946259,"sha256":"90a1834ddc7a083fc9103285c6f42f9c00d421b8c6d6206139f9db3e7f4da042"},{"label":"campaign","run":41753071468,"job":126326178742,"artifact":13288600275,"name":"pon-native-campaign-x64-head-release-be0d5f978dc86008115524a6be85c38e03982b33-1","size":59518668,"sha256":"06bd58d9fb7e10fea73e6f57f2e008295b6515e7be490532deea74711aa6d1be"}]
          ROOT = Path(os.environ['OUT'])
          MEMBER_LIMIT = 16 * 1024 * 1024
          OUTPUT_LIMIT = 4 * 1024 * 1024
          emitted = 0
          
          def require(condition, message):
              if not condition:
                  raise ValueError(message)
          
          def unique_object(pairs):
              value = {}
              for key, item in pairs:
                  require(key not in value, 'duplicate JSON key')
                  value[key] = item
              return value
          
          def reject_constant(value):
              raise ValueError('nonfinite JSON: ' + value)
          
          def decode(raw):
              return json.loads(raw, object_pairs_hook=unique_object, parse_constant=reject_constant)
          
          def metadata(label, kind):
              raw = (ROOT / 'readback' / f'{label}-{kind}.json').read_bytes()
              require(len(raw) <= 1024 * 1024, 'metadata byte bound')
              return decode(raw)
          
          def project(value, keys):
              return {key: value[key] for key in keys if key in value}
          
          def emit(case, kind, value):
              global emitted
              row = {
                  'schema': 'pon-retained-throughput-readback-v1',
                  'kind': kind, 'archive': case['label'],
                  'measured_head': HEAD, 'measured_tree': TREE,
                  'measured_run': case['run'], 'measured_job': case['job'],
                  'artifact_id': case['artifact'], 'artifact_sha256': case['sha256'],
                  'reader_workflow_commit': os.environ['GITHUB_SHA'],
                  'source_tests_executed': False, 'acceptance_granted': False,
                  'value': value,
              }
              line = json.dumps(row, sort_keys=True, separators=(',', ':'), allow_nan=False)
              size = len(line.encode('utf-8')) + 1
              require(size <= 512 * 1024 and emitted + size <= OUTPUT_LIMIT,
                      'bounded console readback exceeded; complete original artifact retained')
              emitted += size
              print(line, flush=True)
          
          class Archive:
              def __init__(self, case):
                  self.case = case
                  self.prefix = None
                  self.members_read = []
                  run, job, artifact = (metadata(case['label'], kind) for kind in ('run', 'job', 'artifact'))
                  require(run['id'] == job['run_id'] == case['run']
                          and job['id'] == case['job'], 'exact run and job')
                  require(run['head_sha'] == HEAD and run['run_attempt'] == 1
                          and run['status'] == job['status'] == 'completed'
                          and run['conclusion'] == job['conclusion'] == 'failure',
                          'retained first-attempt failure and head')
                  require(artifact['id'] == case['artifact']
                          and artifact['name'] == case['name']
                          and artifact['size_in_bytes'] == case['size']
                          and artifact['digest'] == 'sha256:' + case['sha256']
                          and artifact['expired'] is False, 'exact artifact identity')
                  source = artifact['workflow_run']
                  require(source['id'] == case['run'] and source['head_sha'] == HEAD
                          and source['repository_id'] == source['head_repository_id'] == 1323087357,
                          'artifact repository and measured source')
                  path = ROOT / 'raw' / (case['label'] + '.zip')
                  require(path.stat().st_size == case['size'] <= 64 * 1024 * 1024,
                          'complete ZIP size')
                  digest = hashlib.sha256()
                  with path.open('rb') as stream:
                      for chunk in iter(lambda: stream.read(1024 * 1024), b''):
                          digest.update(chunk)
                  require(digest.hexdigest() == case['sha256'], 'complete ZIP SHA256')
                  self.zip = zipfile.ZipFile(path)
                  infos = self.zip.infolist()
                  require(len(infos) <= 8192 and len({item.filename for item in infos}) == len(infos),
                          'bounded unique archive members')
                  self.index = {item.filename: item for item in infos if not item.is_dir()}
          
              def read(self, relative, optional=False):
                  if self.prefix is not None:
                      matches = [self.prefix + relative] if self.prefix + relative in self.index else []
                  elif relative in self.index:
                      matches = [relative]
                  else:
                      matches = [name for name in self.index if name.endswith('/' + relative)]
                  if not matches and optional:
                      return None, None
                  require(len(matches) == 1, 'unique common-root member: ' + relative)
                  name = matches[0]
                  prefix = name[:-len(relative)]
                  require(self.prefix is None or self.prefix == prefix, 'consistent archive root')
                  self.prefix = prefix
                  info = self.index[name]
                  require(not (info.flag_bits & 1) and info.file_size <= MEMBER_LIMIT,
                          'bounded unencrypted JSON member')
                  with self.zip.open(info) as stream:
                      raw = stream.read(MEMBER_LIMIT + 1)
                  require(len(raw) == info.file_size <= MEMBER_LIMIT, 'actual member byte bound')
                  value = decode(raw)
                  digest = hashlib.sha256(raw).hexdigest()
                  self.members_read.append({'member': name, 'bytes': len(raw), 'sha256': digest})
                  (ROOT / 'readback' / (self.case['label'] + '-' + relative.replace('/', '--'))).write_bytes(raw)
                  return value, digest
          
              def finish(self):
                  self.zip.close()
                  emit(self.case, 'archive-integrity', {
                      'archive_sha256_verified': True, 'selected_json_members': self.members_read,
                      'archive_member_paths_used_as_output_paths': False,
                      'archive_members_executed': False, 'selected_json_members_copied_to_readback': True,
                      'scope': 'readback of existing measured JSON only; original failures and acceptance are unchanged',
                  })
          
          for case in CASES:
              archive = Archive(case)
              if case['label'] == 'f0':
                  final, _ = archive.read('finalization/result.json')
                  execution, execution_hash = archive.read('execution/results.json')
                  prepared, prepared_hash = archive.read('prepared/prepared.json')
                  source, _ = archive.read('source-after.json')
                  outcomes, _ = archive.read('workflow-outcomes.json')
                  require(final['schema'] == 'fixed-host-root-f0-finalization-v1'
                          and execution['schema'] == 'pon-fixed-host-root-f0-execution-v1'
                          and prepared['schema'] == 'pon-fixed-host-root-f0-prepared-v1',
                          'original F0 schemas')
                  for value in (final, execution):
                      require(value['head'] == HEAD and value['tree'] == TREE, 'F0 measured source')
                  require(source['tested_commit'] == source['candidate'] == HEAD
                          and source['tested_tree'] == TREE and source['tracked_worktree_verified'] is True,
                          'F0 unchanged source after measurement')
                  denominator = final['denominator']
                  require(execution['prepared_sha256'] == prepared_hash
                          and denominator['native_result_sha256'] == execution_hash,
                          'F0 original preparation and result hashes')
                  require(denominator['planned_confirmations'] == 6
                          and denominator['planned_business_packet_exposures'] == 42
                          and len(denominator['all_planned_rounds']) == 6
                          and len(denominator['all_planned_business_packets']) == 42,
                          'all original F0 denominators')
                  require(execution['all_planned_rounds'] == denominator['all_planned_rounds']
                          and execution['all_planned_business_packets'] == denominator['all_planned_business_packets'],
                          'F0 execution and finalizer denominator binding')
                  if denominator['report_observed']:
                      require(execution['report_sha256'] == denominator['report_sha256'],
                              'F0 existing raw report hash binding')
                  emit(case, 'f0-finalization', {
                      **project(final, ('schema', 'head', 'tree', 'complete_success', 'all_services_known_empty', 'scope')),
                      'services': [project(row, ('phase', 'ownership_validated', 'known_empty', 'remaining', 'failure'))
                                   for row in final['services']],
                      'denominator': denominator, 'workflow_outcomes': outcomes,
                  })
                  emit(case, 'f0-execution', project(execution, (
                      'schema', 'head', 'tree', 'inputs', 'prepared_sha256', 'binary', 'complete_success',
                      'failure', 'report_validation_failure', 'native_result_failure',
                      'native_execution_observed', 'step', 'post_observations',
                      'controller_resources_complete', 'controller_resource_summary', 'all_planned_rounds')))
              else:
                  result, _ = archive.read('results.json')
                  require(result['schema'] == 'pon-original-native-campaign-ci-v1'
                          and result['expected_head'] == HEAD and result['expected_tree'] == TREE
                          and result['planned_complete_runs'] == 3, 'original campaign source and denominator')
                  source = result['source_after']
                  require(source['tested_commit'] == source['candidate'] == HEAD
                          and source['tested_tree'] == TREE and source['tracked_worktree_verified'] is True,
                          'campaign unchanged source after measurement')
                  attempts = result['attempts']
                  require([row['number'] for row in attempts] == [1, 2, 3], 'all three original attempts')
                  emit(case, 'campaign-result', project(result, (
                      'schema', 'expected_head', 'expected_tree', 'source_after', 'profile', 'toolchain',
                      'state_backend', 'planned_complete_runs', 'original_inputs', 'expected_resources',
                      'public_phase_placement', 'expected_public_policy_id', 'binary', 'complete_success',
                      'failure', 'finalization_failures', 'scope')))
                  for attempt in attempts:
                      number = attempt['number']
                      emit(case, 'campaign-attempt', attempt)
                      derived, _ = archive.read(f'run-{number}-phase-readback.json', optional=True)
                      if derived is None:
                          emit(case, 'campaign-derivation-missing', {
                              'attempt': number, 'observations_available': False,
                              'report_validation_failure': attempt.get('report_validation_failure'),
                              'planned_phase_modes': ['baseline', 'from-zero', 'late-product'],
                          })
                          continue
                      require(derived['schema'] == 'pon-public-v3-multiprocess-phase-derivation-v2'
                              and derived['input']['sha256'] == attempt['report_sha256'],
                              'existing campaign derivation and raw report hash')
                      require([row['mode'] for row in derived['phases']] == ['baseline', 'from-zero', 'late-product'],
                              'all original phase modes')
                      for phase in derived['phases']:
                          selected = project(phase, (
                              'mode', 'state_backend', 'public_resource_policy', 'work_profile',
                              'work_arithmetic_owner', 'completion_work_observation',
                              'observations_available', 'window_seconds', 'scheduled_confirmation_rounds',
                              'observed_confirmation_rounds', 'confirmed_rounds', 'unobserved_scheduled_rounds',
                              'confirmation_rounds', 'startup_or_campaign_error', 'native_phase_criteria_met',
                              'whole_parent_phase_wall_ns', 'whole_parent_phase_cpu_ns',
                              'receiver_and_verifier_setup_wall_ns', 'receiver_and_verifier_setup_cpu_ns',
                              'native_service_outcome', 'native_verifier_errors', 'receiver_client_state_equal',
                              'genuine_budget_depletion_observed', 'attacker_processes_requested',
                              'attacker_processes_ready', 'actor_reports_successful_without_cap_or_kill',
                              'submissions', 'history', 'attack_calls', 'final_cpu_meter', 'final_actual_flow',
                              'client_history_import_observations'))
                          if 'receiver' in phase:
                              selected['receiver'] = project(phase['receiver'], (
                                  'schema', 'capacity', 'accepted_connections_seen', 'records_not_retained',
                                  'measurement_failures', 'counter_overflow', 'dispatch_cpu_scope',
                                  'native_observer_complete', 'all_retained_records'))
                          emit(case, 'campaign-phase', {
                              'attempt': number, 'input': derived['input'],
                              'scope': derived['scope'], 'phase': selected,
                              'omitted_phase_fields': sorted(set(phase) - set(selected)),
                              'receiver_role_splits_remain_in_complete_archived_derivation': True,
                          })
              archive.finish()
          PY
      - name: Retain exact archive identities and bounded existing result readback
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: retained-throughput-readback-${{ github.event.pull_request.head.sha }}-${{ github.run_attempt }}
          path: ${{ runner.temp }}/throughput-diagnostic-readback/readback/
          if-no-files-found: error
          retention-days: 30
  native-boundary:
    name: native boundary (${{ matrix.runner }}, ${{ matrix.source }})
    permissions:
      contents: read
    strategy:
      fail-fast: false
      matrix:
        runner: [ubuntu-24.04, ubuntu-24.04-arm]
        source: [head, prospective-merge]
    runs-on: ${{ matrix.runner }}
    timeout-minutes: 25
    env:
      CARGO_INCREMENTAL: "0"
      CARGO_BUILD_JOBS: "2"
      RUST_TEST_THREADS: "1"
      PYTHONDONTWRITEBYTECODE: "1"
      EXPECTED_HEAD: ${{ github.event.pull_request.head.sha }}
      EXPECTED_BASE: ${{ github.event.pull_request.base.sha }}
      EXPECTED_MERGE: ${{ github.sha }}
      SOURCE_KIND: ${{ matrix.source }}
    steps:
      - name: Checkout exact current source or actual target merge
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ matrix.source == 'head' && github.event.pull_request.head.sha || github.sha }}
          fetch-depth: 0
          persist-credentials: false
      - name: Verify source and original project boundary
        id: source
        run: |
          set -euo pipefail
          export TRNM_CI_RECEIPT_DIR="$RUNNER_TEMP/native-boundary"
          mkdir "$TRNM_CI_RECEIPT_DIR"
          echo "TRNM_CI_RECEIPT_DIR=$TRNM_CI_RECEIPT_DIR" >> "$GITHUB_ENV"
          echo "CARGO_HOME=$RUNNER_TEMP/cargo-boundary" >> "$GITHUB_ENV"
          echo "CARGO_TARGET_DIR=$RUNNER_TEMP/target-boundary" >> "$GITHUB_ENV"
          args=(--kind "$SOURCE_KIND" --expected-head "$EXPECTED_HEAD")
          if test "$SOURCE_KIND" = prospective-merge; then
            args+=(--expected-base "$EXPECTED_BASE" --expected-merge "$EXPECTED_MERGE")
          fi
          python3 scripts/ci/verify_ci_source.py "${args[@]}" --output "$TRNM_CI_RECEIPT_DIR/source.json"
          bash scripts/project-preflight.sh --audit
      - name: Install source-pinned compiler and lint tools
        id: tools
        run: rustup toolchain install 1.95.0 --profile minimal --component rustfmt --component clippy
      - name: Prepare pinned OpenSSL 3.5.9 PQ provider
        id: pq_provider
        shell: bash
        run: |
          set -euo pipefail
          export TRNM_CI_RECEIPT_DIR="$TRNM_CI_RECEIPT_DIR"
          bash scripts/ci/prepare_pq_provider.sh
      - name: Preserve exact formatter diagnostics without changing source
        if: ${{ !cancelled() && steps.source.outcome == 'success' && steps.tools.outcome == 'success' }}
        run: |
          set -euo pipefail
          cargo +1.95.0 fmt --manifest-path trillionnium/Cargo.toml --all -- --check 2>&1 | tee "$TRNM_CI_RECEIPT_DIR/format.log"
      - name: Execute strict native all-target Clippy before long campaigns
        if: ${{ !cancelled() && steps.source.outcome == 'success' && steps.tools.outcome == 'success' && steps.pq_provider.outcome == 'success' }}
        run: |
          set -euo pipefail
          cargo +1.95.0 clippy --locked --manifest-path trillionnium/Cargo.toml -p trnm-pon-node --all-targets --all-features -- -D warnings 2>&1 | tee "$TRNM_CI_RECEIPT_DIR/clippy.log"
      - name: Execute original accounting and new cooffered depletion regressions
        if: ${{ !cancelled() && steps.source.outcome == 'success' && steps.tools.outcome == 'success' }}
        run: |
          set -euo pipefail
          # The original transcript validator requires exactly one named invocation.
          # Execute all four original/current tests once, each with its own full log.
          for selector in \
            actual_paid_native_work_rejection_read_frames_and_partial_eof_are_attributed \
            real_observer_capacity_overflow_does_not_refuse_concurrent_honest_reads \
            actual_depletion::actual_replay_depletion_public_recovery_and_same_epoch_reopen \
            actual_depletion::depleted_domain_serves_honest_block_during_rotating_public_false_work; do
            log="$TRNM_CI_RECEIPT_DIR/accounting-${selector//::/-}.log"
            cargo +1.95.0 test --locked --release --manifest-path trillionnium/Cargo.toml -p trnm-pon-node --test public_v3_request_accounting "$selector" -- --exact --show-output --test-threads=1 2>&1 | tee "$log"
            python3 scripts/ci/check_required_native_test.py "$log" --test "$selector"
          done
      - name: Reverify unchanged tested source
        if: always()
        run: |
          set -euo pipefail
          args=(--kind "$SOURCE_KIND" --expected-head "$EXPECTED_HEAD")
          if test "$SOURCE_KIND" = prospective-merge; then
            args+=(--expected-base "$EXPECTED_BASE" --expected-merge "$EXPECTED_MERGE")
          fi
          python3 scripts/ci/verify_ci_source.py "${args[@]}"
      - name: Retain current native results including every failure
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: native-boundary-${{ matrix.runner }}-${{ matrix.source }}-${{ github.event.pull_request.head.sha }}-${{ github.run_attempt }}
          path: ${{ runner.temp }}/native-boundary/
          if-no-files-found: error
          retention-days: 30

45b9594701a408974303c0e4d135e1c7231f51d6 blob 15665
name: PoN branch encoding exact-source acceptance
on:
  pull_request:
    paths:
      - trillionnium/crates/trnm-protocol/src/pon_wire.rs
      - trillionnium/crates/trnm-pon-node/src/consensus.rs
      - trillionnium/crates/trnm-pon-node/src/ingress/public_v3/scalar_cpu.rs
      - trillionnium/crates/trnm-pon-node/tests/public_v3_distinct_invalid_work.rs
      - trillionnium/crates/trnm-pon-node/src/account_archive_prototype.rs
      - trillionnium/crates/trnm-pon-node/src/account_archive_prototype/**
      - scripts/ci/check_native_constants_roster.py
      - scripts/ci/test_native_constants_roster.py
      - scripts/ci/check_consensus_roster.py
      - scripts/ci/test_consensus_roster.py
      - scripts/ci/test_branch_migration_count.py
      - evidence/branch-migration-count-20261106/**
      - .github/workflows/pon-branch-encoding-acceptance.yml
permissions:
  contents: read
jobs:
  branch:
    name: branch encoding (${{ matrix.runner }}, ${{ matrix.source }})
    strategy:
      fail-fast: false
      matrix:
        runner: [ubuntu-24.04, ubuntu-24.04-arm]
        source: [head, prospective-merge]
    runs-on: ${{ matrix.runner }}
    timeout-minutes: 25
    env:
      CARGO_INCREMENTAL: "0"
      CARGO_BUILD_JOBS: "2"
      RUST_TEST_THREADS: "1"
      PYTHONDONTWRITEBYTECODE: "1"
      EXPECTED_HEAD: ${{ github.event.pull_request.head.sha }}
      EXPECTED_BASE: ${{ github.event.pull_request.base.sha }}
      EXPECTED_MERGE: ${{ github.sha }}
      SOURCE_KIND: ${{ matrix.source }}
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
        with:
          ref: ${{ matrix.source == 'head' && github.event.pull_request.head.sha || github.sha }}
          fetch-depth: 0
          persist-credentials: false
      - name: Verify exact unchanged source and actual ordered main merge
        shell: bash
        run: |
          set -euo pipefail
          out="$RUNNER_TEMP/branch-exact"
          mkdir -p "$out"
          echo "OUT=$out" >> "$GITHUB_ENV"
          echo "CARGO_TARGET_DIR=$RUNNER_TEMP/target-branch-exact" >> "$GITHUB_ENV"
          args=(--kind "$SOURCE_KIND" --expected-head "$EXPECTED_HEAD")
          if test "$SOURCE_KIND" = prospective-merge; then
            args+=(--expected-base "$EXPECTED_BASE" --expected-merge "$EXPECTED_MERGE")
          fi
          python3 scripts/ci/verify_ci_source.py "${args[@]}" --output "$out/source.json"
          test "$(git hash-object trillionnium/crates/trnm-pon-node/src/account_archive_prototype.rs)" = 8bc87e56fc968927ab074262f694baa264eb9d76
          test "$(git hash-object trillionnium/crates/trnm-pon-node/src/account_archive_prototype/native_primitive_tests.rs)" = 2a4cfe2dd66692cfd27bc99948ee1d509ebb9dbf
          test "$(git hash-object trillionnium/crates/trnm-pon-node/src/account_archive_prototype/native_store.rs)" = ddc4e1d317ce962e453a1f08db7f608e43a8e152
          test "$(git hash-object trillionnium/crates/trnm-pon-node/src/account_archive_prototype/native_root_digest.rs)" = 95d0dc21b1154aa89990a7b81f35dccffc5f05c1
          test "$(git hash-object trillionnium/crates/trnm-pon-node/src/account_archive_prototype/native_root_digest_tests.rs)" = 9202edd5d62220f097ca4f7b87e4cbd2a130f8c4
          bash scripts/project-preflight.sh --audit
      - name: Install pinned native compiler and lint tools
        run: rustup toolchain install 1.95.0 --profile minimal --component rustfmt --component clippy
      - name: Prepare pinned OpenSSL 3.5.9 PQ provider
        id: pq_provider
        shell: bash
        run: |
          set -euo pipefail
          export TRNM_CI_RECEIPT_DIR="$OUT"
          bash scripts/ci/prepare_pq_provider.sh
      - name: Check committed formatting without rewriting source
        shell: bash
        run: |
          set -euo pipefail
          cargo +1.95.0 fmt --manifest-path trillionnium/Cargo.toml --all -- --check 2>&1 | tee "$OUT/format.log"
      - name: Require exact state-root grammar and unchanged complete-state errors
        shell: bash
        run: |
          set -euo pipefail
          test "$(git hash-object trillionnium/crates/trnm-protocol/src/pon_wire.rs)" = a92d02b7e1edd316aba52cb1b2ff8b546e65c03d
          cargo +1.95.0 test --release --locked --manifest-path trillionnium/Cargo.toml -p trnm-protocol --lib pon_wire:: -- --show-output --test-threads=1 2>&1 | tee "$OUT/state-wire.log"
          grep -E '^test result: ok\. 27 passed; 0 failed; 1 ignored;' "$OUT/state-wire.log"
          selector=pon_wire::tests::every_header_field_binds_its_wire_bytes_challenge_and_block_identity
          cargo +1.95.0 test --release --locked --manifest-path trillionnium/Cargo.toml -p trnm-protocol --lib "$selector" -- --exact --show-output --test-threads=1 2>&1 | tee "$OUT/header-binding.log"
          python3 scripts/ci/check_required_native_test.py "$OUT/header-binding.log" --test "$selector"
          for name in state_node_single_buffer_matches_original_wire state_empty_constants_match_all_depths_and_parallel_callers state_root_constants_do_not_cache_values_or_failures; do
            selector="pon_wire::streamed_state_root_tests::$name"
            cargo +1.95.0 test --release --locked --manifest-path trillionnium/Cargo.toml -p trnm-protocol --lib "$selector" -- --exact --show-output --test-threads=1 2>&1 | tee "$OUT/$name.log"
            python3 scripts/ci/check_required_native_test.py "$OUT/$name.log" --test "$selector"
          done
          selector=pon_wire::streamed_state_root_tests::state_node_and_complete_root_paired_cost_observation
          cargo +1.95.0 test --release --locked --manifest-path trillionnium/Cargo.toml -p trnm-protocol --lib "$selector" -- --exact --ignored --show-output --test-threads=1 2>&1 | tee "$OUT/state-root-cost.log"
          python3 scripts/ci/check_required_native_test.py "$OUT/state-root-cost.log" --test "$selector"
          cargo +1.95.0 clippy --locked --manifest-path trillionnium/Cargo.toml -p trnm-protocol --all-targets --all-features -- -D warnings 2>&1 | tee "$OUT/state-wire-clippy.log"
      - name: Execute entire retained primitive suite and exact new controls
        shell: bash
        run: |
          set -euo pipefail
          cargo +1.95.0 test --release --locked --manifest-path trillionnium/Cargo.toml -p trnm-pon-node --lib account_archive_prototype::native_primitive_tests -- --show-output --test-threads=1 2>&1 | tee "$OUT/primitive.log"
          grep -E '^test result: ok\. 11 passed; 0 failed; 3 ignored;' "$OUT/primitive.log"
          for name in native_branch_single_buffer_matches_original_wire native_branch_single_buffer_preserves_every_lift_depth; do
            selector="account_archive_prototype::native_primitive_tests::$name"
            cargo +1.95.0 test --release --locked --manifest-path trillionnium/Cargo.toml -p trnm-pon-node --lib "$selector" -- --exact --show-output --test-threads=1 2>&1 | tee "$OUT/$name.log"
            python3 scripts/ci/check_required_native_test.py "$OUT/$name.log" --test "$selector"
          done
          selector=account_archive_prototype::native_primitive_tests::native_branch_single_buffer_cost_observation
          cargo +1.95.0 test --release --locked --manifest-path trillionnium/Cargo.toml -p trnm-pon-node --lib "$selector" -- --exact --ignored --show-output --test-threads=1 2>&1 | tee "$OUT/cost.log"
          python3 scripts/ci/check_required_native_test.py "$OUT/cost.log" --test "$selector"
      - name: Require shared account crypto and retain both build-profile observations
        shell: bash
        run: |
          set -euo pipefail
          for profile in test release; do
            mode=()
            if test "$profile" = release; then mode=(--release); fi
            for name in shared_branch_kernel_matches_storage_local_vectors shared_branch_kernel_preserves_complete_account_roots shared_branch_kernel_complete_call_cost; do
              selector="account_archive_prototype::native_primitive_tests::$name"
              cargo +1.95.0 test "${mode[@]}" --locked --manifest-path trillionnium/Cargo.toml -p trnm-pon-node --lib "$selector" -- --exact --include-ignored --show-output --test-threads=1 2>&1 | tee "$OUT/$profile-$name.log"
              python3 scripts/ci/check_required_native_test.py "$OUT/$profile-$name.log" --test "$selector"
            done
          done
      - name: Verify immutable constants without caching stored-state verdicts
        shell: bash
        run: |
          set -euo pipefail
          cargo +1.95.0 test --release --locked --manifest-path trillionnium/Cargo.toml -p trnm-pon-node --lib account_archive_prototype::native_store::tests -- --show-output --test-threads=1 2>&1 | tee "$OUT/native-constants.log"
          python3 scripts/ci/test_native_constants_roster.py
          python3 scripts/ci/check_native_constants_roster.py "$OUT/native-constants.log"
          for name in native_empty_constants_match_wire_and_keep_owned_copy_isolation native_empty_constants_parallel_callers_keep_independent_values; do
            selector="account_archive_prototype::native_store::tests::$name"
            cargo +1.95.0 test --release --locked --manifest-path trillionnium/Cargo.toml -p trnm-pon-node --lib "$selector" -- --exact --show-output --test-threads=1 2>&1 | tee "$OUT/$name.log"
            python3 scripts/ci/check_required_native_test.py "$OUT/$name.log" --test "$selector"
          done
          selector=account_archive_prototype::native_store::tests::native_empty_constants_paired_cost_observation
          cargo +1.95.0 test --release --locked --manifest-path trillionnium/Cargo.toml -p trnm-pon-node --lib "$selector" -- --exact --ignored --show-output --test-threads=1 2>&1 | tee "$OUT/native-constant-cost.log"
          python3 scripts/ci/check_required_native_test.py "$OUT/native-constant-cost.log" --test "$selector"
      - name: Preserve complete existing native batch and migration controls
        shell: bash
        run: |
          set -euo pipefail
          cargo +1.95.0 test --release --locked --manifest-path trillionnium/Cargo.toml -p trnm-pon-node --lib account_archive_prototype::native_store::batch_tests -- --show-output --test-threads=1 2>&1 | tee "$OUT/batch.log"
          grep -E '^test result: ok\. [1-9][0-9]* passed; 0 failed;' "$OUT/batch.log"
          python3 scripts/ci/test_branch_migration_count.py
          cargo +1.95.0 test --release --locked --manifest-path trillionnium/Cargo.toml -p trnm-pon-node --lib authenticated_migration -- --show-output --test-threads=1 2>&1 | tee "$OUT/migration.log"
          grep -E '^test result: ok\. 40 passed; 0 failed; 0 ignored;' "$OUT/migration.log"
      - name: Require exact work arithmetic and unchanged full-profile public service
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/ci/test_consensus_roster.py
          cargo +1.95.0 test --release --locked --manifest-path trillionnium/Cargo.toml -p trnm-pon-node --lib consensus::tests:: -- --show-output --test-threads=1 2>&1 | tee "$OUT/work-arithmetic.log"
          python3 scripts/ci/check_consensus_roster.py "$OUT/work-arithmetic.log"
          for test in aligned_division_preserves_all_512_shift_and_limb_boundaries aligned_division_matches_original_for_wide_arbitrary_operands aligned_required_work_and_retarget_match_original_arithmetic native_arithmetic_matches_versioned_python_domain_vectors; do
            selector="consensus::tests::$test"
            cargo +1.95.0 test --release --locked --manifest-path trillionnium/Cargo.toml -p trnm-pon-node --lib "$selector" -- --exact --show-output --test-threads=1 2>&1 | tee "$OUT/$test.log"
            python3 scripts/ci/check_required_native_test.py "$OUT/$test.log" --test "$selector"
          done
          cargo +1.95.0 test --locked --manifest-path trillionnium/Cargo.toml -p trnm-pon-node --lib ingress::public_v3::scalar_cpu::request_owned_reserve_tests -- --show-output --test-threads=1 2>&1 | tee "$OUT/owned-cpu.log"
          grep -E '^test result: ok\. 9 passed; 0 failed; 0 ignored;' "$OUT/owned-cpu.log"
          for test in owned_quantum_remains_credited_when_request_crosses_its_first_quantum extended_request_cannot_spend_the_other_owned_quantum actual_cpu_extension_uses_its_own_reserve_and_settles_exact_total; do
            selector="ingress::public_v3::scalar_cpu::request_owned_reserve_tests::$test"
            cargo +1.95.0 test --locked --manifest-path trillionnium/Cargo.toml -p trnm-pon-node --lib "$selector" -- --exact --show-output --test-threads=1 2>&1 | tee "$OUT/$test.log"
            python3 scripts/ci/check_required_native_test.py "$OUT/$test.log" --test "$selector"
          done
          mkdir "$OUT/network-test-profile"
          # The mixed-service test writes its complete report before asserting its
          # honest-service target. Preserve failed phase/attempt evidence in the
          # same always-uploaded artifact without relaxing the original test.
          TRNM_PUBLIC_V3_CAMPAIGN_DIR="$OUT/mixed-service-campaign" \
          TRNM_CI_RECEIPT_DIR="$OUT/network-test-profile" \
          cargo +1.95.0 test --locked --manifest-path trillionnium/Cargo.toml -p trnm-pon-node --test public_v3_service_campaign -- --show-output --test-threads=1 2>&1 | tee "$OUT/network-test-profile.log"
          grep -E '^test result: ok\. 2 passed; 0 failed; 0 ignored;' "$OUT/network-test-profile.log"
      - name: Require distinct invalid-work rejection across real shared listeners
        if: ${{ always() && steps.pq_provider.outcome == 'success' }}
        shell: bash
        run: |
          set -euo pipefail
          selector=distinct_false_traces_and_cross_listener_retry_pay_one_shared_domain_without_effects
          cargo +1.95.0 test --locked --manifest-path trillionnium/Cargo.toml -p trnm-pon-node --test public_v3_distinct_invalid_work -- --show-output --test-threads=1 2>&1 | tee "$OUT/distinct-invalid-work.log"
          python3 scripts/ci/check_required_native_test.py "$OUT/distinct-invalid-work.log" --test "$selector"
      - name: Check complete native target lint without allowances
        shell: bash
        run: |
          set -euo pipefail
          cargo +1.95.0 clippy --locked --manifest-path trillionnium/Cargo.toml -p trnm-pon-node --all-targets --all-features -- -D warnings 2>&1 | tee "$OUT/clippy.log"
      - name: Recheck exact source and hash native logs
        if: always()
        shell: bash
        run: |
          set -euo pipefail
          args=(--kind "$SOURCE_KIND" --expected-head "$EXPECTED_HEAD")
          if test "$SOURCE_KIND" = prospective-merge; then
            args+=(--expected-base "$EXPECTED_BASE" --expected-merge "$EXPECTED_MERGE")
          fi
          python3 scripts/ci/verify_ci_source.py "${args[@]}" --output "$OUT/source-after.json"
          sha256sum "$OUT"/*.log > "$OUT/logs.sha256"
          printf 'Exact account-branch byte encoding and retained native checks only. Ignored original whole-capacity and long-cost experiments remain separate; original priority/full baseline still required. No work-proof qualification, whole-node speed, Sybil fairness, real model adoption, physical power loss, independent operators or WAN TPS claimed. Full ancestry/state traversal remains.\n' > "$OUT/SCOPE.txt"
      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        if: always()
        with:
          name: branch-exact-${{ matrix.runner }}-${{ matrix.source }}-${{ github.event.pull_request.head.sha }}-${{ github.run_attempt }}
          path: ${{ runner.temp }}/branch-exact
          if-no-files-found: error
          retention-days: 30

d9e7e2141ef26833deba030cb8b70d80c22274b6 blob 3896
name: PoN original budget component controls
on:
  pull_request:
    paths:
      - trillionnium/**
      - scripts/ci/run_pon_budget_controls.py
      - scripts/ci/test_pon_budget_controls.py
      - scripts/ci/check_required_native_test.py
      - scripts/ci/replay_pinned_native.py
      - scripts/ci/verify_ci_source.py
      - scripts/project-preflight.sh
      - scripts/ci/project_boundary.py
      - rust-toolchain.toml
      - .github/workflows/pon-budget-controls.yml
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: pon-budget-controls-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: false
env:
  CI: "true"
  CARGO_INCREMENTAL: "0"
  CARGO_BUILD_JOBS: "1"
  CARGO_TERM_COLOR: never
  RUST_TEST_THREADS: "1"
  PYTHONDONTWRITEBYTECODE: "1"
jobs:
  component-controls:
    name: Original budget controls (${{ matrix.source }})
    runs-on: ubuntu-24.04
    timeout-minutes: 60
    strategy:
      fail-fast: false
      matrix:
        source: [budget-before-v2, pool-before-v2, pool-scan-before, fixed]
    env:
      DRIVER_SHA: ${{ github.event.pull_request.head.sha || github.sha }}
      SUBJECT_SHA: ${{ matrix.source == 'budget-before-v2' && '89fb2269b0dd306fbd32c36f464842c3d7daee2b' || matrix.source == 'pool-before-v2' && '84e68b4f7a9b2f48f9c47ed05c9a44229d186e30' || matrix.source == 'pool-scan-before' && 'ae657e262278ae4a058220f66a6a0495721eb9ad' || github.event.pull_request.head.sha || github.sha }}
    steps:
      - name: Reserve fresh component observations
        env:
          SOURCE_MODE: ${{ matrix.source }}
        shell: bash
        run: |
          set -euo pipefail
          out="$RUNNER_TEMP/pon-budget-controls-$SOURCE_MODE-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          mkdir "$out"
          printf 'OUT=%s\n' "$out" >> "$GITHUB_ENV"
          printf 'CARGO_HOME=%s/cargo-budget-controls-%s\n' "$RUNNER_TEMP" "$SOURCE_MODE" >> "$GITHUB_ENV"
          printf 'CARGO_TARGET_DIR=%s/target-budget-controls-%s\n' "$RUNNER_TEMP" "$SOURCE_MODE" >> "$GITHUB_ENV"
          printf 'driver=%s\nsubject=%s\nmode=%s\nscope=component-controls-only\n' \
            "$DRIVER_SHA" "$SUBJECT_SHA" "$SOURCE_MODE" > "$out/request.txt"
      - name: Checkout exact current control driver
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ env.DRIVER_SHA }}
          path: driver
          fetch-depth: 0
          persist-credentials: false
      - name: Checkout exact independently measured source
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ env.SUBJECT_SHA }}
          path: subject
          fetch-depth: 0
          persist-credentials: false
      - name: Install the original pinned toolchain
        run: rustup toolchain install 1.95.0 --profile minimal
      - name: Require runner refusal controls
        shell: bash
        run: |
          set -euo pipefail
          python3 -B driver/scripts/ci/test_pon_budget_controls.py > "$OUT/runner-controls.stdout" 2> "$OUT/runner-controls.stderr"
      - name: Build once and execute the exact assigned controls
        shell: bash
        run: |
          set -euo pipefail
          python3 -B driver/scripts/ci/run_pon_budget_controls.py \
            --source "$GITHUB_WORKSPACE/subject" \
            --driver-sha "$DRIVER_SHA" --source-sha "$SUBJECT_SHA" \
            --mode "${{ matrix.source }}" --out "$OUT/native"
      - name: Preserve actual binaries, source receipts and all failures
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: pon-budget-controls-${{ matrix.source }}-${{ env.SUBJECT_SHA }}-${{ github.run_attempt }}
          path: ${{ env.OUT }}/
          if-no-files-found: error
          retention-days: 30
          compression-level: 1

36d0cdef797a21aca7e6884082ffb2a8d861b8a6 blob 3991
name: PoN isolated cloud build inputs
on:
  pull_request:
    paths:
      - .github/workflows/pon-cloud-build-inputs.yml
      - rust-toolchain.toml
      - trillionnium/Cargo.lock
      - trillionnium/**/Cargo.toml
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: pon-cloud-build-inputs-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: false
jobs:
  build-inputs:
    runs-on: ubuntu-24.04
    timeout-minutes: 30
    env:
      EXPECTED_HEAD: ${{ github.event.pull_request.head.sha || github.sha }}
      CARGO_BUILD_JOBS: "2"
      CARGO_INCREMENTAL: "0"
      PYTHONDONTWRITEBYTECODE: "1"
    steps:
      - name: Checkout the exact candidate without persistent credentials
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ env.EXPECTED_HEAD }}
          fetch-depth: 0
          persist-credentials: false
      - name: Verify source and reserve fresh output paths
        shell: bash
        run: |
          set -euo pipefail
          bash scripts/project-preflight.sh --audit
          out="$RUNNER_TEMP/pon-build-inputs-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          mkdir "$out"
          mkdir "$out/bundle"
          printf 'OUT=%s\n' "$out" >> "$GITHUB_ENV"
          printf 'CARGO_HOME=%s/cargo-build-inputs\n' "$RUNNER_TEMP" >> "$GITHUB_ENV"
          printf 'RUSTUP_HOME=%s/rustup-build-inputs\n' "$RUNNER_TEMP" >> "$GITHUB_ENV"
          python3 scripts/ci/verify_ci_source.py --kind head --expected-head "$EXPECTED_HEAD" --output "$out/source-before.json"
      - name: Obtain the pinned compiler and locked source dependencies
        shell: bash
        run: |
          set -euo pipefail
          rustup toolchain install 1.95.0 --profile minimal --component clippy --component rustfmt
          rustc +1.95.0 -Vv > "$OUT/bundle/rustc-version.txt"
          cargo +1.95.0 -Vv > "$OUT/bundle/cargo-version.txt"
          cargo +1.95.0 vendor --locked --manifest-path trillionnium/Cargo.toml "$OUT/bundle/vendor" > "$OUT/bundle/vendor-config.toml"
          cp trillionnium/Cargo.lock "$OUT/bundle/Cargo.lock"
          # Copy only the selected public toolchain and vendored crate sources.
          # Do not archive CARGO_HOME, credentials, runner state or the checkout.
          compiler="$(rustup which --toolchain 1.95.0 rustc)"
          toolchain="$(dirname "$(dirname "$compiler")")"
          cp -a "$toolchain" "$OUT/bundle/toolchain"
          cp "$OUT/source-before.json" "$OUT/bundle/source.json"
          printf 'Build inputs only. No test execution, work-security, model-efficacy, independent-operator or activation qualification is implied.\n' > "$OUT/bundle/SCOPE.txt"
      - name: Verify unchanged source and package the bounded input set
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/ci/verify_ci_source.py --kind head --expected-head "$EXPECTED_HEAD" --output "$OUT/source-after.json"
          tar -czf "$OUT/pon-cloud-build-inputs.tar.gz" -C "$OUT/bundle" .
          sha256sum "$OUT/pon-cloud-build-inputs.tar.gz" > "$OUT/pon-cloud-build-inputs.sha256"
      - name: Retain exact build inputs for offline cloud verification
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: pon-cloud-build-inputs-${{ env.EXPECTED_HEAD }}-${{ github.run_attempt }}
          path: |
            ${{ runner.temp }}/pon-build-inputs-${{ github.run_id }}-${{ github.run_attempt }}/pon-cloud-build-inputs.tar.gz
            ${{ runner.temp }}/pon-build-inputs-${{ github.run_id }}-${{ github.run_attempt }}/pon-cloud-build-inputs.sha256
            ${{ runner.temp }}/pon-build-inputs-${{ github.run_id }}-${{ github.run_attempt }}/source-before.json
            ${{ runner.temp }}/pon-build-inputs-${{ github.run_id }}-${{ github.run_attempt }}/source-after.json
          if-no-files-found: error
          compression-level: 0
          retention-days: 7

a54e2492abbef92685af3ea9c654bb6720511e95 blob 5669
name: PoN classical and quantum credit contract
on:
  pull_request:
    paths:
      - formal/pon-nakamoto-v1/**
      - scripts/ci/**
      - docs/protocol/pon-nakamoto-v1/details/CLASSICAL_QUANTUM_COST_AUDIT_20261108.md
      - .github/workflows/pon-credit-envelope.yml
permissions:
  contents: read
concurrency:
  group: pon-credit-envelope-${{ github.event.pull_request.number }}
  cancel-in-progress: false
env:
  PYTHONDONTWRITEBYTECODE: "1"
jobs:
  finite-credit-contract:
    name: Finite credit contract (${{ matrix.source }})
    runs-on: ubuntu-24.04
    timeout-minutes: 20
    strategy:
      fail-fast: false
      matrix:
        source: [head, prospective-merge]
    env:
      SOURCE_KIND: ${{ matrix.source }}
      EXPECTED_SOURCE: ${{ matrix.source == 'head' && github.event.pull_request.head.sha || github.sha }}
      EXPECTED_HEAD: ${{ github.event.pull_request.head.sha }}
      EXPECTED_BASE: ${{ github.event.pull_request.base.sha }}
    steps:
      - name: Checkout exact source
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ env.EXPECTED_SOURCE }}
          fetch-depth: 0
          persist-credentials: false
      - name: Verify full tracked source before checks
        id: source_before
        shell: bash
        run: |
          set -euo pipefail
          out="$RUNNER_TEMP/credit-envelope-$SOURCE_KIND-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          mkdir "$out"
          printf 'OUT=%s\n' "$out" >> "$GITHUB_ENV"
          args=(--kind "$SOURCE_KIND" --expected-head "$EXPECTED_HEAD")
          if test "$SOURCE_KIND" = prospective-merge; then
            args+=(--expected-base "$EXPECTED_BASE" --expected-merge "$EXPECTED_SOURCE")
          fi
          python3 scripts/ci/verify_ci_source.py "${args[@]}" --output "$out/source-before.json"
          bash scripts/project-preflight.sh --audit 2>&1 | tee "$out/preflight.log"
      - name: Execute pinned tests, verify credit witnesses and recompute costs
        id: finite_math
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/ci/run_credit_envelope_checks.py --output-dir "$OUT/finite-math" 2>&1 | tee "$OUT/finite-math.log"
      - name: Execute retained cost and source integrity controls
        id: retained
        shell: bash
        run: |
          set -euo pipefail
          python3 -m unittest discover -s formal/pon-nakamoto-v1 -p 'test_quantum_candidate_check_clock.py' -v 2>&1 | tee "$OUT/candidate-clock-controls.log"
          python3 -m unittest discover -s formal/pon-nakamoto-v1 -p 'test_w1_quantum_restricted_oracle.py' -v 2>&1 | tee "$OUT/restricted-oracle-controls.log"
          python3 -u scripts/ci/test_ci_source_integrity.py 2>&1 | tee "$OUT/source-integrity-controls.log"
          python3 scripts/ci/test_ci_contract.py 2>&1 | tee "$OUT/ci-contract-controls.log"
          python3 - <<'PY'
          import os, re
          from pathlib import Path
          for name in ('candidate-clock-controls.log',
                       'restricted-oracle-controls.log', 'source-integrity-controls.log',
                       'ci-contract-controls.log'):
              text = (Path(os.environ['OUT'])/name).read_text()
              runs = re.findall(r'^Ran ([0-9]+) tests? in .+$', text, re.M)
              terminal = re.search(r'(?:\A|\n)Ran ([1-9][0-9]*) tests? in [0-9]+(?:\.[0-9]+)?s\n\nOK\s*\Z', text)
              if len(runs) != 1 or terminal is None or terminal.group(1) != runs[0]:
                  raise SystemExit('missing, empty, skipped or unsuccessful suite: ' + name)
          PY
      - name: Verify full tracked source after checks
        id: source_after
        if: always() && steps.source_before.outcome == 'success'
        shell: bash
        run: |
          set -euo pipefail
          args=(--kind "$SOURCE_KIND" --expected-head "$EXPECTED_HEAD")
          if test "$SOURCE_KIND" = prospective-merge; then
            args+=(--expected-base "$EXPECTED_BASE" --expected-merge "$EXPECTED_SOURCE")
          fi
          python3 scripts/ci/verify_ci_source.py "${args[@]}" --output "$OUT/source-after.json"
          cmp "$OUT/source-before.json" "$OUT/source-after.json"
      - name: Require completed execution stages
        if: always()
        env:
          BEFORE: ${{ steps.source_before.outcome }}
          MATH: ${{ steps.finite_math.outcome }}
          RETAINED: ${{ steps.retained.outcome }}
          AFTER: ${{ steps.source_after.outcome }}
        shell: bash
        run: |
          set -euo pipefail
          python3 - <<'PY'
          import json, os
          from pathlib import Path
          stages = {name: os.environ[name] for name in ('BEFORE','MATH','RETAINED','AFTER')}
          if any(value != 'success' for value in stages.values()):
              raise SystemExit('incomplete or failed execution: ' + json.dumps(stages))
          record = json.loads((Path(os.environ['OUT'])/'finite-math/completion.json').read_text())
          if (record['finite_math_checks'] != 'PASS' or record['overall'] != 'HOLD'
                  or record['production_activation'] is not False):
              raise SystemExit('unexpected finite-math scope')
          PY
      - name: Retain results and failures
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: credit-envelope-${{ matrix.source }}-${{ env.EXPECTED_SOURCE }}-${{ github.run_attempt }}
          path: ${{ runner.temp }}/credit-envelope-${{ matrix.source }}-${{ github.run_id }}-${{ github.run_attempt }}/
          if-no-files-found: error
          retention-days: 30

19979c73dea632842eb8edf5c7098703e4387e8a blob 16082
name: PoN fixed Host ROOT F0 diagnostic
on:
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: pon-fixed-host-root-f0-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: false
jobs:
  fixed-host-root-f0:
    name: F0 (x64, head, one baseline and one ROOT phase)
    if: >-
      github.repository == 'TrillionniumFoundation/Trillionnium-Chain' &&
      (github.event_name == 'workflow_dispatch' ||
       (github.event_name == 'pull_request' &&
        github.event.pull_request.head.repo.full_name == github.repository &&
        github.event.pull_request.head.repo.fork == false))
    runs-on: ubuntu-24.04
    # Includes separately bounded dependency acquisition/build and always cleanup;
    # the actual native invocation remains a single 540-second outer cap.
    timeout-minutes: 100
    env:
      CI: "true"
      CARGO_INCREMENTAL: "0"
      CARGO_BUILD_JOBS: "2"
      RUST_TEST_THREADS: "1"
      PYTHONDONTWRITEBYTECODE: "1"
      EXPECTED_HEAD: ${{ github.event.pull_request.head.sha || github.sha }}
    steps:
      - name: Freeze all denominators before checkout or preparation
        id: reserve
        shell: bash
        run: |
          set -euo pipefail
          out="$RUNNER_TEMP/pon-fixed-host-root-f0-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          mkdir "$out"
          printf 'OUT=%s\n' "$out" >> "$GITHUB_ENV"
          printf 'CARGO_HOME=%s/cargo-fixed-host-root-f0\n' "$RUNNER_TEMP" >> "$GITHUB_ENV"
          printf 'CARGO_TARGET_DIR=%s/target-fixed-host-root-f0\n' "$RUNNER_TEMP" >> "$GITHUB_ENV"
          export F0_PREDECLARED_OUT="$out"
          python3 - <<'PY'
          from datetime import datetime, timezone
          import json, os, re
          from pathlib import Path
          out = Path(os.environ['F0_PREDECLARED_OUT'])
          head = os.environ['EXPECTED_HEAD']
          if re.fullmatch('[0-9a-f]{40}', head) is None:
              raise ValueError('full event head SHA required')
          phases = ['baseline', 'valid-work-root']
          value = {
              'schema': 'fixed-host-root-f0-workflow-predeclaration-v1',
              'head': head, 'tree': None, 'source_kind': 'event-head',
              'run_id': os.environ['GITHUB_RUN_ID'], 'run_attempt': os.environ['GITHUB_RUN_ATTEMPT'],
              'job_id': os.environ['GITHUB_JOB'], 'created_utc': datetime.now(timezone.utc).isoformat(),
              'selector': 'fixed_public_host_root_rejection_and_signed_confirmation_diagnostic',
              'planned_complete_runs': 1, 'planned_phases': phases,
              'planned_confirmations': 6, 'planned_business_packet_exposures': 42,
              'all_planned_rounds': [
                  {'phase': phase, 'round': number, 'scheduled_offset_ns': (1+number*4)*1000000000,
                   'actual_started_ns': None, 'actual_ended_ns': None,
                   'four_second_slo_met': False, 'status': 'unobserved'}
                  for phase in phases for number in range(3)],
              'all_planned_business_packets': [
                  {'phase': phase, 'packet_index': number, 'observed_attempts': 0,
                   'timely_network_ack': False, 'ack_is_not_confirmation': True}
                  for phase in phases for number in range(21)],
              'public_host': {'cpu_max': '25000 100000', 'memory_max': '2147483648'},
              'paid_burst_ns': 2000000000, 'paid_refill_ns_per_second': 250000000,
              'phase_window_ns': 30000000000, 'new_f0_four_second_slo_ns': 4000000000,
              'slo_from_scheduled_time_includes_queue_and_final_observer': True,
              'old_root_per_round_four_second_predicate_existed': False,
              'controller_ceiling_is_not_reserved_physical_capacity': True,
              'controller_resource_schema': 'fixed-host-root-controller-resources-v1',
              'planned_controller_resource_boundary_samples': 6,
              'all_controller_resource_boundaries': [
                  {'phase': phase, 'stage': stage, 'complete': False, 'status': 'unobserved'}
                  for phase in phases for stage in ('before_launch','actors_ready','after_reap')],
              'controller_resources_complete': False, 'per_actor_rss_qualified': False,
              'selector_invocation_attempted': False, 'native_execution_observed': False,
              'service_remaining': 'unknown', 'independent_wan_qualification': False,
              'f1_implemented': False, 'production_activation': False,
          }
          with (out/'workflow-predeclared.json').open('x') as stream:
              json.dump(value, stream, indent=2, sort_keys=True)
              stream.write('\n')
          (out/'SCOPE.txt').write_text(
              'One finite x64 head baseline/ROOT pair: 6 confirmations and 42 business exposures. '
              'All unobserved, failed and late outcomes remain. No independent operators, '
              'multi-day WAN, quantum hardness, production or F1 qualification. '
              'Controller 4-core/16GiB limits are ceilings; actual RAM and affinity are recorded.\n')
          PY
      - name: Checkout exactly the event head without retained credentials
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ env.EXPECTED_HEAD }}
          fetch-depth: 0
          persist-credentials: false
      - name: Verify the exact source and all independent parser controls
        id: source
        timeout-minutes: 3
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/ci/verify_ci_source.py --kind head --expected-head "$EXPECTED_HEAD" --output "$OUT/source-before.json" > "$OUT/source-before.log" 2>&1
          expected_tree="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["tested_tree"])' "$OUT/source-before.json")"
          printf 'EXPECTED_TREE=%s\n' "$expected_tree" >> "$GITHUB_ENV"
          bash scripts/project-preflight.sh --audit 2>&1 | tee "$OUT/preflight.log"
          python3 -m unittest discover -s scripts/ci -p 'test_native_phase_host.py' -v 2>&1 | tee "$OUT/original-launcher-controls.log"
          python3 -m unittest discover -s scripts/ci -p 'test_fixed_root*.py' -v 2>&1 | tee "$OUT/f0-source-controls.log"
      - name: Install source-pinned compiler and fetch the locked graph
        id: toolchain
        timeout-minutes: 15
        shell: bash
        run: |
          set -euo pipefail
          rustup toolchain install 1.95.0 --profile minimal --component clippy --component rustfmt 2>&1 | tee "$OUT/toolchain-install.log"
          rustc +1.95.0 -Vv > "$OUT/rustc-version.txt"
          cargo +1.95.0 -Vv > "$OUT/cargo-version.txt"
          cargo +1.95.0 fetch --locked --manifest-path trillionnium/Cargo.toml --target x86_64-unknown-linux-gnu 2>&1 | tee "$OUT/dependency-fetch.log"
      - name: Prepare one source-bound ELF and execute five original plus two resource controls
        id: preparation
        timeout-minutes: 58
        shell: bash
        run: |
          set -euo pipefail
          test "$(uname -m)" = x86_64
          python3 scripts/run_fixed_host_root_f0.py prepare --out "$OUT/prepared" \
            --expected-head "$EXPECTED_HEAD" --expected-tree "$EXPECTED_TREE" \
            --cargo "$(command -v cargo)" --target-dir "$CARGO_TARGET_DIR" \
            > "$OUT/preparation.stdout.log" 2> "$OUT/preparation.stderr.log"
      - name: Arm a previously absent exact controller service
        id: arm
        timeout-minutes: 1
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/ci/finalize_fixed_root_f0.py controller-intent --out "$OUT" \
            --expected-head "$EXPECTED_HEAD" --expected-tree "$EXPECTED_TREE" \
            > "$OUT/controller-arm.stdout.log" 2> "$OUT/controller-arm.stderr.log"
          python3 - <<'PY'
          import json, os
          from pathlib import Path
          value = json.loads((Path(os.environ['OUT'])/'controller-intent.json').read_text())
          with open(os.environ['GITHUB_ENV'], 'a') as stream:
              for key, field in [('F0_UNIT','service'), ('F0_DESCRIPTION','description'), ('PREPARED_SHA','job_sha256')]:
                  if '\n' in value[field] or '\r' in value[field]:
                      raise ValueError('single-line controller identity required')
                  stream.write(key+'='+value[field]+'\n')
          PY
      - name: Run exactly one pair in the declared controller and public Host
        id: execution
        timeout-minutes: 11
        shell: bash
        run: |
          set -euo pipefail
          test "$(id -u)" -ne 0
          test -d /run/systemd/system
          test -f /sys/fs/cgroup/cgroup.controllers
          systemd-run --version > "$OUT/systemd-version.txt"
          rustup_home="$(rustup show home)"
          # The always finalizer handles both controller and separately owned
          # public services, after exact receipt/manager/invocation validation.
          sudo -n systemd-run --unit="$F0_UNIT" --description="$F0_DESCRIPTION" --wait --pipe --collect \
            --service-type=exec --expand-environment=no \
            --uid="$(id -u)" --gid="$(id -g)" --working-directory="$GITHUB_WORKSPACE" \
            --property=CPUAccounting=yes --property=MemoryAccounting=yes \
            --property=CPUQuota=400% --property=CPUQuotaPeriodSec=100ms \
            --property=MemoryMax=17179869184 --property=Nice=10 \
            --property=KillMode=control-group --property=TimeoutStopSec=20s --property=RuntimeMaxSec=600s \
            --setenv="PATH=$PATH" --setenv="CARGO_HOME=$CARGO_HOME" \
            --setenv="CARGO_TARGET_DIR=$CARGO_TARGET_DIR" --setenv="RUSTUP_HOME=$rustup_home" \
            --setenv=CARGO_INCREMENTAL=0 --setenv=CARGO_BUILD_JOBS=2 --setenv=RUST_TEST_THREADS=1 \
            --setenv=PYTHONDONTWRITEBYTECODE=1 --setenv=CI=true --setenv=GITHUB_ACTIONS=true \
            --setenv="GITHUB_WORKSPACE=$GITHUB_WORKSPACE" --setenv="GITHUB_RUN_ID=$GITHUB_RUN_ID" \
            --setenv="GITHUB_RUN_ATTEMPT=$GITHUB_RUN_ATTEMPT" --setenv="GITHUB_JOB=$GITHUB_JOB" \
            /usr/bin/python3 "$GITHUB_WORKSPACE/scripts/run_fixed_host_root_f0.py" execute \
            --out "$OUT/execution" --expected-head "$EXPECTED_HEAD" --expected-tree "$EXPECTED_TREE" \
            --prepared "$OUT/prepared/prepared.json" --prepared-sha256 "$PREPARED_SHA" --unit "$F0_UNIT" \
            > "$OUT/systemd-run.stdout.log" 2> "$OUT/systemd-run.stderr.log"
      - name: Always retain denominators and inspect only exact owned services
        id: finalization
        if: always() && steps.reserve.outcome == 'success'
        timeout-minutes: 4
        env:
          VERIFIED_SOURCE_OUTCOME: ${{ steps.source.outcome }}
        shell: bash
        run: |
          set -uo pipefail
          if [ "$VERIFIED_SOURCE_OUTCOME" = success ] && [ -n "${EXPECTED_TREE:-}" ]; then
            python3 scripts/ci/finalize_fixed_root_f0.py finalize --out "$OUT" \
              --expected-head "$EXPECTED_HEAD" --expected-tree "$EXPECTED_TREE" \
              > "$OUT/finalization.stdout.log" 2> "$OUT/finalization.stderr.log"
            finalization_status=$?
          else
            # No unverified checkout code or guessed unit receives cleanup authority.
            python3 - <<'PY'
          import json, os
          from pathlib import Path
          out = Path(os.environ['OUT'])
          prior = json.loads((out/'workflow-predeclared.json').read_text())
          with (out/'finalization-not-run.json').open('x') as stream:
              json.dump({'source_unverified': True, 'cleanup_attempted': False,
                         'service_remaining': 'unknown', 'complete_success': False,
                         'denominator': prior}, stream, indent=2, sort_keys=True)
              stream.write('\n')
          PY
            finalization_status=1
          fi
          printf 'exit_code=%s\n' "$finalization_status" > "$OUT/finalization-status.txt"
          exit "$finalization_status"
      - name: Retain final source, workflow outcomes and every regular partial artifact
        id: inventory
        if: always() && steps.reserve.outcome == 'success'
        env:
          SOURCE_OUTCOME: ${{ steps.source.outcome }}
          TOOLCHAIN_OUTCOME: ${{ steps.toolchain.outcome }}
          PREPARATION_OUTCOME: ${{ steps.preparation.outcome }}
          ARM_OUTCOME: ${{ steps.arm.outcome }}
          EXECUTION_OUTCOME: ${{ steps.execution.outcome }}
          FINALIZATION_OUTCOME: ${{ steps.finalization.outcome }}
        shell: bash
        run: |
          set -uo pipefail
          source_status=1
          if [ "$SOURCE_OUTCOME" = success ]; then
            python3 scripts/ci/verify_ci_source.py --kind head --expected-head "$EXPECTED_HEAD" --output "$OUT/source-after.json" > "$OUT/source-after.log" 2>&1
            source_status=$?
          fi
          export F0_SOURCE_AFTER_STATUS="$source_status"
          python3 - <<'PY'
          import hashlib, json, os, stat, uuid
          from pathlib import Path
          out = Path(os.environ['OUT'])
          outcome = {key: os.environ[key] for key in (
              'SOURCE_OUTCOME','TOOLCHAIN_OUTCOME','PREPARATION_OUTCOME','ARM_OUTCOME',
              'EXECUTION_OUTCOME','FINALIZATION_OUTCOME','F0_SOURCE_AFTER_STATUS')}
          with (out/'workflow-outcomes.json').open('x') as stream:
              json.dump(outcome, stream, indent=2, sort_keys=True)
              stream.write('\n')
          files, paths, errors = [], [], []
          for path in sorted(out.rglob('*')):
              try:
                  before = path.lstat()
                  if stat.S_ISDIR(before.st_mode):
                      continue
                  if not stat.S_ISREG(before.st_mode) or path.resolve(strict=True) != path or '\n' in str(path) or '\r' in str(path):
                      raise ValueError('only exact regular artifact paths may be uploaded')
                  digest = hashlib.sha256()
                  with path.open('rb') as stream:
                      for chunk in iter(lambda: stream.read(1024*1024), b''):
                          digest.update(chunk)
                  after = path.lstat()
                  if (before.st_dev,before.st_ino,before.st_size,before.st_mtime_ns) != (after.st_dev,after.st_ino,after.st_size,after.st_mtime_ns):
                      raise ValueError('artifact changed during inventory')
                  files.append({'path': str(path.relative_to(out)), 'bytes': before.st_size, 'sha256': digest.hexdigest()})
                  paths.append(str(path))
              except (OSError, ValueError) as error:
                  errors.append({'path': str(path.relative_to(out)), 'failure': str(error)})
          manifest = out/'artifact-files.json'
          with manifest.open('x') as stream:
              json.dump({'schema':'fixed-host-root-f0-artifact-inventory-v1',
                         'files':files, 'errors':errors, 'all_files_retained':not errors,
                         'scope':'all regular success, failure and partial evidence; not a PASS verdict'},
                        stream, indent=2, sort_keys=True)
              stream.write('\n')
          paths.append(str(manifest))
          boundary = 'F0_FILES_'+uuid.uuid4().hex
          with open(os.environ['GITHUB_OUTPUT'], 'a') as stream:
              stream.write('paths<<'+boundary+'\n'+'\n'.join(paths)+'\n'+boundary+'\n')
          raise SystemExit(1 if errors else 0)
          PY
          inventory_status=$?
          test "$source_status" -eq 0 && test "$inventory_status" -eq 0
      - name: Upload all available success, failure and unobserved evidence
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: pon-fixed-host-root-f0-x64-head-${{ env.EXPECTED_HEAD }}-${{ github.run_attempt }}
          path: ${{ steps.inventory.outputs.paths }}
          if-no-files-found: error
          include-hidden-files: true
          retention-days: 30

88b0ed45d65aff17d5cf5e0e14f7516efee24746 blob 4214
name: PoN independent History stage diagnostic
on:
  push:
    branches: [fix/chain-six-axis-performance-20261103]
    paths:
      - .github/workflows/pon-history-stage-diagnostic.yml
      - scripts/ci/run_history_diagnostic.py
      - scripts/ci/test_history_stage_diagnostic.py
      - trillionnium/crates/trnm-pon-node/tests/history_stage_diagnostic.rs
      # Relevant replay/Host changes need stage evidence too. This is not a
      # complete dependency graph or an additional qualification gate.
      - trillionnium/crates/trnm-pon-node/src/store.rs
      - trillionnium/crates/trnm-pon-node/src/store/**
      - trillionnium/crates/trnm-pon-node/src/ingress.rs
      - trillionnium/crates/trnm-pon-node/src/ingress/**
      - trillionnium/crates/trnm-pon-node/src/host_kernel_parent.rs
      - trillionnium/crates/trnm-mvcc-fee/src/pon_commitment.rs
      - trillionnium/crates/trnm-mvcc-fee/src/pon_executor.rs
      - trillionnium/crates/trnm-protocol/src/pon_state.rs
      - trillionnium/crates/trnm-protocol/src/pon_wire.rs
      - trillionnium/crates/trnm-protocol/src/pon_wire/state_root_arithmetic.rs
      - trillionnium/crates/trnm-pon-node/tests/ancestry_long_sync.rs
      - scripts/ci/run_from_zero_host.py
      - scripts/ci/public_host_ci_observation.py
      - scripts/ci/public_fixture_host_lease.py
      - config/systemd/trnmponpublic.slice
permissions:
  contents: read
concurrency:
  group: pon-history-stage-diagnostic-${{ github.sha }}
  cancel-in-progress: false
env:
  CI: "true"
  CARGO_INCREMENTAL: "0"
  CARGO_BUILD_JOBS: "2"
  RUST_TEST_THREADS: "1"
  PYTHONDONTWRITEBYTECODE: "1"
jobs:
  diagnostic:
    name: Instrumented History x64 replica ${{ matrix.replica }} (not qualification)
    runs-on: ubuntu-24.04
    timeout-minutes: 180
    strategy:
      fail-fast: false
      matrix:
        replica: [1, 2]
    env:
      SOURCE_KIND: head
      TRNM_EXPECTED_SOURCE_SHA: ${{ github.sha }}
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ github.sha }}
          fetch-depth: 0
          persist-credentials: false
      - name: Bind exact diagnostic source
        id: source
        shell: bash
        run: |
          set -euo pipefail
          export TRNM_CI_RECEIPT_DIR="$RUNNER_TEMP/history-stage-diagnostic"
          mkdir -p "$TRNM_CI_RECEIPT_DIR"
          printf 'TRNM_CI_RECEIPT_DIR=%s\n' "$TRNM_CI_RECEIPT_DIR" >> "$GITHUB_ENV"
          printf 'CARGO_HOME=%s/cargo-history-diagnostic\n' "$RUNNER_TEMP" >> "$GITHUB_ENV"
          printf 'CARGO_TARGET_DIR=%s/target-history-diagnostic\n' "$RUNNER_TEMP" >> "$GITHUB_ENV"
          python3 scripts/ci/verify_ci_source.py --kind head --expected-head "$GITHUB_SHA" --output "$TRNM_CI_RECEIPT_DIR/source.json"
          bash scripts/project-preflight.sh --audit
          python3 scripts/ci/test_history_stage_diagnostic.py
          python3 scripts/ci/test_from_zero_host_ci.py
      - name: Retain non-authoritative host hardware context
        shell: bash
        run: |
          set -euo pipefail
          lscpu --json > "$TRNM_CI_RECEIPT_DIR/lscpu.json"
          uname -srmo > "$TRNM_CI_RECEIPT_DIR/kernel.txt"
      - name: Install pinned Rust
        run: rustup toolchain install 1.95.0 --profile minimal
      - name: Prepare instrumented binary outside measurement
        id: build
        run: python3 scripts/ci/run_history_diagnostic.py --prepare --out "$TRNM_CI_RECEIPT_DIR/history-diagnostic"
      - name: Execute original resource limits with every diagnostic failure retained
        if: ${{ !cancelled() && steps.build.outcome == 'success' }}
        run: python3 scripts/ci/run_from_zero_host.py -- python3 scripts/ci/run_history_diagnostic.py --out "$TRNM_CI_RECEIPT_DIR/history-diagnostic"
      - name: Retain every replica, including failed or partial observations
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: history-stage-diagnostic-x64-${{ matrix.replica }}-${{ github.sha }}-${{ github.run_attempt }}
          path: ${{ runner.temp }}/history-stage-diagnostic
          if-no-files-found: error
          retention-days: 30

6a183a6add41884730b202a402a934c9dbbcca65 blob 3431
name: PoN learning outcome composition
on:
  pull_request:
    paths:
      - .github/workflows/pon-learning-outcome-composition.yml
      - scripts/cell_learning_local_use_join.py
      - scripts/capture_cell_learning_local_use.py
      - scripts/test_cell_learning_local_use_join.py
      - scripts/cell_learning_local_decision_join.py
      - scripts/test_cell_learning_local_decision_join.py
      - scripts/cell_adoption_readback.py
      - scripts/test_cell_adoption_readback.py
      - scripts/cell_learning_iteration_join.py
      - scripts/test_cell_learning_iteration_join.py
      - scripts/cell_learning_completion_join.py
      - scripts/capture_cell_learning_completion.py
      - scripts/cell_learning_scope_join.py
      - scripts/test_cell_learning_scope_join.py
      - scripts/ci/verify_ci_source.py
      - scripts/project-preflight.sh
      - scripts/ci/project_boundary.py
      - PROJECT_BOUNDARY.json
      - PROJECT_ID
      - evidence/heplcp04-completed-use-20261111/**
permissions:
  contents: read
jobs:
  native-use-readback:
    runs-on: ubuntu-24.04
    timeout-minutes: 10
    strategy:
      fail-fast: false
      matrix:
        lane: [head, prospective-merge]
    env:
      PYTHONDONTWRITEBYTECODE: "1"
      SOURCE: ${{ github.event.pull_request.head.sha }}
      BASE: ${{ github.event.pull_request.base.sha }}
      TESTED: ${{ matrix.lane == 'head' && github.event.pull_request.head.sha || github.sha }}
      LANE: ${{ matrix.lane }}
    steps:
      - uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd
        with:
          ref: ${{ env.TESTED }}
          fetch-depth: 0
          persist-credentials: false
      - name: Observe the actual source
        run: |
          set -euo pipefail
          args=(--kind "$LANE" --expected-head "$SOURCE")
          if test "$LANE" = prospective-merge; then
            args+=(--expected-base "$BASE" --expected-merge "$TESTED")
          fi
          python3 scripts/ci/verify_ci_source.py "${args[@]}" --output "$RUNNER_TEMP/local-use-source-before.json"
          cat "$RUNNER_TEMP/local-use-source-before.json"
          bash scripts/project-preflight.sh --audit
      - name: Replay original completed-use exports and composition attacks
        run: |
          set -euo pipefail
          python3 -B scripts/test_cell_learning_local_use_join.py -v 2>&1 | tee "$RUNNER_TEMP/local-use-tests.log"
      - name: Recheck the actual source
        if: always()
        run: |
          set -euo pipefail
          args=(--kind "$LANE" --expected-head "$SOURCE")
          if test "$LANE" = prospective-merge; then
            args+=(--expected-base "$BASE" --expected-merge "$TESTED")
          fi
          python3 scripts/ci/verify_ci_source.py "${args[@]}" --output "$RUNNER_TEMP/local-use-source-after.json"
          cat "$RUNNER_TEMP/local-use-source-after.json"
          git diff --exit-code
      - name: Retain exact source and local-use replay logs
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: heplcp04-local-use-${{ matrix.lane }}-${{ github.run_id }}-${{ github.run_attempt }}
          path: |
            ${{ runner.temp }}/local-use-source-before.json
            ${{ runner.temp }}/local-use-source-after.json
            ${{ runner.temp }}/local-use-tests.log
          if-no-files-found: error
          retention-days: 30

c58bf49b7be97e747314e2814fa5c4cc9295e891 blob 30537
name: PoN Legacy reorg observation validation
on:
  push:
    branches:
      - fix/chain-legacy-reorg-cost-20261104
permissions:
  contents: read
concurrency:
  group: pon-legacy-reorg-cost-${{ github.ref }}
  cancel-in-progress: false
env:
  CI: "true"
  CARGO_INCREMENTAL: "0"
  CARGO_BUILD_JOBS: "2"
  RUST_TEST_THREADS: "1"
  PYTHONDONTWRITEBYTECODE: "1"
jobs:
  controls:
    name: Legacy observation controls (ARM head)
    runs-on: ubuntu-24.04-arm
    timeout-minutes: 180
    env:
      SOURCE_KIND: head
      EXPECTED_HEAD: ${{ github.sha }}
      TRNM_EXPECTED_SOURCE_SHA: ${{ github.sha }}
    steps:
      - name: Checkout the exact isolated candidate
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ github.sha }}
          fetch-depth: 0
          persist-credentials: false
      - name: Verify candidate, module presence and original project boundary
        id: source
        shell: bash
        run: |
          set -euo pipefail
          test "$GITHUB_EVENT_NAME" = push
          test "$GITHUB_REF" = refs/heads/fix/chain-legacy-reorg-cost-20261104
          export TRNM_CI_RECEIPT_DIR="$RUNNER_TEMP/legacy-reorg-controls"
          mkdir -p "$TRNM_CI_RECEIPT_DIR/commands"
          printf 'TRNM_CI_RECEIPT_DIR=%s\n' "$TRNM_CI_RECEIPT_DIR" >> "$GITHUB_ENV"
          printf 'CARGO_HOME=%s/cargo-legacy-reorg-controls\n' "$RUNNER_TEMP" >> "$GITHUB_ENV"
          printf 'CARGO_TARGET_DIR=%s/target-legacy-reorg-controls\n' "$RUNNER_TEMP" >> "$GITHUB_ENV"
          python3 scripts/ci/verify_ci_source.py --kind head --expected-head "$EXPECTED_HEAD" --output "$TRNM_CI_RECEIPT_DIR/source.json"
          bash scripts/project-preflight.sh --audit | tee "$TRNM_CI_RECEIPT_DIR/audit-before.json"
          python3 - <<'PY'
          import json, os
          from pathlib import Path
          root = Path(os.environ["TRNM_CI_RECEIPT_DIR"])
          module = Path("trillionnium/crates/trnm-pon-node/src/store/legacy_reorg_observation_tests.rs")
          assert module.is_file() and not module.is_symlink() and module.stat().st_size > 0, "missing real Legacy observation test module"
          source = module.read_text(encoding="utf-8")
          store = Path("trillionnium/crates/trnm-pon-node/src/store.rs").read_text(encoding="utf-8")
          assert "mod legacy_reorg_observation_tests;" in store, "Legacy observation module is not wired into Store"
          selectors = ["store::legacy_reorg_observation_tests::legacy_observation_opt_in_is_local_and_keeps_unentered_unknown","store::legacy_reorg_observation_tests::legacy_observation_preserves_signed_reorg_state_and_progress","store::legacy_reorg_observation_tests::legacy_observation_preserves_cancelled_and_failed_reorg_outcomes","store::native_authenticated::history_arithmetic::tests::nested_observations_do_not_hold_a_guard_across_cancellation_or_change_errors","store::reorg_cancellation::tests::cancellation_terminates_only_staging_and_preserves_full_active_state","store::reorg_cancellation::tests::paid_cancellation_reserves_headroom_and_settles_the_original_account_once","store::reorg_cancellation::tests::forgotten_termination_principal_cannot_be_reported_as_a_clean_cpu_close"]
          assert len(selectors) == len(set(selectors)) == 7
          for selector in selectors[:3]:
              assert "fn " + selector.rsplit("::", 1)[1] + "(" in source, "missing new behavior comparison test"
          (root / "selectors.json").write_text(json.dumps(selectors, indent=2) + "\n")
          (root / "selectors.txt").write_text("\n".join(selectors) + "\n")
          scope = {
              "schema": "trnm-legacy-reorg-observation-validation-v1",
              "source_kind": "head", "candidate": os.environ["GITHUB_SHA"],
              "planned_named_controls": 7, "completed_named_controls": None,
              "new_behavior_controls": selectors[:3], "retained_sql_cancellation_controls": selectors[3:],
              "complete_workspace_no_run_required": True,
              "ancestry_integration_executable_required": True,
              "diagnostic_depends_on_all_controls": True,
              "controlled_performance_gain_claimed": False,
              "public_business_acceptance_granted": False,
              "scope": "exact isolated push source; test-profile controls and compile checks precede a separate original release-profile ARM History diagnostic"
          }
          (root / "scope.json").write_text(json.dumps(scope, indent=2) + "\n")
          print(json.dumps(scope, sort_keys=True))
          PY
          cat > "$TRNM_CI_RECEIPT_DIR/run-command.sh" <<'SH'
          set -euo pipefail
          label="$1"
          shift
          command_status=0
          python3 scripts/ci/record_pq_native_command.py --kind head --candidate "$EXPECTED_HEAD" --tested "$EXPECTED_HEAD" --label "$label" --output "$TRNM_CI_RECEIPT_DIR/commands" -- "$@" || command_status=$?
          if test -f "$TRNM_CI_RECEIPT_DIR/commands/$label.log"; then
            case "$label" in
              format|native-*|test_*|clippy) cat "$TRNM_CI_RECEIPT_DIR/commands/$label.log" ;;
              *) if test "$command_status" -ne 0; then tail -n 200 "$TRNM_CI_RECEIPT_DIR/commands/$label.log"; fi ;;
            esac
          fi
          exit "$command_status"
          SH
      - name: Run original negative source and claim integrity controls
        id: source_controls
        shell: bash
        run: |
          set -euo pipefail
          for test_file in test_ci_source_integrity.py test_record_pq_native_command.py test_pq_research_integration.py test_pq_chain_claim_guard.py test_pq_authority_surface_scan.py; do
            label="$(basename "$test_file" .py)"
            bash "$TRNM_CI_RECEIPT_DIR/run-command.sh" "$label" python3 -m unittest discover -s scripts/ci -p "$test_file" -v
          done
          bash "$TRNM_CI_RECEIPT_DIR/run-command.sh" pq-source python3 scripts/ci/check_pq_research_integration.py
          bash "$TRNM_CI_RECEIPT_DIR/run-command.sh" pq-hold python3 scripts/ci/pq_chain_claim_guard.py
          bash "$TRNM_CI_RECEIPT_DIR/run-command.sh" repository python3 scripts/ci/check_repository.py
          bash "$TRNM_CI_RECEIPT_DIR/run-command.sh" inventory python3 scripts/refresh_distributed_source_inventory.py --check
      - name: Install the original pinned compiler
        id: toolchain
        run: rustup toolchain install 1.95.0 --profile minimal --component rustfmt --component clippy
      - name: Check formatting before every build and native execution
        id: format
        shell: bash
        run: |
          set -euo pipefail
          bash "$TRNM_CI_RECEIPT_DIR/run-command.sh" format cargo +1.95.0 fmt --manifest-path trillionnium/Cargo.toml --all -- --check
      - name: Prepare the independently pinned OpenSSL provider for controls
        id: pq_provider
        shell: bash
        run: |
          set -euo pipefail
          bash scripts/ci/prepare_pq_provider.sh
      - name: Record compiler and the exact locked graph
        id: locked_inputs
        shell: bash
        run: |
          set -euo pipefail
          bash "$TRNM_CI_RECEIPT_DIR/run-command.sh" compiler rustc +1.95.0 -Vv
          bash "$TRNM_CI_RECEIPT_DIR/run-command.sh" locked-graph cargo +1.95.0 metadata --locked --manifest-path trillionnium/Cargo.toml --format-version 1
      - name: Build the original complete workspace in the unchanged test profile
        id: build
        if: ${{ !cancelled() && steps.source.outcome == 'success' && steps.source_controls.outcome == 'success' && steps.toolchain.outcome == 'success' && steps.pq_provider.outcome == 'success' && steps.format.outcome == 'success' && steps.locked_inputs.outcome == 'success' }}
        shell: bash
        run: |
          set -euo pipefail
          rustc +1.95.0 -Vv > "$TRNM_CI_RECEIPT_DIR/rustc.txt"
          cargo +1.95.0 -V > "$TRNM_CI_RECEIPT_DIR/cargo.txt"
          rustup which --toolchain 1.95.0 rustc > "$TRNM_CI_RECEIPT_DIR/rustc-path.txt"
          uname -a > "$TRNM_CI_RECEIPT_DIR/host.txt"
          df -h "$RUNNER_TEMP" > "$TRNM_CI_RECEIPT_DIR/build-space-before.txt"
          set +e
          python3 - > "$TRNM_CI_RECEIPT_DIR/build-input-check.stdout" 2> "$TRNM_CI_RECEIPT_DIR/build-input-check.stderr" <<'PYENV'
          import json, os, tomllib
          from pathlib import Path
          root = Path(os.environ["TRNM_CI_RECEIPT_DIR"])
          workspace = Path(os.environ["GITHUB_WORKSPACE"])
          common_keys = ("CI", "CARGO_HOME", "CARGO_TARGET_DIR", "CARGO_BUILD_JOBS",
                         "CARGO_INCREMENTAL", "RUST_TEST_THREADS")
          overrides = ("RUSTFLAGS", "CARGO_ENCODED_RUSTFLAGS", "RUSTC_WRAPPER",
                       "RUSTC_WORKSPACE_WRAPPER", "RUSTC", "RUSTC_BOOTSTRAP", "RUSTDOC",
                       "RUSTDOCFLAGS", "CARGO_ENCODED_RUSTDOCFLAGS", "CARGO_BUILD_RUSTC",
                       "CARGO_BUILD_RUSTDOC", "CARGO_BUILD_RUSTFLAGS", "CARGO_BUILD_TARGET",
                       "CARGO_BUILD_RUSTC_WRAPPER", "CARGO_BUILD_RUSTC_WORKSPACE_WRAPPER")
          provider_keys = ("OPENSSL_DIR", "OPENSSL_STATIC", "OPENSSL_CONF", "OPENSSL_MODULES",
                           "TRNM_PQ_OPENSSL", "TRNM_PQ_OPENSSL_SHA256", "TRNM_PQ_OPENSSL_VERSION")
          env = {key: os.environ.get(key) for key in common_keys + overrides + provider_keys}
          env.update({key: value for key, value in os.environ.items()
                      if key.startswith("CARGO_PROFILE_") or
                      (key.startswith("CARGO_TARGET_") and
                       key.endswith(("_RUSTFLAGS", "_LINKER", "_RUNNER")))})
          command = ["cargo", "+1.95.0", "test", "--locked", "--manifest-path",
                     "trillionnium/Cargo.toml", "--workspace", "--all-targets", "--all-features",
                     "--no-run", "--message-format=json"]
          manifest = tomllib.loads((workspace / "trillionnium/Cargo.toml").read_text())
          test_packages = manifest["profile"]["test"]["package"]
          (root / "build-command.json").write_text(json.dumps({
              "argv": command, "environment": env,
              "process_measurement_wrapper": ["/usr/bin/time", "-v"],
              "rustc_selected_by_rustup": (root / "rustc-path.txt").read_text().strip(),
              "test_profile_packages": {name: test_packages[name]
                  for name in ("trnm-pon-node", "trnm-mvcc-fee")},
              "scope": "complete workspace test-profile build; only the named selectors run below"
          }, indent=2) + "\n")
          assert not any(env.get(key) for key in overrides), "unexpected compiler override"
          assert not any(key.startswith("CARGO_PROFILE_") for key in env), "unexpected profile override"
          assert not any(value for key, value in env.items() if key.startswith("CARGO_TARGET_")
                         and key.endswith(("_RUSTFLAGS", "_LINKER", "_RUNNER"))), "unexpected target override"
          for name, opt in (("trnm-pon-node", 3), ("trnm-mvcc-fee", 1)):
              profile = test_packages[name]
              assert profile["opt-level"] == opt
              assert profile["debug-assertions"] is True and profile["overflow-checks"] is True
          provider = json.loads((root / "pq-provider/provider.json").read_text())
          assert provider["result"] == "PREPARED_AND_SMOKE_VERIFIED" and provider["exit_code"] == 0
          assert env["OPENSSL_STATIC"] == "1" and env["TRNM_PQ_OPENSSL_VERSION"] == "3.5.9"
          PYENV
          input_reader=$?
          set -e
          printf '%s\n' "$input_reader" > "$TRNM_CI_RECEIPT_DIR/build-input-check.exit"
          if [ "$input_reader" -ne 0 ]; then
            tail -n 200 "$TRNM_CI_RECEIPT_DIR/build-input-check.stderr" || true
            exit "$input_reader"
          fi
          set +e
          /usr/bin/time -v -o "$TRNM_CI_RECEIPT_DIR/build.resources.txt" cargo +1.95.0 test --locked --manifest-path trillionnium/Cargo.toml --workspace --all-targets --all-features --no-run --message-format=json > "$TRNM_CI_RECEIPT_DIR/build.jsonl" 2> "$TRNM_CI_RECEIPT_DIR/build.stderr"
          build_exit=$?
          printf '%s\n' "$build_exit" > "$TRNM_CI_RECEIPT_DIR/build.exit"
          df -h "$RUNNER_TEMP" > "$TRNM_CI_RECEIPT_DIR/build-space-after.txt"
          set -e
          if [ "$build_exit" -ne 0 ]; then
            tail -n 200 "$TRNM_CI_RECEIPT_DIR/build.stderr" || true
            exit "$build_exit"
          fi
          set +e
          python3 - > "$TRNM_CI_RECEIPT_DIR/build-artifact-check.json" 2> "$TRNM_CI_RECEIPT_DIR/build-artifact-check.stderr" <<'PYART'
          import hashlib, json, os
          from pathlib import Path
          root = Path(os.environ["TRNM_CI_RECEIPT_DIR"])
          workspace = Path(os.environ["GITHUB_WORKSPACE"]).resolve()
          rows = [json.loads(line) for line in (root / "build.jsonl").read_text().splitlines() if line.strip()]
          finished = [row for row in rows if row.get("reason") == "build-finished"]
          assert len(finished) == 1 and finished[0]["success"] is True
          expected_features = {
              "trnm-pon-node": ["default", "pq-native-openssl", "pq-root-v3"],
              "trnm-mvcc-fee": ["default", "pq-native-openssl"],
          }
          selected = {}
          for crate, target, opt in (("trnm-pon-node", "trnm_pon_node", "3"),
                                     ("trnm-mvcc-fee", "trnm_mvcc_fee", "1")):
              artifacts = [row for row in rows if row.get("reason") == "compiler-artifact"
                           and row.get("target", {}).get("name") == target
                           and row.get("target", {}).get("kind") == ["lib"]]
              assert artifacts, "missing library artifacts for " + crate
              for artifact in artifacts:
                  assert Path(artifact["target"]["src_path"]).resolve() == workspace / "trillionnium/crates" / crate / "src/lib.rs"
                  profile = artifact["profile"]
                  assert profile["opt_level"] == opt, "wrong original test optimization for " + crate
                  assert profile["debug_assertions"] is True and profile["overflow_checks"] is True, "test checks disabled for " + crate
                  assert artifact["features"] == expected_features[crate], "wrong complete-workspace features for " + crate
              selected[crate] = artifacts
          ancestry = [row for row in rows if row.get("reason") == "compiler-artifact"
                      and row.get("target", {}).get("name") == "ancestry_long_sync"
                      and row.get("target", {}).get("kind") == ["test"]
                      and row.get("profile", {}).get("test") is True and row.get("executable")]
          assert len(ancestry) == 1, "expected one compiled ancestry_long_sync integration executable"
          ancestry_artifact = ancestry[0]
          assert Path(ancestry_artifact["target"]["src_path"]).resolve() == workspace / "trillionnium/crates/trnm-pon-node/tests/ancestry_long_sync.rs"
          assert ancestry_artifact["features"] == expected_features["trnm-pon-node"]
          assert ancestry_artifact["profile"]["opt_level"] == "3"
          assert ancestry_artifact["profile"]["debug_assertions"] is True
          assert ancestry_artifact["profile"]["overflow_checks"] is True
          ancestry_binary = Path(ancestry_artifact["executable"])
          assert ancestry_binary.is_absolute() and ancestry_binary.is_file() and not ancestry_binary.is_symlink()
          assert ancestry_binary.resolve().parent == Path(os.environ["CARGO_TARGET_DIR"]).resolve() / "debug/deps"
          with ancestry_binary.open("rb") as stream:
              assert stream.read(4) == b"\x7fELF"
              stream.seek(0)
              ancestry_digest = hashlib.file_digest(stream, "sha256").hexdigest()
          (root / "ancestry-binary.json").write_text(json.dumps({
              "artifact": ancestry_artifact, "sha256": ancestry_digest,
              "scope": "complete workspace integration-file compilation only; original History execution is a separate release-profile job"
          }, indent=2) + "\n")
          (root / "ancestry-binary.sha256").write_text(ancestry_digest + "  " + str(ancestry_binary) + "\n")
          (root / "ancestry-binary.txt").write_text(str(ancestry_binary) + "\n")
          # Inspect M06's ordinary rlib used as a dependency, not just its separate test executable.
          m06_dependencies = [row for row in selected["trnm-mvcc-fee"]
                              if row["profile"]["test"] is False
                              and any(Path(name).suffix == ".rlib" for name in row["filenames"])]
          assert len(m06_dependencies) == 1, "expected one M06 dependency artifact"
          node_tests = [row for row in selected["trnm-pon-node"]
                        if row["profile"]["test"] is True and row.get("executable")]
          assert len(node_tests) == 1, "expected one native Node library test executable"
          artifact = node_tests[0]
          binary = Path(artifact["executable"])
          target = Path(os.environ["CARGO_TARGET_DIR"]).resolve()
          assert binary.is_absolute() and binary.is_file() and not binary.is_symlink()
          assert binary.resolve().parent == target / "debug/deps", "unexpected executable profile/target directory"
          with binary.open("rb") as stream:
              assert stream.read(4) == b"\x7fELF"
              stream.seek(0)
              digest = hashlib.file_digest(stream, "sha256").hexdigest()
          (root / "binary.json").write_text(json.dumps({
              "artifact": artifact, "sha256": digest,
              "profile_evidence": selected,
              "scope": "full-workspace Node test-profile artifact; only the named Legacy observation and SQL/cancellation controls execute in this job"
          }, indent=2) + "\n")
          (root / "binary.sha256").write_text(digest + "  " + str(binary) + "\n")
          (root / "binary.txt").write_text(str(binary) + "\n")
          m06_tests = [row for row in selected["trnm-mvcc-fee"]
                       if row["profile"]["test"] is True and row.get("executable")]
          assert len(m06_tests) == 1, "expected one M06 library test executable"
          m06_artifact = m06_tests[0]
          m06_binary = Path(m06_artifact["executable"])
          assert m06_binary.is_absolute() and m06_binary.is_file() and not m06_binary.is_symlink()
          assert m06_binary.resolve().parent == target / "debug/deps", "unexpected M06 executable profile/target directory"
          assert m06_binary.resolve() != binary.resolve(), "Node and M06 test executables must be distinct"
          with m06_binary.open("rb") as stream:
              assert stream.read(4) == b"\x7fELF"
              stream.seek(0)
              m06_digest = hashlib.file_digest(stream, "sha256").hexdigest()
          (root / "m06-binary.json").write_text(json.dumps({
              "artifact": m06_artifact, "sha256": m06_digest,
              "dependency_artifact": m06_dependencies[0],
              "package_cwd": str(workspace / "trillionnium/crates/trnm-mvcc-fee"),
              "scope": "M06 test artifact from the required complete workspace compile; no M06 test execution is claimed by this job"
          }, indent=2) + "\n")
          (root / "m06-binary.sha256").write_text(m06_digest + "  " + str(m06_binary) + "\n")
          (root / "m06-binary.txt").write_text(str(m06_binary) + "\n")
          print(json.dumps({"result": "PASS", "scope": "build profiles, feature sets and ELF identity only",
                            "node_opt_level": "3", "m06_opt_level": "1", "debug_assertions": True,
                            "overflow_checks": True, "features_by_crate": expected_features,
                            "binary_sha256": digest, "m06_binary_sha256": m06_digest,
                            "ancestry_integration_binary_sha256": ancestry_digest}, sort_keys=True))
          PYART
          artifact_reader=$?
          set -e
          printf '%s\n' "$artifact_reader" > "$TRNM_CI_RECEIPT_DIR/build-artifact-check.exit"
          if [ "$artifact_reader" -ne 0 ]; then
            tail -n 200 "$TRNM_CI_RECEIPT_DIR/build-artifact-check.stderr" || true
          fi
          exit "$artifact_reader"

      - name: Require all seven compiled exact selectors
        id: registry
        if: ${{ !cancelled() && steps.build.outcome == 'success' }}
        shell: bash
        run: |
          set -euo pipefail
          node_binary="$(cat "$TRNM_CI_RECEIPT_DIR/binary.txt")"
          bash "$TRNM_CI_RECEIPT_DIR/run-command.sh" registry "$node_binary" --list --format terse
          python3 - <<'PY'
          import json, os
          from collections import Counter
          from pathlib import Path
          root = Path(os.environ["TRNM_CI_RECEIPT_DIR"])
          expected = json.loads((root / "selectors.json").read_text())
          assert len(expected) == len(set(expected)) == 7
          lines = (root / "commands/registry.log").read_text().splitlines()
          actual = Counter(line[:-6] for line in lines if line.endswith(": test"))
          assert all(actual[name] == 1 for name in expected), "missing or duplicate compiled exact selector"
          prefix = "store::legacy_reorg_observation_tests::"
          assert sorted(name for name in actual if name.startswith(prefix)) == sorted(expected[:3])
          result = {"schema": "trnm-legacy-reorg-compiled-selector-check-v1", "result": "PASS",
                    "selectors": expected, "executed_tests": 0,
                    "scope": "compiled selector presence only; seven separate original test-profile invocations follow"}
          (root / "compiled-selectors.json").write_text(json.dumps(result, indent=2) + "\n")
          print(json.dumps(result, sort_keys=True))
          PY
      - name: Execute every new behavior comparison and retained SQL cancellation control
        id: native_controls
        if: ${{ !cancelled() && steps.build.outcome == 'success' && steps.registry.outcome == 'success' }}
        shell: bash
        run: |
          set -euo pipefail
          failure=0
          index=0
          : > "$TRNM_CI_RECEIPT_DIR/native-results.tsv"
          while IFS= read -r selector; do
            label="native-$index"
            native_status=0
            checker_status=0
            bash "$TRNM_CI_RECEIPT_DIR/run-command.sh" "$label" cargo +1.95.0 test --locked --manifest-path trillionnium/Cargo.toml -p trnm-pon-node --lib --all-features "$selector" -- --exact --show-output --test-threads=1 || native_status=$?
            python3 scripts/ci/check_required_native_test.py "$TRNM_CI_RECEIPT_DIR/commands/$label.log" --test "$selector" > "$TRNM_CI_RECEIPT_DIR/$label.checker.log" 2>&1 || checker_status=$?
            cat "$TRNM_CI_RECEIPT_DIR/$label.checker.log"
            printf '%s\t%s\t%s\t%s\n' "$label" "$selector" "$native_status" "$checker_status" >> "$TRNM_CI_RECEIPT_DIR/native-results.tsv"
            if [ "$native_status" -ne 0 ] || [ "$checker_status" -ne 0 ]; then
              failure=1
            fi
            index=$((index + 1))
          done < "$TRNM_CI_RECEIPT_DIR/selectors.txt"
          python3 - <<'PY'
          import json, os
          from pathlib import Path
          root = Path(os.environ["TRNM_CI_RECEIPT_DIR"])
          expected = json.loads((root / "selectors.json").read_text())
          rows = []
          for line in (root / "native-results.tsv").read_text().splitlines():
              label, selector, native_status, checker_status = line.split("\t")
              rows.append({"label": label, "selector": selector,
                           "command_exit_code": int(native_status), "named_checker_exit_code": int(checker_status)})
          assert [row["selector"] for row in rows] == expected and len(rows) == 7
          result = {"schema": "trnm-legacy-reorg-named-controls-v1",
                    "source_kind": "head", "candidate": os.environ["GITHUB_SHA"],
                    "planned_controls": 7, "returned_commands": len(rows),
                    "controls": rows,
                    "all_named_controls_passed": all(row["command_exit_code"] == row["named_checker_exit_code"] == 0 for row in rows),
                    "whole_node_regression_executed": False,
                    "public_business_acceptance_granted": False}
          (root / "native-controls.json").write_text(json.dumps(result, indent=2) + "\n")
          print(json.dumps(result, sort_keys=True))
          PY
          test "$index" -eq 7
          exit "$failure"
      - name: Retain the original strict Node Clippy gate
        id: clippy
        if: ${{ !cancelled() && steps.build.outcome == 'success' }}
        shell: bash
        run: |
          set -euo pipefail
          bash "$TRNM_CI_RECEIPT_DIR/run-command.sh" clippy cargo +1.95.0 clippy --locked --manifest-path trillionnium/Cargo.toml -p trnm-pon-node --lib --tests --all-features -- -D warnings
      - name: Reverify controls source and original project boundary
        if: always()
        shell: bash
        env:
          TRNM_CI_RECEIPT_DIR: ${{ runner.temp }}/legacy-reorg-controls
        run: |
          set -euo pipefail
          mkdir -p "$TRNM_CI_RECEIPT_DIR"
          python3 scripts/ci/verify_ci_source.py --kind head --expected-head "$EXPECTED_HEAD" --output "$TRNM_CI_RECEIPT_DIR/source-after.json"
          cmp "$TRNM_CI_RECEIPT_DIR/source.json" "$TRNM_CI_RECEIPT_DIR/source-after.json"
          bash scripts/project-preflight.sh --audit | tee "$TRNM_CI_RECEIPT_DIR/audit-after.json"
      - name: Preserve controls, compiler artifacts, formatter differences and all failures
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: pon-legacy-reorg-controls-arm64-head-${{ github.sha }}-${{ github.run_attempt }}
          path: ${{ runner.temp }}/legacy-reorg-controls/
          if-no-files-found: error
          retention-days: 30
  native-priorities:
    name: native priorities (ubuntu-24.04-arm, head, history diagnostic)
    needs: controls
    if: ${{ needs.controls.result == 'success' }}
    runs-on: ubuntu-24.04-arm
    timeout-minutes: 180
    env:
      SOURCE_KIND: head
      EXPECTED_HEAD: ${{ github.sha }}
      TRNM_EXPECTED_SOURCE_SHA: ${{ github.sha }}
    steps:
      - name: Checkout the exact controlled candidate head
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ github.sha }}
          fetch-depth: 0
          persist-credentials: false
      - name: Verify source and original project boundary
        id: source
        shell: bash
        run: |
          set -euo pipefail
          test "$GITHUB_EVENT_NAME" = push
          test "$GITHUB_REF" = refs/heads/fix/chain-legacy-reorg-cost-20261104
          export TRNM_CI_RECEIPT_DIR="$RUNNER_TEMP/priority-observations"
          mkdir -p "$TRNM_CI_RECEIPT_DIR"
          printf 'TRNM_CI_RECEIPT_DIR=%s\n' "$TRNM_CI_RECEIPT_DIR" >> "$GITHUB_ENV"
          printf 'CARGO_HOME=%s/cargo-priority\n' "$RUNNER_TEMP" >> "$GITHUB_ENV"
          printf 'CARGO_TARGET_DIR=%s/target-priority\n' "$RUNNER_TEMP" >> "$GITHUB_ENV"
          python3 scripts/ci/verify_ci_source.py --kind head --expected-head "$EXPECTED_HEAD" --output "$TRNM_CI_RECEIPT_DIR/source.json"
          bash scripts/project-preflight.sh --audit | tee "$TRNM_CI_RECEIPT_DIR/audit-before.json"
          python3 - <<'PY'
          import json, os
          from pathlib import Path
          scope = {
              "schema": "trnm-legacy-reorg-original-history-diagnostic-v1",
              "source_kind": "head", "candidate": os.environ["GITHUB_SHA"],
              "controls_required": True,
              "runner": "ubuntu-24.04-arm", "original_job_key": "native-priorities",
              "target": "ancestry_long_sync",
              "selector": "actual_v3_long_chain_public_full_sync_reopen_and_corrupt_index_refusal",
              "original_server_lifetime_seconds": 1800,
              "original_import_duration_seconds": 30,
              "original_outer_timeout_minutes": 180,
              "controlled_performance_gain_claimed": False,
              "public_business_acceptance_granted": False,
              "scope": "same original release-profile build, Host ownership and resource setup, selector and arguments; only this exact candidate source provides opt-in diagnostic observations"
          }
          (Path(os.environ["TRNM_CI_RECEIPT_DIR"]) / "diagnostic-scope.json").write_text(json.dumps(scope, indent=2) + "\n")
          print(json.dumps(scope, sort_keys=True))
          PY
      - name: Install the original pinned toolchain
        id: toolchain
        run: rustup toolchain install 1.95.0 --profile minimal --component rustfmt --component clippy
      - name: Build the original long-history test separately from measurement
        id: history_build
        if: ${{ !cancelled() && steps.source.outcome == 'success' && steps.toolchain.outcome == 'success' }}
        run: python3 scripts/ci/run_history_native.py --prepare --out "$TRNM_CI_RECEIPT_DIR/history-native"
      - name: Execute 4105 real work blocks and paid public full sync
        if: ${{ !cancelled() && steps.history_build.outcome == 'success' }}
        run: python3 scripts/ci/run_from_zero_host.py -- python3 scripts/ci/run_history_native.py --out "$TRNM_CI_RECEIPT_DIR/history-native"
      - name: Reverify exact unchanged diagnostic source
        if: always()
        shell: bash
        env:
          TRNM_CI_RECEIPT_DIR: ${{ runner.temp }}/priority-observations
        run: |
          set -euo pipefail
          mkdir -p "$TRNM_CI_RECEIPT_DIR"
          python3 scripts/ci/verify_ci_source.py --kind head --expected-head "$EXPECTED_HEAD" --output "$TRNM_CI_RECEIPT_DIR/source-after.json"
          cmp "$TRNM_CI_RECEIPT_DIR/source.json" "$TRNM_CI_RECEIPT_DIR/source-after.json"
          bash scripts/project-preflight.sh --audit | tee "$TRNM_CI_RECEIPT_DIR/audit-after.json"
      - name: Retain the original diagnostic outcome and complete native failures
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: legacy-reorg-priority-ubuntu-24.04-arm-head-history-${{ github.sha }}-${{ github.run_attempt }}
          path: ${{ runner.temp }}/priority-observations/
          if-no-files-found: error
          retention-days: 30

9305c93f54dfee7d8ad6fd88df6df5e881ca7d0c blob 3948
name: PoN parent-bound model evidence
on:
  pull_request:
    paths:
      - formal/pon-nakamoto-v1/**
      - .github/workflows/pon-model-parent-acceptance.yml
permissions:
  contents: read
jobs:
  parent-evidence:
    name: parent evidence (${{ matrix.runner }}, ${{ matrix.source }})
    runs-on: ${{ matrix.runner }}
    timeout-minutes: 15
    strategy:
      fail-fast: false
      matrix:
        runner: [ubuntu-24.04, ubuntu-24.04-arm]
        source: [head, prospective-merge]
    env:
      EXPECTED_HEAD: ${{ github.event.pull_request.head.sha }}
      EXPECTED_BASE: ${{ github.event.pull_request.base.sha }}
      EXPECTED_MERGE: ${{ github.sha }}
      SOURCE_KIND: ${{ matrix.source }}
      PYTHONDONTWRITEBYTECODE: "1"
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ matrix.source == 'head' && github.event.pull_request.head.sha || github.sha }}
          fetch-depth: 0
          persist-credentials: false
      - name: Bind actual source and retain original preflight
        id: source
        shell: bash
        run: |
          set -euo pipefail
          mkdir -p "$RUNNER_TEMP/parent-evidence"
          args=(--kind "$SOURCE_KIND" --expected-head "$EXPECTED_HEAD")
          if [ "$SOURCE_KIND" = prospective-merge ]; then
            args+=(--expected-base "$EXPECTED_BASE" --expected-merge "$EXPECTED_MERGE")
          fi
          python3 scripts/ci/verify_ci_source.py "${args[@]}" --output "$RUNNER_TEMP/parent-evidence/source.json"
          bash scripts/project-preflight.sh --audit
      - name: Prepare existing model verifier dependencies
        run: |
          python3 -m venv "$RUNNER_TEMP/model-env"
          "$RUNNER_TEMP/model-env/bin/python" -m pip install --disable-pip-version-check --only-binary=:all: -r formal/pon-nakamoto-v1/requirements.txt
      - name: Execute original and strict parent-bound owners
        shell: bash
        run: |
          set -euo pipefail
          status=0
          for spec in model_window_history model_consumer_context model_generation_sequence model_generation_sequence_context model_generation_sequence_parent; do
            if ! "$RUNNER_TEMP/model-env/bin/python" "formal/pon-nakamoto-v1/test_${spec}.py" -v 2>&1 | tee "$RUNNER_TEMP/parent-evidence/${spec}.log"; then
              status=1
            fi
          done
          grep -E '^Ran 7 tests in ' "$RUNNER_TEMP/parent-evidence/model_generation_sequence.log" || status=1
          grep -E '^Ran 8 tests in ' "$RUNNER_TEMP/parent-evidence/model_generation_sequence_context.log" || status=1
          grep -E '^Ran 10 tests in ' "$RUNNER_TEMP/parent-evidence/model_generation_sequence_parent.log" || status=1
          exit "$status"
      - name: Recheck source and retain replayable exact reference sources
        if: ${{ always() && steps.source.outcome == 'success' }}
        shell: bash
        run: |
          set -euo pipefail
          args=(--kind "$SOURCE_KIND" --expected-head "$EXPECTED_HEAD")
          if [ "$SOURCE_KIND" = prospective-merge ]; then
            args+=(--expected-base "$EXPECTED_BASE" --expected-merge "$EXPECTED_MERGE")
          fi
          python3 scripts/ci/verify_ci_source.py "${args[@]}" --output "$RUNNER_TEMP/parent-evidence/source-after.json"
          cmp "$RUNNER_TEMP/parent-evidence/source.json" "$RUNNER_TEMP/parent-evidence/source-after.json"
          git archive HEAD formal/pon-nakamoto-v1 config > "$RUNNER_TEMP/parent-evidence/reference-source.tar"
          (cd "$RUNNER_TEMP/parent-evidence" && sha256sum *.log *.json reference-source.tar > sha256sums.txt)
      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        if: always()
        with:
          name: parent-evidence-${{ matrix.runner }}-${{ matrix.source }}-${{ github.event.pull_request.head.sha }}
          path: ${{ runner.temp }}/parent-evidence
          if-no-files-found: error

a11dbcd8476d149fa89aeac7979c5ddefad9108c blob 22404
name: PoN original native campaign
on:
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: pon-native-campaign-${{ github.event.pull_request.number || github.ref }}
  # Keep a running failed/partial observation when a newer candidate arrives.
  cancel-in-progress: false
jobs:
  original-campaign:
    name: original native campaign (x64, head, release)
    runs-on: ubuntu-24.04
    timeout-minutes: 80
    env:
      CI: "true"
      CARGO_INCREMENTAL: "0"
      CARGO_BUILD_JOBS: "2"
      RUST_TEST_THREADS: "1"
      PYTHONDONTWRITEBYTECODE: "1"
      EXPECTED_HEAD: ${{ github.event.pull_request.head.sha || github.sha }}
    steps:
      - name: Reserve new output and isolated Cargo directories
        shell: bash
        run: |
          set -euo pipefail
          out="$RUNNER_TEMP/pon-native-campaign-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          mkdir "$out"
          printf 'OUT=%s\n' "$out" >> "$GITHUB_ENV"
          printf 'CARGO_HOME=%s/cargo-native-campaign\n' "$RUNNER_TEMP" >> "$GITHUB_ENV"
          printf 'CARGO_TARGET_DIR=%s/target-native-campaign\n' "$RUNNER_TEMP" >> "$GITHUB_ENV"
          printf 'Head lane only. Three predeclared complete runs of the original release-profile test. This does not qualify ARM64, a prospective merge, independent operators, WAN service, work hardness, model efficacy or production activation. Resource limits are ceilings, not reserved physical RAM or CPU throughput.\n' > "$out/SCOPE.txt"
      - name: Checkout the immutable candidate head
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ env.EXPECTED_HEAD }}
          fetch-depth: 0
          persist-credentials: false
      - name: Verify actual tracked bytes and original source boundary
        id: source
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/ci/verify_ci_source.py --kind head --expected-head "$EXPECTED_HEAD" --output "$OUT/source-before.json"
          expected_tree="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["tested_tree"])' "$OUT/source-before.json")"
          printf 'EXPECTED_TREE=%s\n' "$expected_tree" >> "$GITHUB_ENV"
          bash scripts/project-preflight.sh --audit 2>&1 | tee "$OUT/preflight.log"
          python3 - <<'PY'
          import os, sys
          sys.path.insert(0, 'scripts')
          from run_pon_w1_native_campaign import validate_build_environment
          validate_build_environment(os.environ)
          PY
          python3 -m unittest discover -s scripts/ci -p 'test_pon_public_v3*.py' -v 2>&1 | tee "$OUT/policy-reader-controls.log"
          python3 -m unittest discover -s scripts/ci -p 'test_inspect_native_campaign_failure.py' -v 2>&1 | tee "$OUT/native-failure-diagnostic-controls.log"
      - name: Install the source-pinned compiler and fetch locked dependencies
        id: toolchain
        shell: bash
        run: |
          set -euo pipefail
          rustup toolchain install 1.95.0 --profile minimal 2>&1 | tee "$OUT/toolchain-install.log"
          rustc +1.95.0 -Vv > "$OUT/rustc-version.txt"
          cargo +1.95.0 -Vv > "$OUT/cargo-version.txt"
          cargo +1.95.0 fetch --locked --manifest-path trillionnium/Cargo.toml --target x86_64-unknown-linux-gnu 2>&1 | tee "$OUT/dependency-fetch.log"
      - name: Prepare the exact original test runner without changing source
        shell: bash
        run: |
          set -euo pipefail
          cat > "$OUT/run-native-campaign.py" <<'PY'
          """Execute the existing multiprocess test; this is not the W1 grid."""
          from datetime import datetime, timezone
          import json
          import os
          from pathlib import Path
          import platform
          import re
          import shutil
          import subprocess
          import sys

          root, out, target = (Path(value).resolve() for value in sys.argv[1:4])
          cargo, expected_head, expected_tree = sys.argv[4:7]
          sys.dont_write_bytecode = True
          sys.path[:0] = [str(root / 'scripts'), str(root / 'scripts/ci')]
          import run_pon_w1_native_campaign as bounds
          import pon_public_v3_phase_read as phase_reader
          from pon_public_v3_policy_read import load_profiles, policy_id
          from verify_ci_source import verify

          selector = 'separate_process_work_and_signed_confirmation_campaign'
          policy_vectors = load_profiles()
          expected_public_policy = policy_id(policy_vectors, policy_vectors['current_revision'], 8, 2000)
          result = {
              'schema': 'pon-original-native-campaign-ci-v1',
              'source_kind': 'head', 'expected_head': expected_head,
              'expected_tree': expected_tree, 'profile': 'release',
              'toolchain': '1.95.0', 'state_backend': 'authenticated-v1',
              'planned_complete_runs': 3, 'attempts': [],
              'expected_public_policy_id': expected_public_policy,
              'started_utc': datetime.now(timezone.utc).isoformat(),
              'build_timeout_seconds': 1800,
              'original_campaign_outer_timeout_seconds': 600,
              'original_inputs': {'seed_transfers': 1024, 'seed_blocks': 4,
                                  'business_blocks': 21, 'phase_seconds': 30,
                                  'modes': ['baseline', 'from-zero', 'late-product'],
                                  'attacker_processes': [0, 24, 24]},
              'expected_resources': {'cpu_max': '400000 100000',
                                     'memory_max': '17179869184', 'nice': 10},
              'public_phase_placement': {
                  'profile': 'fixed-public-phase-external-actors-v1',
                  'receiver_and_verifier_cpu_max': '25000 100000',
                  'receiver_and_verifier_memory_max': '2147483648',
                  'fixed_parent': '/sys/fs/cgroup/trnmponpublic.slice',
                  'attacker_processes_remain_in_original_controller_domain': True,
                  'original_3x3_workload_and_depletion_predicates_changed': False,
              },
              'binary': None, 'source_after': None, 'complete_success': False,
              'failure': None, 'finalization_failures': [],
              'runner_sha256': bounds.sha(__file__),
              'scope': 'same-host controlled loopback; no independent-operator, WAN, hardness, model-efficacy or activation qualification',
          }
          binary = None

          def source_observation(name):
              value = verify('head', expected_head, root=root)
              bounds.require(value['tested_tree'] == expected_tree,
                             'EXPECTED_TREE_CHANGED')
              bounds.write_new(out / name, value)
              return value

          def resources(name):
              value = bounds.resource_observation()
              bounds.write_new(out / name, value)
              bounds.validate_resources(value, 10)
              return value

          try:
              bounds.require(platform.machine() == 'x86_64', 'NATIVE_X64_REQUIRED')
              bounds.require(not out.is_relative_to(root)
                             and not target.is_relative_to(root)
                             and not out.is_relative_to(target)
                             and not target.is_relative_to(out), 'ISOLATED_OUTPUT_REQUIRED')
              bounds.validate_build_environment(os.environ)
              source_observation('source-before-build.json')
              resources('resource-before-build.json')
              bounds.write_new(out / 'hardware.json', {
                  'machine': platform.machine(), 'kernel': platform.release(),
                  'logical_cpu_count': os.cpu_count(),
                  'cpu_models': sorted({
                      line.split(':', 1)[1].strip()
                      for line in Path('/proc/cpuinfo').read_text().splitlines()
                      if line.startswith('model name')}),
                  'meminfo': Path('/proc/meminfo').read_text(),
                  'physical_resources_are_observations_not_reservations': True,
              })
              env = {key: value for key, value in os.environ.items()
                     if not key.startswith('TRNM_')}
              env.update(CARGO_TARGET_DIR=str(target), CARGO_BUILD_JOBS='2',
                         CARGO_NET_OFFLINE='true', CARGO_INCREMENTAL='0',
                         RUSTUP_TOOLCHAIN='1.95.0', RUST_TEST_THREADS='1',
                         PYTHONDONTWRITEBYTECODE='1')
              command = [cargo, '+1.95.0', 'test', '--locked', '--offline',
                         '--release', '--manifest-path', 'trillionnium/Cargo.toml',
                         '-p', 'trnm-pon-node', '--test', 'public_v3_multiprocess']
              build = bounds.run_step(
                  out, 'build', [*command, '--no-run', '--message-format=json'],
                  env, timeout=1800)
              result['build'] = build
              bounds.require(build['complete_success'], 'RELEASE_TEST_BUILD_FAILED')
              artifacts = []
              for line in (out / build['stdout']).read_bytes().splitlines():
                  row = json.loads(line)
                  if (row.get('reason') == 'compiler-artifact'
                          and row.get('target', {}).get('name') == 'public_v3_multiprocess'
                          and row.get('profile', {}).get('test') is True
                          and row.get('executable')):
                      artifacts.append(row)
              bounds.require(len(artifacts) == 1, 'ONE_EXACT_TEST_BINARY_REQUIRED')
              artifact = artifacts[0]
              bounds.require(artifact['profile']['opt_level'] == '3'
                             and artifact['profile']['debug_assertions'] is False,
                             'ACTUAL_OPTIMIZED_RELEASE_TEST_PROFILE_REQUIRED')
              binary = Path(artifact['executable']).resolve(strict=True)
              bounds.require(binary.is_relative_to(target) and binary.is_file(),
                             'EXPECTED_TARGET_BINARY_REQUIRED')
              retained = out / 'public_v3_multiprocess.bin'
              digest = bounds.sha(binary)
              with binary.open('rb') as source, retained.open('xb') as destination:
                  shutil.copyfileobj(source, destination)
              retained.chmod(0o700)
              bounds.require(bounds.sha(retained) == digest, 'BINARY_CAPTURE_CHANGED')
              result['binary'] = {
                  'build_artifact': str(binary), 'retained': retained.name,
                  'sha256_before': digest, 'sha256_after': None,
                  'bytes': retained.stat().st_size,
                  'actual_compiler_artifact_profile': artifact['profile'],
                  'build_separate_from_measured_campaign': True,
                  'execution': 'original cargo test command using the checked build artifact',
              }
              bounds.write_new(out / 'binary-before.json', result['binary'])
              source_observation('source-before-campaigns.json')
              for number in range(1, 4):
                  name = f'run-{number}'
                  report_dir = out / f'{name}-raw'
                  # The original Rust test itself must create this directory.
                  bounds.require(not os.path.lexists(report_dir), 'NEW_REPORT_DIR_REQUIRED')
                  resources(f'{name}-resource-before.json')
                  bounds.require(bounds.sha(binary) == digest, 'TEST_BINARY_CHANGED')
                  run_env = dict(env, TRNM_MULTIPROCESS_STATE_BACKEND='authenticated-v1',
                                 TRNM_MULTIPROCESS_REPORT_DIR=str(report_dir),
                                 TRNM_MULTIPROCESS_PHASE_HOST='fixed-public-phase-external-actors-v1')
                  step = bounds.run_step(
                      out, name,
                      [*command, selector, '--', '--exact', '--ignored',
                       '--nocapture', '--test-threads=1'],
                      run_env, timeout=600)
                  attempt = {'number': number, 'step': step,
                             'report_directory': report_dir.name,
                             'report_validation_failure': None,
                             'original_criteria_met': False, 'complete_success': False}
                  result['attempts'].append(attempt)
                  try:
                      raw_path = report_dir / 'report.json'
                      report_hash = bounds.sha(raw_path)
                      derived = phase_reader.read_report(raw_path, report_hash, expected_public_policy)
                      bounds.write_new(out / f'{name}-phase-readback.json', derived)
                      raw = json.loads(raw_path.read_bytes())
                      preparation = raw['preparation']
                      phases = raw['phases']
                      attempt['phase_startup_errors'] = [
                          {'mode': phase.get('mode'), 'error': phase['startup_or_campaign_error']}
                          for phase in phases if phase.get('startup_or_campaign_error') is not None]
                      bounds.require(not attempt['phase_startup_errors'],
                                     'ORIGINAL_NATIVE_PHASE_STARTUP_FAILED')
                      bounds.require(
                          raw['state_backend'] == 'authenticated-v1'
                          and preparation['actual_signed_seed_transfers'] == 1024
                          and preparation['seed_blocks'] == 4
                          and preparation['business_blocks'] == 21
                          and [phase['mode'] for phase in phases]
                              == ['baseline', 'from-zero', 'late-product']
                          and [phase['duration_seconds'] for phase in phases] == [30, 30, 30]
                          and [phase['attacker_processes_requested'] for phase in phases]
                              == [0, 24, 24], 'ORIGINAL_CAMPAIGN_INPUTS_REQUIRED')
                      attempt['report_sha256'] = report_hash
                      attempt['original_criteria_met'] = (
                          raw['finite_experiment_criteria_met'] is True
                          and raw['economics_complete'] is True
                          and all(phase['finite_phase_criteria_met'] is True
                                  for phase in phases))
                      stdout = (out / step['stdout']).read_text(errors='replace')
                      one_test_passed = re.search(
                          r'^test result: ok\. 1 passed; 0 failed; 0 ignored;',
                          stdout, re.MULTILINE) is not None
                      attempt['complete_success'] = (
                          step['complete_success'] and one_test_passed
                          and attempt['original_criteria_met'])
                  except (OSError, ValueError, KeyError, TypeError) as error:
                      attempt['report_validation_failure'] = str(error)
                  bounds.write_new(out / f'{name}-result.json', attempt)
                  resources(f'{name}-resource-after.json')
                  source_observation(f'{name}-source-after.json')
                  bounds.require(bounds.sha(binary) == digest, 'TEST_BINARY_CHANGED')
                  # A failed native run stays failed; the next predeclared run is
                  # a distinct complete observation, never a replacement retry.
              result['complete_success'] = (
                  len(result['attempts']) == 3
                  and all(row['complete_success'] for row in result['attempts']))
              if not result['complete_success']:
                  result['failure'] = 'ORIGINAL_THREE_RUN_CAMPAIGN_FAILED'
          except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError) as error:
              result['failure'] = str(error)
              result['complete_success'] = False
          finally:
              for name, observation in (
                      ('source', lambda: source_observation('source-after-native.json')),
                      ('resources', lambda: resources('resource-after-native.json'))):
                  try:
                      value = observation()
                      if name == 'source':
                          result['source_after'] = value
                  except (OSError, ValueError, subprocess.SubprocessError) as error:
                      result['finalization_failures'].append(f'{name}: {error}')
              if binary is not None and result['binary'] is not None:
                  try:
                      result['binary']['sha256_after'] = bounds.sha(binary)
                      bounds.require(result['binary']['sha256_after']
                                     == result['binary']['sha256_before'],
                                     'TEST_BINARY_CHANGED')
                  except (OSError, ValueError) as error:
                      result['finalization_failures'].append(f'binary: {error}')
              result['complete_success'] = (
                  result['complete_success'] and not result['finalization_failures'])
              result['completed_utc'] = datetime.now(timezone.utc).isoformat()
              bounds.write_new(out / 'results.json', result)
          print(json.dumps(result, sort_keys=True))
          raise SystemExit(0 if result['complete_success'] else 1)
          PY
      - name: Run three original campaigns under verified actual limits
        id: campaign
        shell: bash
        run: |
          set -euo pipefail
          test "$(uname -m)" = x86_64
          test -d /run/systemd/system
          test -f /sys/fs/cgroup/cgroup.controllers
          systemd-run --version > "$OUT/systemd-version.txt"
          cargo_path="$(command -v cargo)"
          rustup_home="$(rustup show home)"
          unit="trnm-native-campaign-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT.service"
          cleanup() {
            original_status=$?
            trap - EXIT INT TERM
            # Creation may have failed or collided; this trap has no stop authority.
            set +e
            /usr/bin/python3 -B "$GITHUB_WORKSPACE/scripts/ci/check_collected_unit_empty_v1.py" \
              --unit "$unit" > "$OUT/unit-cleanup.json" 2>> "$OUT/unit-cleanup.log"
            cleanup_status=$?
            printf 'original_exit=%s\ncleanup_exit=%s\n' "$original_status" "$cleanup_status" >> "$OUT/unit-cleanup.log"
            if test "$original_status" -eq 0 && test "$cleanup_status" -ne 0; then
              exit "$cleanup_status"
            fi
            exit "$original_status"
          }
          trap cleanup EXIT
          trap 'exit 130' INT
          trap 'exit 143' TERM
          # No scope/fallback path: a service establishes its own actual cgroup,
          # carries all native children, and must pass the inherited-limit reader.
          sudo -n systemd-run --unit="$unit" --wait --pipe --collect \
            --service-type=exec --expand-environment=no \
            --uid="$(id -u)" --gid="$(id -g)" \
            --working-directory="$GITHUB_WORKSPACE" \
            --property=CPUAccounting=yes --property=MemoryAccounting=yes \
            --property=CPUQuota=400% --property=CPUQuotaPeriodSec=100ms \
            --property=MemoryMax=17179869184 --property=Nice=10 \
            --property=KillMode=control-group --property=TimeoutStopSec=20s \
            --property=RuntimeMaxSec=4200s \
            --setenv="PATH=$PATH" --setenv="CARGO_HOME=$CARGO_HOME" \
            --setenv="RUSTUP_HOME=$rustup_home" --setenv=PYTHONDONTWRITEBYTECODE=1 \
            --setenv=CI=true --setenv=GITHUB_ACTIONS=true \
            --setenv="GITHUB_WORKSPACE=$GITHUB_WORKSPACE" \
            --setenv="GITHUB_RUN_ID=$GITHUB_RUN_ID" --setenv="GITHUB_RUN_ATTEMPT=$GITHUB_RUN_ATTEMPT" \
            --setenv="GITHUB_JOB=$GITHUB_JOB" \
            /usr/bin/python3 "$OUT/run-native-campaign.py" \
            "$GITHUB_WORKSPACE" "$OUT" "$CARGO_TARGET_DIR" "$cargo_path" \
            "$EXPECTED_HEAD" "$EXPECTED_TREE" 2>&1 | tee "$OUT/systemd-run.log"
      - name: Diagnose original partial and failed campaigns without changing the verdict
        if: always() && steps.source.outcome == 'success'
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/ci/inspect_native_campaign_failure.py --root "$OUT" --output "$OUT/native-failure-diagnostics.json"
      - name: Preserve final source verification and all partial artifact hashes
        if: always()
        shell: bash
        run: |
          set -uo pipefail
          python3 scripts/ci/verify_ci_source.py --kind head --expected-head "$EXPECTED_HEAD" --output "$OUT/source-after.json" > "$OUT/source-after.log" 2>&1
          source_status=$?
          python3 - <<'PY'
          import hashlib, json, os
          from pathlib import Path
          out = Path(os.environ['OUT'])
          rows = []
          for path in sorted(out.rglob('*')):
              if path.is_symlink():
                  raise ValueError('artifact symlink is not a retained regular file')
              if not path.is_file():
                  continue
              digest = hashlib.sha256()
              with path.open('rb') as stream:
                  for chunk in iter(lambda: stream.read(1024 * 1024), b''):
                      digest.update(chunk)
              rows.append({'path': str(path.relative_to(out)),
                           'bytes': path.stat().st_size, 'sha256': digest.hexdigest()})
          with (out / 'artifact-files.json').open('x') as stream:
              json.dump({'scope': 'retained files including failed or partial runs; not a PASS verdict',
                         'files': rows}, stream, indent=2, sort_keys=True)
              stream.write('\n')
          PY
          files_status=$?
          test "$source_status" -eq 0 && test "$files_status" -eq 0
      - name: Upload successful, failed and partial observations
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: pon-native-campaign-x64-head-release-${{ env.EXPECTED_HEAD }}-${{ github.run_attempt }}
          path: ${{ runner.temp }}/pon-native-campaign-${{ github.run_id }}-${{ github.run_attempt }}
          if-no-files-found: error
          retention-days: 30

f6791e25103f95067d9fe3de46018c41460dd668 blob 5677
name: PoN native full relation and path controls
on:
  pull_request:
    paths:
      - .github/workflows/pon-native-fullpath.yml
      - formal/pon-native-fullpath-v1/**
      - trillionnium/**
      - config/**
      - rust-toolchain.toml
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: native-fullpath-${{ github.ref }}
  cancel-in-progress: false
env:
  CARGO_BUILD_JOBS: "2"
  CARGO_INCREMENTAL: "0"
  RUST_TEST_THREADS: "1"
  PYTHONDONTWRITEBYTECODE: "1"
  TRNM_EXPECTED_SOURCE_SHA: ${{ github.event_name == 'pull_request' && github.event.pull_request.head.sha || github.sha }}
jobs:
  native-fullpath-controls:
    runs-on: ubuntu-24.04
    timeout-minutes: 45
    steps:
      - name: Checkout exact candidate
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ env.TRNM_EXPECTED_SOURCE_SHA }}
          fetch-depth: 0
          persist-credentials: false
      - name: Check source and project boundary
        run: |
          set -euo pipefail
          bash scripts/project-preflight.sh --audit
          python3 scripts/ci/verify_ci_source.py --kind head --expected-head "$TRNM_EXPECTED_SOURCE_SHA" --output "$RUNNER_TEMP/native-fullpath/source-before.json"
      - name: Install pinned Rust toolchain
        run: rustup toolchain install 1.95.0 --profile minimal --component rustfmt --component clippy
      - name: Bind isolated target path
        run: printf 'CARGO_TARGET_DIR=%s/native-fullpath-target\n' "$RUNNER_TEMP" >> "$GITHUB_ENV"
      - name: Reject incomplete and spliced observation evidence
        run: python3 -m unittest discover -s formal/pon-native-fullpath-v1 -p 'test_*.py' -v
      - name: Check formatting and focused strict Clippy
        run: |
          set -euo pipefail
          cargo fmt --manifest-path trillionnium/Cargo.toml --all --check
          cargo clippy --locked --manifest-path trillionnium/Cargo.toml -p trnm-pon-node --test native_full_relation_context --example native_fullpath_v1 -- -D warnings
      - name: Execute freshly sealed wrong-context native regressions
        run: |
          set -euo pipefail
          cargo test --locked --manifest-path trillionnium/Cargo.toml -p trnm-pon-node --test native_full_relation_context --test work_header_binding --test growth_persistence_cancellation -- --test-threads=1
          cargo build --locked --manifest-path trillionnium/Cargo.toml -p trnm-pon-node --example native_fullpath_v1
      - name: Collect real native component processes
        run: |
          set -euo pipefail
          python3 formal/pon-native-fullpath-v1/collect_native.py --repo "$GITHUB_WORKSPACE" --expected-source "$TRNM_EXPECTED_SOURCE_SHA" --binary "$CARGO_TARGET_DIR/debug/examples/native_fullpath_v1" --output "$RUNNER_TEMP/native-fullpath/processes" > "$RUNNER_TEMP/native-fullpath/collector-output.json"
          cat "$RUNNER_TEMP/native-fullpath/collector-output.json"
      - name: Read retained evidence and require explicit component HOLD
        if: always()
        run: |
          python3 - <<'PY'
          import json
          import os
          from pathlib import Path
          import subprocess
          import sys
          root = Path(os.environ["RUNNER_TEMP"]) / "native-fullpath"
          capture = json.loads((root / "collector-output.json").read_text())
          result = subprocess.run([
              sys.executable, "formal/pon-native-fullpath-v1/adapt_native.py",
              str(root / "processes"), "--preregistration-sha256", capture["manifest_sha256"],
          ], capture_output=True, text=True, check=False)
          (root / "reader-stdout.json").write_text(result.stdout)
          (root / "reader-stderr.txt").write_text(result.stderr)
          print(result.stdout, end="")
          if result.returncode != 1:
              raise SystemExit("reader did not return the explicit valid-component HOLD code")
          report = json.loads(result.stdout)
          assert report["overall_gate"] == report["security_gate"] == "HOLD"
          assert report["performance_gate"] == "COMPONENT_OBSERVATION_ONLY"
          assert report["scheduled"] == report["recorded"] == 4 and not report["missing"]
          assert report["recorded_unique_new_native_blocks"] == 1
          attempts = {row["id"]: row for row in report["attempts"]}
          assert {key: row["status"] for key, row in attempts.items()} == {
              "valid": "accepted", "duplicate": "duplicate",
              "late_product": "rejected", "cancelled": "cancelled",
          }
          assert attempts["valid"]["full_native_replay_observed"] is True
          assert attempts["duplicate"]["full_native_replay_observed"] is False
          assert attempts["late_product"]["late_product_rejection_observed"] is True
          assert attempts["cancelled"]["full_native_replay_observed"] is False
          assert attempts["valid"]["last_canonical_depth"] == 0
          assert report["timely_accepted_progress"] == 0
          assert report["production_activation"] is False
          PY
      - name: Verify source remained unchanged
        if: always()
        run: python3 scripts/ci/verify_ci_source.py --kind head --expected-head "$TRNM_EXPECTED_SOURCE_SHA" --output "$RUNNER_TEMP/native-fullpath/source-after.json"
      - name: Retain raw component observations
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: native-fullpath-${{ env.TRNM_EXPECTED_SOURCE_SHA }}-${{ github.run_attempt }}
          path: ${{ runner.temp }}/native-fullpath/
          if-no-files-found: error
          retention-days: 30

a2c1d0fc734b10b50fd3a71b0644e24898f35c06 blob 30885
name: PoN next architecture exact-source observations

on:
  pull_request:
    paths:
      - formal/next-architecture-security/**
      - config/**
      - docs/development/TRNM_AI_NATIVE_BLOCKCHAIN_DEVELOPMENT_PLAN.md
      - docs/development/specs/pon/NEXT_ARCHITECTURE_SECURITY_QUALIFICATION_V1.md
      - docs/development/specs/pon/NEXT_CONSENSUS_PQ_RESEARCH_V1.md
      - docs/development/specs/pon/NEXT_HEPTA_OWNER_BINDINGS_V1.md
      - docs/development/specs/pon/NATIVE_PACKET_STATUS_OBSERVATION_V1.md
      - docs/development/specs/pon/CELL_BEP52_BINDING_V1.md
      - docs/development/specs/pon/CELL_RS46_CHUNK_V1.md
      - docs/development/specs/pon/CELL_COMPLETE_VERSION_V1.md
      - docs/development/specs/pon/CELL_CUSTODY_CONTINUATION_V1.md
      - docs/development/specs/pon/CELL_PROVIDER_DISCOVERY_DEV_V1.md
      - docs/development/specs/pon/CELL_PROVIDER_DISCOVERY_AUTH_PQ_V3.md
      - docs/development/specs/pon/CELL_STORAGE_NETWORK_ACCEPTANCE_V1.md
      - scripts/cell_complete_version_vector.py
      - scripts/cell_discovery_epoch_v3_vector.py
      - formal/pon-nakamoto-v1/vectors/cell-complete-version-v1.json
      - formal/pon-nakamoto-v1/vectors/cell-discovery-epoch-v3.json
      - scripts/cell_version_content_vector.py
      - docs/development/specs/pon/CELL_STORAGE_CONVERGENCE_DEV_V1.md
      - scripts/cell_version_retention_v3_vector.py
      - scripts/cell_storage_descriptor_reference.py
      - scripts/ci/test_cell_storage_convergence_ci.py
      - scripts/cell_sealed_bootstrap_v1.py
      - scripts/llm_cell_sealed_worker_v1.py
      - scripts/prepare_cell_sealed_research_v1.py
      - scripts/test_llm_cell_sealed_worker_v1.py
      - tests/fixtures/llm_material_runtime_bridge_v1/**
      - formal/pon-nakamoto-v1/vectors/cell-version-retention-v3.json
      - formal/pon-nakamoto-v1/vectors/cell-storage-owner-vectors-v1.json
      - docs/development/specs/pon/CELL_FULL_CONTENT_V2.md
      - docs/development/specs/pon/CELL_SEALED_LOADER_V1.md
      - docs/development/specs/pon/CELL_RS46_CUSTODY_V1.md
      - docs/development/specs/pon/CELL_BEP52_PEER_V1.md
      - formal/pon-nakamoto-v1/vectors/cell-version-content-v2.json
      - trillionnium/crates/trnm-data-availability/**
      - trillionnium/crates/trnm-pon-node/**
      - trillionnium/crates/trnm-crypto-primitives/**
      - trillionnium/crates/trnm-protocol/**
      - trillionnium/crates/trnm-research-protocol/**
      - trillionnium/Cargo.toml
      - trillionnium/Cargo.lock
      - .cargo/**
      - rust-toolchain.toml
      - scripts/project-preflight.sh
      - scripts/ci/**
      - .github/workflows/pon-next-architecture-security.yml

permissions:
  contents: read

concurrency:
  group: pon-next-architecture-${{ github.event.pull_request.number }}
  # Preserve earlier failed and partial source observations when a successor arrives.
  cancel-in-progress: false

env:
  CI: "true"
  CARGO_INCREMENTAL: "0"
  CARGO_BUILD_JOBS: "2"
  RUST_TEST_THREADS: "1"
  CARGO_TERM_COLOR: never
  PYTHONDONTWRITEBYTECODE: "1"

jobs:
  next-architecture:
    name: next architecture (${{ matrix.runner }}, ${{ matrix.source }})
    runs-on: ${{ matrix.runner }}
    timeout-minutes: 90
    strategy:
      fail-fast: false
      matrix:
        runner: [ubuntu-24.04, ubuntu-24.04-arm]
        source: [head, prospective-merge]
    env:
      EXPECTED_HEAD: ${{ github.event.pull_request.head.sha }}
      EXPECTED_BASE: ${{ github.event.pull_request.base.sha }}
      EXPECTED_MERGE: ${{ github.sha }}
      EXPECTED_SOURCE: ${{ matrix.source == 'head' && github.event.pull_request.head.sha || github.sha }}
      TRNM_EXPECTED_SOURCE_SHA: ${{ matrix.source == 'head' && github.event.pull_request.head.sha || github.sha }}
      TRNM_COST_RUNNER_LABEL: ${{ matrix.runner }}
      SOURCE_KIND: ${{ matrix.source }}
    steps:
      - name: Reserve isolated logs without changing source
        id: reserve
        shell: bash
        run: |
          set -euo pipefail
          out="$RUNNER_TEMP/next-architecture-$SOURCE_KIND-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          mkdir "$out"
          printf 'OUT=%s\n' "$out" >> "$GITHUB_ENV"
          printf 'TRNM_CI_RECEIPT_DIR=%s\n' "$out" >> "$GITHUB_ENV"
          printf 'CARGO_HOME=%s/cargo-next-architecture\n' "$RUNNER_TEMP" >> "$GITHUB_ENV"
          printf 'CARGO_TARGET_DIR=%s/target-next-architecture\n' "$RUNNER_TEMP" >> "$GITHUB_ENV"
          cat > "$out/SCOPE.txt" <<'SCOPE'
          Exact-source component observations under the default Cargo features.
          Head and prospective merge, x86_64 and ARM64, remain separate records.
          Synthetic Cell bytes are not models. Local recovery and packet reads
          do not qualify WAN throughput, DHT, independent custody, Hepta FinalUse,
          useful-work hardness, QROM/PQ128, sustainable rewards or production.
          Original required gates remain unchanged. Qualification: HOLD_NO_GO.
          SCOPE
          cat > "$out/run-command.sh" <<'SH'
          #!/usr/bin/env bash
          set -euo pipefail
          label="$1"
          shift
          status=0
          "$@" 2>&1 | tee "$OUT/$label.log" || status=$?
          printf '%s\n' "$status" > "$OUT/$label.exit"
          exit "$status"
          SH
          cat > "$out/native-selector-label.py" <<'PY'
          from pathlib import Path
          import json, re, sys
          prefix, selector, output = sys.argv[1:]
          if prefix not in ("native-storage", "native-storage-component"):
              raise SystemExit("invalid native artifact prefix")
          if re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)*", selector) is None:
              raise SystemExit("invalid ASCII Rust selector")
          # Identifiers contain no hyphen; '-' reverses to '::'. The '--'
          # prefix boundary cannot occur in a nonempty encoded Rust path.
          label = prefix + "--" + selector.replace("::", "-")
          record = {"schema": "trnm-native-selector-artifact-v1",
                    "prefix": prefix, "selector": selector, "label": label}
          with (Path(output) / (label + ".selector.json")).open("x", encoding="utf-8") as stream:
              json.dump(record, stream, sort_keys=True)
              stream.write("\n")
          print(label)
          PY
      - name: Checkout the immutable event source
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ env.EXPECTED_SOURCE }}
          fetch-depth: 0
          persist-credentials: false
      - name: Verify exact source and ordered prospective merge
        id: source
        shell: bash
        run: |
          set -euo pipefail
          args=(--kind "$SOURCE_KIND" --expected-head "$EXPECTED_HEAD")
          if test "$SOURCE_KIND" = prospective-merge; then
            args+=(--expected-base "$EXPECTED_BASE" --expected-merge "$EXPECTED_MERGE")
          fi
          bash "$OUT/run-command.sh" source-before python3 -B scripts/ci/verify_ci_source.py "${args[@]}" --output "$OUT/source-before.json"
          # Preserve the exact receipt path consumed by the original Host launcher.
          test ! -e "$OUT/source.json"
          cp "$OUT/source-before.json" "$OUT/source.json"
          cmp "$OUT/source-before.json" "$OUT/source.json"
      - name: Retain original project preflight
        id: preflight
        shell: bash
        run: bash "$OUT/run-command.sh" preflight bash scripts/project-preflight.sh --audit
      - name: Install pinned compiler and lint tools
        id: toolchain
        if: ${{ always() && steps.source.outcome == 'success' && steps.preflight.outcome == 'success' }}
        shell: bash
        run: |
          set -euo pipefail
          bash "$OUT/run-command.sh" toolchain rustup toolchain install 1.95.0 --profile minimal --component rustfmt --component clippy
          rustc +1.95.0 -Vv > "$OUT/rustc.txt"
          cargo +1.95.0 -V > "$OUT/cargo.txt"
          uname -m > "$OUT/architecture.txt"
      - name: Preserve repository truth and source-integrity negative controls
        id: repository
        if: ${{ always() && steps.source.outcome == 'success' && steps.preflight.outcome == 'success' }}
        shell: bash
        run: |
          set -euo pipefail
          status=0
          bash "$OUT/run-command.sh" repository python3 -B scripts/ci/check_repository.py || status=1
          bash "$OUT/run-command.sh" source-negative-controls python3 -B scripts/ci/test_ci_source_integrity.py || status=1
          exit "$status"
      - name: Run all next-architecture Python controls and retained exact fixture
        id: python
        if: ${{ always() && steps.source.outcome == 'success' && steps.preflight.outcome == 'success' }}
        shell: bash
        run: |
          set -euo pipefail
          status=0
          bash "$OUT/run-command.sh" next-python python3 -B -m unittest discover -s formal/next-architecture-security -p 'test_*.py' -v || status=1
          bash "$OUT/run-command.sh" counterexample-fixture python3 -B formal/next-architecture-security/counterexamples.py --check-fixture || status=1
          bash "$OUT/run-command.sh" complete-version-vector python3 -B scripts/cell_complete_version_vector.py --check || status=1
          bash "$OUT/run-command.sh" discovery-epoch-vector python3 -B scripts/cell_discovery_epoch_v3_vector.py --check || status=1
          bash "$OUT/run-command.sh" discovery-workflow-controls python3 -B scripts/ci/test_cell_discovery_v3_ci.py || status=1
          bash "$OUT/run-command.sh" complete-content-vector python3 -B scripts/cell_version_content_vector.py --check || status=1
          bash "$OUT/run-command.sh" version-retention-vector python3 -B scripts/cell_version_retention_v3_vector.py --check || status=1
          bash "$OUT/run-command.sh" storage-descriptor-vector python3 -B scripts/cell_storage_descriptor_reference.py --check || status=1
          bash "$OUT/run-command.sh" storage-convergence-workflow-controls python3 -B scripts/ci/test_cell_storage_convergence_ci.py || status=1
          bash "$OUT/run-command.sh" artifact-map-controls python3 -B scripts/ci/test_prepare_artifact_upload.py || status=1
          exit "$status"
      - name: Verify locked graph and unchanged all-source formatting
        id: graph_format
        if: ${{ always() && steps.source.outcome == 'success' && steps.preflight.outcome == 'success' && steps.toolchain.outcome == 'success' }}
        shell: bash
        run: |
          set -euo pipefail
          status=0
          cargo +1.95.0 metadata --locked --manifest-path trillionnium/Cargo.toml --format-version 1 > "$OUT/cargo-graph.json" 2> "$OUT/cargo-graph.log" || status=1
          bash "$OUT/run-command.sh" all-source-format cargo +1.95.0 fmt --manifest-path trillionnium/Cargo.toml --all -- --check || status=1
          exit "$status"
      - name: Run the complete default-feature P2P crate
        id: p2p
        if: ${{ always() && steps.source.outcome == 'success' && steps.preflight.outcome == 'success' && steps.toolchain.outcome == 'success' }}
        shell: bash
        run: |
          set -euo pipefail
          bash "$OUT/run-command.sh" p2p-complete cargo +1.95.0 test --locked --release --manifest-path trillionnium/Cargo.toml -p trnm-data-availability -- --test-threads=1
      - name: Run real sealed-input Python controls and verify every frozen case
        id: sealed_python
        if: ${{ always() && steps.source.outcome == 'success' && steps.preflight.outcome == 'success' }}
        shell: bash
        run: |
