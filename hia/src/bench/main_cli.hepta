  id_dp:u64 = int.add.wrap(start_dp,f_dp)
  code_dp:u32 = int.cast(id_dp) {"mode":"wrap"}
  ret(code_dp)
block value(i_val:readbuf,o_val:mutbuf,n_val:u64,p_val:u64,e_val:u64,k_val:u64,f_val:u64)
  s_at:u64 = const() {"value":24}
  seen:u64 = call(o_val,s_at) {"function":"bench_get"}
  single:u64 = const() {"value":1}
  bit_value:u64 = int.shl.checked(single,f_val)
  dup:u64 = bit.and(seen,bit_value)
  none_val:u64 = const() {"value":0}
  fresh:bool = compare.eq(dup,none_val)
  branch fresh type_dispatch(i_val,o_val,n_val,p_val,e_val,k_val,f_val,seen,bit_value) duplicate(o_val,f_val)
block type_dispatch(td_i:readbuf,td_o:mutbuf,td_n:u64,td_p:u64,td_e:u64,td_k:u64,td_f:u64,td_seen:u64,td_flag:u64)
  work_field:u64 = const() {"value":6}
  strat_field:u64 = const() {"value":8}
  is_work:bool = compare.eq(td_f,work_field)
  is_strat:bool = compare.eq(td_f,strat_field)
  is_enum:bool = bool.or(is_work,is_strat)
  branch is_enum enum_value(td_i,td_o,td_n,td_p,td_e,td_k,td_f,td_seen,td_flag) number_start(td_i,td_o,td_n,td_p,td_e,td_k,td_f,td_seen,td_flag)
block enum_value(ev_i:readbuf,ev_o:mutbuf,ev_n:u64,ev_p:u64,ev_e:u64,ev_k:u64,ev_f:u64,ev_seen:u64,ev_flag:u64)
  ev_len:u64 = int.sub.wrap(ev_e,ev_p)
  enum_index:u64 = call(ev_i,ev_p,ev_len) {"function":"bc_enum"}
  last_work:u64 = const() {"value":2}
  work_opt:u64 = const() {"value":6}
  original_enum:u64 = const() {"value":3}
  write_last_enum:u64 = const() {"value":4}
  write_last_wire:u64 = const() {"value":3}
  hot_bucket_enum:u64 = const() {"value":5}
  hot_bucket_wire:u64 = const() {"value":4}
  write_first_enum:u64 = const() {"value":6}
  write_first_wire:u64 = const() {"value":2}
  footprint_enum:u64 = const() {"value":7}
  footprint_wire:u64 = const() {"value":1}
  auto_enum:u64 = const() {"value":8}
  auto_wire:u64 = const() {"value":5}
  greedy_enum:u64 = const() {"value":9}
  greedy_wire:u64 = const() {"value":6}
  is_work_opt:bool = compare.eq(ev_f,work_opt)
  is_work_value:bool = compare.le(enum_index,last_work)
  clean_work:bool = bool.and(is_work_opt,is_work_value)
  is_original:bool = compare.eq(enum_index,original_enum)
  is_write_last:bool = compare.eq(enum_index,write_last_enum)
  is_hot_bucket:bool = compare.eq(enum_index,hot_bucket_enum)
  previous_strategies:bool = bool.or(is_original,is_write_last)
  legacy_strategies:bool = bool.or(previous_strategies,is_hot_bucket)
  is_write_first:bool = compare.eq(enum_index,write_first_enum)
  current_strategies:bool = bool.or(legacy_strategies,is_write_first)
  is_footprint:bool = compare.eq(enum_index,footprint_enum)
  native_strategy:bool = bool.or(current_strategies,is_footprint)
  is_auto:bool = compare.eq(enum_index,auto_enum)
  is_greedy:bool = compare.eq(enum_index,greedy_enum)
  scoped_strategy:bool = bool.or(is_auto,is_greedy)
  candidate_strategy:bool = bool.or(native_strategy,scoped_strategy)
  is_strat_opt:bool = bool.not(is_work_opt)
  clean_strategy:bool = bool.and(candidate_strategy,is_strat_opt)
  zero_enum:u64 = const() {"value":0}
  previous_wire:u64 = select(is_write_last,write_last_wire,zero_enum)
  old_strategy_wire:u64 = select(is_hot_bucket,hot_bucket_wire,previous_wire)
  current_wire:u64 = select(is_write_first,write_first_wire,old_strategy_wire)
  native_wire:u64 = select(is_footprint,footprint_wire,current_wire)
