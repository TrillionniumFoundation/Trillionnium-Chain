_run\": true,\n+  \"original_test_roster\": [\n+    \"test_declaration_validation_never_claims_source_inspection_or_security\",\n+    \"test_actual_reviewed_source_inspection_preserves_hold\",\n+    \"test_missing_or_added_use_cannot_narrow_or_expand_the_review\",\n+    \"test_attack_selection_orders_are_distinct_and_not_interchangeable\",\n+    \"test_collision_game_cannot_be_omitted_for_signature_or_root_binding\",\n+    \"test_work_threshold_cannot_be_replaced_by_a_single_target_hash_game\",\n+    \"test_width_exponent_is_not_a_lifetime_probability_or_concrete_bit_claim\",\n+    \"test_primitive_relabel_width_change_and_unknown_algorithm_refused\",\n+    \"test_domain_omission_or_transfer_requires_a_new_review\",\n+    \"test_consumed_width_cannot_hide_truncation_or_drop_a_role\",\n+    \"test_unmapped_proof_output_cannot_inherit_digest_width\",\n+    \"test_literal_metadata_cannot_be_claimed_as_transitive_full_content\",\n+    \"test_proof_parameter_profiles_cannot_be_pooled_or_replaced\",\n+    \"test_proof_width_or_fri_parameters_cannot_supply_soundness\",\n+    \"test_source_map_cannot_self_repin_changed_source\",\n+    \"test_source_paths_cannot_be_removed_redirected_or_duplicated\",\n+    \"test_bool_int_aliases_wrong_types_and_extra_fields_refused\",\n+    \"test_numeric_bounds_source_trust_and_scope_self_certification_refused\",\n+    \"test_wrapper_can_only_describe_the_old_digest_literal\",\n+    \"test_wrapper_cannot_claim_original_content_or_recovered_provenance\",\n+    \"test_small_inner_collision_survives_a_real_sha512_wrapper\",\n+    \"test_direct_recomputation_still_grants_no_old_history_or_adoption\",\n+    \"test_new_byte_readbacks_have_explicit_narrow_scopes\",\n+    \"test_typed_graph_and_history_cannot_promote_missing_authority\",\n+    \"test_finite_or_declared_readback_cannot_claim_whole_chain_scope\",\n+    \"test_missing_migration_prerequisite_and_unknown_material_refused\",\n+    \"test_strict_json_refuses_duplicate_numeric_unicode_and_nesting_ambiguity\",\n+    \"test_missing_source_and_same_size_source_mutation_refused\",\n+    \"test_symlink_source_and_symlink_manifest_refused\",\n+    \"test_symlink_repository_ancestor_refused\",\n+    \"test_nonregular_fifo_and_oversize_source_refused_without_blocking\",\n+    \"test_cli_success_is_hold_and_failure_is_refuse_exit_two\",\n+    \"test_manifest_path_traversal_and_changed_review_base_refused\"\n+  ],\n+  \"originals\": {\n+    \"config/pon/hash-use-contract-v1.json\": {\n+      \"current_blob\": \"c2f7552fded037e2e6ff6a91609112ad7aa6b301\",\n+      \"historical_blob\": \"c2f7552fded037e2e6ff6a91609112ad7aa6b301\",\n+      \"last_mapping_commit\": \"57b069ae1e7ed32ff95e4f2a18a74d5eadcda550\",\n+      \"preserved_original\": {\n+        \"bytes\": 72224,\n+        \"path\": \"/private/tmp/chain-hash-use-current-binding-evidence-20261114/readonly-consumer-and-scope-v2/originals/manifest.json\",\n+        \"sha256\": \"50c12b630049933110a400590d64f8bfb764a76bdf8737c71a53a71245a0fc92\"\n+      },\n+      \"whole_raw_same\": true\n+    },\n+    \"docs/security/HASH_USE_CONTRACT_V1.md\": {\n+      \"current_blob\": \"d912dc2e923b1e39bab1661d5616e90873c74522\",\n+      \"historical_blob\": \"d912dc2e923b1e39bab1661d5616e90873c74522\",\n+      \"last_mapping_commit\": \"57b069ae1e7ed32ff95e4f2a18a74d5eadcda550\",\n+      \"preserved_original\": {\n+        \"bytes\": 12742,\n+        \"path\": \"/private/tmp/chain-hash-use-current-binding-evidence-20261114/readonly-consumer-and-scope-v2/originals/contract.md\",\n+        \"sha256\": \"5aed5a2226f8de982617355476009eaa42ce4600199a4cfece494a5388503777\"\n+      },\n+      \"whole_raw_same\": true\n+    },\n+    \"scripts/ci/hash_use_contract.py\": {\n+      \"current_blob\": \"0c8e2ac894a8a36a70ba69d10e8146c930541010\",\n+      \"historical_blob\": \"0c8e2ac894a8a36a70ba69d10e8146c930541010\",\n+      \"last_mapping_commit\": \"57b069ae1e7ed32ff95e4f2a18a74d5eadcda550\",\n+      \"preserved_original\": {\n+