block pending(i_pe:readbuf,o_pe:mutbuf,p_pe:u64,e_pe:u64,s_pe:u64,k_pe:u64,f_pe:u64)
  special_pe:u64 = call(i_pe,p_pe,s_pe) {"function":"bc_special"}
  zero_pe:u64 = const() {"value":0}
  help_pe:u64 = const() {"value":1}
  end_pe:u64 = const() {"value":2}
  is_help_pe:bool = compare.eq(special_pe,help_pe)
  is_end_pe:bool = compare.eq(special_pe,end_pe)
  last_pe:bool = compare.eq(k_pe,zero_pe)
  terminal_pe:bool = bool.and(last_pe,is_end_pe)
  recognized_pe:bool = bool.or(terminal_pe,is_help_pe)
  branch recognized_pe missing(o_pe,f_pe) pending_long(i_pe,o_pe,p_pe,e_pe,f_pe)
block pending_long(i_plg:readbuf,o_plg:mutbuf,p_plg:u64,e_plg:u64,f_plg:u64)
  equal_plg:u64 = call(i_plg,p_plg,e_plg) {"function":"bc_equal"}
  size_plg:u64 = int.sub.wrap(equal_plg,p_plg)
  option_plg:u64 = call(i_plg,p_plg,size_plg) {"function":"bc_option"}
  corrected_plg:u64 = const() {"value":9}
  profile_plg:u64 = const() {"value":3}
  persist_plg:u64 = const() {"value":7}
  known_plg:bool = compare.lt(option_plg,corrected_plg)
  profile_flag_plg:bool = compare.eq(option_plg,profile_plg)
  persist_flag_plg:bool = compare.eq(option_plg,persist_plg)
  flag_plg:bool = bool.or(profile_flag_plg,persist_flag_plg)
  grammar_eq_plg:bool = compare.ne(equal_plg,e_plg)
  bad_plg:bool = bool.and(flag_plg,grammar_eq_plg)
  safe_plg:bool = bool.not(bad_plg)
  missing_plg:bool = bool.and(known_plg,safe_plg)
  branch missing_plg missing(o_plg,f_plg) fail()
