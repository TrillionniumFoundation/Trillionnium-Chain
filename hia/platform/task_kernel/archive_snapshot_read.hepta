fn capture_phase(r:readbuf,s:mutbuf,p:u64) -> (u32) effects(read,write,trap) entry(entry)
block entry(r:readbuf,s:mutbuf,p:u64)
  p0:u64 = const() {"value":200}
  match0:bool = compare.eq(p,p0)
  branch match0 prepared(r,s) other(r,s,p)
block other(ar:readbuf,as0:mutbuf,ap:u64)
  p1:u64 = const() {"value":201}
  match1:bool = compare.eq(ap,p1)
  branch match1 stepped(ar,as0) other2(ar,as0,ap)
block other2(br:readbuf,bs:mutbuf,bp:u64)
  p2:u64 = const() {"value":202}
  match2:bool = compare.eq(bp,p2)
  branch match2 column(br,bs) other3(br,bs,bp)
block other3(cr:readbuf,cs:mutbuf,cp:u64)
  p3:u64 = const() {"value":203}
  match3:bool = compare.eq(cp,p3)
  branch match3 finalized(cr,cs) bad()
block prepared(dr:readbuf,ds:mutbuf)
  response0:usize = buffer.len(dr)
  exp0:u64 = const() {"value":0}
  match_p:bool = call(dr,response0,exp0) {"function":"sr_status"}
  branch match_p owned(dr,ds) unavailable()
block owned(er:readbuf,es:mutbuf)
  capidx:u64 = const() {"value":8}
  sid:u64 = call(er,capidx) {"function":"tr_read"}
  cap_s:u64 = const() {"value":40}
  _sid:u64 = call(es,cap_s,sid) {"function":"cp_put"}
  next_rc:u32 = call(es) {"function":"capture_step"}
  ret(next_rc)
block stepped(fr:readbuf,fs:mutbuf)
  response1:usize = buffer.len(fr)
  exp_done:u64 = const() {"value":101}
  got_done:bool = call(fr,response1,exp_done) {"function":"sr_status"}
  branch got_done exhausted(fs) check_row(fr,fs,response1)
block check_row(gr:readbuf,gs:mutbuf,gn:usize)
  response_row:u64 = const() {"value":100}
  got_row:bool = call(gr,gn,response_row) {"function":"sr_status"}
  branch got_row read_value(gs) unavailable()
block read_value(hs:mutbuf)
  new_phase:u64 = const() {"value":202}
  first_column:u64 = const() {"value":0}
  col_rc:u32 = call(hs,new_phase,first_column) {"function":"sr_col"}
  ret(col_rc)
block column(ir:readbuf,is0:mutbuf)
  v_extent:usize = buffer.len(ir)
  low:usize = const() {"value":25}
  high:usize = const() {"value":14061}
  lo:bool = compare.ge(v_extent,low)
  hi:bool = compare.le(v_extent,high)
  bounded:bool = bool.and(lo,hi)
  branch bounded blob(ir,is0,v_extent) bad()
block blob(jr:readbuf,js:mutbuf,jn:usize)
  kind:u64 = const() {"value":4}
  typed:bool = call(jr,jn,kind) {"function":"sr_value"}
  branch typed admit(jr,js,jn) schema()
block admit(kr:readbuf,ks:mutbuf,kn:usize)
  nn:u64 = int.cast(kn) {"mode":"wrap"}
  pushed:u32 = call(kr,ks,nn) {"function":"capture_value"}
  zero:u32 = const() {"value":0}
  passed:bool = compare.eq(zero,pushed)
  branch passed again(ks) return_code(pushed)
block again(ls:mutbuf)
  more_rc:u32 = call(ls) {"function":"capture_step"}
  ret(more_rc)
block exhausted(ms:mutbuf)
  _close_frame:u64 = call(ms) {"function":"capture_close_frame"}
  cohere:u64 = call(ms) {"function":"capture_counts"}
  ss:u64 = const() {"value":40}
  handle:u64 = call(ms,ss) {"function":"cp_get"}
  fnl:u64 = const() {"value":9}
  later:u64 = const() {"value":203}
  done_rc:u32 = call(ms,later,fnl,handle) {"function":"sr_handle"}
  ret(done_rc)
block finalized(nr:readbuf,ns:mutbuf)
  response2:usize = buffer.len(nr)
  exp_f:u64 = const() {"value":0}
  passed_f:bool = call(nr,response2,exp_f) {"function":"sr_status"}
  branch passed_f finish(ns) unavailable()
block finish(os:mutbuf)
  commit_rc:u32 = call(os) {"function":"arc_prepare_commit"}
  ret(commit_rc)
block return_code(fail:u32)
  ret(fail)
block bad()
  malformed:u32 = const() {"value":100}
  ret(malformed)
block unavailable()
  mechanical:u32 = const() {"value":21}
  ret(mechanical)
block schema()
  changed:u32 = const() {"value":22}
  ret(changed)
end

fn capture_step(s:mutbuf) -> (u32) effects(read,write,trap) entry(entry)
block entry(s:mutbuf)
  at:u64 = const() {"value":40}
  stmt:u64 = call(s,at) {"function":"cp_get"}
  phase:u64 = const() {"value":201}
  op:u64 = const() {"value":7}
  rc:u32 = call(s,phase,op,stmt) {"function":"sr_handle"}
  ret(rc)
end

fn capture_close_frame(s:mutbuf) -> (u64) effects(read,write,trap) entry(entry)
block entry(s:mutbuf)
  slot:u64 = const() {"value":168}
  start:u64 = call(s,slot) {"function":"cp_get"}
  zero:u64 = const() {"value":0}
  pending:bool = compare.ne(start,zero)
  branch pending close(s,start) none(zero)
block close(cs:mutbuf,ca:u64)
  a:u64 = const() {"value":136}
  cursor:u64 = call(cs,a) {"function":"cp_get"}
  width:u64 = int.sub.wrap(cursor,ca)
  _patch:u64 = call(cs,ca,width) {"function":"cp_put"}
  field:u64 = const() {"value":192}
  counter:u64 = call(cs,field) {"function":"cp_get"}
  saved_cohort:u64 = const() {"value":176}
  cohort:u64 = call(cs,saved_cohort) {"function":"cp_get"}
  _count:u64 = call(cs,counter,cohort) {"function":"cp_put"}
  ret(width)
block none(z:u64)
  ret(z)
end

fn capture_counts(s:mutbuf) -> (u64) effects(read,write,trap) entry(entry)
block entry(s:mutbuf)
  seals_slot:u64 = const() {"value":144}
  live_slot:u64 = const() {"value":152}
  meta_slot:u64 = const() {"value":128}
  live:u64 = call(s,live_slot) {"function":"cp_get"}
  seals:u64 = call(s,seals_slot) {"function":"cp_get"}
  m:u64 = call(s,meta_slot) {"function":"cp_get"}
  step:u64 = const() {"value":120}
  count_at:u64 = int.add.wrap(m,step)
  fixed:u64 = const() {"value":8200}
  _count0:u64 = call(s,fixed,seals) {"function":"cp_put"}
  _count1:u64 = call(s,count_at,live) {"function":"cp_put"}
  ret(seals)
end

fn capture_value(r:readbuf,s:mutbuf,n:u64) -> (u32) effects(read,write,trap) entry(entry)
block entry(r:readbuf,s:mutbuf,n:u64)
  at:usize = const() {"value":24}
  tag:u8 = buffer.load(r,at)
  live:u8 = const() {"value":76}
  is_live:bool = compare.eq(tag,live)
  branch is_live live_row(r,s,n) later(r,s,n,tag)
block later(lr:readbuf,ls:mutbuf,ln:u64,lt:u8)
  seal:u8 = const() {"value":83}
  is_seal:bool = compare.eq(lt,seal)
  branch is_seal seal_row(lr,ls,ln) archive(lr,ls,ln,lt)
