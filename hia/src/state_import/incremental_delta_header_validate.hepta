  epoch_step:bool = compare.le(difference,one)
  epoch_ok:bool = bool.and(epoch_forward,epoch_step)
  counters:bool = bool.and(height_ok,epoch_ok)
  consistent:bool = bool.and(digest_pairs,counters)
  ret(consistent)
end
