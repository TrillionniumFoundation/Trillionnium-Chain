  b:usize = int.cast(second) {"mode":"wrap"}
  n:u64 = const() {"value":32}
  yes:bool = call(m,a,b,n) {"function":"smk_eq"}
  ret(yes)
end

fn hfs_capture_engine(r:readbuf,m:mutbuf,seq:u64,main_end:usize) -> (bool) effects(read,write,trap) entry(entry)
block entry(r:readbuf,m:mutbuf,seq:u64,main_end:usize)
  width:u64 = const() {"value":32}
  one:u64 = const() {"value":1}
  zero:u64 = const() {"value":0}
  base_roots:u64 = const() {"value":441000}
  old_rel:u64 = int.sub.wrap(seq,one)
  old_off:u64 = int.mul.wrap(old_rel,width)
  old_abs:u64 = int.add.wrap(base_roots,old_off)
