@@ -51,13 +51,36 @@
             value.update(chunk)
     return value.hexdigest()
 
+SOURCE_FIELDS = (
+    "base", "candidate", "kind", "prospective_merge", "schema", "tested_commit", "tested_tree",
+    "tests_executed_by_identity_check", "tracked_bytes", "tracked_entries", "tracked_worktree_verified",
+)
+
+def source_identity(raw, sidecar, head, tree):
+    require(type(raw) is bytes and raw == sidecar.read_bytes(), "source stdout/sidecar bytes differ")
+    value = json.loads(raw.decode("utf-8", errors="strict"))
+    require(type(value) is dict and set(value) == set(SOURCE_FIELDS), "source identity must have exactly eleven fields")
+    expected = {
+        "base": None, "candidate": head, "kind": "head", "prospective_merge": None,
+        "schema": "trnm-ci-source-v1", "tested_commit": head, "tested_tree": tree,
+        "tests_executed_by_identity_check": False, "tracked_worktree_verified": True,
+    }
+    for field, wanted in expected.items():
+        require(type(value[field]) is type(wanted) and value[field] == wanted,
+                "source identity type/value differs: " + field)
+    for field in ("tracked_entries", "tracked_bytes"):
+        require(type(value[field]) is int and value[field] > 0, "source identity count is not a positive integer: " + field)
+    canonical = (json.dumps(value, sort_keys=True, indent=2) + "\n").encode("utf-8")
+    require(raw == canonical, "source identity is not the canonical receipt bytes")
+    return value
+
 def artifact_identity():
     path = SOURCE / ARTIFACT_PATH
     before = path.lstat()
     require(path.resolve(strict=True) == path and stat.S_ISREG(before.st_mode) and before.st_nlink == 1,
             "selected worker artifact must be a canonical single-link regular file")
     require(before.st_size == ARTIFACT_BYTES, "selected worker artifact size differs")
-    with os.fdopen(os.open(path, os.O_RDONLY | os.O_NOFOLLOW), "rb") as stream:
+    with os.fdopen(os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC), "rb") as stream:
         opened = os.fstat(stream.fileno())
         raw = stream.read(ARTIFACT_BYTES + 1)
         closed = os.fstat(stream.fileno())
