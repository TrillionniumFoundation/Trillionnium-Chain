  branch valid_u hash_feed(ur,uw,head_u,n_u,limit_u,old_u) frame()
block hash_feed(yr:readbuf,yw:mutbuf,yh:u64,yn:u64,yl:u64,yi:u64)
  sha_y:u64 = call(yr,yh,yn,yw,yl) {"function":"tr_sha_update_limit"}
