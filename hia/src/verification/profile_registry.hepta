  branch accepted_lookup publish(ri,ro,candidate) refuse(status)
block publish(pi:readbuf,po:mutbuf,prow:u64)
  zero_row:u64 = const() {"value":0}
  has_row:bool = compare.ne(prow,zero_row)
  need_row:usize = const() {"value":101}
  need_base:usize = const() {"value":4}
