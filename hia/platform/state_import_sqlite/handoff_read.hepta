fn hf_decode(raw:readbuf,state:mutbuf) -> (bool) effects(read,write,trap) entry(entry)
block entry(raw:readbuf,state:mutbuf)
  begin:u64 = const() {"value":24}
  stage:u64 = const() {"value":4096}
  count:u64 = const() {"value":423}
  jump hex_pairs(raw,state,begin,stage,count)
block hex_pairs(hr:readbuf,hs:mutbuf,i:u64,j:u64,n:u64)
  one:u64 = const() {"value":1}
  second:u64 = int.add.wrap(i,one)
  ia:usize = int.cast(i) {"mode":"wrap"}
  ib:usize = int.cast(second) {"mode":"wrap"}
  high:u8 = buffer.load(hr,ia)
  low:u8 = buffer.load(hr,ib)
  byte:u64 = call(high,low) {"function":"rc_octet"}
  limit:u64 = const() {"value":255}
  valid:bool = compare.le(byte,limit)
  branch valid save(hr,hs,second,j,n,byte) failure()
block save(sr:readbuf,sm:mutbuf,si:u64,sj:u64,sn:u64,byte_s:u64)
  pos:usize = int.cast(sj) {"mode":"wrap"}
  value:u8 = int.cast(byte_s) {"mode":"wrap"}
  _ = buffer.store(sm,pos,value)
  step:u64 = const() {"value":1}
  next_i:u64 = int.add.wrap(si,step)
  next_j:u64 = int.add.wrap(sj,step)
  left:u64 = int.sub.wrap(sn,step)
  done:bool = compare.eq(sn,step)
  branch done success() hex_pairs(sr,sm,next_i,next_j,left)
block success()
  yes:bool = const() {"value":true}
  ret(yes)
block failure()
  no:bool = const() {"value":false}
  ret(no)
end

fn hf_record(state:mutbuf,work:mutbuf) -> (bool) effects(read,write,trap) entry(entry)
block entry(state:mutbuf,work:mutbuf)
  magic_at:u64 = const() {"value":4136}
  header:u64 = call(state,magic_at) {"function":"cp_get"}
  mask:u64 = const() {"value":281474976710655}
  prefix:u64 = bit.and(header,mask)
  magic:u64 = const() {"value":1100691228749}
  rev_sql_at:u64 = const() {"value":4096}
  rev_raw_at:u64 = const() {"value":4143}
  rev_sql:u64 = call(state,rev_sql_at) {"function":"cp_get"}
  rev_raw:u64 = call(state,rev_raw_at) {"function":"cp_get"}
  bound:bool = compare.eq(rev_sql,rev_raw)
  header_ok:bool = compare.eq(prefix,magic)
  framed:bool = bool.and(bound,header_ok)
  branch framed shape(state,work) bad()
block shape(ss:mutbuf,sw:mutbuf)
  state_at:usize = const() {"value":4142}
  state_code:u8 = buffer.load(ss,state_at)
  verified:u8 = const() {"value":1}
  projected:u8 = const() {"value":2}
  is_verified:bool = compare.eq(state_code,verified)
  is_projected:bool = compare.eq(state_code,projected)
  known:bool = bool.or(is_verified,is_projected)
  optional_at:u64 = const() {"value":4479}
  options:u64 = call(ss,optional_at) {"function":"cp_get"}
  zero:u64 = const() {"value":0}
  no_options:bool = compare.eq(options,zero)
  shape_ok:bool = bool.and(known,no_options)
  branch shape_ok semantics(ss,sw,is_projected) bad()
block semantics(ms:mutbuf,mw:mutbuf,require_target:bool)
  checked:bool = call(ms,require_target) {"function":"hf_fields"}
  branch checked commit(ms,mw) bad()
block commit(cs:mutbuf,cw:mutbuf)
  valid:bool = call(cs,cw) {"function":"hf_digest"}
  ret(valid)
block bad()
  refused:bool = const() {"value":false}
  ret(refused)
end

fn hf_fields(state:mutbuf,projected:bool) -> (bool) effects(read,write,trap) entry(entry)
block entry(state:mutbuf,projected:bool)
  f0:u64 = const() {"value":4151}
  field0:bool = call(state,f0) {"function":"hf_nonzero"}
  valid0:bool = bool.and(field0,field0)
  f1:u64 = const() {"value":4183}
  field1:bool = call(state,f1) {"function":"hf_nonzero"}
  valid1:bool = bool.and(field1,field1)
  linked1:bool = bool.and(valid1,valid0)
  f2:u64 = const() {"value":4215}
  field2:bool = call(state,f2) {"function":"hf_nonzero"}
  valid2:bool = bool.and(field2,field2)
  linked2:bool = bool.and(valid2,linked1)
  f3:u64 = const() {"value":4247}
  field3:bool = call(state,f3) {"function":"hf_nonzero"}
  valid3:bool = bool.and(field3,field3)
  linked3:bool = bool.and(valid3,linked2)
  f4:u64 = const() {"value":4279}
  field4:bool = call(state,f4) {"function":"hf_nonzero"}
  valid4:bool = bool.and(field4,field4)
  linked4:bool = bool.and(valid4,linked3)
  f5:u64 = const() {"value":4311}
  field5:bool = call(state,f5) {"function":"hf_nonzero"}
  valid5:bool = compare.eq(field5,projected)
  linked5:bool = bool.and(valid5,linked4)
  f6:u64 = const() {"value":4343}
  field6:bool = call(state,f6) {"function":"hf_nonzero"}
  valid6:bool = compare.eq(field6,projected)
  linked6:bool = bool.and(valid6,linked5)
  f7:u64 = const() {"value":4375}
  field7:bool = call(state,f7) {"function":"hf_nonzero"}
  valid7:bool = compare.eq(field7,projected)
  linked7:bool = bool.and(valid7,linked6)
  f8:u64 = const() {"value":4407}
  field8:bool = call(state,f8) {"function":"hf_nonzero"}
  valid8:bool = bool.and(field8,field8)
  linked8:bool = bool.and(valid8,linked7)
  f9:u64 = const() {"value":4439}
  field9:bool = call(state,f9) {"function":"hf_nonzero"}
  valid9:bool = compare.eq(field9,projected)
  linked9:bool = bool.and(valid9,linked8)

  ret(linked9)
end

fn hf_nonzero(state:mutbuf,source:u64) -> (bool) effects(read,write,trap) entry(entry)
block entry(state:mutbuf,source:u64)
  step:u64 = const() {"value":8}
  plus1:u64 = int.add.wrap(source,step)
  plus2:u64 = int.add.wrap(plus1,step)
  plus3:u64 = int.add.wrap(plus2,step)
  a:u64 = call(state,source) {"function":"cp_get"}
  b:u64 = call(state,plus1) {"function":"cp_get"}
  c:u64 = call(state,plus2) {"function":"cp_get"}
  d:u64 = call(state,plus3) {"function":"cp_get"}
  ab:u64 = bit.or(a,b)
  cd:u64 = bit.or(c,d)
  sum:u64 = bit.or(ab,cd)
  zero:u64 = const() {"value":0}
  present:bool = compare.ne(sum,zero)
  ret(present)
end

fn hf_digest(state:mutbuf,work:mutbuf) -> (bool) effects(read,write,trap) entry(entry)
block entry(state:mutbuf,work:mutbuf)
  init:u64 = call(work) {"function":"tr_sha_init"}
  pos0:u64 = const() {"value":1208}
  word0:u64 = const() {"value":2305843009213693952}
  _write0:u64 = call(work,pos0,word0) {"function":"tr_put"}
  pos8:u64 = const() {"value":1216}
  word8:u64 = const() {"value":7451607104633074292}
  _write8:u64 = call(work,pos8,word8) {"function":"tr_put"}
  pos16:u64 = const() {"value":1224}
  word16:u64 = const() {"value":7507059053662855538}
  _write16:u64 = call(work,pos16,word16) {"function":"tr_put"}
  pos24:u64 = const() {"value":1232}
  word24:u64 = const() {"value":8227344684417314401}
  _write24:u64 = call(work,pos24,word24) {"function":"tr_put"}
  pos32:u64 = const() {"value":1240}
  word32:u64 = const() {"value":3492029570023908197}
  _write32:u64 = call(work,pos32,word32) {"function":"tr_put"}
  pos40:u64 = const() {"value":1248}
  word40:u64 = const() {"value":6845752908579864576}
  _write40:u64 = call(work,pos40,word40) {"function":"tr_put"}
  record:u64 = const() {"value":4136}
  payload:u64 = const() {"value":1256}
  record_len:u64 = const() {"value":351}
  start:u64 = const() {"value":1208}
  total:u64 = const() {"value":399}

  _copy:u64 = call(state,record,work,payload,record_len) {"function":"cp_wout"}
  absorb:u64 = call(work,start,total) {"function":"tr_sha_update_work"}
  sealed:u64 = call(work) {"function":"tr_sha_final"}
  ia:u64 = bit.or(init,absorb)
  all:u64 = bit.or(ia,sealed)
  zero:u64 = const() {"value":0}
  okay:bool = compare.eq(all,zero)
  branch okay digest_matches(state,work) bad()
block digest_matches(ds:mutbuf,dw:mutbuf)
  embedded:u64 = const() {"value":4487}
  sql:u64 = const() {"value":4104}
  actual:u64 = const() {"value":1168}
  span:u64 = const() {"value":32}
  jump compare_words(ds,dw,embedded,sql,actual,span)
block compare_words(xs:mutbuf,xw:mutbuf,a:u64,b:u64,k:u64,left:u64)
  from_record:u64 = call(xs,a) {"function":"cp_get"}
  from_column:u64 = call(xs,b) {"function":"cp_get"}
  calculated:u64 = call(xw,k) {"function":"tr_get"}
  first:bool = compare.eq(from_record,calculated)
  second:bool = compare.eq(from_column,calculated)
  match_both:bool = bool.and(first,second)
  branch match_both next(xs,xw,a,b,k,left) bad()
block next(ns:mutbuf,nw:mutbuf,na:u64,nb:u64,nk:u64,nleft:u64)
  eight:u64 = const() {"value":8}
  a1:u64 = int.add.wrap(na,eight)
  b1:u64 = int.add.wrap(nb,eight)
  k1:u64 = int.add.wrap(nk,eight)
  remains:u64 = int.sub.wrap(nleft,eight)
  done:bool = compare.eq(nleft,eight)
  branch done good() compare_words(ns,nw,a1,b1,k1,remains)
block good()
  yes:bool = const() {"value":true}
  ret(yes)
block bad()
  no:bool = const() {"value":false}
  ret(no)
end
