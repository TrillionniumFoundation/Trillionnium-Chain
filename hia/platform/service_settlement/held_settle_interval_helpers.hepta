fn hfs_receipt_mark(r:readbuf,m:mutbuf,seq:u64) -> (bool) effects(read,write,trap) entry(entry)
block entry(r:readbuf,m:mutbuf,seq:u64)
  checked:u64 = call(m) {"function":"hfs_settle_index"}
  zero:u64 = const() {"value":0}
  valid:bool = compare.gt(checked,zero)
  branch valid route(r,m,seq,checked) bad()
block route(rr:readbuf,rm:mutbuf,rseq:u64,settle_index:u64)
  four:u64 = const() {"value":4}
  last:bool = compare.eq(rseq,four)
  idx:u64 = select(last,settle_index,rseq)
  base:u64 = call(idx) {"function":"hfs_marker_offset"}
  eight:u64 = const() {"value":8}
  state_field:u64 = const() {"value":136}
  coords:u64 = int.add.wrap(base,eight)
  root:u64 = int.add.wrap(base,state_field)
  a:usize = int.cast(coords) {"mode":"wrap"}
  b:usize = int.cast(root) {"mode":"wrap"}
  ac:usize = const() {"value":100}
  ar:usize = const() {"value":140}
  wc:u64 = const() {"value":40}
  wr:u64 = const() {"value":32}
  matched_c:bool = call(rr,rm,ac,a,wc) {"function":"smr_eq_bound"}
  matched_r:bool = call(rr,rm,ar,b,wr) {"function":"smr_eq_bound"}
  yes:bool = bool.and(matched_c,matched_r)
  ret(yes)
block bad()
  no:bool = const() {"value":false}
  ret(no)
end

