  file_ok:bool = compare.le(high,file_cap)
  o_ok:bool = compare.le(ordinary,ocap)
  c_ok:bool = compare.le(cleanup,ccap)
  one_bind:bool = compare.eq(bind,one)
  growth_ok:bool = compare.le(growth,ordinary)
  valid_kind:bool = compare.eq(kind,one)
