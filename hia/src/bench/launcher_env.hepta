fn f0(i:readbuf,o:mutbuf,s:mutbuf) -> (u32) effects(read,trap) entry(entry)
block entry(i:readbuf,o:mutbuf,s:mutbuf)
  n:usize = buffer.len(i)
  zero:usize = const() {"value":0}
  mask:usize = const() {"value":7}
  limit:usize = const() {"value":512}
  bounded:bool = compare.le(n,limit)
  residue:usize = bit.and(n,mask)
