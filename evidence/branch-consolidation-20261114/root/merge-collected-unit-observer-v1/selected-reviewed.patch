+          grep -x 'OK' "$OUT/verifier-lifeline-reader-controls.log"
+      - name: Reject foreign configured parents and forged cleanup evidence
+        shell: bash
+        run: |
+          set -euo pipefail
+          python3 -B scripts/ci/test_history_fixed_parent_v2.py 2>&1 | tee "$OUT/fixed-parent-reader-controls.log"
+          grep -E '^Ran 4 tests in ' "$OUT/fixed-parent-reader-controls.log"
+          grep -x 'OK' "$OUT/fixed-parent-reader-controls.log"
+      - name: Require read-only collected-unit absence controls
+        shell: bash
+        run: |
+          set -euo pipefail
+          python3 -B scripts/ci/test_collected_unit_empty_v1.py -v 2>&1 | tee "$OUT/collected-unit-empty-controls.log"
+          grep -E '^Ran 21 tests in ' "$OUT/collected-unit-empty-controls.log"
+          grep -x OK "$OUT/collected-unit-empty-controls.log"
+      - name: Exercise real fresh-slice creation and exclusive cleanup before native work
+        shell: bash
+        run: |
+          set -euo pipefail
+          test "$(git hash-object config/systemd/trnmponpublic.slice)" = 8981b6aeed4c08c21679664940366b36a991444a
+          test -d /run/systemd/system
+          test -f /sys/fs/cgroup/cgroup.controllers
+          unit="trnm-history-parent-probe-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT.service"
+          # A separate finite fixture probe preserves all original native budgets.
+          sudo -n systemd-run --unit="$unit" --wait --pipe --collect \
+            --service-type=exec --expand-environment=no --uid=0 --gid=0 \
+            --working-directory="$GITHUB_WORKSPACE" \
+            --property=CPUAccounting=yes --property=MemoryAccounting=yes \
+            --property=CPUQuota=400% --property=CPUQuotaPeriodSec=100ms \
+            --property=MemoryMax=17179869184 --property=Nice=10 \
+            --property=KillMode=control-group --property=TimeoutStopSec=20s \
+            --property=RuntimeMaxSec=120s --setenv=PYTHONDONTWRITEBYTECODE=1 \
+            /usr/bin/python3 "$GITHUB_WORKSPACE/scripts/ci/history_fixed_parent_v2.py" probe \
+            --owner "$GITHUB_RUN_ID.$GITHUB_RUN_ATTEMPT" \
+            --source "$GITHUB_WORKSPACE/config/systemd/trnmponpublic.slice" \
+            > "$OUT/fixed-parent-real-probe.json" 2> "$OUT/fixed-parent-real-probe-systemd.log"
+      - name: Provision the original separate fixed History parent
+        shell: bash
+        run: |
+          set -euo pipefail
+          sudo -n python3 -B scripts/ci/history_fixed_parent_v2.py provision \
+            --owner "$GITHUB_RUN_ID.$GITHUB_RUN_ATTEMPT" \
+            --source "$GITHUB_WORKSPACE/config/systemd/trnmponpublic.slice" \
+            > "$OUT/fixed-parent-provision.json"
+          sudo -n systemctl show trnmponpublic.slice > "$OUT/fixed-parent-systemd-show.txt"
+      - name: Install the source-pinned compiler and fetch locked dependencies
+        id: toolchain
+        shell: bash
+        run: |
+          set -euo pipefail
+          rustup toolchain install 1.95.0 --profile minimal 2>&1 | tee "$OUT/toolchain-install.log"
+          rustc +1.95.0 -Vv > "$OUT/rustc-version.txt"
+          cargo +1.95.0 -Vv > "$OUT/cargo-version.txt"
+          cargo +1.95.0 fetch --locked --manifest-path trillionnium/Cargo.toml --target x86_64-unknown-linux-gnu 2>&1 | tee "$OUT/dependency-fetch.log"
+      - name: Prepare the exact original test runner without changing source
+        shell: bash
+        run: |
+          set -euo pipefail
+          cat > "$OUT/run-native-campaign.py" <<'PY'
+          """Execute the existing multiprocess test; this is not the W1 grid."""
+          from datetime import datetime, timezone
+          import json
+          import os
+          from pathlib import Path
+          import platform
+          import re
+          import shutil
+          import subprocess
+          import sys
+
+          root, out, target = (Path(value).resolve() for value in sys.argv[1:4])
+          cargo, expected_head, expected_tree = sys.argv[4:7]
+          sys.dont_write_bytecode = True
+          sys.path[:0] = [str(root / 'scripts'), str(root / 'scripts/ci')]
+          import run_pon_w1_native_campaign as bounds
+          import pon_public_v3_phase_read as phase_reader
+          import read_native_history_verifier as verifier_reader
+          from pon_public_v3_policy_read import load_profiles, policy_id
+          from verify_ci_source import verify
+
+          resource_profile = os.environ['HISTORY_RESOURCE_PROFILE']
+          bounds.require(resource_profile in (verifier_reader.STRICT_PROFILE, verifier_reader.GRAPH_PROFILE),
+                         'EXPLICIT_HISTORY_RESOURCE_PROFILE_REQUIRED')
+          selector = ('separate_process_graph_resource_fence_v1_work_and_signed_confirmation_campaign'
+                      if resource_profile == verifier_reader.GRAPH_PROFILE else
+                      'separate_process_work_and_signed_confirmation_campaign')
+          policy_vectors = load_profiles()
+          expected_public_policy = policy_id(policy_vectors, policy_vectors['current_revision'], 8, 2000)
+          result = {
+              'schema': ('pon-original-native-campaign-ci-v1' if resource_profile == verifier_reader.STRICT_PROFILE
+                         else 'pon-history-graph-resource-fence-campaign-ci-v1'),
+              'history_resource_profile': resource_profile, 'native_selector': selector,
+              'strict_profile_result_is_separate': True,
+              'source_kind': 'head', 'expected_head': expected_head,
+              'expected_tree': expected_tree, 'profile': 'release',
+              'toolchain': '1.95.0', 'state_backend': 'authenticated-v1',
+              'planned_complete_runs': 3, 'attempts': [],
+              'expected_public_policy_id': expected_public_policy,
+              'started_utc': datetime.now(timezone.utc).isoformat(),
+              'build_timeout_seconds': 1800,
+              'original_campaign_outer_timeout_seconds': 600,
+              'original_inputs': {'seed_transfers': 1024, 'seed_blocks': 4,
+                                  'business_blocks': 21, 'phase_seconds': 30,
+                                  'modes': ['baseline', 'from-zero', 'late-product'],
+                                  'attacker_processes': [0, 24, 24]},
+              'expected_resources': {'cpu_max': '400000 100000',
+                                     'memory_max': '17179869184', 'nice': 10},
+              'separate_verifier_limits': dict(verifier_reader.LIMITS),
+              'separate_verifier_parent': verifier_reader.PARENT,
+              'verifier_reader_sha256': bounds.sha(root / 'scripts/ci/read_native_history_verifier.py'),
+              'binary': None, 'source_after': None, 'complete_success': False,
+              'failure': None, 'finalization_failures': [],
+              'runner_sha256': bounds.sha(__file__),
+              'scope': 'same-host controlled loopback; no independent-operator, WAN, hardness, model-efficacy or activation qualification',
+          }
+          binary = None
+
+          def source_observation(name):
+              value = verify('head', expected_head, root=root)
+              bounds.require(value['tested_tree'] == expected_tree,
+                             'EXPECTED_TREE_CHANGED')
+              bounds.write_new(out / name, value)
+              return value
+
+          def resources(name):
+              value = bounds.resource_observation()
+              bounds.write_new(out / name, value)
+              bounds.validate_resources(value, 10)
+              return value
+
+          try:
+              bounds.require(platform.machine() == 'x86_64', 'NATIVE_X64_REQUIRED')
+              bounds.require(not out.is_relative_to(root)
+                             and not target.is_relative_to(root)
+                             and not out.is_relative_to(target)
+                             and not target.is_relative_to(out), 'ISOLATED_OUTPUT_REQUIRED')
+              bounds.validate_build_environment(os.environ)
+              source_observation('source-before-build.json')
+              outer_resources = resources('resource-before-build.json')
+              bounds.write_new(out / 'hardware.json', {
