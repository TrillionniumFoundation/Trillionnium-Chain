+        if &query[..4] == b"TCI1" {
+            return Some(response(b"TIS1", Some(&[0])));
+        }
+        let index = supplied_manifest
+            .chunks()
+            .iter()
+            .position(|chunk| chunk.sha256.as_slice() == &query[5..])
+            .unwrap();
+        Some(response(b"TCS1", Some(&supplied_chunks[index])))
+    });
