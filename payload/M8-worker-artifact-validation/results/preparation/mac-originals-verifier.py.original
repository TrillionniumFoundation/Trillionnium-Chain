inary-write.json\":\"{\\\"mode\\\":384,\\\"sha256\\\":\\\"ee394e73c1f244411b4ec2ff00a5811d9427bc91a11e73160fd2d3dae3c4e1e5\\\",\\\"size\\\":34275,\\\"version\\\":\\\"16777233:606970230:34275:1794653243569245822:1794653243569825861\\\",\\\"written\\\":34275}\",\"summary-rog-binary-read.json\":\"{\\\"chunk_sha256\\\":\\\"330006da0e4b92008c23fc547795839c5e4cc7a741cf2816e391ee5c175c47e4\\\",\\\"data_base64\\\":\\\"\\\",\\\"eof\\\":true,\\\"next_offset\\\":8584,\\\"offset\\\":0,\\\"path\\\":\\\"/home/qian-qi/chain-final-consolidation-20261114-root/closed-worker-artifact-ed0d35-package-v1/package-summary.json\\\",\\\"size\\\":8584,\\\"version\\\":\\\"66306:35035976:8584:1794653197085451925:1794653197085451925\\\"}\",\"summary-mac-binary-write.json\":\"{\\\"mode\\\":384,\\\"sha256\\\":\\\"330006da0e4b92008c23fc547795839c5e4cc7a741cf2816e391ee5c175c47e4\\\",\\\"size\\\":8584,\\\"version\\\":\\\"16777233:606970260:8584:1794653248073699485:1794653248074273525\\\",\\\"written\\\":8584}\"}}")
D=Path(cfg["root"]);CAP=32*1024*1024
def sha(b):return hashlib.sha256(b).hexdigest()
def read(p):
 p=Path(p);s=p.lstat();assert p.resolve()==p and stat.S_ISREG(s.st_mode) and s.st_nlink==1 and s.st_size<=CAP
 fd=os.open(p,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK|os.O_CLOEXEC)
 try:
  a=os.fstat(fd);chunks=[]
  while True:
   z=os.read(fd,65536)
   if not z:break
   chunks.append(z)
  after=os.fstat(fd)
 finally:os.close(fd)
 ident=lambda t:(t.st_dev,t.st_ino,t.st_mode,t.st_nlink,t.st_size,t.st_mtime_ns,t.st_ctime_ns)
 assert ident(s)==ident(a)==ident(after)==ident(p.lstat())
 b=b"".join(chunks);assert len(b)==s.st_size
 return b
def put(p,b):
 p.parent.mkdir(parents=True,mode=0o700,exist_ok=True)
 assert p.parent.resolve()==p.parent
 with p.open("xb") as f:f.write(b);f.flush();os.fsync(f.fileno())
 assert read(p)==b
 return {"path":str(p),"bytes":len(b),"sha256":sha(b)}
def jb(v):return (json.dumps(v,ensure_ascii=False,sort_keys=True,indent=2)+"\n").encode()
archive=D/"closed-worker-artifact-ed0d35-v1.zip"
raw=read(archive)
assert len(raw)==34275 and sha(raw)=="ee394e73c1f244411b4ec2ff00a5811d9427bc91a11e73160fd2d3dae3c4e1e5"
summary_raw=read(D/"rog-package-summary.json")
assert len(summary_raw)==8584 and sha(summary_raw)=="330006da0e4b92008c23fc547795839c5e4cc7a741cf2816e391ee5c175c47e4"
summary=json.loads(summary_raw);assert summary["status"]=="CLOSED_ORIGINALS_PACKAGED_AND_VERIFIED"
assert summary["original_file_count"]==30 and summary["original_bytes"]==31045 and summary["unexpected_original_paths_included"]==[]
assert summary["zip"]["bytes"]==len(raw) and summary["zip"]["sha256"]==sha(raw)
expected={x["path"]:x for x in summary["member_checks"]}
assert len(expected)==len(summary["member_checks"])==37
payload={}
with zipfile.ZipFile(io.BytesIO(raw)) as z:
 infos=z.infolist()
 assert len(infos)==37 and len(set(z.namelist()))==37 and z.testzip() is None
 assert set(z.namelist())==set(expected) and sum(i.file_size for i in infos)<=CAP
 for i in infos:
  name=i.filename;p=PurePosixPath(name)
  assert name==str(p) and not p.is_absolute() and all(q not in ("",".","..") for q in p.parts)
  assert "\\" not in name and all(ord(c)>=32 and ord(c)!=127 for c in name)
  assert not i.is_dir() and stat.S_ISREG(i.external_attr>>16)
  assert not any(str(parent) in expected for parent in p.parents if str(parent)!=".")
  b=z.read(i)
  e=expected[name]
  assert i.file_size==len(b)==e["bytes"] and sha(b)==e["sha256"] and i.CRC==e["crc32"]==(zlib.crc32(b)&0xffffffff)
  payload[name]=b
index_raw=payload["EVIDENCE_INDEX.json"]
assert len(index_raw)==13154 and sha(index_raw)=="8020afec5a53dfbb925b370dbaf40cebd3a7d42f9391dc9b85bd8cd7fa311781"
index=json.loads(index_raw);assert index["file_count"]==len(index["files"])==36
rows={r["path"]:r for r in index["files"]}
assert len(rows)==36 and set(rows)|{"EVIDENCE_INDEX.json"}==set(payload)
assert sum(r["bytes"] for r in rows.values())==index["total_bytes"]
for name,row in rows.items():
 assert set(row)=={"path","bytes","sha256","origin"} and set(row["origin"])=={"host","path"}
 assert row["origin"]["host"]=="rog" and Path(row["origin"]["path"]).is_absolute()
 assert row["bytes"]==len(payload[name]) and row["sha256"]==sha(payload[name])
originals={name[len("originals/"):]:b for name,b in payload.items() if name.startswith("originals/")}
assert len(originals)==30 and sum(map(len,originals.values()))==31045
orig_summary=json.loads(originals["summary.json"])
assert sha(originals["summary.json"])=="b8e6e86e08e40df85b2bdf6e7cc40ede94256075d1d7bd56047a2310b779c026"
assert orig_summary["status"]=="passed" and len(orig_summary["steps"])==12
for s in orig_summary["steps"]:
 assert type(s["exit"]) is int and s["exit"]==0 and s["owned_process_terminated"] is True and s["timed_out"] is False
 for channel in ("stdout","stderr"):
  name=Path(s[channel+"_path"]).name
  assert len(originals[name])==s[channel+"_bytes"] and sha(originals[name])==s[channel+"_sha256"]
for name in ("source-before.json","source-after.json","verify-source-before.stdout","verify-source-after.stdout"):
 assert len(originals[name])==423 and sha(originals[name])=="a74be5eb0131658ed16c8e1988806ffa8886a3a6580a6cca2c5a41a1ee88538d"
source=json.loads(originals["source-before.json"])
assert len(source)==11 and source["tested_commit"]=="ed0d35487f2a67239e4d646fd41c2c7acb5cc740" and source["tested_tree"]=="1aa9c21812489080980bdc3c1c2bb43611e88354"
outcomes=json.loads(originals["test-outcomes.json"])
assert sha(originals["test-outcomes.json"])=="73b8207addc525502bd49a23431d07d0203c9d260b44b78c82207a67fbe83c02"
assert outcomes["passed"]==10 and outcomes["failed"]==outcomes["ignored"]==outcomes["measured"]==0 and outcomes["unrelated_tests_filtered_out"]==373
names=outcomes["expected_names"];events=re.findall(r"^test ([A-Za-z0-9_:]+) \\.\\.\\. ok\\s*$",originals["worker-artifact-tests.stdout"].decode(),re.MULTILINE)
# Match the actual standard harness events without executing the original checker.
events=re.findall(r"^test ([A-Za-z0-9_:]+) \.\.\. ok\s*$",originals["worker-artifact-tests.stdout"].decode(),re.MULTILINE)
assert len(names)==len(set(names))==10 and collections.Counter(events)==collections.Counter(names)
assert outcomes["new_controls_executed"]==["audit::artifact::tests::validation_to_lock_permission_change_is_refused","audit::artifact::tests::validation_to_lock_hardlink_change_is_refused"]
assert sha(payload["driver/run_final_rog_worker_artifact_existing_source_v2.py.original"])=="491ce4a207e722f47ef2174690de83678cfc39b59b82db048f22fb95db17c95f"
assert payload["producer/package_closed_worker_artifact_ed0d35_v1.py.original"]==read(D/"preparation/package_closed_worker_artifact_ed0d35_v1.py")
P=D/"payload";P.mkdir(mode=0o700,exist_ok=False)
for name,b in sorted(payload.items()):put(P/name,b)
T=D/"transport";T.mkdir(mode=0o700,exist_ok=False)
for name,raw_receipt in sorted(cfg["receipts"].items()):put(T/name,raw_receipt.encode())
mapping=[]
for name,row in sorted(rows.items()):
 mapping.append({"path":"payload/"+name,"bytes":row["bytes"],"sha256":row["sha256"],"origin":row["origin"]})
mapping.append({"path":"payload/EVIDENCE_INDEX.json","bytes":len(index_raw),"sha256":sha(index_raw),
 "origin":{"host":"rog","path":summary["index"]["path"]}})
mapping.extend([
 {"path":"closed-worker-artifact-ed0d35-v1.zip","bytes":len(raw),"sha256":sha(raw),"origin":{"host":"rog","path":summary["zip"]["path"]}},
 {"path":"rog-package-summary.json","bytes":len(summary_raw),"sha256":sha(summary_raw),"origin":{"host":"rog","path":"/home/qian-qi/chain-final-consolidation-20261114-root/closed-worker-artifact-ed0d35-package-v1/package-summary.json"}}])
put(D/"original-origin-mapping.json",jb(mapping))
verification={"schema":"trnm-worker-artifact-M8-mac-copy-verification-v1","status":"ALL_ORIGINALS_AND_ZIP_MEMBERS_VERIFIED",
 "archive":{"path":str(archive),"bytes":len(raw),"sha256":sha(raw)},"source_original_files":30,"source_original_bytes":31045,
 "all_zip_members":37,"all_zip_crc_bytes_sha_verified":True,"all_actual_step_stream_hashes_verified":True,
 "actual_source_four_receipts_equal":True,"actual_head":source["tested_commit"],"actual_tree":source["tested_tree"],
 "actual_ten_named_tests_verified":True,"passed":10,"failed":0,"ignored":0,"measured":0,"unrelated_filtered":373,
 "new_controls":outcomes["new_controls_executed"],"actual_component_seconds":{x["label"]:x["elapsed_seconds"] for x in orig_summary["steps"] if x["label"] in ("workspace-format","worker-strict-clippy","worker-artifact-tests")},
 "rog_index":{"bytes":len(index_raw),"sha256":sha(index_raw)},"original_origins_preserved":True,"symlinks_specials_or_excluded_unknowns":False,
 "copy_protocol":"official h_binary_read full pinned chunk -> create-only h_binary_write -> full Mac CRC/size/SHA readback",
 "tests_driver_helpers_git_source_or_host_executed_during_copy":False,"stage_written":False,
 "qualification_scope":"Local worker component only. No claim of hosted or four-second/16-worker confirmation acceptance.",
 "preceding_repository_lane_line_in_pty":"Retained as original output; not independently requalified by this worker-copy verification."}
v=put(D/"verification.json",jb(verification))
readme="""# Closed M8 worker component originals

This directory preserves the completed local Linux worker artifact validation at head ed0d35487f2a67239e4d646fd41c2c7acb5cc740, tree 1aa9c21812489080980bdc3c1c2bb43611e88354.

The actual run has 12 zero-exit steps. Workspace fmt took 7.778 seconds, worker strict all-targets/all-features Clippy 9.080 seconds, and the full artifact module 9.433 seconds. All ten named tests passed, including both new validation_to_lock controls; none failed or was ignored/measured. The 373 filtered tests belong outside the chosen module.

ROG captured all 30 original result files (31045 bytes), the actual 19501-byte worker V2, complete packaging producer, original authoritative PTY bytes/receipt and closure/index. The 37-member ZIP passed whole-file and every member CRC/size/SHA on ROG. Official binary tools copied that exact 34275-byte ZIP and package summary to Mac with pinned source versions and create-only destinations. Mac independently repeated the full ZIP/member and original stream validation; original-origin-mapping.json preserves host/path.

All four 423-byte source identity receipts match the fixed M8 bytes. The selected worker artifact remains f021a33e2969305241099998f703172d29b15251. No test, original driver/helper, Git, Host command or benchmark was rerun to package or copy these results. No source/configuration or stage was written by this copy.

The result is a local worker component pass, not hosted or four-second/16-worker confirmation qualification. The original PTY's preceding-repository-lane statement is preserved without treating this component copy as a new full-lane verification.
"""
put(D/"README.md",readme.encode())
assert read(archive)==raw and read(D/"rog-package-summary.json")==summary_raw
print(json.dumps({"status":verification["status"],"verification":v,"payload_files":len(payload),"original_files":len(originals),"test_names":names,"stage_written":False},sort_keys=True))
