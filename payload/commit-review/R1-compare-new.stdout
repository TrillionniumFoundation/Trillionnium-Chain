/original/runtime-environment.stderr\",\n+      \"response\": {\n+        \"content\": [\n+          {\n+            \"text\": \"{\\\"mode\\\":384,\\\"sha256\\\":\\\"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\\\",\\\"size\\\":0,\\\"version\\\":\\\"16777233:606574901:0:1794641312347737983:1794641312348166815\\\",\\\"written\\\":0}\",\n+            \"type\": \"text\"\n+          }\n+        ],\n+        \"isError\": false,\n+        \"structuredContent\": null\n+      }\n+    },\n+    {\n+      \"name\": \"verify-source-before.stdout\",\n+      \"path\": \"/private/tmp/chain-architecture-7d8-repository-truth-failure-20261114-v1/original/verify-source-before.stdout\",\n+      \"response\": {\n+        \"content\": [\n+          {\n+            \"text\": \"{\\\"mode\\\":384,\\\"sha256\\\":\\\"bdad0a592def9d833fcd84a1e3e124cb86e829c7515b542fbbd5ea925e22cf9a\\\",\\\"size\\\":423,\\\"version\\\":\\\"16777233:606574916:423:1794641313414025900:1794641313414689356\\\",\\\"written\\\":423}\",\n+            \"type\": \"text\"\n+          }\n+        ],\n+        \"isError\": false,\n+        \"structuredContent\": null\n+      }\n+    },\n+    {\n+      \"name\": \"verify-source-before.stderr\",\n+      \"path\": \"/private/tmp/chain-architecture-7d8-repository-truth-failure-20261114-v1/original/verify-source-before.stderr\",\n+      \"response\": {\n+        \"content\": [\n+          {\n+            \"text\": \"{\\\"mode\\\":384,\\\"sha256\\\":\\\"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\\\",\\\"size\\\":0,\\\"version\\\":\\\"16777233:606574970:0:1794641316951458491:1794641316951885156\\\",\\\"written\\\":0}\",\n+            \"type\": \"text\"\n+          }\n+        ],\n+        \"isError\": false,\n+        \"structuredContent\": null\n+      }\n+    },\n+    {\n+      \"name\": \"repository-truth.stdout\",\n+      \"path\": \"/private/tmp/chain-architecture-7d8-repository-truth-failure-20261114-v1/original/repository-truth.stdout\",\n+      \"response\": {\n+        \"content\": [\n+          {\n+            \"text\": \"{\\\"mode\\\":384,\\\"sha256\\\":\\\"6e8beb43b947c67e5ef4abd3f6216ca4854b3c5ffd21eb68ad8a4f9e26d59705\\\",\\\"size\\\":291195,\\\"version\\\":\\\"16777233:606575028:291195:1794641323210725782:1794641323211246447\\\",\\\"written\\\":291195}\",\n+            \"type\": \"text\"\n+          }\n+        ],\n+        \"isError\": false,\n+        \"structuredContent\": null\n+      }\n+    },\n+    {\n+      \"name\": \"repository-truth.stderr\",\n+      \"path\": \"/private/tmp/chain-architecture-7d8-repository-truth-failure-20261114-v1/original/repository-truth.stderr\",\n+      \"response\": {\n+        \"content\": [\n+          {\n+            \"text\": \"{\\\"mode\\\":384,\\\"sha256\\\":\\\"c4772c3a2d25718139f4199171eb432c3b7aff578a75290101d922584812f2ea\\\",\\\"size\\\":67670,\\\"version\\\":\\\"16777233:606575069:67670:1794641325422775043:1794641325423371333\\\",\\\"written\\\":67670}\",\n+            \"type\": \"text\"\n+          }\n+        ],\n+        \"isError\": false,\n+        \"structuredContent\": null\n+      }\n+    },\n+    {\n+      \"name\": \"verify-source-after.stdout\",\n+      \"path\": \"/private/tmp/chain-architecture-7d8-repository-truth-failure-20261114-v1/original/verify-source-after.stdout\",\n+      \"response\": {\n+        \"content\": [\n+          {\n+            \"text\": \"{\\\"mode\\\":384,\\\"sha256\\\":\\\"bdad0a592def9d833fcd84a1e3e124cb86e829c7515b542fbbd5ea925e22cf9a\\\",\\\"size\\\":423,\\\"version\\\":\\\"16777233:606575085:423:1794641326446069447:1794641326446807069\\\",\\\"written\\\":423}\",\n+            \"type\": \"text\"\n+          }\n+        ],\n+        \"isError\": false,\n+        \"structuredContent\": null\n+      }\n+    },\n+    {\n+      \"name\": \"verify-source-after.stderr\",\n+      \"path\": \"/private/tmp/chain-architecture-7d8-repository-truth-failure-20261114-v1/original/verify-source-after.stderr\",\n+      \"response\": {\n+        \"content\": [\n+          {\n+            \"text\": \"{\\\"mode\\\":384,\\\"sha256\\\":\\\"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\\\",\\\"size\\\":0,\\\"version\\\":\\\"16777233:606575128:0:1794641327704811014:1794641327705390886\\\",\\\"written\\\":0}\",\n+            \"type\": \"text\"\n+          }\n+        ],\n+        \"isError\": false,\n+        \"structuredContent\": null\n+      }\n+    },\n+    {\n+      \"name\": \"summary.json\",\n+      \"path\": \"/private/tmp/chain-architecture-7d8-repository-truth-failure-20261114-v1/original/summary.json\",\n+      \"response\": {\n+        \"content\": [\n+          {\n+            \"text\": \"{\\\"mode\\\":384,\\\"sha256\\\":\\\"79d37af0ecec1749098bdfd1cfc7127de2cf9aa928b7271ca4ef8de39cd4061b\\\",\\\"size\\\":21481,\\\"version\\\":\\\"16777233:606575154:21481:1794641328924973426:1794641328925524424\\\",\\\"written\\\":21481}\",\n+            \"type\": \"text\"\n+          }\n+        ],\n+        \"isError\": false,\n+        \"structuredContent\": null\n+      }\n+    },\n+    {\n+      \"name\": \"source-before.json\",\n+      \"path\": \"/private/tmp/chain-architecture-7d8-repository-truth-failure-20261114-v1/original/source-before.json\",\n+      \"response\": {\n+        \"content\": [\n+          {\n+            \"text\": \"{\\\"mode\\\":384,\\\"sha256\\\":\\\"bdad0a592def9d833fcd84a1e3e124cb86e829c7515b542fbbd5ea925e22cf9a\\\",\\\"size\\\":423,\\\"version\\\":\\\"16777233:606575178:423:1794641329919694431:1794641329920266179\\\",\\\"written\\\":423}\",\n+            \"type\": \"text\"\n+          }\n+        ],\n+        \"isError\": false,\n+        \"structuredContent\": null\n+      }\n+    },\n+    {\n+      \"name\": \"source-after.json\",\n+      \"path\": \"/private/tmp/chain-architecture-7d8-repository-truth-failure-20261114-v1/original/source-after.json\",\n+      \"response\": {\n+        \"content\": [\n+          {\n+            \"text\": \"{\\\"mode\\\":384,\\\"sha256\\\":\\\"bdad0a592def9d833fcd84a1e3e124cb86e829c7515b542fbbd5ea925e22cf9a\\\",\\\"size\\\":423,\\\"version\\\":\\\"16777233:606575190:423:1794641330819518149:1794641330820179855\\\",\\\"written\\\":423}\",\n+            \"type\": \"text\"\n+          }\n+        ],\n+        \"isError\": false,\n+        \"structuredContent\": null\n+      }\n+    }\n+  ]\n+}"},{"sha":"275538b69aeed4bd00fd8197336b866e4e076f7a","filename":"scripts/ci/test_pq_authority_effect_register.py","status":"modified","additions":1,"deletions":0,"changes":1,"blob_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/blob/5df7ae6f482157c5f7fdcbcd52222117a965053f/scripts%2Fci%2Ftest_pq_authority_effect_register.py","raw_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/raw/5df7ae6f482157c5f7fdcbcd52222117a965053f/scripts%2Fci%2Ftest_pq_authority_effect_register.py","contents_url":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/contents/scripts%2Fci%2Ftest_pq_authority_effect_register.py?ref=5df7ae6f482157c5f7fdcbcd52222117a965053f","patch":"@@ -152,6 +152,7 @@ def test_other_real_settlement_module_is_not_this_bilateral_owner(self):\n \n     def test_source_revision_schema_purpose_and_route_context_drift_refuse(self):\n         for field, value in (('source_revision', '0' * 40),\n+                             ('source_revision', 'fc39da5f35298ce8a4c34aa5bdb25849648612f9'),\n                              ('source_revision', '332d7f723d71707d88a2cffa52b3754579a46926'),\n                              ('source_revision', 'c82c6eabe8f27e2b918de850d237f6b0b06444bb'),\n                              ('source_revision', '57b069ae1e7ed32ff95e4f2a18a74d5eadcda550'),"},{"sha":"530169ab9de7079958ada8f2f4d66702ea54cca0","filename":"scripts/test_w1_owned_process_collector_v1.py","status":"modified","additions":38,"deletions":1,"changes":39,"blob_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/blob/5df7ae6f482157c5f7fdcbcd52222117a965053f/scripts%2Ftest_w1_owned_process_collector_v1.py","raw_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/raw/5df7ae6f482157c5f7fdcbcd52222117a965053f/scripts%2Ftest_w1_owned_process_collector_v1.py","contents_url":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/contents/scripts%2Ftest_w1_owned_process_collector_v1.py?ref=5df7ae6f482157c5f7fdcbcd52222117a965053f","patch":"@@ -303,7 +303,44 @@ def test_actual_post_fork_identity_failure_reaps_gated_root_without_exec(self):\n         self.assertFalse(marker.exists())\n         self.assertEqual(result[\"result\"][\"final_echild\"][\"errno\"], 10)\n         self.assertEqual(len(result[\"result\"][\"wait4_records\"]), 1)\n-        self.assertEqual(result[\"result\"][\"root_returncode\"], 125)\n+        record = result[\"result\"]\n+        row = record[\"wait4_records\"][0]\n+        self.assertEqual(record[\"cause\"], \"launch-error\")\n+        self.assertEqual(record[\"error\"], \"OSError: actual post-fork proc read fault control\")\n+        self.assertFalse(record[\"records_truncated\"])\n+        self.assertTrue(collector.same_identity(row[\"identity_before_reap\"], record[\"root_identity\"]))\n+        self.assertEqual(row[\"identity_before_reap\"][\"parent\"], record[\"collector_identity\"][\"pid\"])\n+        self.assertEqual(row[\"returncode\"], record[\"root_returncode\"])\n+        status = row[\"wait4_status\"]\n+        self.assertEqual(os.waitstatus_to_exitcode(status), record[\"root_returncode\"])\n+        events = [json.loads(line) for line in (out / \"events.jsonl\").read_text().splitlines()]\n+        self.assertFalse(any(event[\"kind\"] == \"root-exec-released\" for event in events))\n+        self.assertFalse(any(event[\"kind\"] == \"signal\"\n+                             and event[\"value\"][\"signal\"] == signal.SIGTERM\n+                             and collector.same_identity(event[\"value\"][\"identity\"], record[\"root_identity\"])\n+                             for event in events))\n+        cleanup = [event for event in events\n+                   if event[\"kind\"] == \"cleanup-started\" and event[\"value\"][\"cause\"] == \"launch-error\"]\n+        self.assertEqual(len(cleanup), 1)\n+        if os.WIFEXITED(status):\n+            self.assertEqual(os.WEXITSTATUS(status), 125)\n+            self.assertEqual(row[\"waitid_si_code\"], os.CLD_EXITED)\n+            self.assertEqual(row[\"waitid_si_status\"], 125)\n+        else:\n+            self.assertTrue(os.WIFSIGNALED(status))\n+            signum = os.WTERMSIG(status)\n+            self.assertEqual(signum, signal.SIGKILL)\n+            self.assertEqual(row[\"returncode\"], -signum)\n+            self.assertEqual(row[\"waitid_si_code\"], os.CLD_KILLED)\n+            self.assertEqual(row[\"waitid_si_status\"], signum)\n+            sent = [event for event in events\n+                    if event[\"kind\"] == \"signal\"\n+                    and event[\"value\"][\"signal\"] == signum\n+                    and event[\"value\"][\"outcome\"] == \"sent\"\n+                    and collector.same_identity(event[\"value\"][\"identity\"], record[\"root_identity\"])]\n+            self.assertTrue(sent, \"the recorded root signal must come from this collector's cleanup\")\n+            self.assertTrue(any(cleanup[0][\"monotonic_ns\"] <= event[\"monotonic_ns\"]\n+                                <= row[\"reaped_monotonic_ns\"] for event in sent))\n         self.assertFalse(result[\"result\"][\"root_exec_released\"])\n         self.assertFalse(result[\"command_success\"])\n         self.assertFalse(result[\"collector_wait_domain_reaped\"])"},{"sha":"3a9fbe26283920a77ae4883a46153440abbe7e12","filename":"trillionnium/crates/trnm-pon-node/src/ingress/public_v2.rs","status":"modified","additions":98,"deletions":0,"changes":98,"blob_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/blob/5df7ae6f482157c5f7fdcbcd52222117a965053f/trillionnium%2Fcrates%2Ftrnm-pon-node%2Fsrc%2Fingress%2Fpublic_v2.rs","raw_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/raw/5df7ae6f482157c5f7fdcbcd52222117a965053f/trillionnium%2Fcrates%2Ftrnm-pon-node%2Fsrc%2Fingress%2Fpublic_v2.rs","contents_url":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/contents/trillionnium%2Fcrates%2Ftrnm-pon-node%2Fsrc%2Fingress%2Fpublic_v2.rs?ref=5df7ae6f482157c5f7fdcbcd52222117a965053f","patch":"@@ -1540,6 +1540,10 @@ pub fn call_public_protected_v2_with_deadline(\n     )?;\n     verify_hex_strict(pinned_server, &r.message()?, &r.signature)\n         .map_err(|_| \"PUBLIC_RESPONSE_SIGNATURE\")?;\n+    #[cfg(test)]\n+    tests::before_client_return(total_deadline);\n+    // Response decoding and signature verification spend the original call time too.\n+    ensure(Instant::now() < total_deadline, \"PUBLIC_CLIENT_DEADLINE\")?;\n     Ok(PublicReply {\n         ok: r.ok,\n         value: r.value,\n@@ -1580,6 +1584,100 @@ fn client_write(stream: &mut TcpStream, mut bytes: &[u8], deadline: Instant) ->\n #[cfg(test)]\n mod tests {\n     use super::*;\n+\n+    std::thread_local! {\n+        static EXPIRE_AFTER_CLIENT_VERIFY: std::cell::Cell<bool> = const { std::cell::Cell::new(false) };\n+        static CLIENT_VERIFY_OBSERVED: std::cell::Cell<bool> = const { std::cell::Cell::new(false) };\n+    }\n+\n+    pub(super) fn before_client_return(deadline: Instant) {\n+        if EXPIRE_AFTER_CLIENT_VERIFY.with(|armed| armed.replace(false)) {\n+            CLIENT_VERIFY_OBSERVED.with(|observed| observed.set(true));\n+            while let Some(remaining) = deadline.checked_duration_since(Instant::now()) {\n+                if remaining.is_zero() {\n+                    break;\n+                }\n+                thread::sleep(remaining);\n+            }\n+        }\n+    }\n+\n+    #[test]\n+    fn original_v2_client_rejects_expiry_after_signed_response_verification() {\n+        let directory = tempfile::tempdir().unwrap();\n+        let settings = Settings::development(Some(super::super::now().unwrap() - 100)).unwrap();\n+        let node = Node::open(directory.path(), settings.clone(), 2).unwrap();\n+        let listener = TcpListener::bind(\"127.0.0.1:0\").unwrap();\n+        let address = listener.local_addr().unwrap();\n+        let stop = Arc::new(AtomicBool::new(false));\n+        let signal = stop.clone();\n+        let worker = thread::spawn(move || {\n+            serve_public_protected_v2(listener, node, Duration::from_secs(5), signal, server())\n+        });\n+        let policy = PublicPolicy::new(8, Duration::from_secs(2)).unwrap();\n+        let on_time = call_public_protected_v2(\n+            address,\n+            &Request::Head,\n+            &settings,\n+            identity(71).public_key(),\n+            &identity(72),\n+            policy,\n+        );\n+\n+        // Let the real signed response pass every context/signature check.\n+        // Expire the same caller deadline only at the final return boundary.\n+        CLIENT_VERIFY_OBSERVED.with(|observed| observed.set(false));\n+        EXPIRE_AFTER_CLIENT_VERIFY.with(|armed| armed.set(true));\n+        let late = call_public_protected_v2_with_deadline(\n+            address,\n+            &Request::Head,\n+            &settings,\n+            identity(71).public_key(),\n+            &identity(72),\n+            policy,\n+            Some(Instant::now() + Duration::from_secs(2)),\n+        );\n+        EXPIRE_AFTER_CLIENT_VERIFY.with(|armed| armed.set(false));\n+        let verified = CLIENT_VERIFY_OBSERVED.with(|observed| observed.replace(false));\n+        stop.store(true, Ordering::Release);\n+        let metrics = worker.join().unwrap().unwrap();\n+\n+        let on_time = on_time.unwrap();\n+        assert!(on_time.ok);\n+        assert_eq!(on_time.value[\"height\"], 0);\n+        assert!(\n+            verified,\n+            \"the actual signed response must reach the final boundary\"\n+        );\n+        assert_eq!(metrics.completed_read, 2);\n+        assert!(\n+            late.is_err(),\n+            \"signed response completed after the original client deadline\"\n+        );\n+        assert_eq!(late.unwrap_err().to_string(), \"PUBLIC_CLIENT_DEADLINE\");\n+    }\n+\n+    #[test]\n+    fn expired_v2_client_deadline_refuses_before_tcp() {\n+        let listener = TcpListener::bind(\"127.0.0.1:0\").unwrap();\n+        listener.set_nonblocking(true).unwrap();\n+        let settings = Settings::development(Some(super::super::now().unwrap() - 100)).unwrap();\n+        let error = call_public_protected_v2_with_deadline(\n+            listener.local_addr().unwrap(),\n+            &Request::Head,\n+            &settings,\n+            identity(71).public_key(),\n+            &identity(72),\n+            PublicPolicy::development(),\n+            Some(Instant::now()),\n+        )\n+        .unwrap_err();\n+        assert_eq!(error.to_string(), \"PUBLIC_CLIENT_DEADLINE\");\n+        assert_eq!(\n+            listener.accept().unwrap_err().kind(),\n+            std::io::ErrorKind::WouldBlock\n+        );\n+    }\n     fn identity(n: u8) -> DevelopmentIdentity {\n         DevelopmentIdentity::from_secret_hex(&hex::encode([n; 32])).unwrap()\n     }"}]}