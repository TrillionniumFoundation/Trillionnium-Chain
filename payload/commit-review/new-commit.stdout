82157c5f7fdcbcd52222117a965053f","patch":"@@ -0,0 +1,24 @@\n+{\n+  \"schema\": \"trnm-M4-project-preflight-before-edit-v1\",\n+  \"argv\": [\n+    \"bash\",\n+    \"scripts/project-preflight.sh\"\n+  ],\n+  \"returncode\": 1,\n+  \"worktree\": \"/private/tmp/chain-M4-owned-process-collector-20261114\",\n+  \"head\": \"1a7afcdb820b051d1e4bfde3d436f96fc050c487\",\n+  \"nested_agents\": [],\n+  \"files\": [\n+    {\n+      \"path\": \"/private/tmp/chain-M4-owned-process-collector-review-20261114-v1/project-preflight-before-edit-v1/stdout\",\n+      \"bytes\": 0,\n+      \"sha256\": \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\"\n+    },\n+    {\n+      \"path\": \"/private/tmp/chain-M4-owned-process-collector-review-20261114-v1/project-preflight-before-edit-v1/stderr\",\n+      \"bytes\": 253,\n+      \"sha256\": \"7aba2ef6719a8e581c9042bb0116e857656e02a73790192ddd4fc0d3f96bf2b9\"\n+    }\n+  ],\n+  \"finished_at\": \"2026-11-14T08:40:23.457099+00:00\"\n+}"},{"sha":"b309b1f4ca0b8e22afe35aa1b36e2f300142f6df","filename":"docs/audit/20261114-m4-closed-exec-gate/preflight-before-edit.stderr.raw","status":"added","additions":4,"deletions":0,"changes":4,"blob_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/blob/5df7ae6f482157c5f7fdcbcd52222117a965053f/docs%2Faudit%2F20261114-m4-closed-exec-gate%2Fpreflight-before-edit.stderr.raw","raw_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/raw/5df7ae6f482157c5f7fdcbcd52222117a965053f/docs%2Faudit%2F20261114-m4-closed-exec-gate%2Fpreflight-before-edit.stderr.raw","contents_url":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/contents/docs%2Faudit%2F20261114-m4-closed-exec-gate%2Fpreflight-before-edit.stderr.raw?ref=5df7ae6f482157c5f7fdcbcd52222117a965053f","patch":"@@ -0,0 +1,4 @@\n+Traceback (most recent call last):\n+  File \"/private/tmp/chain-M4-owned-process-collector-20261114/scripts/ci/project_boundary.py\", line 3, in <module>\n+    import json, pathlib, re, subprocess, sys, tomllib\n+ModuleNotFoundError: No module named 'tomllib'"},{"sha":"e69de29bb2d1d6434b8b29ae775ad8c2e48c5391","filename":"docs/audit/20261114-m4-closed-exec-gate/preflight-correct-python.stderr.raw","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/blob/5df7ae6f482157c5f7fdcbcd52222117a965053f/docs%2Faudit%2F20261114-m4-closed-exec-gate%2Fpreflight-correct-python.stderr.raw","raw_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/raw/5df7ae6f482157c5f7fdcbcd52222117a965053f/docs%2Faudit%2F20261114-m4-closed-exec-gate%2Fpreflight-correct-python.stderr.raw","contents_url":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/contents/docs%2Faudit%2F20261114-m4-closed-exec-gate%2Fpreflight-correct-python.stderr.raw?ref=5df7ae6f482157c5f7fdcbcd52222117a965053f"},{"sha":"d9940adab04544781ac3f60ca4e342f2b36adc58","filename":"docs/audit/20261114-m4-closed-exec-gate/preflight-correct-python.stdout.raw","status":"added","additions":1,"deletions":0,"changes":1,"blob_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/blob/5df7ae6f482157c5f7fdcbcd52222117a965053f/docs%2Faudit%2F20261114-m4-closed-exec-gate%2Fpreflight-correct-python.stdout.raw","raw_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/raw/5df7ae6f482157c5f7fdcbcd52222117a965053f/docs%2Faudit%2F20261114-m4-closed-exec-gate%2Fpreflight-correct-python.stdout.raw","contents_url":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/contents/docs%2Faudit%2F20261114-m4-closed-exec-gate%2Fpreflight-correct-python.stdout.raw?ref=5df7ae6f482157c5f7fdcbcd52222117a965053f","patch":"@@ -0,0 +1 @@\n+{\"result\": \"PASS\", \"mode\": \"--dev\", \"project\": \"trillionnium-chain\", \"packages\": 26, \"branch\": \"fix/chain-m4-closed-exec-gate-20261114\", \"remote_policy_mutated\": false}"},{"sha":"c0d016f9c302f98c23c46216e7a57e3eb6b10990","filename":"docs/audit/20261114-m4-closed-exec-gate/source-and-tests-current.patch.json","status":"added","additions":6,"deletions":0,"changes":6,"blob_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/blob/5df7ae6f482157c5f7fdcbcd52222117a965053f/docs%2Faudit%2F20261114-m4-closed-exec-gate%2Fsource-and-tests-current.patch.json","raw_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/raw/5df7ae6f482157c5f7fdcbcd52222117a965053f/docs%2Faudit%2F20261114-m4-closed-exec-gate%2Fsource-and-tests-current.patch.json","contents_url":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/contents/docs%2Faudit%2F20261114-m4-closed-exec-gate%2Fsource-and-tests-current.patch.json?ref=5df7ae6f482157c5f7fdcbcd52222117a965053f","patch":"@@ -0,0 +1,6 @@\n+{\n+  \"schema\": \"trnm-exact-patch-json-carrier-v1\",\n+  \"original_bytes\": 6467,\n+  \"original_sha256\": \"2dd93726b371e584947a4af909d6b2895f88828c207d41d4a60638afbfd96dbf\",\n+  \"patch\": \"diff --git a/scripts/test_w1_owned_process_collector_v1.py b/scripts/test_w1_owned_process_collector_v1.py\\nindex 15072e49434166d0d286a710cd3ef4e0f0a71776..0c683b183d64d71e8ae6c6f44dca857b4f6e77b3 100644\\n--- a/scripts/test_w1_owned_process_collector_v1.py\\n+++ b/scripts/test_w1_owned_process_collector_v1.py\\n@@ -14,7 +14,9 @@ import subprocess\\n import sys\\n import tempfile\\n import time\\n+import types\\n import unittest\\n+from unittest import mock\\n \\n import w1_owned_process_collector_v1 as collector\\n \\n@@ -394,5 +396,74 @@ else:\\n         self.assertFalse(row[\\\"result\\\"][\\\"can_authorize_payment\\\"])\\n \\n \\n+class ClosedExecGateSignalControls(unittest.TestCase):\\n+    \\\"\\\"\\\"Deterministic signal ordering; actual fork/wait4 controls remain above.\\\"\\\"\\\"\\n+\\n+    def closed_gate_collector(self, *, grace=2, released=False, closed=True):\\n+        value = collector.Collector.__new__(collector.Collector)\\n+        value.args = types.SimpleNamespace(cleanup_grace_seconds=grace)\\n+        value.cleanup_started = 1_000_000_000\\n+        value.root_pid = 101\\n+        value.root_exec_released = released\\n+        value.root_exec_gate_closed = closed\\n+        value.root_returncode = None\\n+        value.owned = {\\n+            (101, 11): {\\\"identity\\\": {\\\"pid\\\": 101}, \\\"pidfd\\\": 51, \\\"signals\\\": set()},\\n+            (102, 12): {\\\"identity\\\": {\\\"pid\\\": 102}, \\\"pidfd\\\": 52, \\\"signals\\\": set()},\\n+        }\\n+        value.events = []\\n+        value.emit = lambda kind, item: value.events.append((kind, item))\\n+        return value\\n+\\n+    def test_closed_unreleased_gate_defers_term_without_extending_original_kill_threshold(self):\\n+        for grace, threshold in ((2, 250_000_000), (.1, 50_000_000)):\\n+            with self.subTest(cleanup_grace_seconds=grace):\\n+                value = self.closed_gate_collector(grace=grace)\\n+                with mock.patch.object(collector.time, \\\"monotonic_ns\\\") as clock, \\\\\\n+                        mock.patch.object(collector.signal, \\\"pidfd_send_signal\\\", create=True) as send:\\n+                    # Force cleanup to run before the gated root consumes EOF.\\n+                    # The descendant is not covered by the root's exec gate.\\n+                    for elapsed in (0, threshold - 1):\\n+                        clock.return_value = value.cleanup_started + elapsed\\n+                        value.signal_owned()\\n+                    self.assertEqual(send.call_args_list, [mock.call(52, signal.SIGTERM)])\\n+                    self.assertEqual(value.owned[(101, 11)][\\\"signals\\\"], set())\\n+                    self.assertIsNone(value.root_returncode)\\n+\\n+                    # The exact original escalation boundary must still kill\\n+                    # both identities if no terminal wait record has arrived.\\n+                    clock.return_value = value.cleanup_started + threshold\\n+                    value.signal_owned()\\n+                    self.assertEqual(send.call_args_list, [\\n+                        mock.call(52, signal.SIGTERM),\\n+                        mock.call(51, signal.SIGKILL),\\n+                        mock.call(52, signal.SIGKILL),\\n+                    ])\\n+                    self.assertEqual(value.owned[(101, 11)][\\\"signals\\\"], {signal.SIGKILL})\\n+                    self.assertEqual(value.owned[(102, 12)][\\\"signals\\\"], {signal.SIGTERM, signal.SIGKILL})\\n+                    self.assertIsNone(value.root_returncode)\\n+                    clock.return_value += 1\\n+                    value.signal_owned()\\n+                    self.assertEqual(send.call_count, 3)\\n+                self.assertEqual([event[1][\\\"signal\\\"] for event in value.events],\\n+                                 [signal.SIGTERM, signal.SIGKILL, signal.SIGKILL])\\n+\\n+    def test_released_root_or_unconfirmed_gate_keeps_original_term_cleanup(self):\\n+        for released, closed in ((True, True), (False, False), (True, False)):\\n+            with self.subTest(root_exec_released=released, root_exec_gate_closed=closed):\\n+                value = self.closed_gate_collector(released=released, closed=closed)\\n+                with mock.patch.object(collector.time, \\\"monotonic_ns\\\",\\n+                                       return_value=value.cleanup_started), \\\\\\n+                        mock.patch.object(collector.signal, \\\"pidfd_send_signal\\\", create=True) as send:\\n+                    value.signal_owned()\\n+                    self.assertEqual(send.call_args_list, [\\n+                        mock.call(51, signal.SIGTERM), mock.call(52, signal.SIGTERM)])\\n+                    value.signal_owned()\\n+                    self.assertEqual(send.call_count, 2)\\n+                self.assertIsNone(value.root_returncode)\\n+                self.assertEqual([event[1][\\\"signal\\\"] for event in value.events],\\n+                                 [signal.SIGTERM, signal.SIGTERM])\\n+\\n+\\n if __name__ == \\\"__main__\\\":\\n     unittest.main()\\ndiff --git a/scripts/w1_owned_process_collector_v1.py b/scripts/w1_owned_process_collector_v1.py\\nindex eaa24403674c9b5448d49187f0d2d0ade6bc9127..7049001ace23192d6d32e4f438ca85e4b0ac16cc 100644\\n--- a/scripts/w1_owned_process_collector_v1.py\\n+++ b/scripts/w1_owned_process_collector_v1.py\\n@@ -213,6 +213,7 @@ class Collector:\\n         self.root_pid = None\\n         self.root_returncode = None\\n         self.root_exec_released = False\\n+        self.root_exec_gate_closed = False\\n         self.echild = None\\n         self.records_truncated = False\\n         self.events_count = 0\\n@@ -394,6 +395,13 @@ class Collector:\\n         elapsed = time.monotonic_ns() - self.cleanup_started\\n         sig = signal.SIGKILL if elapsed >= min(250_000_000, int(self.args.cleanup_grace_seconds * 500_000_000)) else signal.SIGTERM\\n         for item in list(self.owned.values()):\\n+            # A closed, never-released exec gate already tells this root to exit\\n+            # with 125. Do not race that refusal with TERM before it can read\\n+            # EOF. The original KILL escalation and total cleanup bound remain.\\n+            if (sig == signal.SIGTERM and self.root_exec_gate_closed\\n+                    and not self.root_exec_released\\n+                    and item[\\\"identity\\\"][\\\"pid\\\"] == self.root_pid):\\n+                continue\\n             if sig in item[\\\"signals\\\"]:\\n                 continue\\n             item[\\\"signals\\\"].add(sig)\\n@@ -507,6 +515,7 @@ class Collector:\\n                 self.emit(\\\"root-exec-released\\\", {\\\"identity\\\": self.root})\\n         finally:\\n             os.close(gate_writer)\\n+            self.root_exec_gate_closed = True\\n \\n     def loop(self):\\n         while True:\\n\"\n+}"},{"sha":"6799a53ea1b04a82f901870f322582386f0c0a08","filename":"docs/audit/20261114-m4-closed-exec-gate/source-and-tests-initial.patch.json","status":"added","additions":6,"deletions":0,"changes":6,"blob_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/blob/5df7ae6f482157c5f7fdcbcd52222117a965053f/docs%2Faudit%2F20261114-m4-closed-exec-gate%2Fsource-and-tests-initial.patch.json","raw_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/raw/5df7ae6f482157c5f7fdcbcd52222117a965053f/docs%2Faudit%2F20261114-m4-closed-exec-gate%2Fsource-and-tests-initial.patch.json","contents_url":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/contents/docs%2Faudit%2F20261114-m4-closed-exec-gate%2Fsource-and-tests-initial.patch.json?ref=5df7ae6f482157c5f7fdcbcd52222117a965053f","patch":"@@ -0,0 +1,6 @@\n+{\n+  \"schema\": \"trnm-exact-patch-json-carrier-v1\",\n+  \"original_bytes\": 6317,\n+  \"original_sha256\": \"a8c3d5ecbf2b563efde4ac4bb535309e9657145e59c45c3957ca2ecf7e131b91\",\n+  \"patch\": \"diff --git a/scripts/test_w1_owned_process_collector_v1.py b/scripts/test_w1_owned_process_collector_v1.py\\nindex 15072e494..0593d08df 100644\\n--- a/scripts/test_w1_owned_process_collector_v1.py\\n+++ b/scripts/test_w1_owned_process_collector_v1.py\\n@@ -14,7 +14,9 @@ import subprocess\\n import sys\\n import tempfile\\n import time\\n+import types\\n import unittest\\n+from unittest import mock\\n \\n import w1_owned_process_collector_v1 as collector\\n \\n@@ -394,5 +396,74 @@ else:\\n         self.assertFalse(row[\\\"result\\\"][\\\"can_authorize_payment\\\"])\\n \\n \\n+class ClosedExecGateSignalControls(unittest.TestCase):\\n+    \\\"\\\"\\\"Deterministic signal ordering; actual fork/wait4 controls remain above.\\\"\\\"\\\"\\n+\\n+    def closed_gate_collector(self, *, grace=2, released=False, closed=True):\\n+        value = collector.Collector.__new__(collector.Collector)\\n+        value.args = types.SimpleNamespace(cleanup_grace_seconds=grace)\\n+        value.cleanup_started = 1_000_000_000\\n+        value.root_pid = 101\\n+        value.root_exec_released = released\\n+        value.root_exec_gate_closed = closed\\n+        value.root_returncode = None\\n+        value.owned = {\\n+            (101, 11): {\\\"identity\\\": {\\\"pid\\\": 101}, \\\"pidfd\\\": 51, \\\"signals\\\": set()},\\n+            (102, 12): {\\\"identity\\\": {\\\"pid\\\": 102}, \\\"pidfd\\\": 52, \\\"signals\\\": set()},\\n+        }\\n+        value.events = []\\n+        value.emit = lambda kind, item: value.events.append((kind, item))\\n+        return value\\n+\\n+    def test_closed_unreleased_gate_defers_term_without_extending_original_kill_threshold(self):\\n+        for grace, threshold in ((2, 250_000_000), (.1, 50_000_000)):\\n+            with self.subTest(cleanup_grace_seconds=grace):\\n+                value = self.closed_gate_collector(grace=grace)\\n+                with mock.patch.object(collector.time, \\\"monotonic_ns\\\") as clock, \\\\\\n+                        mock.patch.object(collector.signal, \\\"pidfd_send_signal\\\") as send:\\n+                    # Force cleanup to run before the gated root consumes EOF.\\n+                    # The descendant is not covered by the root's exec gate.\\n+                    for elapsed in (0, threshold - 1):\\n+                        clock.return_value = value.cleanup_started + elapsed\\n+                        value.signal_owned()\\n+                    self.assertEqual(send.call_args_list, [mock.call(52, signal.SIGTERM)])\\n+                    self.assertEqual(value.owned[(101, 11)][\\\"signals\\\"], set())\\n+                    self.assertIsNone(value.root_returncode)\\n+\\n+                    # The exact original escalation boundary must still kill\\n+                    # both identities if no terminal wait record has arrived.\\n+                    clock.return_value = value.cleanup_started + threshold\\n+                    value.signal_owned()\\n+                    self.assertEqual(send.call_args_list, [\\n+                        mock.call(52, signal.SIGTERM),\\n+                        mock.call(51, signal.SIGKILL),\\n+                        mock.call(52, signal.SIGKILL),\\n+                    ])\\n+                    self.assertEqual(value.owned[(101, 11)][\\\"signals\\\"], {signal.SIGKILL})\\n+                    self.assertEqual(value.owned[(102, 12)][\\\"signals\\\"], {signal.SIGTERM, signal.SIGKILL})\\n+                    self.assertIsNone(value.root_returncode)\\n+                    clock.return_value += 1\\n+                    value.signal_owned()\\n+                    self.assertEqual(send.call_count, 3)\\n+                self.assertEqual([event[1][\\\"signal\\\"] for event in value.events],\\n+                                 [signal.SIGTERM, signal.SIGKILL, signal.SIGKILL])\\n+\\n+    def test_released_root_or_unconfirmed_gate_keeps_original_term_cleanup(self):\\n+        for released, closed in ((True, True), (False, False), (True, False)):\\n+            with self.subTest(root_exec_released=released, root_exec_gate_closed=closed):\\n+                value = self.closed_gate_collector(released=released, closed=closed)\\n+                with mock.patch.object(collector.time, \\\"monotonic_ns\\\",\\n+                                       return_value=value.cleanup_started), \\\\\\n+                        mock.patch.object(collector.signal, \\\"pidfd_send_signal\\\") as send:\\n+                    value.signal_owned()\\n+                    self.assertEqual(send.call_args_list, [\\n+                        mock.call(51, signal.SIGTERM), mock.call(52, signal.SIGTERM)])\\n+                    value.signal_owned()\\n+                    self.assertEqual(send.call_count, 2)\\n+                self.assertIsNone(value.root_returncode)\\n+                self.assertEqual([event[1][\\\"signal\\\"] for event in value.events],\\n+                                 [signal.SIGTERM, signal.SIGTERM])\\n+\\n+\\n if __name__ == \\\"__main__\\\":\\n     unittest.main()\\ndiff --git a/scripts/w1_owned_process_collector_v1.py b/scripts/w1_owned_process_collector_v1.py\\nindex eaa244036..7049001ac 100644\\n--- a/scripts/w1_owned_process_collector_v1.py\\n+++ b/scripts/w1_owned_process_collector_v1.py\\n@@ -213,6 +213,7 @@ class Collector:\\n         self.root_pid = None\\n         self.root_returncode = None\\n         self.root_exec_released = False\\n+        self.root_exec_gate_closed = False\\n         self.echild = None\\n         self.records_truncated = False\\n         self.events_count = 0\\n@@ -394,6 +395,13 @@ class Collector:\\n         elapsed = time.monotonic_ns() - self.cleanup_started\\n         sig = signal.SIGKILL if elapsed >= min(250_000_000, int(self.args.cleanup_grace_seconds * 500_000_000)) else signal.SIGTERM\\n         for item in list(self.owned.values()):\\n+            # A closed, never-released exec gate already tells this root to exit\\n+            # with 125. Do not race that refusal with TERM before it can read\\n+            # EOF. The original KILL escalation and total cleanup bound remain.\\n+            if (sig == signal.SIGTERM and self.root_exec_gate_closed\\n+                    and not self.root_exec_released\\n+                    and item[\\\"identity\\\"][\\\"pid\\\"] == self.root_pid):\\n+                continue\\n             if sig in item[\\\"signals\\\"]:\\n                 continue\\n             item[\\\"signals\\\"].add(sig)\\n@@ -507,6 +515,7 @@ class Collector:\\n                 self.emit(\\\"root-exec-released\\\", {\\\"identity\\\": self.root})\\n         finally:\\n             os.close(gate_writer)\\n+            self.root_exec_gate_closed = True\\n \\n     def loop(self):\\n         while True:\\n\"\n+}"},{"sha":"fb629d6e0964cab2bf7c17e0a7de50f23bef3196","filename":"docs/audit/20261114-m4-closed-exec-gate/source-static-validation-v2.json","status":"added","additions":37,"deletions":0,"changes":37,"blob_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/blob/5df7ae6f482157c5f7fdcbcd52222117a965053f/docs%2Faudit%2F20261114-m4-closed-exec-gate%2Fsource-static-validation-v2.json","raw_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/raw/5df7ae6f482157c5f7fdcbcd52222117a965053f/docs%2Faudit%2F20261114-m4-closed-exec-gate%2Fsource-static-validation-v2.json","contents_url":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/contents/docs%2Faudit%2F20261114-m4-closed-exec-gate%2Fsource-static-validation-v2.json?ref=5df7ae6f482157c5f7fdcbcd52222117a965053f","patch":"@@ -0,0 +1,37 @@\n+{\n+  \"schema\": \"trnm-M4-portable-signal-recorder-static-v2\",\n+  \"base\": \"1a7afcdb820b051d1e4bfde3d436f96fc050c487\",\n+  \"source_files\": [\n+    {\n+      \"path\": \"scripts/w1_owned_process_collector_v1.py\",\n+      \"bytes\": 48204,\n+      \"sha256\": \"01accf26eecd5b0bdecd94909d328cafc028d7d2bcf387ec9ecbcab533b146cc\",\n+      \"git_blob\": \"7049001ace23192d6d32e4f438ca85e4b0ac16cc\"\n+    },\n+    {\n+      \"path\": \"scripts/test_w1_owned_process_collector_v1.py\",\n+      \"bytes\": 26879,\n+      \"sha256\": \"31b2e67e25653fdb025150c6ba5fef1ba23b20efe7c6c05fe429cca853a3e8aa\",\n+      \"git_blob\": \"0c683b183d64d71e8ae6c6f44dca857b4f6e77b3\"\n+    }\n+  ],\n+  \"change\": \"Only the two new signal recorder mocks add create=True; runtime9-line approved patch unchanged.\",\n+  \"original14_source_and_ast_equal\": true,\n+  \"syntax_compilation_passed\": true,\n+  \"modules_imported\": false,\n+  \"tests_executed\": false,\n+  \"linux16_pending\": true,\n+  \"full_lane_passed\": false,\n+  \"initial_patch_preserved_sha256\": \"a8c3d5ecbf2b563efde4ac4bb535309e9657145e59c45c3957ca2ecf7e131b91\",\n+  \"current_patch\": {\n+    \"path\": \"/private/tmp/chain-M4-owned-process-collector-review-20261114-v1/commit-v2/source-and-tests.patch\",\n+    \"bytes\": 6467,\n+    \"sha256\": \"2dd93726b371e584947a4af909d6b2895f88828c207d41d4a60638afbfd96dbf\"\n+  },\n+  \"initial_staged_whitespace_failure\": {\n+    \"source\": \"/