  vp_at:u64 = int.cast(vp_prev) {"mode":"wrap"}
  vp_good:bool = call(vp_r,vp_m,vp_w,vp_first,vp_at) {"function":"hfv_parent"}
  branch vp_good terminal(vp_r,vp_m,vp_w,vp_row,vp_last,vp_len) refused()
block terminal(te_r:readbuf,te_m:mutbuf,te_w:mutbuf,te_row:u64,te_last:bool,te_len:u64)
  branch te_last tail(te_r,te_m,te_w,te_row,te_len) save(te_r,te_m,te_w,te_row,te_len)
block tail(ta_r:readbuf,ta_m:mutbuf,ta_w:mutbuf,ta_row:u64,ta_len:u64)
  ta_receipt:usize = const() {"value":100}
  ta_metadata:usize = const() {"value":7010}
  ta_all:u64 = const() {"value":72}
  ta_mode_at:u64 = const() {"value":349024}
  ta_cap:u64 = call(ta_m,ta_mode_at) {"function":"cp_get"}
  ta_settle:bool = call(ta_cap) {"function":"hfs_settled"}
  ta_state_receipt:usize = const() {"value":140}
