update-proposal.json","raw_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/raw/5df7ae6f482157c5f7fdcbcd52222117a965053f/evidence%2Fhash-use-current-source-review-20261114%2Fconsumer-pin-update-proposal.json","contents_url":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/contents/evidence%2Fhash-use-current-source-review-20261114%2Fconsumer-pin-update-proposal.json?ref=5df7ae6f482157c5f7fdcbcd52222117a965053f","patch":"@@ -0,0 +1,25 @@\n+{\n+  \"corpus_modified_here\": false,\n+  \"schema\": \"hash-use-root-composition-pin-proposal-v1\",\n+  \"soleplan_modified_here\": false,\n+  \"updates\": [\n+    {\n+      \"bytes\": 72224,\n+      \"new_git_blob\": \"986a94eaf6b1c44a11595cc98ac4f9925e7c943e\",\n+      \"path\": \"config/pon/hash-use-contract-v1.json\",\n+      \"sha256\": \"9d1e45dacc0717a9418360c0eb1d1652abc0ef7e761f730c978bab160b09c2d5\"\n+    },\n+    {\n+      \"bytes\": 18146,\n+      \"new_git_blob\": \"cf55d45678bfb27d9ad9fcf2863a05aa1bc0540b\",\n+      \"path\": \"scripts/ci/hash_use_contract.py\",\n+      \"sha256\": \"e7a3b41852509e4fdf9833ce65aadcfb3b749055044175176202276287218230\"\n+    },\n+    {\n+      \"bytes\": 15317,\n+      \"new_git_blob\": \"caeef93f9bc11228fc8fe5d18923ffca42a7af16\",\n+      \"path\": \"docs/security/HASH_USE_CONTRACT_V1.md\",\n+      \"sha256\": \"216c7cb253fb08010af0e990c691efdce5850da7620d175bb19290e6d8388a50\"\n+    }\n+  ]\n+}"},{"sha":"d12c1819303e94bf4dfd39d14a9b2780c28110a1","filename":"evidence/hash-use-current-source-review-20261114/diagnostics/function-precheck_proof_statement.rs","status":"added","additions":26,"deletions":0,"changes":26,"blob_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/blob/5df7ae6f482157c5f7fdcbcd52222117a965053f/evidence%2Fhash-use-current-source-review-20261114%2Fdiagnostics%2Ffunction-precheck_proof_statement.rs","raw_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/raw/5df7ae6f482157c5f7fdcbcd52222117a965053f/evidence%2Fhash-use-current-source-review-20261114%2Fdiagnostics%2Ffunction-precheck_proof_statement.rs","contents_url":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/contents/evidence%2Fhash-use-current-source-review-20261114%2Fdiagnostics%2Ffunction-precheck_proof_statement.rs?ref=5df7ae6f482157c5f7fdcbcd52222117a965053f","patch":"@@ -0,0 +1,26 @@\n+pub fn precheck_proof_statement(\n+    challenge: Hash,\n+    expected_task: Hash,\n+    target: Hash,\n+    bytes: &[u8],\n+) -> Result<(), WorkError> {\n+    precheck_proof_encoding(bytes)?;\n+    if target == [0; 32] {\n+        return Err(WorkError::Target);\n+    }\n+    let actual_task = hash(\n+        b\"task\",\n+        &[\n+            &bytes[4..4 + CELLS * 4],\n+            &bytes[4 + CELLS * 4..4 + CELLS * 8],\n+        ],\n+    );\n+    if actual_task != expected_task {\n+        return Err(WorkError::Task);\n+    }\n+    let trace_claim = &bytes[4 + 3 * CELLS * 4..];\n+    if hash(b\"ticket\", &[&challenge, trace_claim]) > target {\n+        return Err(WorkError::Target);\n+    }\n+    Ok(())\n+}"},{"sha":"11655042c1fbea365a5bf5e7efad13f35f42c66f","filename":"evidence/hash-use-current-source-review-20261114/diagnostics/function-sequence_root.rs","status":"added","additions":25,"deletions":0,"changes":25,"blob_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/blob/5df7ae6f482157c5f7fdcbcd52222117a965053f/evidence%2Fhash-use-current-source-review-20261114%2Fdiagnostics%2Ffunction-sequence_root.rs","raw_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/raw/5df7ae6f482157c5f7fdcbcd52222117a965053f/evidence%2Fhash-use-current-source-review-20261114%2Fdiagnostics%2Ffunction-sequence_root.rs","contents_url":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/contents/evidence%2Fhash-use-current-source-review-20261114%2Fdiagnostics%2Ffunction-sequence_root.rs?ref=5df7ae6f482157c5f7fdcbcd52222117a965053f","patch":"@@ -0,0 +1,25 @@\n+pub fn sequence_root(tag: &str, items: &[Vec<u8>]) -> Hash {\n+    let mut leaves: Vec<_> = items\n+        .iter()\n+        .enumerate()\n+        .map(|(i, b)| {\n+            hash(\n+                format!(\"{tag}-leaf\").as_bytes(),\n+                &[&(i as u64).to_le_bytes(), b],\n+            )\n+        })\n+        .collect();\n+    if leaves.is_empty() {\n+        return hash(format!(\"{tag}-empty\").as_bytes(), &[]);\n+    }\n+    while leaves.len() > 1 {\n+        if leaves.len() % 2 == 1 {\n+            leaves.push(*leaves.last().expect(\"nonempty\"));\n+        }\n+        leaves = leaves\n+            .chunks_exact(2)\n+            .map(|p| hash(format!(\"{tag}-node\").as_bytes(), &[&p[0], &p[1]]))\n+            .collect();\n+    }\n+    leaves[0]\n+}"},{"sha":"778bbabc3d942270b58d0829271c20215cb0d7f0","filename":"evidence/hash-use-current-source-review-20261114/diagnostics/function-task_id.rs","status":"added","additions":5,"deletions":0,"changes":5,"blob_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/blob/5df7ae6f482157c5f7fdcbcd52222117a965053f/evidence%2Fhash-use-current-source-review-20261114%2Fdiagnostics%2Ffunction-task_id.rs","raw_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/raw/5df7ae6f482157c5f7fdcbcd52222117a965053f/evidence%2Fhash-use-current-source-review-20261114%2Fdiagnostics%2Ffunction-task_id.rs","contents_url":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/contents/evidence%2Fhash-use-current-source-review-20261114%2Fdiagnostics%2Ffunction-task_id.rs?ref=5df7ae6f482157c5f7fdcbcd52222117a965053f","patch":"@@ -0,0 +1,5 @@\n+pub fn task_id(a: &[u32], b: &[u32]) -> Result<Hash, WorkError> {\n+    validate(a)?;\n+    validate(b)?;\n+    Ok(hash(b\"task\", &[&field_bytes(a), &field_bytes(b)]))\n+}"},{"sha":"a5d0892996a4d3d3ec15f8e9cbcb619a6b3848ad","filename":"evidence/hash-use-current-source-review-20261114/diagnostics/function-verify.rs","status":"added","additions":14,"deletions":0,"changes":14,"blob_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/blob/5df7ae6f482157c5f7fdcbcd52222117a965053f/evidence%2Fhash-use-current-source-review-20261114%2Fdiagnostics%2Ffunction-verify.rs","raw_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/raw/5df7ae6f482157c5f7fdcbcd52222117a965053f/evidence%2Fhash-use-current-source-review-20261114%2Fdiagnostics%2Ffunction-verify.rs","contents_url":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/contents/evidence%2Fhash-use-current-source-review-20261114%2Fdiagnostics%2Ffunction-verify.rs?ref=5df7ae6f482157c5f7fdcbcd52222117a965053f","patch":"@@ -0,0 +1,14 @@\n+pub fn verify(\n+    challenge: Hash,\n+    expected_task: Hash,\n+    target: Hash,\n+    bytes: &[u8],\n+) -> Result<VerifiedWork, WorkError> {\n+    relation_only(verify_with_progress(\n+        challenge,\n+        expected_task,\n+        target,\n+        bytes,\n+        &mut no_cancellation,\n+    ))\n+}"},{"sha":"33a5095f2db042a1911392d15a32fae4e0c7c254","filename":"evidence/hash-use-current-source-review-20261114/diagnostics/readonly_pin_audit.py","status":"added","additions":58,"deletions":0,"changes":58,"blob_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/blob/5df7ae6f482157c5f7fdcbcd52222117a965053f/evidence%2Fhash-use-current-source-review-20261114%2Fdiagnostics%2Freadonly_pin_audit.py","raw_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/raw/5df7ae6f482157c5f7fdcbcd52222117a965053f/evidence%2Fhash-use-current-source-review-20261114%2Fdiagnostics%2Freadonly_pin_audit.py","contents_url":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/contents/evidence%2Fhash-use-current-source-review-20261114%2Fdiagnostics%2Freadonly_pin_audit.py?ref=5df7ae6f482157c5f7fdcbcd52222117a965053f","patch":"@@ -0,0 +1,58 @@\n+import datetime, hashlib, json, os, pathlib, re, stat, subprocess, sys\n+sys.dont_write_bytecode=True\n+W=pathlib.Path(\"/private/tmp/chain-hash-use-current-binding-20261114\")\n+E=pathlib.Path(\"/private/tmp/chain-hash-use-current-binding-evidence-20261114\")\n+D=E/\"readonly-pin-audit-v1\";D.mkdir()\n+HEAD=\"7d8d4c59fcd01480a12e1c64835b202079091800\"\n+BASE=\"dc42ce4df5cff79cc61c5addbaf01074b56b06ca\"\n+LAST=\"57b069ae1e7ed32ff95e4f2a18a74d5eadcda550\"\n+env=dict(os.environ,PATH=\"/Users/qianqi/.rustup/toolchains/1.95.0-aarch64-apple-darwin/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin\",GIT_NO_REPLACE_OBJECTS=\"1\",GIT_NO_LAZY_FETCH=\"1\",GIT_OPTIONAL_LOCKS=\"0\",GIT_TERMINAL_PROMPT=\"0\",PYTHONDONTWRITEBYTECODE=\"1\",PYTHONOPTIMIZE=\"0\")\n+def sh(b):return hashlib.sha256(b).hexdigest()\n+def go(a):\n+ r=subprocess.run([\"/usr/bin/git\",\"-C\",str(W),*a],env=env,stdout=subprocess.PIPE,stderr=subprocess.PIPE,timeout=60)\n+ if r.returncode:raise RuntimeError(str(a)+\": \"+r.stderr.decode(errors=\"replace\"))\n+ return r.stdout\n+def blob(commit,path):\n+ oid=go([\"rev-parse\",commit+\":\"+path]).decode().strip()\n+ raw=go([\"cat-file\",\"blob\",oid])\n+ assert hashlib.sha1(b\"blob \"+str(len(raw)).encode()+b\"\\0\"+raw).hexdigest()==oid\n+ return oid,raw\n+def put(name,raw):\n+ p=D/name;p.parent.mkdir(parents=True,exist_ok=True)\n+ with p.open(\"xb\") as f:f.write(raw)\n+ return {\"path\":str(p),\"bytes\":len(raw),\"sha256\":sh(raw)}\n+def dump(name,data):return put(name,(json.dumps(data,indent=2,sort_keys=True)+\"\\n\").encode())\n+before={\"head\":go([\"rev-parse\",\"HEAD\"]).decode().strip(),\"tree\":go([\"rev-parse\",\"HEAD^{tree}\"]).decode().strip(),\"status\":go([\"status\",\"--porcelain=v1\",\"--untracked-files=all\"]).decode()}\n+assert before[\"head\"]==HEAD and before[\"status\"]==\"\"\n+sys.path.insert(0,str(W/\"scripts/ci\"))\n+import hash_use_contract as contract\n+from pq_source_reader import read_regular\n+mp=contract.DEFAULT_MANIFEST\n+moid,mraw=blob(HEAD,mp); assert mraw==read_regular(W,mp,contract.MAX_BYTES)\n+manifest=contract.strict_json(mraw)\n+assert len(manifest[\"source_files\"])==31 and len(manifest[\"uses\"])==19\n+semantic={k:v for k,v in manifest.items() if k!=\"source_files\"}\n+assert contract.sha(contract.canonical(semantic))==contract.REVIEWED_SEMANTICS_SHA256\n+assert contract.sha(contract.canonical(manifest[\"source_files\"]))==contract.REVIEWED_SOURCE_MAP_SHA256\n+prior_oid,prior_raw=blob(LAST,mp);assert prior_raw==mraw\n+for index,start in enumerate(range(0,len(mraw),30000)):put(\"manifest-part-\"+str(index)+\".txt\",mraw[start:start+30000])\n+rows=[];changes=[]\n+for i,(path,pin) in enumerate(manifest[\"source_files\"].items()):\n+ current_oid,raw=blob(HEAD,path); physical=read_regular(W,path,contract.MAX_SOURCE_BYTES);assert physical==raw\n+ old_oid,old_raw=blob(LAST,path)\n+ source_uses=[identity for identity,row in manifest[\"uses\"].items() if path in row[\"source_paths\"]]\n+ assert source_uses\n+ _,dcraw=blob(BASE,path)\n+ row={\"path\":path,\"declared_pin\":pin,\"declared_uses\":source_uses,\"last_mapping_commit\":LAST,\"last_mapping_blob\":old_oid,\"last_mapping_bytes\":len(old_raw),\"last_mapping_sha256\":sh(old_raw),\"declared_pin_matches_last_mapping_commit\":pin=={\"bytes\":len(old_raw),\"sha256\":sh(old_raw)},\"current_commit\":HEAD,\"current_blob\":current_oid,\"current_bytes\":len(raw),\"current_sha256\":sh(raw),\"current_raw_equals_worktree\":True,\"current_equals_dc42\":raw==dcraw,\"current_matches_declared_pin\":pin=={\"bytes\":len(raw),\"sha256\":sh(raw)}}\n+ if not row[\"current_matches_declared_pin\"]:\n+  filename=path.replace(\"/\",\"--\")\n+  row[\"full_blob_delta\"]=put(\"changed/\"+filename+\".patch\",go([\"diff\",\"--no-ext-diff\",\"--no-textconv\",\"--binary\",old_oid,current_oid]))\n+  row[\"current_path_history\"]=put(\"changed/\"+filename+\".history\",go([\"log\",\"--format=%H %P %s\",LAST+\"..\"+HEAD,\"--\",path]))\n+  put(\"changed/\"+filename+\".before\",old_raw);put(\"changed/\"+filename+\".current\",raw)\n+  changes.append(path)\n+ rows.append(row)\n+summary={\"schema\":\"hash-use-all-31-source-pins-readonly-review-v1\",\"head\":HEAD,\"source_before\":before,\"manifest\":{\"path\":mp,\"blob\":moid,\"bytes\":len(mraw),\"sha256\":sh(mraw),\"last_mapping_commit\":LAST,\"last_mapping_blob\":prior_oid,\"same_raw_as_last_mapping_commit\":True},\"review_base_revision\":manifest[\"review_base_revision\"],\"reviewed_semantics_sha256\":contract.REVIEWED_SEMANTICS_SHA256,\"reviewed_source_map_sha256\":contract.REVIEWED_SOURCE_MAP_SHA256,\"declared_use_count\":len(manifest[\"uses\"]),\"declared_source_count\":len(rows),\"changed_paths\":changes,\"changed_count\":len(changes),\"unchanged_count\":len(rows)-len(changes),\"all_old_pins_match_last_mapping_commit\":all(r[\"declared_pin_matches_last_mapping_commit\"] for r in rows),\"all_current_equal_dc42\":all(r[\"current_equals_dc42\"] for r in rows),\"rows\":rows,\"no_source_edits\":True,\"no_tests_run\":True}\n+after={\"head\":go([\"rev-parse\",\"HEAD\"]).decode().strip(),\"tree\":go([\"rev-parse\",\"HEAD^{tree}\"]).decode().strip(),\"status\":go([\"status\",\"--porcelain=v1\",\"--untracked-files=all\"]).decode()}\n+assert before==after;summary[\"source_after\"]=after\n+meta=dump(\"all-31-inputs.json\",summary)\n+print(json.dumps({\"summary\":meta,\"changed_count\":len(changes),\"unchanged_count\":len(rows)-len(changes),\"changed_paths\":changes,\"all_old_pins_match_last_mapping_commit\":summary[\"all_old_pins_match_last_mapping_commit\"],\"all_current_equal_dc42\":summary[\"all_current_equal_dc42\"]}),flush=True)"},{"sha":"a47a7b5414dd568134092f57be0a3f0510f058e8","filename":"evidence/hash-use-current-source-review-20261114/diagnostics/readonly_scope_v1.py","status":"added","additions":81,"deletions":0,"changes":81,"blob_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/blob/5df7ae6f482157c5f7fdcbcd52222117a965053f/evidence%2Fhash-use-current-source-review-20261114%2Fdiagnostics%2Freadonly_scope_v1.py","raw_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/raw/5df7ae6f482157c5f7fdcbcd52222117a965053f/evidence%2Fhash-use-current-source-review-20261114%2Fdiagnostics%2Freadonly_scope_v1.py","contents_url":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/contents/evidence%2Fhash-use-current-source-review-20261114%2Fdiagnostics%2Freadonly_scope_v1.py?ref=5df7ae6f482157c5f7fdcbcd52222117a965053f","patch":"@@ -0,0 +1,81 @@\n+import ast, copy, hashlib, json, os, pathlib, re, subprocess, sys\n+sys.dont_write_bytecode=True\n+W=pathlib.Path(\"/private/tmp/chain-hash-use-current-binding-20261114\")\n+E=pathlib.Path(\"/private/tmp/chain-hash-use-current-binding-evidence-20261114\")\n+D=E/\"readonly-pin-audit-v1\"; S=E/\"readonly-consumer-and-scope-v1\";S.mkdir()\n+HEAD=\"7d8d4c59fcd01480a12e1c64835b202079091800\";LAST=\"57b069ae1e7ed32ff95e4f2a18a74d5eadcda550\"\n+env=dict(os.environ,PATH=\"/Users/qianqi/.rustup/toolchains/1.95.0-aarch64-apple-darwin/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin\",GIT_NO_REPLACE_OBJECTS=\"1\",GIT_NO_LAZY_FETCH=\"1\",GIT_OPTIONAL_LOCKS=\"0\",GIT_TERMINAL_PROMPT=\"0\",PYTHONDONTWRITEBYTECODE=\"1\",PYTHONOPTIMIZE=\"0\")\n+def sha(b):return hashlib.sha256(b).hexdigest()\n+def put(name,b):\n+ p=S/name;p.parent.mkdir(parents=True,exist_ok=True)\n+ with p.open(\"xb\") as f:f.write(b)\n+ return {\"path\":str(p),\"bytes\":len(b),\"sha256\":sha(b)}\n+def dump(n,v):return put(n,(json.dumps(v,indent=2,sort_keys=True)+\"\\n\").encode())\n+def git(args):\n+ r=subprocess.run([\"/usr/bin/git\",\"-C\",str(W),*args],env=env,stdout=subprocess.PIPE,stderr=subprocess.PIPE,timeout=60)\n+ if r.returncode:raise RuntimeError(str(args))\n+ return r.stdout\n+before={\"head\":git([\"rev-parse\",\"HEAD\"]).decode().strip(),\"tree\":git([\"rev-parse\",\"HEAD^{tree}\"]).decode().strip(),\"status\":git([\"status\",\"--porcelain=v1\",\"--untracked-files=all\"]).decode()}\n+assert before[\"head\"]==HEAD and not before[\"status\"]\n+a=json.loads((D/\"all-31-inputs.json\").read_bytes())\n+raw=(W/\"config/pon/hash-use-contract-v1.json\").read_bytes();m=json.loads(raw)\n+canon=lambda x:json.dumps(x,sort_keys=True,separators=(\",\",\":\"),ensure_ascii=True,allow_nan=False).encode()\n+proposed=copy.deepcopy(m[\"source_files\"])\n+for row in a[\"rows\"]:proposed[row[\"path\"]]={\"bytes\":row[\"current_bytes\"],\"sha256\":row[\"current_sha256\"]}\n+schema={\"current_manifest_sha256\":sha(raw),\"current_source_map_sha256\":sha(canon(m[\"source_files\"])),\"proposed_current_source_map_sha256\":sha(canon(proposed)),\"unchanged_semantics_sha256\":sha(canon({k:v for k,v in m.items() if k!=\"source_files\"})),\"unchanged_review_base_revision\":m[\"review_base_revision\"],\"uses\":len(m[\"uses\"]),\"source_paths\":len(proposed),\"proposed_map_has_exact_same_roster\":set(proposed)==set(m[\"source_files\"]),\"changed_pin_count\":sum(proposed[p]!=m[\"source_files\"][p] for p in proposed),\"source_files_currently_modified\":False}\n+originals={}\n+for name,path in [(\"manifest.json\",\"config/pon/hash-use-contract-v1.json\"),(\"reader.py\",\"scripts/ci/hash_use_contract.py\"),(\"tests.py\",\"scripts/ci/test_hash_use_contract.py\"),(\"contract.md\",\"docs/security/HASH_USE_CONTRACT_V1.md\")]:\n+ old=git([\"show\",LAST+\":\"+path]);current=(W/path).read_bytes()\n+ originals[path]={\"last_mapping_commit\":LAST,\"historical_blob\":git([\"rev-parse\",LAST+\":\"+path]).decode().strip(),\"current_blob\":git([\"rev-parse\",HEAD+\":\"+path]).decode().strip(),\"whole_raw_same\":old==current,\"preserved_original\":put(\"originals/\"+name,old)}\n+ assert old==current\n+roster=[n.name for n in ast.walk(ast.parse((W/\"scripts/ci/test_hash_use_contract.py\").read_text())) if isinstance(n,(ast.FunctionDef,ast.AsyncFunctionDef)) and n.name.startswith(\"test_\")]\n+assert len(roster)==33\n+proof_path=\"config/pon/pq-proof-profile-binding-v1.json\"\n+profile_versions=[]\n+for commit in [LAST,\"ecf8b5cfea66d7451c2ae6910233746bd95fc155\",\"b84568a714e24070d9554008660f1382e2c1b1b5\",HEAD]:\n+ b=git([\"show\",commit+\":\"+proof_path]);v=json.loads(b)\n+ profile_versions.append({\"commit\":commit,\"blob\":git([\"rev-parse\",commit+\":\"+proof_path]).decode().strip(),\"bytes\":len(b),\"sha256\":sha(b),\"mapping_contract\":v[\"mapping_contract\"],\"all_other_profile_fields\":{k:x for k,x in v.items() if k!=\"mapping_contract\"}})\n+assert all(x[\"all_other_profile_fields\"]==profile_versions[0][\"all_other_profile_fields\"] for x in profile_versions)\n+r=subprocess.run([\"/opt/homebrew/bin/rg\",\"-n\",\"--glob\",\"!evidence/**\",\"--glob\",\"!archive/**\",\"hash_use_contract|hash-use-contract|HASH_USE_CONTRACT|4c52b9ee94afcc67992da56ce88f0705bd4b5c6dd99f29fc56b4b894ed484cbf|50c12b630049933110a400590d64f8bfb764a76bdf8737c71a53a71245a0fc92\", \"scripts\",\"config\",\"docs\",\".github\",\"AGENTS.md\"],cwd=W,env=env,stdout=subprocess.PIPE,stderr=subprocess.PIPE,timeout=60);assert r.returncode==0\n+search=put(\"direct-consumers.stdout\",r.stdout);put(\"direct-consumers.stderr\",r.stderr)\n+excerpts={}\n+for path,spans in {\n+ \"scripts/ci/ci_job.sh\":[(55,72)],\n+ \"scripts/ci/check_ci_contract.py\":[(840,860),(1650,1700)],\n+ \"scripts/ci/test_ci_contract.py\":[(3180,3220),(3308,3322)],\n+ \"scripts/ci/check_pq_research_integration.py\":[(282,307)]\n+}.items():\n+ lines=(W/path).read_text().splitlines(keepends=True)\n+ text=\"\".join(\"\".join(str(i+1)+\": \"+lines[i] for i in range(lo-1,min(hi,len(lines))))+\"\\n\" for lo,hi in spans)\n+ excerpts[path]=put(path.replace(\"/\",\"--\")+\".excerpt\",text.encode())\n+# Full patches already prove every changed line; these narrow exact spans aid\n+# review without claiming a Rust parser or a whole-repository refinement proof.\n+function_checks=[]\n+def span(data,name):\n+ lines=data.decode().splitlines(keepends=True)\n+ found=[i for i,line in enumerate(lines) if re.match(r\"^(\\s*)(?:pub(?:\\([^)]*\\))?\\s+)?fn\\s+\"+re.escape(name)+r\"(?:<|\\()\",line)]\n+ if len(found)!=1:raise ValueError(\"nonunique function \