fn vr_registry(input:readbuf,count:u64) -> (u32) effects(read,trap) entry(entry)
block entry(input:readbuf,count:u64)
  zero:u64 = const() {"value":0}
  jump scan(input,count,zero,zero)
block scan(si:readbuf,total:u64,index:u64,seen:u64)
  done:bool = compare.eq(index,total)
  branch done complete(total) entry_check(si,total,index,seen)
block entry_check(ei:readbuf,en:u64,ei_index:u64,ekinds:u64)
  row:u64 = call(ei_index) {"function":"vr_row"}
  status:u32,kind:u64 = call(ei,row) {"function":"vr_validate"}
  ok:u32 = const() {"value":0}
  eligible:bool = compare.eq(status,ok)
  branch eligible unique_kind(ei,en,ei_index,ekinds,row,kind) refuse(status)
block unique_kind(ki:readbuf,kn:u64,kidx:u64,known:u64,krow:u64,new_kind:u64)
  one_kind:u64 = const() {"value":1}
  bit:u64 = int.shl.checked(one_kind,new_kind)
  in_seen:u64 = bit.and(known,bit)
  zero_bit:u64 = const() {"value":0}
  fresh:bool = compare.eq(in_seen,zero_bit)
  more:u64 = bit.or(known,bit)
  branch fresh unique_identity(ki,kn,kidx,more,krow) duplicate_kind()
block unique_identity(ui:readbuf,un:u64,uidx:u64,ukinds:u64,urow:u64)
  duplicate:bool = call(ui,uidx,urow) {"function":"vr_prior_identity"}
  next_one:u64 = const() {"value":1}
  next:u64 = int.add.wrap(uidx,next_one)
  branch duplicate duplicate_id() scan(ui,un,next,ukinds)
block complete(cn:u64)
  six:u64 = const() {"value":6}
  all_kinds:bool = compare.eq(cn,six)
  success:u32 = const() {"value":0}
  missing:u32 = const() {"value":6}
  result:u32 = select(all_kinds,success,missing)
  ret(result)
block refuse(code:u32)
  ret(code)
block duplicate_kind()
  duplicated_kind:u32 = const() {"value":4}
  ret(duplicated_kind)
block duplicate_id()
  duplicated_identity:u32 = const() {"value":5}
  ret(duplicated_identity)
end

fn vr_lookup(input:readbuf,id_at:u64,version_at:u64,hash_at:u64,height_at:u64) -> (u32,u64) effects(read,trap) entry(entry)
block entry(input:readbuf,id_at:u64,version_at:u64,hash_at:u64,height_at:u64)
  four:u64 = const() {"value":4}
  version:u64 = call(input,version_at,four) {"function":"rac_read_le"}
  row:u64 = call(input,id_at,version) {"function":"vr_find"}
  zero:u64 = const() {"value":0}
  present:bool = compare.ne(row,zero)
  branch present active(input,row,hash_at,height_at) absent()
block active(ai:readbuf,arow:u64,ahash:u64,aheight:u64)
  status:u32 = call(ai,arow,ahash,aheight) {"function":"vr_resolve"}
  ret(status,arow)
block absent()
  missing:u32 = const() {"value":7}
  no_row:u64 = const() {"value":0}
  ret(missing,no_row)
end

fn vr_row(index:u64) -> (u64) effects() entry(entry)
block entry(index:u64)
  start:u64 = const() {"value":92}
