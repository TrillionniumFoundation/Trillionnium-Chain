  bl:u64 = call(w,at_r) {"function":"tr_get"}
  _a0:u64 = call(w,left,b) {"function":"tr_put"}
  _a1:u64 = call(w,at_l,bl) {"function":"tr_put"}
  _b0:u64 = call(w,right,a) {"function":"tr_put"}
  _b1:u64 = call(w,at_r,al) {"function":"tr_put"}
  ret(b)
end

fn audit_included(w:mutbuf,a:u64,step:u64) -> (bool) effects(read,write,trap) entry(entry)
block entry(w:mutbuf,a:u64,step:u64)
  word:u64 = const() {"value":8}
  group_at:u64 = int.add.wrap(a,word)
  seq:u64 = call(w,group_at) {"function":"tr_get"}
  z:u64 = const() {"value":0}
  live:bool = compare.eq(seq,z)
  later:bool = compare.gt(seq,step)
  taken:bool = bool.or(live,later)
  ret(taken)
end

fn audit_sort(r:readbuf,w:mutbuf,n:u64) -> (u64) effects(read,write,trap) entry(entry)
block entry(r:readbuf,w:mutbuf,n:u64)
  one:u64 = const() {"value":1}
  jump outer(r,w,n,one)
block outer(or0:readbuf,ow:mutbuf,on:u64,oi:u64)
  more:bool = compare.lt(oi,on)
  branch more insertion(or0,ow,on,oi,oi) done()
block insertion(ir:readbuf,iw:mutbuf,in0:u64,ii:u64,ij:u64)
  z:u64 = const() {"value":0}
  prev:bool = compare.gt(ij,z)
  branch prev compare_rows(ir,iw,in0,ii,ij) advance(ir,iw,in0,ii)
block compare_rows(cr:readbuf,cw:mutbuf,cn:u64,ci:u64,cj:u64)
  pred:u64 = const() {"value":1}
  j0:u64 = int.sub.wrap(cj,pred)
  left:u64 = call(j0) {"function":"audit_row_at"}
  right:u64 = call(cj) {"function":"audit_row_at"}
  lr:u64 = call(cw,left) {"function":"tr_get"}
  rr:u64 = call(cw,right) {"function":"tr_get"}
  bias:u64 = const() {"value":40}
  lh:u64 = int.add.wrap(lr,bias)
  rh:u64 = int.add.wrap(rr,bias)
  reverse:bool = call(cr,rh,lh) {"function":"ar_multi_lex"}
  branch reverse swap(cr,cw,cn,ci,j0,left,right,lr,rr) advance(cr,cw,cn,ci)
block swap(sr:readbuf,sw:mutbuf,sn:u64,si:u64,sj:u64,sl:u64,ss:u64,srow:u64,soth:u64)
  _shift:u64 = call(sw,sl,ss) {"function":"audit_swap"}
  jump insertion(sr,sw,sn,si,sj)
block advance(ar:readbuf,aw:mutbuf,an:u64,ai:u64)
  o:u64 = const() {"value":1}
  next:u64 = int.add.wrap(ai,o)
  jump outer(ar,aw,an,next)
block done()
  result:u64 = const() {"value":0}
  ret(result)
end

fn audit_root(r:readbuf,w:mutbuf,n:u64,step:u64) -> (bool) effects(read,write,trap) entry(entry)
block entry(r:readbuf,w:mutbuf,n:u64,step:u64)
  z:u64 = const() {"value":0}
  jump count(r,w,n,step,z,z)
block count(cr:readbuf,cw:mutbuf,cn:u64,cs:u64,ci:u64,cc:u64)
  more:bool = compare.lt(ci,cn)
  branch more consider(cr,cw,cn,cs,ci,cc) digest_init(cr,cw,cn,cs,cc)
block consider(ar:readbuf,aw:mutbuf,an:u64,as0:u64,ai:u64,ac:u64)
  slot:u64 = call(ai) {"function":"audit_row_at"}
  take:bool = call(aw,slot,as0) {"function":"audit_included"}
  one:u64 = const() {"value":1}
  cadd:u64 = int.add.wrap(ac,one)
  cnext:u64 = select(take,cadd,ac)
  next:u64 = int.add.wrap(ai,one)
  jump count(ar,aw,an,as0,next,cnext)
block digest_init(dr:readbuf,dw:mutbuf,dn:u64,ds:u64,dc:u64)
  started:bool = call(dw,dc) {"function":"inv_begin_digest"}
  z0:u64 = const() {"value":0}
  branch started stream(dr,dw,dn,ds,z0) failed()
block stream(sr:readbuf,sw:mutbuf,sn:u64,ss:u64,si:u64)
  more_bytes:bool = compare.lt(si,sn)
  branch more_bytes feed(sr,sw,sn,ss,si) done(sw)
block feed(fr:readbuf,fw:mutbuf,fn0:u64,fs:u64,fi:u64)
  slot_f:u64 = call(fi) {"function":"audit_row_at"}
  row_f:u64 = call(fw,slot_f) {"function":"tr_get"}
  take_f:bool = call(fw,slot_f,fs) {"function":"audit_included"}
  step_f:u64 = const() {"value":1}
  next_f:u64 = int.add.wrap(fi,step_f)
  branch take_f consume(fr,fw,fn0,fs,next_f,row_f) stream(fr,fw,fn0,fs,next_f)
block consume(rr:readbuf,rw:mutbuf,rn:u64,rs:u64,ri:u64,ra:u64)
  hash_off:u64 = const() {"value":40}
  hash_at:u64 = int.add.wrap(ra,hash_off)
  hash_len:u64 = const() {"value":32}
  rc:u64 = call(rr,hash_at,hash_len,rw) {"function":"tr_sha_update"}
  zero:u64 = const() {"value":0}
  ok:bool = compare.eq(rc,zero)
  branch ok stream(rr,rw,rn,rs,ri) failed()
block done(vw:mutbuf)
  rd:u64 = call(vw) {"function":"tr_sha_final"}
  zz:u64 = const() {"value":0}
  digest_ok:bool = compare.eq(rd,zz)
  ret(digest_ok)
block failed()
  broken:bool = const() {"value":false}
  ret(broken)
end

fn audit_reconstruct(r:readbuf,w:mutbuf,n:u64,g:u64,root:u64) -> (u32) effects(read,write,trap) entry(entry)
block entry(r:readbuf,w:mutbuf,n:u64,g:u64,root:u64)
  zero:u64 = const() {"value":0}
  jump chain(r,w,n,g,root,zero)
block chain(cr:readbuf,cw:mutbuf,cn:u64,cg:u64,ct:u64,ci:u64)
  make:bool = call(cr,cw,cn,ci) {"function":"audit_root"}
  branch make verify(cr,cw,cn,cg,ct,ci) internal()
block verify(vr:readbuf,vw:mutbuf,vn:u64,vg:u64,vt:u64,vi:u64)
  previous:bool = call(vr,vw,vi) {"function":"audit_previous_root"}
  branch previous next(vr,vw,vn,vg,vt,vi) tamper()
block next(nr:readbuf,nw:mutbuf,nn:u64,ng:u64,nt:u64,ni:u64)
  done:bool = compare.eq(ni,ng)
  branch done tail(nr,nw,nt) before(nr,nw,nn,ng,nt,ni)
block before(br:readbuf,bw:mutbuf,bn:u64,bg:u64,bt:u64,bi:u64)
  stride:u64 = const() {"value":16}
  base:u64 = const() {"value":2144}
  delta:u64 = int.mul.wrap(bi,stride)
  idx:u64 = int.add.wrap(base,delta)
  at:u64 = call(bw,idx) {"function":"tr_get"}
  agree:bool = call(br,bw,at) {"function":"archive_digest_match"}
  inc:u64 = const() {"value":1}
  nxt:u64 = int.add.wrap(bi,inc)
  branch agree chain(br,bw,bn,bg,bt,nxt) tamper()
block tail(tr:readbuf,tw:mutbuf,tt:u64)
  equal:bool = call(tr,tw,tt) {"function":"archive_digest_match"}
  branch equal pass() tamper()
block pass()
  ok:u32 = const() {"value":0}
  ret(ok)
block tamper()
  wrong:u32 = const() {"value":23}
  ret(wrong)
block internal()
  fault:u32 = const() {"value":103}
  ret(fault)
end

fn audit_previous_root(r:readbuf,w:mutbuf,step:u64) -> (bool) effects(read,write,trap) entry(entry)
block entry(r:readbuf,w:mutbuf,step:u64)
  zero:u64 = const() {"value":0}
  prior:bool = compare.gt(step,zero)
  branch prior check(r,w,step) genesis()
block check(cr:readbuf,cw:mutbuf,cs:u64)
  stripe:u64 = const() {"value":16}
  table:u64 = const() {"value":2136}
  p:u64 = int.mul.wrap(cs,stripe)
  at:u64 = int.add.wrap(p,table)
  after:u64 = call(cw,at) {"function":"tr_get"}
  matches:bool = call(cr,cw,after) {"function":"archive_digest_match"}
  ret(matches)
block genesis()
  yes:bool = const() {"value":true}
  ret(yes)
end
