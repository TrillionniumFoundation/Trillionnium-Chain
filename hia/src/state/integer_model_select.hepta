  branch ascending classify(ai,ao,an,al,ac2,ac3,am,amn,akl,avl,ap,avp) frame_error()
block classify(ci:readbuf,co:mutbuf,cn:u64,cl:u64,cc2:u64,cc3:u64,cm:u64,cmn:u64,ckl:u64,cvl:u64,cp:u64,cvp:u64)
  kind:u64 = call(ci,cp,ckl) {"function":"ims_namespace"}
  oldtag:u64 = const() {"value":2}
  newtag:u64 = const() {"value":3}
  old:bool = compare.eq(kind,oldtag)
  new:bool = compare.eq(kind,newtag)
  selected:bool = bool.or(old,new)
  one:u64 = const() {"value":1}
  zero_c:u64 = const() {"value":0}
  old_add:u64 = select(old,one,zero_c)
  new_add:u64 = select(new,one,zero_c)
  old_sum:u64 = int.add.wrap(cc2,old_add)
  new_sum:u64 = int.add.wrap(cc3,new_add)
  exact_meta_key_len:u64 = const() {"value":85}
  meta_len:bool = compare.eq(ckl,exact_meta_key_len)
  guess_meta:bool = bool.and(meta_len,selected)
  branch guess_meta match_meta(ci,co,cn,cl,old_sum,new_sum,cm,cmn,ckl,cvl,cp,cvp) advance(ci,co,cn,cl,old_sum,new_sum,cm,cmn,ckl,cvl,cp,cvp)
block match_meta(mi:readbuf,mo:mutbuf,mn:u64,ml:u64,mc2:u64,mc3:u64,mm:u64,mmn:u64,mkl:u64,mvl:u64,mp:u64,mvp:u64)
  pref:u64 = const() {"value":81}
  mat:u64 = int.add.wrap(mp,pref)
  four_m:u64 = const() {"value":4}
  suffix:u64 = call(mi,mat,four_m) {"function":"rac_read_le"}
  expected_m:u64 = const() {"value":1635018093}
  yes:bool = compare.eq(suffix,expected_m)
  dst:u64 = select(yes,mvp,mm)
  dst_len:u64 = select(yes,mvl,mmn)
  jump advance(mi,mo,mn,ml,mc2,mc3,dst,dst_len,mkl,mvl,mp,mvp)
block advance(di:readbuf,do:mutbuf,dn:u64,dl:u64,dc2:u64,dc3:u64,dm:u64,dmn:u64,dkl:u64,dvl:u64,dp:u64,dvp:u64)
  one_d:u64 = const() {"value":1}
  remains:u64 = int.sub.wrap(dl,one_d)
  row_end:u64 = int.add.wrap(dvp,dvl)
  jump scan(di,do,dn,row_end,remains,dp,dkl,dc2,dc3,dm,dmn)
block exact(xo:mutbuf,xn:u64,xp:u64,xc2:u64,xc3:u64,xm:u64,xmn:u64)
  consumed:bool = compare.eq(xp,xn)
  branch consumed collision(xo,xc2,xc3,xm,xmn) frame_error()
block collision(bo:mutbuf,bc2:u64,bc3:u64,bm:u64,bmn:u64)
  none:u64 = const() {"value":0}
  nonempty2:bool = compare.ne(bc2,none)
  nonempty3:bool = compare.ne(bc3,none)
  both:bool = bool.and(nonempty2,nonempty3)
  branch both model_collision() missing_check(bo,bc2,bc3,bm,bmn)
block missing_check(cbo:mutbuf,cbc2:u64,cbc3:u64,cbm:u64,cbmn:u64)
  zero_b:u64 = const() {"value":0}
  no_meta:bool = compare.eq(cbm,zero_b)
  branch no_meta model_missing() capacity_check(cbo,cbc2,cbc3,cbm,cbmn)
block capacity_check(fo:mutbuf,fc2:u64,fc3:u64,fm:u64,fmn:u64)
  out_size:usize = buffer.len(fo)
  minout:usize = const() {"value":32}
  enough_out:bool = compare.ge(out_size,minout)
  branch enough_out publish(fo,fc2,fc3,fm,fmn) output_error()
block publish(po:mutbuf,pc2:u64,pc3:u64,pm:u64,pmn:u64)
  z_p:u64 = const() {"value":0}
  eight_p:u64 = const() {"value":8}
  sixteen_p:u64 = const() {"value":16}
  twentyfour:u64 = const() {"value":24}
  private_header:u64 = const() {"value":40}
  offset:u64 = int.sub.wrap(pm,private_header)
  a:u64 = call(po,z_p,pc2) {"function":"ims_write"}
  b:u64 = call(po,eight_p,pc3) {"function":"ims_write"}
  c:u64 = call(po,sixteen_p,offset) {"function":"ims_write"}
  d:u64 = call(po,twentyfour,pmn) {"function":"ims_write"}
  success:u32 = const() {"value":0}
  ret(success)
block model_collision()
  col:u32 = const() {"value":1}
