+              failed=1
+            elif ! python3 scripts/ci/check_required_native_test.py "$PQ_OUT/$label.log" --test "$selector" > "$PQ_OUT/$label-execution.json"; then
+              failed=1
+            fi
+          done
+          for selector in \
+            pon_executor::canonical_comparison_tests::canonical_comparison_matches_independent_serde_bytes_and_every_json_kind \
+            pon_executor::canonical_comparison_tests::canonical_comparison_keeps_complete_value_error_order_before_byte_mismatch \
