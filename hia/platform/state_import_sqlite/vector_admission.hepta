  post_plan_ok:bool = call(raw,after,binding) {"function":"vd_equal_ascii64"}
  pre_schema_ok:bool = call(raw,pre_schema,binding_schema) {"function":"vd_equal_ascii64"}
  post_schema_ok:bool = call(raw,post_schema,binding_schema) {"function":"vd_equal_ascii64"}
  a:bool = bool.and(pre_plan_ok,post_plan_ok)
  b:bool = bool.and(pre_schema_ok,post_schema_ok)
  consistent:bool = bool.and(a,b)
  ret(consistent)
end

