fn hfs_actual_limit(m:mutbuf,profile:u64) -> (u64) effects(read,write,trap) entry(entry)
block entry(m:mutbuf,profile:u64)
  legal:bool = call(profile) {"function":"hfs_long"}
  prior:u64 = call(profile) {"function":"hfs_limit"}
  at:u64 = const() {"value":7002}
  rows:u64 = call(m,at) {"function":"cp_get"}
  choose:u64 = select(legal,rows,prior)
  ret(choose)
end
