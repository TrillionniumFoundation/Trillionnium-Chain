fn cr_between(raw:u64,top:i64) -> (bool) effects(read,write,trap) entry(entry)
block entry(raw:u64,top:i64)
  zero:i64 = const() {"value":0}
  x:i64 = int.cast(raw) {"mode":"wrap"}
  lower:i64 = int.sub.wrap(zero,top)
  g:bool = compare.ge(x,lower)
  l:bool = compare.le(x,top)
  fit:bool = bool.and(g,l)
  ret(fit)
end

fn cr_validate(i:readbuf,start:u64,end_:u64) -> (bool) effects(read,write,trap) entry(entry)
block entry(i:readbuf,start:u64,end_:u64)
  jump row(i,start,end_)
block row(ri:readbuf,ra:u64,re:u64)
  done:bool = compare.eq(ra,re)
  branch done yes() check(ri,ra,re)
block check(ci:readbuf,ca:u64,ce:u64)
  z:u64 = const() {"value":0}
  eight:u64 = const() {"value":8}
  sev:u64 = const() {"value":7}
  two:u64 = const() {"value":2}
  label_at:u64 = int.add.wrap(ca,eight)
  mask:u64 = call(ci,ca) {"function":"cp_read"}
  label:u64 = call(ci,label_at) {"function":"cp_read"}
  has:bool = compare.lt(z,mask)
  limited:bool = compare.le(mask,sev)
  labs:bool = compare.le(label,two)
  proper:bool = bool.and(has,limited)
  fit:bool = bool.and(proper,labs)
  branch fit setup(ci,ca,ce) no()
block setup(si:readbuf,sa:u64,se:u64)
  lane0:u64 = const() {"value":16}
  feature0:u64 = const() {"value":136}
  stride:u64 = const() {"value":2192}
  lp:u64 = int.add.wrap(sa,lane0)
  f:u64 = int.add.wrap(sa,feature0)
  next:u64 = int.add.wrap(sa,stride)
  jump lanes(si,lp,f,next,se)
block lanes(li:readbuf,la:u64,lf:u64,ln:u64,le:u64)
  raw:u64 = call(li,la) {"function":"cp_read"}
  limit:i64 = const() {"value":67368952}
  okay:bool = call(raw,limit) {"function":"cr_between"}
  step:u64 = const() {"value":8}
  nextp:u64 = int.add.wrap(la,step)
  endp:bool = compare.eq(nextp,lf)
  branch okay after_lanes(li,nextp,lf,ln,le,endp) no()
block after_lanes(ai:readbuf,ap:u64,af:u64,an:u64,ae:u64,ad:bool)
  branch ad features0(ai,af,an,ae) lanes(ai,ap,af,an,ae)
block features0(fi:readbuf,ff:u64,fn_:u64,fe:u64)
  eight_:u64 = const() {"value":8}
  bias_at:u64 = int.sub.wrap(fn_,eight_)
  bias:u64 = call(fi,bias_at) {"function":"cp_read"}
  valid_bias:bool = compare.eq(bias,eight_)
  abs0:u64 = const() {"value":0}
  branch valid_bias features(fi,ff,bias_at,fn_,fe,abs0) no()
block features(vi:readbuf,va:u64,vb:u64,vn:u64,ve:u64,vs:u64)
  word:u64 = call(vi,va) {"function":"cp_read"}
  top:i64 = const() {"value":8}
  typed:bool = call(word,top) {"function":"cr_between"}
  branch typed mass(vi,va,vb,vn,ve,vs,word) no()
block mass(ti:readbuf,ta:u64,tb:u64,tn:u64,te:u64,ts:u64,tw:u64)
  zi:i64 = const() {"value":0}
  zu:u64 = const() {"value":0}
  x:i64 = int.cast(tw) {"mode":"wrap"}
  neg:bool = compare.lt(x,zi)
  opp:u64 = int.sub.wrap(zu,tw)
  add:u64 = select(neg,opp,tw)
  acc:u64 = int.add.wrap(ts,add)
  bound:u64 = const() {"value":1024}
  fit2:bool = compare.le(acc,bound)
  branch fit2 feature_next(ti,ta,tb,tn,te,acc) no()
block feature_next(xi:readbuf,xa:u64,xb:u64,xn:u64,xe:u64,xs:u64)
  w:u64 = const() {"value":8}
  next_f:u64 = int.add.wrap(xa,w)
  last:bool = compare.eq(next_f,xb)
  branch last row(xi,xn,xe) features(xi,next_f,xb,xn,xe,xs)
block yes()
  one:bool = const() {"value":true}
  ret(one)
block no()
  none:bool = const() {"value":false}
  ret(none)
end

fn cr_route(i:readbuf,p:u64) -> (u64) effects(read,write,trap) entry(entry)
block entry(i:readbuf,p:u64)
  r0:u64 = const() {"value":40}
  r1:u64 = const() {"value":48}
  r2:u64 = const() {"value":56}
  off0:u64 = int.add.wrap(p,r0)
  off1:u64 = int.add.wrap(p,r1)
  off2:u64 = int.add.wrap(p,r2)
  mask:u64 = call(i,p) {"function":"cp_read"}
  a:u64 = call(i,off0) {"function":"cp_read"}
  b:u64 = call(i,off1) {"function":"cp_read"}
  c:u64 = call(i,off2) {"function":"cp_read"}
  x0:i64 = int.cast(a) {"mode":"wrap"}
  x1:i64 = int.cast(b) {"mode":"wrap"}
  x2:i64 = int.cast(c) {"mode":"wrap"}
  z:u64 = const() {"value":0}
  one:u64 = const() {"value":1}
  two:u64 = const() {"value":2}
  four:u64 = const() {"value":4}
  m0:u64 = bit.and(mask,one)
  m1:u64 = bit.and(mask,two)
  m2:u64 = bit.and(mask,four)
  y0:bool = compare.ne(m0,z)
  y1:bool = compare.ne(m1,z)
  y2:bool = compare.ne(m2,z)
  floor:i64 = const() {"value":-67368953}
  s0:i64 = select(y0,x0,floor)
  s1:i64 = select(y1,x1,floor)
  s2:i64 = select(y2,x2,floor)
  bigger1:bool = compare.gt(s1,s0)
  best:i64 = select(bigger1,s1,s0)
  idx:u64 = select(bigger1,one,z)
  bigger2:bool = compare.gt(s2,best)
  route:u64 = select(bigger2,two,idx)
  ret(route)
end

fn cr_class(i:readbuf,p:u64,route:u64,class:u64,old:u64) -> (u64,u64) effects(read,write,trap) entry(entry)
block entry(i:readbuf,p:u64,route:u64,class:u64,old:u64)
  eight:u64 = const() {"value":8}
  b0:u64 = const() {"value":16}
  d0:u64 = const() {"value":64}
  rsize:u64 = const() {"value":24}
  delta_class:u64 = int.mul.wrap(class,eight)
  base:u64 = int.add.wrap(p,b0)
  base_at:u64 = int.add.wrap(base,delta_class)
  route_delta:u64 = int.mul.wrap(route,rsize)
  delta_base:u64 = int.add.wrap(p,d0)
  selected:u64 = int.add.wrap(delta_base,route_delta)
  delta_at:u64 = int.add.wrap(selected,delta_class)
  base_word:u64 = call(i,base_at) {"function":"cp_read"}
  delta_word:u64 = call(i,delta_at) {"function":"cp_read"}
  merged:u64 = int.add.wrap(base_word,delta_word)
  logit:u64 = int.add.wrap(merged,old)
  signed:i64 = int.cast(logit) {"mode":"wrap"}
  z:i64 = const() {"value":0}
  below:bool = compare.lt(signed,z)
  above:bool = compare.gt(signed,z)
  negative:u64 = const() {"value":18446744073709543424}
  positive:u64 = const() {"value":8192}
  nil:u64 = const() {"value":0}
  up:u64 = select(above,positive,nil)
  direction:u64 = select(below,negative,up)
  three:u64 = const() {"value":3}
  bias:u64 = const() {"value":32768}
  floor_divisor:u64 = const() {"value":4}
  old3:u64 = int.mul.wrap(old,three)
  mix:u64 = int.add.wrap(old3,direction)
  nonnegative:u64 = int.add.wrap(mix,bias)
  quart:u64 = int.div.checked(nonnegative,floor_divisor)
  memory:u64 = int.sub.wrap(quart,positive)
  ret(logit,memory)
end

