  branch loop_done_now good() byte(loop_i,loop_s,loop_a,loop_b,loop_n)
block byte(byte_i:readbuf,byte_s:mutbuf,byte_a:u64,byte_b:u64,byte_n:u64)
  byte_in_at:usize = int.cast(byte_a) {"mode":"wrap"}
  byte_stage_at:usize = int.cast(byte_b) {"mode":"wrap"}
  byte_raw:u8 = buffer.load(byte_i,byte_in_at)
  byte_expected:u8 = buffer.load(byte_s,byte_stage_at)
  byte_same:bool = compare.eq(byte_raw,byte_expected)
