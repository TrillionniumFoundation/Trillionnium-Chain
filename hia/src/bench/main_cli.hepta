block flag_or_arg(fo_i:readbuf,fo_o:mutbuf,fo_n:u64,fo_p:u64,fo_k:u64,fo_e:u64,fo_at:u64,fo_field:u64)
  profile_field:u64 = const() {"value":3}
  persist_field:u64 = const() {"value":7}
