748c21550dda37f69ddc5f9208e9dc07fc384b69 blob 30842
#!/usr/bin/env python3
"""Adversarial reader controls; every positive fixture is explicitly synthetic.

These tests execute no native work, signatures, Host or cgroup. The separate
historical readback uses unchanged retained native report bytes and their pins.
"""
import copy
import hashlib
import json
from pathlib import Path
import tempfile
import unittest

import throughput_cost_coverage as reader
from test_pon_public_v3_phase_read import attribution_phase, lifecycle_record, observed_history_call

HEAD, TREE = 'a' * 40, 'b' * 40


def source():
    return dict(schema='trnm-ci-source-v1', kind='head', candidate=HEAD, tested_commit=HEAD,
                tested_tree=TREE, base=None, prospective_merge=None, tracked_entries=1,
                tracked_bytes=1, tracked_worktree_verified=True,
                tests_executed_by_identity_check=False)


def host_context():
    before = dict(cpu_usage_usec=100, cpu_nr_periods=10, cpu_nr_throttled=2,
                  cpu_throttled_usec=30, memory_current_bytes=64, pids_current=2)
    after = dict(before, cpu_usage_usec=150, cpu_nr_periods=15,
                 cpu_throttled_usec=32, memory_current_bytes=32, pids_current=1)
    return dict(schema='fixed-public-phase-external-actors-v1', phase_pid=1,
        phase_cgroup='/trnmponpublic.slice/synthetic.service',
        controller_cgroup='/system.slice/synthetic-controller.service',
        host_before=before, host_after=after, same_original_receiver_and_verifier_owners=True,
        attackers_launched_by_external_controller=True, runtime_business_deadline_changed=False,
        scalar_policy_changed=False, independent_administration=False, wan_qualified=False)


def report():
    """Producer-shaped observations; the numbers are not measured CPU or bytes."""
    rows = []
    for index, mode in enumerate(reader.phases.MODES):
        record = lifecycle_record(accepted=0, connection=200, task=190)
        record.update(connection_id=1, application_bytes_read=300, application_bytes_written=400,
                      physical_network_bytes=None)
        by_name = {span['phase']: span for span in record['submit_phases']}
        for name, start, end, cpu in [('admission', 20, 80, 50), ('execution', 30, 70, 20),
                                      ('root_commitment', 40, 50, 4)]:
            by_name[name].update(started=True, completed=True, accepted=True,
                                 started_ns=start, ended_ns=end, wall_ns=end-start, thread_cpu_ns=cpu)
        phase = attribution_phase([], [observed_history_call()], [], [record])
        phase.update(mode=mode, whole_parent_phase_cpu_ns=500,
            whole_parent_phase_wall_ns=1000, receiver_and_verifier_setup_cpu_ns=10,
            receiver_and_verifier_setup_wall_ns=20, phase_process_context=host_context(),
            service_outcome={'Ok': dict(pq_authentication_attempts=0, pq_authentication_bytes=0,
                pq_authentication_thread_cpu_ns=0, pq_authentication_unavailable=False,
                mutation_cpu_charged_ns=100, mutation_full_work_cpu_ns=30,
                mutation_dispatch_excluding_work_cpu_ns=70,
                mutation_body_decode_cpu_ns=10, mutation_response_cpu_ns=2)})
        phase['receiver_observation'].update(schema='public-v3-local-request-resource-observation-v4',
            capacity=16384, accepted_connections_seen=1, records_not_retained=0,
            measurement_failures=0, counter_overflow=False, observation_has_consensus_authority=False,
            stream_bytes_are_physical_network_bytes=False, cpu_wait_is_outside_dispatch=True,
            phase_parent_links_are_inclusive=True, monotonic_epoch_is_observer_local=True,
            cpu_includes_reactor_authentication_or_response_signing=True,
            cpu_includes_reactor_authentication=False,
            dispatch_cpu_includes_paid_body_decode=True, dispatch_cpu_includes_response_signing=True)
        rows.append(phase)
    return dict(schema='native-public-v3-separate-process-campaign-v2',
        state_backend='authenticated-v1', finite_experiment_criteria_met=False,
        economics_complete=False, best_observed_cold_legal_method=None,
        preparation=dict(cpu_ns=None, wall_ns=None), phases=rows)


def encoded(value):
    return (json.dumps(value, sort_keys=True, allow_nan=False) + '\n').encode()


class CoverageControls(unittest.TestCase):
    def analyze(self, value=None):
        value = report() if value is None else value
        return reader.analyze(value, hashlib.sha256(encoded(value)).hexdigest())

    def file_inputs(self, value=None):
        temporary = tempfile.TemporaryDirectory(prefix='trnm-cost-reader-control-')
        self.addCleanup(temporary.cleanup)
        root = Path(temporary.name)
        raw = encoded(report() if value is None else value)
        (root / 'report.json').write_bytes(raw)
        for name in ('before.json', 'after.json'):
            (root / name).write_bytes(encoded(source()))
        return root, hashlib.sha256(raw).hexdigest()

    def read(self, root, pin, **kwargs):
        return reader.read_coverage(root/'report.json', root/'before.json', root/'after.json',
            expected_report_sha256=pin, head=HEAD, tree=TREE, **kwargs)

    def test_failed_campaign_and_all_planned_denominators_are_preserved(self):
        result = self.analyze()
        self.assertFalse(result['original_finite_experiment_criteria_met'])
        self.assertEqual([p['mode'] for p in result['phases']], list(reader.phases.MODES))
        for phase in result['phases']:
            self.assertFalse(phase['original_outcome']['native_phase_criteria_met'])
            self.assertEqual(phase['original_outcome']['scheduled_confirmation_rounds'], 3)
            self.assertEqual(phase['original_outcome']['unobserved_scheduled_rounds'], 3)
            self.assertEqual(phase['history']['records'][0]['error'], 'PUBLIC_REQUEST_DEADLINE')
            self.assertFalse(phase['history']['records'][0]['succeeded'])
        self.assertFalse(result['scope']['production_qualification'])
        self.assertIsNone(result['scope']['business_tps_capacity'])

    def test_nested_request_settlement_host_and_process_cpu_are_never_added(self):
        phase = self.analyze()['phases'][0]
        self.assertEqual(phase['phase_process_cpu_ns'], 500)
        self.assertEqual(phase['receiver']['dispatch_thread_cpu_ns']['sum_known'], 100)
        self.assertEqual(phase['receiver']['settlement']['total_cpu_ns']['sum_known'], 170)
        costs = {v['phase']: v for v in phase['receiver']['phases']}
        self.assertEqual(costs['admission']['thread_cpu_ns']['sum_known'], 50)
        self.assertEqual(costs['execution']['parent_phase'], 'admission')
        self.assertEqual(costs['root_commitment']['parent_phase'], 'execution')
        self.assertIsNone(phase['complete_pipeline_cpu_ns'])
        self.assertIsNone(phase['cold_recovery_cpu_ns'])
        self.assertFalse(self.analyze()['scope']['overlapping_cpu_domains_are_added'])

    def test_missing_clock_and_unentered_span_are_not_zero_cost_samples(self):
        value = report()
        record = value['phases'][0]['receiver_observation']['records'][0]
        record['dispatch_thread_cpu_ns'] = None
        result = self.analyze(value)['phases'][0]['receiver']
        self.assertIsNone(result['dispatch_thread_cpu_ns']['sum_known'])
        self.assertIsNone(result['dispatch_thread_cpu_ns']['sum_all_observed'])
        self.assertEqual(result['dispatch_thread_cpu_ns']['unknown_slots'], 1)
        unentered = next(v for v in result['phases'] if v['phase'] == 'history_epoch_open')
        self.assertEqual(unentered['unentered'], 1)
        self.assertEqual(unentered['thread_cpu_ns']['observed_slots'], 0)
        self.assertIsNone(unentered['thread_cpu_ns']['sum_known'])

    def test_unfinished_and_unretained_work_remain_explicit(self):
        value = report()
        observer = value['phases'][0]['receiver_observation']
        observer.update(accepted_connections_seen=3, records_not_retained=2)
        span = next(v for v in observer['records'][0]['submit_phases'] if v['phase'] == 'admission')
        span.update(completed=False, accepted=None)
        result = self.analyze(value)['phases'][0]['receiver']
        self.assertEqual(result['unobserved_records'], 2)
        measured = next(v for v in result['phases'] if v['phase'] == 'admission')
        self.assertEqual(measured['unfinished'], 1)
        self.assertEqual(measured['thread_cpu_ns']['sum_known'], 50)
        self.assertFalse(result['all_request_costs_covered'])

    def test_same_connection_number_across_epochs_is_separate_but_local_duplicates_refuse(self):
        result = self.analyze()
        epochs = [p['receiver']['epoch'] for p in result['phases']]
        self.assertEqual(len(set(epochs)), 3)
        value = report()
        observer = value['phases'][0]['receiver_observation']
        observer['records'].append(copy.deepcopy(observer['records'][0]))
        observer['accepted_connections_seen'] = 2
        with self.assertRaisesRegex(ValueError, 'duplicate receiver identity'):
            self.analyze(value)

    def test_receiver_epoch_and_inclusive_parent_claims_cannot_be_mixed(self):
        for mutation in ('foreign_start', 'foreign_end', 'global_epoch', 'wrong_parent'):
            value = report()
            observer = value['phases'][0]['receiver_observation']
            row = observer['records'][0]
            span = next(v for v in row['submit_phases'] if v['phase'] == 'admission')
            if mutation == 'foreign_start':
                row['lifecycle']['accepted_ns'] = 25
            elif mutation == 'foreign_end':
                span.update(ended_ns=250, wall_ns=230)
            elif mutation == 'global_epoch':
                observer['monotonic_epoch_is_observer_local'] = False
            else:
                next(v for v in row['submit_phases'] if v['phase'] == 'root_commitment')['parent_phase'] = 'admission'
            with self.subTest(mutation=mutation), self.assertRaises(ValueError):
                self.analyze(value)

    def test_history_epoch_stays_separate_and_wrong_host_scope_refuses(self):
        result = self.analyze()['phases'][0]
        native = result['history']['records'][0]
        self.assertNotEqual(native['epoch'], result['receiver']['epoch'])
        self.assertEqual(native['native_snapshot']['phases'][16]['phase'], 'history_import')
        self.assertIsNone(result['history']['cold_recovery_cpu_ns'])
        value = report()
        value['phases'][0]['history'][0]['client_import']['native_import_observation']['host_cpu_is_full_worker_cpu'] = True
        with self.assertRaisesRegex(ValueError, 'IMPORT_OBSERVATION_SCOPE'):
            self.analyze(value)

    def test_stream_byte_counts_cannot_be_promoted_to_physical_network_cost(self):
        result = self.analyze()['phases'][0]['receiver']
        self.assertEqual(result['application_bytes_read']['sum_known'], 300)
        self.assertIsNone(result['physical_network_bytes'])
        for mutation in ('stream_flag', 'physical_count'):
            value = report()
            observer = value['phases'][0]['receiver_observation']
            if mutation == 'stream_flag':
                observer['stream_bytes_are_physical_network_bytes'] = True
            else:
                observer['records'][0]['physical_network_bytes'] = 700
            with self.subTest(mutation=mutation), self.assertRaises(ValueError):
                self.analyze(value)

    def test_zero_pq_attempts_remain_zero_and_absent_metrics_remain_unknown(self):
        pq = self.analyze()['phases'][0]['listener']['pq_authentication']
        self.assertEqual(pq['pq_authentication_attempts'], 0)
        self.assertEqual(pq['pq_authentication_thread_cpu_ns'], 0)
        self.assertEqual(pq['missing_fields'], [])
        value = report()
        value['phases'][0]['service_outcome']['Ok'].pop('pq_authentication_thread_cpu_ns')
        pq = self.analyze(value)['phases'][0]['listener']['pq_authentication']
        self.assertIsNone(pq['pq_authentication_thread_cpu_ns'])
        self.assertEqual(pq['missing_fields'], ['pq_authentication_thread_cpu_ns'])

    def test_inconsistent_mutation_settlement_and_numeric_boolean_clocks_refuse(self):
        for field, observed in [('mutation_cpu_charged_ns', 200),
                                ('pq_authentication_thread_cpu_ns', True),
                                ('pq_authentication_unavailable', 0)]:
            value = report()
            value['phases'][0]['service_outcome']['Ok'][field] = observed
            with self.subTest(field=field), self.assertRaises(ValueError):
                self.analyze(value)

    def test_host_delta_is_local_memory_points_are_not_delta_or_peak(self):
        result = self.analyze()['phases'][0]['fixed_parent']
        self.assertEqual(result['counter_deltas']['cpu_usage_usec'], 50)
        self.assertNotIn('memory_current_bytes', result['counter_deltas'])
        self.assertNotIn('pids_current', result['counter_deltas'])
        self.assertEqual(result['context']['host_after']['memory_current_bytes'], 32)
        self.assertIsNone(result['serialized_boot_identity'])
        for mutation in ('cpu_rewind', 'merged_owner', 'foreign_profile', 'parent_path', 'empty_path'):
            value = report()
            context = value['phases'][0]['phase_process_context']
            if mutation == 'cpu_rewind':
                context['host_after']['cpu_usage_usec'] = 99
            elif mutation == 'merged_owner':
                context['controller_cgroup'] = context['phase_cgroup']
            elif mutation == 'foreign_profile':
                context['schema'] = 'other-resource-profile'
            elif mutation == 'parent_path':
                context['controller_cgroup'] = '/system.slice/../trnmponpublic.slice/hidden'
            else:
                context['phase_cgroup'] = '/trnmponpublic.slice//child'
            with self.subTest(mutation=mutation), self.assertRaises(ValueError):
                self.analyze(value)

    def test_incomplete_phase_does_not_delete_original_failure_denominator(self):
        value = report()
        value['phases'][1] = dict(mode='from-zero', state_backend='authenticated-v1',
                                 finite_phase_criteria_met=False, startup_or_campaign_error='FAILED_START')
        phase = self.analyze(value)['phases'][1]
        self.assertEqual(phase['original_outcome']['startup_or_campaign_error'], 'FAILED_START')
        self.assertEqual(phase['original_outcome']['unobserved_scheduled_rounds'], 3)
        self.assertIsNone(phase['receiver'])
        self.assertIsNone(phase['phase_process_cpu_ns'])

    def test_sources_reports_and_prospective_merge_identity_are_exact(self):
        root, pin = self.file_inputs()
        result = self.read(root, pin)
        self.assertEqual(result['source']['tested_commit'], HEAD)
        self.assertEqual(result['input']['report_sha256'], pin)
        wrong = source()
        wrong['tested_tree'] = 'c' * 40
        (root/'after.json').write_bytes(encoded(wrong))
        with self.assertRaisesRegex(ValueError, 'unchanged complete source'):
            self.read(root, pin)
        (root/'before.json').write_bytes(encoded(wrong))
        with self.assertRaisesRegex(ValueError, 'pinned source'):
            self.read(root, pin)
        base, merge = 'd' * 40, 'e' * 40
        prospective = dict(source(), kind='prospective-merge', base=base,
                           prospective_merge=merge, tested_commit=merge)
        for name in ('before.json', 'after.json'):
            (root/name).write_bytes(encoded(prospective))
        result = self.read(root, pin, kind='prospective-merge', base=base, merge=merge)
        self.assertEqual(result['source']['tested_commit'], merge)
        with self.assertRaisesRegex(ValueError, 'pinned source'):
            self.read(root, pin, kind='prospective-merge', base=base, merge='f' * 40)

    def test_changed_report_and_symlinked_input_cannot_reuse_source_receipts(self):
        root, pin = self.file_inputs()
        with self.assertRaisesRegex(ValueError, 'report SHA256 mismatch'):
            self.read(root, '0' * 64)
        original = (root/'report.json').read_bytes()
        (root/'report.json').write_bytes(original+b' ')
        with self.assertRaisesRegex(ValueError, 'report SHA256 mismatch'):
            self.read(root, pin)
        (root/'report.json').unlink()
        (root/'other.json').write_bytes(original)
        (root/'report.json').symlink_to(root/'other.json')
        with self.assertRaises((ValueError, OSError)):
            self.read(root, pin)

    def test_duplicate_keys_nonfinite_numbers_and_truncated_json_refuse(self):
        for raw in (b'{"schema":1,"schema":2}', b'{"x":NaN}', b'{"schema":'):
            root, _ = self.file_inputs()
            (root/'report.json').write_bytes(raw)
            with self.subTest(raw=raw), self.assertRaises(ValueError):
                self.read(root, hashlib.sha256(raw).hexdigest())

    def test_unknown_or_mixed_report_profiles_and_phase_order_refuse(self):
        for mutation in ('schema', 'backend', 'unknown_backend', 'phase_order'):
            value = report()
            if mutation == 'schema':
                value['schema'] = 'unrecognized'
            elif mutation == 'backend':
                value['phases'][1]['state_backend'] = 'other'
            elif mutation == 'unknown_backend':
                value['state_backend'] = 'other'
                for phase in value['phases']:
                    phase['state_backend'] = 'other'
            else:
                value['phases'][1], value['phases'][2] = value['phases'][2], value['phases'][1]
            with self.subTest(mutation=mutation), self.assertRaises(ValueError):
                self.analyze(value)

    def test_bad_collection_shapes_and_oversized_epochs_refuse_before_analysis(self):
        for mutation in ('missing_preparation', 'invalid_phase', 'invalid_record',
                         'receiver_capacity', 'history_capacity', 'invalid_import'):
            value = report()
            phase = value['phases'][0]
            if mutation == 'missing_preparation':
                value['preparation'] = None
            elif mutation == 'invalid_phase':
                value['phases'][0] = None
            elif mutation == 'invalid_record':
                phase['receiver_observation']['records'] = [None]
            elif mutation == 'receiver_capacity':
                phase['receiver_observation']['records'] *= reader.MAX_RECORDS + 1
            elif mutation == 'history_capacity':
                phase['history'] *= 65
            else:
                phase['history'][0]['client_import'] = 'unexpected'
            with self.subTest(mutation=mutation), self.assertRaises(ValueError):
                reader.analyze(value, '1' * 64)

    def test_legacy_import_costs_keep_calling_thread_scope(self):
        value = report()
        imported = value['phases'][0]['history'][0]['client_import']
        imported.pop('native_import_observation')
        result = self.analyze(value)['phases'][0]['history']
        self.assertEqual(result['imports_without_native_snapshot'], 1)
        self.assertIsNone(result['host_checks'][0]['thread_cpu_ns']['sum_known'])
        imported['scope'] = 'entire process including all workers'
        with self.assertRaisesRegex(ValueError, 'calling-thread CPU scope'):
            self.analyze(value)



def confirmation_round(index, *, transaction=None, confirmed=True, end_ns=None):
    """Synthetic complete native-confirmation shape, never executed work."""
    transaction = transaction or f'{index + 1:064x}'
    included, tip = f'{index + 10:064x}', f'{index + 20:064x}'
    start = (1 + 4 * index) * 1_000_000_000
    observation = dict(transaction=transaction, included_block=included, observed_tip=tip,
        confirmed=True, reorged=False, finalized=False, execution_authority=False,
        depth=6, included_height=1 + 7 * index, observed_height=7 + 7 * index,
        work_delta=f'{6:0128x}', required_work_delta=f'{6:0128x}') if confirmed else None
    return dict(round=index, started_ns=start,
        ended_ns=start + 1_000_000_000 if end_ns is None else end_ns,
        transaction=transaction, included_block=included, tip=tip,
        confirmed_inside_pressure_window=confirmed, observation=observation)


def with_confirmation_rounds(value, rows):
    phase = value['phases'][0]
    phase['confirmations'] = rows
    phase['all_signed_rounds_confirmed_in_window'] = (
        len(rows) == reader.phases.ROUNDS
        and all(row['confirmed_inside_pressure_window'] is True for row in rows))
    return value


class FiniteBusinessControls(unittest.TestCase):
    def analyze(self, value=None):
        value = report() if value is None else value
        return reader.analyze(value, hashlib.sha256(encoded(value)).hexdigest())

    def test_unique_confirmations_keep_failed_unobserved_and_retry_denominators(self):
        value = with_confirmation_rounds(report(), [
            confirmation_round(0), confirmation_round(1, confirmed=False)])
        retry = copy.deepcopy(value['phases'][0]['history'][0])
        retry.update(status='refused', response={'value': {'error': 'SYNTHETIC_RETRY'}})
        retry.pop('client_import')
        value['phases'][0]['submissions'] = [copy.deepcopy(retry), copy.deepcopy(retry)]
        output = self.analyze(value)
        self.assertEqual(output['schema'], 'pon-throughput-cost-coverage-v2')
        business = output['phases'][0]['business']
        self.assertEqual(business['native_confirmed_rounds'], 1)
        self.assertEqual(business['native_unconfirmed_rounds'], 1)
        self.assertEqual(business['unobserved_scheduled_rounds'], 1)
        self.assertEqual(business['observed_unique_confirmed_transactions'], 1)
        self.assertEqual(business['window_ns'], 30_000_000_000)
        self.assertAlmostEqual(business['observed_confirmed_tps'], 1 / 30)
        self.assertEqual(business['observed_round_nonconfirmation_fraction'],
                         {'numerator': 1, 'denominator': 2})
        self.assertEqual(business['request_attempts']['submit']['attempts'], 2)
        self.assertEqual(business['request_attempts']['submit']['acknowledged_on_time'], 0)
        self.assertFalse(business['scope']['rate_is_capacity_estimate'])
        self.assertFalse(business['scope']['unobserved_slots_are_failed_samples'])
        self.assertIsNone(output['scope']['business_tps_capacity'])

    def test_repeated_transaction_ids_do_not_turn_rounds_into_tps(self):
        value = with_confirmation_rounds(report(), [
            confirmation_round(index, transaction='ab' * 32) for index in range(3)])
        business = self.analyze(value)['phases'][0]['business']
        self.assertEqual(business['native_confirmed_rounds'], 3)
        self.assertEqual(business['observed_unique_confirmed_transactions'], 1)
        self.assertEqual(business['independently_checked_confirmed_transaction_ids'], ['ab' * 32])
        self.assertAlmostEqual(business['observed_confirmed_tps'], 1 / 30)

    def test_missing_transaction_or_independent_confirmation_is_unknown_not_ack_credit(self):
        for mutation in ('transaction', 'observation', 'ack_only', 'round_time'):
            value = with_confirmation_rounds(report(), [confirmation_round(0)])
            # Derive only the unchanged request/availability context from valid input.
            derived = reader.phases.analyze(value)['phases'][0]
            row = value['phases'][0]['confirmations'][0]
            if mutation == 'ack_only':
                row['observation'] = {'status': 'ok', 'acknowledged': True}
            elif mutation == 'round_time':
                row['started_ns'] = None
            else:
                row[mutation] = None
            with self.subTest(mutation=mutation):
                # The same production helper retains unknown/no-credit semantics.
                # The full current analyzer refuses these claimed-success inputs;
                # its separate control below preserves that stricter boundary.
                business = reader.finite_business_observation(
                    value['phases'][0], derived,
                    hashlib.sha256(encoded(value)).hexdigest() + '/phases/0')
                self.assertEqual(business['native_confirmed_rounds'], 1)
                self.assertIsNone(business['observed_unique_confirmed_transactions'])
                self.assertIsNone(business['observed_confirmed_tps'])
                self.assertTrue(business['rate_unknown_reasons'])
                self.assertFalse(business['rounds'][0]['independent_confirmation_fields_verified'])

    def test_current_analyzer_refuses_incomplete_claimed_confirmation_fields(self):
        # Current V4 rejects incomplete success claims before cost aggregation.
        # These are the four old whole-reader success expectations deliberately
        # superseded by the selected current identity and clock contract.
        for mutation in ('transaction', 'observation', 'ack_only', 'round_time'):
            value = with_confirmation_rounds(report(), [confirmation_round(0)])
            row = value['phases'][0]['confirmations'][0]
            if mutation == 'ack_only':
                row['observation'] = {'status': 'ok', 'acknowledged': True}
            elif mutation == 'round_time':
                row['started_ns'] = None
            else:
                row[mutation] = None
            with self.subTest(mutation=mutation), self.assertRaises(ValueError):
                self.analyze(value)

    def test_missing_failure_identity_and_no_observations_never_become_zero_tps(self):
        value = with_confirmation_rounds(report(), [confirmation_round(0, confirmed=False)])
        value['phases'][0]['confirmations'][0]['transaction'] = None
        for sample in (value, report()):
            with self.subTest(sample=sample['phases'][0]['confirmations']):
                business = self.analyze(sample)['phases'][0]['business']
                self.assertIsNone(business['observed_confirmed_tps'])
                self.assertTrue(business['rate_unknown_reasons'])
        value['phases'][0] = dict(mode='baseline', state_backend='authenticated-v1',
            finite_phase_criteria_met=False, startup_or_campaign_error='SYNTHETIC_STARTUP_FAILURE')
        business = self.analyze(value)['phases'][0]['business']
        self.assertIsNone(business['window_ns'])
        self.assertIsNone(business['observed_confirmed_tps'])
        self.assertIsNone(business['native_unconfirmed_rounds'])
        self.assertEqual(business['unobserved_scheduled_rounds'], 3)

    def test_failed_late_round_keeps_full_elapsed_and_fixed_window(self):
        value = with_confirmation_rounds(report(), [
            confirmation_round(0, confirmed=False, end_ns=31_000_000_000)])
        business = self.analyze(value)['phases'][0]['business']
        self.assertEqual(business['window_ns'], 30_000_000_000)
        self.assertEqual(business['observed_unique_confirmed_transactions'], 0)
        self.assertEqual(business['observed_confirmed_tps'], 0)
        self.assertEqual(business['unconfirmed_round_wall_ns']['max_ns'], 30_000_000_000)
        self.assertEqual(business['all_observed_scheduled_to_terminal_ns']['max_ns'], 30_000_000_000)
        self.assertEqual(business['confirmed_round_wall_ns']['known_count'], 0)
        self.assertEqual(business['unobserved_scheduled_rounds'], 2)

    def test_confirmation_identity_depth_work_flags_and_local_clock_are_checked(self):
        for mutation in ('transaction', 'included_block', 'observed_tip', 'depth', 'height',
                         'work', 'zero_required', 'reorg', 'finalized', 'authority',
                         'outside_window', 'rewind', 'cross_epoch', 'boolean'):
            value = with_confirmation_rounds(report(), [confirmation_round(0)])
            row = value['phases'][0]['confirmations'][0]
            observation = row['observation']
            if mutation in ('transaction', 'included_block', 'observed_tip'):
                observation[mutation] = 'ff' * 32
            elif mutation == 'depth':
                observation['depth'] = 5
            elif mutation == 'height':
                observation['observed_height'] = 6
            elif mutation == 'work':
                observation['work_delta'] = f'{5:0128x}'
            elif mutation == 'zero_required':
                observation['required_work_delta'] = '0' * 128
            elif mutation in ('reorg', 'finalized', 'authority'):
                observation[{'reorg': 'reorged', 'finalized': 'finalized',
                             'authority': 'execution_authority'}[mutation]] = True
            elif mutation == 'outside_window':
                row['ended_ns'] = 30_000_000_000
            elif mutation == 'rewind':
                row['ended_ns'] = row['started_ns'] - 1
            elif mutation == 'cross_epoch':
                row['started_ns'] = 0
            else:
                row['confirmed_inside_pressure_window'] = 1
            with self.subTest(mutation=mutation), self.assertRaises(ValueError):
                self.analyze(value)

    def test_confirmation_shape_is_bounded_before_shared_analysis(self):
        for rows in (None, [None], [confirmation_round(0)] * 4):
            value = report()
            value['phases'][0]['confirmations'] = rows
            with self.subTest(rows=rows), self.assertRaisesRegex(ValueError, 'bounded confirmation'):
                self.analyze(value)

    def test_process_memory_retains_point_and_lifetime_scope_without_request_peak(self):
        value = report()
        value['phases'][0]['rss'] = dict(rss_bytes=128, lifetime_peak_rss_bytes=256,
            kernel_rusage_self_peak_rss_bytes=None,
            scope='Linux /proc/self magic self and kernel RUSAGE_SELF; peak is whole process lifetime, '
                  'not an isolated allocation or incremental memory bound')
        phase = self.analyze(value)['phases'][0]
        self.assertEqual(phase['phase_process_memory']['rss_bytes'], 128)
        self.assertEqual(phase['phase_process_memory']['lifetime_peak_rss_bytes'], 256)
        self.assertIsNone(phase['phase_process_memory']['kernel_rusage_self_peak_rss_bytes'])
        self.assertFalse(phase['phase_process_memory']['per_request_peak_measured'])
        self.assertIsNone(phase['request_peak_rss_bytes'])
        self.assertIsNone(self.analyze()['phases'][0]['phase_process_memory'])
        value['phases'][0]['rss']['scope'] = 'per-request exact physical peak'
        with self.assertRaisesRegex(ValueError, 'memory scope'):
            self.analyze(value)

if __name__ == '__main__':
    unittest.main()

75f881e987ecb0d7ee7d63ea04c5b5ebc37dd9b7 blob 21527
# Joint lifetime obligation review and conditional root composition V2

Status: **research only; HOLD / NO-GO**. The actual lifetime failure bound is
still unknown. This change checks the relationship between two reviewed source
inventories and implements conditional probability arithmetic. It does not
prove a complete security experiment, a concrete cryptographic reduction, an
adversary resource budget, or production qualification.

The initial review baseline was [PR #837](https://github.com/TrillionniumFoundation/Trillionnium-Chain/pull/837)
at [44330b91eb552fd20ef6f2e69bf5e6f1e8f5c0b0](https://github.com/TrillionniumFoundation/Trillionnium-Chain/commit/44330b91eb552fd20ef6f2e69bf5e6f1e8f5c0b0).
The new [machine register](../../config/pon/pq128-lifetime-composition-v2.json),
[checker](../../scripts/ci/pq_lifetime_composition.py), and
[tests](../../scripts/ci/test_pq_lifetime_composition.py) preserve the existing
[V1 lifetime contract](PQ128_LIFETIME_BUDGET_V1.md) and
[root dependency contract](PQ_ROOT_DEPENDENCY_REGISTER_V3.md).

## 1. What the source bridge establishes

The current legacy V1 budget declares **21 source paths** at
`0f9b30549328e5be20f4d3e6e27bd132b42d90de`. The current root inventory
declares **45 paths**, reviewed at the SQLite cleanup source commit
`975af9eb4a7f15b405de602552fa05021a176c11`. The journal source changes;
the other 44 source hashes retain the reviewed bytes from
`57b069ae1e7ed32ff95e4f2a18a74d5eadcda550`. This mapping's review context is
the actual client-construction source checkpoint
`0f9b30549328e5be20f4d3e6e27bd132b42d90de`. Child manifest bytes are independently
frozen in the bridge; a review context does not attest the commit containing
the metadata update or a native execution.

The V2 inspector requires both exact manifest identities, invokes both existing
inspectors, checks every overlapping source digest, and reports the union:

| Inventory | Declared paths |
| --- | ---: |
| Legacy lifetime | 21 |
| Root and provider/witness continuation | 45 |
| Shared path | 1 |
| Distinct union | 65 |

The sole shared path remains
`trillionnium/crates/trnm-release-bundle/src/pq_release.rs`; the checker
requires its exact identity as well as all four counts. The role population
now explicitly contains the existing sixth `witness-response` role, with
2-of-3 in each family. This aligns the mapping with the current root input;
it changes no quorum or arithmetic rule. All six lifetime populations remain
unknown and the threshold-to-forgery reduction remains uninstantiated.

The previous 15/37/51 mapping, five-role population and input identities are
retained as historical inputs, not accepted as current ones. They used legacy
revision `12e510b211110d93d9ead07e02c07a1eecc28ae9` and root review context
`57e6c17ae2fa8a9cc547e271f34d90ef09115f04`, with manifest SHA-256 digests
`87108ad195c79d17eebbc0f34e320f7141763b507487cc82a3f62d5945fb9b23` and
`eedc1db827d97aab0be4c43e58713a2e2f2a3d0331e045a509f0941557834028`.
Current child manifest SHA-256 digests are
`0315e07ca2988b3b209a6fd2980ca6d9aa22a5bb3aa98b5444a041852b2f0afd` and
`d973cb827537c5b852370da6e4e916afc0f52ccdadb2f2c051ed2b9e041f40c8`, respectively.
Added controls explicitly
reject the old input pins and the omitted witness population.

The immediately preceding root review context
`b683714cdd5ba241c16c335a81aebc12c1581902` and root-manifest SHA-256
`a94b3e01c8a78a796496182dc268fe23b6fe844e27edec7553876c735ce37cc8` remain historical identities.
That preceding source continuation changed only the root inventory's crypto
export digest to the reviewed typed weak-key error implementation. At that
step it left the legacy 21-path input and source lock unchanged. The bridge retains the
same 21/45/1/65 path counts, four shared primitive scopes, six unknown role
populations and conditional arithmetic. Both superseded root identity fields
are now explicit refusal cases; neither a new source label nor a passing
inventory supplies runtime or production qualification.

The client-construction continuation changes one of the 21 legacy source
digests and the legacy source checkpoint. All 45 root source bytes, the root
manifest bytes and its declared review context remain unchanged. The prior
legacy revision `2bb56596e637908c44b5a2ef5984c9c37c7d3cc8` and manifest SHA-256
`3ed0e9d451ff885fb27a4a6f7449ca9050eb44707d801a3a40d675fcf5ceaed4` remain historical identities;
both are explicit refusal cases for the current bridge. The private timing
change includes PQ pin preparation in diagnostics and preserves the original
caller deadline. It changes no event roster, allocation, primitive scope,
quorum, operational maximum or qualification field.

The subsequent SQLite cleanup continuation moves the existing journal setup
PRAGMAs inside its existing close guard. It updates only that source digest
in the 45-path root inventory and the exact root input binding here. The prior
root review context `57b069ae1e7ed32ff95e4f2a18a74d5eadcda550` and manifest digest
`4144d308e76fd73f14c197765e354273059bfc8f7480541eaa3f715c31b132cf`
remain historical identities. The legacy input, 21/45/1/65 counts, roles,
conditional arithmetic, limits, unknowns and false qualification fields remain.

An exact manifest change requires a new review. One source map cannot silently
overwrite the other. Missing inputs, locks, sources, changed bytes, conflicting
digests and attempted qualification changes are refused. The existing
descriptor-bound regular-file reader remains in use.

`declared_source_union_consistent=true` means consistency of these reviewed
declarations and the bytes inspected. It does not establish an atomic snapshot
across separate reads, authenticated Git history, deployed executable identity,
complete call-graph coverage, transitive dependencies, trusted custody, or an
implementation-to-theorem refinement. The joint report deliberately keeps
`source_revision_bound=false`, `deployment_identity_proved=false`, and
`transitive_dependency_closure_proved=false`.

## 2. Public primitive identities have one shared scope

Both input registers refer to the same four fixed public primitive identities:

| Shared scope | Public parameter identity |
| --- | --- |
| SHA-256 | `FIPS180-4/SHA-256` |
| SHA-512 | `FIPS180-4/SHA-512` |
| SHAKE128 | `FIPS202/SHAKE128` |
| SHAKE256 | `FIPS202/SHAKE256` |

The bridge retains each legacy term and each root use group under these four
identities. It does not create eight independent query budgets merely because
there are two registers. It neither adds nor takes a minimum of their budgets.
All four maxima and query-unit mappings remain unknown. A changed maximum,
unit, fixed-public identity, or reset policy requires an explicit new review.
Registration, role changes, key rotation, recovery and epoch changes do not
restart preprocessing or the lifetime scope.

The existing root inventory already records the actual algorithm dependencies:
ML-DSA uses SHAKE128 and SHAKE256; SLH-DSA-SHA2-256s uses both SHA-256 and
SHA-512, including HMAC-SHA-512 and MGF1-SHA-512. This V2 bridge connects that
inventory to the older scope; it does not claim to have newly implemented those
cryptographic dependencies. See [FIPS 204, section 3.7](https://nvlpubs.nist.gov/nistpubs/FIPS/NIST.FIPS.204.pdf)
and [FIPS 205, section 11.2.2](https://nvlpubs.nist.gov/nistpubs/FIPS/NIST.FIPS.205.pdf).

A separate obligation now records the shared `KECCAK-p[1600,24]` substrate of
SHAKE128 and SHAKE256. [FIPS 202](https://nvlpubs.nist.gov/nistpubs/FIPS/NIST.FIPS.202.pdf)
specifies these different modes over that permutation. Their interface names
alone do not prove independent random oracles. One XOF call, a squeeze block,
and a permutation call are different units; no equation adds these counts
without a justified resource transformation. The substrate mapping and joint
oracle replacement error remain unknown. Other SHA3 proof profiles are not
included by this declaration.

## 3. Root AND composition and the location of losses

Fix one complete experiment, adversary class and lifetime. Let `C` be a common
failure event, and let `B_ML` and `B_SLH` be failures of the complete threshold
family games. The required project relation is:

\[
\mathrm{Bad}_{root}\subseteq C\cup(B_{ML}\cap B_{SLH}).
\]

This relation is an open project obligation. In particular, it requires the
same full statement, purpose, current roster, thresholds, distinct signers,
successor possession, policy transition and owner authority. Corruption,
custody, rollback, revocation, retained liabilities and actual external effects
cannot be removed by describing the verification rule as AND.

Suppose the family bounds, after their own reductions, are valid in the same
game. If their event and reduction errors are respectively
`epsilon_ML, delta_ML` and `epsilon_SLH, delta_SLH`, the conservative rule is:

\[
\epsilon_{root}^{declared}
=\min\!\left(1,\delta_C+\delta_{shared}
+\min(\epsilon_{ML}+\delta_{ML},\epsilon_{SLH}+\delta_{SLH})\right).
\]

`delta_shared` denotes one separately justified common-game replacement loss.
The theorem game, resource expansion and placement of that loss must actually
apply; the checker only validates matching declarations. The proof of the
probability rule uses the union bound and the fact that an intersection is
contained in each member. Neither step requires independent events.

The family-specific loss belongs in its own branch before taking the minimum.
For example, with family pairs `(1/64, 1/4096)` and `(1/4096, 1/64)`, both
complete family sums are `65/4096`. Selecting the minimum event error and the
minimum reduction error separately would produce `2/4096`, which is not the
bound supplied by either family. The tests exercise this distinction.

The default API does not implement multiplication of family probabilities.
Taking `B_ML = B_SLH` with probability `p` gives intersection probability `p`,
not `p squared`. A caller-supplied `independent=true` is not a proof and is
refused. The 2-of-3 rule also does not create a square automatically: the
corruption model and reduction from threshold acceptance to multi-user forgery
must be established. Successor possession uses all three keys in each family;
the arithmetic declaration retains that separate role scope.

## 4. Unknown inputs remain visible

The root arithmetic API has six mandatory inputs: two family event bounds,
their two reduction losses, common failure, and shared game replacement.

| Condition | Arithmetic behavior |
| --- | --- |
| A family event or its reduction loss is unknown | That family's complete bound stays unknown |
| One complete family has a valid declared bound | It can bound the intersection; the other unknown remains listed |
| Common failure or shared replacement is unknown | The complete conditional root bound remains unknown |
| A zero loss is claimed | It must be explicitly declared with its unverified theorem reference |
| A probability sum exceeds one | Keep the exact uncapped sum and report a final probability upper bound capped at one |
| Input fields claim product, verification or independence | Refuse the unsupported contract |

All arithmetic uses the existing bounded exact rational implementation. A
reference, locator or applicability string is review input, not a theorem
verifier. Numeric declarations, including extremely small caller-supplied
values, remain unverified. Matching experiment labels establish only label
agreement. They do not establish that the underlying games, auxiliary quantum
states, profiles or reductions are compatible.

`review_arithmetic(data)` accepts the closed research-model or arithmetic-example
contract. `validate_manifest(data)` checks declarations only and never reports
source inspection. `inspect(root, manifest)` additionally invokes the two real
source inspectors. None of these APIs produces an actual lifetime failure bound.

## 5. Resource conversion still needs evidence

Each common/shared/family resource instance now has explicit unknown fields for
total adversary queries, online queries, offline search, preprocessing, honest
queries, simulator and extractor queries, classical advice bits, quantum advice
qubits, keys, rosters, epochs, signing queries and verification attempts.

The coverage labels include failed, cancelled, rejected and unpublished work,
helpers, recursion, shared uses and authority surviving retirement. These labels
overlap. They are a coverage checklist, not disjoint bins to sum. In particular,
an offline failed query may also be a shared-primitive query. Quantum access
models and resource units must be fixed before a numeric transformation is used.
Whether honest, simulator and extractor work enters a theorem's query count is
theorem dependent. Unknown advice does not mean no advice.

An honest node's timeout, message-size limit, local signature cap or observed
receipts cannot bound work on an adversary's external machines. Those limits
remain useful operational controls, but the total adversary resource bound
requires a separate justified model or explicitly stated external assumption.

### 5.1 Bounded-query theorems require a resource-tail term

The separate `default_query_tail_arithmetic()` and
`review_query_tail_arithmetic(data)` API now records three mandatory terms.
The normal inspector includes its unknown default report under
`conditional_query_tail_arithmetic`. It does not change either input manifest,
transfer a component estimate, or supply a numeric query maximum.

Suppose a complete experiment defines a total lifetime resource random variable
`Q`, a fixed threshold `q`, and a protected failure event `Bad`. Set
`O = {Q > q}`. The disjoint event partition gives

\[
\Pr[Bad] = \Pr[Bad \cap O^c] + \Pr[Bad \cap O]
\leq \Pr[Bad \cap \{Q\leq q\}] + \Pr[Q>q].
\]

If an applicable bounded-game argument and its project reduction give
`Pr[Bad intersection {Q<=q}] <= epsilon + delta`, the resulting conditional
accounting rule is

\[
\Pr[Bad]\leq\min(1,\epsilon+\Pr[Q>q]+\delta).
\]

No event independence is needed. These hypotheses are not established for the
project. In particular, a theorem about an algorithm truncated at `q` queries
is not by itself a bound on the original experiment's joint event. Its lift
must be justified in the stated quantum access, advice and resource model.
No observation or measurement of a quantum state is added by this arithmetic.
The underlying experiment must first define the resource variable and show
that its event partition and bounded-game comparison apply.

| Required input | Meaning |
| --- | --- |
| `bounded_query_failure` | Declared bounded-game contribution to the joint event `Bad intersection {Q<=q}` |
| `query_budget_overrun` | Declared bound on `Pr[Q>q]` over the same full lifetime |
| `bounded_game_reduction_loss` | Separate loss connecting that bounded game to the project event |

Each input repeats the same explicit maximum and query unit. Numeric inputs
require both; missing inputs, conflicting units/maxima, incomplete theorem
declarations, unsupported fields and self-verified claims are refused. A zero
tail or zero reduction loss requires an explicit unverified declaration.
Unknown terms keep the complete conditional result null. A known subtotal and
signed remaining target are reported separately, so known charges exceeding
the target remain visible even when another term is unknown. A negative
remaining target means these declarations exceed the arithmetic allocation;
it is not a measured failure probability or evidence of an attack.

The fixed coverage checklist retains prior preprocessing, online/offline work,
failed/cancelled/rejected/unpublished work, helpers, recursion, shared uses,
all keys/epochs, authority surviving retirement and initial classical/quantum
advice. Overlapping labels are not additive query bins. Matching labels and
units do not prove complete coverage, authenticate initial advice, convert
interface calls to substrate queries, or bound external machines. Node limits
and key/epoch/recovery resets cannot establish the global tail bound.

With a bounded-game contribution exactly `2^-128`, any positive tail or loss
outside that contribution exceeds that target. The tests retain a `2^-512`
tail exactly rather than rounding it away. This is a conditional arithmetic
example; no project term has acquired that value. The new report is not added
to, or substituted into, the root or legacy eight-domain results.

`resource_random_variable_defined_for_project`,
`bounded_game_to_project_reduction_proved`, `theorem_applicability_verified`,
`composition_coverage_proved` and `whole_chain_hash_query_scope_closed` remain
false. `actual_lifetime_failure_bound` remains null, and whole-chain PQ and
production activation remain false for every declaration, including all-zero
arithmetic examples.

## 6. Eight target allocations do not become a joint bound

The legacy register still allocates eight times `2^-131`, exactly `2^-128`.
The new report computes `allocation_headroom = 0`. Extra shared losses have
`placement_in_eight_domains=unproved` and `total=null`; there is no implicit
zero loss and no assertion that the actual system has exceeded a risk target.
This implementation does not include a general additional-loss allocation
solver. A positive extra charge outside a fully used target would require
reallocation, once that charge and its placement were validly established.

The old domain experiment and the root inventory have not been mapped into a
proved common whole-chain experiment. Therefore the root result is not
substituted for the legacy signature term and is not added to the eight-domain
sum. The report labels them `legacy_declared_arithmetic` and
`conditional_root_arithmetic`, with `joint_bound_derived=false` and both scope
mappings unproved. Their events may overlap; no domain is silently removed.

All of the following remain required:

- A finite lifetime or explicit stopping rule, including earlier preprocessing
  and authority surviving retirement.
- Complete key/epoch populations and concrete multi-user threshold-family
  bounds under the actual corruption and custody model.
- Shared-oracle instantiation, initial advice, query units and all reduction,
  simulator/extractor, compiler and recursion losses where applicable.
- Project event containment, implementation refinement and complete protected
  outcome coverage, including recovery and actual external effects.
- The ledger/network/work-cost conditions for a whole-chain claim. No RISC Zero,
  Plonky3 or tagged SHA3 proof estimate is imported into this native PNW1 scope.

[RFC 9955, section 1.3.2](https://www.rfc-editor.org/rfc/rfc9955.html#section-1.3.2)
discusses proof composability and dependencies on additional hashes or KDFs.
It is an informational framework, not the missing proof of this project's
threshold protocol. NIST security categories likewise do not supply a direct
whole-lifetime failure probability.

## 7. CI and interpretation

Run from the repository root:

```sh
python3 scripts/ci/test_pq_lifetime_composition.py -v
python3 scripts/ci/pq_lifetime_composition.py --root .
```

Both commands remain mandatory in `repository-truth`, alongside the
unchanged V1 budget and root-register commands. CI structure controls reject deletion,
duplication,
conditional skipping, swallowed failure, movement to another lane, or replacement
of the checker/test file by a symlink. The four new source/config/document files
also enter the explicit research corpus and exact Git blob pins. Every existing
V1, claim-guard, root, protocol and native gate is retained.

The tests include independent finite-space evaluation of 4,096 event triples,
loss-placement and unknown-input cases, scope/profile conflicts, real declared
source inspection, and source/input refusal controls. They test the mathematics
of the accounting rule and the checker contract; they are not quantum attack
cost measurements or a project security proof.

A successful inspection returns exit zero with **HOLD**. A malformed or changed
contract returns exit two with **REFUSE**. Neither grants consensus admission,
release, migration, payment, installation, execution or FinalUse. The actual
report continues to contain:

```json
{
  "actual_lifetime_failure_bound": null,
  "composition_coverage_proved": false,
  "whole_chain_hash_query_scope_closed": false,
  "whole_chain_pq_qualified": false,
  "production_activation": false
}
```

## Current source correspondence entry (2026-11-14)

The v2 machine register and the original observation files remain unchanged.
The default checker now reads the explicit
[current-v3 register](../../config/pon/pq128-lifetime-composition-current-v3.json).
That register retains the exact v2 identity and binds the
[current 21-path correspondence](../../config/pon/pq128-source-correspondence-current-v2.json)
separately from the frozen v1 model and source lock. The frozen arithmetic does
not claim a current source revision.

The current root inventory has 46 declared source paths, including the bounded
cost observation source. Its one shared path with the 21-path event map gives
66 distinct current source paths. This source accounting adds no bad event,
probability, query budget, theorem applicability or production qualification.
All arithmetic, unknown values, HOLD results and original refusal limits remain
in force. Supplying the retained v2 register to the current-v3 checker is refused;
historical logs retain their original schema and outcome.

