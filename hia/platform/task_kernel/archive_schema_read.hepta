  jump loop(r,w,a,b,n,zero)
block loop(lr:readbuf,lw:mutbuf,la:u64,lb:u64,ln:u64,li:u64)
  more:bool = compare.lt(li,ln)
  branch more byte(lr,lw,la,lb,ln,li) yes()
block byte(br:readbuf,bw:mutbuf,ba:u64,bb:u64,bn:u64,bi:u64)
  p:u64 = int.add.wrap(ba,bi)
  q:u64 = int.add.wrap(bb,bi)
  p_at:usize = int.cast(p) {"mode":"wrap"}
  q_at:usize = int.cast(q) {"mode":"wrap"}
  x:u8 = buffer.load(br,p_at)
  y:u8 = buffer.load(bw,q_at)
  equal:bool = compare.eq(x,y)
  one:u64 = const() {"value":1}
  next:u64 = int.add.wrap(bi,one)
  branch equal loop(br,bw,ba,bb,bn,next) no()
