block parent(pa_r:readbuf,pa_m:mutbuf,pa_w:mutbuf,pa_row:u64,pa_first:bool,pa_last:bool,pa_len:u64)
  pa_cfg:usize = const() {"value":8307}
  pa_previous:usize = const() {"value":354000}
  pa_four:u64 = const() {"value":4}
  pa_final_row:bool = compare.eq(pa_row,pa_four)
  pa_profile_at:u64 = const() {"value":349024}
  pa_profile:u64 = call(pa_m,pa_profile_at) {"function":"cp_get"}
  pa_settled:bool = call(pa_profile) {"function":"hfs_settled"}
  pa_final:bool = bool.and(pa_final_row,pa_settled)
  pa_settle_index:u64 = call(pa_m) {"function":"hfs_settle_index"}
  pa_one:u64 = const() {"value":1}
  pa_valid_index:bool = compare.ge(pa_settle_index,pa_one)
  pa_safe_index:u64 = select(pa_valid_index,pa_settle_index,pa_one)
  pa_gap_index:u64 = int.sub.wrap(pa_safe_index,pa_one)
  pa_marker_base:u64 = call(pa_gap_index) {"function":"hfs_marker_offset"}
  pa_field:u64 = const() {"value":8}
  pa_coord:u64 = int.add.wrap(pa_marker_base,pa_field)
  pa_empty:usize = int.cast(pa_coord) {"mode":"wrap"}
  pa_non_first:usize = select(pa_final,pa_empty,pa_previous)
  pa_parent:usize = select(pa_first,pa_cfg,pa_non_first)
  pa_exec:usize = const() {"value":140083}
  pa_copy:usize = const() {"value":354080}
  pa_n:u64 = const() {"value":40}
  pa_stage:u64 = call(pa_w,pa_m,pa_exec,pa_copy,pa_n) {"function":"sscid_copy"}
  pa_match:bool = call(pa_m,pa_copy,pa_parent,pa_n) {"function":"smk_eq"}
  pa_h_at:u64 = const() {"value":100}
  pa_known:u64 = int.cast(pa_parent) {"mode":"wrap"}
  pa_current:u64 = call(pa_r,pa_h_at) {"function":"tr_read"}
  pa_height:u64 = call(pa_m,pa_known) {"function":"cp_get"}
  pa_unit:u64 = const() {"value":1}
  pa_next:u64 = int.add.wrap(pa_height,pa_unit)
  pa_step:bool = compare.eq(pa_current,pa_next)
  pa_progress:bool = compare.gt(pa_current,pa_height)
  pa_mode_at:u64 = const() {"value":349024}
  pa_mode:u64 = call(pa_m,pa_mode_at) {"function":"cp_get"}
  pa5:u64 = const() {"value":5}
  pa2:u64 = const() {"value":2}
  pa_which:bool = compare.eq(pa_mode,pa5)
  pa_is_second:bool = compare.eq(pa_row,pa2)
  pa_same:bool = bool.and(pa_which,pa_is_second)
  pa_equal:bool = compare.eq(pa_current,pa_height)
  pa_normal:bool = bool.and(pa_step,pa_progress)
  pa_exact:bool = select(pa_same,pa_equal,pa_normal)
  pa_good:bool = bool.and(pa_match,pa_exact)
  pa_var:bool = call(pa_mode) {"function":"hfs_variable"}
  pa_plan:bool = call(pa_mode) {"function":"hfs_mixed_plan_profile"}
  branch pa_plan marker_parent(pa_r,pa_m,pa_w,pa_row,pa_first,pa_last,pa_len) usual_parent(pa_r,pa_m,pa_w,pa_row,pa_first,pa_last,pa_len,pa_non_first,pa_good,pa_var)
