          bash "$OUT/run-command.sh" hepta-pq-receiver cargo +1.95.0 test --locked --release --manifest-path trillionnium/Cargo.toml -p trnm-research-protocol --test hepta_handoff_pq -- --test-threads=1 || status=1
          bash "$OUT/run-command.sh" native-accepted-task cargo +1.95.0 test --locked --release --manifest-path trillionnium/Cargo.toml -p trnm-pon-node --lib store::task_observation::tests:: -- --test-threads=1 || status=1
          bash "$OUT/run-command.sh" native-settlement-cold-readback cargo +1.95.0 test --locked --release --manifest-path trillionnium/Cargo.toml -p trnm-pon-node --test accepted_task_observation -- --test-threads=1 || status=1
          exit "$status"
      - name: Preserve existing growth packet and cold-observer controls
        id: growth_observers
        if: ${{ always() && steps.source.outcome == 'success' && steps.preflight.outcome == 'success' && steps.toolchain.outcome == 'success' }}
        shell: bash
        run: |
          set -euo pipefail
          status=0
          for selector in native_growth_v2_exact_packet_observation native_growth_v2_packet_observer native_growth_v2_cold_observer; do
            bash "$OUT/run-command.sh" "$selector" cargo +1.95.0 test --locked --release --manifest-path trillionnium/Cargo.toml -p trnm-pon-node --lib "$selector" -- --test-threads=1 || status=1
          done
          bash "$OUT/run-command.sh" growth-cli-packet-cold cargo +1.95.0 test --locked --release --manifest-path trillionnium/Cargo.toml -p trnm-pon-node --test native_growth_cli native_growth_v2_cli_signed_packet_remote_admission_and_cold_current_snapshot -- --exact --test-threads=1 || status=1
          python3 -B scripts/ci/check_required_native_test.py "$OUT/growth-cli-packet-cold.log" --test native_growth_v2_cli_signed_packet_remote_admission_and_cold_current_snapshot || status=1
          exit "$status"
      - name: Require nonempty filtered native executions without freezing test counts
        id: native_execution
        if: ${{ always() && steps.source.outcome == 'success' && steps.preflight.outcome == 'success' && steps.toolchain.outcome == 'success' }}
        shell: bash
        run: |
          set -euo pipefail
          python3 -B - "$OUT" <<'PY'
          from pathlib import Path
          import re, sys
          root = Path(sys.argv[1])
          names = ["native-packet-observer", "native-node-packet-status",
                   "hepta-classical-receiver", "hepta-pq-receiver", "native-accepted-task",
                   "native-settlement-cold-readback",
                   "native_growth_v2_exact_packet_observation",
                   "native_growth_v2_packet_observer", "native_growth_v2_cold_observer"]
          for name in names:
              text = (root / (name + ".log")).read_text()
              rows = re.findall(r"^test result: ok\. ([0-9]+) passed; 0 failed;", text, re.M)
              if len(rows) != 1 or int(rows[0]) == 0:
                  raise SystemExit("no successful nonempty native execution: " + name)
          PY
      - name: Run strict default-feature lint for both affected crates and all targets
        id: clippy
        if: ${{ always() && steps.source.outcome == 'success' && steps.preflight.outcome == 'success' && steps.toolchain.outcome == 'success' }}
        shell: bash
        run: |
          set -euo pipefail
          status=0
          for package in trnm-data-availability trnm-pon-node; do
            bash "$OUT/run-command.sh" "clippy-$package" cargo +1.95.0 clippy --locked --manifest-path trillionnium/Cargo.toml -p "$package" --all-targets -- -D warnings || status=1
          done
          exit "$status"
      - name: Retain release Cell component observations
        id: examples
        if: ${{ always() && steps.source.outcome == 'success' && steps.preflight.outcome == 'success' && steps.toolchain.outcome == 'success' }}
        shell: bash
        run: |
          set -euo pipefail
          status=0
          for example in cell_bep52_cost_v1 cell_rs46_cost_v1 cell_signed_sealed_pipeline_v1; do
            command_status=0
            timeout --signal=TERM --kill-after=10s 600 cargo +1.95.0 run --locked --release --manifest-path trillionnium/Cargo.toml -p trnm-data-availability --example "$example" > "$OUT/$example.json" 2> "$OUT/$example.log" || command_status=$?
            printf '%s\n' "$command_status" > "$OUT/$example.exit"
            if test "$command_status" != 0; then status=1; fi
          done
          exit "$status"
      - name: Reverify the complete measured source after all attempts
        id: source_after
        if: ${{ always() && steps.source.outcome == 'success' }}
        shell: bash
        run: |
          set -euo pipefail
          args=(--kind "$SOURCE_KIND" --expected-head "$EXPECTED_HEAD")
          if test "$SOURCE_KIND" = prospective-merge; then
            args+=(--expected-base "$EXPECTED_BASE" --expected-merge "$EXPECTED_MERGE")
          fi
          bash "$OUT/run-command.sh" source-after python3 -B scripts/ci/verify_ci_source.py "${args[@]}" --output "$OUT/source-after.json"
          cmp "$OUT/source-before.json" "$OUT/source-after.json"
          cmp "$OUT/source-before.json" "$OUT/source.json"
      - name: Retain stage outcomes and artifact digests
        if: ${{ always() && steps.reserve.outcome == 'success' }}
        shell: bash
        env:
          STAGE_OUTCOMES: ${{ toJSON(steps) }}
        run: |
          set -euo pipefail
          python3 -B - "$OUT" <<'PY'
          from pathlib import Path
          import hashlib, json, os, sys
          root = Path(sys.argv[1])
          stage_outcomes = json.loads(os.environ["STAGE_OUTCOMES"])
          storage_owner_passed = stage_outcomes.get("storage_owner", {}).get("outcome") == "success"
          storage_components_passed = stage_outcomes.get("storage_components", {}).get("outcome") == "success"
          sealed_python_passed = stage_outcomes.get("sealed_python", {}).get("outcome") == "success"
          (root / "stage-outcomes.json").write_text(json.dumps({
              "steps": stage_outcomes,
              "storage_owner_required": True,
              "storage_owner_passed": storage_owner_passed,
              "storage_components_required": True,
              "storage_components_passed": storage_components_passed,
              "sealed_python_required": True,
              "sealed_python_passed": sealed_python_passed,
              "expected_source": os.environ["EXPECTED_SOURCE"],
              "source_kind": os.environ["SOURCE_KIND"],
              "runner": os.environ["TRNM_COST_RUNNER_LABEL"],
              "qualification": "HOLD_NO_GO",
              "production_qualified": False,
              "performance_or_economics_qualified": False,
              "optional_pq_features_tested": False,
          }, sort_keys=True, indent=2) + "\n")
          records = []
          for path in sorted(root.iterdir()):
              if path.is_file() and not path.is_symlink() and path.name != "sha256sums.txt":
                  records.append(hashlib.sha256(path.read_bytes()).hexdigest() + "  " + path.name)
          (root / "sha256sums.txt").write_text("\n".join(records) + "\n")
          if not storage_owner_passed:
              raise SystemExit("required storage-owner native stage did not succeed")
          if not storage_components_passed or not sealed_python_passed:
              raise SystemExit("required storage convergence component stages did not succeed")
          PY
      - name: Package complete raw observations without renaming members
        if: ${{ always() && steps.reserve.outcome == 'success' }}
        shell: bash
        run: |
          set -euo pipefail
          python3 -B - "$OUT" <<'PY'
          from pathlib import Path, PurePosixPath
          import hashlib, io, json, stat, sys, tarfile
          root = Path(sys.argv[1])
          if root.is_symlink() or not root.is_dir():
              raise SystemExit("raw observation root must be a real directory")
          root = root.resolve(strict=True)
          destination = root.with_name(root.name + "-artifact")
          destination.mkdir()
          pending = destination / "raw-observations.tar.gz.partial"
          records = []
          def regular_bytes(path):
              if not stat.S_ISREG(path.lstat().st_mode):
                  raise SystemExit("non-regular observation: " + str(path))
              return path.read_bytes()
          def safe_member(name):
              path = PurePosixPath(name)
              return bool(name) and not path.is_absolute() and ".." not in path.parts
          with tarfile.open(pending, "x:gz", format=tarfile.PAX_FORMAT) as archive:
              for path in sorted(root.rglob("*")):
                  mode = path.lstat().st_mode
                  if stat.S_ISDIR(mode):
                      continue
                  name = path.relative_to(root).as_posix()
                  if not safe_member(name):
                      raise SystemExit("unsafe observation path: " + name)
                  data = regular_bytes(path)
                  member = tarfile.TarInfo(name)
                  member.size = len(data)
                  member.mode = stat.S_IMODE(mode)
                  archive.addfile(member, io.BytesIO(data))
                  records.append({"raw_relative_path": name, "archive_member": name,
                                  "bytes": len(data), "sha256": hashlib.sha256(data).hexdigest()})
          if not records:
              raise SystemExit("no raw observations to archive")
          expected = {record["archive_member"]: record for record in records}
          with tarfile.open(pending, "r:gz") as archive:
              members = archive.getmembers()
              if len(members) != len(expected) or {member.name for member in members} != set(expected):
                  raise SystemExit("archive member set differs from raw observations")
              for member in members:
                  if not member.isfile() or not safe_member(member.name):
                      raise SystemExit("unsafe archive member: " + member.name)
                  reader = archive.extractfile(member)
                  if reader is None:
                      raise SystemExit("missing archive member bytes: " + member.name)
                  with reader:
                      data = reader.read()
                  record = expected[member.name]
                  if (len(data) != record["bytes"]
                          or hashlib.sha256(data).hexdigest() != record["sha256"]
                          or data != regular_bytes(root / record["raw_relative_path"])):
                      raise SystemExit("archive readback differs from raw observation: " + member.name)
          archive_path = destination / "raw-observations.tar.gz"
          pending.rename(archive_path)
          manifest = {"schema": "pon-ci-raw-observation-archive-v1",
                      "archive": archive_path.name,
                      "archive_bytes": archive_path.stat().st_size,
                      "archive_sha256": hashlib.sha256(archive_path.read_bytes()).hexdigest(),
                      "member_count": len(records), "members": records}
          (destination / "members.json").write_text(
              json.dumps(manifest, sort_keys=True, indent=2) + "\n")
          PY
      - name: Map every observation to a safe upload path
        id: artifact_map
        if: ${{ always() && steps.reserve.outcome == 'success' }}
        shell: bash
        run: |
          set -euo pipefail
          python3 -B scripts/ci/prepare_artifact_upload.py --source "$OUT" --output "$OUT-upload"
      - name: Retain logs and failed or partial observations
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: next-architecture-${{ matrix.runner }}-${{ matrix.source }}-${{ env.EXPECTED_SOURCE }}-${{ github.run_attempt }}
          path: |
            ${{ runner.temp }}/next-architecture-${{ matrix.source }}-${{ github.run_id }}-${{ github.run_attempt }}-artifact/raw-observations.tar.gz
            ${{ runner.temp }}/next-architecture-${{ matrix.source }}-${{ github.run_id }}-${{ github.run_attempt }}-artifact/members.json
            ${{ runner.temp }}/next-architecture-${{ matrix.source }}-${{ github.run_id }}-${{ github.run_attempt }}-upload/
          if-no-files-found: error
          retention-days: 30

