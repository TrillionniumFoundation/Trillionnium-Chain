env.update({'PATH':toolchain+'/bin:'+venv+'/bin:'+env['PATH'],'RUSTC':toolchain+'/bin/rustc','RUSTDOC':toolchain+'/bin/rustdoc','LD_LIBRARY_PATH':toolchain+'/lib','CARGO_HOME':'/home/qian-qi/work/chain-pon-lifecycle-closure-20261107/cargo-home','CARGO_TARGET_DIR':target,'NATIVE_OWNER_JOURNAL_RUN':str(out/'fresh-native-owner/run.json'),'NATIVE_RISK_LEDGER_RUN':str(out/'fresh-native-risk/run.json'),'CARGO_NET_OFFLINE':'true','RUST_TEST_THREADS':'1'})
stages=[]
def stage(name,args):
 start=time.monotonic()
 with (out/(name+'.log')).open('wb') as log:
  done=subprocess.run(args,cwd=root,env=env,stdout=log,stderr=subprocess.STDOUT)
 row={'stage':name,'args':args,'returncode':done.returncode,'elapsed_seconds':time.monotonic()-start}
 stages.append(row);(out/'stages.json').write_text(json.dumps(stages,indent=2)+'\n')
 print(json.dumps(row),flush=True)
 if done.returncode:
  print((out/(name+'.log')).read_text()[-16000:],flush=True);sys.exit(done.returncode)
 return (out/(name+'.log')).read_text().strip()
