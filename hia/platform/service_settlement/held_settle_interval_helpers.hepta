  sf:u64 = int.add.wrap(base,source_at)
  tf:u64 = int.add.wrap(base,target_at)
  sn:u64 = call(m,sf) {"function":"cp_get"}
  tn:u64 = call(m,tf) {"function":"cp_get"}
  a:bool = compare.eq(n,index)
  b:bool = compare.eq(h,height)
  c:bool = compare.eq(sn,source)
  d:bool = compare.eq(tn,target)
  ab:bool = bool.and(a,b)
