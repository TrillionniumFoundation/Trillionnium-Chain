  branch mandatory order(ii,io,in_n,il,ik,ikn,ic2,ic3,im,imn,ikl,ivl,kpos,vpos,previous) frame_error()
block order(oi:readbuf,oo:mutbuf,on:u64,ol:u64,ok:u64,okn:u64,oc2:u64,oc3:u64,om:u64,omn:u64,okl:u64,ovl:u64,op:u64,ovp:u64,oprev:bool)
  branch oprev ordered(oi,oo,on,ol,ok,okn,oc2,oc3,om,omn,okl,ovl,op,ovp) classify(oi,oo,on,ol,oc2,oc3,om,omn,okl,ovl,op,ovp)
block ordered(ai:readbuf,ao:mutbuf,an:u64,al:u64,ak:u64,akn:u64,ac2:u64,ac3:u64,am:u64,amn:u64,akl:u64,avl:u64,ap:u64,avp:u64)
