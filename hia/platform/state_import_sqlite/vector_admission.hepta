  ai:u64 = int.add.wrap(ni,one)
  bj:u64 = int.sub.wrap(nj,one)
  remaining:u64 = int.sub.wrap(nleft,one)
  done:bool = compare.eq(nleft,one)
  branch done success() count_byte(nraw,nwork,ai,bj,remaining)
block success()
