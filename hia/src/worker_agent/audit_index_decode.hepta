  byte_in_next:u64 = int.add.wrap(byte_a,byte_one)
  byte_stage_next:u64 = int.add.wrap(byte_b,byte_one)
  byte_remaining:u64 = int.sub.wrap(byte_n,byte_one)
  branch byte_same loop(byte_i,byte_s,byte_in_next,byte_stage_next,byte_remaining) bad()
block good()
  good_yes:bool = const() {"value":true}
  ret(good_yes)
block bad()
  bad_no:bool = const() {"value":false}
  ret(bad_no)
end

