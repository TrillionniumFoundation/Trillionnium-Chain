b.com/users/Tomasrgbsf","html_url":"https://github.com/Tomasrgbsf","followers_url":"https://api.github.com/users/Tomasrgbsf/followers","following_url":"https://api.github.com/users/Tomasrgbsf/following{/other_user}","gists_url":"https://api.github.com/users/Tomasrgbsf/gists{/gist_id}","starred_url":"https://api.github.com/users/Tomasrgbsf/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Tomasrgbsf/subscriptions","organizations_url":"https://api.github.com/users/Tomasrgbsf/orgs","repos_url":"https://api.github.com/users/Tomasrgbsf/repos","events_url":"https://api.github.com/users/Tomasrgbsf/events{/privacy}","received_events_url":"https://api.github.com/users/Tomasrgbsf/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"Tomasrgbsf","id":273673612,"node_id":"U_kgDOEE_tjA","avatar_url":"https://avatars.githubusercontent.com/u/273673612?v=4","gravatar_id":"","url":"https://api.github.com/users/Tomasrgbsf","html_url":"https://github.com/Tomasrgbsf","followers_url":"https://api.github.com/users/Tomasrgbsf/followers","following_url":"https://api.github.com/users/Tomasrgbsf/following{/other_user}","gists_url":"https://api.github.com/users/Tomasrgbsf/gists{/gist_id}","starred_url":"https://api.github.com/users/Tomasrgbsf/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Tomasrgbsf/subscriptions","organizations_url":"https://api.github.com/users/Tomasrgbsf/orgs","repos_url":"https://api.github.com/users/Tomasrgbsf/repos","events_url":"https://api.github.com/users/Tomasrgbsf/events{/privacy}","received_events_url":"https://api.github.com/users/Tomasrgbsf/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"989055428a46b67ff99390bf7bcaa09783936d39","url":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/commits/989055428a46b67ff99390bf7bcaa09783936d39","html_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/commit/989055428a46b67ff99390bf7bcaa09783936d39"}]},{"sha":"5df7ae6f482157c5f7fdcbcd52222117a965053f","node_id":"C_kwDOTty1_doAKDVkZjdhZTZmNDgyMTU3YzVmN2ZkY2JjZDUyMjIyMTE3YTk2NTA1M2Y","commit":{"author":{"name":"Tomasrgbsf","email":"tomasbraynt@gmail.com","date":"2026-11-14T15:37:19Z"},"committer":{"name":"Tomasrgbsf","email":"tomasbraynt@gmail.com","date":"2026-11-14T15:37:19Z"},"message":"Merge reviewed concurrent source with local deadline and ownership fixes\n\nReconcile ABFC and 2a by explicit source and evidence dispositions.\nKeep the local public_v2 completion deadline check, select the reviewed\nimmutable PublicPolicy prefix cache and epoch-before-readiness store,\nand compose all sixteen owned-collector controls with causal raw status.\nRestore four byte-exact metadata files missing from a retained index,\ncorrect current versus historical source labels, and preserve the old\nFC39 observations with the withdrawn ordering recommendation explicit.\nOriginal business failures and qualification boundaries remain open.\nProposal SHA256: 21e5299e01eec57f7c72fb7ae76c287f00389be64cb3bd3c3493b2d783b8f1e6\nResolution SHA256: 5f10655e03bd7c801eb99cc445990e98ba675c998b3dcb941235e2858fc08cb5","tree":{"sha":"6be4940d38cc88782657f2684cbefe48866f8b9f","url":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/git/trees/6be4940d38cc88782657f2684cbefe48866f8b9f"},"url":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/git/commits/5df7ae6f482157c5f7fdcbcd52222117a965053f","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/commits/5df7ae6f482157c5f7fdcbcd52222117a965053f","html_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/commit/5df7ae6f482157c5f7fdcbcd52222117a965053f","comments_url":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/comm