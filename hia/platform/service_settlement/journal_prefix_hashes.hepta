fn jph_collect(w:mutbuf,end:u64,count:u64) -> (u32) effects(read,write,trap) entry(entry)
block entry(w:mutbuf,end:u64,count:u64)
  base:u64 = const() {"value":4100}
  max_end:u64 = const() {"value":5580}
  max_count:u64 = const() {"value":8}
  cap:usize = buffer.len(w)
  need:usize = const() {"value":8192}
  width_ok:bool = compare.le(count,max_count)
  min_ok:bool = compare.ge(end,base)
  max_ok:bool = compare.le(end,max_end)
  scratch_ok:bool = compare.ge(cap,need)
  bounds:bool = bool.and(min_ok,max_ok)
  count_extent:bool = bool.and(width_ok,bounds)
  valid:bool = bool.and(count_extent,scratch_ok)
  first:u64 = const() {"value":0}
  branch valid loop(w,end,count,base,first) bad()
block loop(lw:mutbuf,le:u64,lc:u64,lp:u64,li:u64)
  frame:u64 = const() {"value":4100}
  good:bool = call(lw,frame,lp,li) {"function":"jph_hash"}
  branch good save(lw,le,lc,lp,li) internal()
block save(sw:mutbuf,se:u64,sc:u64,sp:u64,si:u64)
