5b0bdecd94909d328cafc028d7d2bcf387ec9ecbcab533b146cc\",\n+      \"git_blob\": \"7049001ace23192d6d32e4f438ca85e4b0ac16cc\"\n+    },\n+    {\n+      \"path\": \"scripts/test_w1_owned_process_collector_v1.py\",\n+      \"bytes\": 26853,\n+      \"sha256\": \"20ba82854ae08211195a4a7ceb677b72cda3f0ebb152c4e4c94ea77438528224\",\n+      \"git_blob\": \"0593d08df667d56460250ae336fdbd7897daf693\"\n+    }\n+  ],\n+  \"patch\": {\n+    \"path\": \"/private/tmp/chain-M4-owned-process-collector-review-20261114-v1/edit-static-v1/source-and-tests.patch\",\n+    \"bytes\": 6317,\n+    \"sha256\": \"a8c3d5ecbf2b563efde4ac4bb535309e9657145e59c45c3957ca2ecf7e131b91\"\n+  }\n+}"},{"sha":"bfb512b08a34e3d35d2db5492e47043d6ac439c4","filename":"docs/audit/20261114-m4-closed-exec-gate/staging-failure-observations.json","status":"added","additions":22,"deletions":0,"changes":22,"blob_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/blob/5df7ae6f482157c5f7fdcbcd52222117a965053f/docs%2Faudit%2F20261114-m4-closed-exec-gate%2Fstaging-failure-observations.json","raw_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/raw/5df7ae6f482157c5f7fdcbcd52222117a965053f/docs%2Faudit%2F20261114-m4-closed-exec-gate%2Fstaging-failure-observations.json","contents_url":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/contents/docs%2Faudit%2F20261114-m4-closed-exec-gate%2Fstaging-failure-observations.json?ref=5df7ae6f482157c5f7fdcbcd52222117a965053f","patch":"@@ -0,0 +1,22 @@\n+{\n+  \"schema\": \"trnm-M4-original-staging-failure-carriers-v1\",\n+  \"observations\": [\n+    {\n+      \"source_path\": \"/private/tmp/chain-M4-owned-process-collector-review-20261114-v1/commit-v1/staged-diff-check.stdout\",\n+      \"exit_code\": 2,\n+      \"bytes\": 456,\n+      \"sha256\": \"5a7c5009a3c60c8528266ec5324f8feae9ecadd0b83e79037b3a55243dbc39e2\",\n+      \"stdout\": \"docs/audit/20261114-m4-closed-exec-gate/source-and-tests.patch:12: trailing whitespace.\\n+ \\ndocs/audit/20261114-m4-closed-exec-gate/source-and-tests.patch:14: trailing whitespace.\\n+ \\ndocs/audit/20261114-m4-closed-exec-gate/source-and-tests.patch:17: trailing whitespace.\\n+ \\ndocs/audit/20261114-m4-closed-exec-gate/source-and-tests.patch:18: trailing whitespace.\\n+ \\ndocs/audit/20261114-m4-closed-exec-gate/source-and-tests.patch:121: trailing whitespace.\\n+ \\n\",\n+      \"cause\": \"unchanged unified-diff context space stored in an evidence text carrier; production source whitespace was not failing\"\n+    },\n+    {\n+      \"source_path\": \"/private/tmp/chain-M4-owned-process-collector-review-20261114-v1/commit-v2/staged-diff-check.stdout\",\n+      \"exit_code\": 2,\n+      \"bytes\": 556,\n+      \"sha256\": \"205b29cb014d8de9e2d7987bef0f51cf565c9845989df93c033e1d2406eb9808\",\n+      \"stdout\": \"docs/audit/20261114-m4-closed-exec-gate/initial-staged-patch-whitespace.stdout.raw:2: trailing whitespace.\\n++ \\ndocs/audit/20261114-m4-closed-exec-gate/initial-staged-patch-whitespace.stdout.raw:4: trailing whitespace.\\n++ \\ndocs/audit/20261114-m4-closed-exec-gate/initial-staged-patch-whitespace.stdout.raw:6: trailing whitespace.\\n++ \\ndocs/audit/20261114-m4-closed-exec-gate/initial-staged-patch-whitespace.stdout.raw:8: trailing whitespace.\\n++ \\ndocs/audit/20261114-m4-closed-exec-gate/initial-staged-patch-whitespace.stdout.raw:10: trailing whitespace.\\n++ \\n\",\n+      \"cause\": \"unchanged unified-diff context space stored in an evidence text carrier; production source whitespace was not failing\"\n+    }\n+  ],\n+  \"original_external_bytes_unchanged\": true\n+}"},{"sha":"fe36bbf8f1ba9dfb933f5e93f10685be1f7977c2","filename":"docs/development/BRANCH_CONSOLIDATION_AUDIT_20261114.md","status":"modified","additions":486,"deletions":1,"changes":487,"blob_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/blob/5df7ae6f482157c5f7fdcbcd52222117a965053f/docs%2Fdevelopment%2FBRANCH_CONSOLIDATION_AUDIT_20261114.md","raw_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/raw/5df7ae6f482157c5f7fdcbcd52222117a965053f/docs%2Fdevelopment%2FBRANCH_CONSOLIDATION_AUDIT_20261114.md","contents_url":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/contents/docs%2Fdevelopment%2FBRANCH_CONSOLIDATION_AUDIT_20261114.md?ref=5df7ae6f482157c5f7fdcbcd52222117a965053f","patch":"@@ -13,7 +13,7 @@ The snapshot was observed at 2026-11-14T04:07:38.570192Z. Its manifest has SHA25\n The protected main tip was `dd6e1c3cbeacbdc532b0679297835b3a0aac78f0`;\n the existing consolidation PR is [#847](https://github.com/TrillionniumFoundation/Trillionnium-Chain/pull/847).\n \n-The selected runtime integration and current reader bindings are combined at\n+The initial runtime integration and reader-binding checkpoint was\n `96643a2dd8a90cded0059216cae15e2cd620c77b` (tree\n `b3adb2552cf47b7dbd6956b3b23cdac3f588c4cb`). The final binding component is\n `b84568a714e24070d9554008660f1382e2c1b1b5`. The branch-disposition ledger is\n@@ -71,6 +71,48 @@ equivalence.\n \n ## Findings that affect acceptance\n \n+### Published-candidate repository-truth stopped at a stale current mapping\n+\n+The first full Linux repository-truth attempt on published source\n+`dc42ce4df5cff79cc61c5addbaf01074b56b06ca` (tree `9fda17fed2542b2baccaa34585bb00afd699e12b`) returned exit 1\n+after **6.677 seconds**, before the remainder of that lane could execute.\n+The original 58 lifetime-budget controls reported **57 passes and one error**:\n+`test_default_research_register_contains_no_known_security_bound` reached\n+`pq_lifetime_budget.inspect` and rejected the stale `pon_work.rs` source hash.\n+The original [summary](../../evidence/pq128-lifetime-source-binding-20261114/original-full-lane/summary.json)\n+has SHA-256 `9a4bc9c021e80adff3d2c7d5500e1aed3f9eda519efb3942cbd42a2e34c5eab2`;\n+all 37 original streams/receipts are preserved. Source checks before and after\n+the failed lane matched the same clean checkpoint. This is a failed full-lane\n+attempt, not evidence that later commands passed.\n+\n+The documented default is a current reviewed source mapping. Its 0f9 bytes\n+remain historical evidence; preserving those bytes alone does not establish\n+that the current physical source satisfies that default inspector. All 21\n+old/current regular Git blobs were compared explicitly: eight changed and\n+thirteen did not. The corrective mapping binds the selected current source\n+without changing the original budget reader, 58 controls, mathematical\n+parameters, event roster or qualification flags.\n+\n+The current composition bridge also required exact-child synchronization:\n+its already reviewed root register contains 46 paths, so the strict joined\n+inventory is 21/46/1/66. The root register remains unchanged. Only two existing\n+composition controls adapt their exact count expectations; the original\n+probability, source-integrity and nonqualification assertions remain.\n+The repaired working source passed the original **58 lifetime, 60 composition,\n+51 root-dependency, 57 chain-claim and 39 proof-profile controls** (265 method\n+executions), with no failures or skips. The five actual inspectors, current\n+corpus and CI contract also passed. All 79 selected validation inputs matched\n+before and after; the selected proof-profile descriptor remained unchanged.\n+Sixteen separate negative observations refused each stale source digest, mixed\n+old/current revision pair and superseded composition identity. These targeted\n+Mac observations use Python 3.14.3 and a canonical private temporary directory;\n+they do not replace the required full Linux lane on the final successor commit.\n+\n+The [corrective evidence](../../evidence/pq128-lifetime-source-binding-20261114/README.md) separates the\n+original failures from subsequent targeted results. A complete successor lane\n+and exact-head hosted checks remain required; neither has a passing result\n+from this corrective source review.\n+\n ### The original confirmation target remains a separate blocking gate\n \n Earlier exact-head and prospective-merge runs failed `CONFIRMATION_TARGET`.\n@@ -422,3 +464,446 @@ remote reference.\n The single-branch result can be asserted only from a fresh remote inventory after\n all authorized deletions. Any unresolved required CI result or explicit deletion\n protection remains visible in the final execution receipt.\n+\n+## Follow-up source bindings and preserved complete-lane failures\n+\n+The published dc42ce4d source failed its original complete Linux\n+repository-truth run in the 58-method lifetime suite, with 57 passes and one\n+source-lock error. The reviewed lifetime successor\n+7d8d4c59fcd01480a12e1c64835b202079091800 passed all seven local source gates, but\n+its complete original Linux lane then failed in the hash-use source binding:\n+31 of the original 33 methods passed, one failed and one errored. That lane\n+exited 1 after 30.922 seconds; its original limit remained 2700 seconds.\n+Both failed complete runs and their original source readbacks are preserved.\n+\n+To identify the remaining causes, a separate diagnostic executed the 122\n+remaining original command units from the unchanged lane, preserving each\n+unit's body and arguments. All units ran; 116 exited zero and six exited nonzero\n+(units 1, 6, 10, 22, 23 and 107). The original 58 repository mutation controls\n+were among the successful units. The diagnostic continued between failed\n+units and therefore cannot qualify as a complete original lane pass.\n+The [complete diagnostic package and integration record](../../evidence/branch-consolidation-followup-20261114/source-binding-integration-v1/README.md)\n+retain the original summary, all 266 original files in the indexed ZIP,\n+and the exact source identity before and after.\n+\n+The four independently reviewed corrections are:\n+\n+| Component | Exact scope | Focused result |\n+| --- | --- | --- |\n+| Hash-use source map, e811c204 | Six changed and 25 unchanged inputs in the fixed 31-path map; original 19 uses and semantic digest retained | Original 33 methods and the existing CI registration control pass; actual reader remains HOLD_NO_GO |\n+| Fixed-probability source map, 2d9baf31 | One changed and three unchanged inputs; original probability 1/16, research credit 16u, reader and all original methods retained | Original 16 methods pass; old map is refused; actual reader remains HOLD_NO_GO |\n+| Joint-consensus source map, 6418023d | Four changed and 19 unchanged inputs, bound to the actual F1 source commit; no parameter or runtime change | Original 35 methods pass; one current-revision assertion is adapted and old-revision rejection is added; qualification request still exits 3 |\n+| Historical collector binding, 341a8b5f | One fixed historical source/tree/producer tuple checked as bounded raw data; current collector and original native evidence remain unchanged | All original 25 methods plus six new boundary methods pass; one new corpus omission/tamper method passes |\n+\n+The [hash-use review](../../evidence/hash-use-current-source-review-20261114/README.md),\n+[fixed and joint source review](../../evidence/pon-fixed-joint-source-binding-20261114/README.md)\n+and [historical collector provenance](../../evidence/branch-consolidation-followup-20261114/native-collector-history-v1/README.md)\n+state their exact coverage. The historical producer is never imported, compiled\n+or executed. Its content-address proof does not authenticate a native build.\n+The fixed source contexts identify reviewed inputs; they are not presented as\n+the later commits which store the new mapping metadata.\n+\n+The original failed Mac temporary-path control and the two failed staged\n+whitespace checks remain recorded. Canonical temporary-path selection and\n+byte-preserving ZIP carriers corrected those execution/carrier issues without\n+weakening readers, tests or the repository checker. The old joint Markdown\n+document is retained byte-for-byte as .md.original because its thirteen original\n+relative links do not describe its new archival location.\n+\n+No Rust runtime source, original service deadline, worker count, probability,\n+cost parameter or qualification flag is changed by these four follow-ups.\n+The next complete gate receipts must identify their actual committed successor.\n+The current published C0 external-evidence failure is a separate unresolved\n+observation at this checkpoint and is not claimed as fixed by these changes.\n+\n+## Later remote and dependency observations\n+\n+The original e40d workflow 43551533528 subsequently completed with 15 successful\n+and six failed jobs. Its two protocol runs and two architecture-specific service\n+runs retained real CONFIRMATION_TARGET failures under the original four-second,\n+16-worker contract. The exact-head and prospective protocol receipts both\n+recorded zero accepted confirmations out of one pressure request; all five\n+native processes in each run exited normally. These business acceptance\n+failures are preserved and are not inferred from an outer process exit.\n+The later C0 workflow 43567821538 remains a separate source and observation;\n+its ongoing or failed checks cannot be replaced by the predecessor's results.\n+\n+The seven then-open Dependabot alerts all concern the main branch's\n+cryptography 41.0.7 requirement. The selected candidate uses cryptography 50.0.2,\n+outside each of the seven reported vulnerable ranges. Four alerts were high,\n+two medium and one low. Their original API responses and advisory records are\n+retained in the later execution evidence; no alert was manually dismissed or\n+closed. This narrow comparison is not a claim that every dependency, wheel or\n+OpenSSL deployment is qualified. The 27 historical registry/yank-query timeouts\n+and the unresolved macOS physical-retention result remain open observations.\n+\n+The original 908-name archive was confirmed remotely before any merge or branch\n+cleanup. Its annotated tag is archive/branches-before-consolidation-20261114-dc42ce4df5cf-v2,\n+tag object 9dafd9192e4040fab530958ef71598aaec9265b9, commit\n+5f57c4e1e2b7ae95a7b0651d7674979d3f44b90b. That commit retains all 892 original\n+tips plus the published C0 candidate as its 893 direct parents. A later execution\n+archive may retain this archive and the reviewed successor as separate parents;\n+an older tag is never represented as capturing source added afterward.\n+At this source checkpoint, main integration and the single-branch remote result\n+are still uncompleted actions.\n+\n+## Public-readiness reader correction after the C0 external failures\n+\n+The two C0 external-evidence jobs reached the original 76-method readiness\n+suite and reported 46 failures and 23 errors. Their actual first mismatch was\n+the complete observation_only opener-body digest. The\n+[readiness source review](../../evidence/public-readiness-selected-body-binding-20261114/README.md)\n+preserves both complete hosted logs and the exact historical/current body\n+comparison.\n+\n+Component a3495dab updates one independently reviewed digest. The only body\n+difference is the already selected requirement for a TLS endpoint witness,\n+checked before namespace effects; the M06 account-profile refusal remains\n+before that check. The reader retains the historical growth-body digest and\n+all DDL, domain, typed-mode and schema checks, and accepts no old-body fallback.\n+All original 76 methods are byte- and AST-identical. One added method refuses\n+old-body rollback, an ignored witness error and moving the guard after a\n+namespace effect.\n+\n+The first local Mac run attempted 77 methods: 69 passed, eight encountered\n+missing-dependency errors and none failed an assertion. The new three refusal\n+cases passed. No dependency installation or test skip was used to turn that\n+run into a pass. Complete Linux and hosted outcomes must be recorded separately\n+on their actual tested source. This reader correction changes no Rust runtime\n+or production qualification.\n+\n+The e1bf seven-source-gate run also remains an original failed observation:\n+six commands passed, while the corpus checker refused the newly appended\n+development-plan bytes. The 308878 follow-up changed only the stale plan pin.\n+All subsequent plan appends must be pinned after their final bytes are written.\n+\n+\n+## Original full Linux failure and bounded exec-gate repair\n+\n+The 1a7afc candidate passed its seven local source gates. Its complete original\n+Linux repository-truth command subsequently exited 1 after 496.806 seconds,\n+with identical source identities before and after execution. The last suite\n+passed 13 of 14 original collector controls. In the post-fork identity-refusal\n+case, the recorded root exit was -15 rather than the required 125. The\n+[collector review and complete failed-run package](../audit/20261114-m4-closed-exec-gate/README.md)\n+retain the raw result and its source identity.\n+\n+The source review found a concrete ordering race: the parent closes the exec\n+gate, but cleanup can signal TERM before the child is scheduled to read EOF.\n+Component b71b84bb adds a successful-close flag and defers only that root's\n+TERM when exec was never released. The original KILL threshold and total\n+cleanup grace remain unchanged; descendants, already released roots and\n+unconfirmed gate closures retain their original signal behavior. No return\n+code is rewritten. All original 14 test methods are preserved, and two\n+deterministic signal-order controls are added.\n+\n+Linux execution of the changed 16-method suite and the complete original lane\n+is still pending at this source checkpoint. This Python collector correction\n+does not change the active Rust workload or resolve its four-second pressure\n+confirmation failure. Local source checks, hosted qualification and the final\n+remote one-branch result remain distinct observations.\n+\n+\n+## Complete M5 observations and exact-count integration\n+\n+The full Linux repository-truth lane on 08c9beca exited 1 after 481.260 seconds.\n+All 16 collector tests passed, including the original post-fork refusal case,\n+but the later CI parser still required exactly 14. The failed execution and\n+both unchanged source identities remain preserved; passing the collector\n+suite does not turn the complete lane into a pass.\n+\n+Component f0f6a419 updates only the exact collector count in the shell,\n+its independent CI contract, and their existing mutation controls. It\n+requires all 16, retains failures for 0/13, and adds refusal of old 14 and\n+incomplete 15. The original zero-skip, exact-OK, missing-log and failed-process\n+guards remain. All four original focused CI methods and ten synthetic parser\n+cases passed; no collector or Rust runtime code changed in this follow-up.\n+\n+The independent complete external-evidence-contract command on 08c9beca\n+passed in 225.948 seconds. The previously incomplete readiness suite now\n+passed all 77 tests in the prepared Linux dependency environment. All 14\n+declared historical source trees were present, the original materializer\n+reported fetched=[], and before/after source identities were equal. This\n+validates the declared historical-evidence contract on that exact source;\n+it does not grant current system, hosted or production qualification.\n+\n+The new integration requires its own original full repository-truth result.\n+The unchanged original C0 head and prospective native confirmation failures,\n+the original four-second window and 16 pressure workers, and all prior\n+HOLD_NO_GO / DENY_ALL conditions remain in force. No main merge or branch\n+deletion has occurred at this checkpoint.\n+\n+\n+## Complete M6 validation and concurrent-source reconciliation\n+\n+The exact M6 source `2a62061177852dc3ebd200fa8d7c66c661a119a1`, tree\n+`f8d170ff75990e879e93888a95e5408f36b36f6c`, subsequently passed all seven\n+Mac source gates and both original complete Linux commands. The original\n+repository-truth command passed in 582.575 seconds, including all 16 collector\n+controls. The original external-evidence-contract command passed in 221.499\n+seconds, including all 77 readiness methods. Its historical materializer reported\n+`fetched=[]`. Each complete lane retained equal before/after identities for\n+41,671 tracked entries and 3,994,766,803 tracked bytes.\n+\n+| Original M6 receipt | SHA256 |\n+| --- | --- |\n+| Seven Mac source gates | `fc8901b9c33e0887f28994a29ca1fefa3df1301169cfd611a4f30f392fb1f155` |\n+| Complete Linux repository-truth, 18-stage driver | `7516f4d8602dd58949eeb608439005882c3703a189dac32b0cea716eafd157ce` |\n+| Complete Linux external-evidence contract, 12-stage driver | `c7ed3b0109e09b1fe18ede0986250c96cb9cf1e41bedf9b1966875ecc03874f4` |\n+\n+These successes qualify those exact source checks on M6. They do not qualify a\n+later source, hosted native performance, deployment or production activation.\n+Earlier failed runs retain their original outcomes.\n+\n+The attempt to publish M6 stopped before any push because PR #847 had advanced\n+from C0 to `5a4b7fe8de1adce803184f262fd9f704ead1930c` (N). The actual\n+pre-push receipt has SHA256\n+`c7878c180b7019ff635203f08fe05a9c09e00d8e8e9ee44232f4df7272d05183`,\n+`push_started=false`, `push_exit=null`, and `archive=null`.\n+No M6 publication or new execution tag was inferred from this refusal. The\n+09:57:36–09:57:42 UTC full reference observation still contained 908 names and\n+892 tips: only the candidate had advanced, while the other 907 names and main\n+were unchanged. N adds 14 commits and changes 49 paths relative to C0.\n+\n+The reconciliation preserves both M6 and N as parents and explicitly selects\n+53 paths. This report and a final sole-plan append record the root decision;\n+all other M6 source and historical evidence remain unchanged. The reviewed\n+pre-append selected-file manifest has SHA256\n+`7cd35f9aa4f4cc11ba0b3dc10eb19148c1d5a087d464101573188afa9edb7d95`.\n+The reviewed source choices are:\n+\n+- Retain the complete C0/M6 Node store blob\n+  `d596dc6bab16698cd18bcc15bcbbe1fafedf603e`. Moving the initial readiness\n+  check before the admission epoch capture introduces an uncovered reorganization\n+  interleaving. Moving time deferral before local chainwork validation changes\n+  fatal local-integrity refusal into a nonfatal time refusal. Both findings\n+  concern source ordering; no executed exploit or false confirmation is claimed.\n+- Adopt N's worker artifact reader blob\n+  `f021a33e2969305241099998f703172d29b15251`. It preserves the originally\n+  validated metadata across the lock boundary and adds independent permission\n+  and hard-link mutation controls. The complete Linux module now contains\n+  eight retained controls and two new controls; its actual execution remains\n+  a separate exact-source result.\n+- Restore the three genuine C0 frozen PQ JSON identities and use a separate\n+  current correspondence map. The map binds the same 21 declared source paths,\n+  including the retained store. Its SHA256 is\n+  `b1a3e6d9124aa3e15b3f1e46ba361cc3876514f587eeaf4ff7d4530d4b8e2c7a`;\n+  the independent canonical map digest is\n+  `69b8f761e92ecd0d43378f44eae7458a0acced35bd9323a171fe59fd843cf5f9`.\n+  Frozen arithmetic is explicitly unbound. The current 21-path and existing\n+  46-path inventories still share one release path and cover 66 distinct paths,\n+  without proving a Git revision, security theorem or complete dependency closure.\n+- Preserve H1's 31 current hash-purpose bindings, the authority and current\n+  lifetime inventories, F1/F2, the B1 historical collector carrier, C5's bounded\n+  cleanup repair, and C6's exact 16-control requirement with the 0/13/14/15\n+  refusals. Retain the original 58 budget command and add the 25 current-map\n+  controls. Both endpoint-witness methods remain, giving a static roster of\n+  78 readiness methods.\n+- Accept explicit SQLite connection closure, strict JSON type matching, exact\n+  SP27 native-process readback, current History phase validation and the separate\n+  10-control W1 workflow roster. Retain the original QROM observations; the new\n+  fixed expected report changes only the reviewed dependency-lock identity and\n+  does not become a native execution receipt.\n+\n+The merged source requires new complete source, repository and external-evidence\n+gates, the worker module tests and strict lint, and the required hosted checks.\n+M6 passes cannot substitute for any of these. The original four-second window,\n+16 pressure workers, fresh Host checks, 30-second campaign and all\n+HOLD_NO_GO / DENY_ALL conditions remain unchanged. This reconciliation is not\n+a demonstrated fix for the original confirmation failures or macOS physical\n+retention failure. Main integration, the explicitly protected legacy deletion,\n+and the final one-branch inventory remain separate uncompleted actions at this\n+source checkpoint.\n+\n+\n+## Reconciled-source inventory check\n+\n+The first seven-gate run on `c3ae6e71d7b0da4b43b0c7aa6df34aeabf838f47`\n+passed six commands and failed the distributed-source inventory check. The\n+complete failed receipt has SHA256\n+`df8fafcf273cdd00bf2a3a468cbc7e4d318235f0b14a5033f93bfe16c37db512`.\n+Both source observations were equal and verified 41,677 entries and\n+3,994,945,659 bytes. The two new current PQ JSON paths were absent from the\n+generated native inventory. The original generator adds exactly those two\n+`include_bytes!` records, without removing or changing an existing entry.\n+The sole plan and its corpus pin are updated after the correction. The new\n+commit must pass its own gates; the original failed run remains failed.\n+\n+### 2026-11-14: PublicPolicy ID prefix-equivalence successor of M8\n+\n+This local component starts from M8 ed0d35487f2a67239e4d646fd41c2c7acb5cc740\n+(tree 1aa9c21812489080980bdc3c1c2bb43611e88354). The reviewed Rust patch is\n+16,945 bytes, SHA-256\n+519f7b6950743386f53e655edf5e31d3f198de581c7125461a08b28d81211a37.\n+The original public_v3.rs is 433,736 bytes, SHA-256\n+1a90c3eebf8a8642264f8a65ef906f5bdb9c1e656fab8650dc028328f104fb70;\n+the candidate is 438,782 bytes, SHA-256\n+0fd32665f5a666af27d8650214cdfd956d1efb5f72927a003ff0b7c84d10f49a.\n+Reversing the four declared transformations recovers the original file byte\n+for byte, including all 84 preexisting test bodies and all Host, authorization,\n+nonce and deadline code.\n+\n+The private cache retains the unfinalized state of the existing pon_wire::hash\n+framing after its immutable 5,105-byte prefix: 79 complete SHA-256 blocks plus\n+49 buffered bytes. The six original framed dynamic fields add 61 bytes; warm\n+calls finalize two blocks from a cloned state. These are encoding counts, not\n+measurements or a latency bound. Cold initialization still performs the prefix\n+work. The four-thread control checks independent clone results, but does not\n+guarantee that the harness scheduled simultaneous cold initialization.\n+\n+Actual observations remain distinct:\n+\n+- Mac libtest compilation: HOLD, 11 existing Darwin fixture errors and zero\n+  executed Rust tests; summary SHA-256\n+  2447c1d7d7300e3a1b8d0d2591ad362c294b261510ef493511496d0a8bfcdcdf.\n+- Independent Linux M8 plus the exact single-file Rust proposal: serial\n+  RUST_TEST_THREADS=1 passed the three new controls and original full-qualified\n+  golden. Strict all-target/all-feature Clippy with -D warnings passed.\n+  Summary SHA-256\n+  bf16496bd43d61e935e84748177d8add0ef5cc661be35f77ddb2ec11f94448f4.\n+- Default-harness follow-up: all RUST_TEST_* environment variables were removed;\n+  unchanged 3-prefix and 1 --exact commands passed with no ignored tests.\n+  Summary SHA-256\n+  0be788fea02aa1a59869c7610f42002c39954f52a63b4f4a76bfdf78f038780a.\n+  Clippy was not repeated. Both Linux records verify that the root M8 worktree\n+  stayed clean and the independent uncommitted proposal did not change.\n+- Original Python policy-vector 7/7 and Hash-use 33/33 controls, the actual\n+  Hash-use inspector and workspace formatting passed; summary SHA-256\n+  6464a84fa41517c4d41b0ff4a03032009347c079a904e363a291ed7c4ad8a27a.\n+- The first budget suite encountered the Mac system temporary directory's\n+  symlink ancestor: Ran 58 tests; failures=1, errors=4, including two\n+  subtest errors in one method. That failure is preserved. With only a\n+  canonical temporary directory selected, unchanged\n+  budget58, current-correspondence25, composition60 and chain-claim57 all\n+  passed. The three actual inspectors retained HOLD/HOLD_NO_GO and\n+  activation=false. Summary SHA-256\n+  ec1a745291e4ec3f4cda2eb9769d7196490edabc49e92587a17f2dca43b0f9be.\n+\n+The Linux compilation warning \"SQLite I/O boundary UNQUALIFIED: RUSTC must be\n+absolute\" is retained. The hash controls grant no SQLite/native acceptance;\n+Clippy applies to the exact isolated Rust-proposal source. These are not\n+hosted 4-second results.\n+\n+For one reviewed successful paid RPC, the server computes the base policy ID\n+once for cookie construction, once for Solution validation, once for body\n+validation and once for response construction; the client computes it once\n+and reuses it. WaitGrant polling does not repeat it. This is a per-RPC static\n+count, with no proven global invocation bound. Two historical numbers are\n+different: the W1 trace's 1,099 fresh Host observations are\n+3 + 256 + 128 + 512 + 200; the separate x64 policy-stage lower bound is\n+370 issued + 369 spent + 360 delivered = 1,099 (ARM:\n+524 + 519 + 510 = 1,553). The latter uses distinct server counters, not direct\n+id() instrumentation, an exact 4-second interval or a Host count.\n+\n+This successor's current 21-path map changes only the public_v3.rs digest.\n+Its new raw-map SHA-256 is\n+4f234fbff89fdf5693b4d7b82676a46574f92e297fdd535101110a76b9abb3e0,\n+and canonical source-map digest is\n+e8b0d9ceb227e95a045cee1b9224719c8b9ac9c416f8f503218bfee0160d57dc.\n+The current reader and composition independently bind this pair. These\n+successor metadata bytes are not claimed to exist at the M8 commit. Frozen\n+V1 budget, source lock and V2 composition remain respectively SHA-256\n+0315e07ca2988b3b209a6fd2980ca6d9aa22a5bb3aa98b5444a041852b2f0afd,\n+094dcae805f3872ee621d6554ab26a7a3a34c498e21be669740949ada424ccb2 and\n+5b527fbd56885bf7a7cba7516a45f0f911479b0d2867d03ff5361ee3e7a8b052.\n+Path sets, mathematics, caps, flags and source-revision limitations are\n+unchanged. H1's 19-use/31-source inventory is not expanded: the helper retains\n+the existing PublicPolicy SHA-256 purpose, reviewed by framing/oracle evidence,\n+without claiming full-callgraph coverage. No nonce optimization, Host-check\n+reduction, limit increase or qualification waiver is included.\n+\n+### 2026-11-14: Reconcile the later 096c6b CI increment\n+\n+The complete remote observation from 11:25:36 to 11:25:49 UTC retained 908\n+branch names and 892 distinct tips. Only the integration candidate advanced\n+from 5a4b7fe8de1adce803184f262fd9f704ead1930c to\n+096c6b5f9b952c49389fd975515744074ba61317; the other 907 refs and main remained\n+unchanged. That one-parent increment modifies seven files. This normal\n+reconciliation retains both it and local 1e54c4ff66a92827c83bea8715f59f6b299e98cf.\n+\n+The three selected W1 CI files require all 19 named factorial kernel controls\n+and correct floating-point endpoint validation. The original 120-second\n+producer endpoint remains the bound: deadline <= started + 120, remaining\n+must equal deadline - started, and completion must be strictly before the\n+deadline. The added cases cover an exact producer endpoint whose subtraction\n+rounds above 120, and reject an extended endpoint, mismatched remaining\n+duration and completion at the endpoint. The workflow's nine batch controls\n+and original shard budgets remain.\n+\n+The incoming Hash-use source map agrees with the local map for 30 of 31 paths.\n+Its remaining store identity belongs to the concurrent store variant that was\n+not selected in the earlier review. The complete local H1 manifest and reader\n+therefore remain unchanged, including their 19 declared purposes and false\n+qualification fields. The generated inventory is already byte-identical.\n+The local 2,606 corpus pins and 2,510 required paths, including the B1 raw\n+historical fixture and both current PQ manifests, are retained; only the\n+three selected W1 pins and appended plan pin are updated.\n+\n+Before this reconciliation, the first Linux P1 attempt stopped before running\n+the repository lane: the existing sparse-checkout setting reapplied two\n+skip-worktree flags and removed two tracked historical ZIP files. Restoring\n+the full checkout from the existing local Git objects left the commit and\n+tree unchanged. The original source verifier then accepted all 41,677\n+tracked entries. A separate P1 run finished at 11:28:39 UTC with all 18 stages\n+successful; its original repository lane took 546.056 seconds within the\n+unchanged 2,700-second budget. That receipt is bound to\n+6a8cd55573065ceb50cdb65a7834615f79b521ae, not this later merge. Original\n+failures remain preserved, and the merged commit still requires its own\n+gates. No hosted four-second result or whole-system qualification is granted.\n+\n+The first local merge-validation attempt invoked the unchanged Linux-oriented\n+W1 controls on macOS and stopped with 'Ran 31 tests; failures=1, errors=6'.\n+All six error events report the missing '/proc/sys/kernel/random/boot_id';\n+the cancellation test separately reports '0 != 1'. These are preserved as\n+failures, without inferring that every failure has the same cause. No test\n+or producer is altered to make macOS pass. The normal merge is finalized\n+after its repository and inventory checks; the original Linux lane must\n+validate this merged source separately before publication.\n+\n+### 2026-11-14 reconcile local ABFC and concurrent 2a source\n+\n+This reconciliation selects the reviewed concurrent candidate\n+`2a86462a1ab20c68151719ba4635e3c294391e64` together with the independent\n+local `abfcff23d4e2aab7dfd92dfb34937ec7d6021ead` corrections. It is an\n+integration candidate; main merge, complete remaining historical review and\n+remote branch cleanup remain pending.\n+\n+The 42 active differences were read and independently rebound to native Git\n+bytes. The 298 retained evidence paths and all 327 ZIP members were checked\n+for custody and complete CRC/hash reads. That check does not confer source\n+semantics or successful execution on historical programs. Four metadata\n+files missing from the original-full-lane index were recovered byte for byte\n+from their declared source copies; the original index is unchanged.\n+\n+Select the immutable PublicPolicy hash-prefix cache without changing any\n+domain, resource bytes, framing or six dynamic fields. All 84 existing test\n+definitions remain intact; the three added definitions and structural hash\n+work reduction alone do not prove the four-second target. Preserve the local\n+public_v2 strict-signature completion deadline fix.\n+\n+Select Node store d596dc6 with epoch capture before readiness and same-row\n+work checks before time deferral. The previous local preference for 3bce39ce\n+is withdrawn: an independent SQLite writer can otherwise be captured after\n+readiness, and simultaneous future time can mask a typed local work-integrity\n+fault. Both counterexamples are static; no new exploit, global transaction\n+snapshot, public-listener shutdown or native performance result is asserted.\n+\n+Select the raw fixed historical collector fixture as read-only evidence.\n+Use the remote closed-gate TERM deferral with the composed 16-control suite;\n+its real post-fork refusal keeps raw same-root wait status and requires a\n+recorded causal KILL event for the signal branch. This does not weaken the\n+ordinary exit-125 check, the original kill/grace boundary or cleanup ownership.\n+\n+Use the concurrent current source maps for their exact selected bodies.\n+Retain the earlier FC39 audit and its original failures/passes as historical\n+records; finite PASS results do not prove the two uncovered store schedules.\n+The current authority44 and lifetime20 maps select 5c04c60e; the current QROM\n+comparison still fixes both provenance lock fields 0 and 2. No frozen\n+mathematical claim, historical failure or qualification flag is upgraded.\n+\n+The original 096 protocol head and prospective-merge archives both retain\n+five exit-zero native children, but their pressure confirmations fail\n+CONFIRMATION_TARGET with PUBLIC_REQUEST_DEADLINE. The original 4,000,000,000 ns\n+window and 16 workers are unchanged. The later 2a ARM and x64 cost jobs also\n+report failure; their original artifacts are under separate inspection.\n+No new committed-source gate or native target PASS is claimed by this entry."},{"sha":"8308164308dbaa7504a167f30e0a2ab0fc553227","filename":"docs/development/TRNM_AI_NATIVE_BLOCKCHAIN_DEVELOPMENT_PLAN.md","status":"modified","additions":349,"deletions":21,"changes":370,"blob_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/blob/5df7ae6f482157c5f7fdcbcd52222117a965053f/docs%2Fdevelopment%2FTRNM_AI_NATIVE_BLOCKCHAIN_DEVELOPMENT_PLAN.md","raw_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/raw/5df7ae6f482157c5f7fdcbcd52222117a965053f/docs%2Fdevelopment%2FTRNM_AI_NATIVE_BLOCKCHAIN_DEVELOPMENT_PLAN.md","contents_url":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/contents/docs%2Fdevelopment%2FTRNM_AI_NATIVE_BLOCKCHAIN_DEVELOPMENT_PLAN.md?ref=5df7ae6f482157c5f7fdcbcd52222117a965053f","patch":"@@ -14311,26 +14311,6 @@ does not close the separately recorded Page JSON parsing-account gap or\n qualify the other source changes on that historical branch.\n \n \n-### 2026-11-14 retain the reviewed hash-purpose proof descriptor binding\n-\n-The existing hash-purpose source guard correctly refused the stale proof\n-descriptor identity after the independently reviewed standalone verifier lock\n-alignment. Rebind only that descriptor within the existing 31-path inventory\n-and retain the exact 19-use semantic identity. The descriptor changes only the\n-byte count and digest of its selected W1 implementation map. That map preserves\n-the 16 selected inputs and 140 local-closure inputs, updating the one verifier\n-lock in both inventories with its explicit review record.\n-\n-The selected RISC Zero package versions, sources, checksums and resolved direct\n-dependency edges, proof parameters, expected image and control identities, historical proof materials and unresolved obligations stay\n-unchanged. The hash-purpose inspector still refuses unreviewed source changes\n-or automatic repinning. Its existing 33 finite controls and positive source\n-inspection are the validation scope for this correction; successful inspection\n-continues to report HOLD_NO_GO, unknown security bits and no production\n-activation. Original failed CI records remain valid observations of their\n-original source. This binding supplies no new native execution, complete\n-callgraph review, authenticated history or cryptographic qualification.\n-\n ### 2026-11-14 consolidation: cooperative paged restore owner contract\n \n This compatible port preserves the controlled restore capability from\n@@ -15148,10 +15128,309 @@ all 67 actually observed absolute project inputs match this checkpoint, with\n 60 modules loaded before and 61 afterward. This selected-input comparison\n does not claim a complete checkout or resolve the 7,331 relative open events.\n \n-### 2026-11-14 frozen branch-disposition inventory and integration record\n+### 2026-11-14 frozen branch-disposition audit and integration record\n \n The [branch consolidation audit](BRANCH_CONSOLIDATION_AUDIT_20261114.md) records all 908 frozen branch names, 892 distinct tips, 296 terminal dispositions and the selected current implementation. Its evidence index preserves original successful and failed controls, source identities, dependency findings and unselected historical alternatives. The original hosted four-second confirmation gate, protected main requirements and legacy deletion protection remain independent conditions. This audit does not activate a production profile or declare the one-branch remote result before a verified protected merge and reference cleanup. This file remains the sole development plan.\n \n+### 2026-11-14 reviewed PQ lifetime default mapping after the first full-lane failure\n+\n+The published source `dc42ce4df5cff79cc61c5addbaf01074b56b06ca` (tree `9fda17fed2542b2baccaa34585bb00afd699e12b`)\n+stopped in the original repository-truth lane after 6.677 seconds: the original\n+58 lifetime controls reported 57 passes and one stale `pon_work.rs` source pin.\n+The complete original Linux receipt and 21-path review are retained in\n+[the corrective mapping evidence](../../evidence/pq128-lifetime-source-binding-20261114/README.md).\n+A previous static proof that the 0f9 input bytes were preserved did not establish\n+that the active default inspector could bind the current physical source.\n+\n+Review all 21 old/current Git blobs before rebinding the default current register:\n+eight selected source bodies changed and thirteen remain identical. Retain the\n+old mapping and failure as historical evidence. Keep the original budget reader,\n+58 controls, event roster, arithmetic, security parameters and false/null flags.\n+Synchronize the composition bridge to the exact reviewed children and strict\n+21/46/1/66 union; adapt only two old count expectations in its original 60 controls.\n+The already correct 46-path root register and historical proof profiles do not change.\n+\n+Run the complete original lane on the final successor commit, including this\n+documentation. Targeted local controls do not assert a full lane pass, hosted\n+confirmation, production qualification or a protected main merge. The original\n+2700-second lane limit and four-second/16-worker hosted confirmation gate remain.\n+\n+The successor's targeted Mac validation passed the original 58 lifetime controls,\n+60 composition controls and 147 direct-consumer controls, plus all five actual\n+inspectors and the current CI/corpus contracts. The 79 selected inputs matched\n+before/after and all 16 stale-binding negatives refused. The original first Mac\n+composition failure (including its strict temporary-path refusal) remains\n+separate evidence. No complete successor Linux lane or hosted result is claimed.\n+\n+### 2026-11-14 reviewed follow-up after the second full-lane failure\n+\n+The complete original Linux lane on source 7d8d4c59fcd01480a12e1c64835b202079091800\n+failed in the hash-use source binding after 30.922 seconds of its unchanged\n+2700-second limit. Preserve that failed receipt and both original streams.\n+A separate diagnostic then executed all 122 remaining original command units:\n+116 exited zero and six exited nonzero. Its outer continuation process completed,\n+but it is not a successful full fail-fast lane. The six failures identify the\n+hash-use map, fixed-probability map, joint-consensus map and historical collector\n+binding. The complete original diagnostic package is retained in the\n+[follow-up integration record](../../evidence/branch-consolidation-followup-20261114/source-binding-integration-v1/README.md).\n+\n+Integrate the reviewed component commits e811c204e039565c06f5bb2cba3543564f510f7b,\n+2d9baf313e54e49a4507c5057578e89ddbe7a1b6, 6418023d7f60e6e0c42f08c8726085a2b983757b\n+and 341a8b5f751342b51a4aaf9512534853c79d7b5b without rewriting their history.\n+The hash-use map retains 31 inputs and 19 uses; the fixed-probability relation\n+retains its four inputs, probability 1/16 and research credit 16u; the joint map\n+retains exactly 23 inputs and names the actual committed fixed-probability child.\n+The original 33 hash-use, 16 fixed-probability and 35 joint methods passed.\n+Only the joint revision-identity method adapts its current checkpoint and adds\n+the old revision to its refusals. Independent old-map refusals remain.\n+\n+For the retained native collector, require the one original e4abb172 source,\n+016ebf3 tree, original context digest and exact 23,639-byte producer as data.\n+Keep current collector improvements and all original ZIP/context/report bytes.\n+The original 25 bridge methods remain unchanged and pass with six new boundary\n+controls; the new corpus dependency-omission/tamper control also passes.\n+No historical native producer is imported, compiled or executed. These results\n+do not authenticate a native build or grant service or quantum qualification.\n+\n+Refresh only the twelve reviewed existing corpus pins and add the one required\n+historical raw producer. Preserve the complete historical Markdown text while\n+changing its evidence carrier to .md.original, so its thirteen old relative links\n+are not misrepresented as links in the new current location. The repository\n+link checker and all original test thresholds remain unchanged.\n+\n+The exact committed successor still needs the original complete source and\n+Linux gates and required hosted checks. The newly observed C0 external-evidence\n+failure is independently under review; these four fixes do not claim to repair\n+that different gate. No protected main merge, branch deletion, production\n+activation, deadline relaxation or one-branch completion is declared here.\n+\n+### 2026-11-14 current public-readiness selected-body binding\n+\n+Merge the reviewed readiness component a3495dab9979a7630373c979399c7e29e5cf6e5b.\n+The old observation_only body pin matches the historical 2bb/332d body.\n+The current body adds only the already selected TLS endpoint-witness refusal\n+before namespace effects, after the retained M06 account-profile check.\n+Update that one independently reviewed body pin; retain the historical growth\n+body, DDL, domain, typed-mode and namespace checks. All original 76 method bodies\n+remain unchanged, with one new method covering three unsafe guard mutations.\n+\n+The first Mac run is 77 attempted, 69 passed, eight environment errors and zero\n+assertion failures. Its missing numpy/cryptography dependencies and all original\n+streams are retained. Do not relabel it as 77 passing. Use the prepared exact\n+Linux dependencies for the complete 77-method suite and original external\n+lane, and keep the complete repository-truth lane on the same committed source.\n+\n+The e1bf source gates separately recorded six passes and one corpus failure\n+because this plan's appended bytes were not yet reflected in its pin. The\n+one-leaf 308878 correction preserved that failure; synchronize this new plan\n+blob after this appendix as well. Preserve all failed observations and original\n+qualification boundaries. The current four-second pressure confirmation\n+failure remains an independent runtime problem; no source-map repair closes it.\n+\n+\n+### 2026-11-14 original Linux lane and closed exec-gate cleanup\n+\n+The exact 1a7afc source passed all seven local source gates with identical\n+before/after identities: 41,653 tracked entries and 3,994,532,888 bytes.\n+Its original Linux repository-truth command then ran for 496.806 seconds and\n+failed. The final owned-process collector suite passed 13 of its original\n+14 methods; the post-fork identity-refusal control received the actual wait4\n+return code -15 where the original contract requires 125. The original\n+source-before/source-after identities remained equal. Preserve that full\n+failed execution, not only its last assertion.\n+\n+Merge reviewed component b71b84bbccd9bc403384921802e7edcf2e682242. After a\n+successful close of the never-released exec gate, defer only the first TERM\n+to that exact root so it can read EOF and return its original refusal code.\n+Keep the existing KILL escalation, total cleanup grace, descendant signals,\n+released-root cleanup, actual wait4 status and original command deadline.\n+The original 14 method bodies remain byte- and AST-identical. Two new\n+deterministic controls cover the unchanged escalation boundary and the roots\n+that must not receive this deferral.\n+\n+At this integration checkpoint the changed collector has syntax/static\n+validation only. Run the complete 16-method suite and the original full\n+Linux lane on the committed integration source; do not infer a pass from\n+the code review. Historical source-object recovery and the external-evidence\n+lane remain separate validation. The unchanged active Rust implementation\n+still has original C0 pressure-confirmation failures. No main merge, branch\n+deletion, production qualification or single-branch completion is declared.\n+\n+\n+### 2026-11-14 exact collector count and complete historical-evidence lane\n+\n+The original full Linux repository-truth lane on 08c9becab740ab2c375b970f376a7638f44c9e8e\n+ran for 481.260 seconds and failed after all 16 collector controls passed in\n+2.664 seconds. This includes every original 14 method and both added signal\n+controls; the previously failing post-fork identity-refusal control passed.\n+The later shell guard still required exactly 14 and rejected the actual 16.\n+Preserve original receipt c39d394f383dd88f31544292e3222b8a76f69ebea86377099a6192e8bbba9777\n+and all 39 original execution files as a failed full lane.\n+\n+Merge f0f6a4192dc3bcda2fca20110322f7cff07e4644: align the shell and independent\n+CI contract to exactly 16. Preserve rejection of skips, incomplete/duplicate\n+counts, failed runs and missing logs. The original four CI methods passed;\n+negative fixtures retain bad counts 0/13 and additionally reject old 14 and\n+incomplete 15. Synthetic parser fixtures are not collector execution.\n+No collector method, runtime, command deadline or native workload changes.\n+\n+The separate original external-evidence-contract lane on the same 08c9beca\n+source passed in 225.948 seconds; all 77 readiness tests passed in 36.691\n+seconds. Both source identities remained 41,671 tracked entries and\n+3,994,762,924 bytes. Receipt 624efff452b6bd0b2c6ebcf9a47abe3216999a7d051d1e7d0fb9e5ea86fb2ca3\n+records all 12 driver stages, the original 30-command lane and no source fetch.\n+The materializer verified all 14 declared historical trees with fetched=[].\n+These observations bind 08c9beca, not the new integration commit.\n+\n+Run the original complete repository-truth lane on the new committed source.\n+Current-source consistency and historical-evidence checks do not repair the\n+unchanged active Rust four-second/16-worker CONFIRMATION_TARGET failures.\n+Main integration, protected branch cleanup and a one-branch result remain\n+pending; no required check, source identity or production acceptance is waived.\n+\n+### Concurrent candidate reconciliation — frozen scope and selected source\n+\n+The concurrent candidate `5a4b7fe8de1adce803184f262fd9f704ead1930c` is reconciled with the reviewed\n+M6 source `2a62061177852dc3ebd200fa8d7c66c661a119a1`. The original908-name/892-tip audit and296\n+terminal dispositions remain the frozen audit scope; their evidence and all\n+intermediate L1/H1/B1/F1/F2/C5/C6 records are retained. The concurrent plan's\n+checkpoint-specific claims are not reused as validation of this combination.\n+\n+Keep the complete C0/M6 Node store blob\n+`d596dc6bab16698cd18bcc15bcbbe1fafedf603e` (SHA-256\n+`5918270368c61b420d26910dc5934714e1423f71c686b2d01f8d2e3ccceb990c`). Static source review rejected the concurrent\n+store's two check reorderings because they change the epoch window and fatal\n+error precedence. This is a source-level finding, not a claim of an executed\n+attack. Adopt the independent worker artifact metadata prevalidation and\n+locked-baseline strengthening, with its two additional controls.\n+\n+Retain the exact C0 frozen PQ V1 register/lock and v2 composition JSON bytes.\n+Current21 acceptance moves to the explicit reviewed correspondence namespace;\n+its raw map SHA-256 is `b1a3e6d9124aa3e15b3f1e46ba361cc3876514f587eeaf4ff7d4530d4b8e2c7a`, snapshot\n+`69b8f761e92ecd0d43378f44eae7458a0acced35bd9323a171fe59fd843cf5f9`. Only the concurrent store digest changes in that map.\n+Keep M6's44-authority,20-current-lifetime and31-hash-purpose bindings. The\n+current composition still joins21 and46 declared paths with one shared release\n+path and exactly66 unique inputs. All arithmetic, unknown values, limits and\n+false/null qualification fields remain.\n+\n+Keep the original58 budget command alongside the25 current-correspondence\n+controls and reader. Keep the historical B1 collector carrier and its source\n+guard. Preserve the exact16 owned-process collector count and the independent\n+bad0/13/14/15 refusals, together with the existing failure, skip and timeout\n+semantics. Retain both endpoint-witness readback control methods (static78 total),\n+the explicit SQLite connection closure, exact SP27 child command/status binding,\n+typed receipt equality, original native-completion phase controls and the\n+independent10-method W1 current-stage workflow roster.\n+\n+This reconciliation was prepared from immutable source evidence without running\n+new tests, native workloads or hosted gates. Existing M6 successes and concurrent\n+failures remain observations of their respective sources. The combined source\n+must independently pass the original complete local lanes and required hosted\n+head/prospective checks. The four-second confirmation budget,16 pressure workers,\n+fresh Host checks,30-second campaign and protected-main conditions are unchanged.\n+No waiver, production activation, protected merge, branch deletion or single-branch\n+remote completion is asserted here. This remains the sole development plan.\n+\n+\n+### Root validation checkpoint before publishing the reconciled source\n+\n+M6 `2a62061177852dc3ebd200fa8d7c66c661a119a1` passed all seven Mac source\n+gates, the original complete Linux repository-truth command (582.575 seconds),\n+and the original complete external-evidence command (221.499 seconds, 77\n+readiness methods). Its publication attempt stopped before any push when the\n+remote candidate had advanced to N; the failure remains an original pre-push\n+HOLD. The [audit report](BRANCH_CONSOLIDATION_AUDIT_20261114.md) records the\n+receipts and the explicit 53-path merge selection. New results must bind the\n+actual reconciled commit and tree. Source pins are refreshed only after this\n+final plan append. This checkpoint grants no hosted, production or single-branch\n+completion claim.\n+\n+\n+### Generated inventory completion after the reconciled-source check\n+\n+The seven source gates on `c3ae6e71d7b0da4b43b0c7aa6df34aeabf838f47`\n+reported six passes and one distributed-inventory failure with unchanged\n+source identities. The original generator adds only the two newly selected\n+current PQ JSON paths to the embedded native inventory. Existing inventory\n+records and checker semantics remain. The original failed receipt is retained\n+in the audit report; this successor requires new exact-source validation.\n+\n+### 2026-11-14: PublicPolicy ID prefix-equivalence successor of M8\n+\n+The isolated successor starts from M8 ed0d35487f2a67239e4d646fd41c2c7acb5cc740\n+and changes only the existing PublicPolicy::id computation in\n+trillionnium/crates/trnm-pon-node/src/ingress/public_v3.rs. A private OnceLock\n+retains the unfinalized SHA-256 state after the immutable 5,105-byte framed\n+prefix. Each call clones it and appends all six original framed suffix fields.\n+The original resource literal, domain, encoding, returned bytes, fresh Host\n+checks, nonce order, deadline cadence, 4-second window and 16 pressure workers\n+are unchanged. The 84 original tests in that file remain byte-identical; three\n+oracle/suffix/clone-independence controls are added. No nonce optimization is\n+included.\n+\n+The Mac libtest build remains HOLD with 11 existing Darwin fixture errors\n+before any test ran. On the independent Linux M8-plus-Rust-proposal worktree,\n+the first run used serial RUST_TEST_THREADS=1 and passed three new controls\n+plus the original golden. A separate run removed every RUST_TEST_* environment\n+variable and passed the same 3 + 1 with the default harness. Strict all-target,\n+all-feature Clippy passed and was not repeated. Its SQLite I/O boundary warning\n+about nonabsolute RUSTC remains in the raw evidence; these results grant no\n+SQLite/native or hosted-performance qualification.\n+\n+The current correspondence/composition digests change only for the reviewed\n+source bytes. All three frozen model/lock/composition JSON files, historical\n+identities, mathematical controls, caps and false qualification fields remain\n+unchanged. After preserving the Mac temporary-directory symlink refusal, the\n+same original 58 + 25 + 60 + 57 consumer controls passed with a canonical\n+temporary directory. Seven policy-vector and 33 Hash-use controls also passed.\n+The Hash-use reader still covers only its 19 declared purposes and 31 sources,\n+not this entire call graph. The normal merged-source and hosted gates remain\n+required; no 4-second completion or latency improvement has been measured.\n+\n+### 2026-11-14: Reconcile the later 096c6b CI increment\n+\n+This reconciliation combines local 1e54c4ff66a92827c83bea8715f59f6b299e98cf\n+with remote 096c6b5f9b952c49389fd975515744074ba61317, whose single parent is\n+5a4b7fe8de1adce803184f262fd9f704ead1930c. It selects the three reviewed W1\n+workflow/control files, retaining the original producer endpoint, 120-second\n+budget and strict completion-before-deadline condition. The workflow requires\n+all 19 named factorial kernel controls; its nine batch controls remain.\n+The identical generated inventory needs no further change. The existing H1\n+31-source/19-purpose manifest and reader remain bound to the selected complete\n+store implementation; current PQ correspondence, frozen records and the B1\n+historical fixture remain. Only the three selected W1 corpus pins and this\n+plan pin change. The resulting commit requires its own original source,\n+repository and external-evidence gates before publication and protected merge.\n+\n+### Retained pre-reconciliation audit text\n+\n+The following exact text from local ABFC is retained as historical context.\n+Its then-current FC39 labels do not describe the selection below. Original\n+execution observations keep their original source identities and limits.\n+\n+```text\n+### 2026-11-14 retain the reviewed hash-purpose proof descriptor binding\n+\n+The existing hash-purpose source guard correctly refused the stale proof\n+descriptor identity after the independently reviewed standalone verifier lock\n+alignment. Rebind only that descriptor within the existing 31-path inventory\n+and retain the exact 19-use semantic identity. The descriptor changes only the\n+byte count and digest of its selected W1 implementation map. That map preserves\n+the 16 selected inputs and 140 local-closure inputs, updating the one verifier\n+lock in both inventories with its explicit review record.\n+\n+The selected RISC Zero package versions, sources, checksums and resolved direct\n+dependency edges, proof parameters, expected image and control identities, historical proof materials and unresolved obligations stay\n+unchanged. The hash-purpose inspector still refuses unreviewed source changes\n+or automatic repinning. Its existing 33 finite controls and positive source\n+inspection are the validation scope for this correction; successful inspection\n+continues to report HOLD_NO_GO, unknown security bits and no production\n+activation. Original failed CI records remain valid observations of their\n+original source. This binding supplies no new native execution, complete\n+callgraph review, authenticated history or cryptographic qualification.\n+```\n+\n+```text\n ### Corrective audit checkpoint and remaining consolidation work — 2026-11-14\n \n The active local corrective source is\n@@ -15218,3 +15497,52 @@ a newly verified full-history archive, merge through the existing protected\n main process, then verify reference cleanup. These outcomes remain pending;\n no one-branch remote result, complete-repository qualification or production\n activation is claimed. This file remains the sole development plan.\n+```\n+\n+### 2026-11-14 reconcile local ABFC and concurrent 2a source\n+\n+This reconciliation selects the reviewed concurrent candidate\n+`2a86462a1ab20c68151719ba4635e3c294391e64` together with the independent\n+local `abfcff23d4e2aab7dfd92dfb34937ec7d6021ead` corrections. It is an\n+integration candidate; main merge, complete remaining historical review and\n+remote branch cleanup remain pending.\n+\n+The 42 active differences were read and independently rebound to native Git\n+bytes. The 298 retained evidence paths and all 327 ZIP members were checked\n+for custody and complete CRC/hash reads. That check does not confer source\n+semantics or successful execution on historical programs. Four metadata\n+files missing from the original-full-lane index were recovered byte for byte\n+from their declared source copies; the original index is unchanged.\n+\n+Select the immutable PublicPolicy hash-prefix cache without changing any\n+domain, resource bytes, framing or six dynamic fields. All 84 existing test\n+definitions remain intact; the three added definitions and structural hash\n+work reduction alone do not prove the four-second target. Preserve the local\n+public_v2 strict-signature completion deadline fix.\n+\n+Select Node store d596dc6 with epoch capture before readiness and same-row\n+work checks before time deferral. The previous local preference for 3bce39ce\n+is withdrawn: an independent SQLite writer can otherwise be captured after\n+readiness, and simultaneous future time can mask a typed local work-integrity\n+fault. Both counterexamples are static; no new exploit, global transaction\n+snapshot, public-listener shutdown or native performance result is asserted.\n+\n+Select the raw fixed historical collector fixture as read-only evidence.\n+Use the remote closed-gate TERM deferral with the composed 16-control suite;\n+its real post-fork refusal keeps raw same-root wait status and requires a\n+recorded causal KILL event for the signal branch. This does not weaken the\n+ordinary exit-125 check, the original kill/grace boundary or cleanup ownership.\n+\n+Use the concurrent current source maps for their exact selected bodies.\n+Retain the earlier FC39 audit and its original failures/passes as historical\n+records; finite PASS results do not prove the two uncovered store schedules.\n+The current authority44 and lifetime20 maps select 5c04c60e; the current QROM\n+comparison still fixes both provenance lock fields 0 and 2. No frozen\n+mathematical claim, historical failure or qualification flag is upgraded.\n+\n+The original 096 protocol head and prospective-merge archives both retain\n+five exit-zero native children, but their pressure confirmations fail\n+CONFIRMATION_TARGET with PUBLIC_REQUEST_DEADLINE. The original 4,000,000,000 ns\n+window and 16 workers are unchanged. The later 2a ARM and x64 cost jobs also\n+report failure; their original artifacts are under separate inspection.\n+No new committed-source gate or native target PASS is claimed by this entry."},{"sha":"440ee24b4095b240e346e4b320f82c7bad2dade7","filename":"docs/protocol/pon-nakamoto-v1/details/FIXED_PROBABILITY_COST_CONTRACT_V1.md","status":"modified","additions":21,"deletions":0,"changes":21,"blob_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/blob/5df7ae6f482157c5f7fdcbcd52222117a965053f/docs%2Fprotocol%2Fpon-nakamoto-v1%2Fdetails%2FFIXED_PROBABILITY_COST_CONTRACT_V1.md","raw_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/raw/5df7ae6f482157c5f7fdcbcd52222117a965053f/docs%2Fprotocol%2Fpon-nakamoto-v1%2Fdetails%2FFIXED_PROBABILITY_COST_CONTRACT_V1.md","contents_url":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/contents/docs%2Fprotocol%2Fpon-nakamoto-v1%2Fdetails%2FFIXED_PROBABILITY_COST_CONTRACT_V1.md?ref=5df7ae6f482157c5f7fdcbcd52222117a965053f","patch":"@@ -224,3 +224,24 @@ gate is replaced by a successful arithmetic certificate.\n - [BCHN integer ASERT specification](https://bitcoin-cash-node.gitlab.io/bchn-sw/bitcoincash-upgrade-specifications/2020-11-15-asert/): integer division, polynomial, anchor semantics, and reference vectors; deployment parameters are not copied into PoN.\n - [Cojocaru et al., Quantum 7:944](https://arxiv.org/abs/2012.15254v4): multi-solution Bernoulli quantum-query analysis under its stated adversary and honest-miner model; no automatic W1 physical-cost reduction.\n - [Komargodski and Weinstein, ESA 2026](https://drops.dagstuhl.de/entities/document/10.4230/LIPIcs.ESA.2026.2): useful matrix work under explicit hardness conjectures, rather than an unconditional lower bound for arbitrary optimized Cell arithmetic.\n+\n+## Reviewed relation-source mapping, 2026-11-14\n+\n+The current four-file relation-source mapping was reviewed against source\n+checkpoint `7d8d4c59fcd01480a12e1c64835b202079091800`. Its only changed input\n+is `trnm-crypto-primitives/src/pon_work.rs`: the current SHA-256 is\n+`7af17da8488782bf403275b5fd401ad469dd460fd0ecda38a0edb4e714c5494e`.\n+The other three inputs retain their original bytes. The original four pins\n+match source `2bb56596e637908c44b5a2ef5984c9c37c7d3cc8`; their original\n+contract and the actual failed observations are preserved in the\n+[review evidence](../../../../evidence/pon-fixed-joint-source-binding-20261114/f1/README.md).\n+These source checkpoints identify reviewed source bytes, not the later\n+commit that stores this mapping metadata.\n+\n+The reviewed Rust delta contains previously selected owner progress and\n+same-invocation verification changes plus explicit module additions. This\n+mapping edit changes one source digest only. The original reader and all\n+sixteen controls, probability `1/16`, research credit `16u`, context,\n+accounting, strategy roster, sixteen unproved cost points and open obligations\n+are retained. Qualification remains `HOLD_NO_GO`; this selected-source check\n+supplies no all-algorithm cost bound, native execution receipt or activation."},{"sha":"fb577f6b424f19db48e21d0027cf3618e3556bbf","filename":"docs/protocol/pon-nakamoto-v1/details/JOINT_CONSENSUS_QUALIFICATION_V1.md","status":"modified","additions":46,"deletions":3,"changes":49,"blob_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/blob/5df7ae6f482157c5f7fdcbcd52222117a965053f/docs%2Fprotocol%2Fpon-nakamoto-v1%2Fdetails%2FJOINT_CONSENSUS_QUALIFICATION_V1.md","raw_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/raw/5df7ae6f482157c5f7fdcbcd52222117a965053f/docs%2Fprotocol%2Fpon-nakamoto-v1%2Fdetails%2FJOINT_CONSENSUS_QUALIFICATION_V1.md","contents_url":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/contents/docs%2Fprotocol%2Fpon-nakamoto-v1%2Fdetails%2FJOINT_CONSENSUS_QUALIFICATION_V1.md?ref=5df7ae6f482157c5f7fdcbcd52222117a965053f","patch":"@@ -1,6 +1,6 @@\n # Joint difficulty, time and credit qualification contract V1\n \n-Status: **research contract; HOLD_NO_GO**. The reviewed listed source is\n+Status: **research contract; HOLD_NO_GO**. The historical listed-source checkpoint is\n `2bb56596e637908c44b5a2ef5984c9c37c7d3cc8`, tree\n `18cfc660131170a5b0c5c7244987a9fcebfb7e62`. The prior PR #835 source,\n `e2a02f9271b49f146e70806c8a66e161b5973971`, retains its historical identity.\n@@ -63,9 +63,10 @@ these thresholds is supplied by V1.\n \n The machine contract contains exactly **23 SHA-256 source pins**. The roster\n is fixed in the reader; omission, addition or changed bytes requires review.\n-Their canonical map also has a separately fixed digest in the checker,\n+The historical 2bb56596 canonical map had the separately fixed checker digest\n `c142b6758d90e01e1960dc5f7fb110209fa9fd40c25fca22f4010acbc085a459`,\n-verified against the listed Git blobs at the reviewed commit. Editing source\n+verified against the listed Git blobs at that historical checkpoint. The current\n+reviewed map and source checkpoint are recorded in section 8. Editing source\n and JSON hashes together still fails that anchor. A new anchor requires a\n reviewed checker change; there is no automatic repinning option.\n \n@@ -208,3 +209,45 @@ six-confirmation failure bounds, and false activation, finality and execution\n authority. Future qualification requires a reviewed contract revision and\n evidence verifier for the missing premises; editing JSON numbers or booleans\n cannot supply that proof.\n+\n+## 8. Reviewed current listed-source mapping — 2026-11-14\n+\n+The current default contract binds exactly the same 23 source paths to source\n+checkpoint `2d9baf313e54e49a4507c5057578e89ddbe7a1b6`, tree\n+`9d85026774e6d5d8ba63162db5332954831fab74`. This is the actual committed source\n+checkpoint containing the reviewed fixed-probability child contract. It is\n+not the commit that stores this new joint mapping.\n+\n+The independently reviewed canonical map digest is\n+`5fd6aea2f2d1a6a3831853f54c8cc6e83cc8233cc61ab97a01a8e482749be674`.\n+All 23 Git blobs were compared with their physical files. Relative to the\n+historical `2bb56596e637908c44b5a2ef5984c9c37c7d3cc8` mapping, nineteen inputs are\n+unchanged and four have reviewed changes:\n+\n+| Input | Current SHA-256 | Reviewed change |\n+| --- | --- | --- |\n+| `trillionnium/crates/trnm-crypto-primitives/src/pon_work.rs` | `7af17da8488782bf403275b5fd401ad469dd460fd0ecda38a0edb4e714c5494e` | Selected progress API and same-invocation verifier continuation; no change to the MU1 probability or credit relation |\n+| `trillionnium/crates/trnm-pon-node/src/lib.rs` | `baafb16f125fda88b09d2342a0b6badb253497742c9a106921e8416e930f108d` | Previously selected owner and observer exports and advisory Q4 API |\n+| `trillionnium/crates/trnm-pon-node/src/store.rs` | `5918270368c61b420d26910dc5934714e1423f71c686b2d01f8d2e3ccceb990c` | Reviewed snapshot, replay, advisory and confirmation checks; no threshold relaxation |\n+| `formal/pon-nakamoto-v1/fixed_probability_contract_v1.json` | `916cbdcf0f163844d269a7152305de952022f92065d0f70f77a752baa6cba092` | The F1 one-pin source update, with the original probability, costs and qualification boundary preserved |\n+\n+The old map digest `c142b6758d90e01e1960dc5f7fb110209fa9fd40c25fca22f4010acbc085a459`,\n+old contract, reader, tests and document remain original historical evidence\n+in [the source-binding record](../../../../evidence/pon-fixed-joint-source-binding-20261114/README.md).\n+They are not accepted alternate current mappings. The original 35 test methods\n+are retained; the revision-identity method now requires this real source\n+checkpoint and explicitly refuses both the old 2bb56596 revision and the\n+earlier e2a02f92 revision, as well as an unknown revision.\n+\n+The original Linux failures at units 022 and 023 remain recorded with their\n+original exit codes and source-digest failures. The complete 23-input review,\n+full changed-source patches and subsequent focused results are recorded under\n+`evidence/pon-fixed-joint-source-binding-20261114/f2/`. A focused\n+source-consistency result does not substitute for a complete repository lane\n+or a hosted run.\n+\n+This mapping change leaves all eighteen environment parameters unknown,\n+all thirteen obligations open and all sixteen classical/quantum cost points\n+unproved. The development parameters, native semantic contract, null failure\n+bounds, `HOLD_NO_GO`, and false activation, finality and execution-authority\n+flags are unchanged. No Rust runtime source is edited in F2."},{"sha":"bae4d5c9692e451bddb2e46e67facefeb649848b","filename":"docs/research/W1_ORACLE_EVIDENCE_SCOPE_V1.md","status":"modified","additions":29,"deletions":0,"changes":29,"blob_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/blob/5df7ae6f482157c5f7fdcbcd52222117a965053f/docs%2Fresearch%2FW1_ORACLE_EVIDENCE_SCOPE_V1.md","raw_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/raw/5df7ae6f482157c5f7fdcbcd52222117a965053f/docs%2Fresearch%2FW1_ORACLE_EVIDENCE_SCOPE_V1.md","contents_url":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/contents/docs%2Fresearch%2FW1_ORACLE_EVIDENCE_SCOPE_V1.md?ref=5df7ae6f482157c5f7fdcbcd52222117a965053f","patch":"@@ -92,6 +92,35 @@ recorded local block has depth zero and zero timely accepted progress under the\n original service contract. The native test's 16 newly sealed wrong-context cases\n also remain one native test method, not 16 independent safety proofs.\n \n+### Retained collector identity after current-source improvements\n+\n+The retained cohort names source\n+`e4abb172147e941b62483652b0ceabaae4317624` and tree\n+`016ebf3deeac88d6d7a782edf563f2291ebe17f5`. Its context commits to\n+collector SHA256\n+`f40c5d621454d0532141920724a3cfd57e240f4a3b061536162313daa676c254`.\n+The current collector has since acquired exact-source verification. Replacing\n+that historical context digest with the current collector would change the\n+meaning of the retained observation.\n+\n+For this one source, the reader requires the exact historical tree and context\n+digest, then reads the original 23,639-byte\n+[collector as data](../../formal/pon-nakamoto-v1/fixtures/native-collector-e4abb172.py.raw)\n+through the existing bounded regular-file reader. It verifies the independent\n+SHA256, byte count and Git blob identity. Missing data, a changed tree, a different\n+producer, symlinks and nonregular files are refused; the historical source does\n+not fall back to the current collector. Other sources retain the existing\n+current-collector comparison. The raw historical producer is included in the\n+reader's source commitment and is never imported, compiled or executed.\n+\n+The [fixed Git provenance](../../evidence/branch-consolidation-followup-20261114/native-collector-history-v1/README.md)\n+retains the original commit and three tree objects linking that source to the\n+collector blob. Their content addresses were checked independently during this\n+correction. This is a source-content binding, not an independent authentication\n+of the external pins or proof that a native binary was built or executed from\n+that source. The original ZIP, context and saved reports keep their original\n+bytes; no new native execution, service acceptance or qualification is claimed.\n+\n ## Acceptance boundary and remaining work\n \n The engineering exit for this continuation is a reproducible separation of"},{"sha":"caeef93f9bc11228fc8fe5d18923ffca42a7af16","filename":"docs/security/HASH_USE_CONTRACT_V1.md","status":"modified","additions":44,"deletions":0,"changes":44,"blob_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/blob/5df7ae6f482157c5f7fdcbcd52222117a965053f/docs%2Fsecurity%2FHASH_USE_CONTRACT_V1.md","raw_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/raw/5df7ae6f482157c5f7fdcbcd52222117a965053f/docs%2Fsecurity%2FHASH_USE_CONTRACT_V1.md","contents_url":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/contents/docs%2Fsecurity%2FHASH_USE_CONTRACT_V1.md?ref=5df7ae6f482157c5f7fdcbcd52222117a965053f","patch":"@@ -11,6 +11,50 @@ reachable through that digest. Both the checker and its\n [negative controls](../../scripts/ci/test_hash_use_contract.py) run in the\n mandatory `repository-truth` lane.\n \n+## Reviewed current-source map, 2026-11-14 UTC\n+\n+The full local `repository-truth` run at source checkpoint\n+`7d8d4c59fcd01480a12e1c64835b202079091800` stopped at this contract:\n+the original 33 controls reported 31 passes, one failure and one error because\n+the first declared input had changed. The preserved run has summary SHA-256\n+`79d37af0ecec1749098bdfd1cfc7127de2cf9aa928b7271ca4ef8de39cd4061b`.\n+Its 2,700-second limit was unchanged; it exited after 30.922 seconds. Later\n+commands in that fail-fast run did not execute.\n+\n+This successor makes a manual source review of all 31 declared paths.\n+The old pins exactly match their bytes at\n+`57b069ae1e7ed32ff95e4f2a18a74d5eadcda550`. Twenty-five inputs are unchanged;\n+the six changed inputs are the proof-profile binding descriptor, native\n+`pon_work.rs`, Cell `store.rs` and `cell.rs`, and Node `lib.rs` and `store.rs`.\n+All 31 source blobs at the reviewed `7d8d4c` checkpoint are also identical to\n+their earlier `dc42ce4df5cff79cc61c5addbaf01074b56b06ca` bytes. The previous\n+lifetime-register repair did not introduce these changes.\n+\n+The proof descriptor changes only the byte length and SHA-256 of its current\n+W1 mapping. Its selected profile, image/control/parameter identities and\n+withdrawal boundary remain unchanged. The five Rust-file deltas retain the\n+declared hash encodings and output widths while adding separately reviewed\n+APIs or owner/readback checks. Those additional APIs do not acquire coverage\n+under this finite 19-use inventory.\n+\n+The newly reviewed source-map commitment is\n+`15a8d91e0b2c50908d17c6bb9743e8ef5a44927814e59354874d77d9654f9ee7`.\n+The 19-use semantics commitment remains\n+`29189f8e96a255472577479d46204b2b403a1f8e27806da6aa616e417ced0b5b`,\n+and `e4abb172147e941b62483652b0ceabaae4317624` remains the original semantic\n+review context. The source checkpoint identifies the reviewed input blobs;\n+it is not claimed to contain this successor's new mapping metadata.\n+\n+The [review packet](../../evidence/hash-use-current-source-review-20261114/README.md)\n+preserves the previous manifest, reader, original controls, full six-file\n+source deltas, all 31 old/current identities and original failure records.\n+All original 33 controls, reader functions, source-reading limits and\n+qualification values remain unchanged. The independent source-map commitment\n+still rejects unreviewed repinning; the CLI still returns `HOLD_NO_GO` on a\n+successful source inspection. This repair does not establish a full-lane pass,\n+hosted qualification, a complete call graph, a cryptographic security bound\n+or production activation.\n+\n ## Composed W1 mapping review, 2026-11-12 America/New_York\n \n The integration combines the 19-use, 31-source TCG3/CMH2 review from #927"},{"sha":"4e4ac98c9fde929db5de9269f1efd1882cc6cc55","filename":"docs/security/PQ128_LIFETIME_BUDGET_V1.md","status":"modified","additions":70,"deletions":2,"changes":72,"blob_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/blob/5df7ae6f482157c5f7fdcbcd52222117a965053f/docs%2Fsecurity%2FPQ128_LIFETIME_BUDGET_V1.md","raw_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/raw/5df7ae6f482157c5f7fdcbcd52222117a965053f/docs%2Fsecurity%2FPQ128_LIFETIME_BUDGET_V1.md","contents_url":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/contents/docs%2Fsecurity%2FPQ128_LIFETIME_BUDGET_V1.md?ref=5df7ae6f482157c5f7fdcbcd52222117a965053f","patch":"@@ -11,7 +11,74 @@ and [budget checker](../../scripts/ci/pq_lifetime_budget.py) extend the existing\n [whole-chain claim guard](WHOLE_CHAIN_PQ_CLAIM_GUARD_20261031.md). They do not\n transfer an observation or security estimate from another candidate to this one.\n \n-## Current client-construction source binding, 2026-11-13\n+## Current frozen-model and source-correspondence boundary\n+\n+The V1 machine register and source lock retain the exact frozen C0 bytes\n+(SHA-256 `0315e07ca2988b3b209a6fd2980ca6d9aa22a5bb3aa98b5444a041852b2f0afd`\n+and `094dcae805f3872ee621d6554ab26a7a3a34c498e21be669740949ada424ccb2`),\n+with the declared historical source revision\n+`0f9b30549328e5be20f4d3e6e27bd132b42d90de`.\n+The unchanged V1 reader does not accept different current bytes as that source.\n+\n+The separate [current correspondence map](../../config/pon/pq128-source-correspondence-current-v2.json)\n+has raw SHA-256 `4f234fbff89fdf5693b4d7b82676a46574f92e297fdd535101110a76b9abb3e0` and canonical source-map digest\n+`e8b0d9ceb227e95a045cee1b9224719c8b9ac9c416f8f503218bfee0160d57dc`. Its same21 declared event paths bind the reviewed\n+current source bytes, including the selected complete store blob\n+`d596dc6bab16698cd18bcc15bcbbe1fafedf603e`.\n+The reader independently verifies the exact frozen manifest/lock, raw map,\n+canonical21-path digest and every bounded regular source read. A supplied\n+report is accepted only after the same inspection is recomputed.\n+\n+CI retains the original58-method budget command and adds the25 current\n+correspondence controls and current reader. The frozen mathematical result is\n+unbound; the outer record separately records checked current files and\n+`source_revision_bound=false`. The eight unknown terms, four unknown query\n+budgets, numeric assumptions, strict refusal limits and null/false qualification\n+fields are unchanged. Current composition uses its explicit current-v3 namespace.\n+No original failed or successful source-specific observation transfers to this\n+combined source without its own validation.\n+\n+The L1 mapping below is an exact historical integration record. Its reviewed\n+current-source findings and original receipts remain retained in Git and\n+evidence; its two JSON identities are no longer the default frozen inputs.\n+\n+## Historical L1 consolidated source binding, 2026-11-14\n+\n+The default **21-path** register and lock now bind to the reviewed source\n+checkpoint `dc42ce4df5cff79cc61c5addbaf01074b56b06ca`, tree `9fda17fed2542b2baccaa34585bb00afd699e12b`.\n+All 21 old entries match their exact regular Git blobs at the preceding\n+`0f9b30549328e5be20f4d3e6e27bd132b42d90de` checkpoint. All 21 selected current blobs\n+match the clean checkout; eight changed and thirteen remain byte-identical.\n+The [per-path review](../../evidence/pq128-lifetime-source-binding-20261114/reviewed-source-mapping.json)\n+records old/new modes, Git object IDs, byte lengths, SHA-256 values, complete\n+source deltas and the already selected implementation commits.\n+\n+The current register SHA-256 is `ed2558e8e3ee0806395272e20bab4bd63ab8676cc0dda0c790dd82fb13692edc`;\n+the current lock SHA-256 is `59db43efd6a04054c04d97d38cc58df1325c7efc5910dbe7975cb6a63dc487cb`.\n+The review covers the listed event paths only. It neither expands the event\n+roster nor proves a transitive dependency closure or a security theorem.\n+The unchanged reader still hashes actual regular source bytes and refuses\n+missing, changed, substituted or revision-mismatched inputs.\n+\n+The first full Linux repository-truth attempt on this published checkpoint\n+stopped after 6.677 seconds: the original 58 lifetime controls ran with 57\n+passing and one source-lock error at `pon_work.rs`. Its\n+[original receipt](../../evidence/pq128-lifetime-source-binding-20261114/original-full-lane/summary.json)\n+has SHA-256 `9a4bc9c021e80adff3d2c7d5500e1aed3f9eda519efb3942cbd42a2e34c5eab2`.\n+This failure does not establish the result of the unexecuted remainder of the\n+lane. The current mapping is updated after source review, not generated by CI\n+to accept arbitrary bytes.\n+\n+The eight-domain allocations, nine unmet assumptions, eight unknown terms,\n+four unknown lifetime query budgets, exact arithmetic, all source-reader caps\n+and every false/null qualification field remain unchanged. The V2 composition\n+bridge separately binds this register and the already reviewed 46-path root\n+inventory, yielding exactly 66 distinct paths and one shared release source.\n+The old 0f9 register and lock are retained byte-for-byte under the\n+[historical inputs](../../evidence/pq128-lifetime-source-binding-20261114/historical/); their observations\n+are not replayed or relabelled as results for the current source.\n+\n+## Retained client-construction source binding, 2026-11-13\n \n The unchanged **21-path** event roster now binds to source checkpoint\n `0f9b30549328e5be20f4d3e6e27bd132b42d90de`, tree\n@@ -509,7 +576,8 @@ Run from the repository root:\n \n ```sh\n python3 scripts/ci/test_pq_lifetime_budget.py -v\n-python3 scripts/ci/pq_lifetime_budget.py\n+python3 scripts/ci/test_pq_lifetime_current_v2.py -v\n+python3 scripts/ci/pq_lifetime_current_v2.py\n python3 scripts/ci/pq_lifetime_budget.py --manifest config/pon/pq128-lifetime-example-v1.json\n python3 scripts/ci/test_pq_chain_claim_guard.py -v\n python3 scripts/ci/pq_chain_claim_guard.py"},{"sha":"39d4e18d99bea0c8908c5e0279566a63dbe6f461","filename":"docs/security/PQ128_LIFETIME_COMPOSITION_V2.md","status":"modified","additions":60,"deletions":2,"changes":62,"blob_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/blob/5df7ae6f482157c5f7fdcbcd52222117a965053f/docs%2Fsecurity%2FPQ128_LIFETIME_COMPOSITION_V2.md","raw_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/raw/5df7ae6f482157c5f7fdcbcd52222117a965053f/docs%2Fsecurity%2FPQ128_LIFETIME_COMPOSITION_V2.md","contents_url":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/contents/docs%2Fsecurity%2FPQ128_LIFETIME_COMPOSITION_V2.md?ref=5df7ae6f482157c5f7fdcbcd52222117a965053f","patch":"@@ -14,7 +14,45 @@ The new [machine register](../../config/pon/pq128-lifetime-composition-v2.json),\n [V1 lifetime contract](PQ128_LIFETIME_BUDGET_V1.md) and\n [root dependency contract](PQ_ROOT_DEPENDENCY_REGISTER_V3.md).\n \n-## 1. What the source bridge establishes\n+## Current consolidated source bridge, 2026-11-14\n+\n+This reviewed mapping uses source checkpoint `dc42ce4df5cff79cc61c5addbaf01074b56b06ca` as its\n+review context. The current legacy register binds its 21 declared source blobs\n+to that checkpoint; its new manifest SHA-256 is\n+`ed2558e8e3ee0806395272e20bab4bd63ab8676cc0dda0c790dd82fb13692edc`.\n+The unchanged 46-path root register has declared review context\n+`5c04c60e463462d9df8884786e0d5bb32af08a64` and manifest SHA-256\n+`2b641a5e2e1bf66ad924e17d85da21c8cf76d7431fe35c8f448ab921659ba725`.\n+These source-review contexts do not identify the later commits that store the\n+corresponding mapping metadata.\n+Its additional path is the already selected\n+`trillionnium/crates/trnm-crypto-primitives/examples/pq_root_v3_cost_observation.rs`;\n+the exact example bytes match the selected `19940a6653df0d88aba02f264f295a40ee047f96`\n+component.\n+\n+The independent fixed counts are now **21 legacy, 46 root, one shared and 66\n+distinct source files**. The sole shared path remains\n+`trillionnium/crates/trnm-release-bundle/src/pq_release.rs`, with the same exact\n+digest in both inventories. The inspector still reads both exact child\n+manifests, invokes both actual inspectors, compares every shared digest and\n+requires the reviewed path counts and shared path. Count changes do not\n+replace the exact source maps or permit equal-count substitution.\n+\n+Only reviewed input identities, the review context and these exact counts\n+change. All arithmetic, primitive identities, loss accounting, role populations,\n+query-budget unknowns, strict reading limits, nonqualification fields and the\n+original sixty control methods remain. Two existing methods adapt only their\n+fixed 45/65 expectations to 46/66; the historical method name containing\n+`65` is retained as a stable control identifier.\n+The [current review and original failure](../../evidence/pq128-lifetime-source-binding-20261114/README.md)\n+record the exact source scope and original observations. Full repository-truth\n+and hosted acceptance still require their own fixed-source execution.\n+\n+The following section retains the prior bridge's source identities and results.\n+References to its then-current mapping describe that historical review, not the\n+default inputs of this continuation.\n+\n+## 1. Retained source bridge before this continuation\n \n The current legacy V1 budget declares **21 source paths** at\n `0f9b30549328e5be20f4d3e6e27bd132b42d90de`. The current root inventory\n@@ -372,7 +410,7 @@ report continues to contain:\n \n ## Current source correspondence entry (2026-11-14)\n \n-The v2 machine register and the original observation files remain unchanged.\n+The selected frozen v2 machine register is byte-identical to C0; its original observation files remain unchanged.\n The default checker now reads the explicit\n [current-v3 register](../../config/pon/pq128-lifetime-composition-current-v3.json).\n That register retains the exact v2 identity and binds the\n@@ -387,3 +425,23 @@ probability, query budget, theorem applicability or production qualification.\n All arithmetic, unknown values, HOLD results and original refusal limits remain\n in force. Supplying the retained v2 register to the current-v3 checker is refused;\n historical logs retain their original schema and outcome.\n+\n+### Concurrent-source reconciliation boundary\n+\n+The earlier L1 section records the then-current default metadata and its actual\n+source-specific checks. That record and all original evidence are preserved.\n+The active frozen v2 input now has its true C0 SHA-256\n+`5b527fbd56885bf7a7cba7516a45f0f911479b0d2867d03ff5361ee3e7a8b052`.\n+Current source acceptance belongs to the separate current-v3 manifest and the\n+current21 map `4f234fbff89fdf5693b4d7b82676a46574f92e297fdd535101110a76b9abb3e0`, with independent snapshot\n+`e8b0d9ceb227e95a045cee1b9224719c8b9ac9c416f8f503218bfee0160d57dc`. Its selected store is the complete\n+C0/M6 implementation; the concurrent two store-check reorderings were not\n+selected. The root46 input keeps its existing manifest identity\n+`2b641a5e2e1bf66ad924e17d85da21c8cf76d7431fe35c8f448ab921659ba725`.\n+\n+The original arithmetic helpers and limits are unchanged. The full60-method\n+composition roster is retained with explicit namespace/fixture assertions.\n+Frozen V1 is not presented as current-source-bound; actual current21 and root46\n+reads must agree at their one shared release path and yield exactly66 paths.\n+This merged correspondence requires its own checks and conveys no native,\n+lifetime-security, deployment or production qualification."},{"sha":"94a921086fd5136ae12e3308b7017d6bfc226a40","filename":"docs/security/PQ_AUTHORITY_EFFECT_REGISTER_V1.md","status":"modified","additions":23,"deletions":5,"changes":28,"blob_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/blob/5df7ae6f482157c5f7fdcbcd52222117a965053f/docs%2Fsecurity%2FPQ_AUTHORITY_EFFECT_REGISTER_V1.md","raw_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/raw/5df7ae6f482157c5f7fdcbcd52222117a965053f/docs%2Fsecurity%2FPQ_AUTHORITY_EFFECT_REGISTER_V1.md","contents_url":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/contents/docs%2Fsecurity%2FPQ_AUTHORITY_EFFECT_REGISTER_V1.md?ref=5df7ae6f482157c5f7fdcbcd52222117a965053f","patch":"@@ -4,7 +4,7 @@\n \n The [register](../../config/pon/pq-authority-effects-v1.json) binds seven reviewed\n routes to the current listed source checkpoint\n-`fc39da5f35298ce8a4c34aa5bdb25849648612f9`. The\n+`5c04c60e463462d9df8884786e0d5bb32af08a64`. The\n [checker](../../scripts/ci/pq_authority_effect_register.py) enforces their exact\n effect scopes and source sets, and compares 44 actual regular files with a fixed\n reviewed SHA-256 lock. Successful checking reports `source_consistency: PASS`\n@@ -18,9 +18,27 @@ a signature, context comparison, downloaded artifact or certificate observation\n must not be recorded as a different downstream permission. That original source\n inventory did not itself establish a classical bypass of a PQ owner.\n \n-## Active corrective source binding, 2026-11-14\n+## Selected source correspondence after ordering review, 2026-11-14\n \n-The selected checkpoint is `fc39da5f35298ce8a4c34aa5bdb25849648612f9`,\n+The active 44-path correspondence selects\n+`5c04c60e463462d9df8884786e0d5bb32af08a64` and lock\n+`3113f8e9cd6f8f72d190f55e84b97ab7b04da38cd3ddf86be9ab871fc4743528`.\n+Its selected Node store is 391,470 bytes, SHA-256\n+`5918270368c61b420d26910dc5934714e1423f71c686b2d01f8d2e3ccceb990c`.\n+The earlier FC39 correspondence below remains a historical observation.\n+\n+Further inspection found a foreign SQLite commit window between readiness\n+and a subsequently captured epoch, and a same-row work-corruption case that\n+the early time refusal could mask. The selected store captures the epoch\n+before readiness and checks the visited row's work before time deferral.\n+The old inverse-ordering recommendation is withdrawn. This is a source\n+selection with explicit static counterexamples, not a new native execution\n+or a statement that every caller stops a public listener. Seven routes,\n+44 paths and all false qualification fields retain their original scope.\n+\n+## Historical corrective source binding, 2026-11-14 (superseded)\n+\n+The superseded checkpoint was `fc39da5f35298ce8a4c34aa5bdb25849648612f9`,\n tree `20ef410a1ea847a3585de91d5f0a0380009cf874`. All 44 selected\n regular Git blobs were read independently and matched to the checkout.\n The canonical revision-plus-file lock is `f90e400347b1a1431b845cc41eb89a904a629f6095ae9f2967d69b35809c5f56`.\n@@ -629,9 +647,9 @@ The consolidation preserves commits e35cfb3cd85183a3b5beb47ad1287389cc4d1cd5, 49\n \n The incoming sealed-material fixture contains three corrected fixed expected contract hashes for its exact source pair. The current combination additionally contains the reviewed read-only trial-ledger reconciliation command, changing llm_runtime_pilot.py to SHA-256 13e4c11d51931d902483372a9a05c7180333893202ecb1d663d57a83111eccc7. The first integration attempt refused this real producer difference before changing the repository. The final merge rebinds the neural reader and explicit research preparation entry to that exact current pilot and independently derived complete contract. Both original test suites retain their fixed positive identities and all refusal assertions; the prior pilot is an additional explicit refusal. Historical material plan, target and original runtime identities retain their bytes. Both standalone lock blobs already exactly match the reviewed root. Final combined source mappings remain pending; neither this rebind nor preserved historical executions confer native, model, installation or security qualification.\n \n-## Retained consolidated source review, 2026-11-14\n+## Selected consolidated source mapping, 2026-11-14\n \n-The preceding source checkpoint 5c04c60e463462d9df8884786e0d5bb32af08a64 keeps the same seven curated routes and 44\n+The selected mapped source checkpoint 5c04c60e463462d9df8884786e0d5bb32af08a64 keeps the same seven curated routes and 44\n selected paths. Seven selected files changed from the preceding 332d7f72\n review: Cell fetch ordering and controlled cache restoration, the per-call PQ\n account configuration and its controls, Node advisory/store integration, and"},{"sha":"78c21de7954a9c65a751a61e6531d3f325303add","filename":"docs/security/W1_LIFETIME_CURRENT_SOURCE_OBSERVATION_V2.md","status":"modified","additions":22,"deletions":5,"changes":27,"blob_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/blob/5df7ae6f482157c5f7fdcbcd52222117a965053f/docs%2Fsecurity%2FW1_LIFETIME_CURRENT_SOURCE_OBSERVATION_V2.md","raw_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/raw/5df7ae6f482157c5f7fdcbcd52222117a965053f/docs%2Fsecurity%2FW1_LIFETIME_CURRENT_SOURCE_OBSERVATION_V2.md","contents_url":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/contents/docs%2Fsecurity%2FW1_LIFETIME_CURRENT_SOURCE_OBSERVATION_V2.md?ref=5df7ae6f482157c5f7fdcbcd52222117a965053f","patch":"@@ -3,9 +3,26 @@\n Status: **HOLD / NO-GO**. No lifetime bound or cryptographic qualification is\n created by this source-survey continuation of #850.\n \n-## Active corrective source binding, 2026-11-14\n-\n-The current contract selects `fc39da5f35298ce8a4c34aa5bdb25849648612f9`,\n+## Selected source correspondence after ordering review, 2026-11-14\n+\n+The active 20-path contract selects\n+`5c04c60e463462d9df8884786e0d5bb32af08a64`; its SHA-256 is\n+`bd22f0db32c479dd7d42ae541eeed0ad0c1115d40b88b01d07acefd25930fbb7`.\n+The selected store is 391,470 bytes with SHA-256\n+`5918270368c61b420d26910dc5934714e1423f71c686b2d01f8d2e3ccceb990c`.\n+The preceding FC39 selection is retained below as historical context and is\n+superseded following the readiness/epoch and same-row work/time review.\n+The ordered roster, frozen historical hashes, eight changed-path comparison\n+and every lifetime/qualification limitation remain unchanged.\n+\n+The current QROM report correspondence still permits exactly provenance\n+lock fields 0 and 2, for the verifier and zkVM locks. Guest lock field 1 and\n+all other values remain identical. The older zkVM-only description and the\n+382,866-byte store describe their historical checkpoints.\n+\n+## Historical corrective source binding, 2026-11-14 (superseded)\n+\n+The superseded contract selected `fc39da5f35298ce8a4c34aa5bdb25849648612f9`,\n tree `20ef410a1ea847a3585de91d5f0a0380009cf874`, with the same\n ordered 20-path roster and the same 20 historical SHA-256 values.\n Its SHA-256 is `ed9d948a4815aa2fdd858acdcda104341ab96fb504a15e761c86ae04d6547c63`.\n@@ -127,9 +144,9 @@ quantum auxiliary-state hypotheses, a complete shared-oracle reduction,\n recursive composition and complete lifetime event coverage still require their\n own mathematical and operational evidence.\n \n-## Retained consolidated source review, 2026-11-14\n+## Selected consolidated source mapping, 2026-11-14\n \n-The preceding checkpoint 5c04c60e463462d9df8884786e0d5bb32af08a64 retains the exact ordered 20-path roster and all\n+The selected mapped checkpoint 5c04c60e463462d9df8884786e0d5bb32af08a64 retains the exact ordered 20-path roster and all\n 20 historical SHA-256 values from 7150d96a. Four current rows changed from\n 332d7f72: the crypto Cargo manifest, pon_work.rs, pq_accounts_v2.rs and Node\n store.rs. The historical-versus-current difference list now has eight paths,"},{"sha":"dcd6a8bec4b2cac4e84cc087e70751ba10b5e1c1","filename":"evidence/branch-consolidation-followup-20261114/native-collector-history-v1/README.md","status":"added","additions":33,"deletions":0,"changes":33,"blob_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/blob/5df7ae6f482157c5f7fdcbcd52222117a965053f/evidence%2Fbranch-consolidation-followup-20261114%2Fnative-collector-history-v1%2FREADME.md","raw_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/raw/5df7ae6f482157c5f7fdcbcd52222117a965053f/evidence%2Fbranch-consolidation-followup-20261114%2Fnative-collector-history-v1%2FREADME.md","contents_url":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/contents/evidence%2Fbranch-consolidation-followup-20261114%2Fnative-collector-history-v1%2FREADME.md?ref=5df7ae6f482157c5f7fdcbcd52222117a965053f","patch":"@@ -0,0 +1,33 @@\n+# Retained native collector source provenance\n+\n+This directory records one fixed source-content binding used by the current\n+read-only W1 native bridge. It does not execute the historical producer or\n+replace any original native observation.\n+\n+- Source: e4abb172147e941b62483652b0ceabaae4317624.\n+- Tree: 016ebf3deeac88d6d7a782edf563f2291ebe17f5.\n+- Original path: formal/pon-native-fullpath-v1/collect_native.py.\n+- Original collector: 23,639 bytes; SHA256\n+  f40c5d621454d0532141920724a3cfd57e240f4a3b061536162313daa676c254;\n+  Git blob 421b10241820580efcdabc692ccb1f6dd27b6586.\n+\n+[provenance.json](provenance.json) records the raw commit and three raw tree\n+objects, their byte counts, SHA256 digests and Git content addresses. Independent\n+offline review verified SHA1 of type, one space, decimal byte count, a NUL byte\n+and the raw object body for every object. Parsing the three tree entries links\n+the commit's tree through formal/pon-native-fullpath-v1/collect_native.py to\n+the fixed blob. No signature or author-authenticity claim follows from these\n+content addresses.\n+\n+The exact producer bytes are kept as\n+[non-executable data](../../../formal/pon-nakamoto-v1/fixtures/native-collector-e4abb172.py.raw).\n+The current bridge verifies the fixed source/tree/context-digest tuple and uses\n+its existing bounded regular-file reader to check the data's size, SHA256 and\n+Git blob identity. It neither imports this file nor invokes historical Git or\n+native processes. Other sources keep the existing current-collector semantics.\n+The current collector retains its later exact-source checks.\n+\n+The original ZIP, context, saved reports and their native source identities are\n+unchanged. The original native binary has not been rebuilt, reauthenticated or\n+rerun by this correction. Service acceptance, quantum security and production\n+activation remain unqualified."},{"sha":"cef4eb0a5aae12eb68cadaf54722b2847f3bef3d","filename":"evidence/branch-consolidation-followup-20261114/native-collector-history-v1/historical-commit.raw","status":"added","additions":8,"deletions":0,"changes":8,"blob_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/blob/5df7ae6f482157c5f7fdcbcd52222117a965053f/evidence%2Fbranch-consolidation-followup-20261114%2Fnative-collector-history-v1%2Fhistorical-commit.raw","raw_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/raw/5df7ae6f482157c5f7fdcbcd52222117a965053f/evidence%2Fbranch-consolidation-followup-20261114%2Fnative-collector-history-v1%2Fhistorical-commit.raw","contents_url":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/contents/evidence%2Fbranch-consolidation-followup-20261114%2Fnative-collector-history-v1%2Fhistorical-commit.raw?ref=5df7ae6f48