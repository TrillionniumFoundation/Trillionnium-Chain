  gradient:u64 = call(vi,vx,vmode) {"function":"train_input_gradient"}
  wabs:u64,ws:bool = call(w) {"function":"opt_abs"}
  mabs:u64,ms:bool = call(m) {"function":"opt_abs"}
  gabs:u64,gs:bool = call(gradient) {"function":"opt_abs"}
