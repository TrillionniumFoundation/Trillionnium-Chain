paths=['AGENTS.md','trillionnium/Cargo.toml','trillionnium/Cargo.lock','trillionnium/crates/trnm-pon-node/Cargo.toml','trillionnium/crates/trnm-pon-node/src/lib.rs','trillionnium/crates/trnm-pon-node/src/store.rs','trillionnium/crates/trnm-pon-node/src/cell_native_v1.rs','trillionnium/crates/trnm-pon-node/src/native_owner_journal.rs','trillionnium/crates/trnm-pon-node/src/native_risk_ledger.rs','trillionnium/crates/trnm-pon-node/tests/native_owner_journal.rs','trillionnium/crates/trnm-pon-node/tests/native_risk_ledger.rs','trillionnium/crates/trnm-pon-node/tests/native_owner_observation.rs','trillionnium/crates/trnm-pon-node/tests/cell_native_v1.rs','trillionnium/crates/trnm-pon-node/examples/native_owner_journal_v1.rs','trillionnium/crates/trnm-pon-node/examples/native_risk_ledger_v1.rs','trillionnium/crates/trnm-pon-node/examples/support/native_journal_scenario.rs','trillionnium/crates/trnm-pon-node/examples/support/native_risk_scenario.rs','trillionnium/crates/trnm-pon-node/examples/support/distributed_source_inventory.rs','formal/pon-nakamoto-v1/native_owner_journal.py','formal/pon-nakamoto-v1/native_risk_ledger.py','formal/pon-nakamoto-v1/test_native_owner_journal.py','formal/pon-nakamoto-v1/test_native_risk_ledger.py','formal/pon-nakamoto-v1/certificate_composition.py','formal/pon-nakamoto-v1/certificate_composition_evidence.py','formal/pon-nakamoto-v1/certificate_composition_tests.py','formal/pon-nakamoto-v1/NATIVE_RISK_LEDGER_V1.md']
sources={}
for name in paths:
 raw=(root/name).read_bytes();dest=out/'sources'/name
 if name.endswith('.md'):dest=dest.with_suffix('.md.source')
 dest.parent.mkdir(parents=True,exist_ok=True);dest.write_bytes(raw)
 sources[name]={'sha256':hashlib.sha256(raw).hexdigest(),'bytes':len(raw),'retained_path':str(dest.relative_to(out))}
