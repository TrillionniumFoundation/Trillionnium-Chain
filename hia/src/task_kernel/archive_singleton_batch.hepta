  l:u64 = call(rr,l_at) {"function":"tr_read"}
  f_eq:bool = compare.eq(h,f)
  l_eq:bool = compare.eq(h,l)
  ids:u64 = const() {"value":32}
  first_ok:bool = call(rr,i_at,f_id,ids) {"function":"archive_equal"}
  last_ok:bool = call(rr,i_at,l_id,ids) {"function":"archive_equal"}
  heights:bool = bool.and(f_eq,l_eq)
  names:bool = bool.and(first_ok,last_ok)
  combined:bool = bool.and(heights,names)
  branch combined accepted() invalid()
block accepted()
  code0:u32 = const() {"value":0}
  ret(code0)
block invalid()
  code13:u32 = const() {"value":13}
  ret(code13)
block internal()
  code103:u32 = const() {"value":103}
  ret(code103)
end
