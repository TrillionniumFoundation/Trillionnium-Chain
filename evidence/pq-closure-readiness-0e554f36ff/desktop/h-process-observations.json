        "text": "{\n  \"audit_recorded\": true,\n  \"job\": {\n    \"args\": [\n      \"-B\",\n      \"-c\",\n      \"from pathlib import Path\\nfrom datetime import datetime, timezone\\nimport hashlib\\nimport io\\nimport json\\nimport tarfile\\n\\nprimary = Path('/data/pq-closure-c2-publish-validation-0e554f36ff-d4d2')\\nsupplemental = Path('/data/pq-closure-c2-inventory-correction-0e554f36ff-d4d2')\\narchive_path = Path('/data/pq-closure-c2-desktop-originals-0e554f36ff-d4d2.tar.xz')\\nassert not archive_path.exists()\\nfirst = json.loads((primary / 'summary.json').read_bytes())\\nsecond = json.loads((supplemental / 'summary.json').read_bytes())\\nassert first['all_commands_passed'] is False\\nassert [x['name'] for x in first['commands'] if not x['passed']] == ['distributed-inventory']\\nassert next(x for x in first['commands'] if x['name'] == 'public-readiness-tests')['complete_71_without_skip'] is True\\nassert second['combined_required_publish_validation_complete'] is True\\nassert second['original_all_commands_passed'] is False and second['original_failure_preserved'] is True\\nassert first['source'] == second['source'] == {'commit':'0e554f36ffdde3053a5eb1756eb5e526b1935032','tree':'753cdbad6714f00d8ccb9ddbb47f0fd71280ee62'}\\nassert (primary / 'source-before.json').read_bytes() == (primary / 'source-after.json').read_bytes()\\nassert (supplemental / 'source-before.json').read_bytes() == (supplemental / 'source-after.json').read_bytes()\\ninputs = []\\nfor prefix, folder in [('primary', primary), ('supplemental', supplemental)]:\\n    for path in sorted(folder.rglob('*')):\\n        if path.is_file():\\n            inputs.append((prefix + '/' + path.relative_to(folder).as_posix(), path))\\ninputs.extend([\\n    ('harness/c2_publish_validate.py', Path('/data/pq-closure-c2-publish-validate-d4d2.py')),\\n    ('harness/c2_inventory_supplement.py', Path('/data/pq-closure-c2-inventory-supplement-d4d2.py')),\\n    ('input/pq-closure-readiness-correction.bundle', Path('/data/pq-closure-readiness-correction-0e554f36ff-d4d2.bundle')),\\n])\\nraw = {}\\nrows = []\\nfor name, path in inputs:\\n    assert not path.is_symlink()\\n    data = path.read_bytes()\\n    raw[name] = data\\n    rows.append({'path':name, 'original_path':str(path), 'bytes':len(data), 'sha256':hashlib.sha256(data).hexdigest()})\\nindex = {'schema':'TRNM-C2-DESKTOP-ORIGINALS1','source':first['source'],\\n         'packaged_at_utc':datetime.now(timezone.utc).isoformat(),\\n         'raw_file_count':len(raw),'raw_bytes':sum(map(len,raw.values())),\\n         'primary_original_all_commands_passed':False,'inventory_correction_is_separate':True,\\n         'files':rows}\\nindex_bytes = (json.dumps(index,sort_keys=True,indent=2)+'\\\\n').encode()\\nwith archive_path.open('xb') as output:\\n    with tarfile.open(fileobj=output,mode='w:xz',preset=6) as archive:\\n        for name, path in inputs:\\n            assert path.read_bytes() == raw[name], str(path)\\n            info = archive.gettarinfo(str(path),arcname=name)\\n            archive.addfile(info,io.BytesIO(raw[name]))\\n        info = tarfile.TarInfo('archive-index.json')\\n        info.size = len(index_bytes)\\n        info.mode = 0o644\\n        archive.addfile(info,io.BytesIO(index_bytes))\\nwith tarfile.open(archive_path,'r:xz') as archive:\\n    assert len(archive.getmembers()) == len(raw)+1\\n    for name,data in raw.items():\\n        assert archive.extractfile(name).read() == data\\n    assert archive.extractfile('archive-index.json').read() == index_bytes\\nfor name,path in inputs:\\n    assert path.read_bytes() == raw[name], str(path)\\ndata = archive_path.read_bytes()\\nprint(json.dumps({'archive':str(archive_path),'bytes':len(data),'sha256':hashlib.sha256(data).hexdigest(),\\n                  'raw_files':len(raw),'raw_bytes':sum(map(len,raw.values())),\\n                  'index_sha256':hashlib.sha256(index_bytes).hexdigest(),\\n                  'source':first['source'],'primary_all_passed':False,'supplemental_closed':True},sort_keys=True))\\n\"\n    ],\n    \"created_unix_ms\": 1794374401273,\n    \"cwd\": \"/data\",\n    \"env_keys\": [],\n    \"executable\": \"/usr/bin/python3\",\n    \"execution_mode\": \"operator\",\n    \"host\": \"desktop\",\n    \"id\": \"1a1c90c7cf9-135c4-3a8\",\n    \"idempotency_key\": \"pq-closure-c2-desktop-evidence-pack-0e554f36ff-d4d2\",\n    \"launch_error\": null,\n    \"launch_state\": \"launched\",\n    \"remote_job_dir\": \"/home/qian-qi/.local/state/hepta-runtime-mac-worker/jobs/1a1c90c7cf9-135c4-3a8\",\n    \"request_digest\": \"ee89a61ea917d3912012e0b8f2513be562b6ce29c831c4aea36bde357d54d03a\",\n    \"request_fingerprint\": 17188452103452349329,\n    \"ssh_target\": \"desktop-ts\",\n    \"system_jobctl\": false,\n    \"unit\": \"hepta-runtime-job-1a1c90c7cf9-135c4-3a8\"\n  },\n  \"launch\": {\n    \"backend\": \"systemd\",\n    \"launcher_pid\": null,\n    \"ok\": true,\n    \"unit\": \"hepta-runtime-job-1a1c90c7cf9-135c4-3a8\"\n  },\n  \"local_record_pending\": false,\n  \"reused\": false\n}",
