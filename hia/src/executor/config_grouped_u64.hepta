  below_hair:bool = compare.le(triple,hair_space)
  in_spaces:bool = bool.and(above_quad,below_hair)
  sep_pair:bool = bool.or(is_line_sep,is_para_sep)
  no_break_pair:bool = bool.or(is_narrow_nbsp,is_medium_space)
  outer_pair:bool = bool.or(is_ogham,is_ideographic)
  non_quad_a:bool = bool.or(sep_pair,no_break_pair)
  non_quad_b:bool = bool.or(non_quad_a,outer_pair)
  triple_ws:bool = bool.or(non_quad_b,in_spaces)
  branch triple_ws three() none()
