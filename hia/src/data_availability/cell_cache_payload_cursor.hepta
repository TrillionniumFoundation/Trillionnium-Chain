  branch reading read_plan(i3,o3,size,pos,word,rows3,count3) seek(o3,size,pos,word,op3)
block seek(so:mutbuf,ssize:u64,spos:u64,sarg:u64,sop:u8)
  start_op:u8 = const() {"value":0}
