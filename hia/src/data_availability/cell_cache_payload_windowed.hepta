block stage(jr:readbuf,jw:mutbuf,jh:u64,jn:u64,ji:u64)
  received_at_j:u64 = const() {"value":1256}
  off_at_j:u64 = const() {"value":1232}
  count_at_j:u64 = const() {"value":1240}
  end_j:u64 = int.add.wrap(ji,jn)
  lower_j:u64 = call(jw,off_at_j) {"function":"tr_get"}
  asked_j:u64 = call(jw,count_at_j) {"function":"tr_get"}
  upper_j:u64 = int.add.wrap(lower_j,asked_j)
  later_j:bool = compare.gt(ji,lower_j)
  earlier_j:bool = compare.lt(end_j,upper_j)
  first_j:u64 = select(later_j,ji,lower_j)
  last_j:u64 = select(earlier_j,end_j,upper_j)
  has_j:bool = compare.lt(first_j,last_j)
  rc_j:u64 = call(jw,received_at_j,end_j) {"function":"tr_put"}
  branch has_j copy_j(jr,jw,jh,ji,lower_j,first_j,last_j) success()
block copy_j(kr:readbuf,kw:mutbuf,kh:u64,ki:u64,kl:u64,kf:u64,kt:u64)
  base_k:u64 = const() {"value":4096}
