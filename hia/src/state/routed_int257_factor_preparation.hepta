  b_at2:u64 = int.add.wrap(at2,cb2)
  c_at2:u64 = int.add.wrap(at2,cc2)
  a2:u64 = call(r2,a_at2) {"function":"daav_u32"}
  b2:u64 = call(r2,b_at2) {"function":"daav_u32"}
  c2:u64 = call(r2,c_at2) {"function":"daav_u32"}
  pa2:bool = compare.eq(a2,rank2)
  pb2:bool = compare.eq(b2,rank2)
  pc2:bool = compare.eq(c2,rank2)
  pab2:bool = bool.and(pa2,pb2)
  valid2:bool = bool.and(pab2,pc2)
  branch valid2 coeffs(r2,at2,delta2,rank2) bad_shape()
block coeffs(r3:readbuf,at3:u64,delta3:u64,rank3:u64)
  hop3:u64 = const() {"value":16}
  downoff3:u64 = const() {"value":112}
  up3:u64 = int.add.wrap(at3,hop3)
