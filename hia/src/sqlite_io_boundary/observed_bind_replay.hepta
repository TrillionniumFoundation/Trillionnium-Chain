  new_pair:bool = bool.not(same_pair)
  replaced:bool = bool.and(old_covered,new_pair)
  branch replaced replacement_error() prior(rr,rv,rl)
block prior(tr:readbuf,tv:bool,tl:u64)
  prior_high_at:u64 = const() {"value":40}
  prior_high:u64 = call(tr,prior_high_at) {"function":"tr_read"}
