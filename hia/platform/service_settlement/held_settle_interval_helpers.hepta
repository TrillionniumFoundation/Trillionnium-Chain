  sized:bool = bool.and(min_ok,max_ok)
  zero:u64 = const() {"value":0}
  branch sized start_plan(m,verify,count,zero) bad()
block start_plan(stm:mutbuf,stv:bool,stn:u64,stz:u64)
  branch stv read_marker(stm,stv,stn,stz,stz) clear_plan(stm,stv,stn,stz)
block clear_plan(cpm:mutbuf,cpv:bool,cpn:u64,cpz:u64)
  mask_loc:u64 = const() {"value":459984}
  clear_mask:u64 = call(cpm,mask_loc,cpz) {"function":"cp_put"}
  jump read_marker(cpm,cpv,cpn,cpz,cpz)
block read_marker(rm:mutbuf,rv:bool,rn:u64,ri:u64,previous:u64)
  base:u64 = call(ri) {"function":"hfs_marker_offset"}
  source_off:u64 = const() {"value":88}
  target_off:u64 = const() {"value":96}
  source_at:u64 = int.add.wrap(base,source_off)
  target_at:u64 = int.add.wrap(base,target_off)
  src:u64 = call(rm,source_at) {"function":"cp_get"}
  dst:u64 = call(rm,target_at) {"function":"cp_get"}
  cap:u64 = const() {"value":4}
  no_gap:bool = compare.eq(src,previous)
  zero_r:u64 = const() {"value":0}
  first:bool = compare.eq(ri,zero_r)
  maximum:u64 = select(first,zero_r,cap)
  above:bool = compare.ge(dst,src)
  small:bool = compare.le(dst,cap)
  adj:bool = compare.le(dst,maximum)
  possible:bool = bool.and(above,small)
  contiguous:bool = bool.and(no_gap,adj)
  valid:bool = bool.and(possible,contiguous)
  branch valid phase(rm,rv,rn,ri,base,src,dst) bad()
block phase(pm:mutbuf,pv:bool,pn:u64,pi:u64,pb:u64,ps:u64,pt:u64)
  branch pv roots(pm,pn,pi,pb,ps,pt,pv) endpoint(pm,pn,pi,pt,pv)
