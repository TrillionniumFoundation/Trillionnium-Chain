45ca070ace5981fc481061fc2c1d979046eec4b6 blob 38322
#!/usr/bin/env python3
"""Run the separate SP27-02 balanced strata campaign in the unchanged public Host.

The controller distinguishes successful collection from business qualification.
Each native phase keeps the original four-second deadline.  A failed healthy
control stops the native experiment before any pressure data are collected.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import os
from pathlib import Path
import shutil
import sys

import public_fixture_host_lease as lease
import run_from_zero_native as native
import run_history_native as history
from check_required_native_test import validate as named_test
from public_host_ci_observation import write_new
from replay_pinned_native import require

ROOT = Path(__file__).resolve().parents[2]
SCRIPT = 'scripts/ci/run_sp27_strata_controls.py'
SELECTOR = 'sp27_receiver_campaign::balanced_native_stage_controls_stop_on_unhealthy_sentinel'
MODULE = 'trillionnium/crates/trnm-pon-node/tests/public_v3_from_zero/sp27_receiver_controls.rs'
SCHEMA = 'sp27-native-strata-execution-v1'
PREPARATION = 'sp27-native-strata-preparation-v1'
STRATA_MODULE = 'trillionnium/crates/trnm-pon-node/tests/public_v3_from_zero/sp27_receiver_strata.rs'
CAMPAIGN_MODULE = 'trillionnium/crates/trnm-pon-node/tests/public_v3_from_zero/sp27_receiver_campaign.rs'
NATIVE_TIMEOUT_SECONDS = 90


def digest(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def source_identity() -> dict:
    actual = lease.workflow_source()
    return {'commit': actual['tested_commit'], 'tree': actual['tested_tree'],
            'tracked_source_identity': actual,
            'files_sha256': {p: digest(ROOT / p) for p in (
                native.SOURCE, MODULE, STRATA_MODULE, CAMPAIGN_MODULE, SCRIPT, 'config/systemd/trnmponpublic.slice',
                'trillionnium/crates/trnm-pon-node/src/host_kernel_parent.rs')}}


def output_path(out: Path) -> Path:
    receipts = Path(os.environ.get('TRNM_CI_RECEIPT_DIR', ''))
    require(receipts.is_absolute() and receipts.resolve(strict=True) == receipts
            and out == receipts / 'sp27-receiver-strata'
            and out.is_absolute() and out.resolve() == out
            and not out.is_relative_to(ROOT), 'SP27_EXACT_OUTPUT_REQUIRED')
    return out


def prepare(out: Path) -> dict:
    output_path(out).mkdir(exist_ok=False)
    result = {'schema': PREPARATION, 'job': history.job_identity(),
              'source_before': None, 'source_after': None, 'binary': None,
              'build': None, 'failures': [], 'completed': False,
              'native_tests_executed': False}
    try:
        result['source_before'] = source_identity()
        result['build'] = native.run_child(native.native_build_command(), out / 'build', 900)
        require(result['build']['exit_code'] == 0 and not result['build']['timed_out'],
                'SP27_SOURCE_BUILD_FAILED')
        binary = native.select_binary((out / 'build/stdout').read_text().splitlines())
        result['binary'], _ = history.file_observation(binary, history.BINARY_LIMIT)
    except (OSError, ValueError, KeyError, TypeError) as error:
        result['failures'].append(type(error).__name__ + ':' + str(error))
    finally:
        try:
            result['source_after'] = source_identity()
            require(result['source_before'] == result['source_after'], 'SP27_SOURCE_CHANGED')
        except (OSError, ValueError, KeyError, TypeError) as error:
            result['failures'].append(type(error).__name__ + ':' + str(error))
        result['completed'] = not result['failures'] and result['binary'] is not None
        write_new(out / 'preparation.json', result)
    return result


def validate_preparation(out: Path) -> dict:
    output_path(out)
    value, _ = history.load_object(out / 'preparation.json')
    require(value.get('schema') == PREPARATION and value.get('completed') is True
            and value.get('failures') == [] and value.get('native_tests_executed') is False
            and value.get('job') == history.job_identity(), 'SP27_PREPARATION_REQUIRED')
    require(value['source_before'] == value['source_after'] == source_identity(),
            'SP27_PREPARATION_SOURCE_CHANGED')
    build = value['build']
    require(build['command'] == native.native_build_command()
            and build['exit_code'] == 0 and build['timed_out'] is False
            and build['stdout_sha256'] == digest(out / 'build/stdout')
            and build['stderr_sha256'] == digest(out / 'build/stderr'), 'SP27_BUILD_CHANGED')
    binary = native.select_binary((out / 'build/stdout').read_text().splitlines())
    require(history.file_observation(binary, history.BINARY_LIMIT)[0] == value['binary'],
            'SP27_BINARY_CHANGED')
    return value


def exact_integer(value, expected: int) -> bool:
    # JSON booleans and floats compare equal to Python integers, but do not
    # satisfy the native collector's serde_json::Value::as_u64() checks.
    return type(value) is int and value == expected


def declared_run_id(job: dict) -> str:
    return '-'.join(job[key] for key in ('GITHUB_RUN_ID', 'GITHUB_RUN_ATTEMPT', 'GITHUB_JOB'))



ARMS = ('transport', 'early-reject', 'late-reject', 'valid-expensive')
ORDER = (0, 1, 2, 3, 3, 2, 1, 0)
WINDOW_NS = 4_000_000_000
RECORD_LIMIT = 32 * 1024 * 1024


def same_json(left, right) -> bool:
    return json.dumps(left, sort_keys=True, separators=(',', ':')) == json.dumps(
        right, sort_keys=True, separators=(',', ':'))


def expect(value: dict, fields: dict, code: str) -> None:
    require(type(value) is dict and all(key in value and same_json(value[key], item)
                                      for key, item in fields.items()), code)


def unsigned(value) -> bool:
    return type(value) is int and 0 <= value < 2 ** 64


def encoded(value, length=None) -> bool:
    return (type(value) is str and bool(value) and len(value) % 2 == 0
            and (length is None or len(value) == length)
            and all(char in '0123456789abcdef' for char in value))


def planned_phases() -> list[dict]:
    descriptions = [(f'health-{i:03}', 'initial-health', None, i, None) for i in range(3)]
    for index, arm in enumerate(ORDER):
        descriptions.append((f'control-{index:03}-{ARMS[arm]}', 'pressure-control', ARMS[arm], None, index))
        if index in (3, 7):
            health = 3 if index == 3 else 4
            descriptions.append((f'health-{health:03}', 'midpoint-sentinel' if index == 3
                                 else 'terminal-sentinel', None, health, None))
    return [{'planned_index': index, 'phase_id': identity, 'kind': kind, 'arm': arm,
             'health_index': health, 'control_index': control, 'requested_window_ns': WINDOW_NS,
             'workers_max': 16 if arm else 0, 'per_worker_attempt_cap': 1 if arm else 0,
             'control_scheduled_arrival_ns': 100_000_000 if arm else None}
            for index, (identity, kind, arm, health, control) in enumerate(descriptions)]


def native_business(phase: dict) -> bool:
    gate, count, end = (phase.get(key) for key in (
        'client_confirmed_before_original_window_end', 'client_confirmed_transactions',
        'confirmation_ended_ns'))
    require(type(gate) is bool and exact_integer(count, int(gate))
            and (end is None or unsigned(end)), 'SP27_STRATA_BUSINESS_TYPES')
    require(not gate or (unsigned(end) and end < WINDOW_NS),
            'SP27_STRATA_NATIVE_FINAL_GATE_CONTRADICTION')
    return gate


def healthy(phase: dict) -> bool:
    return (exact_integer(phase.get('requested_window_ns'), WINDOW_NS)
            and exact_integer(phase.get('workers'), 0)
            and all(phase.get(key) is True for key in (
                'invariant_target_met', 'finite_business_target_met',
                'client_confirmed_before_original_window_end', 'full_native_state_equal'))
            and exact_integer(phase.get('client_confirmed_transactions'), 1)
            and unsigned(phase.get('confirmation_ended_ns'))
            and phase['confirmation_ended_ns'] < WINDOW_NS
            and phase.get('verification_errors') == [])


def observed_stage(record: dict, arm: str) -> tuple[bool, bool, bool]:
    phases = record.get('submit_phases')
    require(type(phases) is list and all(type(row) is dict for row in phases)
            and len({row.get('phase') for row in phases}) == len(phases),
            'SP27_STRATA_OBSERVED_PHASES')
    by_name = {row.get('phase'): row for row in phases}

    def accepted(name):
        row = by_name.get(name, {})
        return all(row.get(key) is True for key in ('started', 'completed', 'accepted'))

    def refused(name):
        row = by_name.get(name, {})
        return row.get('started') is True and row.get('completed') is True and row.get('accepted') is False

    def unstarted(name):
        return by_name.get(name, {}).get('started') is False

    def message(expected):
        diagnostics = record.get('error_diagnostics')
        dispatch = diagnostics.get('dispatch') if type(diagnostics) is dict else None
        return (type(dispatch) is dict and dispatch.get('message_prefix') == expected
                and dispatch.get('message_truncated') is False)

    rejection = record.get('work_rejection')
    rejection = rejection if type(rejection) is dict else {}
    cache = rejection.get('cache')
    cache = cache if type(cache) is dict else {}
    full = (rejection.get('completed') is True
            and all(cache.get(key) is True for key in (
                'native_verifier_started', 'native_verifier_returned', 'full_replay_started'))
            and cache.get('cached_rejection_returned') is False)
    checked = accepted('body_decode')
    reached = checked and {
        'transport': (refused('decode') and by_name.get('decode', {}).get('error_code') == 'HEADER_CODEC'
                      and unstarted('context') and unstarted('work')),
        'early-reject': (accepted('decode') and refused('context') and unstarted('work')
                         and record.get('full_work_started') is False and message('WORK:Task')),
        'late-reject': (accepted('context') and refused('work') and full and message('WORK:Transcript')),
        'valid-expensive': (accepted('work') and full and record.get('full_work_accepted') is True
                            and record.get('dispatch_accepted') is True and accepted('submit_result')),
    }[arm]
    return checked, full, reached


def pressure_integrity(phase: dict, arm: str, requests: list[str]) -> bool:
    expect(phase, {'schema': 'sp27-native-stage-control-phase-v1', 'mode': arm,
                  'requested_window_ns': WINDOW_NS, 'workers': 16}, 'SP27_STRATA_PRESSURE_SCOPE')
    expect(phase.get('arrival_plan'), {
        'workers': 16, 'attempts_per_worker': 1, 'scheduled_start_ns': 100_000_000,
        'retries': 0, 'business_waits_for_pressure_completion': False},
        'SP27_STRATA_ARRIVAL_PLAN')
    workers = phase.get('attacks')
    require(type(workers) is list and len(workers) == 16, 'SP27_STRATA_WORKER_ROSTER')
    calls = []
    for index, worker in enumerate(workers):
        expect(worker, {'worker': index, 'planned_attempts': 1}, 'SP27_STRATA_WORKER_IDENTITY')
        require(type(worker.get('calls')) is list and len(worker['calls']) == 1,
                'SP27_STRATA_SINGLE_ATTEMPT')
        call = worker['calls'][0]
        expect(call, {'packet_index': index, 'attempt_index': 0, 'scheduled_start_ns': 100_000_000},
               'SP27_STRATA_OFFERING_IDENTITY')
        ready = call.get('offering_thread_ready_ns')
        require(unsigned(ready) and exact_integer(call.get('offering_lateness_ns'),
                                                 max(0, ready - 100_000_000)),
                'SP27_STRATA_OFFERING_CLOCK')
        calls.append(call)
    no_acceptance = all(call.get('status') != 'ok' for call in calls)
    require(phase.get('no_attack_accepted') is no_acceptance, 'SP27_STRATA_ACCEPTANCE_MISMATCH')
    captured = phase.get('observations')
    require(type(captured) is dict and type(captured.get('records')) is list
            and all(type(row) is dict for row in captured['records']),
            'SP27_STRATA_OBSERVATIONS_REQUIRED')
    coverage = (exact_integer(captured.get('records_not_retained'), 0)
                and exact_integer(captured.get('measurement_failures'), 0)
                and captured.get('counter_overflow') is False
                and exact_integer(captured.get('accepted_connections_seen'), len(captured['records']))
                and all(type(row) is dict and row.get('complete') is True
                        and row.get('observation_failed') is False for row in captured['records']))
    service = phase.get('service')
    require(type(service) is dict, 'SP27_STRATA_SERVICE_REQUIRED')
    metrics = service.get('metrics')
    metrics = metrics if type(metrics) is dict else {}
    costs = [metrics.get(key) for key in ('mutation_cpu_charged_ns',
             'mutation_full_work_cpu_ns', 'mutation_dispatch_excluding_work_cpu_ns')]
    accounting = (all(unsigned(value) for value in costs) and costs[1] + costs[2] == costs[0]
                  and unsigned(metrics.get('work_started'))
                  and exact_integer(metrics.get('work_finished'), metrics.get('work_started'))
                  and exact_integer(metrics.get('mutation_cpu_clock_failures'), 0))
    require(phase.get('accounting_closed') is accounting, 'SP27_STRATA_ACCOUNTING_MISMATCH')
    invariant = ((arm == 'valid-expensive' or no_acceptance) and coverage and accounting
                 and service.get('error') is None
                 and phase.get('receiver_matches_valid_honest_prefix') is True)
    require(phase.get('invariant_target_met') is invariant, 'SP27_STRATA_INVARIANT_MISMATCH')
    stage = phase.get('stage_readback')
    expect(stage, {'schema': 'sp27-native-stage-readback-v1', 'arm': arm,
                   'planned_offerings': 16}, 'SP27_STRATA_STAGE_SCHEMA')
    offered = sum(unsigned(call.get('started_ns')) for call in calls)
    require(exact_integer(stage.get('actual_calls_started'), offered)
            and type(stage.get('matched_records')) is list
            and exact_integer(stage.get('matched_claimed_body_connections'), len(stage['matched_records'])),
            'SP27_STRATA_STAGE_DENOMINATORS')
    body_digests = [native.H('public-request-body-v3', json.dumps(
        {'op': 'submit', 'packet': wire}, separators=(',', ':')).encode()).hex() for wire in requests]
    witnesses, unexpected = [], False
    for record in captured['records']:
        digest_bytes = record.get('body_digest')
        if digest_bytes is None:
            continue
        require(type(digest_bytes) is list and len(digest_bytes) == 32
                and all(type(value) is int and 0 <= value <= 255 for value in digest_bytes),
                'SP27_STRATA_OBSERVER_BODY_DIGEST')
        body_digest = bytes(digest_bytes).hex()
        if body_digest not in body_digests:
            continue
        checked, full, reached = observed_stage(record, arm)
        unexpected |= arm != 'valid-expensive' and record.get('dispatch_accepted') is True
        unexpected |= arm in ('transport', 'early-reject') and record.get('full_work_started') is True
        witnesses.append({'packet_index': body_digests.index(body_digest),
            'connection_id': record.get('connection_id'), 'body_digest': body_digest,
            'actual_body_checked': checked, 'target_stage_attained': reached,
            'full_native_replay_observed': full,
            **{key: record.get(key) for key in ('dispatch_accepted', 'lifecycle',
                'paid_task_queue_wait', 'work_rejection', 'submit_phases',
                'terminal_phase', 'terminal_error_code')}})
    require(same_json(stage['matched_records'], witnesses), 'SP27_STRATA_STAGE_WITNESS_CHANGED')
    attained = sum(row['target_stage_attained'] for row in witnesses)
    require(exact_integer(stage.get('target_stage_attained'), attained),
            'SP27_STRATA_STAGE_COUNT_MISMATCH')
    identifiable = offered == 16 and attained > 0
    require(stage.get('input_stage_identifiable') is identifiable
            and stage.get('unexpected_stage_or_acceptance') is unexpected,
            'SP27_STRATA_STAGE_QUALIFICATION_MISMATCH')
    integrity = invariant and identifiable and not stage['unexpected_stage_or_acceptance']
    require(phase.get('control_integrity_met') is integrity, 'SP27_STRATA_INTEGRITY_MISMATCH')
    return integrity


def read_campaign(out: Path, prepared: dict) -> tuple[dict, dict, dict]:
    readback = {}

    def read_record(name: str) -> dict:
        observed, raw = history.file_observation(out / 'native' / name, RECORD_LIMIT, retain=True)
        value = native.json_load(raw)
        require(type(value) is dict, 'SP27_STRATA_JSON_OBJECT')
        readback[name] = observed
        return value

    def host_record(name: str, claimed) -> bool:
        host = read_record(name)
        expect(host, {'schema': 'sp27-receiver-host-readback-v1',
                      'fixed_parent': '/sys/fs/cgroup/trnmponpublic.slice'}, 'SP27_STRATA_HOST_SCOPE')
        require(type(claimed) is bool and host.get('verified') is claimed,
                'SP27_STRATA_HOST_MISMATCH')
        require((claimed and type(host.get('sample')) is dict and host.get('error') is None)
                or (not claimed and host.get('sample') is None
                    and type(host.get('error')) is str and bool(host['error'])),
                'SP27_STRATA_HOST_OBSERVATION')
        return claimed

    report = read_record('report.json')
    report_file = readback.pop('report.json')
    expect(report, {'schema': 'sp27-receiver-strata-campaign-v1',
                    'planned_phases': 13, 'planned_health_repetitions': 3, 'planned_sentinels': 2,
                    'pressure_controls_planned': 8, 'balanced_arm_indices': list(ORDER),
                    'requested_window_ns': WINDOW_NS, 'mechanism_status': 'UNKNOWN',
                    'causal_mechanism_status': 'UNKNOWN', 'publication_qualified': False,
                    'public_network_ready': False, 'production_activation': False},
           'SP27_STRATA_CAMPAIGN_SCOPE')
    require(report.get('qualification') in ('NO_GO', 'COLLECTED_CONTROL_SERIES'),
            'SP27_STRATA_QUALIFICATION')
    planned = planned_phases()
    plan = read_record('plan.json')
    expect(plan, {'schema': 'sp27-receiver-strata-campaign-plan-v1', 'planned_phases': planned,
                  'initial_health_repetitions': 3, 'control_phase_count': 8, 'sentinel_count': 2,
                  'arm_names': list(ARMS), 'balanced_arm_indices': list(ORDER),
                  'same_seven_signed_packets': True, 'confirmation_depth': 6,
                  'requested_window_ns': WINDOW_NS, 'pressure_workers_max': 16,
                  'pressure_per_worker_attempt_cap': 1, 'control_scheduled_arrival_ns': 100_000_000,
                  'global_per_worker_attempt_ceiling': 1024, 'outer_selector_timeout_seconds': 90,
                  'fixed_parent': '/sys/fs/cgroup/trnmponpublic.slice',
                  'required_cpu_quota_us': 25000, 'required_cpu_period_us': 100000,
                  'required_memory_bytes': 2147483648, 'required_swap_bytes': 0},
           'SP27_STRATA_PLAN_CHANGED')
    source, binary, job = prepared['source_before'], prepared['binary'], prepared['job']
    binding = {'binary_path': binary['path'], 'binary_sha256': binary['sha256'],
               'runner_declared_source_sha': source['commit'], 'runner_declared_run_id': declared_run_id(job),
               'github_run_id': job['GITHUB_RUN_ID'], 'github_run_attempt': job['GITHUB_RUN_ATTEMPT']}
    for field, path in (('compiled_test_source_sha256', native.SOURCE),
                        ('compiled_health_module_sha256', MODULE),
                        ('compiled_strata_module_sha256', STRATA_MODULE),
                        ('compiled_campaign_module_sha256', CAMPAIGN_MODULE)):
        binding[field] = source['files_sha256'][path]
    identities = [read_record(f'identity-{when}.json') for when in ('before', 'after')]
    for identity in identities:
        expect(identity, {'schema': 'sp27-receiver-run-identity-v1',
                          'binary_identity_error': None, **binding}, 'SP27_STRATA_BUILD_RUN_BINDING')
        require(unsigned(identity.get('pid')) and identity['pid'] > 0
                and all(type(identity.get(key)) is str and bool(identity[key])
                        for key in ('hostname', 'boot_id', 'process_cgroup')),
                'SP27_STRATA_PROCESS_IDENTITY')
    require(all(same_json(identities[0][key], identities[1][key])
                for key in ('pid', 'hostname', 'boot_id', 'process_cgroup'))
            and report.get('binary_unchanged') is True, 'SP27_STRATA_IDENTITY_CHANGED')
    before_ok = host_record('host-before.json', report.get('host_before_verified'))
    after_ok = host_record('host-after.json', report.get('host_after_verified'))
    records = report.get('phases')
    require(type(records) is list and len(records) <= 13
            and exact_integer(report.get('attempted_phases'), len(records)), 'SP27_STRATA_ATTEMPTED_COUNT')
    if records or (out / 'native/business-acquisition.json').exists():
        acquisition = read_record('business-acquisition.json')
        expect(acquisition, {'schema': 'sp27-receiver-seven-packet-acquisition-v1',
                            'same_seven_packets_in_all_health_phases': True}, 'SP27_STRATA_BUSINESS_ACQUISITION')
        packets, ids = acquisition.get('signed_honest_packets'), acquisition.get('packet_ids')
        require(type(packets) is list and len(packets) == 7 and all(encoded(p) for p in packets)
                and type(ids) is list and len(ids) == 7 and all(encoded(p, 64) for p in ids),
                'SP27_STRATA_SEVEN_PACKETS')
        read_record('business-acquisition-started.json')
    require(before_ok or not records, 'SP27_STRATA_ATTEMPT_AFTER_GLOBAL_HOST_FAILURE')
    inputs_acquired = report.get('control_inputs_acquired')
    require(type(inputs_acquired) is bool, 'SP27_STRATA_INPUT_ACQUISITION_FLAG')
    streams = []
    if inputs_acquired:
        read_record('strata-acquisition-started.json')
        input_index = read_record('strata-inputs-index.json')
        expect(input_index, {'schema': 'sp27-receiver-control-input-index-v1',
                             'same_request_streams_for_balanced_repeats': True}, 'SP27_STRATA_INPUT_INDEX')
        require(type(input_index.get('inputs')) is list and len(input_index['inputs']) == 4,
                'SP27_STRATA_INPUT_ARMS')
        acquisition = read_record('strata-input-acquisition-native.json')
        expect(acquisition, {'schema': 'sp27-strata-input-acquisition-v1', 'arms': list(ARMS),
                            'workers_per_arm': 16, 'calls_per_worker': 1,
                            'valid_expensive_is_not_a_pure_W1_intervention': True},
               'SP27_STRATA_INPUT_SCOPE')
        require(type(acquisition.get('inputs')) is list and len(acquisition['inputs']) == 4,
                'SP27_STRATA_INPUT_IDENTITIES')
        for index, arm in enumerate(ARMS):
            name = f'inputs/arm-{index:03}.json'
            stream = read_record(name)
            expect(stream, {'schema': 'sp27-receiver-control-request-stream-v1',
                            'arm_index': index, 'arm': arm, 'request_count': 16}, 'SP27_STRATA_INPUT_STREAM')
            requests = stream.get('requests')
            require(type(requests) is list and len(requests) == 16 and all(encoded(v) for v in requests)
                    and len(set(requests)) == 16
                    and exact_integer(stream.get('packet_hex_bytes'), sum(len(v) for v in requests)),
                    'SP27_STRATA_INPUT_REQUESTS')
            streams.append(requests)
            expect(input_index['inputs'][index], {'arm_index': index, 'arm': arm, 'raw_record': name,
                   'sha256': readback[name]['sha256'], 'request_count': 16}, 'SP27_STRATA_INPUT_SHA')
            require(same_json(stream.get('canonical_submit_body_bytes'), [len(json.dumps(
                {'op': 'submit', 'packet': wire}, separators=(',', ':')).encode()) for wire in requests]),
                    'SP27_STRATA_CANONICAL_BODY_LENGTHS')
            values = acquisition['inputs'][index]
            require(type(values) is list and len(values) == 16, 'SP27_STRATA_INPUT_IDENTITIES')
            for wire, value in zip(requests, values):
                body = json.dumps({'op': 'submit', 'packet': wire}, separators=(',', ':')).encode()
                expect(value, {'packet_hex': wire, 'request_bytes': len(body),
                               'body_digest': native.H('public-request-body-v3', body).hex(),
                               'recorded_request_digest': native.H('pressure-recorded-request-v1', body).hex()},
                       'SP27_STRATA_INPUT_DIGEST')
                require(exact_integer(acquisition.get('canonical_submit_body_bytes_each'), len(body)),
                        'SP27_STRATA_EQUAL_BODY_LENGTH')
    health_rows, controls, completed, invoked, stopped = [], [], 0, 0, False
    allowed_raw = set()
    for index, row in enumerate(records):
        require(not stopped, 'SP27_STRATA_CONTINUED_AFTER_STOP')
        expect(row, planned[index], 'SP27_STRATA_PHASE_PLAN')
        expect(row, {'attempted': True}, 'SP27_STRATA_PHASE_ATTEMPT')
        prefix = 'raw/' + planned[index]['phase_id']
        expected_names = [prefix + suffix for suffix in ('-started.json', '-host-before.json',
                                                          '-host-after.json', '-index.json')]
        started = read_record(expected_names[0])
        expect(started, {'schema': 'sp27-receiver-campaign-phase-started-v1',
                         'status': 'STARTED_NOT_YET_OBSERVED_COMPLETE'}, 'SP27_STRATA_START_MARKER')
        expect(started.get('plan'), {**planned[index], 'attempted': True, 'helper_invoked': False,
               'completed': False, 'raw_phase_record': None, 'raw_phase_sha256': None}, 'SP27_STRATA_STARTED_PLAN')
        actual_index = read_record(prefix + '-index.json')
        require(same_json(actual_index, row), 'SP27_STRATA_PHASE_INDEX_CHANGED')
        phase_before = host_record(prefix + '-host-before.json', row.get('host_before_verified'))
        phase_after = host_record(prefix + '-host-after.json', row.get('host_after_verified'))
        require(type(row.get('completed')) is bool and type(row.get('helper_invoked')) is bool
                and row['helper_invoked'] is phase_before, 'SP27_STRATA_PHASE_INVOCATION')
        if row['helper_invoked']:
            invoked += 1
            expected_names.append(prefix + '-invoked.json')
            expect(read_record(prefix + '-invoked.json'), {
                'schema': 'sp27-receiver-campaign-phase-invoked-v1',
                'phase_id': planned[index]['phase_id'], 'planned_index': index,
                'requested_window_ns': WINDOW_NS, 'helper_invoked': True}, 'SP27_STRATA_INVOKED_MARKER')
        passed = False
        if row['completed']:
            require(row['helper_invoked'], 'SP27_STRATA_UNINVOKED_COMPLETION')
            completed += 1
            name = prefix + '.json'
            expected_names.append(name)
            phase = read_record(name)
            expect(row, {'raw_phase_record': name, 'raw_phase_sha256': readback[name]['sha256'],
                         'business_result_is_not_campaign_integrity': planned[index]['arm'] is not None},
                   'SP27_STRATA_RAW_CHANGED')
            native_business(phase)
            expect(row, {'native_final_gate': phase['client_confirmed_before_original_window_end'],
                         **{key: phase.get(key) for key in ('confirmation_ended_ns',
                            'client_confirmed_transactions', 'control_integrity_met',
                            'invariant_target_met', 'finite_business_target_met')}},
                   'SP27_STRATA_PHASE_SUMMARY')
            if planned[index]['arm'] is None:
                passed = healthy(phase)
                require(row.get('healthy') is passed, 'SP27_STRATA_HEALTH_MISMATCH')
            else:
                require(inputs_acquired, 'SP27_STRATA_PRESSURE_BEFORE_INPUTS')
                passed = pressure_integrity(phase, planned[index]['arm'],
                                            streams[ARMS.index(planned[index]['arm'])])
        else:
            expect(row, {'raw_phase_record': None, 'raw_phase_sha256': None}, 'SP27_STRATA_INCOMPLETE_RAW')
            if row['helper_invoked']:
                name = prefix + '-panic.json'
                expected_names.append(name)
                require(row.get('panic_record') == name, 'SP27_STRATA_PANIC_REQUIRED')
                expect(read_record(name), {'schema': 'sp27-receiver-campaign-native-panic-v1',
                    'phase_id': planned[index]['phase_id'], 'planned_index': index,
                    'raw_phase_complete': False, 'native_confirmation_result': None}, 'SP27_STRATA_PANIC')
        stopped = not (passed and phase_before and phase_after)
        require(row.get('stopped_campaign') is stopped, 'SP27_STRATA_STOP_MISMATCH')
        (health_rows if planned[index]['arm'] is None else controls).append(row)
        allowed_raw.update(Path(name).name for name in expected_names)
    require({path.name for path in (out / 'native/raw').iterdir()} == allowed_raw,
            'SP27_STRATA_UNINDEXED_OR_MISSING_RAW')
    initial_passed = (len(records) >= 3 and all(row.get('healthy') is True
                      and row.get('stopped_campaign') is False for row in records[:3]))
    require(report.get('health_gate_passed') is initial_passed
            and (not inputs_acquired or initial_passed)
            and (not controls or initial_passed)
            and (initial_passed or not (out / 'native/strata-acquisition-started.json').exists()),
            'SP27_STRATA_PRESSURE_BEFORE_HEALTH')
    expect(report, {'helper_invoked_phases': invoked, 'completed_phases': completed,
                    'incomplete_phases': len(records) - completed, 'unstarted_phases': 13 - len(records),
                    'health_phases': health_rows, 'control_phases': controls,
                    'healthy_completed_phases': sum(row.get('healthy') is True for row in health_rows),
                    'pressure_controls_attempted': len(controls),
                    'pressure_controls_executed': sum(row.get('completed') is True for row in controls),
                    'pressure_controls_unstarted': 8 - len(controls)}, 'SP27_STRATA_DENOMINATORS')
    collected = report['qualification'] == 'COLLECTED_CONTROL_SERIES'
    if collected:
        require(len(records) == completed == 13 and not stopped and inputs_acquired
                and before_ok and after_ok and report.get('first_divergence') is None,
                'SP27_STRATA_SERIES_NOT_ESTABLISHED')
    else:
        divergence = read_record('first-divergence.json')
        require(type(report.get('first_divergence')) is dict
                and same_json(divergence, report['first_divergence']), 'SP27_STRATA_DIVERGENCE_CHANGED')
        expect(divergence, {'schema': 'sp27-receiver-campaign-first-divergence-v1',
                           'qualification': 'NO_GO', 'causal_status': 'UNKNOWN'}, 'SP27_STRATA_DIVERGENCE_SCOPE')
        if stopped:
            expect(divergence, {'planned_index': len(records) - 1,
                               'phase_id': records[-1]['phase_id']}, 'SP27_STRATA_DIVERGENCE_PHASE')
        else:
            stage = divergence.get('stage')
            require((not records and stage in ('pre-execution-identity-or-host', 'business-acquisition-panic'))
                    or (len(records) == 3 and not inputs_acquired and stage in (
                        'strata-input-acquisition-panic', 'invalid-control-input-roster'))
                    or (len(records) == 13 and stage == 'post-execution-identity-or-host' and not after_ok),
                    'SP27_STRATA_UNEXPLAINED_STOP')
    # Preserve actual partial acquisition observations too. They are not
    # successes, reconstructed costs, or a second cryptographic verification.
    for name in ('business-acquisition-started.json', 'business-acquisition-panic.json',
                 'strata-acquisition-started.json', 'strata-acquisition-panic.json'):
        if name not in readback and (out / 'native' / name).exists():
            read_record(name)
    acquisition_dir = out / 'native/strata-acquisition'
    if acquisition_dir.exists():
        for path in sorted(acquisition_dir.glob('*.json')):
            read_record('strata-acquisition/' + path.name)
    return report, report_file, readback


def execution(out: Path) -> dict:
    prepared = validate_preparation(out)
    write_new(out / 'execution-start.json', {'schema': SCHEMA, 'job': history.job_identity()})
    result = {'schema': SCHEMA, 'job': history.job_identity(), 'source_before': source_identity(),
              'source_after': None, 'binary_before': prepared['binary'], 'binary_after': None,
              'process': None, 'named_execution': None, 'report_file': None, 'native_readback_files': None,
              'qualification': 'UNKNOWN', 'failures': [], 'collection_completed': False,
              'causal_mechanism_established': False, 'runtime_limits_or_deadlines_changed': False}
    binary = Path(prepared['binary']['path'])
    try:
        # Retain the actual executable independently of the build cache.
        saved = out / native.TARGET
        with binary.open('rb') as source, saved.open('xb') as destination:
            shutil.copyfileobj(source, destination)
        os.chmod(saved, 0o755)
        require(digest(saved) == prepared['binary']['sha256'], 'SP27_RETAINED_BINARY_CHANGED')
        os.environ['TRNM_SP27_RECEIVER_STRATA_DIR'] = str(out / 'native')
        os.environ['TRNM_SP27_SOURCE_SHA'] = result['source_before']['commit']
        os.environ['TRNM_SP27_RUN_ID'] = declared_run_id(prepared['job'])
        command = [str(binary), SELECTOR, '--exact', '--ignored', '--show-output', '--test-threads=1']
        result['process'] = native.run_child(command, out / 'run', NATIVE_TIMEOUT_SECONDS)
        require(result['process']['exit_code'] == 0 and not result['process']['timed_out'],
                'SP27_NATIVE_EXECUTION_FAILED')
        result['named_execution'] = named_test((out / 'run/stdout').read_text().splitlines(), SELECTOR)
        report, result['report_file'], result['native_readback_files'] = read_campaign(out, prepared)
        result['qualification'] = report['qualification']
    except (OSError, ValueError, KeyError, TypeError) as error:
        result['failures'].append(type(error).__name__ + ':' + str(error))
    finally:
        for field, action in (
            ('source_after', source_identity),
            ('binary_after', lambda: history.file_observation(binary, history.BINARY_LIMIT)[0]),
        ):
            try:
                result[field] = action()
            except (OSError, ValueError, KeyError, TypeError) as error:
                result['failures'].append(type(error).__name__ + ':' + str(error))
        if result['source_before'] != result['source_after']:
            result['failures'].append('SP27_SOURCE_CHANGED')
        if result['binary_before'] != result['binary_after']:
            result['failures'].append('SP27_BINARY_CHANGED')
        result['collection_completed'] = not result['failures']
        write_new(out / 'manifest.json', result)
    return result


def bind_execution(prepared: dict, out: Path) -> dict:
    require(validate_preparation(out) == prepared, 'SP27_PREPARATION_CHANGED')
    result, manifest = history.load_object(out / 'manifest.json')
    require(result.get('schema') == SCHEMA and result.get('collection_completed') is True
            and result.get('failures') == [] and result.get('job') == history.job_identity()
            and result.get('causal_mechanism_established') is False
            and result.get('runtime_limits_or_deadlines_changed') is False,
            'SP27_COLLECTION_INCOMPLETE')
    require(result['source_before'] == result['source_after'] == prepared['source_before']
            and result['binary_before'] == result['binary_after'] == prepared['binary'],
            'SP27_SOURCE_BINARY_BINDING')
    report, observed, readback = read_campaign(out, prepared)
    require(observed == result['report_file'] and report['qualification'] == result['qualification'],
            'SP27_REPORT_CHANGED')
    require(readback == result.get('native_readback_files'), 'SP27_NATIVE_READBACK_CHANGED')
    process = result.get('process')
    command = [prepared['binary']['path'], SELECTOR, '--exact', '--ignored',
               '--show-output', '--test-threads=1']
    require(type(process) is dict and process.get('command') == command
            and type(process.get('exit_code')) is int and process['exit_code'] == 0
            and process.get('timed_out') is False, 'SP27_NATIVE_PROCESS_REQUIRED')
    require(result['process']['stdout_sha256'] == digest(out / 'run/stdout')
            and result['process']['stderr_sha256'] == digest(out / 'run/stderr')
            and named_test((out / 'run/stdout').read_text().splitlines(), SELECTOR)
            == result['named_execution'], 'SP27_NATIVE_LOG_CHANGED')
    return {'schema': 'sp27-strata-build-execution-binding-v1',
            'manifest_sha256': manifest['sha256'], 'source_commit': prepared['source_before']['commit'],
            'binary_sha256': prepared['binary']['sha256'], 'qualification': result['qualification'],
            'successful_collection_is_business_qualification': False,
            'runtime_limits_or_deadlines_changed': False}


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--prepare', action='store_true')
    parser.add_argument('--out', type=Path, required=True)
    args = parser.parse_args()
    result = prepare(args.out) if args.prepare else execution(args.out)
    print(json.dumps(result, sort_keys=True))
    return 0 if result.get('completed', result.get('collection_completed')) is True else 1


if __name__ == '__main__':
    raise SystemExit(main())

4a63635251bbe36e729d0f9ad6928c532cce6183 blob 26814
#!/usr/bin/env python3
"""Review the declared V1/root inventory union and conditional AND arithmetic.

This is a research accounting contract, not a theorem checker. The two source
inventories do not instantiate one security game. No numeric declaration, source
checksum, or successful inspection can produce an actual lifetime bound.
"""
from __future__ import annotations

import argparse
import copy
from fractions import Fraction
import hashlib
import json
from pathlib import Path
import sys

import pq_lifetime_budget as legacy
import pq_root_dependency_register as root_register
from pq_source_reader import SourceReadError, read_regular

SCHEMA = "trnm-pq128-lifetime-composition-v2"
RESULT_SCHEMA = "trnm-pq128-lifetime-composition-result-v2"
ARITHMETIC_SCHEMA = "trnm-pq128-root-composition-arithmetic-v2"
DEFAULT_MANIFEST = "config/pon/pq128-lifetime-composition-v2.json"
REVIEW_BASE = "dc42ce4df5cff79cc61c5addbaf01074b56b06ca"
EXPERIMENT_ID = "trnm-proposed-joint-lifetime-experiment-v2"
COMMON_GAME = "uninstantiated-common-root-game-v2"
MAX_BYTES = legacy.MAX_BYTES

INPUTS = {
    "legacy": {
        "path": legacy.DEFAULT_MANIFEST,
        "sha256": "ed2558e8e3ee0806395272e20bab4bd63ab8676cc0dda0c790dd82fb13692edc",
        "declared_revision": "dc42ce4df5cff79cc61c5addbaf01074b56b06ca",
        "revision_semantics": "declared-event-source-revision",
    },
    "root": {
        "path": root_register.DEFAULT_MANIFEST,
        "sha256": "2b641a5e2e1bf66ad924e17d85da21c8cf76d7431fe35c8f448ab921659ba725",
        "declared_revision": root_register.REVIEW_BASE,
        "revision_semantics": "review-base-context-not-all-source-revision",
    },
}
PRIMITIVES = {
    "sha256": "FIPS180-4/SHA-256", "sha512": "FIPS180-4/SHA-512",
    "shake128": "FIPS202/SHAKE128", "shake256": "FIPS202/SHAKE256",
}
COVERAGE = [
    "online", "offline", "preprocessing", "failed", "cancelled", "rejected",
    "unpublished", "helpers", "recursive", "all-keys", "all-epochs",
    "shared-uses", "authority-surviving-retirement",
]
RESOURCE_VARIABLES = (
    "adversary_total_queries", "online_queries", "offline_search_queries",
    "preprocessing_queries", "honest_queries", "simulator_queries",
    "extractor_queries", "classical_advice_bits", "quantum_advice_qubits",
    "total_keys", "total_rosters", "total_epochs", "signing_queries",
    "verification_attempts",
)
LEAVES = {
    "common_failure": ("root-common-failure-whole-lifetime", "joint-root", "common"),
    "shared_game_loss": ("common-game-replacement-whole-lifetime", "joint-root", "shared"),
    "ml_event": ("threshold-family-whole-lifetime", "ML-DSA-87", "ml"),
    "ml_loss": ("family-reduction-whole-lifetime", "ML-DSA-87", "ml"),
    "slh_event": ("threshold-family-whole-lifetime", "SLH-DSA-SHA2-256s", "slh"),
    "slh_loss": ("family-reduction-whole-lifetime", "SLH-DSA-SHA2-256s", "slh"),
}


class CompositionError(ValueError):
    """A conflicting, incomplete or overclaiming declaration must be refused."""


def require(ok, message):
    if not ok:
        raise CompositionError(message)


def exact(value, expected, where):
    try:
        root_register.exact(value, expected, where)
    except root_register.RegisterError as error:
        raise CompositionError(str(error)) from error


def fields(value, names, where):
    require(type(value) is dict and set(value) == set(names.split()),
            "unexpected or missing fields: " + where)


def unknown_leaf(name):
    scope, profile, resource = LEAVES[name]
    return {
        "experiment_id": EXPERIMENT_ID, "game_id": COMMON_GAME,
        "model": legacy.MODEL, "scope": scope, "profile": profile,
        "resource_instance_id": resource, "status": "unknown",
        "bound": None, "theorem": None,
    }


def default_arithmetic():
    return {
        "schema": ARITHMETIC_SCHEMA, "purpose": "research-model",
        "experiment_id": EXPERIMENT_ID, "game_id": COMMON_GAME,
        "combiner": "common-plus-shared-plus-min-complete-family-bounds",
        "family_population": {
            "roles": list(root_register.ROLES),
            "required_by_role": {
                role: {"required": 3 if role == "successor-possession" else 2,
                       "roster_size": 3} for role in root_register.ROLES
            },
            "scope": "all-keys-all-epochs-including-retired-authority",
            "corruption_model": "unqualified",
            "threshold_to_forgery_reduction": "uninstantiated",
        },
        "inputs": {name: unknown_leaf(name) for name in LEAVES},
    }


def default_manifest():
    """Return reviewed declarations; never regenerate a source lock from files."""
    return {
        "schema": SCHEMA, "purpose": "research-obligation-bridge",
        "review_base_revision": REVIEW_BASE,
        "input_manifests": copy.deepcopy(INPUTS),
        "experiment": {
            "id": EXPERIMENT_ID, "model": legacy.MODEL,
            "profile": "proposed-native-pnw1-with-root-v2-v3-v4",
            "status": "uninstantiated", "horizon": None, "stopping_rule": None,
            "initial_state_and_advice": "unqualified",
            "prior_preprocessing_included": True,
            "authority_after_retirement_included": True,
            "joint_corruption_and_custody_model": "unqualified",
        },
        "scope_mappings": {
            "legacy_domains_to_current_candidate": "unproved",
            "root_to_legacy_domains": "unproved",
            "root_replaces_legacy_signature_term": False,
            "root_is_added_to_legacy_sum": False,
            "joint_bound_derived": False,
        },
        "primitive_scope_bridge": {
            primitive: {
                "public_parameter_id": identity,
                "budget_identity": "one-shared-lifetime-scope-across-both-registers",
                "maximum": None, "query_unit": None,
                "merge_rule": "identity-union-no-budget-sum-or-min",
                "reset_at_register_key_epoch_role_recovery": False,
            } for primitive, identity in PRIMITIVES.items()
        },
        "shared_substrates": {
            "keccak-p1600-24": {
                "interfaces": ["shake128", "shake256"],
                "reference": "https://nvlpubs.nist.gov/nistpubs/FIPS/NIST.FIPS.202.pdf",
                "interface_level": "xof-to-permutation-mapping-uninstantiated",
                "resource_transform": None, "maximum_queries": None,
                "joint_oracle_replacement_bound": None,
                "independent_oracles_proved": False,
                "other_sha3_profiles_included": False,
            },
        },
        "resource_instances": {
            name: {
                "status": "uninstantiated", "theorem_reference": None,
                "query_unit": None, "quantum_access_model": None,
                "auxiliary_state_kind": "unknown",
                "advice_generation_scope": "unknown",
                "variables": {key: None for key in RESOURCE_VARIABLES},
                "coverage_labels": list(COVERAGE),
                "coverage_labels_are_disjoint_buckets": False,
                "theorem_resource_transform": None,
                "honest_simulator_extractor_inclusion": "theorem-dependent-uninstantiated",
                "node_limits_bound_external_queries": False,
            } for name in ("common", "shared", "ml", "slh")
        },
        "root_event_relation": {
            "statement": "Bad_root subset C union (B_ML intersection B_SLH)",
            "status": "unproved-for-project",
            "common_failure_obligations": [
                "same-complete-statement-purpose-and-current-roster",
                "thresholds-distinct-signers-and-successor-possession",
                "implementation-refinement-and-owner-authority",
                "corruption-custody-revocation-and-all-state-recovery",
                "actual-external-effects-and-surviving-liabilities",
            ],
        },
        "conditional_root_arithmetic": default_arithmetic(),
        "additional_loss_accounting": {
            "placement_in_eight_domains": "unproved", "total": None,
            "known_budget_headroom_is_not_a_security_bound": True,
        },
        "actual_lifetime_failure_bound": None,
        "composition_coverage_proved": False,
        "whole_chain_hash_query_scope_closed": False,
        "whole_chain_pq_qualified": False, "production_activation": False,
    }


def maybe_sum(values):
    """An unknown required additive term never becomes zero."""
    if any(value is None for value in values):
        return None
    return legacy.bounded_sum(values, "conditional composition sum")


def intersection_bound(values):
    """One valid marginal bound also bounds an intersection; no product rule."""
    known = [value for value in values if value is not None]
    return min(known) if known else None


def review_arithmetic(data):
    """Exact arithmetic on unverified common-game declarations, never promotion.

Each family total contains its own reduction loss before the minimum. Common
failure and a shared game replacement are separate mandatory additive inputs.
Even a numeric zero must be an explicit declaration, not an omitted loss.
"""
    fields(data, "schema purpose experiment_id game_id combiner family_population inputs",
           "arithmetic")
    expected = default_arithmetic()
    for key in ("schema", "experiment_id", "game_id", "combiner", "family_population"):
        exact(data[key], expected[key], "arithmetic." + key)
    require(data["purpose"] in ("research-model", "arithmetic-example"),
            "unsupported arithmetic purpose")
    fields(data["inputs"], " ".join(LEAVES), "arithmetic.inputs")
    values = {}
    for name, row in data["inputs"].items():
        prototype = unknown_leaf(name)
        fields(row, " ".join(prototype), "arithmetic.inputs." + name)
        for key in ("experiment_id", "game_id", "model", "scope", "profile", "resource_instance_id"):
            exact(row[key], prototype[key], name + "." + key)
        require(row["status"] in ("unknown", "declared-model-bound"),
                "unsupported status; a declaration cannot self-certify")
        if row["status"] == "unknown":
            require(row["bound"] is None and row["theorem"] is None,
                    "unknown input requires null bound and theorem")
            values[name] = None
        else:
            theorem = row["theorem"]
            fields(theorem, "reference locator applicability", name + ".theorem")
            for key, value in theorem.items():
                legacy.string(value, name + ".theorem." + key)
            values[name] = legacy.probability(row["bound"], name + ".bound")
    ml = maybe_sum([values["ml_event"], values["ml_loss"]])
    slh = maybe_sum([values["slh_event"], values["slh_loss"]])
    intersection = intersection_bound([ml, slh])
    uncapped = maybe_sum([values["common_failure"], values["shared_game_loss"], intersection])
    conditional = None if uncapped is None else min(Fraction(1), uncapped)
    return {
        "schema": "trnm-pq128-root-composition-arithmetic-result-v2", "status": "HOLD",
        "arithmetic_contract_satisfied": True,
        "experiment_identity_matches": True,
        "family_complete_declared_bounds": {"ML-DSA-87": legacy.rational(ml),
                                             "SLH-DSA-SHA2-256s": legacy.rational(slh)},
        "cryptographic_intersection_subtotal": legacy.rational(intersection),
        "uncapped_declared_sum": legacy.rational(uncapped),
        "conditional_root_declared_bound": legacy.rational(conditional),
        "unknown_inputs": [name for name in LEAVES if values[name] is None],
        "project_event_relation_proved": False,
        "theorems_applicable_to_common_experiment": False,
        "actual_lifetime_failure_bound": None,
        "whole_chain_pq_qualified": False, "production_activation": False,
        "note": "Conditional arithmetic only; references and matching labels do not establish the declared bounds or the project event relation.",
    }


QUERY_TAIL_LEAVES = (
    "bounded_query_failure", "query_budget_overrun", "bounded_game_reduction_loss",
)


def default_query_tail_arithmetic():
    """Separate declarations for a bounded game, resource tail and game lift.

    This does not instantiate a query counter or a global attacker cap. The
    event bound is on Bad intersect {Q <= q}, not a per-invocation estimate.
    A theorem about a truncated algorithm needs a justified lift to that event.
    """
    budget = {"maximum": None, "unit": None}
    return {
        "schema": "trnm-pq128-lifetime-query-tail-arithmetic-v1",
        "purpose": "research-model", "experiment_id": EXPERIMENT_ID,
        "game_id": "uninstantiated-lifetime-query-tail-game-v1",
        "model": legacy.MODEL,
        "scope": "all-keys-all-epochs-including-retired-authority",
        "query_count_definition": "total-lifetime-including-prior-work",
        "bounded_event": "Bad intersection {Q<=q}",
        "overrun_event": "{Q>q}",
        "coverage_labels": list(COVERAGE) + ["initial-state", "classical-advice", "quantum-advice"],
        "coverage_labels_are_disjoint_buckets": False,
        "node_limits_bound_external_queries": False,
        "reset_at_key_epoch_role_recovery": False,
        "query_budget": budget,
        "target": legacy.rational(Fraction(1, 1 << 128)),
        "inputs": {
            name: {"query_budget": copy.deepcopy(budget), "status": "unknown",
                   "bound": None, "theorem": None} for name in QUERY_TAIL_LEAVES
        },
    }


def review_query_tail_arithmetic(data):
    """Evaluate epsilon + P(Q>q) + delta on explicit unverified declarations.

    Whenever Q is a well-defined lifetime resource variable, partition Bad into
    {Q<=q} and {Q>q}. No independence is needed. Applicability of a bounded-game
    theorem, initial advice, resource transformations and the tail bound remain
    separate project obligations. A node timeout never supplies a zero tail.
    """
    expected = default_query_tail_arithmetic()
    fields(data, " ".join(expected), "query-tail arithmetic")
    for key in expected:
        if key not in ("purpose", "query_budget", "inputs"):
            exact(data[key], expected[key], "query-tail." + key)
    require(data["purpose"] in ("research-model", "arithmetic-example"),
            "unsupported query-tail arithmetic purpose")
    budget = data["query_budget"]
    fields(budget, "maximum unit", "query-tail.query_budget")
    if budget["maximum"] is None:
        require(budget["unit"] is None, "unknown query maximum requires unknown unit")
    else:
        legacy.natural(budget["maximum"], "query-tail.query_budget.maximum")
        legacy.string(budget["unit"], "query-tail.query_budget.unit")
    fields(data["inputs"], " ".join(QUERY_TAIL_LEAVES), "query-tail.inputs")
    values = {}
    for name in QUERY_TAIL_LEAVES:
        row = data["inputs"][name]
        fields(row, "query_budget status bound theorem", "query-tail." + name)
        exact(row["query_budget"], budget, "query-tail." + name + ".query_budget")
        require(row["status"] in ("unknown", "declared-model-bound"),
                "query-tail declaration cannot self-certify")
        if row["status"] == "unknown":
            require(row["bound"] is None and row["theorem"] is None,
                    "unknown query-tail input requires null bound and theorem")
            values[name] = None
        else:
            require(budget["maximum"] is not None,
                    "declared query-tail bounds require explicit query maximum and unit")
            fields(row["theorem"], "reference locator applicability", name + ".theorem")
            for key, value in row["theorem"].items():
                legacy.string(value, name + ".theorem." + key)
            values[name] = legacy.probability(row["bound"], name + ".bound")
    known = legacy.bounded_sum([v for v in values.values() if v is not None],
                               "known query-tail subtotal")
    total = maybe_sum(list(values.values()))
    target = legacy.probability(data["target"], "query-tail.target")
    return {
        "schema": "trnm-pq128-lifetime-query-tail-arithmetic-result-v1", "status": "HOLD",
        "arithmetic_contract_satisfied": True,
        "query_budget": copy.deepcopy(budget),
        "declared_input_bounds": {name: legacy.rational(v) for name, v in values.items()},
        "unknown_inputs": [name for name in QUERY_TAIL_LEAVES if values[name] is None],
        "known_declared_subtotal": legacy.rational(known),
        "uncapped_declared_sum": legacy.rational(total),
        "conditional_lifetime_declared_bound": legacy.rational(
            None if total is None else min(Fraction(1), total)),
        "target": legacy.rational(target),
        "remaining_target_after_known_inputs": legacy.rational(target - known),
        "declared_target_exceeded_by_known_inputs": known > target,
        "declared_target_met": None if total is None else total <= target,
        "target_comparison_is_arithmetic_only": True,
        "resource_random_variable_defined_for_project": False,
        "bounded_game_to_project_reduction_proved": False,
        "theorem_applicability_verified": False,
        "composition_coverage_proved": False,
        "whole_chain_hash_query_scope_closed": False,
        "actual_lifetime_failure_bound": None,
        "whole_chain_pq_qualified": False, "production_activation": False,
        "note": "Separate conditional accounting only. Matching counts, units and coverage labels do not define the project's resource variable, prove a tail bound, authenticate advice, or connect a bounded-game theorem to the project. This result is not substituted for or added to either existing register.",
    }


def merge_source_maps(legacy_files, root_files):
    """Do not let one reviewed source silently overwrite another."""
    merged = dict(legacy_files)
    for path, digest in root_files.items():
        require(path not in merged or merged[path] == digest,
                "conflicting source digest across registers: " + path)
        merged[path] = digest
    return dict(sorted(merged.items()))


def bridge_primitives(legacy_data, root_data):
    """Join fixed public identities, never add two budgets for the same oracle."""
    old = {row["id"]: row for row in legacy_data["primitives"]}
    new = root_data["primitives"]
    require(set(old) == set(new) == set(PRIMITIVES), "primitive scope mismatch")
    seen = set()
    out = {}
    for name, identity in PRIMITIVES.items():
        left, right = old[name], new[name]
        require(left["public_parameter_id"] == right["public_parameter_id"] == identity,
                "shared public primitive identity mismatch: " + name)
        require(identity not in seen, "duplicate shared primitive identity")
        seen.add(identity)
        require(left["fixed_across_epochs"] is True and right["fixed_across_epochs"] is True,
                "fixed public primitive cannot be reset")
        lq, rq = left["query_budget"], right["query_budget"]
        require(left["reset_at_epoch"] is False
                and all(rq[key] is False for key in (
                    "reset_at_key_epoch", "reset_at_recovery", "reset_at_role_boundary")),
                "query scope cannot reset at a register, role, key or epoch")
        require(lq["basis"] == rq["basis"] == "unknown"
                and lq["maximum"] is None and rq["maximum"] is None
                and rq["unit"] == "not-instantiated",
                "changed query bounds/units require a new joint review")
        out[name] = {
            "public_parameter_id": identity, "maximum": None, "query_unit": None,
            "legacy_term_ids": sorted(term["id"] for term in legacy_data["terms"]
                                      if name in term["primitive_ids"]),
            "root_use_ids": list(right["use_ids"]),
            "scope": "declared-use-union-only", "query_budget_proved": False,
        }
    return out


def validate_manifest(data):
    exact(data, default_manifest(), "composition manifest")
    return {
        "schema": RESULT_SCHEMA, "status": "HOLD", "inventory_contract_satisfied": True,
        "review_base_revision": REVIEW_BASE,
        "declared_source_union_consistent": False, "source_binding_scope": "unbound",
        "source_revision_bound": False, "deployment_identity_proved": False,
        "transitive_dependency_closure_proved": False,
        "conditional_root_arithmetic": review_arithmetic(data["conditional_root_arithmetic"]),
        "conditional_query_tail_arithmetic": review_query_tail_arithmetic(default_query_tail_arithmetic()),
        "scope_mappings": copy.deepcopy(data["scope_mappings"]),
        "resource_instances": copy.deepcopy(data["resource_instances"]),
        "shared_substrates": copy.deepcopy(data["shared_substrates"]),
        "additional_loss_placement": "unproved", "additional_loss_total": None,
        "allocation_sufficiency_under_declared_losses": None,
        "actual_lifetime_failure_bound": None, "joint_bound_derived": False,
        "composition_coverage_proved": False, "theorem_applicability_verified": False,
        "whole_chain_hash_query_scope_closed": False,
        "whole_chain_pq_qualified": False, "pq_128_qualified": False,
        "production_activation": False,
        "note": "The old domain experiment and the new root inventory are not a proved common experiment. No numeric bound is transferred, substituted, added or promoted.",
    }


def inspect(root, manifest_path=DEFAULT_MANIFEST):
    root = Path(root)
    try:
        raw = read_regular(root, legacy.relative_path(manifest_path, "manifest"), MAX_BYTES)
        data = legacy.strict_json(raw)
        result = validate_manifest(data)
        children = {}
        for name, item in INPUTS.items():
            child_raw = read_regular(root, item["path"], MAX_BYTES)
            require(hashlib.sha256(child_raw).hexdigest() == item["sha256"],
                    "input manifest differs from reviewed bytes: " + name)
            children[name] = legacy.strict_json(child_raw)
        old_result = legacy.inspect(root)
        root_result = root_register.inspect(root)
        for name, child in (("legacy", old_result), ("root", root_result)):
            require(child["manifest_sha256"] == INPUTS[name]["sha256"],
                    "child manifest changed between inspections: " + name)
            require(child["actual_lifetime_failure_bound"] is None
                    and child["composition_coverage_proved"] is False
                    and child["whole_chain_pq_qualified"] is False
                    and child["production_activation"] is False,
                    "changed child qualification requires new review")
        require(old_result["experiment"]["source_revision"] == INPUTS["legacy"]["declared_revision"]
                and root_result["review_base_revision"] == INPUTS["root"]["declared_revision"],
                "child revision semantics mismatch")
        require(old_result["purpose"] == "research-model" and old_result["source_revision_bound"] is True
                and root_result["source_files_checked"] is True,
                "source inventories must be checked research inputs")
        require(len(old_result["unknown_terms"]) == 8
                and all(value is None for value in root_result["domain_failure_bounds"].values()),
                "new component bounds require explicit experiment and coverage review")
        files = merge_source_maps(old_result["source_files_sha256"], root_result["source_files_sha256"])
        shared_paths = sorted(set(old_result["source_files_sha256"])
                              & set(root_result["source_files_sha256"]))
        source_counts = {
            "legacy": len(old_result["source_files_sha256"]),
            "root": len(root_result["source_files_sha256"]),
            "shared": len(shared_paths), "union": len(files),
        }
        require(source_counts == {"legacy": 21, "root": 46, "shared": 1, "union": 66}
                and shared_paths == ["trillionnium/crates/trnm-release-bundle/src/pq_release.rs"],
                "declared source union changed; review the mapping")
        scopes = bridge_primitives(children["legacy"], children["root"])
        allocated = legacy.probability(old_result["allocated_sum"], "allocated sum")
        target = legacy.probability(old_result["target"], "target")
        result.update({
            "manifest_sha256": hashlib.sha256(raw).hexdigest(),
            "input_manifests": copy.deepcopy(INPUTS),
            "legacy_source_lock_sha256": old_result["source_lock_sha256"],
            "root_declared_source_snapshot_sha256": root_result["declared_source_snapshot_sha256"],
            "declared_source_union_consistent": True,
            "source_binding_scope": "declared-path-union-only",
            "source_counts": source_counts,
            "source_files_sha256": files,
            "shared_source_paths": shared_paths,
            "primitive_scope_union": scopes, "shared_primitive_scope_count": len(scopes),
            "unknown_lifetime_query_budgets": sorted(scopes),
            "unknown_role_lifetime_populations": list(root_register.ROLES),
            "legacy_declared_arithmetic": {
                "experiment": old_result["experiment"],
                "model_arithmetic_sum": old_result["model_arithmetic_sum"],
                "unknown_terms": old_result["unknown_terms"],
                "not_transferred_to_joint_experiment": True,
            },
            "allocation_headroom": legacy.rational(target - allocated),
            "allocation_is_target_only": True,
            "domain_failure_bounds": {name: None for name in root_register.DOMAINS},
        })
        return result
    except (legacy.BudgetError, root_register.RegisterError, SourceReadError,
            KeyError, TypeError) as error:
        raise CompositionError(str(error)) from error


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", type=Path, default=Path(__file__).resolve().parents[2])
    parser.add_argument("--manifest", default=DEFAULT_MANIFEST)
    args = parser.parse_args()
    try:
        report = inspect(args.root, args.manifest)
    except (CompositionError, OSError, ValueError) as error:
        print(json.dumps({"schema": RESULT_SCHEMA, "status": "REFUSE", "error": str(error),
                          "actual_lifetime_failure_bound": None, "whole_chain_pq_qualified": False,
                          "production_activation": False}, sort_keys=True))
        return 2
    print(json.dumps(report, sort_keys=True))
    return 0


if __name__ == "__main__":
    sys.exit(main())

4aa91a62595b5771a09cfe017395af652f93a0aa blob 32315
#!/usr/bin/env python3
"""Read the cost coverage of one pinned original native multiprocess report.

This is an observation reader, including failed/unfinished campaigns. It runs
no node, supplies no authority, and never sums overlapping CPU domains. The
caller pins the report SHA256 and its retained before/after source receipts;
these inputs establish consistency, not process attestation or current-source
qualification. Each receiver/import epoch remains local to its exact report
path. Absent measurements remain null, including the complete pipeline cost.
"""
from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path
import re
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
import pon_public_v3_phase_read as phases
from read_native_cache_observation import read_bounded, strict_json

SCHEMA = 'pon-throughput-cost-coverage-v2'
MAX_REPORT_BYTES = 256 * 1024 * 1024
MAX_RECORDS = 16384
SOURCE_FIELDS = {'schema', 'kind', 'candidate', 'tested_commit', 'tested_tree',
                 'base', 'prospective_merge', 'tracked_entries', 'tracked_bytes',
                 'tracked_worktree_verified', 'tests_executed_by_identity_check'}
HOST_FIELDS = ('cpu_usage_usec', 'cpu_nr_periods', 'cpu_nr_throttled',
               'cpu_throttled_usec', 'memory_current_bytes', 'pids_current')
PQ_FIELDS = ('pq_authentication_attempts', 'pq_authentication_bytes',
             'pq_authentication_thread_cpu_ns', 'pq_authentication_unavailable')
MUTATION_FIELDS = ('mutation_cpu_charged_ns', 'mutation_full_work_cpu_ns',
                   'mutation_dispatch_excluding_work_cpu_ns',
                   'mutation_body_decode_cpu_ns', 'mutation_response_cpu_ns')
CLIENT_IMPORT_SCOPE = ('calling client thread only; excludes scoped execution worker CPU; '
                       'unknown clock is null; no deadline or acceptance authority')


def require(condition, reason):
    if not condition:
        raise ValueError(reason)


def digest(value, digits=64):
    require(type(value) is str and re.fullmatch('[0-9a-f]{' + str(digits) + '}', value),
            'canonical digest required')
    return value


def number(value):
    require(type(value) is int and 0 <= value < 1 << 64, 'measured u64 required')
    return value


def optional_number(value):
    return None if value is None else number(value)


def measurements(values):
    """One metric over observed slots, never a sum across nested cost domains."""
    known = [number(value) for value in values if value is not None]
    return {'observed_slots': len(values), 'known_slots': len(known),
            'unknown_slots': len(values) - len(known),
            'sum_known': sum(known) if known else None,
            'sum_all_observed': sum(known) if known and len(known) == len(values) else None,
            'max_known': max(known) if known else None}


def source_binding(before, after, *, head, tree, kind='head', base=None, merge=None):
    digest(head, 40)
    digest(tree, 40)
    require(kind in ('head', 'prospective-merge'), 'source kind required')
    if kind == 'head':
        require(base is None and merge is None, 'unexpected merge source arguments')
        tested = head
    else:
        digest(base, 40)
        tested = digest(merge, 40)
    require(type(before) is dict and set(before) == SOURCE_FIELDS
            and before == after, 'unchanged complete source receipts required')
    require(before['schema'] == 'trnm-ci-source-v1'
            and before['kind'] == kind and before['candidate'] == head
            and before['tested_commit'] == tested and before['tested_tree'] == tree
            and before['base'] == base and before['prospective_merge'] == merge
            and before['tracked_worktree_verified'] is True
            and before['tests_executed_by_identity_check'] is False,
            'pinned source head/tree/kind mismatch')
    require(number(before['tracked_entries']) > 0 and number(before['tracked_bytes']) > 0,
            'tracked source coverage required')


def phase_epoch_records(observer):
    rows = observer.get('records')
    require(type(rows) is list and len(rows) <= MAX_RECORDS, 'bounded receiver records required')
    ids = [number(row.get('connection_id')) for row in rows]
    require(all(value > 0 for value in ids) and len(set(ids)) == len(ids),
            'duplicate receiver identity in one epoch')
    seen = number(observer.get('accepted_connections_seen'))
    omitted = number(observer.get('records_not_retained'))
    capacity = number(observer.get('capacity'))
    require(0 < capacity <= MAX_RECORDS and len(rows) <= capacity
            and len(rows) + omitted <= seen, 'receiver observation denominator mismatch')
    number(observer.get('measurement_failures'))
    require(type(observer.get('counter_overflow')) is bool
            and observer.get('observation_has_consensus_authority') is False
            and observer.get('stream_bytes_are_physical_network_bytes') is False,
            'receiver observation scope mismatch')
    require(observer.get('cpu_intervals_are_nested_not_additive') is True,
            'receiver CPU domains cannot be added')
    for row in rows:
        require(row.get('physical_network_bytes') is None,
                'this producer does not measure physical network bytes')
        for key in ('application_bytes_read', 'application_bytes_written',
                    'dispatch_thread_cpu_ns', 'full_work_thread_cpu_ns'):
            optional_number(row.get(key))
        # The record's lifecycle and its receiver phases share one local
        # epoch. History import snapshots below own different local epochs.
        life = row.get('lifecycle')
        if life is None:
            continue
        phases.request_owner_lifecycle_summary([row])
        if row.get('observation_failed') is True:
            continue
        accepted = life['accepted_ns']
        closed = [value for value in (life['connection_closed_ns'], life['task_closed_ns'])
                  if value is not None]
        for span in row.get('submit_phases', []):
            for key in ('started_ns', 'ended_ns'):
                value = span.get(key)
                if value is not None and accepted is not None:
                    require(value >= accepted, 'receiver span precedes its own epoch acceptance')
                if value is not None and closed and row.get('complete') is True:
                    require(value <= max(closed), 'receiver span escapes its own closed epoch')
    return rows, seen - len(rows)


def bounded_report_shape(report):
    """Reject malformed or oversized collections before the shared analyzer."""
    require(type(report) is dict and type(report.get('preparation')) is dict,
            'original report and preparation objects required')
    require(report.get('state_backend') in (None, 'legacy-v2', 'authenticated-v1'),
            'recognized or absent original state backend required')
    phase_rows = report.get('phases')
    require(type(phase_rows) is list and len(phase_rows) == 3
            and all(type(row) is dict for row in phase_rows), 'three original phase objects required')
    for phase in phase_rows:
        if phase.get('startup_or_campaign_error') is not None:
            require(type(phase['startup_or_campaign_error']) is str,
                    'original startup failure text required')
            continue
        observer, history = phase.get('receiver_observation'), phase.get('history')
        require(type(observer) is dict and type(observer.get('records')) is list
                and len(observer['records']) <= MAX_RECORDS
                and all(type(row) is dict for row in observer['records']),
                'bounded receiver record objects required')
        require(type(history) is list and len(history) <= 64
                and all(type(row) is dict for row in history), 'bounded History call objects required')
        rounds = phase.get('confirmations')
        require(type(rounds) is list and len(rounds) <= phases.ROUNDS
                and all(type(row) is dict for row in rounds), 'bounded confirmation round objects required')
        for row in history:
            require(row.get('client_import') is None or type(row['client_import']) is dict,
                    'original client import object required')


def request_costs(observer, epoch):
    rows, unobserved = phase_epoch_records(observer)
    output = {'epoch': epoch, 'retained_records': len(rows),
              'unobserved_records': unobserved,
              'measurement_failures': observer['measurement_failures'],
              'counter_overflow': observer['counter_overflow'],
              'all_request_costs_covered': False,
              'dispatch_thread_cpu_ns': measurements([row.get('dispatch_thread_cpu_ns')
                  for row in rows if row.get('dispatch_started') is True]),
              'full_work_thread_cpu_ns': measurements([row.get('full_work_thread_cpu_ns')
                  for row in rows if row.get('full_work_started') is True]),
              'application_bytes_read': measurements([row.get('application_bytes_read') for row in rows]),
              'application_bytes_written': measurements([row.get('application_bytes_written') for row in rows]),
              'physical_network_bytes': None, 'phases': [], 'waits': {},
              'scope': 'retained receiver records only; full work is inside dispatch; '
                       'dispatch/phase CPU excludes separately scoped workers; '
                       'stream counts are application bytes, not physical network bytes; '
                       'missing or unentered work is not a zero-cost sample'}
    names = (phases.PHASES_V4 if observer['schema'].endswith('-v4') else
             phases.PHASES if observer['schema'].endswith(('-v2', '-v3')) else ())
    for name in names:
        slots = [next(span for span in row['submit_phases'] if span['phase'] == name) for row in rows]
        entered = [span for span in slots if span['started'] is True]
        output['phases'].append({'phase': name, 'parent_phase': phases.PHASE_PARENTS_V4.get(name),
            'entered': len(entered), 'unentered': len(slots) - len(entered),
            'terminal': sum(span['completed'] is True for span in entered),
            'unfinished': sum(span['completed'] is not True for span in entered),
            'thread_cpu_ns': measurements([span.get('thread_cpu_ns') for span in entered]),
            'wall_ns': measurements([span.get('wall_ns') for span in entered])})
    if observer['schema'].endswith('-v4'):
        for name in phases.WAIT_FIELDS_V4:
            entered = [row[name] for row in rows if row[name]['started_ns'] is not None]
            output['waits'][name] = {
                'wall_ns': measurements([span['wall_ns'] for span in entered]),
                'terminal': sum(span['completed'] for span in entered),
                'unfinished': sum(not span['completed'] for span in entered),
                'scope': 'observed request wait durations, not CPU or a whole-phase latency'}
    values = [row['cpu_settlement'] for row in rows
              if row.get('cpu_settlement', {}).get('schema') == phases.CPU_SETTLEMENT_VALUES_SCHEMA]
    output['settlement'] = {
        'value_records': len(values), 'records_without_value_settlement': len(rows) - len(values),
        **{name: measurements([value[name] for value in values])
           for name in phases.CPU_SETTLEMENT_VALUE_FIELDS},
        'scope': 'original owner plus scoped-worker total; overlaps dispatch; '
                 'live-paid plus residual describes the same total, not additional work; '
                 'CPU-settle observer phase is not additive to this total'}
    return output


def listener_costs(outcome):
    require(type(outcome) is dict and set(outcome) in ({'Ok'}, {'Err'}),
            'original service Result required')
    if 'Err' in outcome:
        return {'outcome': outcome, 'pq_authentication': None, 'mutation_counters': None}
    metrics = outcome['Ok']
    require(type(metrics) is dict, 'service metrics required')
    pq = {key: metrics.get(key) for key in PQ_FIELDS}
    for key, value in pq.items():
        if key.endswith('unavailable'):
            require(value is None or type(value) is bool, 'PQ availability boolean required')
        else:
            optional_number(value)
    pq['missing_fields'] = [key for key in PQ_FIELDS if key not in metrics]
    pq['scope'] = ('listener intake epoch cumulative attempts/bytes/calling-thread CPU; '
                   'not a per-request increment; zero attempts does not exercise PQ; '
                   'never add to overlapping response/dispatch/process CPU')
    mutation = {key: optional_number(metrics.get(key)) for key in MUTATION_FIELDS}
    total, work, rest = (mutation[key] for key in MUTATION_FIELDS[:3])
    if all(value is not None for value in (total, work, rest)):
        require(total == work + rest, 'mutation CPU settlement partition mismatch')
    mutation['scope'] = ('original charged CPU and its partitions; body decode and response '
                         'are inside dispatch-excluding-work, not additional charges; '
                         'this is not full listener or Host CPU')
    return {'outcome': 'Ok', 'pq_authentication': pq, 'mutation_counters': mutation}


def history_costs(history, epoch):
    require(type(history) is list and len(history) <= 64, 'bounded original History calls required')
    imports = [row['client_import'] for row in history if type(row.get('client_import')) is dict]
    records = []
    for value in imports:
        require(value.get('scope') == CLIENT_IMPORT_SCOPE,
                'client import calling-thread CPU scope required')
        optional_number(value.get('thread_cpu_ns'))
        optional_number(value.get('wall_ns'))
    for index, row in enumerate(history):
        value = row.get('client_import')
        if type(value) is not dict:
            continue
        native = value.get('native_import_observation')
        if native is None:
            continue
        # Parent analyzer already checks request tip/after/packet count and
        # native import outcome. Retain each whole local snapshot unchanged.
        phases.validate_history_import_observation(native)
        records.append({'history_call_index': index,
            'epoch': epoch + f'/history/{index}/client_import/native_import_observation',
            'succeeded': value['succeeded'], 'error': value['error'],
            'caller_thread_cpu_ns': optional_number(value.get('thread_cpu_ns')),
            'caller_wall_ns': optional_number(value.get('wall_ns')),
            'native_snapshot': native})
    host = []
    for name in ('resolve', 'initial', 'checkpoint', 'final'):
        slots = [next(slot for slot in row['native_snapshot']['host_checks'] if slot['phase'] == name)
                 for row in records]
        host.append({'phase': name, 'observed_imports': len(slots),
            'calls_started': sum(slot['calls_started'] for slot in slots) if slots else None,
            'calls_unfinished': sum(slot['calls_unfinished'] for slot in slots) if slots else None,
            'thread_cpu_ns': measurements([slot['thread_cpu_ns'] for slot in slots]),
            'wall_ns': measurements([slot['wall_ns'] for slot in slots])})
    return {'history_calls': len(history), 'retained_imports': len(imports),
            'imports_with_native_snapshot': len(records),
            'imports_without_native_snapshot': len(imports) - len(records),
            'caller_thread_cpu_ns': measurements([value.get('thread_cpu_ns') for value in imports]),
            'caller_wall_ns': measurements([value.get('wall_ns') for value in imports]),
            'host_checks': host, 'records': records,
            'cold_recovery_cpu_ns': None,
            'scope': 'live History import, not full cold recovery; native/Host spans overlap '
                     'the outer import; Host CPU sums invoking threads, not all worker CPU; '
                     'each snapshot has its own epoch; no offsets are joined across snapshots'}


def host_costs(context):
    if context is None:
        return None
    require(type(context) is dict
            and context.get('schema') == 'fixed-public-phase-external-actors-v1'
            and context.get('same_original_receiver_and_verifier_owners') is True
            and context.get('attackers_launched_by_external_controller') is True
            and all(context.get(key) is False for key in ('runtime_business_deadline_changed',
                    'scalar_policy_changed', 'independent_administration', 'wan_qualified')),
            'fixed public phase context required')
    def canonical_cgroup(value):
        return (type(value) is str and value.startswith('/')
                and (value == '/' or all(part not in ('', '.', '..')
                                        for part in value[1:].split('/'))))

    require(canonical_cgroup(context.get('phase_cgroup'))
            and context['phase_cgroup'].startswith('/trnmponpublic.slice/')
            and canonical_cgroup(context.get('controller_cgroup'))
            and not context['controller_cgroup'].startswith('/trnmponpublic.slice/')
            and context['controller_cgroup'] != '/trnmponpublic.slice'
            and number(context.get('phase_pid')) > 0, 'distinct original phase/controller owners required')
    before, after = context.get('host_before'), context.get('host_after')
    require(type(before) is dict and type(after) is dict
            and set(before) == set(after) == set(HOST_FIELDS), 'complete Host counter snapshots required')
    for snapshot in (before, after):
        for value in snapshot.values():
            number(value)
    delta = {}
    for name in HOST_FIELDS[:4]:
        require(after[name] >= before[name], 'Host cumulative counter rewind')
        delta[name] = after[name] - before[name]
    return {'context': context, 'counter_deltas': delta,
            'serialized_boot_identity': None,
            'scope': 'the two samples of this one fixed-parent phase context only; '
                     'producer verifies Host identity, but these counters are not signed attestation; '
                     'CPU excludes the external controller; memory/pids are point samples, not deltas '
                     'or peaks; no counter subtraction across phases or process restarts'}



def finite_business_observation(original, derived, epoch):
    """Read distinct independently confirmed transactions in the original window.

    A retained native flag is not by itself a transaction observation. This
    finite workload is deliberately sparse; its rate is never a capacity or
    sustained-throughput claim. Failed and unobserved scheduled slots remain
    separate, and all timing is local to this one original phase.
    """
    available = derived['observations_available']
    window_ns = number(original['duration_seconds']) * 1_000_000_000 if available else None
    rounds = original['confirmations'] if available else []
    reasons = [] if rounds else ['no-retained-confirmation-rounds' if available
                                 else 'phase-observations-unavailable']
    observed_ids, confirmed_ids, records = set(), set(), []
    observation_fields = ('transaction', 'included_block', 'observed_tip', 'confirmed',
        'reorged', 'finalized', 'execution_authority', 'depth', 'included_height',
        'observed_height', 'work_delta', 'required_work_delta')
    for row in rounds:
        index = number(row['round'])
        claimed = row.get('confirmed_inside_pressure_window')
        require(type(claimed) is bool, 'native confirmation flag boolean required')
        scheduled = (1 + 4 * index) * 1_000_000_000
        start, end = (optional_number(row.get(key)) for key in ('started_ns', 'ended_ns'))
        if start is not None:
            require(start >= scheduled, 'round begins before its original scheduled epoch')
        if start is not None and end is not None:
            require(end >= start, 'confirmation round clock rewind')
        else:
            reasons.append(f'round-{index}:missing-round-time')
        transaction = row.get('transaction')
        if transaction is None:
            reasons.append(f'round-{index}:missing-transaction-id')
        else:
            observed_ids.add(digest(transaction))
        verified = False
        if claimed:
            observation = row.get('observation')
            require(observation is None or type(observation) is dict,
                    'independent confirmation observation object required')
            missing = [key for key in observation_fields
                       if observation is None or observation.get(key) is None]
            missing += [key for key in ('transaction', 'included_block', 'tip')
                        if row.get(key) is None]
            if missing:
                reasons.append(f'round-{index}:missing-independent-confirmation-fields:'
                               + ','.join(sorted(set(missing))))
            else:
                require(all(observation[key] is False for key in
                            ('reorged', 'finalized', 'execution_authority'))
                        and observation['confirmed'] is True
                        and type(observation['depth']) is int and observation['depth'] == 6
                        and number(observation['observed_height'])
                            - number(observation['included_height']) == 6,
                        'independent depth-six confirmation outcome mismatch')
                for outer, inner in (('transaction', 'transaction'),
                                     ('included_block', 'included_block'), ('tip', 'observed_tip')):
                    require(digest(row[outer]) == digest(observation[inner]),
                            'independent confirmation identity mismatch')
                work = int(digest(observation['work_delta'], 128), 16)
                required_work = int(digest(observation['required_work_delta'], 128), 16)
                require(required_work > 0 and work >= required_work,
                        'independent confirmation required work mismatch')
                if start is not None and end is not None:
                    require(end < window_ns, 'confirmed round outside its original pressure window')
                    confirmed_ids.add(transaction)
                    verified = True
        records.append({'round': index, 'transaction': transaction, 'scheduled_ns': scheduled,
            'started_ns': start, 'ended_ns': end, 'native_confirmed_inside_pressure_window': claimed,
            'independent_confirmation_fields_verified': verified,
            'round_wall_ns': end - start if start is not None and end is not None else None,
            'start_delay_ns': start - scheduled if start is not None else None,
            'scheduled_to_terminal_ns': end - scheduled if end is not None else None})
    complete_identity = available and bool(rounds) and not reasons
    confirmed = len(confirmed_ids) if complete_identity else None
    failed_rounds = sum(not row['native_confirmed_inside_pressure_window'] for row in records)
    return {'schema': 'pon-finite-confirmed-business-observation-v1', 'epoch': epoch,
        'window_ns': window_ns, 'scheduled_confirmation_rounds': phases.ROUNDS,
        'observed_confirmation_rounds': len(records),
        'native_confirmed_rounds': sum(row['native_confirmed_inside_pressure_window'] for row in records)
                                  if available else None,
        'native_unconfirmed_rounds': failed_rounds if available else None,
        'unobserved_scheduled_rounds': phases.ROUNDS - len(records),
        'observed_round_nonconfirmation_fraction': {'numerator': failed_rounds,
            'denominator': len(records)} if records else None,
        'observed_transaction_ids': sorted(observed_ids),
        'independently_checked_confirmed_transaction_ids': sorted(confirmed_ids),
        'observed_unique_confirmed_transactions': confirmed,
        'observed_confirmed_tps': confirmed * 1_000_000_000 / window_ns
                                  if confirmed is not None else None,
        'rate_unknown_reasons': sorted(set(reasons)), 'rounds': records,
        'confirmed_round_wall_ns': phases.stats([row['round_wall_ns'] for row in records
            if row['independent_confirmation_fields_verified']]),
        'unconfirmed_round_wall_ns': phases.stats([row['round_wall_ns'] for row in records
            if not row['native_confirmed_inside_pressure_window']]),
        'all_observed_scheduled_to_terminal_ns': phases.stats(
            [row['scheduled_to_terminal_ns'] for row in records]),
        'request_attempts': {'submit': derived['submissions'], 'history': derived['history']}
                            if available else None,
        'scope': {'rate_is_capacity_estimate': False, 'production_qualification': False,
            'acknowledgments_are_confirmations': False, 'repeated_transaction_ids_count_once': True,
            'unobserved_slots_are_failed_samples': False, 'cross_phase_clocks_are_joined': False,
            'statement': 'original sparse three-round, thirty-second phase only; unique retained '
                         'independent transaction confirmations, including all failed and unobserved '
                         'scheduled denominators; elapsed failure durations are not success latencies; '
                         'reader validates retained fields, not signatures or execution attestation'}}


def process_memory_costs(value):
    """Retain the producer's point RSS and lifetime high-water scopes."""
    if value is None:
        return None
    fields = ('rss_bytes', 'lifetime_peak_rss_bytes', 'kernel_rusage_self_peak_rss_bytes')
    scope = ('Linux /proc/self magic self and kernel RUSAGE_SELF; peak is whole process lifetime, '
             'not an isolated allocation or incremental memory bound')
    require(type(value) is dict and set(value) == {*fields, 'scope'} and value['scope'] == scope,
            'original process point and lifetime memory scope required')
    measured = {key: optional_number(value[key]) for key in fields}
    if measured['rss_bytes'] is not None and measured['lifetime_peak_rss_bytes'] is not None:
        require(measured['rss_bytes'] <= measured['lifetime_peak_rss_bytes'],
                'process RSS exceeds its recorded lifetime high-water mark')
    return {**measured, 'scope': scope, 'per_request_peak_measured': False}


def analyze(report, report_sha256):
    digest(report_sha256)
    bounded_report_shape(report)
    for key in ('finite_experiment_criteria_met', 'economics_complete'):
        require(type(report.get(key)) is bool, 'original outcome boolean required')
    native = phases.analyze(report)
    output = []
    for index, (original, derived) in enumerate(zip(report['phases'], native['phases'])):
        epoch = report_sha256 + f'/phases/{index}'
        row = {'mode': original['mode'], 'epoch': epoch,
               'original_outcome': {key: derived.get(key) for key in (
                   'native_phase_criteria_met', 'startup_or_campaign_error',
                   'scheduled_confirmation_rounds', 'observed_confirmation_rounds',
                   'confirmed_rounds', 'unobserved_scheduled_rounds', 'confirmation_rounds')},
               'business': finite_business_observation(original, derived, epoch),
               'phase_process_memory': process_memory_costs(original.get('rss')),
               'phase_process_cpu_ns': optional_number(original.get('whole_parent_phase_cpu_ns')),
               'phase_process_wall_ns': optional_number(original.get('whole_parent_phase_wall_ns')),
               'setup_process_cpu_ns': optional_number(original.get('receiver_and_verifier_setup_cpu_ns')),
               'setup_wall_ns': optional_number(original.get('receiver_and_verifier_setup_wall_ns')),
               'process_scope': 'original phase process; setup and all its threads are nested; '
                                'excludes child processes and unrelated Host work',
               'receiver': None, 'listener': None, 'history': None, 'fixed_parent': None,
               'complete_pipeline_cpu_ns': None, 'physical_network_bytes': None,
               'disk_growth_bytes': None, 'payload_transfer_cpu_ns': None,
               'cold_recovery_cpu_ns': None, 'request_peak_rss_bytes': None}
        if derived['observations_available']:
            row.update(receiver=request_costs(original['receiver_observation'], epoch + '/receiver_observation'),
                       listener=listener_costs(original['service_outcome']),
                       history=history_costs(original['history'], epoch),
                       fixed_parent=host_costs(original.get('phase_process_context')))
        output.append(row)
    return {'schema': SCHEMA, 'source_report_schema': report['schema'],
            'state_backend': report.get('state_backend'),
            'public_resource_policy': report.get('public_resource_policy'),
            'original_finite_experiment_criteria_met': report['finite_experiment_criteria_met'],
            'preparation_process_cpu_ns': optional_number(report['preparation'].get('cpu_ns')),
            'phases': output,
            'scope': {'reader_runs_native_work': False, 'production_qualification': False,
                      'complete_pipeline_cost_measured': False, 'business_tps_capacity': None,
                      'unknown_values_are_zero': False, 'overlapping_cpu_domains_are_added': False,
                      'cross_epoch_timestamps_are_joined': False, 'physical_network_bytes_measured': False,
                      'source_binding': 'caller-pinned report bytes and unchanged retained source receipts; '
                                        'not execution attestation or applicability to later source'}}


def read_coverage(report_path, source_path, source_after_path, *, expected_report_sha256,
                  head, tree, kind='head', base=None, merge=None):
    digest(expected_report_sha256)
    raw = read_bounded(report_path, MAX_REPORT_BYTES)
    require(hashlib.sha256(raw).hexdigest() == expected_report_sha256, 'pinned report SHA256 mismatch')
    before = read_bounded(source_path, 64 * 1024)
    after = read_bounded(source_after_path, 64 * 1024)
    source = strict_json(before)
    source_binding(source, strict_json(after), head=head, tree=tree, kind=kind, base=base, merge=merge)
    result = analyze(strict_json(raw), expected_report_sha256)
    result['source'] = source
    result['input'] = {'report_bytes': len(raw), 'report_sha256': expected_report_sha256,
                       'source_sha256': hashlib.sha256(before).hexdigest(),
                       'source_after_sha256': hashlib.sha256(after).hexdigest()}
    return result


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('report', type=Path)
    parser.add_argument('--report-sha256', required=True)
    parser.add_argument('--source', required=True, type=Path)
    parser.add_argument('--source-after', required=True, type=Path)
    parser.add_argument('--expected-head', required=True)
    parser.add_argument('--expected-tree', required=True)
    parser.add_argument('--kind', choices=('head', 'prospective-merge'), default='head')
    parser.add_argument('--expected-base')
    parser.add_argument('--expected-merge')
    parser.add_argument('--output', required=True, type=Path)
    args = parser.parse_args(argv)
    try:
        result = read_coverage(args.report, args.source, args.source_after,
            expected_report_sha256=args.report_sha256, head=args.expected_head, tree=args.expected_tree,
            kind=args.kind, base=args.expected_base, merge=args.expected_merge)
        with args.output.open('x', encoding='utf-8') as stream:
            json.dump(result, stream, indent=2, sort_keys=True, allow_nan=False)
            stream.write('\n')
    except (OSError, ValueError, KeyError, TypeError, StopIteration, RecursionError) as error:
        print(f'cost coverage refused: {error}', file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    raise SystemExit(main())

4d7f18b7146aad5459b967eab10dc41010e979e6 blob 21038
#!/usr/bin/env python3
"""Fixed artifacts, upstream KATs and adverse encodings for the image audit."""
from __future__ import annotations

import importlib.util
import json
from pathlib import Path
import struct
import tempfile
import unittest


ROOT = Path(__file__).resolve().parents[2]
SPEC = importlib.util.spec_from_file_location('w1_qrom_semantics_audit',
                                            ROOT / 'scripts/w1_qrom_semantics_audit.py')
AUDIT = importlib.util.module_from_spec(SPEC)
SPEC.loader.exec_module(AUDIT)


def small_elf(segments: list[tuple[int, int, bytes]], entry: int = 0x10000) -> bytes:
    """Construct ELF32 fixtures: (address, memory byte count, file content)."""
    blob = bytearray(52 + 32 * len(segments))
    blob[:7] = b'\x7fELF\x01\x01\x01'
    struct.pack_into('<HHIIIIIHHHHHH', blob, 16,
                     2, 243, 1, entry, 52, 0, 0, 52, 32, len(segments), 40, 0, 0)
    for index, (address, memory_bytes, content) in enumerate(segments):
        offset = len(blob)
        blob.extend(content)
        struct.pack_into('<IIIIIIII', blob, 52 + index * 32,
                         1, offset, address, address, len(content), memory_bytes, 5, 4)
    return bytes(blob)


def generated_def(operations: list[str], returned: int) -> str:
    return ('pub const DEF: PolyExtStepDef = PolyExtStepDef { block: &['
            + ''.join('PolyExtStep::' + operation + ',' for operation in operations)
            + f'], ret: {returned}, }};')


class W1SemanticsAuditTests(unittest.TestCase):
    @classmethod
    def setUpClass(cls) -> None:
        cls.helper, cls.engine, cls.provenance, cls.archives = AUDIT.load_sources(ROOT)
        cls.binary = (ROOT / AUDIT.GUEST_PATH).read_bytes()
        cls.report = AUDIT.audit(ROOT)

    def test_fixed_r0bf_reconstructs_exact_v2_image_and_memory_root(self) -> None:
        guest = self.report['guest_binary']
        self.assertEqual(guest['image_id'],
                         '7b8fb87437a9f1c308909d6b8e27655a3190ae04d2b11a2fa12ef111941c0dff')
        self.assertEqual(guest['memory_root'],
                         'eaef1e2d046026053790dd77bdafe629eddf1a12c35190385eebf8417c7ae964')
        self.assertEqual(guest['image_id_words'], list(AUDIT.EXPECTED_IMAGE_WORDS))
        self.assertEqual(guest['memory_tree']['loaded_pages'], 208)
        self.assertEqual(guest['memory_tree']['loaded_words'], 51507)

    def test_r0bf_embedded_kernel_matches_complete_locked_release_archive(self) -> None:
        user, kernel, metadata = AUDIT.split_r0bf(self.binary)
        self.assertEqual((len(user), len(kernel), metadata['user_elf_offset']), (343504, 32392, 32))
        self.assertEqual(kernel, self.archives['risc0-zkos-v1compat-2.2.3']['elfs/v1compat.elf'])
        self.assertEqual(AUDIT.sha256(kernel),
                         '7ffd942e4e8babd771094f549ad080cfea8ecb2c05c986e275c011f41979d921')
        self.assertEqual(len(self.provenance['lock_checks']), 3)

    def test_upstream_memory_known_answers_include_nonzero_kernel_image(self) -> None:
        self.assertEqual(AUDIT.digest_hex(AUDIT.page_digest(self.engine, bytes(1024))),
                         AUDIT.ZERO_PAGE_HEX)
        root, _ = AUDIT.memory_root(self.engine, {})
        self.assertEqual(AUDIT.digest_hex(root), AUDIT.ZERO_MEMORY_HEX)
        root, _ = AUDIT.memory_root(self.engine,
                                   {0x10000: 0x1234b337, 0xffff0210: 0x10000, 0xffff0214: 1})
        self.assertEqual(AUDIT.digest_hex(root), AUDIT.KERNEL_KAT_HEX)

    def test_partial_words_and_bss_follow_little_endian_source_loop(self) -> None:
        entry, words, _ = AUDIT.load_elf(small_elf([(0x10000, 12, b'\x01\x02\x03\x04\x05')]),
                                      AUDIT.KERNEL_START)
        self.assertEqual(entry, 0x10000)
        self.assertEqual(words, {0x10000: 0x04030201, 0x10004: 5, 0x10008: 0})
        # The SDK iterates starts of 4-byte words, rather than truncating a final
        # partial memory word.  This narrower audit models that behavior too.
        _, partial, _ = AUDIT.load_elf(small_elf([(0x10000, 5, b'\x01' * 8)]), AUDIT.KERNEL_START)
        self.assertEqual(partial, {0x10000: 0x01010101, 0x10004: 0x01010101})

    def test_later_segments_and_user_memory_override_in_source_order(self) -> None:
        elf = small_elf([(0x10000, 8, b'\x01' * 8), (0x10004, 4, b'\x02' * 4)])
        entry, words, info = AUDIT.load_elf(elf, AUDIT.KERNEL_START)
        self.assertEqual(words[0x10004], 0x02020202)
        self.assertEqual(info['overwritten_segment_words'], 1)
        memory, merge = AUDIT.initial_memory(entry, words, 0xc0000000,
                                             {0x10000: 99, 0x10004: 88, AUDIT.SUSPEND_MODE: 9})
        self.assertEqual(memory[0x10000], entry)
        self.assertEqual(memory[0x10004], 0x02020202)
        self.assertEqual(memory[AUDIT.SUSPEND_PC], 0xc0000000)
        self.assertEqual(memory[AUDIT.SUSPEND_MODE], 1)
        self.assertEqual(merge['user_overwrites_kernel_addresses'], [0x10000, 0x10004])
        self.assertEqual(self.report['guest_binary']['initial_memory_writes']
                         ['user_overwrites_kernel_word_count'], 69)

    def test_r0bf_rejects_bad_magic_version_header_and_lengths(self) -> None:
        variants = []
        for offset in (0, 4, 8, 12, 20):
            changed = bytearray(self.binary)
            changed[offset] ^= 1
            variants.append(bytes(changed))
        for length in (0, len(self.binary), 0xffffffff):
            changed = bytearray(self.binary)
            struct.pack_into('<I', changed, 28, length)
            variants.append(bytes(changed))
        variants.extend((self.binary[:31], self.binary[32:]))
        for variant in variants:
            with self.subTest(prefix=variant[:32].hex()), self.assertRaises(AUDIT.SemanticsAuditError):
                AUDIT.split_r0bf(variant)

    def test_elf_rejects_wrong_class_endian_machine_and_entry(self) -> None:
        baseline = small_elf([(0x10000, 4, b'\x01\0\0\0')])
        changes = ((4, b'\x02'), (5, b'\x02'), (18, struct.pack('<H', 62)),
                   (16, struct.pack('<H', 3)), (24, struct.pack('<I', 0x10001)),
                   (24, struct.pack('<I', AUDIT.KERNEL_START)))
        for offset, data in changes:
            variant = bytearray(baseline)
            variant[offset:offset + len(data)] = data
            with self.subTest(offset=offset, data=data.hex()), self.assertRaises(AUDIT.SemanticsAuditError):
                AUDIT.load_elf(bytes(variant), AUDIT.KERNEL_START)

    def test_elf_rejects_truncated_tables_segments_and_address_overflow(self) -> None:
        baseline = small_elf([(0x10000, 4, b'\x01\0\0\0')])
        variants = [baseline[:51], baseline[:83], baseline[:-1]]
        for offset, value in ((60, 0xfffffffc), (72, 0xffffffff), (52 + 4, 0xfffffff0)):
            changed = bytearray(baseline)
            struct.pack_into('<I', changed, offset, value)
            variants.append(bytes(changed))
        for variant in variants:
            with self.subTest(variant=variant.hex()), self.assertRaises(AUDIT.SemanticsAuditError):
                AUDIT.load_elf(variant, AUDIT.KERNEL_START)

    def test_elf_resource_limit_rejects_unbounded_memory_expansion(self) -> None:
        huge = small_elf([(0x10000, (AUDIT.MAX_LOAD_WORDS + 1) * 4, b'')])
        with self.assertRaisesRegex(AUDIT.SemanticsAuditError, 'loaded-word limit'):
            AUDIT.load_elf(huge, AUDIT.KERNEL_START)

    def test_nonloaded_elf_byte_changes_file_hash_but_preserves_image_inputs(self) -> None:
        counterexample = self.report['unloaded_elf_byte_counterexample']
        changed = bytearray(self.binary)
        changed[counterexample['composite_byte_offset']] ^= 1
        self.assertNotEqual(AUDIT.sha256(bytes(changed)), AUDIT.GUEST_SHA256)
        user, kernel, _ = AUDIT.split_r0bf(self.binary)
        changed_user, changed_kernel, _ = AUDIT.split_r0bf(bytes(changed))
        self.assertEqual(kernel, changed_kernel)
        self.assertEqual(AUDIT.load_elf(user, AUDIT.KERNEL_START)[:2],
                         AUDIT.load_elf(changed_user, AUDIT.KERNEL_START)[:2])
        with tempfile.TemporaryDirectory() as directory:
            path = Path(directory) / 'modified.bin'
            path.write_bytes(changed)
            with self.assertRaisesRegex(AUDIT.SemanticsAuditError, 'SHA-256 mismatch'):
                AUDIT.read_pinned(Path(directory), 'modified.bin', AUDIT.GUEST_SHA256,
                                  AUDIT.MAX_BINARY_BYTES)

    def test_loaded_instruction_byte_changes_recomputed_image(self) -> None:
        changed = bytearray(self.binary)
        # The fixed first executable user segment begins at composite 32+2048.
        changed[2080] ^= 1
        report = AUDIT.recompute_binary(self.engine, bytes(changed))
        self.assertNotEqual(report['memory_root'], self.report['guest_binary']['memory_root'])
        self.assertNotEqual(report['image_id'], self.report['guest_binary']['image_id'])

    def test_page_word_byte_order_and_child_order_are_observable(self) -> None:
        little = struct.pack('<I', 0x12345678) + bytes(1020)
        big = struct.pack('>I', 0x12345678) + bytes(1020)
        self.assertNotEqual(AUDIT.page_digest(self.engine, little), AUDIT.page_digest(self.engine, big))
        left, right = tuple(range(1, 9)), tuple(range(9, 17))
        self.assertNotEqual(AUDIT.memory_pair(self.engine, left, right),
                            AUDIT.memory_pair(self.engine, right, left))

    def test_memory_pair_rejects_malformed_or_noncanonical_field_words(self) -> None:
        for left in ((0,) * 7, (0,) * 9, (AUDIT.P,) + (0,) * 7,
                     (-1,) + (0,) * 7, (False,) + (0,) * 7):
            with self.subTest(left=left), self.assertRaises(AUDIT.SemanticsAuditError):
                AUDIT.memory_pair(self.engine, left, (0,) * 8)
        for page in (bytes(1023), bytes(1025), bytearray(1024)):
            with self.assertRaises(AUDIT.SemanticsAuditError):
                AUDIT.page_digest(self.engine, page)

    def test_shared_poseidon_input_vector_exposes_missing_independence_premise(self) -> None:
        vector = self.report['shared_poseidon_permutation_vector']
        self.assertEqual(vector['identical_permutation_input_normal_words'],
                         [*range(9, 17), *range(1, 9), *([0] * 8)])
        self.assertEqual(vector['memory_output_normal_digest'],
                         '26aef03c2c56af3901843515515a910cb103766734bc58127459504de4c67974')
        self.assertEqual(vector['control_output_montgomery_digest'],
                         '7d8cfe153d59f01c8708c11a6550303dab80484b5f4cdc603e52106b1cbe8427')
        normalized = tuple(word * self.helper.MONTGOMERY_R_INV % AUDIT.P for word in
                           struct.unpack('<8I', bytes.fromhex(vector['control_output_montgomery_digest'])))
        self.assertEqual(AUDIT.digest_hex(normalized), vector['memory_output_normal_digest'])
        # Treating the serialized normal digests as control-tree raw Montgomery
        # digests produces a different permutation input and result.
        wrong = self.engine.hash_pair(vector['memory_right_normal_digest'],
                                      vector['memory_left_normal_digest'])
        self.assertNotEqual(wrong, vector['control_output_montgomery_digest'])
        self.assertIs(vector['independent_oracle_domains_established'], False)

    def test_complete_crate_archive_tamper_rejected_before_member_reads(self) -> None:
        for name in AUDIT.CRATES:
            data = bytearray((ROOT / AUDIT.EVIDENCE / (name + '.crate')).read_bytes())
            data[len(data) // 2] ^= 1
            with self.subTest(crate=name), self.assertRaisesRegex(AUDIT.SemanticsAuditError,
                                                               'archive checksum mismatch'):
                AUDIT.crate_members(bytes(data), name)

    def test_fixed_generated_air_dag_degree_and_register_counts(self) -> None:
        circuits = self.report['generated_air_degree_audit']['circuits']
        for name, counts in {'recursion': (11130, 1229, 643), 'rv32im': (13736, 6466, 790)}.items():
            with self.subTest(circuit=name):
                result = circuits[name]
                self.assertEqual((result['field_registers'], result['mix_registers'], result['tap_count']), counts)
                self.assertEqual(result['return_tot_trace_degree_upper_bound'], 5)
                self.assertEqual(result['return_mul_trace_degree_upper_bound'], 0)
                self.assertEqual(result['division_or_inverse_operations'], 0)
        consequence = self.report['generated_air_degree_audit']['conditional_univariate_consequence']
        self.assertIs(consequence['actual_trace_divisibility_proved'], False)
        self.assertIs(consequence['deep_fri_rational_quotient_and_denominator_events_covered'], False)

    def test_air_conditional_mix_includes_condition_degree(self) -> None:
        # Returned polynomial is y*x^2, not merely x^2 from the inner constraint.
        source = generated_def(['Get(0)', 'Get(1)', 'Mul(0, 0)', 'True',
                                'AndEqz(0, 2)', 'AndCond(0, 1, 1)'], 2)
        result = AUDIT.analyze_poly_ext(source, 2, (1, 1))
        self.assertEqual(result['return_tot_trace_degree_upper_bound'], 3)
        self.assertEqual(result['maximum_field_register_degree_upper_bound'], 2)

    def test_air_public_and_extension_constants_are_fixed_coefficients(self) -> None:
        source = generated_def(['ConstExt(1, 2, 3, 4)', 'GetGlobal(0, 0)', 'Get(0)',
                                'Mul(0, 2)', 'Mul(3, 1)', 'True', 'AndEqz(0, 4)'], 1)
        result = AUDIT.analyze_poly_ext(source, 1, (1, 1))
        self.assertEqual(result['return_tot_trace_degree_upper_bound'], 1)
        self.assertEqual(result['referenced_global_values'], 1)

    def test_air_bound_responds_to_higher_degree_operation_mutation(self) -> None:
        operations = ['Get(0)', 'Mul(0, 0)', 'Mul(1, 0)', 'True', 'AndEqz(0, 2)']
        self.assertEqual(AUDIT.analyze_poly_ext(generated_def(operations, 1), 1, (1, 1))
                         ['return_tot_trace_degree_upper_bound'], 3)
        operations[2] = 'Mul(1, 1)'
        self.assertEqual(AUDIT.analyze_poly_ext(generated_def(operations, 1), 1, (1, 1))
                         ['return_tot_trace_degree_upper_bound'], 4)

    def test_air_returns_selected_constraint_bound_not_unused_field_maximum(self) -> None:
        operations = ['Get(0)', 'Mul(0, 0)', 'Mul(1, 1)', 'Mul(2, 2)',
                      'True', 'AndEqz(0, 0)']
        result = AUDIT.analyze_poly_ext(generated_def(operations, 1), 1, (1, 1))
        self.assertEqual(result['maximum_field_register_degree_upper_bound'], 8)
        self.assertEqual(result['return_tot_trace_degree_upper_bound'], 1)

    def test_air_unknown_operations_forward_refs_and_wrong_input_banks_rejected(self) -> None:
        bad_programs = [
            (['Get(0)', 'Inv(0)', 'True', 'AndEqz(0, 0)'], 1),
            (['Get(0)', 'Mul(0, 1)', 'True', 'AndEqz(0, 0)'], 1),
            (['Get(1)', 'True', 'AndEqz(0, 0)'], 1),
            (['GetGlobal(2, 0)', 'True', 'AndEqz(0, 0)'], 1),
            (['GetGlobal(0, 1)', 'True', 'AndEqz(0, 0)'], 1),
            (['Get(0)', 'True', 'AndCond(0, 0, 1)'], 1),
            (['Get(0)', 'True', 'AndEqz(0, 0)'], 0),
            (['Get(-1)', 'True', 'AndEqz(0, 0)'], 1),
        ]
        for operations, returned in bad_programs:
            with self.subTest(operations=operations), self.assertRaises(AUDIT.SemanticsAuditError):
                AUDIT.analyze_poly_ext(generated_def(operations, returned), 1, (1, 1))

    def test_reconstruction_does_not_promote_compiler_trace_or_qrom_claims(self) -> None:
        qualification = self.report['qualification']
        closed = {'fixed_composite_binary_to_image_id_independently_recomputed',
                  'embedded_kernel_matches_locked_release_binary',
                  'fixed_generated_constraint_dag_degree_bound_recomputed'}
        self.assertEqual({key for key, value in qualification.items() if value is True}, closed)
        self.assertTrue(all(value is False for key, value in qualification.items() if key not in closed))
        self.assertIs(qualification['valid_code_zero_control_digest_excluded'], False)
        self.assertIs(qualification['fresh_receipt_cryptographically_verified'], False)
        self.assertIs(self.report['kernel_release_match']['kernel_source_to_binary_rebuilt'], False)
        # Both preceding source observations remain frozen. The separately
        # retained Nov14 observation binds the current two-lock correspondence.
        current_path = 'evidence/pon-w1-qrom-semantics-current-20261114/report.json'
        prior_current_path = 'evidence/pon-w1-qrom-semantics-current-20261109/report.json'
        historical_path = 'evidence/pon-w1-qrom-semantics-20261107/report.json'
        current_raw = (ROOT / current_path).read_bytes()
        prior_current_raw = (ROOT / prior_current_path).read_bytes()
        historical_raw = (ROOT / historical_path).read_bytes()
        encoded = (json.dumps(self.report, indent=2, sort_keys=True) + '\n').encode()
        self.assertEqual(AUDIT.sha256(current_raw),
                         '5101f65f58a7bb067654191126fc385780623fb77ff592035bd776777fb8364f')
        self.assertEqual(AUDIT.sha256(prior_current_raw),
                         '129e7b8bc1b6d34ef55acc25bd12cae273bdc65bdeee9649b1b43e214a4e9ebe')
        self.assertEqual(AUDIT.sha256(historical_raw),
                         '66e017dfb3d58206c6372e6ba059ea7991ed7606dcd91e52dd63c73007d0f221')
        self.assertEqual(encoded, current_raw)
        self.assertNotEqual(encoded, prior_current_raw)
        self.assertNotEqual(encoded, historical_raw)
        historical = json.loads(historical_raw)
        self.assertEqual(historical['provenance']['lock_checks'][2]['sha256'],
                         'af7ee60b8f9f95c200d3dddac41b70c037e2bb3395122fe67ab20885140f247f')
        historical['provenance']['lock_checks'][2]['sha256'] = (
            'ed6ea70f20cbe45bf0bdef7f841adbdaa7c3b2a9838ffdfed64fa88f129b707a')
        # Preserve the preceding one-lock observation under its original SHA.
        self.assertEqual(historical, json.loads(prior_current_raw))
        self.assertEqual(historical['provenance']['lock_checks'][0]['path'],
                         'formal/pon-nakamoto-v1/w1_v2_verifier/Cargo.lock')
        self.assertEqual(historical['provenance']['lock_checks'][0]['sha256'],
                         '9756a0d8cb88c4f0e67f722dad933d30dcbe93d5bb2b6ca2be15f23fd0a3f2ef')
        historical['provenance']['lock_checks'][0]['sha256'] = (
            '93a68edce98e5c61e0cba33ebfbe392ff52df24633347da5a214ac8eb6eae24b')
        # Compare all JSON values; the audit's in-memory structures include tuples.
        self.assertEqual(historical, json.loads(encoded))
        prior_current = json.loads(prior_current_raw)
        self.assertEqual(prior_current['provenance']['lock_checks'][0]['sha256'],
                         '9756a0d8cb88c4f0e67f722dad933d30dcbe93d5bb2b6ca2be15f23fd0a3f2ef')
        prior_current['provenance']['lock_checks'][0]['sha256'] = (
            '93a68edce98e5c61e0cba33ebfbe392ff52df24633347da5a214ac8eb6eae24b')
        self.assertEqual((json.dumps(prior_current, indent=2, sort_keys=True) + '\n').encode(),
                         encoded)
        workflow = (ROOT / '.github/workflows/pon-w1-qrom-closure.yml').read_text()
        # The two explicitly different source jobs have different consumers.
        # Keep the historical byte comparison in its fixed checkout; the current
        # job must call the independently pinned correspondence reader.
        self.assertEqual(workflow.count('  closure-historical:\n'), 1)
        self.assertEqual(workflow.count('  closure:\n'), 1)
        historical_job, current_job = workflow.split(
            '  closure-historical:\n', 1)[1].split('  closure:\n', 1)
        fixed_source = '1a14f7d4826363daefac9ec10131c66d7e70ece7'
        self.assertIn('EXPECTED_SOURCE: ' + fixed_source, historical_job)
        self.assertIn('EXPECTED_HEAD: ' + fixed_source, historical_job)
        historical_command = 'cmp ' + historical_path + ' "$W1_CLOSURE_OUT/semantics.json"'
        self.assertEqual(historical_job.count('          ' + historical_command + '\n'), 1)
        current_command = (
            'python3 scripts/ci/w1_qrom_closure_current_controls.py check-semantics '
            '--output "$W1_CLOSURE_OUT/semantics.json" '
            '> "$W1_CLOSURE_OUT/semantics-correspondence.json"')
        self.assertEqual(current_job.count('          ' + current_command + '\n'), 1)
        self.assertNotIn(historical_command, current_job)
        self.assertNotIn('cmp ' + current_path, current_job)
        self.assertNotIn('cmp ' + prior_current_path, current_job)
        self.assertNotIn(current_command, historical_job)


if __name__ == '__main__':
    unittest.main()

