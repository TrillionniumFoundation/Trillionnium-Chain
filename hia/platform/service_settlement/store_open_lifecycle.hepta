  zero_pd:u64 = const() {"value":0}
  done_pd:u64 = const() {"value":4}
  child_pd:u64 = call(pdm,zero_pd) {"function":"cp_get"}
  finished_pd:bool = compare.eq(child_pd,done_pd)
  branch finished_pd path_failed(pdm,pdc) refused()
block refused()
  denied:u32 = const() {"value":100}
  ret(denied)
end

fn sol_end(m:mutbuf,status:u32) -> (u32) effects(read,write,trap) entry(entry)
block entry(m:mutbuf,status:u32)
  terminal:u64 = const() {"value":7}
  no_op:u64 = const() {"value":0}
  result:u32 = call(m,terminal,no_op,status) {"function":"sol_yield"}
  ret(result)
end

fn sol_yield(m:mutbuf,stage:u64,op:u64,status:u32) -> (u32) effects(read,write,trap) entry(entry)
block entry(m:mutbuf,stage:u64,op:u64,status:u32)
  stage_at:u64 = const() {"value":4400}
  op_at:u64 = const() {"value":4416}
  stored_stage:u64 = call(m,stage_at,stage) {"function":"cp_put"}
  stored_op:u64 = call(m,op_at,op) {"function":"cp_put"}
  ret(status)
end
