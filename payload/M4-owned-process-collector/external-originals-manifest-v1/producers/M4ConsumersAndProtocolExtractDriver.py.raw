import pathlib,subprocess,json,hashlib,datetime,os,re
G="/private/tmp/chain-audit-recovery-records-20261113/full-history-independent-v1/complete.git"
H="1a7afcdb820b051d1e4bfde3d436f96fc050c487"
O=pathlib.Path("/private/tmp/chain-M4-owned-process-collector-review-20261114-v1")
env=dict(os.environ,GIT_NO_LAZY_FETCH="1",GIT_OPTIONAL_LOCKS="0",GIT_NO_REPLACE_OBJECTS="1")
cmd=["/usr/bin/git","--no-replace-objects","--git-dir="+G,"grep","-n","-F","w1_owned_process_collector_v1",H,"--","scripts",".github"]
p=subprocess.run(cmd,env=env,stdout=subprocess.PIPE,stderr=subprocess.PIPE,timeout=60)
assert p.returncode in (0,1)
raw=p.stdout
assert len(raw)<262144
(O/"direct-consumers-git-grep.stdout").write_bytes(raw)
out={"head":H,"argv":cmd,"returncode":p.returncode,"bytes":len(raw),"sha256":hashlib.sha256(raw).hexdigest(),"lines":raw.decode().splitlines()}
(O/"direct-consumer-index.json").write_text(json.dumps(out,indent=2)+"\n")
print(json.dumps(out))
D=pathlib.Path("/private/tmp/chain-C0-prospective-protocol-job132376957499-original-20261114-v1")
r=(D/"job-132376957499.stdout.raw").read_bytes()
assert hashlib.sha256(r).hexdigest()=="50b3b4fab0cb804210065d6bd748b6c3d9d63ff0127c67a4f55d33db74a81461"
lines=r.decode().splitlines()
patterns=re.compile(r"CONFIRMATION_TARGET|FAILED|Traceback|panicked at|timed out|timeout|failure_type|AssertionError|##\[error\]|Error:")
found=[]
for i,line in enumerate(lines,1):
 if patterns.search(line):
  if len(line)>3500:
   m=re.search(r"(\{.*\})",line)
   if m:
    try:
     q=json.loads(m.group(1));found.append({"line":i,"timestamp":line.split(" ",1)[0],"json_keys":list(q),"compact":{k:q[k] for k in ("name","exit_code","passed","failure","error","failure_type","timed_out","systemd_run_exit","source","schema","final_host_errors") if k in q}})
     continue
    except Exception:pass
  found.append({"line":i,"text":line[:3500]})
res={"schema":"trnm-C0-prospective-protocol-original-log-static-extract-v1","source":{"path":str(D/"job-132376957499.stdout.raw"),"bytes":len(r),"sha256":hashlib.sha256(r).hexdigest()},"total_lines":len(lines),"matches":found}
(D/"failure-line-extract.json").write_text(json.dumps(res,indent=2)+"\n")
print(json.dumps(res))