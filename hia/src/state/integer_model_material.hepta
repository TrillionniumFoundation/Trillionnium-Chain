fn f0(input:readbuf,output:mutbuf,scratch:mutbuf) -> (u32) effects(read,write,trap) entry(entry)
block entry(input:readbuf,output:mutbuf,scratch:mutbuf)
  extent:usize = buffer.len(input)
  prefix:usize = const() {"value":40}
  enough:bool = compare.ge(extent,prefix)
  branch enough framing(input,output,extent) malformed()
block framing(fi:readbuf,fo:mutbuf,fn_:usize)
  zero_f:u64 = const() {"value":0}
  one_f:u64 = const() {"value":1}
  two_f:u64 = const() {"value":2}
  four_f:u64 = const() {"value":4}
  magic:u64 = call(fi,zero_f,four_f) {"function":"rac_read_le"}
  expected:u64 = const() {"value":826559817}
  valid_magic:bool = compare.eq(magic,expected)
  old:u64 = call(fi,four_f,one_f) {"function":"rac_read_le"}
  after_at:u64 = const() {"value":5}
  newer:u64 = call(fi,after_at,one_f) {"function":"rac_read_le"}
  ten:u64 = const() {"value":10}
  size_o:bool = compare.le(old,ten)
  size_n:bool = compare.le(newer,ten)
  reserved_at:u64 = const() {"value":6}
  reserved:u64 = call(fi,reserved_at,two_f) {"function":"rac_read_le"}
  reserved_ok:bool = compare.eq(reserved,zero_f)
  n:u64 = int.add.wrap(old,newer)
  stop:u64 = call(n) {"function":"imd_row"}
  got:u64 = int.cast(fn_) {"mode":"wrap"}
  complete:bool = compare.eq(got,stop)
  a:bool = bool.and(valid_magic,reserved_ok)
  b:bool = bool.and(size_o,size_n)
  c:bool = bool.and(a,b)
  valid:bool = bool.and(c,complete)
  branch valid namespaces(fi,fo,old,newer,n) malformed()
block namespaces(ni:readbuf,no:mutbuf,old_n:u64,new_n:u64,total:u64)
  zero:u64 = const() {"value":0}
  has_old:bool = compare.ne(old_n,zero)
  evolution:bool = compare.ne(new_n,zero)
  both:bool = bool.and(has_old,evolution)
  branch both collision() ordered(ni,no,total,evolution)
block ordered(oi:readbuf,oo:mutbuf,on:u64,ov:bool)
  sorted:bool = call(oi,on) {"function":"imd_sorted"}
  branch sorted metadata(oi,oo,on,ov) malformed()
block metadata(mi:readbuf,mo:mutbuf,mn:u64,mv:bool)
  meta_key:u64 = const() {"value":1635018093}
  at:u64 = call(mi,mn,meta_key) {"function":"imd_find"}
  empty_meta:u64 = const() {"value":0}
  present:bool = compare.ne(at,empty_meta)
  branch present validate(mi,mo,mn,mv,at) missing()
block validate(vi:readbuf,vo:mutbuf,vn:u64,vv:bool,va:u64)
  rows_expected:u64 = const() {"value":9}
  rows:bool = compare.eq(vn,rows_expected)
  valid_meta:bool = call(vi,va,vv) {"function":"imd_meta"}
  valid_all:bool = bool.and(rows,valid_meta)
  branch valid_all chunks(vi,vo,vn,vv) bad_meta()
block chunks(ci:readbuf,co:mutbuf,cn:u64,cv:bool)
  v2_tail:u64 = const() {"value":588}
  v3_tail:u64 = const() {"value":590}
  tail:u64 = select(cv,v3_tail,v2_tail)
  total_valid:bool = call(ci,cn,tail) {"function":"imd_chunks"}
  branch total_valid room(ci,co,cn,tail) bad_chunk()
block room(ri:readbuf,ro:mutbuf,rn:u64,rt:u64)
  initial:u64 = const() {"value":7168}
  result_extent:u64 = int.add.wrap(initial,rt)
  need:usize = int.cast(result_extent) {"mode":"wrap"}
  avail:usize = buffer.len(ro)
  capacity_ok:bool = compare.ge(avail,need)
  branch capacity_ok write(ri,ro,rn,rt) capacity()
block write(wi:readbuf,wo:mutbuf,wn:u64,wt:u64)
  _out:u64 = call(wi,wo,wn,wt) {"function":"imd_emit"}
  success:u32 = const() {"value":0}
  ret(success)
block collision()
  collision_code:u32 = const() {"value":1}
  ret(collision_code)
block missing()
  missing_code:u32 = const() {"value":2}
  ret(missing_code)
block bad_meta()
  metadata_code:u32 = const() {"value":3}
  ret(metadata_code)
block bad_chunk()
  chunk_code:u32 = const() {"value":4}
  ret(chunk_code)
block malformed()
  local_frame:u32 = const() {"value":100}
  ret(local_frame)
block capacity()
  insufficient:u32 = const() {"value":102}
  ret(insufficient)
end

fn imd_row(index:u64) -> (u64) effects() entry(entry)
block entry(index:u64)
  stride:u64 = const() {"value":2064}
  before:u64 = const() {"value":40}
  pos:u64 = int.mul.wrap(index,stride)
  row:u64 = int.add.wrap(pos,before)
  ret(row)
end

fn imd_sorted(input:readbuf,count:u64) -> (bool) effects(read,trap) entry(entry)
block entry(input:readbuf,count:u64)
  idx:u64 = const() {"value":1}
  active:bool = compare.gt(count,idx)
  branch active each(input,count,idx) yes()
block each(ei:readbuf,en:u64,ex:u64)
  size:u64 = const() {"value":8}
  one:u64 = const() {"value":1}
  prior:u64 = int.sub.wrap(ex,one)
  prev:u64 = call(prior) {"function":"imd_row"}
  now:u64 = call(ex) {"function":"imd_row"}
  order:u64 = call(ei,prev,now,size,size) {"function":"sb_compare"}
  zero:u64 = const() {"value":0}
  asc:bool = compare.eq(order,zero)
  next:u64 = int.add.wrap(ex,one)
  done:bool = compare.eq(next,en)
  branch asc advance(ei,en,next,done) no()
block advance(ai:readbuf,an:u64,ax:u64,ad:bool)
  branch ad yes() each(ai,an,ax)
block yes()
  good:bool = const() {"value":true}
  ret(good)
block no()
  bad:bool = const() {"value":false}
  ret(bad)
end

fn imd_find(input:readbuf,count:u64,key:u64) -> (u64) effects(read,trap) entry(entry)
block entry(input:readbuf,count:u64,key:u64)
  zero:u64 = const() {"value":0}
  jump scan(input,count,key,zero)
block scan(si:readbuf,sn:u64,sk:u64,sx:u64)
  end:bool = compare.eq(sx,sn)
  branch end no() row(si,sn,sk,sx)
block row(ri:readbuf,rn:u64,rk:u64,rx:u64)
  a:u64 = call(rx) {"function":"imd_row"}
  eight:u64 = const() {"value":8}
  stored:u64 = call(ri,a,eight) {"function":"rac_read_le"}
  matches:bool = compare.eq(stored,rk)
  one:u64 = const() {"value":1}
  ns:u64 = int.add.wrap(rx,one)
  branch matches yes(a) scan(ri,rn,rk,ns)
block yes(at:u64)
  ret(at)
block no()
  absent:u64 = const() {"value":0}
  ret(absent)
end

fn imd_meta(input:readbuf,row:u64,modern:bool) -> (bool) effects(read,trap) entry(entry)
block entry(input:readbuf,row:u64,modern:bool)
  eight:u64 = const() {"value":8}
