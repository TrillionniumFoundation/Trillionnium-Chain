+        entries = manifest["files"]
+        require(isinstance(entries, list) and len(entries) <= 256,
+                "closed-log manifest roster exceeds bound")
+        pins, names = [], set()
+        for row in entries:
+            require(isinstance(row, dict) and set(row) == {"path", "bytes", "sha256"},
+                    "closed-log pin fields differ")
+            relative = row["path"]
