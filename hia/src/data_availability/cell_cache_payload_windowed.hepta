block active(xr:readbuf,xo:mutbuf,xw:mutbuf,xn:u64,xop:u64)
  phase_at_x:u64 = const() {"value":1216}
  flag_x:u64 = call(xw,phase_at_x) {"function":"tr_get"}
  one_x:u64 = const() {"value":1}
  two_x:u64 = const() {"value":2}
  feed_x:bool = compare.eq(xop,one_x)
  final_x:bool = compare.eq(xop,two_x)
