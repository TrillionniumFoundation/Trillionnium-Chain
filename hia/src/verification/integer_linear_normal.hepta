  shift_2:u64 = const() {"value":16}
  part_2:u64 = int.shl.checked(byte_2,shift_2)
  stride_3:usize = const() {"value":3}
  offset_3:usize = int.add.wrap(offset,stride_3)
  raw_3:u8 = buffer.load(input,offset_3)
  byte_3:u64 = int.cast(raw_3) {"mode":"wrap"}
  shift_3:u64 = const() {"value":24}
  part_3:u64 = int.shl.checked(byte_3,shift_3)
  low:u64 = bit.or(byte_0,part_1)
  hi:u64 = bit.or(part_2,part_3)
  word:u64 = bit.or(low,hi)
  ret(word)
end

fn iln_abs(value:u64, negative:bool) -> (u64) effects() entry(entry)
block entry(value:u64, negative:bool)
  mod32:u64 = const() {"value":4294967296}
  magnitude:u64 = int.sub.wrap(mod32,value)
  chosen:u64 = select(negative,magnitude,value)
  ret(chosen)
end

fn iln_divisor(value:u64) -> (u64) effects() entry(entry)
block entry(value:u64)
  one:u64 = const() {"value":1}
  ten:u64 = const() {"value":10}
  hundred:u64 = const() {"value":100}
  thousand:u64 = const() {"value":1000}
  large:u64 = const() {"value":10000}
  at_least_ten:bool = compare.ge(value,ten)
  at_least_hundred:bool = compare.ge(value,hundred)
  at_least_thousand:bool = compare.ge(value,thousand)
  at_least_large:bool = compare.ge(value,large)
  d2:u64 = select(at_least_ten,ten,one)
  d3:u64 = select(at_least_hundred,hundred,d2)
  d4:u64 = select(at_least_thousand,thousand,d3)
  d5:u64 = select(at_least_large,large,d4)
  ret(d5)
end

fn iln_digits(divisor:u64) -> (u64) effects(trap) entry(entry)
block entry(divisor:u64)
  one:u64 = const() {"value":1}
  ten:u64 = const() {"value":10}
  jump loop(divisor,one,one,ten)
block loop(ld:u64,ln:u64,lone:u64,lten:u64)
  more:bool = compare.gt(ld,lone)
  branch more reduce(ld,ln,lone,lten) done(ln)
block reduce(rd:u64,rn:u64,rone:u64,rten:u64)
  part:u64 = int.div.checked(rd,rten)
  inc:u64 = int.add.wrap(rn,rone)
  jump loop(part,inc,rone,rten)
block done(count:u64)
  ret(count)
end

