summary={"schema":"trnm-M4-source-static-validation-v1","observed_at":datetime.datetime.now(datetime.timezone.utc).isoformat(),"base":H,"worktree":str(W),"project_preflight":{"returncode":0,"python_path_prefix":"/opt/homebrew/bin"},"python_compile":{"mode":"compile(raw,filename,exec,dont_inherit=True,optimize=0)","files":2,"passed":True,"module_imported":False},"original14_preserved":True,"new_controls":2,"linux_suite_executed":False,"linux_suite_pending_coordinator":True,"full_lane_passed":False,"source_files":source_rows,"patch":{"path":str(O/"source-and-tests.patch"),"bytes":len(patch),"sha256":hashlib.sha256(patch).hexdigest()}}
