fn cr_records(i:readbuf,o:mutbuf,count:u64,p:u64,d:u64,t:u64,m0:u64,m1:u64,m2:u64) -> (u64,u64,u64) effects(read,write,trap) entry(entry)
block entry(i:readbuf,o:mutbuf,count:u64,p:u64,d:u64,t:u64,m0:u64,m1:u64,m2:u64)
  jump loop(i,o,count,p,d,t,m0,m1,m2)
