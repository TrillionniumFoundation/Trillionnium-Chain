hia-asm.v1 hepta.hia.program.v8 trnm_checkpoint_tile_checkpoint_extract
fn f0(r:readbuf,o:mutbuf,w:mutbuf) -> (u32) effects(read,write,trap) entry(entry)
block entry(r:readbuf,o:mutbuf,w:mutbuf)
  len_r:usize = buffer.len(r)
  n:u64 = int.cast(len_r) {"mode":"wrap"}
  min:u64 = const() {"value":48}
  max:u64 = const() {"value":1048576}
  lo:bool = compare.le(min,n)
  hi:bool = compare.le(n,max)
  have:bool = bool.and(lo,hi)
  branch have wire_check(r,o,w,n) frame()
block wire_check(er:readbuf,eo:mutbuf,ew:mutbuf,en:u64)
  zero_e:u64 = const() {"value":0}
  magic:u64 = call(er,zero_e) {"function":"tr_read"}
  expected:u64 = const() {"value":826622804}
  is_frame:bool = compare.eq(magic,expected)
  branch is_frame capacity(er,eo,ew,en) frame()
block capacity(cr:readbuf,co:mutbuf,cw:mutbuf,cn:u64)
  out_len:usize = buffer.len(co)
  scratch_len:usize = buffer.len(cw)
  tile_need:usize = const() {"value":8192}
  scratch_need:usize = const() {"value":18000}
  room1:bool = compare.le(tile_need,out_len)
  room2:bool = compare.le(scratch_need,scratch_len)
  good:bool = bool.and(room1,room2)
  branch good size(cr,co,cw,cn) short()
block size(sr:readbuf,so:mutbuf,sw:mutbuf,sn:u64)
  size_at:u64 = const() {"value":40}
  expected_n:u64 = call(sr,size_at) {"function":"tr_read"}
  raw_start:u64 = const() {"value":48}
  actual_n:u64 = int.sub.wrap(sn,raw_start)
  exact:bool = compare.eq(expected_n,actual_n)
  branch exact prefix(sr,so,sw,sn,actual_n) size_error()
block prefix(pr:readbuf,po:mutbuf,pw:mutbuf,pn:u64,ps:u64)
  eight:u64 = const() {"value":8}
  have_prefix:bool = compare.le(eight,ps)
  branch have_prefix range(pr,po,pw,pn,ps) prefix_error()
block range(rr:readbuf,ro:mutbuf,rw:mutbuf,rn:u64,rs:u64)
  raw_at:u64 = const() {"value":48}
  header_bytes:u64 = call(rr,raw_at) {"function":"tr_read"}
  start:u64 = const() {"value":56}
  avail:u64 = int.sub.wrap(rn,start)
  two:u64 = const() {"value":2}
  ceiling:u64 = const() {"value":16777216}
  low:bool = compare.le(two,header_bytes)
  high:bool = compare.le(header_bytes,ceiling)
  inside:bool = compare.le(header_bytes,avail)
  bounds:bool = bool.and(low,high)
  okay:bool = bool.and(bounds,inside)
  end_header:u64 = int.add.wrap(start,header_bytes)
  payload:u64 = int.sub.wrap(avail,header_bytes)
  branch okay header(rr,ro,rw,rs,start,end_header,payload) header_error()
block header(hr:readbuf,ho:mutbuf,hw:mutbuf,hs:u64,hb:u64,he:u64,hp:u64)
  status:u32,count:u64,slot:u64 = call(hr,hw,he,hb,hp) {"function":"th_header_private"}
  zero_h:u32 = const() {"value":0}
  proved:bool = compare.eq(status,zero_h)
  branch proved digest(hr,ho,hw,hs,he,slot) refusal(status)
block digest(dr:readbuf,do_:mutbuf,dw:mutbuf,ds:u64,de:u64,dt:u64)
  start_d:u64 = const() {"value":48}
  init:u64 = call(dw) {"function":"tr_sha_init"}
  feed:u64 = call(dr,start_d,ds,dw) {"function":"tr_sha_update"}
  final:u64 = call(dw) {"function":"tr_sha_final"}
  two_d:u64 = bit.or(init,feed)
  all_d:u64 = bit.or(two_d,final)
  zero_d:u64 = const() {"value":0}
  good_digest:bool = compare.eq(all_d,zero_d)
  branch good_digest pin(dr,do_,dw,de,dt) sha_error()
block pin(ar:readbuf,ao:mutbuf,aw:mutbuf,ae:u64,at:u64)
  matches:bool = call(ar,aw) {"function":"tar_pin"}
  branch matches tile(ar,ao,aw,ae,at) pin_error()
block tile(tr:readbuf,to:mutbuf,tw:mutbuf,te:u64,tt:u64)
  offset:u64 = call(tw,tt) {"function":"tr_get"}
  p:u64 = int.add.wrap(te,offset)
  result:u32 = call(tr,to,p) {"function":"tce_copy"}
  ret(result)
block frame()
  bad_frame:u32 = const() {"value":100}
  ret(bad_frame)
block short()
  short_space:u32 = const() {"value":102}
  ret(short_space)
block size_error()
  wrong_size:u32 = const() {"value":1}
  ret(wrong_size)
block prefix_error()
  bad_read:u32 = const() {"value":12}
  ret(bad_read)
block header_error()
  wrong_header:u32 = const() {"value":13}
  ret(wrong_header)
block pin_error()
  wrong_pin:u32 = const() {"value":14}
  ret(wrong_pin)
block sha_error()
  failed_sha:u32 = const() {"value":104}
  ret(failed_sha)
block refusal(c:u32)
  ret(c)
end

fn tce_copy(r:readbuf,o:mutbuf,p:u64) -> (u32) effects(read,write,trap) entry(entry)
block entry(r:readbuf,o:mutbuf,p:u64)
  row0:u64 = const() {"value":0}
  jump loop(r,o,p,row0,row0)
block loop(lr:readbuf,lo:mutbuf,lp:u64,ld:u64,lk:u64)
  total:u64 = const() {"value":64}
  complete:bool = compare.eq(lk,total)
  branch complete done() row(lr,lo,lp,ld,lk)
block row(ar:readbuf,ao:mutbuf,ap:u64,ad:u64,ak:u64)
  src:usize = int.cast(ap) {"mode":"wrap"}
  dst:usize = int.cast(ad) {"mode":"wrap"}
  byte_count:usize = const() {"value":128}
  _ = buffer.copy_range(ao,ar,dst,src,byte_count)
  input_stride:u64 = const() {"value":1152}
  output_stride:u64 = const() {"value":128}
  next_p:u64 = int.add.wrap(ap,input_stride)
  next_d:u64 = int.add.wrap(ad,output_stride)
  one:u64 = const() {"value":1}
  next_k:u64 = int.add.wrap(ak,one)
  jump loop(ar,ao,next_p,next_d,next_k)
block done()
  status:u32 = const() {"value":0}
  ret(status)
end
