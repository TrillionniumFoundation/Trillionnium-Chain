fn bc_end(i:readbuf,p:u64,n:u64) -> (u64) effects(read,trap) entry(entry)
block entry(i:readbuf,p:u64,n:u64)
  jump loop(i,p,n)
block loop(li:readbuf,lp:u64,ln:u64)
  has:bool = compare.lt(lp,ln)
  branch has read(li,lp,ln) done(lp)
block read(r_i:readbuf,r_p:u64,r_n:u64)
  at:usize = int.cast(r_p) {"mode":"wrap"}
  raw:u8 = buffer.load(r_i,at)
  zero:u8 = const() {"value":0}
  closed:bool = compare.eq(raw,zero)
  one:u64 = const() {"value":1}
  next:u64 = int.add.wrap(r_p,one)
  branch closed done(r_p) loop(r_i,next,r_n)
block done(result:u64)
  ret(result)
end

fn bc_equal(i:readbuf,p:u64,n:u64) -> (u64) effects(read,trap) entry(entry)
block entry(i:readbuf,p:u64,n:u64)
  jump loop(i,p,n)
block loop(li:readbuf,lp:u64,ln:u64)
  has:bool = compare.lt(lp,ln)
  branch has read(li,lp,ln) done(lp)
block read(r_i:readbuf,r_p:u64,r_n:u64)
  at:usize = int.cast(r_p) {"mode":"wrap"}
  raw:u8 = buffer.load(r_i,at)
  equal:u8 = const() {"value":61}
  stop:bool = compare.eq(raw,equal)
  one:u64 = const() {"value":1}
  next:u64 = int.add.wrap(r_p,one)
  branch stop done(r_p) loop(r_i,next,r_n)
block done(result:u64)
  ret(result)
end
fn bc_tail(i_entry:readbuf,p_entry:u64,n_entry:u64) -> (u64) effects(read,trap) entry(entry)
block entry(i_entry:readbuf,p_entry:u64,n_entry:u64)
  zero_entry:u64 = const() {"value":0}
  jump piece(i_entry,p_entry,n_entry,zero_entry,zero_entry)
block piece(i_piece:readbuf,p_piece:u64,n_piece:u64,shift_piece:u64,result_piece:u64)
  zero_piece:u64 = const() {"value":0}
  done_piece:bool = compare.eq(n_piece,zero_piece)
  branch done_piece finish(result_piece) octet(i_piece,p_piece,n_piece,shift_piece,result_piece)
block octet(i_octet:readbuf,p_octet:u64,n_octet:u64,shift_octet:u64,result_octet:u64)
  at_octet:usize = int.cast(p_octet) {"mode":"wrap"}
  c_octet:u8 = buffer.load(i_octet,at_octet)
  word_octet:u64 = int.cast(c_octet) {"mode":"wrap"}
  moved_octet:u64 = int.shl.checked(word_octet,shift_octet)
  combined_octet:u64 = bit.or(result_octet,moved_octet)
  one_octet:u64 = const() {"value":1}
  eight_octet:u64 = const() {"value":8}
  next_octet:u64 = int.add.wrap(p_octet,one_octet)
  remain_octet:u64 = int.sub.wrap(n_octet,one_octet)
  new_shift_octet:u64 = int.add.wrap(shift_octet,eight_octet)
  jump piece(i_octet,next_octet,remain_octet,new_shift_octet,combined_octet)
block finish(result_finish:u64)
  ret(result_finish)
end

