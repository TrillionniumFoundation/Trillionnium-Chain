  next_hits:u64 = int.add.wrap(rhits,record_one)
  following:u64 = call(rs,rout,rrow,record_four,record_yes) {"function":"wa_word"}
  jump advance(rs,rmap,rcount,record_pending,rkey,rheader,following,rrow,next_hits)
block advance(vs:mutbuf,vmap:u64,vcount:u64,vmask:u64,vkey:u64,vheader:u64,vout:u64,vrow:u64,vhits:u64)
  advance_one:u64 = const() {"value":1}
  next_row:u64 = int.add.wrap(vrow,advance_one)
  jump scan(vs,vmap,vcount,vmask,vkey,vheader,vout,next_row,vhits)
block finish(fs:mutbuf,fheader:u64,fout:u64,fhits:u64,fmask:u64)
  finish_four:u64 = const() {"value":4}
  finish_yes:bool = const() {"value":true}
  header_done:u64 = call(fs,fheader,fhits,finish_four,finish_yes) {"function":"wa_word"}
  ret(fout,fmask)
end
