name: PoN four-axis throughput evidence controls
on:
  pull_request:
    paths:
      - .github/workflows/pon-throughput-evidence.yml
      - formal/throughput-v1/**
      - formal/pon-native-fullpath-v1/**
      - scripts/run_smollm_cell_replica_research.py
      - scripts/ci/test_smollm_command_receipts.py
      - scripts/pon_public_v3_phase_read.py
      - scripts/ci/test_pon_public_v3_phase_read.py
      - scripts/ci/prepare_pq_provider.sh
      - trillionnium/crates/trnm-mvcc-fee/**
      - trillionnium/crates/trnm-pon-node/src/ingress/public_v3/**
      - trillionnium/crates/trnm-pon-node/src/ingress/public_v3.rs
      - trillionnium/crates/trnm-pon-node/src/peer_polling.rs
      - evidence/pon-throughput-engineering-20261108/**
      - evidence/pon-throughput-business-20261109/**
      - evidence/pon-throughput-20261108/**
      - config/pon/pq-cross-branch-corpus-v1.json
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: throughput-evidence-${{ github.ref }}
  cancel-in-progress: false
env:
  PYTHONDONTWRITEBYTECODE: "1"
  TRNM_EXPECTED_SOURCE_SHA: ${{ github.event_name == 'pull_request' && github.event.pull_request.head.sha || github.sha }}
jobs:
  evidence-controls:
    runs-on: ubuntu-24.04
    timeout-minutes: 20
    steps:
      - name: Checkout exact candidate
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ env.TRNM_EXPECTED_SOURCE_SHA }}
          fetch-depth: 0
          persist-credentials: false
      - name: Check original boundary and exact raw source
        run: |
          set -euo pipefail
          bash scripts/project-preflight.sh --audit
          python3 scripts/ci/verify_ci_source.py --kind head --expected-head "$TRNM_EXPECTED_SOURCE_SHA" --output "$RUNNER_TEMP/throughput-evidence/source-before.json"
      - name: Verify failure denominators and native confirmation distinctions
        run: |
          set -euo pipefail
          test -f formal/pon-native-fullpath-v1/test_transaction_throughput.py
          python3 -m unittest discover -s formal/pon-native-fullpath-v1 -p 'test_*.py' -v
          python3 formal/throughput-v1/test_proof_cpu_metrics.py -v
          python3 formal/throughput-v1/test_cell_model_metrics.py -v
          python3 formal/throughput-v1/test_useful_task_metrics.py -v
          python3 formal/throughput-v1/test_whole_block_cost_metrics.py -v
          python3 formal/throughput-v1/test_component_observations.py -v
          python3 formal/throughput-v1/test_reproduce_reports.py -v
          python3 formal/throughput-v1/test_execution_report.py -v
          python3 formal/throughput-v1/test_sqlite_syscall_profile.py -v
          python3 scripts/ci/test_pon_public_v3_phase_read.py -v
          python3 scripts/ci/test_smollm_command_receipts.py -v
      - name: Reproduce original records without granting throughput qualification
        run: python3 formal/throughput-v1/reproduce_reports.py --output "$RUNNER_TEMP/throughput-evidence/reproduced"
      - name: Verify unchanged source guards and original resource controls
        run: |
          set -euo pipefail
          python3 scripts/ci/check_pq_research_integration.py
          python3 scripts/refresh_distributed_source_inventory.py --check
          python3 scripts/ci/check_ci_contract.py
          python3 scripts/ci/check_repository.py
          python3 -m unittest discover -s scripts/ci -p test_ci_source_integrity.py -v
          python3 -m unittest discover -s scripts/ci -p test_from_zero_host_ci.py -v
      - name: Verify exact raw source after execution
        if: always()
        run: python3 scripts/ci/verify_ci_source.py --kind head --expected-head "$TRNM_EXPECTED_SOURCE_SHA" --output "$RUNNER_TEMP/throughput-evidence/source-after.json"
      - name: Retain reproduction and source evidence
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: throughput-evidence-${{ env.TRNM_EXPECTED_SOURCE_SHA }}-${{ github.run_attempt }}
          path: ${{ runner.temp }}/throughput-evidence/
          if-no-files-found: error
          retention-days: 30
  native-components:
    name: Native component observations (not business TPS)
    runs-on: ubuntu-24.04
    timeout-minutes: 45
    env:
      CARGO_BUILD_JOBS: "1"
      CARGO_INCREMENTAL: "0"
    steps:
      - name: Checkout exact candidate
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ env.TRNM_EXPECTED_SOURCE_SHA }}
          fetch-depth: 0
          persist-credentials: false
      - name: Bind source and allocate separate component paths
        shell: bash
        run: |
          set -euo pipefail
          bash scripts/project-preflight.sh --audit
          printf 'CARGO_TARGET_DIR=%s/throughput-component-target\n' "$RUNNER_TEMP" >> "$GITHUB_ENV"
          printf 'TRNM_COMPONENT_RECEIPTS=%s/throughput-component-receipts\n' "$RUNNER_TEMP" >> "$GITHUB_ENV"
          mkdir "$RUNNER_TEMP/throughput-component-receipts"
          python3 scripts/ci/verify_ci_source.py --kind head --expected-head "$TRNM_EXPECTED_SOURCE_SHA" --output "$RUNNER_TEMP/throughput-component-receipts/source-before.json"
      - name: Install the pinned compiler and retain its identity
        shell: bash
        run: |
          set -euo pipefail
          rustup toolchain install 1.95.0 --profile minimal --component rustfmt --component clippy
          printf 'RUSTC=%s\n' "$(rustup which --toolchain 1.95.0 rustc)" >> "$GITHUB_ENV"
          rustc +1.95.0 -Vv > "$TRNM_COMPONENT_RECEIPTS/rustc.txt"
          cargo +1.95.0 -V > "$TRNM_COMPONENT_RECEIPTS/cargo.txt"
      - name: Prepare pinned OpenSSL 3.5.9 PQ provider
        id: pq_provider
        shell: bash
        run: |
          set -euo pipefail
          export TRNM_CI_RECEIPT_DIR="$TRNM_COMPONENT_RECEIPTS"
          bash scripts/ci/prepare_pq_provider.sh
      - name: Check locked graphs, formatting and strict component Clippy
        shell: bash
        run: |
          set -euo pipefail
          cargo +1.95.0 metadata --locked --manifest-path trillionnium/Cargo.toml --format-version 1 > "$TRNM_COMPONENT_RECEIPTS/graph-default.json"
          cargo +1.95.0 metadata --locked --all-features --manifest-path trillionnium/Cargo.toml --format-version 1 > "$TRNM_COMPONENT_RECEIPTS/graph-all-features.json"
          cargo +1.95.0 fmt --manifest-path trillionnium/Cargo.toml --all -- --check
          cargo +1.95.0 clippy --locked --release --manifest-path trillionnium/Cargo.toml -p trnm-mvcc-fee -p trnm-pon-node --all-targets --all-features -- -D warnings 2>&1 | tee "$TRNM_COMPONENT_RECEIPTS/clippy.txt"
      - name: Build both real libtest executables
        shell: bash
        run: |
          set -euo pipefail
          cargo +1.95.0 test --locked --release --manifest-path trillionnium/Cargo.toml -p trnm-mvcc-fee -p trnm-pon-node --lib --no-run --message-format=json > "$TRNM_COMPONENT_RECEIPTS/build.jsonl" 2> "$TRNM_COMPONENT_RECEIPTS/build.stderr"
          python3 - <<'PY'
          import json, os
          from pathlib import Path
          rows = [json.loads(line) for line in (Path(os.environ['TRNM_COMPONENT_RECEIPTS']) / 'build.jsonl').read_text().splitlines() if line.startswith('{')]
          for name, variable in [('trnm_mvcc_fee', 'TRNM_MVCC_BINARY'), ('trnm_pon_node', 'TRNM_NODE_BINARY')]:
              candidates = [row['executable'] for row in rows if row.get('reason') == 'compiler-artifact' and row.get('target', {}).get('name') == name and row.get('profile', {}).get('test') is True and row.get('executable')]
              if len(candidates) != 1:
                  raise SystemExit(f'exactly one compiled {name} libtest executable required')
              with open(os.environ['GITHUB_ENV'], 'a') as output:
                  output.write(f'{variable}={Path(candidates[0]).resolve(strict=True)}\n')
          PY
      - name: Retain every planned component observation and failure
        shell: bash
        run: |
          set -euo pipefail
          python3 -B formal/throughput-v1/run_component_observations.py --mvcc-binary "$TRNM_MVCC_BINARY" --node-binary "$TRNM_NODE_BINARY" --output "$TRNM_COMPONENT_RECEIPTS/native"
      - name: Verify source after the component attempt
        if: always()
        run: python3 scripts/ci/verify_ci_source.py --kind head --expected-head "$TRNM_EXPECTED_SOURCE_SHA" --output "$RUNNER_TEMP/throughput-component-receipts/source-after.json"
      - name: Retain native component receipts without granting business qualification
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: throughput-components-${{ env.TRNM_EXPECTED_SOURCE_SHA }}-${{ github.run_attempt }}
          path: ${{ runner.temp }}/throughput-component-receipts/
          if-no-files-found: error
          retention-days: 30

fe0a830ee9b120bdc1928f044bfe8384243b2f38 blob 22579
name: PoN W1 QROM closure observations
on:
  pull_request:
    paths:
      - formal/pon-nakamoto-v1/**
      - trillionnium/**
      - scripts/w1_*.py
      - scripts/w1_*.c
      - scripts/ci/**
      - scripts/project-preflight.sh
      - evidence/pon-w1-*/**
      - evidence/pq-live-retry-20261111-fa62381e/**
      - evidence/pon-quantum-lifetime-20261111-e464/**
      - config/**
      - .cargo/**
      - rust-toolchain.toml
      - AGENTS.md
      - PROJECT_ID
      - PROJECT_BOUNDARY.json
      - .github/workflows/pon-w1-qrom-closure.yml
permissions:
  contents: read
concurrency:
  group: pon-w1-qrom-closure-${{ github.event.pull_request.number }}
  cancel-in-progress: false
env:
  PYTHONDONTWRITEBYTECODE: "1"
  W1_CLOSURE_ROSTER_SHA256: ee2b11492a362bd4be2f2df4e7ad691f4dd8a78cd9df884979cb3409e117745f
jobs:
  closure-historical:
    name: W1 QROM historical closure (fixed 1a14f7d, x64)
    runs-on: ubuntu-24.04
    timeout-minutes: 20
    env:
      SOURCE_KIND: head
      EXPECTED_SOURCE: 1a14f7d4826363daefac9ec10131c66d7e70ece7
      EXPECTED_HEAD: 1a14f7d4826363daefac9ec10131c66d7e70ece7
      EXPECTED_BASE: cb114b13bf848a77634e40a08b31b30c7c758e7b
    steps:
      - name: Reserve fresh observations
        id: observations
        shell: bash
        run: |
          set -euo pipefail
          out="$RUNNER_TEMP/w1-qrom-historical-closure-$SOURCE_KIND-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          mkdir "$out"
          printf 'W1_CLOSURE_OUT=%s\n' "$out" >> "$GITHUB_ENV"
          printf 'Immutable historical 1a14 source, original 105-name roster and seven byte-identical reports only. This does not validate current candidate sources or establish cryptographic qualification.\n' > "$out/SCOPE.txt"
      - name: Checkout exact candidate without persistent credentials
        id: checkout
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ env.EXPECTED_SOURCE }}
          fetch-depth: 0
          persist-credentials: false
      - name: Verify complete ordered source before execution
        id: source_before
        if: always() && steps.observations.outcome == 'success' && steps.checkout.outcome == 'success'
        shell: bash
        run: |
          set -euo pipefail
          args=(--kind "$SOURCE_KIND" --expected-head "$EXPECTED_HEAD")
          if test "$SOURCE_KIND" = prospective-merge; then
            args+=(--expected-base "$EXPECTED_BASE" --expected-merge "$EXPECTED_SOURCE")
          fi
          python3 scripts/ci/verify_ci_source.py "${args[@]}" --output "$W1_CLOSURE_OUT/source-before.json" 2>&1 | tee "$W1_CLOSURE_OUT/source-before.log"
      - name: Audit project boundary
        id: preflight
        if: always() && steps.source_before.outcome == 'success'
        shell: bash
        run: |
          set -euo pipefail
          bash scripts/project-preflight.sh --audit 2>&1 | tee "$W1_CLOSURE_OUT/preflight.log"
      - name: Execute the complete fixed named roster
        id: named_controls
        if: always() && steps.preflight.outcome == 'success'
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/ci/w1_qrom_closure_controls.py run --roster-sha256 "$W1_CLOSURE_ROSTER_SHA256" --output "$W1_CLOSURE_OUT" 2>&1 | tee "$W1_CLOSURE_OUT/named-controls.log"
          python3 scripts/ci/w1_qrom_closure_controls.py check --roster-sha256 "$W1_CLOSURE_ROSTER_SHA256" --output "$W1_CLOSURE_OUT" 2>&1 | tee "$W1_CLOSURE_OUT/named-controls-check.log"
      - name: Reproduce pinned observations and unknown project inputs
        id: reproduce
        if: always() && steps.preflight.outcome == 'success'
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/w1_qrom_semantics_audit.py --out "$W1_CLOSURE_OUT/semantics.json"
          # This job checks out 1a14f7d4 and compares only that commit's original evidence.
          python3 scripts/w1_lifetime_ledger.py --input evidence/pon-w1-lifetime-20261107/project-input.json > "$W1_CLOSURE_OUT/lifetime.json"
          python3 scripts/w1_qrom_composition_budget.py > "$W1_CLOSURE_OUT/composition-unknown.json"
          python3 scripts/w1_qrom_composition_budget.py --example > "$W1_CLOSURE_OUT/composition-example.json"
          python3 scripts/w1_qrom_joint_oracle_diagnostic.py > "$W1_CLOSURE_OUT/joint-oracle-unknown.json"
          python3 scripts/w1_qrom_joint_oracle_diagnostic.py --example alias > "$W1_CLOSURE_OUT/joint-oracle-alias.json"
          python3 scripts/w1_qrom_joint_oracle_diagnostic.py --example separated > "$W1_CLOSURE_OUT/joint-oracle-separated.json"
          cmp evidence/pon-w1-qrom-semantics-20261107/report.json "$W1_CLOSURE_OUT/semantics.json"
          cmp evidence/pon-w1-lifetime-20261107/project-report.json "$W1_CLOSURE_OUT/lifetime.json"
          for name in composition-unknown composition-example joint-oracle-unknown joint-oracle-alias joint-oracle-separated; do
            cmp "evidence/pon-w1-qrom-formal-bridge-20261107/$name.json" "$W1_CLOSURE_OUT/$name.json"
          done
      - name: Verify complete ordered source after execution
        id: source_after
        if: always() && steps.source_before.outcome == 'success'
        shell: bash
        run: |
          set -euo pipefail
          args=(--kind "$SOURCE_KIND" --expected-head "$EXPECTED_HEAD")
          if test "$SOURCE_KIND" = prospective-merge; then
            args+=(--expected-base "$EXPECTED_BASE" --expected-merge "$EXPECTED_SOURCE")
          fi
          python3 scripts/ci/verify_ci_source.py "${args[@]}" --output "$W1_CLOSURE_OUT/source-after.json" 2>&1 | tee "$W1_CLOSURE_OUT/source-after.log"
      - name: Validate named completion and every required stage independently
        id: completion
        if: always() && steps.observations.outcome == 'success' && steps.checkout.outcome == 'success'
        shell: bash
        env:
          W1_CLOSURE_STEPS: ${{ toJSON(steps) }}
        run: |
          set -euo pipefail
          python3 - <<'PY' 2>&1 | tee "$W1_CLOSURE_OUT/completion.log"
          import json
          import os
          from pathlib import Path
          import sys
          sys.path.insert(0, 'scripts/ci')
          import w1_qrom_closure_controls as controls
          out = Path(os.environ['W1_CLOSURE_OUT'])
          required = ('observations', 'checkout', 'source_before', 'preflight',
                      'named_controls', 'reproduce', 'source_after')
          steps = controls.strict_json(os.environ['W1_CLOSURE_STEPS'])
          failed = [name for name in required if type(steps.get(name)) is not dict
                    or steps[name].get('outcome') != 'success'
                    or steps[name].get('conclusion') != 'success']
          error = None
          try:
              controls.check(Path.cwd(), out, os.environ['W1_CLOSURE_ROSTER_SHA256'])
              before = controls.strict_json((out / 'source-before.json').read_bytes())
              after = controls.strict_json((out / 'source-after.json').read_bytes())
              controls.require(before == after, 'source observations differ')
              controls.require(before['schema'] == 'trnm-ci-source-v1', 'source schema differs')
              controls.require(before['tracked_worktree_verified'] is True, 'tracked source is unverified')
              controls.require(type(before['tracked_entries']) is int and before['tracked_entries'] > 0,
                               'tracked source count differs')
              controls.require(before['kind'] == os.environ['SOURCE_KIND'], 'source kind differs')
              controls.require(before['tested_commit'] == os.environ['EXPECTED_SOURCE'], 'source commit differs')
              controls.require(before['candidate'] == os.environ['EXPECTED_HEAD'], 'candidate differs')
              if os.environ['SOURCE_KIND'] == 'prospective-merge':
                  controls.require(before['base'] == os.environ['EXPECTED_BASE'], 'base differs')
                  controls.require(before['prospective_merge'] == os.environ['EXPECTED_SOURCE'], 'merge differs')
              else:
                  controls.require(before['base'] is None and before['prospective_merge'] is None,
                                   'head observation has merge fields')
          except (Exception, SystemExit) as caught:
              error = type(caught).__name__ + ': ' + str(caught)
          passed = not failed and error is None
          status = {'schema': 'TRNM-W1-QROM-CLOSURE-CI1',
                    'expected_source': os.environ['EXPECTED_SOURCE'],
                    'expected_head': os.environ['EXPECTED_HEAD'],
                    'expected_base': os.environ['EXPECTED_BASE'],
                    'source_kind': os.environ['SOURCE_KIND'],
                    'required_stages': list(required), 'steps': steps,
                    'failed_or_skipped_stages': failed, 'completion_or_identity_error': error,
                    'all_required_observations_passed': passed,
                    'qualification': controls.QUALIFICATION}
          with (out / 'ci-status.json').open('x') as stream:
              json.dump(status, stream, indent=2, sort_keys=True, allow_nan=False)
              stream.write('\n')
          if not passed:
              raise SystemExit('required QROM continuation observations did not all complete')
          print('All fixed named observations completed; complete QROM and chain qualification remain false.')
          PY
      - name: Retain exact observations including failures
        if: always() && steps.observations.outcome == 'success'
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: w1-qrom-historical-closure-fixed-x64-${{ env.EXPECTED_SOURCE }}-${{ github.run_attempt }}
          path: ${{ env.W1_CLOSURE_OUT }}/
          if-no-files-found: error
  closure:
    name: W1 QROM current closure (${{ matrix.source }}, x64)
    runs-on: ubuntu-24.04
    timeout-minutes: 20
    strategy:
      fail-fast: false
      matrix:
        source: [head, prospective-merge]
    env:
      W1_CLOSURE_ROSTER_SHA256: f5292042233ba22fad6af1b7d89c0b57298038e9b98558d360b8feae50ecdfed
      SOURCE_KIND: ${{ matrix.source }}
      EXPECTED_SOURCE: ${{ matrix.source == 'head' && github.event.pull_request.head.sha || github.sha }}
      EXPECTED_HEAD: ${{ github.event.pull_request.head.sha }}
      EXPECTED_BASE: ${{ github.event.pull_request.base.sha }}
    steps:
      - name: Reserve fresh observations
        id: observations
        shell: bash
        run: |
          set -euo pipefail
          out="$RUNNER_TEMP/w1-qrom-current-closure-$SOURCE_KIND-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          mkdir "$out"
          printf 'W1_CLOSURE_OUT=%s\n' "$out" >> "$GITHUB_ENV"
          printf 'Current selected-source lifetime observation, explicit V1 refusal and separate current named roster only. Original historical positives execute in their own fixed checkout. No complete QROM theorem, adversary budget or qualification is granted.\n' > "$out/SCOPE.txt"
      - name: Checkout exact candidate without persistent credentials
        id: checkout
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ env.EXPECTED_SOURCE }}
          fetch-depth: 0
          persist-credentials: false
      - name: Verify complete ordered source before execution
        id: source_before
        if: always() && steps.observations.outcome == 'success' && steps.checkout.outcome == 'success'
        shell: bash
        run: |
          set -euo pipefail
          args=(--kind "$SOURCE_KIND" --expected-head "$EXPECTED_HEAD")
          if test "$SOURCE_KIND" = prospective-merge; then
            args+=(--expected-base "$EXPECTED_BASE" --expected-merge "$EXPECTED_SOURCE")
          fi
          python3 scripts/ci/verify_ci_source.py "${args[@]}" --output "$W1_CLOSURE_OUT/source-before.json" 2>&1 | tee "$W1_CLOSURE_OUT/source-before.log"
      - name: Audit project boundary
        id: preflight
        if: always() && steps.source_before.outcome == 'success'
        shell: bash
        run: |
          set -euo pipefail
          bash scripts/project-preflight.sh --audit 2>&1 | tee "$W1_CLOSURE_OUT/preflight.log"
      - name: Execute the complete fixed named roster
        id: named_controls
        if: always() && steps.preflight.outcome == 'success'
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/ci/w1_qrom_closure_current_controls.py run --roster-sha256 "$W1_CLOSURE_ROSTER_SHA256" --output "$W1_CLOSURE_OUT" 2>&1 | tee "$W1_CLOSURE_OUT/named-controls.log"
          python3 scripts/ci/w1_qrom_closure_current_controls.py check --roster-sha256 "$W1_CLOSURE_ROSTER_SHA256" --output "$W1_CLOSURE_OUT" 2>&1 | tee "$W1_CLOSURE_OUT/named-controls-check.log"
      - name: Retain actual historical ledger refusal on current source
        id: historical_refusal
        if: always() && steps.preflight.outcome == 'success'
        shell: bash
        run: |
          set -euo pipefail
          set +e
          python3 tests/fixtures/w1-lifetime-historical-7150/ledger.py --root . --input evidence/pon-w1-lifetime-20261107/project-input.json > "$W1_CLOSURE_OUT/historical-reader.stdout" 2> "$W1_CLOSURE_OUT/historical-reader.stderr"
          code=$?
          set -e
          test "$code" -eq 2
          python3 - "$code" <<'PY'
          import json, os
          from pathlib import Path
          import sys
          sys.path.insert(0, 'scripts/ci')
          import w1_qrom_closure_current_controls as controls
          out = Path(os.environ['W1_CLOSURE_OUT'])
          controls.require((out / 'historical-reader.stdout').read_bytes() == b'', 'historical refusal emitted a success report')
          refusal = controls.strict_json((out / 'historical-reader.stderr').read_bytes())
          controls.require(set(refusal) == {'status', 'error'} and refusal['status'] == 'REFUSED'
                           and refusal['error'].startswith('source identity mismatch: '), 'unexpected historical refusal')
          record = {'schema': 'TRNM-W1-LIFETIME-HISTORICAL-CURRENT-REFUSAL2',
                    'expected_source': os.environ['EXPECTED_SOURCE'], 'exit_code': int(sys.argv[1]),
                    'historical_refusal': refusal, 'historical_pins_relaxed': False}
          with (out / 'historical-refusal.json').open('x') as stream:
              json.dump(record, stream, indent=2, sort_keys=True)
              stream.write('\n')
          PY
      - name: Reproduce pinned observations and unknown project inputs
        id: reproduce
        if: always() && steps.preflight.outcome == 'success'
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/w1_qrom_semantics_audit.py --out "$W1_CLOSURE_OUT/semantics.json"
          python3 scripts/w1_lifetime_current_observation.py --input evidence/pon-w1-lifetime-20261107/project-input.json > "$W1_CLOSURE_OUT/lifetime-current.json"
          python3 scripts/w1_qrom_composition_budget.py > "$W1_CLOSURE_OUT/composition-unknown.json"
          python3 scripts/w1_qrom_composition_budget.py --example > "$W1_CLOSURE_OUT/composition-example.json"
          python3 scripts/w1_qrom_joint_oracle_diagnostic.py > "$W1_CLOSURE_OUT/joint-oracle-unknown.json"
          python3 scripts/w1_qrom_joint_oracle_diagnostic.py --example alias > "$W1_CLOSURE_OUT/joint-oracle-alias.json"
          python3 scripts/w1_qrom_joint_oracle_diagnostic.py --example separated > "$W1_CLOSURE_OUT/joint-oracle-separated.json"
          python3 scripts/ci/w1_qrom_closure_current_controls.py check-semantics --output "$W1_CLOSURE_OUT/semantics.json" > "$W1_CLOSURE_OUT/semantics-correspondence.json"
          for name in composition-unknown composition-example joint-oracle-unknown joint-oracle-alias joint-oracle-separated; do
            cmp "evidence/pon-w1-qrom-formal-bridge-20261107/$name.json" "$W1_CLOSURE_OUT/$name.json"
          done
      - name: Verify complete ordered source after execution
        id: source_after
        if: always() && steps.source_before.outcome == 'success'
        shell: bash
        run: |
          set -euo pipefail
          args=(--kind "$SOURCE_KIND" --expected-head "$EXPECTED_HEAD")
          if test "$SOURCE_KIND" = prospective-merge; then
            args+=(--expected-base "$EXPECTED_BASE" --expected-merge "$EXPECTED_SOURCE")
          fi
          python3 scripts/ci/verify_ci_source.py "${args[@]}" --output "$W1_CLOSURE_OUT/source-after.json" 2>&1 | tee "$W1_CLOSURE_OUT/source-after.log"
      - name: Validate named completion and every required stage independently
        id: completion
        if: always() && steps.observations.outcome == 'success' && steps.checkout.outcome == 'success'
        shell: bash
        env:
          W1_CLOSURE_STEPS: ${{ toJSON(steps) }}
        run: |
          set -euo pipefail
          python3 - <<'PY' 2>&1 | tee "$W1_CLOSURE_OUT/completion.log"
          import json
          import os
          from pathlib import Path
          import sys
          sys.path.insert(0, 'scripts/ci')
          import w1_qrom_closure_current_controls as controls
          out = Path(os.environ['W1_CLOSURE_OUT'])
          required = ('observations', 'checkout', 'source_before', 'preflight',
                      'named_controls', 'historical_refusal', 'reproduce', 'source_after')
          steps = controls.strict_json(os.environ['W1_CLOSURE_STEPS'])
          failed = [name for name in required if type(steps.get(name)) is not dict
                    or steps[name].get('outcome') != 'success'
                    or steps[name].get('conclusion') != 'success']
          error = None
          try:
              controls.check(Path.cwd(), out, os.environ['W1_CLOSURE_ROSTER_SHA256'])
              observed = controls.strict_json((out / 'lifetime-current.json').read_bytes())
              controls.require(observed['schema'] == 'TRNM-W1-LIFETIME-CURRENT-OBSERVATION2'
                               and observed['status'] == 'CURRENT_SELECTED_SOURCE_OBSERVED_SECURITY_HOLD', 'current lifetime scope differs')
              expected_qualification = {'production_activation': False, 'consensus_admission': False,
                    'whole_chain_post_quantum_qualified': False, 'actual_lifetime_failure_bound': None,
                    'coverage_exhaustiveness_proved': False, 'composition_theorem_instantiated': False}
              controls.require(type(observed['qualification']) is dict
                               and set(observed['qualification']) == set(expected_qualification)
                               and all(observed['qualification'][k] is v for k, v in expected_qualification.items()), 'current lifetime qualification differs')
              refusal = controls.strict_json((out / 'historical-refusal.json').read_bytes())
              controls.require(refusal['schema'] == 'TRNM-W1-LIFETIME-HISTORICAL-CURRENT-REFUSAL2'
                               and refusal['expected_source'] == os.environ['EXPECTED_SOURCE']
                               and type(refusal['exit_code']) is int and refusal['exit_code'] == 2
                               and refusal['historical_pins_relaxed'] is False
                               and refusal['historical_refusal']['status'] == 'REFUSED'
                               and refusal['historical_refusal']['error'].startswith('source identity mismatch: '), 'historical refusal record differs')
              before = controls.strict_json((out / 'source-before.json').read_bytes())
              after = controls.strict_json((out / 'source-after.json').read_bytes())
              controls.require(before == after, 'source observations differ')
              controls.require(before['schema'] == 'trnm-ci-source-v1', 'source schema differs')
              controls.require(before['tracked_worktree_verified'] is True, 'tracked source is unverified')
              controls.require(type(before['tracked_entries']) is int and before['tracked_entries'] > 0,
                               'tracked source count differs')
              controls.require(before['kind'] == os.environ['SOURCE_KIND'], 'source kind differs')
              controls.require(before['tested_commit'] == os.environ['EXPECTED_SOURCE'], 'source commit differs')
              controls.require(before['candidate'] == os.environ['EXPECTED_HEAD'], 'candidate differs')
              if os.environ['SOURCE_KIND'] == 'prospective-merge':
                  controls.require(before['base'] == os.environ['EXPECTED_BASE'], 'base differs')
                  controls.require(before['prospective_merge'] == os.environ['EXPECTED_SOURCE'], 'merge differs')
              else:
                  controls.require(before['base'] is None and before['prospective_merge'] is None,
                                   'head observation has merge fields')
          except (Exception, SystemExit) as caught:
              error = type(caught).__name__ + ': ' + str(caught)
          passed = not failed and error is None
          status = {'schema': 'TRNM-W1-QROM-CLOSURE-CURRENT-CI2',
                    'expected_source': os.environ['EXPECTED_SOURCE'],
                    'expected_head': os.environ['EXPECTED_HEAD'],
                    'expected_base': os.environ['EXPECTED_BASE'],
                    'source_kind': os.environ['SOURCE_KIND'],
                    'required_stages': list(required), 'steps': steps,
                    'failed_or_skipped_stages': failed, 'completion_or_identity_error': error,
                    'all_required_observations_passed': passed,
                    'qualification': controls.QUALIFICATION}
          with (out / 'ci-status.json').open('x') as stream:
              json.dump(status, stream, indent=2, sort_keys=True, allow_nan=False)
              stream.write('\n')
          if not passed:
              raise SystemExit('required QROM continuation observations did not all complete')
          print('All fixed named observations completed; complete QROM and chain qualification remain false.')
          PY
      - name: Retain exact observations including failures
        if: always() && steps.observations.outcome == 'success'
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: w1-qrom-current-closure-${{ matrix.source }}-x64-${{ env.EXPECTED_SOURCE }}-${{ github.run_attempt }}
          path: ${{ env.W1_CLOSURE_OUT }}/
          if-no-files-found: error

eca8b1d4733f452a685894e8e942461f64f74a1e blob 70342
name: PoN W1 QROM implementation observations
on:
  pull_request:
    paths:
      - formal/pon-nakamoto-v1/**
      - trillionnium/**
      - scripts/w1_*.py
      - scripts/ci/**
      - scripts/project-preflight.sh
      - evidence/pon-w1-*/**
      - config/**
      - .cargo/**
      - rust-toolchain.toml
      - AGENTS.md
      - PROJECT_ID
      - PROJECT_BOUNDARY.json
      - .github/workflows/pon-w1-qrom-implementation.yml
permissions:
  contents: read
concurrency:
  group: pon-w1-qrom-implementation-${{ github.event.pull_request.number }}
  cancel-in-progress: false
env:
  CI: "true"
  PYTHONDONTWRITEBYTECODE: "1"
jobs:
  qrom-historical-implementation:
    name: W1 QROM historical V1 (fixed 0c830e0, x64)
    runs-on: ubuntu-24.04
    timeout-minutes: 20
    env:
      # V1 pins historical bytes. Its positive replay must execute that source;
      # the current candidate and its V1 refusal are required in the companion job.
      SOURCE_KIND: head
      EXPECTED_SOURCE: 0c830e0be8939ce80c8443c9ad68021b87343a00
      EXPECTED_HEAD: 0c830e0be8939ce80c8443c9ad68021b87343a00
      EXPECTED_BASE: 1e4bffc371bcdc53aabc621b6b6cb2485ab36f53
    steps:
      - name: Reserve source-specific observations
        id: observations
        shell: bash
        run: |
          set -euo pipefail
          w1_qrom_out="$RUNNER_TEMP/pon-w1-qrom-historical-v1-$SOURCE_KIND-x64-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          mkdir "$w1_qrom_out"
          printf 'W1_QROM_OUT=%s\n' "$w1_qrom_out" >> "$GITHUB_ENV"
          printf 'Fixed historical source 0c830e0be8939ce80c8443c9ad68021b87343a00 and original 81-name V1 roster only. This result does not validate the current candidate. Current V2 mapping and V1-on-current source drift are separate required jobs. No new proof verification, QROM instantiation, quantum-work qualification or consensus admission is established.\n' > "$w1_qrom_out/SCOPE.txt"
          python3 --version > "$w1_qrom_out/python-version.txt" 2>&1
      - name: Checkout immutable historical V1 source without persistent credentials
        id: checkout
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ env.EXPECTED_SOURCE }}
          fetch-depth: 0
          persist-credentials: false
      - name: Verify ordered source identity before execution
        id: source_before
        if: always() && steps.observations.outcome == 'success' && steps.checkout.outcome == 'success'
        shell: bash
        run: |
          set -euo pipefail
          args=(--kind "$SOURCE_KIND" --expected-head "$EXPECTED_HEAD")
          if test "$SOURCE_KIND" = prospective-merge; then
            args+=(--expected-base "$EXPECTED_BASE" --expected-merge "$EXPECTED_SOURCE")
          fi
          python3 scripts/ci/verify_ci_source.py "${args[@]}" --output "$W1_QROM_OUT/source-before.json" 2>&1 | tee "$W1_QROM_OUT/source-before.log"
      - name: Audit the project boundary
        id: preflight
        if: always() && steps.source_before.outcome == 'success'
        shell: bash
        run: |
          set -euo pipefail
          bash scripts/project-preflight.sh --audit 2>&1 | tee "$W1_QROM_OUT/preflight.log"
      - name: Execute every fixed named Python control exactly once
        id: named_tests
        if: always() && steps.preflight.outcome == 'success'
        shell: bash
        run: |
          set -euo pipefail
          python3 - "$W1_QROM_OUT" <<'PY' 2>&1 | tee "$W1_QROM_OUT/named-tests.log"
          from collections import Counter
          import hashlib
          import json
          from pathlib import Path
          import re
          import sys
          import traceback
          import unittest

          out = Path(sys.argv[1])
          roster_path = Path('config/pon/w1-qrom-required-tests-v1.json')
          expected_digest = 'ca685b61914435e0be6defdaa0bc4f2368f7430060663315cd96f226adab5bd8'
          required_modules = (
              'test_w1_control_tree_audit',
              'test_w1_qrom_conditional_budget',
              'test_w1_qrom_implementation_audit',
              'test_w1_fri_transcript_audit',
              'test_w1_qrom_workflow_gate',
          )
          def strict_object(pairs):
              result = {}
              for key, value in pairs:
                  if key in result:
                      raise ValueError('duplicate JSON key: ' + key)
                  result[key] = value
              return result

          def refuse_constant(value):
              raise ValueError('nonfinite JSON number: ' + value)

          raw = roster_path.read_bytes()
          if hashlib.sha256(raw).hexdigest() != expected_digest:
              raise SystemExit('required-test roster differs from its reviewed workflow pin')
          manifest = json.loads(raw, object_pairs_hook=strict_object, parse_constant=refuse_constant)
          false_fields = (
              'post_quantum_soundness_qualified', 'complete_w1_soundness_qualified',
              'quantum_work_qualified', 'pq_signature_qualification_inferred',
              'production_qualified', 'consensus_admission',
          )
          if (type(manifest) is not dict
                  or manifest.get('schema') != 'TRNM-W1-QROM-REQUIRED-TESTS1'
                  or type(manifest.get('suites')) is not list
                  or type(manifest.get('expected_tests')) is not int
                  or manifest['expected_tests'] <= 0
                  or any(manifest.get(key) is not False for key in false_fields)
                  or 'unconditional_project_security_bits' not in manifest
                  or manifest['unconditional_project_security_bits'] is not None):
              raise SystemExit('required-test roster schema or scope invalid')
          if tuple(row.get('module') for row in manifest['suites']) != required_modules:
              raise SystemExit('all fixed module suites must be present in the original order')
          total_required = []
          for row in manifest['suites']:
              module, count, names = row['module'], row.get('expected_tests'), row.get('tests')
              if (set(row) != {'module', 'expected_tests', 'tests'}
                      or type(count) is not int or count <= 0 or type(names) is not list
                      or len(names) != count
                      or any(type(name) is not str or re.fullmatch(
                          re.escape(module) + r'\.[A-Za-z_][A-Za-z0-9_]*\.test_[A-Za-z0-9_]+', name) is None
                          for name in names)
                      or len(set(names)) != count or sorted(names) != names):
                  raise SystemExit('missing, duplicate, unsorted or invalid required names: ' + module)
              total_required.extend(names)
          if (len(total_required) != manifest['expected_tests']
                  or len(set(total_required)) != len(total_required)):
              raise SystemExit('required-test total or global uniqueness differs')
          with (out / 'required-tests.json').open('xb') as stream:
              stream.write(raw)

          def flatten(suite):
              for item in suite:
                  if isinstance(item, unittest.TestSuite):
                      yield from flatten(item)
                  else:
                      yield item

          class ObservedResult(unittest.TextTestResult):
              def __init__(self, *args, **kwargs):
                  super().__init__(*args, **kwargs)
                  self.started_ids = []
                  self.success_ids = []

              def startTest(self, test):
                  self.started_ids.append(test.id())
                  super().startTest(test)

              def addSuccess(self, test):
                  self.success_ids.append(test.id())
                  super().addSuccess(test)

          records = []
          for row in manifest['suites']:
              module, expected = row['module'], row['tests']
              record = {'module': module, 'expected_ids': expected, 'passed': False}
              try:
                  loader = unittest.TestLoader()
                  suite = loader.discover('scripts/ci', pattern=module + '.py')
                  registered = [test.id() for test in flatten(suite)]
                  record['registered_ids'] = registered
                  record['loader_errors'] = list(loader.errors)
                  if loader.errors or Counter(registered) != Counter(expected):
                      raise ValueError('actual complete module registry differs from the required named roster')
                  runner = unittest.TextTestRunner(
                      stream=sys.stderr, verbosity=2, descriptions=False, resultclass=ObservedResult)
                  result = runner.run(suite)
                  record.update({
                      'tests_run': result.testsRun,
                      'started_ids': result.started_ids,
                      'success_ids': result.success_ids,
                      'skipped': [(test.id(), reason) for test, reason in result.skipped],
                      'failures': [(test.id(), reason) for test, reason in result.failures],
                      'errors': [(test.id(), reason) for test, reason in result.errors],
                      'expected_failures': [(test.id(), reason) for test, reason in result.expectedFailures],
                      'unexpected_successes': [test.id() for test in result.unexpectedSuccesses],
                  })
                  record['passed'] = (
                      result.testsRun == row['expected_tests']
                      and Counter(result.started_ids) == Counter(expected)
                      and Counter(result.success_ids) == Counter(expected)
                      and result.wasSuccessful()
                      and not result.skipped and not result.expectedFailures
                      and not result.unexpectedSuccesses and not result.failures and not result.errors)
              except (Exception, SystemExit) as error:
                  record['exception'] = str(error)
                  traceback.print_exc()
              records.append(record)
              with (out / (module + '.json')).open('x') as stream:
                  json.dump(record, stream, indent=2, sort_keys=True, allow_nan=False)
                  stream.write('\n')
          report = {
              'schema': 'TRNM-W1-QROM-NAMED-TEST-OBSERVATION1',
              'roster_sha256': expected_digest,
              'required_tests': manifest['expected_tests'],
              'suites': records,
              'all_named_controls_passed': len(records) == len(required_modules)
                  and all(row['passed'] is True for row in records),
              'post_quantum_soundness_qualified': False,
              'unconditional_project_security_bits': None,
          }
          with (out / 'named-tests.json').open('x') as stream:
              json.dump(report, stream, indent=2, sort_keys=True, allow_nan=False)
              stream.write('\n')
          if report['all_named_controls_passed'] is not True:
              raise SystemExit('every fixed named test must execute exactly once with success and no skips')
          print('All fixed named controls executed exactly once; security qualification remains false.')
          PY
      - name: Reproduce the fixed implementation and saved-fixture map
        id: implementation
        if: always() && steps.preflight.outcome == 'success'
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/w1_qrom_implementation_audit.py --repo-root "$GITHUB_WORKSPACE" \
            --output "$W1_QROM_OUT/implementation.json" 2>&1 | tee "$W1_QROM_OUT/implementation.log"
      - name: Preserve all unknown project quantum inputs
        id: budget_unknown
        if: always() && steps.preflight.outcome == 'success'
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/w1_qrom_conditional_budget.py > "$W1_QROM_OUT/budget-unknown.json" 2> "$W1_QROM_OUT/budget-unknown.log"
      - name: Reproduce explicitly hypothetical component arithmetic
        id: budget_hypothetical
        if: always() && steps.preflight.outcome == 'success'
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/w1_qrom_conditional_budget.py --example-input \
            > "$W1_QROM_OUT/budget-hypothetical-input.json" 2> "$W1_QROM_OUT/budget-hypothetical-input.log"
          python3 scripts/w1_qrom_conditional_budget.py --input "$W1_QROM_OUT/budget-hypothetical-input.json" \
            > "$W1_QROM_OUT/budget-hypothetical.json" 2> "$W1_QROM_OUT/budget-hypothetical.log"
      - name: Require every report to retain the unqualified security boundary
        id: report_scopes
        if: always() && steps.implementation.outcome == 'success' && steps.budget_unknown.outcome == 'success' && steps.budget_hypothetical.outcome == 'success'
        shell: bash
        run: |
          set -euo pipefail
          python3 - "$W1_QROM_OUT" <<'PY' 2>&1 | tee "$W1_QROM_OUT/report-scopes.log"
          from fractions import Fraction
          import json
          from pathlib import Path
          import re
          import sys

          out = Path(sys.argv[1])
          def require(condition, message):
              if not condition:
                  raise ValueError(message)

          def strict_object(pairs):
              result = {}
              for key, value in pairs:
                  require(key not in result, 'duplicate JSON key: ' + key)
                  result[key] = value
              return result

          def refuse_constant(value):
              raise ValueError('nonfinite JSON number: ' + value)

          def read(name):
              return json.loads((out / name).read_bytes(), object_pairs_hook=strict_object,
                                parse_constant=refuse_constant)

          def fields(value, expected, label):
              require(type(value) is dict and set(value) == set(expected), label + ': exact fields required')

          def exact_qualification(observed, expected):
              return (type(observed) is dict and set(observed) == set(expected)
                      and all(observed[key] is value for key, value in expected.items()))

          implementation = read('implementation.json')
          expected_implementation = {
              'post_quantum_soundness_qualified': False,
              'complete_w1_soundness_qualified': False,
              'quantum_work_qualified': False,
              'pq_signature_qualification_inferred': False,
              'production_qualified': False,
              'consensus_admission': False,
              'security_bits_quantum': None,
          }
          require(type(implementation) is dict
                  and implementation.get('schema') == 'TRNM-W1-QROM-IMPLEMENTATION-AUDIT1'
                  and implementation.get('result') == 'MAPPING_REPRODUCED_SECURITY_HOLD'
                  and exact_qualification(implementation.get('qualification'), expected_implementation),
                  'implementation observation widened its qualification scope')
          expected_budget = {
              'unconditional_project_security_bits': None,
              'quantum_security_bits': None,
              'full_recursive_security_bits': None,
              'qrom_theorem_instantiated': False,
              'post_quantum_soundness_qualified': False,
              'whole_recursive_proof_soundness_qualified': False,
              'complete_w1_attack_established': False,
              'production_qualified': False,
              'consensus_admission': False,
          }
          pqsr_fields = {'t', 'k', 'w', 'r_min', 'kappa_rrbr', 'target_error'}
          merkle_fields = {'t', 'k', 'w_vc', 'sigma', 'ell_max', 'n', 'q_s', 'target_error'}
          component_names = {
              'commutativity', 'extraction_correctness',
              'offline_extractability', 'online_indistinguishability',
          }
          pqsr_numbers = (
              'rrbr_coefficient', 'finite_randomness_addend',
              'rrbr_addend', 'conditional_upper_expression',
          )
          target_fields = {
              'finite_randomness_addend_exceeds_target',
              'some_nonnegative_rrbr_bound_can_meet_target_by_this_expression',
              'kappa_rrbr_required_at_most',
          }
          budget_fields = {
              'schema', 'status', 'source', 'inputs', 'pqsr_component', 'merkle_components',
              'theorem_11_3_full_bound', 'theorem_10_6_composed_bound',
              'qualification', 'unresolved_obligations',
          }
          def input_fields(inputs):
              fields(inputs, {'schema', 'input_kind', 'pqsr', 'merkle'}, 'inputs')
              require(inputs['schema'] == 'TRNM-W1-QROM-CONDITIONAL-INPUT1'
                      and inputs['input_kind'] == 'hypothetical', 'hypothetical input schema required')
              fields(inputs['pqsr'], pqsr_fields, 'inputs.pqsr')
              fields(inputs['merkle'], merkle_fields, 'inputs.merkle')

          def report_shape(report):
              fields(report, budget_fields, 'component report')
              require(report['schema'] == 'TRNM-W1-QROM-CONDITIONAL-COMPONENTS1'
                      and report['status'] == 'hypothetical_component_arithmetic_only'
                      and report['theorem_11_3_full_bound'] is None
                      and report['theorem_10_6_composed_bound'] is None
                      and exact_qualification(report['qualification'], expected_budget),
                      'conditional component report widened its theorem or project scope')
              source = report['source']
              fields(source, {'paper', 'indexed_copy', 'indexed_manuscript_date',
                             'latest_revision_date_observed_in_metadata',
                             'latest_revision_full_text_equivalence_verified', 'scope'}, 'source')
              require(source['indexed_manuscript_date'] == '2026-01-01'
                      and source['latest_revision_full_text_equivalence_verified'] is False,
                      'component arithmetic must retain the selected January statement boundary')
              require(type(report['unresolved_obligations']) is list and report['unresolved_obligations']
                      and all(type(item) is str and item for item in report['unresolved_obligations']),
                      'unresolved obligations must remain explicit')
              input_fields(report['inputs'])
              pqsr = report['pqsr_component']
              fields(pqsr, set(pqsr_numbers) | {'theorem', 'conditional_expression_meets_target',
                     'target_analysis', 'unknown_inputs', 'boundary'}, 'pqsr_component')
              require(pqsr['theorem'] == '2026-01-01 manuscript, Theorem 6.10, page 46'
                      and type(pqsr['boundary']) is str and pqsr['boundary'], 'PQSR theorem boundary missing')
              fields(pqsr['target_analysis'], target_fields, 'PQSR target analysis')
              merkle = report['merkle_components']
              fields(merkle, {'theorem', 'conditional_expressions', 'each_expression_meets_component_target',
                              'unknown_inputs', 'boundary'}, 'merkle_components')
              require(merkle['theorem'] == '2026-01-01 manuscript, Theorem 8.3, page 53'
                      and type(merkle['boundary']) is str and merkle['boundary'], 'Merkle theorem boundary missing')
              fields(merkle['conditional_expressions'], component_names, 'Merkle expressions')
              fields(merkle['each_expression_meets_component_target'], component_names, 'Merkle comparisons')

          unknown = read('budget-unknown.json')
          example = read('budget-hypothetical.json')
          for report in (unknown, example):
              report_shape(report)
          for group in ('pqsr', 'merkle'):
              require(all(value is None for value in unknown['inputs'][group].values()),
                      'unknown inputs must remain null with the complete field set')
          unknown_pqsr = unknown['pqsr_component']
          require(all(unknown_pqsr[key] is None for key in pqsr_numbers)
                  and unknown_pqsr['conditional_expression_meets_target'] is None
                  and all(value is None for value in unknown_pqsr['target_analysis'].values())
                  and unknown_pqsr['unknown_inputs'] == sorted(pqsr_fields),
                  'every unknown PQSR derived value, comparison and threshold must remain null')
          unknown_merkle = unknown['merkle_components']
          require(all(value is None for value in unknown_merkle['conditional_expressions'].values())
                  and all(value is None for value in unknown_merkle['each_expression_meets_component_target'].values())
                  and unknown_merkle['unknown_inputs'] == sorted(merkle_fields),
                  'every unknown named Merkle expression and comparison must remain null')

          # Independent stdlib Fraction arithmetic for the retained hypothetical input.
          # Do not import or call the calculator to validate its own derived values.
          def integer_text(value, label, minimum=0, maximum=None):
              require(type(value) is str and len(value) <= 617
                      and re.fullmatch(r'0|[1-9][0-9]*', value) is not None,
                      label + ': canonical exact integer string required')
              number = int(value)
              require(number.bit_length() <= 2048 and number >= minimum
                      and (maximum is None or number <= maximum), label + ': input outside evaluator bounds')
              return number

          def fraction_value(value, label, reported):
              if not reported and type(value) is str:
                  return Fraction(integer_text(value, label))
              fields(value, {'numerator', 'denominator'}, label)
              numerator = integer_text(value['numerator'], label + '.numerator')
              denominator = integer_text(value['denominator'], label + '.denominator', 1)
              number = Fraction(numerator, denominator)
              require(value == {'numerator': str(number.numerator), 'denominator': str(number.denominator)},
                      label + ': reduced exact fraction required')
              return number

          def parse_known_inputs(inputs, reported):
              input_fields(inputs)
              pqsr_raw, merkle_raw = inputs['pqsr'], inputs['merkle']
              pqsr = {key: integer_text(pqsr_raw[key], 'pqsr.' + key, int(key != 't'),
                                       4096 if key == 'r_min' else None)
                      for key in ('t', 'k', 'r_min')}
              pqsr.update({key: fraction_value(pqsr_raw[key], 'pqsr.' + key, reported)
                           for key in ('w', 'kappa_rrbr', 'target_error')})
              merkle = {key: integer_text(merkle_raw[key], 'merkle.' + key,
                                         int(key in ('k', 'sigma', 'ell_max')),
                                         4096 if key == 'sigma' else None)
                        for key in ('t', 'k', 'sigma', 'ell_max', 'n', 'q_s')}
              merkle.update({key: fraction_value(merkle_raw[key], 'merkle.' + key, reported)
                             for key in ('w_vc', 'target_error')})
              require(pqsr['w'] <= pqsr['t'] and pqsr['kappa_rrbr'] <= 1
                      and 0 < pqsr['target_error'] <= 1, 'PQSR query mass or probability domain invalid')
              length = merkle['ell_max']
              require(merkle['w_vc'] <= merkle['t'] and 0 < merkle['target_error'] <= 1
                      and length & (length - 1) == 0 and merkle['n'] <= merkle['k']
                      and merkle['q_s'] <= merkle['k'] * length, 'Merkle lengths, query mass or probability domain invalid')
              return pqsr, merkle

          retained_input = read('budget-hypothetical-input.json')
          pqsr, merkle = parse_known_inputs(retained_input, reported=False)
          require(parse_known_inputs(example['inputs'], reported=True) == (pqsr, merkle),
                  'hypothetical report must preserve every exact retained illustrative input')
          def exact_fraction(observed, expected, label):
              if expected is None:
                  require(observed is None, label + ': expected an unavailable threshold')
                  return
              require(type(observed) is dict
                      and set(observed) == {'numerator', 'denominator'}
                      and all(type(value) is str for value in observed.values())
                      and observed == {'numerator': str(expected.numerator), 'denominator': str(expected.denominator)},
                      label + ': derived fraction differs from independent arithmetic')

          t, k, w = pqsr['t'], pqsr['k'], pqsr['w']
          coefficient = 80 * (t + k + 1) * (w + k)
          finite = Fraction((t + k + 1) * k, 1 << pqsr['r_min'])
          rrbr = coefficient * pqsr['kappa_rrbr']
          upper = rrbr + finite
          expected_pqsr = {
              'rrbr_coefficient': coefficient,
              'finite_randomness_addend': finite,
              'rrbr_addend': rrbr,
              'conditional_upper_expression': upper,
          }
          observed_pqsr = example['pqsr_component']
          require(type(observed_pqsr['unknown_inputs']) is list and observed_pqsr['unknown_inputs'] == [],
                  'fully specified hypothetical PQSR inputs cannot remain unknown')
          for key, value in expected_pqsr.items():
              exact_fraction(observed_pqsr[key], value, 'pqsr_component.' + key)
          target = pqsr['target_error']
          require(observed_pqsr['conditional_expression_meets_target'] is (upper <= target),
                  'PQSR target comparison must be the exact boolean result')
          analysis = observed_pqsr['target_analysis']
          feasible = finite <= target
          require(analysis['finite_randomness_addend_exceeds_target'] is (finite > target)
                  and analysis['some_nonnegative_rrbr_bound_can_meet_target_by_this_expression'] is feasible,
                  'PQSR finite-addend comparisons must be exact booleans')
          required_rrbr = min(Fraction(1), (target - finite) / coefficient) if feasible else None
          exact_fraction(analysis['kappa_rrbr_required_at_most'], required_rrbr, 'PQSR required RRBR threshold')

          t, w_vc, length = merkle['t'], merkle['w_vc'], merkle['ell_max']
          denominator = 1 << merkle['sigma']
          expected_merkle = {
              'commutativity': Fraction(240 * (t + 1), denominator),
              'extraction_correctness': Fraction(8 * merkle['n'] * length, denominator),
              'offline_extractability': (160 * w_vc * t * t
                  + 16 * merkle['q_s'] * (length.bit_length() - 1)) / denominator,
              'online_indistinguishability': 240 * w_vc * t * t / denominator,
          }
          observed_merkle = example['merkle_components']
          require(type(observed_merkle['unknown_inputs']) is list and observed_merkle['unknown_inputs'] == [],
                  'fully specified hypothetical Merkle inputs cannot remain unknown')
          for key, value in expected_merkle.items():
              exact_fraction(observed_merkle['conditional_expressions'][key], value, 'Merkle component ' + key)
              require(observed_merkle['each_expression_meets_component_target'][key] is (value <= merkle['target_error']),
                      'Merkle target comparison must be the exact boolean result: ' + key)
          print('Complete unknown fields and independently recomputed hypothetical components verified; project qualification remains false.')
          PY
      - name: Verify ordered source identity after execution
        id: source_after
        if: always() && steps.source_before.outcome == 'success'
        shell: bash
        run: |
          set -euo pipefail
          args=(--kind "$SOURCE_KIND" --expected-head "$EXPECTED_HEAD")
          if test "$SOURCE_KIND" = prospective-merge; then
            args+=(--expected-base "$EXPECTED_BASE" --expected-merge "$EXPECTED_SOURCE")
          fi
          python3 scripts/ci/verify_ci_source.py "${args[@]}" --output "$W1_QROM_OUT/source-after.json" 2>&1 | tee "$W1_QROM_OUT/source-after.log"
      - name: Require every stage and retain failed or skipped status
        id: status
        if: always()
        shell: bash
        env:
          W1_QROM_STEP_RESULTS: ${{ toJSON(steps) }}
        run: |
          set -euo pipefail
          w1_qrom_out="$RUNNER_TEMP/pon-w1-qrom-historical-v1-$SOURCE_KIND-x64-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          mkdir -p "$w1_qrom_out"
          python3 - "$w1_qrom_out" <<'PY' 2>&1 | tee "$w1_qrom_out/ci-status.log"
          from collections import Counter
          import hashlib
          import json
          import os
          from pathlib import Path
          import sys

          out = Path(sys.argv[1])
          steps = json.loads(os.environ['W1_QROM_STEP_RESULTS'])
          expected_digest = 'ca685b61914435e0be6defdaa0bc4f2368f7430060663315cd96f226adab5bd8'
          required_modules = (
              'test_w1_control_tree_audit',
              'test_w1_qrom_conditional_budget',
              'test_w1_qrom_implementation_audit',
              'test_w1_fri_transcript_audit',
              'test_w1_qrom_workflow_gate',
          )
          def strict_object(pairs):
              result = {}
              for key, value in pairs:
                  if key in result:
                      raise ValueError('duplicate JSON key: ' + key)
                  result[key] = value
              return result

          def refuse_constant(value):
              raise ValueError('nonfinite JSON number: ' + value)

          def strict_json(raw):
              return json.loads(raw, object_pairs_hook=strict_object, parse_constant=refuse_constant)

          def check_named_completion():
              roster_raw = (out / 'required-tests.json').read_bytes()
              if (hashlib.sha256(roster_raw).hexdigest() != expected_digest
                      or roster_raw != Path('config/pon/w1-qrom-required-tests-v1.json').read_bytes()):
                  raise ValueError('retained named-test roster differs from the reviewed source pin')
              manifest = strict_json(roster_raw)
              if (type(manifest) is not dict
                      or manifest.get('schema') != 'TRNM-W1-QROM-REQUIRED-TESTS1'
                      or type(manifest.get('suites')) is not list
                      or any(type(row) is not dict for row in manifest['suites'])
                      or tuple(row.get('module') for row in manifest['suites']) != required_modules
                      or type(manifest.get('expected_tests')) is not int):
                  raise ValueError('fixed roster schema, suite order or total invalid')
              completion_raw = (out / 'named-tests.json').read_bytes()
              completion = strict_json(completion_raw)
              expected_fields = {
                  'schema', 'roster_sha256', 'required_tests', 'suites',
                  'all_named_controls_passed', 'post_quantum_soundness_qualified',
                  'unconditional_project_security_bits',
              }
              if (type(completion) is not dict or set(completion) != expected_fields
                      or completion['schema'] != 'TRNM-W1-QROM-NAMED-TEST-OBSERVATION1'
                      or completion['roster_sha256'] != expected_digest
                      or type(completion['required_tests']) is not int
                      or completion['required_tests'] != manifest['expected_tests']
                      or completion['all_named_controls_passed'] is not True
                      or completion['post_quantum_soundness_qualified'] is not False
                      or completion['unconditional_project_security_bits'] is not None
                      or type(completion['suites']) is not list
                      or len(completion['suites']) != len(required_modules)):
                  raise ValueError('named-test completion schema, total or scope invalid')
              suite_fields = {
                  'module', 'expected_ids', 'passed', 'registered_ids', 'loader_errors',
                  'tests_run', 'started_ids', 'success_ids', 'skipped', 'failures', 'errors',
                  'expected_failures', 'unexpected_successes',
              }
              total = 0
              all_required = []
              for required_suite, observed in zip(manifest['suites'], completion['suites']):
                  names, count = required_suite.get('tests'), required_suite.get('expected_tests')
                  if (type(names) is not list or any(type(name) is not str for name in names)
                          or type(count) is not int or count <= 0
                          or len(names) != count or len(set(names)) != count
                          or type(observed) is not dict or set(observed) != suite_fields
                          or observed['module'] != required_suite['module']
                          or observed['passed'] is not True
                          or type(observed['tests_run']) is not int or observed['tests_run'] != count):
                      raise ValueError('named-test suite identity, fields or count invalid')
                  for field in ('expected_ids', 'registered_ids', 'started_ids', 'success_ids'):
                      actual = observed[field]
                      if (type(actual) is not list or any(type(name) is not str for name in actual)
                              or Counter(actual) != Counter(names)):
                          raise ValueError('named-test completion lost exact identities: '
                                           + required_suite['module'] + '.' + field)
                  for field in ('loader_errors', 'skipped', 'failures', 'errors',
                                'expected_failures', 'unexpected_successes'):
                      if type(observed[field]) is not list or observed[field]:
                          raise ValueError('named-test completion retained a non-success outcome: '
                                           + required_suite['module'] + '.' + field)
                  total += count
                  all_required.extend(names)
              if total != manifest['expected_tests'] or len(set(all_required)) != total:
                  raise ValueError('named-test completion has an invalid total or duplicate required ID')
              return hashlib.sha256(completion_raw).hexdigest()

          named_completion_error = None
          named_completion_sha256 = None
          try:
              named_completion_sha256 = check_named_completion()
          except Exception as error:
              named_completion_error = str(error)
          required = (
              'observations', 'checkout', 'source_before', 'preflight', 'named_tests',
              'implementation', 'budget_unknown', 'budget_hypothetical',
              'report_scopes', 'source_after',
          )
          incomplete = [name for name in required if
                        steps.get(name, {}).get('outcome') != 'success'
                        or steps.get(name, {}).get('conclusion') != 'success']
          identity_error = None
          if not incomplete:
              try:
                  before = json.loads((out / 'source-before.json').read_text())
                  after = json.loads((out / 'source-after.json').read_text())
                  if (before != after or before.get('schema') != 'trnm-ci-source-v1'
                          or before.get('kind') != os.environ['SOURCE_KIND']
                          or before.get('tested_commit') != os.environ['EXPECTED_SOURCE']
                          or before.get('candidate') != os.environ['EXPECTED_HEAD']
                          or before.get('tracked_worktree_verified') is not True):
                      raise ValueError('source identities disagree or do not bind the requested source')
              except (OSError, ValueError, TypeError) as error:
                  identity_error = str(error)
          report = {
              'schema': 'TRNM-W1-QROM-CI-OBSERVATION1',
              'source_kind': os.environ['SOURCE_KIND'],
              'expected_source': os.environ['EXPECTED_SOURCE'],
              'expected_candidate': os.environ['EXPECTED_HEAD'],
              'expected_base': os.environ['EXPECTED_BASE'],
              'steps': steps,
              'required_stages': required,
              'failed_or_skipped_stages': incomplete,
              'source_identity_error': identity_error,
              'named_test_completion_error': named_completion_error,
              'named_test_completion_sha256': named_completion_sha256,
              'named_test_completion_verified': named_completion_error is None,
              'all_required_observations_passed': not incomplete and identity_error is None
                  and named_completion_error is None,
              'scope': 'Offline construction and saved-fixture mapping with conditional arithmetic. This workflow does not establish proof or quantum security.',
              'post_quantum_soundness_qualified': False,
              'complete_w1_soundness_qualified': False,
              'quantum_work_qualified': False,
              'pq_signature_qualification_inferred': False,
              'production_qualified': False,
              'consensus_admission': False,
              'unconditional_project_security_bits': None,
          }
          with (out / 'ci-status.json').open('x') as stream:
              json.dump(report, stream, indent=2, sort_keys=True, allow_nan=False)
              stream.write('\n')
          if report['all_required_observations_passed'] is not True:
              raise SystemExit('required observations failed, were skipped or lost source identity: '
                               + ', '.join(incomplete) + '; ' + str(identity_error)
                               + '; named completion: ' + str(named_completion_error))
          print('All required exact-source observations completed; project security remains unqualified.')
          PY
      - name: Retain source identities reports logs and every failure
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: w1-qrom-historical-v1-x64-${{ env.EXPECTED_SOURCE }}-${{ github.run_attempt }}
          path: ${{ runner.temp }}/pon-w1-qrom-historical-v1-head-x64-${{ github.run_id }}-${{ github.run_attempt }}/
          if-no-files-found: error
          retention-days: 30

  qrom-current-implementation:
    name: W1 QROM current V2 (${{ matrix.source }}, x64)
    runs-on: ubuntu-24.04
    timeout-minutes: 20
    strategy:
      fail-fast: false
      matrix:
        source: [head, prospective-merge]
    env:
      SOURCE_KIND: ${{ matrix.source }}
      EXPECTED_SOURCE: ${{ matrix.source == 'head' && github.event.pull_request.head.sha || github.sha }}
      EXPECTED_HEAD: ${{ github.event.pull_request.head.sha }}
      EXPECTED_BASE: ${{ github.event.pull_request.base.sha }}
    steps:
      - name: Reserve current-source observations
        id: observations
        shell: bash
        run: |
          set -euo pipefail
          w1_qrom_current_out="$RUNNER_TEMP/pon-w1-qrom-current-v2-$SOURCE_KIND-x64-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          mkdir "$w1_qrom_current_out"
          mkdir "$w1_qrom_current_out/supplemental"
          printf 'W1_QROM_SUPPLEMENTAL_OUT=%s\n' "$w1_qrom_current_out/supplemental" >> "$GITHUB_ENV"
          printf 'W1_QROM_CURRENT_OUT=%s\n' "$w1_qrom_current_out" >> "$GITHUB_ENV"
          printf 'Current V2 source mapping and original V1 source-pin refusal. Historical V1 positive replay is a separate fixed-source job. All cryptographic, native-execution and production qualifications remain false.\n' > "$w1_qrom_current_out/SCOPE.txt"
          python3 --version > "$w1_qrom_current_out/python-version.txt" 2>&1
      - name: Checkout exact current candidate without persistent credentials
        id: checkout
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ env.EXPECTED_SOURCE }}
          fetch-depth: 0
          persist-credentials: false
      - name: Verify complete current source before observations
        id: source_before
        if: always() && steps.observations.outcome == 'success' && steps.checkout.outcome == 'success'
        shell: bash
        run: |
          set -euo pipefail
          args=(--kind "$SOURCE_KIND" --expected-head "$EXPECTED_HEAD")
          if test "$SOURCE_KIND" = prospective-merge; then
            args+=(--expected-base "$EXPECTED_BASE" --expected-merge "$EXPECTED_SOURCE")
          fi
          python3 scripts/ci/verify_ci_source.py "${args[@]}" --output "$W1_QROM_CURRENT_OUT/source-before.json" 2>&1 | tee "$W1_QROM_CURRENT_OUT/source-before.log"
      - name: Audit the current project boundary
        id: preflight
        if: always() && steps.source_before.outcome == 'success'
        shell: bash
        run: |
          set -euo pipefail
          bash scripts/project-preflight.sh --audit 2>&1 | tee "$W1_QROM_CURRENT_OUT/preflight.log"
      - name: Execute all fixed current-source named controls
        id: named_tests
        if: always() && steps.preflight.outcome == 'success'
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/ci/w1_qrom_current_ci.py named --repo-root "$GITHUB_WORKSPACE" --out "$W1_QROM_CURRENT_OUT" 2>&1 | tee "$W1_QROM_CURRENT_OUT/named-tests.log"
      - name: Retain original V1 refusal and exact current source differences
        id: historical_drift
        if: always() && steps.preflight.outcome == 'success'
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/ci/w1_qrom_current_ci.py drift --repo-root "$GITHUB_WORKSPACE" --out "$W1_QROM_CURRENT_OUT" 2>&1 | tee "$W1_QROM_CURRENT_OUT/historical-drift.log"
      - name: Reproduce the explicit current V2 mapping
        id: implementation
        if: always() && steps.preflight.outcome == 'success'
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/w1_qrom_current_implementation_audit.py --repo-root "$GITHUB_WORKSPACE" --output "$W1_QROM_CURRENT_OUT/implementation.json" 2>&1 | tee "$W1_QROM_CURRENT_OUT/implementation.log"
      - name: Verify historical Git materialization and current refusal controls
        id: supplemental_historical_controls
        if: always() && steps.preflight.outcome == 'success'
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/ci/w1_qrom_supplemental_controls.py --suite historical \
            --repo-root "$GITHUB_WORKSPACE" --output-dir "$W1_QROM_SUPPLEMENTAL_OUT" \
            2>&1 | tee "$W1_QROM_SUPPLEMENTAL_OUT/historical-controls.log"
      - name: Reproduce the historical map and retain current-tree v1 refusal
        id: supplemental_historical_mapping
        if: always() && steps.preflight.outcome == 'success'
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/w1_qrom_historical_fixture.py --repo-root "$GITHUB_WORKSPACE" \
            --output-dir "$W1_QROM_SUPPLEMENTAL_OUT" 2>&1 | tee "$W1_QROM_SUPPLEMENTAL_OUT/implementation.log"
      - name: Check the separately reviewed current-source mapping
        id: supplemental_current_mapping
        if: always() && steps.preflight.outcome == 'success'
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/ci/w1_qrom_supplemental_controls.py --suite current \
            --repo-root "$GITHUB_WORKSPACE" --output-dir "$W1_QROM_SUPPLEMENTAL_OUT" \
            2>&1 | tee "$W1_QROM_SUPPLEMENTAL_OUT/current-controls.log"
          python3 scripts/w1_qrom_current_implementation_audit.py --repo-root "$GITHUB_WORKSPACE" \
            --output "$W1_QROM_SUPPLEMENTAL_OUT/implementation-current.json" 2>&1 | tee "$W1_QROM_SUPPLEMENTAL_OUT/implementation-current.log"
      - name: Preserve all unknown project quantum inputs
        id: supplemental_budget_unknown
        if: always() && steps.preflight.outcome == 'success'
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/w1_qrom_conditional_budget.py > "$W1_QROM_SUPPLEMENTAL_OUT/budget-unknown.json" 2> "$W1_QROM_SUPPLEMENTAL_OUT/budget-unknown.log"
      - name: Reproduce explicitly hypothetical component arithmetic
        id: supplemental_budget_hypothetical
        if: always() && steps.preflight.outcome == 'success'
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/w1_qrom_conditional_budget.py --example-input \
            > "$W1_QROM_SUPPLEMENTAL_OUT/budget-hypothetical-input.json" 2> "$W1_QROM_SUPPLEMENTAL_OUT/budget-hypothetical-input.log"
          python3 scripts/w1_qrom_conditional_budget.py --input "$W1_QROM_SUPPLEMENTAL_OUT/budget-hypothetical-input.json" \
            > "$W1_QROM_SUPPLEMENTAL_OUT/budget-hypothetical.json" 2> "$W1_QROM_SUPPLEMENTAL_OUT/budget-hypothetical.log"
      - name: Require every report to retain the unqualified security boundary
        id: supplemental_report_scopes
        if: always() && steps.supplemental_historical_mapping.outcome == 'success' && steps.supplemental_current_mapping.outcome == 'success' && steps.supplemental_budget_unknown.outcome == 'success' && steps.supplemental_budget_hypothetical.outcome == 'success'
        shell: bash
        run: |
          set -euo pipefail
          python3 - "$W1_QROM_SUPPLEMENTAL_OUT" <<'PY' 2>&1 | tee "$W1_QROM_SUPPLEMENTAL_OUT/report-scopes.log"
          from fractions import Fraction
          import json
          from pathlib import Path
          import re
          import sys

          # These generators re-read the reviewed source contracts and actual
          # checkout. Reports cannot vouch for one another's source identities.
          repo_root = Path.cwd()
          sys.path.insert(0, str(repo_root / 'scripts'))
          import w1_qrom_historical_fixture as historical_materializer
          import w1_qrom_current_implementation_audit as current_mapper
          import w1_qrom_supplemental_controls as supplemental_controls

          out = Path(sys.argv[1])
          supplemental_controls.verify_completions(repo_root, out)
          def require(condition, message):
              if not condition:
                  raise ValueError(message)

          def strict_object(pairs):
              result = {}
              for key, value in pairs:
                  require(key not in result, 'duplicate JSON key: ' + key)
                  result[key] = value
              return result

          def refuse_constant(value):
              raise ValueError('nonfinite JSON number: ' + value)

          def read(name):
              return json.loads((out / name).read_bytes(), object_pairs_hook=strict_object,
                                parse_constant=refuse_constant)

          def fields(value, expected, label):
              require(type(value) is dict and set(value) == set(expected), label + ': exact fields required')

          def exact_qualification(observed, expected):
              return (type(observed) is dict and set(observed) == set(expected)
                      and all(observed[key] is value for key, value in expected.items()))

          def exact_observation(observed, expected, label):
              # Canonical JSON also distinguishes bool/int and int/float values;
              # Python container equality alone would accept True == 1.
              canonical = lambda value: json.dumps(value, sort_keys=True,
                  separators=(',', ':'), allow_nan=False)
              require(canonical(observed) == canonical(expected),
                      label + ': differs from the actual reviewed-source observation')

          implementation = read('implementation.json')
          expected_implementation = {
              'post_quantum_soundness_qualified': False,
              'complete_w1_soundness_qualified': False,
              'quantum_work_qualified': False,
              'pq_signature_qualification_inferred': False,
              'production_qualified': False,
              'consensus_admission': False,
              'security_bits_quantum': None,
          }
          require(type(implementation) is dict
                  and implementation.get('schema') == 'TRNM-W1-QROM-IMPLEMENTATION-AUDIT1'
                  and implementation.get('result') == 'MAPPING_REPRODUCED_SECURITY_HOLD'
                  and exact_qualification(implementation.get('qualification'), expected_implementation),
                  'implementation observation widened its qualification scope')
          historical_revision = 'cb114b13bf848a77634e40a08b31b30c7c758e7b'
          historical_contract = '7761787fca9ea92c7b678186ccb302900bfabc974460b7f6793c7a0aabb6cf22'
          historical_reader = 'c6fc6c36e4c2ce198c1dad465a7d36495253f844438f46df652715ea6dc8b354'
          refusal_reason = 'input exceeds bound: formal/pon-nakamoto-v1/w1_v2_verifier/src/main.rs'
          require(implementation.get('source_base_commit') == historical_revision
                  and implementation.get('contract_sha256') == historical_contract,
                  'historical mapping cannot be relabeled as current-source evidence')
          historical = read('historical-source.json')
          fields(historical, {
              'schema', 'historical_source_commit', 'historical_contract_sha256',
              'historical_reader_sha256', 'project_files', 'pinned_checkout_inputs', 'scope',
              'historical_full_repository_checked', 'current_project_mapping',
              'fresh_cryptographic_verification', 'qualification',
          }, 'historical materialization')
          require(historical['schema'] == 'TRNM-W1-QROM-HISTORICAL-MATERIALIZATION1'
                  and historical['historical_source_commit'] == historical_revision
                  and historical['historical_contract_sha256'] == historical_contract
                  and historical['historical_reader_sha256'] == historical_reader
                  and historical['scope'] == 'historical-declared-project-blobs-and-pinned-fixtures-only'
                  and exact_qualification(historical['qualification'], expected_implementation)
                  and historical['historical_full_repository_checked'] is False
                  and historical['current_project_mapping'] is False
                  and historical['fresh_cryptographic_verification'] is False,
                  'historical materialization scope or identity differs')
          rows = historical['project_files']
          require(type(rows) is list and len(rows) == len(implementation['project_files'])
                  and len(rows) > 0, 'historical source roster is incomplete')
          for row, expected in zip(rows, implementation['project_files']):
              fields(row, {'path', 'bytes', 'sha256', 'git_mode', 'git_blob_oid'}, 'historical Git source')
              require({key: row[key] for key in ('path', 'bytes', 'sha256')} == expected
                      and row['git_mode'] in ('100644', '100755')
                      and type(row['git_blob_oid']) is str
                      and re.fullmatch(r'[0-9a-f]{40}', row['git_blob_oid']) is not None,
                      'historical Git source record differs')
          expected_pinned = (implementation['helper_execution']['sources']
                             + implementation['saved_fixture_files']
                             + [implementation['upstream_snapshot']])
          require(historical['pinned_checkout_inputs'] == expected_pinned,
                  'historical helper and saved-fixture identities differ')
          refusal = read('current-v1-refusal.json')
          fields(refusal, {
              'schema', 'result', 'reason', 'historical_source_commit',
              'historical_contract_sha256', 'historical_reader_sha256', 'target',
              'current_source_mapping_performed', 'qualification',
          }, 'current-tree v1 refusal')
          require(refusal['schema'] == 'TRNM-W1-QROM-HISTORICAL-CURRENT-REFUSAL1'
                  and refusal['result'] == 'INPUT_REJECTED' and refusal['reason'] == refusal_reason
                  and refusal['historical_source_commit'] == historical_revision
                  and refusal['historical_contract_sha256'] == historical_contract
                  and refusal['historical_reader_sha256'] == historical_reader
                  and refusal['target'] == 'actual-current-worktree'
                  and refusal['current_source_mapping_performed'] is False
                  and exact_qualification(refusal['qualification'], expected_implementation),
                  'current-tree refusal cannot become a historical or current mapping pass')
          current = read('implementation-current.json')
          require(type(current) is dict
                  and current.get('schema') == 'TRNM-W1-QROM-CURRENT-IMPLEMENTATION-AUDIT2'
                  and current.get('result') == 'CURRENT_MAPPING_REPRODUCED_SECURITY_HOLD'
                  and current.get('source_base_commit') != historical_revision
                  and exact_qualification(current.get('qualification'), expected_implementation),
                  'separate current-source mapping is missing or widened its qualification')
          old_refusal = current.get('historical_v1')
          require(type(old_refusal) is dict
                  and old_refusal.get('reader_sha256') == historical_reader
                  and old_refusal.get('contract_sha256') == historical_contract
                  and old_refusal.get('result') == 'INPUT_REJECTED'
                  and old_refusal.get('reason') == refusal_reason
                  and old_refusal.get('named_roster_completed') is False
                  and old_refusal.get('workflow_passed') is False,
                  'current mapping must preserve the original historical-reader refusal')
          closure = current.get('local_path_closure')
          require(type(closure) is dict and closure.get('source_before_after_equal') is True
                  and type(closure.get('source_files_checked')) is int
                  and type(closure.get('files')) is list
                  and closure['source_files_checked'] == len(closure['files']) > 0,
                  'current-source declared closure is incomplete or changed')
          for flag in ('fresh_cryptographic_verification', 'native_binary_executed',
                       'whole_repository_source_verified', 'third_party_source_closure_verified',
                       'provider_build_identity_verified', 'git_commit_ancestry_verified'):
              require(current.get(flag) is False, 'current-source mapping widened: ' + flag)
          expected_historical, expected_materialization = historical_materializer.historical_mapping(repo_root)
          exact_observation(implementation, expected_historical, 'historical mapping')
          exact_observation(historical, expected_materialization, 'historical Git materialization')
          exact_observation(refusal, historical_materializer.current_v1_refusal(repo_root),
                            'current-tree historical refusal')
          exact_observation(current, current_mapper.build_report(repo_root), 'current-source mapping')
          expected_budget = {
              'unconditional_project_security_bits': None,
              'quantum_security_bits': None,
              'full_recursive_security_bits': None,
              'qrom_theorem_instantiated': False,
              'post_quantum_soundness_qualified': False,
              'whole_recursive_proof_soundness_qualified': False,
              'complete_w1_attack_established': False,
              'production_qualified': False,
              'consensus_admission': False,
          }
          pqsr_fields = {'t', 'k', 'w', 'r_min', 'kappa_rrbr', 'target_error'}
          merkle_fields = {'t', 'k', 'w_vc', 'sigma', 'ell_max', 'n', 'q_s', 'target_error'}
          component_names = {
              'commutativity', 'extraction_correctness',
              'offline_extractability', 'online_indistinguishability',
          }
          pqsr_numbers = (
              'rrbr_coefficient', 'finite_randomness_addend',
              'rrbr_addend', 'conditional_upper_expression',
          )
          target_fields = {
              'finite_randomness_addend_exceeds_target',
              'some_nonnegative_rrbr_bound_can_meet_target_by_this_expression',
              'kappa_rrbr_required_at_most',
          }
          budget_fields = {
              'schema', 'status', 'source', 'inputs', 'pqsr_component', 'merkle_components',
              'theorem_11_3_full_bound', 'theorem_10_6_composed_bound',
              'qualification', 'unresolved_obligations',
          }
          def input_fields(inputs):
              fields(inputs, {'schema', 'input_kind', 'pqsr', 'merkle'}, 'inputs')
              require(inputs['schema'] == 'TRNM-W1-QROM-CONDITIONAL-INPUT1'
                      and inputs['input_kind'] == 'hypothetical', 'hypothetical input schema required')
              fields(inputs['pqsr'], pqsr_fields, 'inputs.pqsr')
              fields(inputs['merkle'], merkle_fields, 'inputs.merkle')

          def report_shape(report):
              fields(report, budget_fields, 'component report')
              require(report['schema'] == 'TRNM-W1-QROM-CONDITIONAL-COMPONENTS1'
                      and report['status'] == 'hypothetical_component_arithmetic_only'
                      and report['theorem_11_3_full_bound'] is None
                      and report['theorem_10_6_composed_bound'] is None
                      and exact_qualification(report['qualification'], expected_budget),
                      'conditional component report widened its theorem or project scope')
              source = report['source']
              fields(source, {'paper', 'indexed_copy', 'indexed_manuscript_date',
                             'latest_revision_date_observed_in_metadata',
                             'latest_revision_full_text_equivalence_verified', 'scope'}, 'source')
              require(source['indexed_manuscript_date'] == '2026-01-01'
                      and source['latest_revision_full_text_equivalence_verified'] is False,
                      'component arithmetic must retain the selected January statement boundary')
              require(type(report['unresolved_obligations']) is list and report['unresolved_obligations']
                      and all(type(item) is str and item for item in report['unresolved_obligations']),
                      'unresolved obligations must remain explicit')
              input_fields(report['inputs'])
              pqsr = report['pqsr_component']
              fields(pqsr, set(pqsr_numbers) | {'theorem', 'conditional_expression_meets_target',
                     'target_analysis', 'unknown_inputs', 'boundary'}, 'pqsr_component')
              require(pqsr['theorem'] == '2026-01-01 manuscript, Theorem 6.10, page 46'
                      and type(pqsr['boundary']) is str and pqsr['boundary'], 'PQSR theorem boundary missing')
              fields(pqsr['target_analysis'], target_fields, 'PQSR target analysis')
              merkle = report['merkle_components']
              fields(merkle, {'theorem', 'conditional_expressions', 'each_expression_meets_component_target',
                              'unknown_inputs', 'boundary'}, 'merkle_components')
              require(merkle['theorem'] == '2026-01-01 manuscript, Theorem 8.3, page 53'
                      and type(merkle['boundary']) is str and merkle['boundary'], 'Merkle theorem boundary missing')
              fields(merkle['conditional_expressions'], component_names, 'Merkle expressions')
              fields(merkle['each_expression_meets_component_target'], component_names, 'Merkle comparisons')

          unknown = read('budget-unknown.json')
          example = read('budget-hypothetical.json')
          for report in (unknown, example):
              report_shape(report)
          for group in ('pqsr', 'merkle'):
              require(all(value is None for value in unknown['inputs'][group].values()),
                      'unknown inputs must remain null with the complete field set')
          unknown_pqsr = unknown['pqsr_component']
          require(all(unknown_pqsr[key] is None for key in pqsr_numbers)
                  and unknown_pqsr['conditional_expression_meets_target'] is None
                  and all(value is None for value in unknown_pqsr['target_analysis'].values())
                  and unknown_pqsr['unknown_inputs'] == sorted(pqsr_fields),
                  'every unknown PQSR derived value, comparison and threshold must remain null')
          unknown_merkle = unknown['merkle_components']
          require(all(value is None for value in unknown_merkle['conditional_expressions'].values())
                  and all(value is None for value in unknown_merkle['each_expression_meets_component_target'].values())
                  and unknown_merkle['unknown_inputs'] == sorted(merkle_fields),
                  'every unknown named Merkle expression and comparison must remain null')

          # Independent stdlib Fraction arithmetic for the retained hypothetical input.
          # Do not import or call the calculator to validate its own derived values.
          def integer_text(value, label, minimum=0, maximum=None):
              require(type(value) is str and len(value) <= 617
                      and re.fullmatch(r'0|[1-9][0-9]*', value) is not None,
                      label + ': canonical exact integer string required')
              number = int(value)
              require(number.bit_length() <= 2048 and number >= minimum
                      and (maximum is None or number <= maximum), label + ': input outside evaluator bounds')
              return number

          def fraction_value(value, label, reported):
              if not reported and type(value) is str:
                  return Fraction(integer_text(value, label))
              fields(value, {'numerator', 'denominator'}, label)
              numerator = integer_text(value['numerator'], label + '.numerator')
              denominator = integer_text(value['denominator'], label + '.denominator', 1)
              number = Fraction(numerator, denominator)
              require(value == {'numerator': str(number.numerator), 'denominator': str(number.denominator)},
                      label + ': reduced exact fraction required')
              return number

          def parse_known_inputs(inputs, reported):
              input_fields(inputs)
              pqsr_raw, merkle_raw = inputs['pqsr'], inputs['merkle']
              pqsr = {key: integer_text(pqsr_raw[key], 'pqsr.' + key, int(key != 't'),
                                       4096 if key == 'r_min' else None)
                      for key in ('t', 'k', 'r_min')}
              pqsr.update({key: fraction_value(pqsr_raw[key], 'pqsr.' + key, reported)
                           for key in ('w', 'kappa_rrbr', 'target_error')})
              merkle = {key: integer_text(merkle_raw[key], 'merkle.' + key,
                                         int(key in ('k', 'sigma', 'ell_max')),
                                         4096 if key == 'sigma' else None)
                        for key in ('t', 'k', 'sigma', 'ell_max', 'n', 'q_s')}
              merkle.update({key: fraction_value(merkle_raw[key], 'merkle.' + key, reported)
                             for key in ('w_vc', 'target_error')})
              require(pqsr['w'] <= pqsr['t'] and pqsr['kappa_rrbr'] <= 1
                      and 0 < pqsr['target_error'] <= 1, 'PQSR query mass or probability domain invalid')
              length = merkle['ell_max']
              require(merkle['w_vc'] <= merkle['t'] and 0 < merkle['target_error'] <= 1
                      and length & (length - 1) == 0 and merkle['n'] <= merkle['k']
                      and merkle['q_s'] <= merkle['k'] * length, 'Merkle lengths, query mass or probability domain invalid')
              return pqsr, merkle

          retained_input = read('budget-hypothetical-input.json')
          pqsr, merkle = parse_known_inputs(retained_input, reported=False)
          require(parse_known_inputs(example['inputs'], reported=True) == (pqsr, merkle),
                  'hypothetical report must preserve every exact retained illustrative input')
          def exact_fraction(observed, expected, label):
              if expected is None:
                  require(observed is None, label + ': expected an unavailable threshold')
                  return
              require(type(observed) is dict
                      and set(observed) == {'numerator', 'denominator'}
                      and all(type(value) is str for value in observed.values())
                      and observed == {'numerator': str(expected.numerator), 'denominator': str(expected.denominator)},
                      label + ': derived fraction differs from independent arithmetic')

          t, k, w = pqsr['t'], pqsr['k'], pqsr['w']
          coefficient = 80 * (t + k + 1) * (w + k)
          finite = Fraction((t + k + 1) * k, 1 << pqsr['r_min'])
          rrbr = coefficient * pqsr['kappa_rrbr']
          upper = rrbr + finite
          expected_pqsr = {
              'rrbr_coefficient': coefficient,
              'finite_randomness_addend': finite,
              'rrbr_addend': rrbr,
              'conditional_upper_expression': upper,
          }
          observed_pqsr = example['pqsr_component']
          require(type(observed_pqsr['unknown_inputs']) is list and observed_pqsr['unknown_inputs'] == [],
                  'fully specified hypothetical PQSR inputs cannot remain unknown')
          for key, value in expected_pqsr.items():
              exact_fraction(observed_pqsr[key], value, 'pqsr_component.' + key)
          target = pqsr['target_error']
          require(observed_pqsr['conditional_expression_meets_target'] is (upper <= target),
                  'PQSR target comparison must be the exact boolean result')
          analysis = observed_pqsr['target_analysis']
          feasible = finite <= target
          require(analysis['finite_randomness_addend_exceeds_target'] is (finite > target)
                  and analysis['some_nonnegative_rrbr_bound_can_meet_target_by_this_expression'] is feasible,
                  'PQSR finite-addend comparisons must be exact booleans')
          required_rrbr = min(Fraction(1), (target - finite) / coefficient) if feasible else None
          exact_fraction(analysis['kappa_rrbr_required_at_most'], required_rrbr, 'PQSR required RRBR threshold')

          t, w_vc, length = merkle['t'], merkle['w_vc'], merkle['ell_max']
          denominator = 1 << merkle['sigma']
          expected_merkle = {
              'commutativity': Fraction(240 * (t + 1), denominator),
              'extraction_correctness': Fraction(8 * merkle['n'] * length, denominator),
              'offline_extractability': (160 * w_vc * t * t
                  + 16 * merkle['q_s'] * (length.bit_length() - 1)) / denominator,
              'online_indistinguishability': 240 * w_vc * t * t / denominator,
          }
          observed_merkle = example['merkle_components']
          require(type(observed_merkle['unknown_inputs']) is list and observed_merkle['unknown_inputs'] == [],
                  'fully specified hypothetical Merkle inputs cannot remain unknown')
          for key, value in expected_merkle.items():
              exact_fraction(observed_merkle['conditional_expressions'][key], value, 'Merkle component ' + key)
              require(observed_merkle['each_expression_meets_component_target'][key] is (value <= merkle['target_error']),
                      'Merkle target comparison must be the exact boolean result: ' + key)
          print('Complete unknown fields and independently recomputed hypothetical components verified; project qualification remains false.')
          PY
      - name: Verify complete current source after observations
        id: source_after
        if: always() && steps.source_before.outcome == 'success'
        shell: bash
        run: |
          set -euo pipefail
          args=(--kind "$SOURCE_KIND" --expected-head "$EXPECTED_HEAD")
          if test "$SOURCE_KIND" = prospective-merge; then
            args+=(--expected-base "$EXPECTED_BASE" --expected-merge "$EXPECTED_SOURCE")
          fi
          python3 scripts/ci/verify_ci_source.py "${args[@]}" --output "$W1_QROM_CURRENT_OUT/source-after.json" 2>&1 | tee "$W1_QROM_CURRENT_OUT/source-after.log"
      - name: Require all current stages and original historical rejection
        id: status
        if: always()
        shell: bash
        env:
          W1_QROM_CURRENT_STEP_RESULTS: ${{ toJSON(steps) }}
        run: |
          set -euo pipefail
          w1_qrom_current_out="$RUNNER_TEMP/pon-w1-qrom-current-v2-$SOURCE_KIND-x64-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          mkdir -p "$w1_qrom_current_out"
          python3 scripts/ci/w1_qrom_current_ci.py verify --repo-root "$GITHUB_WORKSPACE" --out "$w1_qrom_current_out" --kind "$SOURCE_KIND" --expected-source "$EXPECTED_SOURCE" --expected-head "$EXPECTED_HEAD" --expected-base "$EXPECTED_BASE" 2>&1 | tee "$w1_qrom_current_out/current-ci-status.log"
      - name: Retain complete current-source observations and failures
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: w1-qrom-current-v2-${{ matrix.source }}-x64-${{ env.EXPECTED_SOURCE }}-${{ github.run_attempt }}
          path: ${{ runner.temp }}/pon-w1-qrom-current-v2-${{ matrix.source }}-x64-${{ github.run_id }}-${{ github.run_attempt }}/
          if-no-files-found: error
          retention-days: 30

11db1f8c113d24d711531b4340972af79da0f186 blob 18199
name: W1 QROM proof-chain observations
on:
  pull_request:
    paths:
      - scripts/w1_*.py
      - scripts/ci/**
      - scripts/project-preflight.sh
      - formal/pon-nakamoto-v1/**
      - config/pon/w1-*.json
      - evidence/pon-w1-*/**
      - docs/security/W1_*.md
      - .github/workflows/pon-w1-qrom-proof-chain.yml
      - PROJECT_ID
      - PROJECT_BOUNDARY.json
      - AGENTS.md
permissions:
  contents: read
concurrency:
  group: w1-qrom-proof-chain-${{ github.event.pull_request.number }}
  cancel-in-progress: false
env:
  PYTHONDONTWRITEBYTECODE: "1"
jobs:
  proof-chain:
    name: W1 proof-chain (${{ matrix.source }})
    runs-on: ubuntu-24.04
    timeout-minutes: 20
    strategy:
      fail-fast: false
      matrix:
        source: [head, prospective-merge]
    env:
      SOURCE_KIND: ${{ matrix.source }}
      EXPECTED_SOURCE: ${{ matrix.source == 'head' && github.event.pull_request.head.sha || github.sha }}
      EXPECTED_HEAD: ${{ github.event.pull_request.head.sha }}
      EXPECTED_BASE: ${{ github.event.pull_request.base.sha }}
    steps:
      - name: Reserve fresh observations
        id: observations
        shell: bash
        run: |
          set -euo pipefail
          w1_chain_out="$RUNNER_TEMP/w1-qrom-proof-chain-$SOURCE_KIND-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          mkdir "$w1_chain_out"
          printf 'W1_CHAIN_OUT=%s\n' "$w1_chain_out" >> "$GITHUB_ENV"
          python3 --version > "$w1_chain_out/python-version.txt" 2>&1
      - name: Checkout exact source
        id: checkout
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ env.EXPECTED_SOURCE }}
          fetch-depth: 0
          persist-credentials: false
      - name: Verify source before execution
        id: source_before
        if: always() && steps.observations.outcome == 'success' && steps.checkout.outcome == 'success'
        shell: bash
        run: |
          set -euo pipefail
          args=(--kind "$SOURCE_KIND" --expected-head "$EXPECTED_HEAD")
          if test "$SOURCE_KIND" = prospective-merge; then
            args+=(--expected-base "$EXPECTED_BASE" --expected-merge "$EXPECTED_SOURCE")
          fi
          python3 scripts/ci/verify_ci_source.py "${args[@]}" --output "$W1_CHAIN_OUT/source-before.json" 2>&1 | tee "$W1_CHAIN_OUT/source-before.log"
      - name: Check project boundary
        id: preflight
        if: always() && steps.source_before.outcome == 'success'
        shell: bash
        run: |
          set -euo pipefail
          bash scripts/project-preflight.sh --audit 2>&1 | tee "$W1_CHAIN_OUT/preflight.log"
      - name: Execute pinned named controls
        id: controls
        if: always() && steps.preflight.outcome == 'success'
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/ci/w1_qrom_proof_chain_controls.py run --output "$W1_CHAIN_OUT" 2>&1 | tee "$W1_CHAIN_OUT/controls.log"
      - name: Independently require complete successful test identities
        id: completion
        if: always() && steps.controls.outcome == 'success'
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/ci/w1_qrom_proof_chain_controls.py check --output "$W1_CHAIN_OUT" 2>&1 | tee "$W1_CHAIN_OUT/completion.log"
          python3 - "$W1_CHAIN_OUT" <<'PY' 2>&1 | tee "$W1_CHAIN_OUT/completion-independent.log"
          from collections import Counter
          import hashlib
          import json
          from pathlib import Path
          import sys
          out = Path(sys.argv[1])
          def require(condition, message):
              if not condition:
                  raise ValueError(message)
          def unique(pairs):
              result = {}
              for key, value in pairs:
                  require(key not in result, 'duplicate JSON key')
                  result[key] = value
              return result
          def read(path):
              raw = path.read_bytes()
              require(len(raw) <= 512 * 1024, 'oversized completion record')
              return json.loads(raw, object_pairs_hook=unique)
          roster_path = Path('evidence/pon-w1-qrom-proof-chain-20261108/required-tests.json')
          roster_hash = hashlib.sha256(roster_path.read_bytes()).hexdigest()
          require(roster_hash == '54dceecf6a8fb6d5f91252cbb79427ba92563663c2e8248cf61a10ecb581911c', 'independent roster pin')
          required = read(roster_path)['suites']
          actual = read(out / 'named-controls.json')
          require(actual['schema'] == 'TRNM-W1-QROM-PROOF-CHAIN-CONTROLS1'
                  and actual['roster_sha256'] == roster_hash, 'completion identity')
          require(type(actual['suites']) is list and len(actual['suites']) == len(required),
                  'missing test suite completion')
          count = 0
          for expected, row in zip(required, actual['suites']):
              module, names = expected['module'], expected['tests']
              require(row['module'] == module and row['exception'] is None, 'module failed to complete')
              require(actual['test_source_sha256'][module] == hashlib.sha256(
                  Path('scripts/ci', module + '.py').read_bytes()).hexdigest(), 'test source identity')
              require(type(row['tests_run']) is int and row['tests_run'] == len(names), 'test count')
              for field in ('registered', 'started', 'successful'):
                  require(type(row[field]) is list and Counter(row[field]) == Counter(names),
                          'missing/duplicate test identity')
              for field in ('skipped', 'failures', 'errors', 'expected_failures', 'unexpected_successes'):
                  require(row[field] == [], 'unsuccessful test')
              count += len(names)
          expected_qualification = {'complete_w1_soundness_qualified': False,
              'post_quantum_soundness_qualified': False, 'quantum_work_qualified': False,
              'production_qualified': False, 'unconditional_project_security_bits': None}
          require(actual['qualification'] == expected_qualification and all(
              actual['qualification'][key] is value for key, value in expected_qualification.items()),
              'qualification changed')
          checker = read(out / 'completion.log')
          require(checker == {'result': 'PASS', 'actual_successful_tests': count,
                             'qualification': expected_qualification}
                  and type(checker['actual_successful_tests']) is int, 'checker did not complete')
          with (out / 'completion-independent.json').open('x') as stream:
              json.dump({'result': 'PASS', 'roster_sha256': roster_hash,
                         'actual_successful_tests': count}, stream, sort_keys=True)
              stream.write('\n')
          print('Independently required all ' + str(count) + ' named successful controls.')
          PY
      - name: Replay historical transcript and every opening
        id: replay
        if: always() && steps.preflight.outcome == 'success'
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/w1_fri_query_replay.py --output "$W1_CHAIN_OUT/fri-query-replay.json" 2>&1 | tee "$W1_CHAIN_OUT/replay.log"
      - name: Reproduce separate P3 expression
        id: query_expression
        if: always() && steps.preflight.outcome == 'success'
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/w1_query_expression_feasibility.py > "$W1_CHAIN_OUT/query-expression.json" 2> "$W1_CHAIN_OUT/query-expression.stderr.log"
      - name: Evaluate unknown and explicitly hypothetical BCS envelopes
        id: bcs
        if: always() && steps.preflight.outcome == 'success'
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/w1_qrom_bcs_budget.py > "$W1_CHAIN_OUT/bcs-unknown.json" 2> "$W1_CHAIN_OUT/bcs-unknown.stderr.log"
          python3 scripts/w1_qrom_bcs_budget.py --example > "$W1_CHAIN_OUT/bcs-example.json" 2> "$W1_CHAIN_OUT/bcs-example.stderr.log"
      - name: Require candidate identities and bounded conclusions
        id: report_scopes
        if: always() && steps.replay.outcome == 'success' && steps.query_expression.outcome == 'success' && steps.bcs.outcome == 'success'
        shell: bash
        run: |
          set -euo pipefail
          python3 - "$W1_CHAIN_OUT" <<'PY' 2>&1 | tee "$W1_CHAIN_OUT/report-scopes.log"
          import hashlib
          import json
          from pathlib import Path
          import sys
          out = Path(sys.argv[1])
          def read(name):
              return json.loads((out / name).read_text())
          def require(condition, message):
              if not condition:
                  raise ValueError(message)
          def qualification(actual, false_keys, null_keys, true_keys=()):
              expected = dict.fromkeys(false_keys, False)
              expected.update(dict.fromkeys(null_keys, None))
              expected.update(dict.fromkeys(true_keys, True))
              require(type(actual) is dict and set(actual) == set(expected)
                      and all(actual[key] is value for key, value in expected.items()),
                      'missing, promoted or mistyped qualification')
          r = read('fri-query-replay.json')
          q = read('query-expression.json')
          u, e = read('bcs-unknown.json'), read('bcs-example.json')
          require(r['schema'] == 'TRNM-W1-FRI-QUERY-REPLAY1'
                  and r['profile_id'] == 'trnm-w1-risc0-3.0.6-poseidon2-join-v2'
                  and r['input_profile_source_head'] == '0c830e0be8939ce80c8443c9ad68021b87343a00',
                  'RISC Zero candidate identity changed')
          require(r['receipt']['sha256'] == '6c72828c9d05a62175e08fa3e7e1d0d5e85e785ad96b5beb5ec7a2e2490c26ee'
                  and r['reproduced_checks']['merkle_openings_verified'] == 350
                  and len(r['queries']) == 50
                  and sum(t['opened_leaf_count'] for t in r['merkle_trees']) == 350,
                  'incomplete fixed-input replay')
          require(q['schema'] == 'TRNM-W1-QUERY-EXPRESSION-FEASIBILITY1'
                  and q['profile']['application_revision'] == 'cc836dfc13ef0006eb0878abd8cb5eca9a76bec0'
                  and q['profile']['risc0_parameter_transfer_qualified'] is False,
                  'P3 source attribution changed')
          for report in (u, e):
              require(report['schema'] == 'TRNM-W1-CDHZ-MARCH-BCS-ASSUMED-EXPRESSION1', 'BCS schema changed')
              qualification(report['qualification'], (
                  'complete_manuscript_proof_independently_verified', 'author_erratum_claimed',
                  'component_hypotheses_proved_for_implementation', 'actual_joint_oracle_model_proved',
                  'qrom_theorem_instantiated', 'complete_w1_soundness_qualified',
                  'post_quantum_soundness_qualified', 'quantum_work_qualified',
                  'production_qualified', 'consensus_admission'),
                  ('unconditional_project_security_bits', 'whole_lifetime_failure_bound'),
                  ('pinned_january_to_march_statement_correspondence_verified',))
          require(u['arithmetic_maximized_upper_expression'] is None
                  and e['conditional_expression_on_declared_query_domains'] is not None,
                  'unknown or hypothetical arithmetic scope lost')
          qualification(q['qualification'], (
              'end_to_end_qualified', 'noninteractive_qualified', 'quantum_qualified',
              'recursive_qualified', 'lifecycle_qualified', 'pq128_qualified',
              'theorem_6_10_mapping_qualified', 'theorem_11_3_mapping_qualified'), (
              'unconditional_project_security_bits', 'complete_noninteractive_security_bits',
              'quantum_security_bits', 'recursive_security_bits', 'lifecycle_security_bits'))
          qualification(r['qualification'], (
              'air_validity_checked', 'all_recursive_program_semantics_verified',
              'complete_receipt_verified', 'complete_w1_soundness_qualified', 'consensus_admission',
              'deep_ali_evaluation_checked', 'fri_folding_equations_checked',
              'post_quantum_soundness_qualified', 'production_qualified', 'qrom_instantiated',
              'quantum_work_qualified', 'terminal_polynomial_evaluations_checked'), ('security_bits_quantum',))
          report_names = ('fri-query-replay.json', 'query-expression.json', 'bcs-unknown.json', 'bcs-example.json')
          with (out / 'report-scopes-independent.json').open('x') as stream:
              json.dump({'schema': 'TRNM-W1-QROM-REPORT-SCOPES1', 'result': 'PASS',
                  'strict_qualification_checked': True, 'reports_sha256': {
                      name: hashlib.sha256((out / name).read_bytes()).hexdigest()
                      for name in report_names}}, stream, sort_keys=True)
              stream.write('\n')
          print('Fixed candidates remain distinct; implementation checks and hypothetical arithmetic only.')
          PY
      - name: Verify source after execution
        id: source_after
        if: always() && steps.source_before.outcome == 'success'
        shell: bash
        run: |
          set -euo pipefail
          args=(--kind "$SOURCE_KIND" --expected-head "$EXPECTED_HEAD")
          if test "$SOURCE_KIND" = prospective-merge; then
            args+=(--expected-base "$EXPECTED_BASE" --expected-merge "$EXPECTED_SOURCE")
          fi
          python3 scripts/ci/verify_ci_source.py "${args[@]}" --output "$W1_CHAIN_OUT/source-after.json" 2>&1 | tee "$W1_CHAIN_OUT/source-after.log"
      - name: Require every stage and unchanged exact source
        id: complete
        if: always()
        env:
          STEP_RECORDS: ${{ toJSON(steps) }}
        shell: bash
        run: |
          set -euo pipefail
          python3 - "$W1_CHAIN_OUT" <<'PY'
          import hashlib
          import json
          import os
          from pathlib import Path
          import sys
          out = Path(sys.argv[1])
          steps = json.loads(os.environ['STEP_RECORDS'])
          required = ('observations', 'checkout', 'source_before', 'preflight', 'controls',
                      'completion', 'replay', 'query_expression', 'bcs', 'report_scopes', 'source_after')
          incomplete = [name for name in required if any(
              steps.get(name, {}).get(field) != 'success' for field in ('outcome', 'conclusion'))]
          identity_error = None
          try:
              before = json.loads((out / 'source-before.json').read_text())
              after = json.loads((out / 'source-after.json').read_text())
              if (before != after or before.get('tested_commit') != os.environ['EXPECTED_SOURCE']
                      or before.get('tracked_worktree_verified') is not True):
                  raise ValueError('source identity or bytes changed')
              completion = json.loads((out / 'completion-independent.json').read_text())
              if (completion.get('result') != 'PASS'
                      or completion.get('roster_sha256') != '54dceecf6a8fb6d5f91252cbb79427ba92563663c2e8248cf61a10ecb581911c'
                      or type(completion.get('actual_successful_tests')) is not int
                      or completion['actual_successful_tests'] != 69):
                  raise ValueError('independent named completion missing or incomplete')
              boundary = json.loads((out / 'preflight.log').read_text())
              if (boundary.get('result') != 'PASS' or boundary.get('mode') != '--audit'
                      or boundary.get('project') != 'trillionnium-chain'
                      or boundary.get('remote_policy_mutated') is not False):
                  raise ValueError('project boundary check did not complete')
              scopes = json.loads((out / 'report-scopes-independent.json').read_text())
              names = ('fri-query-replay.json', 'query-expression.json', 'bcs-unknown.json', 'bcs-example.json')
              if (scopes.get('schema') != 'TRNM-W1-QROM-REPORT-SCOPES1'
                      or scopes.get('result') != 'PASS' or scopes.get('strict_qualification_checked') is not True
                      or scopes.get('reports_sha256') != {
                          name: hashlib.sha256((out / name).read_bytes()).hexdigest() for name in names}):
                  raise ValueError('report scope check did not complete or report bytes changed')
          except (OSError, ValueError, TypeError, KeyError) as error:
              identity_error = str(error)
          passed = not incomplete and identity_error is None
          result = {'schema': 'TRNM-W1-QROM-PROOF-CHAIN-HOSTED1', 'source_kind': os.environ['SOURCE_KIND'],
                    'expected_source': os.environ['EXPECTED_SOURCE'], 'steps': steps,
                    'required_stages': required, 'failed_or_skipped_stages': incomplete,
                    'source_identity_error': identity_error, 'all_required_observations_passed': passed,
                    'post_quantum_soundness_qualified': False, 'complete_w1_soundness_qualified': False,
                    'production_qualified': False, 'unconditional_project_security_bits': None}
          with (out / 'ci-status.json').open('x') as stream:
              json.dump(result, stream, indent=2, sort_keys=True)
              stream.write('\n')
          if not passed:
              raise SystemExit('Required observations incomplete: ' + ', '.join(incomplete) + '; ' + str(identity_error))
          print('All exact-source observations completed; QROM qualification remains HOLD.')
          PY
      - name: Retain full observations and failures
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: w1-qrom-proof-chain-${{ matrix.source }}-${{ env.EXPECTED_SOURCE }}-${{ github.run_attempt }}
          path: ${{ runner.temp }}/w1-qrom-proof-chain-${{ matrix.source }}-${{ github.run_id }}-${{ github.run_attempt }}/
          if-no-files-found: error
          retention-days: 30

6b0ea0fcceb61c245cb516ba4a8bb2e9c0570ad8 blob 36890
name: PoN W1 transparent candidate observations
on:
  pull_request:
    paths:
      - formal/pon-nakamoto-v1/w1_hardened_verifier/**
      - formal/pon-nakamoto-v1/w1_v2_verifier/**
      - formal/pon-nakamoto-v1/w1_native_cost/**
      - formal/pon-nakamoto-v1/w1_zkvm/**
      - formal/pon-nakamoto-v1/experiments/w1_full_staged_run.py
      - formal/pon-nakamoto-v1/experiments/w1_stage_measure.py
      - formal/pon-nakamoto-v1/experiments/w1_local_payload.py
      - trillionnium/**
      - scripts/w1_transparent_compare.py
      - scripts/w1_profile_source_map.py
      - scripts/w1_security_budget.py
      - scripts/w1_v2_receipt_controls.py
      - scripts/run_w1_receiver.py
      - scripts/run_w1_postwin_proof.py
      - scripts/run_w1_deployment_comparison.py
      - scripts/audit_w1_deployment_comparison.py
      - scripts/build_w1_kaggle_source.py
      - scripts/kaggle_generation_contract_v2.py
      - scripts/test_kaggle_generation_contract_v2.py
      - scripts/w1_generation_target_v2.py
      - scripts/test_w1_generation_target_v2.py
      - scripts/w1_owner_cancellation_v1.py
      - scripts/test_w1_owner_cancellation_v1.py
      - scripts/w1_owned_generation_runtime_v2.py
      - scripts/test_w1_owned_generation_runtime_v2.py
      - scripts/w1_owned_process_collector_v1.py
      - scripts/test_w1_owned_process_collector_v1.py
      - evidence/pon-w1-full-v2-20261105/**
      - evidence/seven-gates-followup-20261108/research-ci-fix/transparent-bb-controls.tar.xz
      - evidence/pon-w1-fresh-runtime-20261107/**
      - evidence/pon-w1-backend-sdk-20261107/**
      - scripts/w1_kaggle_worker_template.py
      - scripts/ci/**
      - scripts/project-preflight.sh
      - evidence/pon-w1-complete-succinct-20261028/**
      - evidence/pon-w1-full-v2-20261105/**
      - evidence/seven-gates-followup-20261108/research-ci-fix/transparent-bb-controls.tar.xz
      - evidence/pon-w1-verifier-hardening-20261028/**
      - evidence/pon-w1-transparent-profile-20261104/**
      - evidence/pon-w1-stark-review-20261106/**
      - evidence/pon-w1-source-snapshot-20261106/**
      - evidence/pon-w1-statement-v2-20261105/**
      - evidence/pon-w1-qrom-budget-20261105/**
      - config/**
      - .cargo/**
      - rust-toolchain.toml
      - AGENTS.md
      - PROJECT_ID
      - PROJECT_BOUNDARY.json
      - .github/workflows/pon-w1-transparent-profile.yml
permissions:
  contents: read
concurrency:
  group: pon-w1-transparent-profile-${{ github.event.pull_request.number }}
  # Preserve failed and partial observations when a newer source arrives.
  cancel-in-progress: false
env:
  CI: "true"
  CARGO_INCREMENTAL: "0"
  CARGO_BUILD_JOBS: "2"
  RUST_TEST_THREADS: "1"
  CARGO_TERM_COLOR: never
  PYTHONDONTWRITEBYTECODE: "1"
jobs:
  transparent-profile:
    name: W1 transparent candidate (${{ matrix.source }}, x64)
    runs-on: ubuntu-24.04
    timeout-minutes: 60
    strategy:
      fail-fast: false
      matrix:
        source: [head, prospective-merge]
    env:
      SOURCE_KIND: ${{ matrix.source }}
      EXPECTED_SOURCE: ${{ matrix.source == 'head' && github.event.pull_request.head.sha || github.sha }}
      EXPECTED_HEAD: ${{ github.event.pull_request.head.sha }}
      EXPECTED_BASE: ${{ github.event.pull_request.base.sha }}
    steps:
      - name: Checkout exact candidate without persistent credentials
        id: checkout
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ env.EXPECTED_SOURCE }}
          fetch-depth: 0
          persist-credentials: false
      - name: Reserve observations and verify ordered source identity
        id: source
        shell: bash
        run: |
          set -euo pipefail
          w1_profile_out="$RUNNER_TEMP/pon-w1-transparent-profile-$SOURCE_KIND-x64-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          mkdir "$w1_profile_out"
          mkdir "$w1_profile_out/bin"
          printf 'W1_PROFILE_OUT=%s\n' "$w1_profile_out" >> "$GITHUB_ENV"
          printf 'CARGO_HOME=%s/cargo-w1-transparent-profile-%s-%s-%s\n' "$RUNNER_TEMP" "$SOURCE_KIND" "$GITHUB_RUN_ID" "$GITHUB_RUN_ATTEMPT" >> "$GITHUB_ENV"
          printf 'CARGO_TARGET_DIR=%s/target-w1-transparent-profile-%s-%s-%s\n' "$RUNNER_TEMP" "$SOURCE_KIND" "$GITHUB_RUN_ID" "$GITHUB_RUN_ATTEMPT" >> "$GITHUB_ENV"
          printf 'Continuous candidate checks and saved-proof observations only. No new proof, end-to-end benefit, quantum soundness, production or consensus-admission qualification is established.\n' > "$w1_profile_out/SCOPE.txt"
          args=(--kind "$SOURCE_KIND" --expected-head "$EXPECTED_HEAD")
          if test "$SOURCE_KIND" = prospective-merge; then
            args+=(--expected-base "$EXPECTED_BASE" --expected-merge "$EXPECTED_SOURCE")
          fi
          python3 scripts/ci/verify_ci_source.py "${args[@]}" --output "$w1_profile_out/source-before.json" 2>&1 | tee "$w1_profile_out/source-before.log"
          bash scripts/project-preflight.sh --audit 2>&1 | tee "$w1_profile_out/preflight.log"
      - name: Install pinned compiler and retain tool identities
        id: toolchain
        shell: bash
        run: |
          set -euo pipefail
          rustup toolchain install 1.95.0 --profile minimal --component rustfmt --component clippy 2>&1 | tee "$W1_PROFILE_OUT/toolchain-install.log"
          rustc +1.95.0 -Vv > "$W1_PROFILE_OUT/rustc-version.txt"
          cargo +1.95.0 -Vv > "$W1_PROFILE_OUT/cargo-version.txt"
          python3 --version > "$W1_PROFILE_OUT/python-version.txt"
      - name: Execute source identity rejection controls
        if: always() && steps.source.outcome == 'success'
        id: source_controls
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/ci/test_ci_source_integrity.py 2>&1 | tee "$W1_PROFILE_OUT/source-controls.log"
      - name: Execute all 24 saved-proof observer controls
        if: always() && steps.source.outcome == 'success'
        id: observer_tests
        shell: bash
        run: |
          set -euo pipefail
          python3 -m unittest discover -s scripts/ci -p test_w1_transparent_compare.py -v 2>&1 | tee "$W1_PROFILE_OUT/observer-tests.log"
          python3 - "$W1_PROFILE_OUT/observer-tests.log" <<'PY'
          from pathlib import Path
          import re, sys
          text = Path(sys.argv[1]).read_text()
          if re.findall(r'^Ran ([0-9]+) tests in ', text, re.M) != ['24'] or not re.search(r'^OK$', text, re.M):
              raise SystemExit('all 24 retained observer controls must execute without skips')
          PY
      - name: Execute all 15 offline source-map controls
        if: always() && steps.source.outcome == 'success'
        id: mapper_tests
        shell: bash
        run: |
          set -euo pipefail
          python3 -m unittest discover -s scripts/ci -p test_w1_profile_source_map.py -v 2>&1 | tee "$W1_PROFILE_OUT/mapper-tests.log"
          python3 - "$W1_PROFILE_OUT/mapper-tests.log" <<'PY'
          from pathlib import Path
          import re, sys
          text = Path(sys.argv[1]).read_text()
          expected = {
              'test_archive_and_selected_members_match_locked_checksum',
              'test_archive_replacement_does_not_change_the_inspected_snapshot',
              'test_archive_replacement_with_matching_changed_sources_is_refused',
              'test_duplicate_and_missing_locked_packages_are_refused',
              'test_duplicate_archive_member_is_refused',
              'test_existing_output_is_never_overwritten',
              'test_json_snapshot_keeps_the_digest_of_the_parsed_bytes',
              'test_json_snapshot_preserves_duplicate_key_refusal',
              'test_lock_snapshot_keeps_the_digest_of_the_parsed_bytes',
              'test_locked_archive_checksum_drift_is_refused',
              'test_modified_extracted_source_is_refused',
              'test_oversized_selected_archive_member_is_refused',
              'test_provenance_is_parsed_from_the_hashed_source_snapshot',
              'test_source_size_and_digest_describe_the_same_read',
              'test_stark_value_or_declaration_drift_is_refused',
          }
          rows = re.findall(r'^(test_\S+) \(([^)]+)\) \.\.\. (.*)$', text, re.M)
          required = sorted((name, f'test_w1_profile_source_map.SourceMapTests.{name}', 'ok')
                            for name in expected)
          if (sorted(rows) != required
                  or re.findall(r'^Ran ([0-9]+) tests in ', text, re.M) != ['15']
                  or re.findall(r'^OK(?: \(.*\))?$', text, re.M) != ['OK']):
              raise SystemExit('all 15 named source-map controls must execute exactly once without skips')
          PY
      - name: Execute all 31 saved-v2 report consistency controls
        if: always() && steps.source.outcome == 'success'
        id: v2_gate_tests
        shell: bash
        run: |
          set -euo pipefail
          python3 -m unittest discover -s scripts/ci -p test_w1_v2_controls_gate.py -v 2>&1 | tee "$W1_PROFILE_OUT/v2-gate-tests.log"
          python3 - "$W1_PROFILE_OUT/v2-gate-tests.log" <<'PY'
          from pathlib import Path
          import re, sys
          text = Path(sys.argv[1]).read_text()
          expected = {
              'test_budget_and_qualification_cannot_be_widened',
              'test_cancellation_after_stage_snapshot_cannot_complete_the_controls',
              'test_case_command_must_use_pinned_verifier',
              'test_case_command_must_use_planned_inputs',
              'test_case_result_must_match_summary',
              'test_current_gate_rejects_legacy_without_explicit_replay',
              'test_current_gate_rejects_unknown_process_schema',
              'test_current_hosted_controls_bind_common_clock_and_summary_completion',
              'test_current_stage_cancellation_fields_are_mandatory_and_exact',
              'test_current_stage_cannot_skip_common_settlement_controls',
              'test_current_stage_clock_cannot_extend_original_budget',
              'test_current_stage_measurements_pass_without_proof_claim',
              'test_incomplete_session_observation_is_rejected',
              'test_integer_exit_codes_cannot_be_booleans',
              'test_mutation_identity_must_match_planned_bytes',
              'test_negative_process_acceptance_is_rejected',
              'test_nested_timeout_is_rejected',
              'test_original_control_order_and_count_are_required',
              'test_output_hashes_must_match_saved_logs',
              'test_positive_process_rejection_is_rejected',
              'test_positive_stdout_must_match_summary',
              'test_process_pid_must_belong_to_observed_groups',
              'test_process_scan_errors_are_rejected',
              'test_real_saved_controls_pass',
              'test_rejection_layer_must_match_saved_stderr',
              'test_required_rejection_text_must_be_present',
              'test_retained_process_must_match_summary',
              'test_saved_inputs_must_match_planned_bytes',
              'test_truncated_output_scans_are_rejected',
              'test_unsettled_owned_groups_are_rejected',
              'test_verifier_hash_must_match_pinned_identity',
          }
          rows = re.findall(r'^(test_\S+) \(([^)]+)\) \.\.\. (.*)$', text, re.M)
          required = sorted((name, f'test_w1_v2_controls_gate.V2ControlsGateTests.{name}', 'ok')
                            for name in expected)
          if (sorted(rows) != required
                  or re.findall(r'^Ran ([0-9]+) tests in ', text, re.M) != ['31']
                  or re.findall(r'^OK(?: \(.*\))?$', text, re.M) != ['OK']):
              raise SystemExit('all 31 named v2 report controls must execute exactly once without skips')
          PY
          python3 -m unittest discover -s scripts/ci -p test_w1_v2_current_stage_gate.py -v 2>&1 | tee "$W1_PROFILE_OUT/v3-gate-tests.log"
          python3 - "$W1_PROFILE_OUT/v3-gate-tests.log" <<'PY'
          from pathlib import Path
          import re, sys
          text = Path(sys.argv[1]).read_text()
          expected = {
              'test_current_cli_selects_current_schema_without_a_downgrade_option',
              'test_current_contract_accepts_actual_clean_expected_rejection',
              'test_current_contract_accepts_actual_clean_process_observation',
              'test_current_contract_refuses_deadline_exhaustion',
              'test_current_contract_refuses_legacy_and_unknown_observations',
              'test_current_contract_refuses_snapshot_cancellation',
              'test_current_contract_requires_every_new_snapshot_field',
              'test_current_contract_retains_unqualified_resource_and_proof_scope',
              'test_current_snapshot_fields_cannot_coerce_types',
              'test_version_selector_is_explicit_and_unknown_versions_are_refused',
          }
          rows = re.findall(r'^(test_\S+) \(([^)]+)\) \.\.\. (.*)$', text, re.M)
          required = sorted((name, f'test_w1_v2_current_stage_gate.CurrentStageV3ControlsGateTests.{name}', 'ok')
                            for name in expected)
          if (sorted(rows) != required
                  or re.findall(r'^Ran ([0-9]+) tests in ', text, re.M) != ['10']
                  or re.findall(r'^OK(?: \(.*\))?$', text, re.M) != ['OK']):
              raise SystemExit('all 10 current stage-v3 controls must execute exactly once without skips')
          PY
      - name: Execute staged lifecycle and complete-observation rejection controls
        if: always() && steps.source.outcome == 'success'
        id: staged_tests
        shell: bash
        run: |
          set -euo pipefail
          w1_staged_tmp="$(mktemp -d /dev/shm/trnm-w1-staged-ci-XXXXXXXX)"
          trap 'rm -rf -- "$w1_staged_tmp"' EXIT
          export TMPDIR="$w1_staged_tmp"
          python3 -m unittest discover -s scripts/ci -p test_w1_staged_observer.py -v 2>&1 | tee "$W1_PROFILE_OUT/staged-observer-tests.log"
          python3 - "$W1_PROFILE_OUT/staged-observer-tests.log" <<'PY'
          from pathlib import Path
          import re, sys
          text = Path(sys.argv[1]).read_text()
          counts = re.findall(r'^Ran ([0-9]+) tests in ', text, re.M)
          if counts != ['32'] or not re.search(r'^OK$', text, re.M) or 'skipped=' in text:
              raise SystemExit('all 32 retained staged-observer controls must execute without skips')
          PY
      - name: Execute exact-source component-budget rejection controls
        if: always() && steps.source.outcome == 'success'
        id: budget_tests
        shell: bash
        run: |
          set -euo pipefail
          python3 -m unittest discover -s scripts/ci -p test_w1_security_budget.py -v 2>&1 | tee "$W1_PROFILE_OUT/security-budget-tests.log"
          python3 - "$W1_PROFILE_OUT/security-budget-tests.log" <<'PY'
          from pathlib import Path
          import re, sys
          text = Path(sys.argv[1]).read_text()
          counts = re.findall(r'^Ran ([0-9]+) tests in ', text, re.M)
          if len(counts) != 1 or int(counts[0]) < 21 or not re.search(r'^OK$', text, re.M):
              raise SystemExit('all 21 retained security-budget controls must execute without skips')
          PY
      - name: Verify and build the independent native crate
        if: always() && steps.source.outcome == 'success' && steps.toolchain.outcome == 'success'
        id: native
        shell: bash
        run: |
          set -euo pipefail
          w1_manifest=formal/pon-nakamoto-v1/w1_native_cost/Cargo.toml
          cargo +1.95.0 metadata --locked --manifest-path "$w1_manifest" --format-version 1 > "$W1_PROFILE_OUT/native-cargo-graph.json" 2> "$W1_PROFILE_OUT/native-metadata.stderr.log"
          cargo +1.95.0 fmt --manifest-path "$w1_manifest" --all -- --check 2>&1 | tee "$W1_PROFILE_OUT/native-format.log"
          cargo +1.95.0 test --locked --release --manifest-path "$w1_manifest" -- --test-threads=1 2>&1 | tee "$W1_PROFILE_OUT/native-tests.log"
          python3 - "$W1_PROFILE_OUT/native-tests.log" <<'PY'
          from pathlib import Path
          import re, sys
          rows = re.findall(r'^test result: ok\. ([0-9]+) passed; 0 failed; ([0-9]+) ignored;', Path(sys.argv[1]).read_text(), re.M)
          if sum(int(passed) for passed, _ in rows) < 6 or any(int(ignored) for _, ignored in rows):
              raise SystemExit('six retained native relation controls did not execute')
          PY
          cargo +1.95.0 clippy --locked --release --manifest-path "$w1_manifest" --all-targets -- -D warnings 2>&1 | tee "$W1_PROFILE_OUT/native-clippy.log"
          cargo +1.95.0 build --locked --release --manifest-path "$w1_manifest" 2>&1 | tee "$W1_PROFILE_OUT/native-build.log"
          cp "$CARGO_TARGET_DIR/release/w1-native-cost" "$W1_PROFILE_OUT/bin/w1-native-cost"
          sha256sum "$W1_PROFILE_OUT/bin/w1-native-cost" > "$W1_PROFILE_OUT/native-binary.sha256"
      - name: Verify and build the independent hardened verifier crate
        if: always() && steps.source.outcome == 'success' && steps.toolchain.outcome == 'success'
        id: hardened
        shell: bash
        run: |
          set -euo pipefail
          w1_manifest=formal/pon-nakamoto-v1/w1_hardened_verifier/Cargo.toml
          cargo +1.95.0 metadata --locked --manifest-path "$w1_manifest" --format-version 1 > "$W1_PROFILE_OUT/hardened-cargo-graph.json" 2> "$W1_PROFILE_OUT/hardened-metadata.stderr.log"
          cargo +1.95.0 fmt --manifest-path "$w1_manifest" --all -- --check 2>&1 | tee "$W1_PROFILE_OUT/hardened-format.log"
          cargo +1.95.0 test --locked --release --manifest-path "$w1_manifest" -- --test-threads=1 2>&1 | tee "$W1_PROFILE_OUT/hardened-tests.log"
          python3 - "$W1_PROFILE_OUT/hardened-tests.log" <<'PY'
          from pathlib import Path
          import re, sys
          rows = re.findall(r'^test result: ok\. ([0-9]+) passed; 0 failed; ([0-9]+) ignored;', Path(sys.argv[1]).read_text(), re.M)
          if sum(int(passed) for passed, _ in rows) < 15 or any(int(ignored) for _, ignored in rows):
              raise SystemExit('15 retained hardened verifier controls did not execute')
          PY
          cargo +1.95.0 clippy --locked --release --manifest-path "$w1_manifest" --all-targets -- -D warnings 2>&1 | tee "$W1_PROFILE_OUT/hardened-clippy.log"
          cargo +1.95.0 build --locked --release --manifest-path "$w1_manifest" 2>&1 | tee "$W1_PROFILE_OUT/hardened-build.log"
          cp "$CARGO_TARGET_DIR/release/trnm-w1-hardened-verifier" "$W1_PROFILE_OUT/bin/trnm-w1-hardened-verifier"
          sha256sum "$W1_PROFILE_OUT/bin/trnm-w1-hardened-verifier" > "$W1_PROFILE_OUT/hardened-binary.sha256"
      - name: Verify and build the independent v2 verifier without a guest build
        if: always() && steps.source.outcome == 'success' && steps.toolchain.outcome == 'success'
        id: verifier_v2
        shell: bash
        run: |
          set -euo pipefail
          w1_manifest=formal/pon-nakamoto-v1/w1_v2_verifier/Cargo.toml
          cargo +1.95.0 metadata --locked --manifest-path "$w1_manifest" --format-version 1 > "$W1_PROFILE_OUT/v2-cargo-graph.json" 2> "$W1_PROFILE_OUT/v2-metadata.stderr.log"
          python3 - "$W1_PROFILE_OUT/v2-cargo-graph.json" <<'PY'
          from pathlib import Path
          import json, sys
          graph = json.loads(Path(sys.argv[1]).read_text())
          packages = {package['name'] for package in graph['packages']}
          if packages.intersection({'risc0-build', 'trnm-w1-zk-methods', 'trnm-w1-zk-methods-v2',
                                    'trnm-w1-full-guest', 'trnm-w1-full-guest-v2'}):
              raise SystemExit('independent v2 verifier must not acquire a guest build dependency')
          PY
          cargo +1.95.0 fmt --manifest-path "$w1_manifest" --all -- --check 2>&1 | tee "$W1_PROFILE_OUT/v2-format.log"
          cargo +1.95.0 test --locked --release --manifest-path "$w1_manifest" -- --format=pretty --test-threads=1 2>&1 | tee "$W1_PROFILE_OUT/v2-tests.log"
          python3 - "$W1_PROFILE_OUT/v2-tests.log" <<'PY'
          from pathlib import Path
          import re, sys
          text = Path(sys.argv[1]).read_text()
          expected = {
              'tests::expected_artifacts_are_exact_and_never_derived_from_receipt',
              'tests::historical_full_receipt_cannot_satisfy_v2_statement',
              'tests::saved_full_v2_receipt_verifies_with_independent_artifacts',
          }
          rows = re.findall(r'^test ([A-Za-z0-9_:]+) \.\.\. (\S+)$', text, re.M)
          summaries = re.findall(r'^test result: (.*)$', text, re.M)
          if (len(rows) != 3 or {name for name, _ in rows} != expected
                  or any(outcome != 'ok' for _, outcome in rows)
                  or re.findall(r'^running ([0-9]+) tests$', text, re.M) != ['3']
                  or len(summaries) != 1 or not re.fullmatch(
                      r'ok\. 3 passed; 0 failed; 0 ignored; 0 measured; 0 filtered out; finished in [0-9]+(?:\.[0-9]+)?s',
                      summaries[0])):
              raise SystemExit('all three named v2 controls, including the actual saved proof, must execute without filtering')
          PY
          cargo +1.95.0 clippy --locked --release --manifest-path "$w1_manifest" --all-targets -- -D warnings 2>&1 | tee "$W1_PROFILE_OUT/v2-clippy.log"
          cargo +1.95.0 build --locked --release --manifest-path "$w1_manifest" 2>&1 | tee "$W1_PROFILE_OUT/v2-build.log"
          cp "$CARGO_TARGET_DIR/release/w1-verify-v2" "$W1_PROFILE_OUT/bin/w1-verify-v2"
          sha256sum "$W1_PROFILE_OUT/bin/w1-verify-v2" > "$W1_PROFILE_OUT/v2-binary.sha256"
      - name: Execute eleven actual full-v2 receiver and cancellation controls
        if: always() && steps.source.outcome == 'success' && steps.verifier_v2.outcome == 'success'
        id: real_receiver_controls
        shell: bash
        run: |
          set -euo pipefail
          w1_v2_fixture="$GITHUB_WORKSPACE/evidence/pon-w1-full-v2-20261105"
          w1_v2_verifier="$W1_PROFILE_OUT/bin/w1-verify-v2"
          w1_v2_verifier_sha="$(sha256sum "$w1_v2_verifier")"
          w1_v2_verifier_sha="${w1_v2_verifier_sha%% *}"
          python3 - "$w1_v2_fixture" <<'PY'
          from pathlib import Path
          import hashlib, sys
          root = Path(sys.argv[1])
          expected = {
              "succinct.bin": (257014, "6c72828c9d05a62175e08fa3e7e1d0d5e85e785ad96b5beb5ec7a2e2490c26ee"),
              "input.bin": (49506, "67b74fa2f417c0240d974e5ecea410d2b68d97d6dde667603aeb4d7ce59036cb"),
              "header.bin": (318, "7b96038f228a1eedccf7b29ffc54802aba691be7259e33937846c6bf6126d78f"),
              "expected-artifacts.bin": (64, "802adcdd951cfb4cd7271df22c3bca6af66fee9f40454c74f8b5ff2c98a1b683"),
          }
          for name, (size, digest) in expected.items():
              raw = (root / name).read_bytes()
              if len(raw) != size or hashlib.sha256(raw).hexdigest() != digest:
                  raise SystemExit("historical full-v2 fixture changed: " + name)
          if (root / "input.bin").read_bytes()[:318] != (root / "header.bin").read_bytes():
              raise SystemExit("full-v2 input/header binding changed")
          PY
          python3 scripts/ci/test_w1_receiver_real.py \
            --verifier "$w1_v2_verifier" --verifier-sha256 "$w1_v2_verifier_sha" \
            --receipt "$w1_v2_fixture/succinct.bin" --input "$w1_v2_fixture/input.bin" \
            --header "$w1_v2_fixture/header.bin" --expected-artifacts "$w1_v2_fixture/expected-artifacts.bin" \
            --out "$W1_PROFILE_OUT/real-receiver-controls" 2>&1 | tee "$W1_PROFILE_OUT/real-receiver-controls.log"
          python3 - "$W1_PROFILE_OUT/real-receiver-controls/summary.json" "$w1_v2_verifier_sha" <<'PY'
          from pathlib import Path
          import json, sys
          report = json.loads(Path(sys.argv[1]).read_text())
          counts = {"tests_run": 11, "failures": 0, "errors": 0, "skipped": 0, "fresh_proof_generations": 0}
          if (report.get("schema") != "TRNM-W1-REAL-RECEIVER-CONTROLS1"
                  or any(type(report.get(key)) is not int or report[key] != value for key, value in counts.items())
                  or report.get("result") != "PASS" or report.get("actual_complete_receipt_used") is not True
                  or report.get("verifier_sha256") != sys.argv[2]
                  or report.get("receipt_sha256") != "6c72828c9d05a62175e08fa3e7e1d0d5e85e785ad96b5beb5ec7a2e2490c26ee"):
              raise SystemExit("all eleven actual receiver controls must execute with the declared saved receipt and zero proof generation")
          PY

      - name: Retain all 58 actual saved-v2 receipt controls
        if: always() && steps.source.outcome == 'success' && steps.verifier_v2.outcome == 'success'
        id: receipt_controls_v2
        timeout-minutes: 4
        shell: bash
        run: |
          set -euo pipefail
          w1_proof_dir="$GITHUB_WORKSPACE/evidence/pon-w1-full-v2-20261105"
          w1_verifier="$W1_PROFILE_OUT/bin/w1-verify-v2"
          RAYON_NUM_THREADS=8 python3 scripts/w1_v2_receipt_controls.py \
            --verifier "$w1_verifier" --receipt "$w1_proof_dir/succinct.bin" \
            --header "$w1_proof_dir/header.bin" --expected-artifacts "$w1_proof_dir/expected-artifacts.bin" \
            --out "$W1_PROFILE_OUT/v2-controls" 2>&1 | tee "$W1_PROFILE_OUT/v2-receipt-controls.log"
          python3 scripts/ci/w1_v2_controls_gate.py "$W1_PROFILE_OUT/v2-controls" "$w1_proof_dir" "$w1_verifier" \
            2>&1 | tee "$W1_PROFILE_OUT/v2-controls-validation.log"
      - name: Reproduce the component-budget report with its unqualified boundary
        if: always() && steps.source.outcome == 'success' && steps.hardened.outcome == 'success'
        id: component_budget
        shell: bash
        run: |
          set -euo pipefail
          # Offline reproduction of an explicit research budget. A component
          # budget failure is a valid observation, not QROM qualification.
          python3 - "$CARGO_HOME" "$W1_PROFILE_OUT" <<'PY' 2>&1 | tee "$W1_PROFILE_OUT/security-budget.log"
          from pathlib import Path
          import json, subprocess, sys
          cargo, out = map(Path, sys.argv[1:])
          required = ('risc0-zkp-3.0.5.crate', 'risc0-core-3.0.2.crate',
                      'risc0-circuit-recursion-4.0.5.crate', 'risc0-circuit-rv32im-4.0.5.crate')
          caches = [path for path in (cargo / 'registry/cache').glob('*')
                    if path.is_dir() and all((path / name).is_file() for name in required)]
          if len(caches) != 1:
              raise SystemExit('one complete pinned crate archive cache is required')
          report_path = out / 'security-budget.json'
          subprocess.run([sys.executable, 'scripts/w1_security_budget.py',
                          '--crate-cache', str(caches[0]), '--target-bits', '128',
                          '--output', str(report_path)], check=True)
          report = json.loads(report_path.read_text())
          qualification = report['qualification']
          if (report['schema'] != 'TRNM-W1-COMPONENT-SECURITY-BUDGET1'
                  or report['research_target']['failure_probability_bits'] != 128
                  or report['research_target']['protocol_policy_adopted'] is not False
                  or qualification['quantum_security_bits'] is not None
                  or qualification['full_recursive_security_bits'] is not None
                  or any(qualification[key] is not False for key in
                         ('qrom_theorem_instantiated', 'consensus_admission',
                          'production_qualified', 'attack_on_complete_w1_established'))):
              raise SystemExit('component estimates must retain their exact unqualified scope')
          print('Component formula report reproduced; whole-proof and QROM qualification remain false.')
          PY
      - name: Reproduce the bounded source map without network access
        if: always() && steps.source.outcome == 'success' && steps.toolchain.outcome == 'success'
        id: source_map
        shell: bash
        run: |
          set -euo pipefail
          # The mapper only reads already downloaded locked archives and sources.
          python3 scripts/w1_profile_source_map.py --cargo-home "$CARGO_HOME" --repo-root "$GITHUB_WORKSPACE" --out "$W1_PROFILE_OUT/security-map.json" 2>&1 | tee "$W1_PROFILE_OUT/source-map.log"
          cmp evidence/pon-w1-source-snapshot-20261106/security-map.json "$W1_PROFILE_OUT/security-map.json" 2>&1 | tee "$W1_PROFILE_OUT/source-map-comparison.log"
      - name: Observe the compiled profile and its unqualified boundary
        if: always() && steps.source.outcome == 'success' && steps.hardened.outcome == 'success'
        id: profile
        shell: bash
        run: |
          set -euo pipefail
          "$W1_PROFILE_OUT/bin/trnm-w1-hardened-verifier" profile > "$W1_PROFILE_OUT/profile.json" 2> "$W1_PROFILE_OUT/profile.stderr.log"
          python3 - "$W1_PROFILE_OUT/profile.json" <<'PY'
          from pathlib import Path
          import json, sys
          profile = json.loads(Path(sys.argv[1]).read_text())
          mapping = json.loads(Path('evidence/pon-w1-transparent-profile-20261104/security-map.json').read_text())
          saved, defaults = mapping['saved_full_receipt'], mapping['recursive_verifier_defaults']
          checks = [profile['schema'] == 'TRNM-W1-TRANSPARENT-PROFILE1',
              profile['profile_id'] == 'trnm-w1-risc0-3.0.6-poseidon2-join-v1',
              profile['hash_function'] == saved['hash_function'],
              profile['final_control_id'] == saved['control_id'],
              profile['verifier_parameters_digest'] == saved['verifier_parameters_digest'],
              profile['control_root'] == defaults['control_root'],
              profile['effective_inner_control_root'] == defaults['effective_inner_control_root'],
              profile['control_inclusion_depth'] == defaults['control_merkle_depth'],
              profile['quantum_security_bits'] is None,
              profile['quantum_soundness_qualified'] is False,
              profile['consensus_admission'] is False]
          if not all(checks):
              raise SystemExit('compiled profile differs from its mapped, unqualified construction')
          PY
      - name: Retain all 44 actual saved-proof acceptance and rejection controls
        if: always() && steps.source.outcome == 'success' && steps.hardened.outcome == 'success'
        id: receipt_controls
        shell: bash
        run: |
          set -euo pipefail
          w1_proof_dir="$GITHUB_WORKSPACE/evidence/pon-w1-complete-succinct-20261028/full-proof"
          "$W1_PROFILE_OUT/bin/trnm-w1-hardened-verifier" controls "$w1_proof_dir/header.bin" "$w1_proof_dir/succinct.bin" "$W1_PROFILE_OUT/controls" 2>&1 | tee "$W1_PROFILE_OUT/receipt-controls.log"
          python3 - "$W1_PROFILE_OUT/controls/result.json" <<'PY'
          from pathlib import Path
          import json, sys
          report = json.loads(Path(sys.argv[1]).read_text())
          cases = report['cases']
          retained_extra = {'hash_function_sha256', 'hash_function_blake2b'}
          if (report['schema'] != 'TRNM-W1-HARDENED-VERIFIER-CONTROLS2'
                  or len(cases) != 44 or len({case['name'] for case in cases}) != 44
                  or not retained_extra.issubset({case['name'] for case in cases})
                  or report['all_passed'] is not True or report['fake_proofs_used'] is not False
                  or report['consensus_admission'] is not False
                  or any(case['passed'] is not True or case['observed']['outcome'] != case['expected']
                         or case['observed']['outcome'] not in ('ACCEPT', 'REJECT') for case in cases)):
              raise SystemExit('all 44 real controls must complete without panic or changed expectations')
          PY
      - name: Compare the saved proof under one shared 120-second deadline
        if: always() && steps.source.outcome == 'success' && steps.native.outcome == 'success' && steps.hardened.outcome == 'success'
        id: comparison
        timeout-minutes: 4
        shell: bash
        run: |
          set -euo pipefail
          w1_native="$W1_PROFILE_OUT/bin/w1-native-cost"
          w1_verifier="$W1_PROFILE_OUT/bin/trnm-w1-hardened-verifier"
          w1_native_sha="$(sha256sum "$w1_native")"
          w1_native_sha="${w1_native_sha%% *}"
          w1_verifier_sha="$(sha256sum "$w1_verifier")"
          w1_verifier_sha="${w1_verifier_sha%% *}"
          python3 scripts/w1_transparent_compare.py \
            --proof-dir "$GITHUB_WORKSPACE/evidence/pon-w1-complete-succinct-20261028/full-proof" \
            --native "$w1_native" --verifier "$w1_verifier" \
            --native-sha256 "$w1_native_sha" --verifier-sha256 "$w1_verifier_sha" \
            --native-source-commit "$EXPECTED_SOURCE" --verifier-source-commit "$EXPECTED_SOURCE" \
            --source-root "$GITHUB_WORKSPACE" --out "$W1_PROFILE_OUT/comparison" \
            --total-wall-seconds 120 2>&1 | tee "$W1_PROFILE_OUT/comparison.log"
          python3 - "$W1_PROFILE_OUT/comparison/result.json" <<'PY'
          from pathlib import Path
          import json, sys
          report = json.loads(Path(sys.argv[1]).read_text())
          if (report['outcome'] != 'SAVED_PROOF_COMPARISON_COMPLETE' or report['qualification'] != 'HOLD'
                  or report['new_proofs_generated'] != 0 or report['logical_work_items'] != 1
                  or any(report[key] is not False for key in ('end_to_end_benefit_established',
                      'quantum_soundness_qualified', 'consensus_admission',
                      'production_tail_established', 'source_equivalence_established'))):
              raise SystemExit('saved-proof observation must retain its unqualified scope')
          PY
      - name: Verify measured source after execution
        if: always() && steps.source.outcome == 'success'
        id: source_after
        shell: bash
        run: |
          set -euo pipefail
          args=(--kind "$SOURCE_KIND" --expected-head "$EXPECTED_HEAD")
          if test "$SOURCE_KIND" = prospective-merge; then
            args+=(--expected-base "$EXPECTED_BASE" --expected-merge "$EXPECTED_SOURCE")
          fi
          python3 scripts/ci/verify_ci_source.py "${args[@]}" --output "$W1_PROFILE_OUT/source-after.json" 2>&1 | tee "$W1_PROFILE_OUT/source-after.log"
      - name: Record completed, failed and skipped observations
        if: always()
        shell: bash
        env:
          W1_PROFILE_STEP_RESULTS: ${{ toJSON(steps) }}
        run: |
          set -euo pipefail
          w1_profile_out="$RUNNER_TEMP/pon-w1-transparent-profile-$SOURCE_KIND-x64-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          mkdir -p "$w1_profile_out"
          python3 - "$w1_profile_out/ci-status.json" <<'PY'
          import json, os, sys
          report = {'schema': 'TRNM-W1-TRANSPARENT-CI-OBSERVATION1',
              'source_kind': os.environ['SOURCE_KIND'], 'expected_source': os.environ['EXPECTED_SOURCE'],
              'steps': json.loads(os.environ['W1_PROFILE_STEP_RESULTS']),
              'scope': 'Continuous candidate checks; failed and partial observations are retained.',
              'end_to_end_benefit_established': False, 'quantum_soundness_qualified': False,
              'production_qualified': False, 'consensus_admission': False}
          with open(sys.argv[1], 'x', encoding='utf-8') as stream:
              json.dump(report, stream, indent=2, sort_keys=True)
              stream.write('\n')
          required = ('checkout', 'source', 'toolchain', 'source_controls', 'observer_tests',
                      'mapper_tests', 'v2_gate_tests', 'staged_tests', 'budget_tests', 'native', 'hardened',
                      'verifier_v2', 'real_receiver_controls', 'receipt_controls_v2', 'component_budget', 'source_map',
                      'profile', 'receipt_controls', 'comparison', 'source_after')
          incomplete = [name for name in required if report['steps'].get(name, {}).get('outcome') != 'success']
          if incomplete:
              raise SystemExit('required W1 observations failed or were skipped: ' + ', '.join(incomplete))
          PY
      - name: Retain source identities, binaries, logs and all failures
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: w1-transparent-profile-${{ matrix.source }}-x64-${{ env.EXPECTED_SOURCE }}-${{ github.run_attempt }}
          path: ${{ runner.temp }}/pon-w1-transparent-profile-${{ matrix.source }}-x64-${{ github.run_id }}-${{ github.run_attempt }}/
          if-no-files-found: error
          retention-days: 30

ce94e0a5423d91840849d91579ec541081117274 blob 40413
name: PoN W1 work security observations
on:
  push:
    branches:
      - fix/chain-six-axis-performance-20261103
  pull_request:
    paths:
      - trillionnium/**
      - tests/fuzz/**
      - scripts/ci/**
      - scripts/pon_w1_*.py
      - formal/pon-nakamoto-v1/work_query_bound.py
      - formal/pon-nakamoto-v1/test_work_query_bound.py
      - config/**
      - .cargo/**
      - rust-toolchain.toml
      - .github/workflows/pon-w1-work-security.yml
      - .github/workflows/pon-recent-batch-acceptance.yml
permissions:
  contents: read
concurrency:
  group: pon-w1-security-${{ github.event.pull_request.number || github.ref }}
  # A later source never erases a failed or partial earlier observation.
  cancel-in-progress: false
env:
  CI: "true"
  CARGO_INCREMENTAL: "0"
  CARGO_BUILD_JOBS: "2"
  RUST_TEST_THREADS: "1"
  CARGO_TERM_COLOR: never
  PYTHONDONTWRITEBYTECODE: "1"
jobs:
  push-source-context:
    # Main is observed once when this resolver runs. Rerun the whole workflow;
    # failed-job-only retries cannot borrow a different attempt's source context.
    name: Freeze actual integration push source
    if: github.event_name == 'push'
    runs-on: ubuntu-24.04
    timeout-minutes: 10
    outputs:
      head: ${{ steps.resolve.outputs.head }}
      base: ${{ steps.resolve.outputs.base }}
      merge: ${{ steps.resolve.outputs.merge }}
      context: ${{ steps.resolve.outputs.context }}
      context_sha256: ${{ steps.resolve.outputs.context_sha256 }}
    steps:
      - name: Checkout the immutable push after object
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ github.sha }}
          fetch-depth: 0
          persist-credentials: false
      - name: Freeze the real push and current main without a PR identity
        id: resolve
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/ci/integration_push_source.py resolve --output "$RUNNER_TEMP/integration-push-source/context.json"
      - name: Require source-context refusal controls and unchanged resolver bytes
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/ci/test_integration_push_source.py 2>&1 | tee "$RUNNER_TEMP/integration-push-source/controls.log"
          python3 scripts/ci/verify_ci_source.py --kind head --expected-head "$GITHUB_SHA" --output "$RUNNER_TEMP/integration-push-source/source-after-controls.json"
      - name: Preserve resolved and failed push context
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: integration-push-source-${{ github.run_id }}-${{ github.run_attempt }}
          path: ${{ runner.temp }}/integration-push-source/
          if-no-files-found: error
          retention-days: 30
  false-trace-reuse:
    needs: push-source-context
    if: ${{ !cancelled() && (github.event_name == 'pull_request' || needs.push-source-context.result == 'success') }}
    name: W1 false trace reuse (${{ matrix.arch }}, ${{ matrix.source }})
    runs-on: ${{ matrix.runner }}
    timeout-minutes: 55
    strategy:
      fail-fast: false
      matrix:
        arch: [x64, arm64]
        source: [head, prospective-merge]
        include:
          - arch: x64
            runner: ubuntu-24.04
          - arch: arm64
            runner: ubuntu-24.04-arm
    env:
      TRNM_COST_RUNNER_LABEL: ${{ matrix.runner }}
      SOURCE_KIND: ${{ matrix.source }}
      EXPECTED_SOURCE: ${{ matrix.source == 'head' && (github.event_name == 'push' && needs.push-source-context.outputs.head || github.event.pull_request.head.sha) || (github.event_name == 'push' && needs.push-source-context.outputs.merge || github.sha) }}
      TRNM_EXPECTED_SOURCE_SHA: ${{ matrix.source == 'head' && (github.event_name == 'push' && needs.push-source-context.outputs.head || github.event.pull_request.head.sha) || (github.event_name == 'push' && needs.push-source-context.outputs.merge || github.sha) }}
      EXPECTED_HEAD: ${{ github.event_name == 'push' && needs.push-source-context.outputs.head || github.event.pull_request.head.sha }}
      EXPECTED_BASE: ${{ github.event_name == 'push' && needs.push-source-context.outputs.base || github.event.pull_request.base.sha }}
      EXPECTED_MERGE: ${{ github.event_name == 'push' && needs.push-source-context.outputs.merge || github.sha }}
    steps:
      - name: Checkout exact measured source
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ github.event_name == 'push' && needs.push-source-context.outputs.head || env.EXPECTED_SOURCE }}
          fetch-depth: 0
          persist-credentials: false
      - name: Reproduce the frozen integration-push source
        if: github.event_name == 'push'
        env:
          PUSH_SOURCE_CONTEXT: ${{ needs.push-source-context.outputs.context }}
          PUSH_SOURCE_CONTEXT_SHA256: ${{ needs.push-source-context.outputs.context_sha256 }}
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/ci/integration_push_source.py materialize --kind "$SOURCE_KIND" --context-json "$PUSH_SOURCE_CONTEXT" --context-sha256 "$PUSH_SOURCE_CONTEXT_SHA256" --output "$RUNNER_TEMP/integration-push-context.json"
      - name: Reserve observations and verify ordered source identity
        id: source
        shell: bash
        run: |
          set -euo pipefail
          out="$RUNNER_TEMP/w1-security-$SOURCE_KIND-${{ matrix.arch }}-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          mkdir "$out"
          printf 'OUT=%s\n' "$out" >> "$GITHUB_ENV"
          printf 'TRNM_CI_RECEIPT_DIR=%s\n' "$out" >> "$GITHUB_ENV"
          printf 'CARGO_HOME=%s/cargo-w1-security\n' "$RUNNER_TEMP" >> "$GITHUB_ENV"
          printf 'CARGO_TARGET_DIR=%s/target-w1-security\n' "$RUNNER_TEMP" >> "$GITHUB_ENV"
          args=(--kind "$SOURCE_KIND" --expected-head "$EXPECTED_HEAD")
          if test "$SOURCE_KIND" = prospective-merge; then
            args+=(--expected-base "$EXPECTED_BASE" --expected-merge "$EXPECTED_SOURCE")
          fi
          python3 scripts/ci/verify_ci_source.py "${args[@]}" --output "$out/source-before.json"
          bash scripts/project-preflight.sh --audit 2>&1 | tee "$out/preflight.log"
      - name: Install exact original compiler and tools
        run: rustup toolchain install 1.95.0 --profile minimal --component rustfmt --component clippy
      - name: Execute reader rejection controls
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/ci/test_pon_w1_false_trace_reuse_reader_v1.py 2>&1 | tee "$OUT/reader-controls.log"
          python3 scripts/ci/test_work_rejection_report.py 2>&1 | tee "$OUT/retained-rejection-reader-controls.log"
          python3 scripts/ci/test_run_w1_false_trace_reuse_v1.py 2>&1 | tee "$OUT/runner-controls.log"
          python3 formal/pon-nakamoto-v1/test_work_query_bound.py 2>&1 | tee "$OUT/query-work-controls.log"
      - name: Verify actual locked graph and formatting
        shell: bash
        run: |
          set -euo pipefail
          cargo +1.95.0 metadata --locked --manifest-path trillionnium/Cargo.toml --format-version 1 > "$OUT/cargo-graph.json"
          cargo +1.95.0 fmt --manifest-path trillionnium/Cargo.toml --all -- --check 2>&1 | tee "$OUT/format.log"
      - name: Run complete W1 module tests and strict primitive lint
        shell: bash
        run: |
          set -euo pipefail
          cargo +1.95.0 test --locked --release --manifest-path trillionnium/Cargo.toml -p trnm-crypto-primitives --lib pon_work:: -- --test-threads=1 2>&1 | tee "$OUT/w1-tests.log"
          python3 - "$OUT/w1-tests.log" <<'PY'
          from pathlib import Path
          import re, sys
          text = Path(sys.argv[1]).read_text()
          rows = re.findall(r'^test result: ok\. ([0-9]+) passed; 0 failed; 0 ignored;', text, re.M)
          if len(rows) != 1 or int(rows[0]) < 104:
              raise SystemExit('complete retained W1 module suite did not execute')
          PY
          cargo +1.95.0 test --locked --release --manifest-path trillionnium/Cargo.toml -p trnm-pon-node --test work_fuzz_semantics -- --test-threads=1 2>&1 | tee "$OUT/w1-fuzz-semantics.log"
          python3 - "$OUT/w1-fuzz-semantics.log" <<'PY'
          from pathlib import Path
          import re, sys
          text = Path(sys.argv[1]).read_text()
          rows = re.findall(r'^test result: ok\. ([0-9]+) passed; 0 failed; 0 ignored;', text, re.M)
          if rows != ['6']:
              raise SystemExit('six retained W1 fuzz semantic controls did not execute')
          PY
          cargo +1.95.0 test --locked --release --manifest-path trillionnium/Cargo.toml -p trnm-crypto-primitives --example pon_rejection_cost -- --test-threads=1 2>&1 | tee "$OUT/retained-rejection-tests.log"
          python3 - "$OUT/retained-rejection-tests.log" <<'PY'
          from pathlib import Path
          import re, sys
          text = Path(sys.argv[1]).read_text()
          rows = re.findall(r'^test result: ok\. ([0-9]+) passed; 0 failed; 0 ignored;', text, re.M)
          if rows != ['3']:
              raise SystemExit('three retained rejection controls did not execute')
          PY
          cargo +1.95.0 clippy --locked --manifest-path trillionnium/Cargo.toml -p trnm-crypto-primitives --lib --tests -- -D warnings 2>&1 | tee "$OUT/w1-clippy.log"
          cargo +1.95.0 clippy --locked --manifest-path trillionnium/Cargo.toml -p trnm-crypto-primitives --example pon_rejection_cost -- -D warnings 2>&1 | tee "$OUT/retained-rejection-clippy.log"
      - name: Execute complete false trace reuse campaign
        if: always() && steps.source.outcome == 'success'
        # This frozen release runner rejects even a workflow-wide incremental
        # override of zero. Preserve that guard and use the default release input.
        run: env -u CARGO_INCREMENTAL python3 scripts/ci/run_w1_false_trace_reuse_v1.py --arch "${{ matrix.arch }}"
      - name: Execute additional complete full-limb comparison
        if: always() && steps.source.outcome == 'success'
        run: env -u CARGO_INCREMENTAL python3 scripts/ci/run_w1_false_trace_reuse_v1.py --arch "${{ matrix.arch }}" --full-limb
      - name: Verify measured source after execution
        if: always() && steps.source.outcome == 'success'
        shell: bash
        run: |
          set -euo pipefail
          args=(--kind "$SOURCE_KIND" --expected-head "$EXPECTED_HEAD")
          if test "$SOURCE_KIND" = prospective-merge; then
            args+=(--expected-base "$EXPECTED_BASE" --expected-merge "$EXPECTED_SOURCE")
          fi
          python3 scripts/ci/verify_ci_source.py "${args[@]}" --output "$OUT/source-after.json"
      - name: Preserve this lane's actual push source context
        if: always() && github.event_name == 'push'
        shell: bash
        run: |
          set -euo pipefail
          push_context_out="$RUNNER_TEMP/w1-security-$SOURCE_KIND-${{ matrix.arch }}-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          mkdir -p "$push_context_out"
          cp "$RUNNER_TEMP/integration-push-context.json" "$push_context_out/push-source-context.json"
      - name: Retain costs, binaries and all failures
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: w1-false-trace-${{ matrix.source }}-${{ matrix.arch }}-${{ env.EXPECTED_SOURCE }}-${{ github.run_attempt }}
          path: ${{ runner.temp }}/w1-security-${{ matrix.source }}-${{ matrix.arch }}-${{ github.run_id }}-${{ github.run_attempt }}/
          if-no-files-found: error
          retention-days: 30
  legal-strategy:
    needs: push-source-context
    if: ${{ !cancelled() && (github.event_name == 'pull_request' || needs.push-source-context.result == 'success') }}
    name: W1 complete legal strategies (${{ matrix.version }}, ${{ matrix.arch }}, ${{ matrix.source }})
    runs-on: ${{ matrix.runner }}
    timeout-minutes: 180
    strategy:
      fail-fast: false
      matrix:
        arch: [x64, arm64]
        source: [head, prospective-merge]
        version: [v1, v2]
        include:
          - arch: x64
            runner: ubuntu-24.04
          - arch: arm64
            runner: ubuntu-24.04-arm
    env:
      TRNM_COST_RUNNER_LABEL: ${{ matrix.runner }}
      SOURCE_KIND: ${{ matrix.source }}
      LEGAL_VERSION: ${{ matrix.version }}
      LEGAL_CAPTURE_PREFIX: ${{ matrix.version == 'v2' && 'w1-legal-v2' || 'w1-legal' }}
      LEGAL_ARTIFACT_PREFIX: ${{ matrix.version == 'v2' && 'w1-legal-strategy-v2' || 'w1-legal-strategy' }}
      EXPECTED_SOURCE: ${{ matrix.source == 'head' && (github.event_name == 'push' && needs.push-source-context.outputs.head || github.event.pull_request.head.sha) || (github.event_name == 'push' && needs.push-source-context.outputs.merge || github.sha) }}
      TRNM_EXPECTED_SOURCE_SHA: ${{ matrix.source == 'head' && (github.event_name == 'push' && needs.push-source-context.outputs.head || github.event.pull_request.head.sha) || (github.event_name == 'push' && needs.push-source-context.outputs.merge || github.sha) }}
      EXPECTED_HEAD: ${{ github.event_name == 'push' && needs.push-source-context.outputs.head || github.event.pull_request.head.sha }}
      EXPECTED_BASE: ${{ github.event_name == 'push' && needs.push-source-context.outputs.base || github.event.pull_request.base.sha }}
      EXPECTED_MERGE: ${{ github.event_name == 'push' && needs.push-source-context.outputs.merge || github.sha }}
    steps:
      - name: Checkout exact measured source
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ github.event_name == 'push' && needs.push-source-context.outputs.head || env.EXPECTED_SOURCE }}
          fetch-depth: 0
          persist-credentials: false
      - name: Reproduce the frozen integration-push source
        if: github.event_name == 'push'
        env:
          PUSH_SOURCE_CONTEXT: ${{ needs.push-source-context.outputs.context }}
          PUSH_SOURCE_CONTEXT_SHA256: ${{ needs.push-source-context.outputs.context_sha256 }}
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/ci/integration_push_source.py materialize --kind "$SOURCE_KIND" --context-json "$PUSH_SOURCE_CONTEXT" --context-sha256 "$PUSH_SOURCE_CONTEXT_SHA256" --output "$RUNNER_TEMP/integration-push-context.json"
      - name: Reserve observations and verify ordered source identity
        id: source
        shell: bash
        run: |
          set -euo pipefail
          out="$RUNNER_TEMP/$LEGAL_CAPTURE_PREFIX-$SOURCE_KIND-${{ matrix.arch }}-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          mkdir "$out"
          printf 'OUT=%s\n' "$out" >> "$GITHUB_ENV"
          printf 'TRNM_CI_RECEIPT_DIR=%s\n' "$out" >> "$GITHUB_ENV"
          printf 'CARGO_HOME=%s/cargo-w1-legal\n' "$RUNNER_TEMP" >> "$GITHUB_ENV"
          printf 'CARGO_TARGET_DIR=%s/target-w1-legal\n' "$RUNNER_TEMP" >> "$GITHUB_ENV"
          args=(--kind "$SOURCE_KIND" --expected-head "$EXPECTED_HEAD")
          if test "$SOURCE_KIND" = prospective-merge; then
            args+=(--expected-base "$EXPECTED_BASE" --expected-merge "$EXPECTED_SOURCE")
          fi
          python3 scripts/ci/verify_ci_source.py "${args[@]}" --output "$out/source-before.json"
          bash scripts/project-preflight.sh --audit 2>&1 | tee "$out/preflight.log"
      - name: Install exact original compiler and tools
        run: rustup toolchain install 1.95.0 --profile minimal --component rustfmt --component clippy
      - name: Verify complete legal-cost readers and native controls
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/ci/test_pon_w1_legal_strategy_reader_v1.py 2>&1 | tee "$OUT/legal-reader-controls.log"
          python3 -B scripts/ci/test_w1_factorial_native_gate.py 2>&1 | tee "$OUT/native-completion-gate-controls.log"
          python3 scripts/ci/test_pon_w1_legal_strategy_reader_v2.py 2>&1 | tee "$OUT/legal-reader-v2-controls.log"
          python3 scripts/ci/test_run_w1_false_trace_reuse_v1.py 2>&1 | tee "$OUT/runner-controls.log"
          cargo +1.95.0 metadata --locked --manifest-path trillionnium/Cargo.toml --format-version 1 > "$OUT/cargo-graph.json"
          cargo +1.95.0 fmt --manifest-path trillionnium/Cargo.toml --all -- --check 2>&1 | tee "$OUT/format.log"
          cargo +1.95.0 test --locked --release --manifest-path trillionnium/Cargo.toml -p trnm-pon-node --example pon_w1_legal_strategy_v1 -- --test-threads=1 2>&1 | tee "$OUT/legal-native-controls.log"
          python3 -B scripts/ci/w1_native_controls.py --group legal --logs "$OUT" --output "$OUT/legal-native-controls-completion.json"
          python3 scripts/ci/test_w1_native_roster.py
          python3 scripts/ci/check_w1_native_roster.py --profile legal-example "$OUT/legal-native-controls.log"
          cargo +1.95.0 clippy --locked --manifest-path trillionnium/Cargo.toml -p trnm-pon-node --example pon_w1_legal_strategy_v1 -- -D warnings 2>&1 | tee "$OUT/legal-clippy.log"
      - name: Execute all thirty original-budget legal strategy shards
        if: always() && steps.source.outcome == 'success'
        shell: bash
        run: |
          set -euo pipefail
          mode=--legal-strategy
          if test "$LEGAL_VERSION" = v2; then mode=--legal-strategy-v2; fi
          env -u CARGO_INCREMENTAL python3 scripts/ci/run_w1_false_trace_reuse_v1.py --arch "${{ matrix.arch }}" "$mode"
      - name: Verify measured source after execution
        if: always() && steps.source.outcome == 'success'
        shell: bash
        run: |
          set -euo pipefail
          args=(--kind "$SOURCE_KIND" --expected-head "$EXPECTED_HEAD")
          if test "$SOURCE_KIND" = prospective-merge; then
            args+=(--expected-base "$EXPECTED_BASE" --expected-merge "$EXPECTED_SOURCE")
          fi
          python3 scripts/ci/verify_ci_source.py "${args[@]}" --output "$OUT/source-after.json"
      - name: Preserve this lane's actual push source context
        if: always() && github.event_name == 'push'
        shell: bash
        run: |
          set -euo pipefail
          push_context_out="$RUNNER_TEMP/$LEGAL_CAPTURE_PREFIX-$SOURCE_KIND-${{ matrix.arch }}-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          mkdir -p "$push_context_out"
          cp "$RUNNER_TEMP/integration-push-context.json" "$push_context_out/push-source-context.json"
      - name: Retain costs, binaries and all failures
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: ${{ env.LEGAL_ARTIFACT_PREFIX }}-${{ matrix.source }}-${{ matrix.arch }}-${{ env.EXPECTED_SOURCE }}-${{ github.run_attempt }}
          path: ${{ runner.temp }}/${{ env.LEGAL_CAPTURE_PREFIX }}-${{ matrix.source }}-${{ matrix.arch }}-${{ github.run_id }}-${{ github.run_attempt }}/
          if-no-files-found: error
          retention-days: 30
  legal-factorial:
    needs: push-source-context
    if: ${{ !cancelled() && (github.event_name == 'pull_request' || needs.push-source-context.result == 'success') }}
    name: W1 factorial legal strategies v3 (${{ matrix.arch }}, ${{ matrix.source }})
    runs-on: ${{ matrix.runner }}
    timeout-minutes: 180
    strategy:
      fail-fast: false
      matrix:
        arch: [x64, arm64]
        source: [head, prospective-merge]
        include:
          - arch: x64
            runner: ubuntu-24.04
          - arch: arm64
            runner: ubuntu-24.04-arm
    env:
      TRNM_COST_RUNNER_LABEL: ${{ matrix.runner }}
      SOURCE_KIND: ${{ matrix.source }}
      EXPECTED_SOURCE: ${{ matrix.source == 'head' && (github.event_name == 'push' && needs.push-source-context.outputs.head || github.event.pull_request.head.sha) || (github.event_name == 'push' && needs.push-source-context.outputs.merge || github.sha) }}
      TRNM_EXPECTED_SOURCE_SHA: ${{ matrix.source == 'head' && (github.event_name == 'push' && needs.push-source-context.outputs.head || github.event.pull_request.head.sha) || (github.event_name == 'push' && needs.push-source-context.outputs.merge || github.sha) }}
      EXPECTED_HEAD: ${{ github.event_name == 'push' && needs.push-source-context.outputs.head || github.event.pull_request.head.sha }}
      EXPECTED_BASE: ${{ github.event_name == 'push' && needs.push-source-context.outputs.base || github.event.pull_request.base.sha }}
      EXPECTED_MERGE: ${{ github.event_name == 'push' && needs.push-source-context.outputs.merge || github.sha }}
    steps:
      - name: Checkout exact measured source
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ github.event_name == 'push' && needs.push-source-context.outputs.head || env.EXPECTED_SOURCE }}
          fetch-depth: 0
          persist-credentials: false
      - name: Reproduce the frozen integration-push source
        if: github.event_name == 'push'
        env:
          PUSH_SOURCE_CONTEXT: ${{ needs.push-source-context.outputs.context }}
          PUSH_SOURCE_CONTEXT_SHA256: ${{ needs.push-source-context.outputs.context_sha256 }}
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/ci/integration_push_source.py materialize --kind "$SOURCE_KIND" --context-json "$PUSH_SOURCE_CONTEXT" --context-sha256 "$PUSH_SOURCE_CONTEXT_SHA256" --output "$RUNNER_TEMP/integration-push-context.json"
      - name: Reserve observations and verify ordered source identity
        id: source
        shell: bash
        run: |
          set -euo pipefail
          out="$RUNNER_TEMP/w1-legal-factorial-$SOURCE_KIND-${{ matrix.arch }}-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          mkdir "$out"
          printf 'OUT=%s\n' "$out" >> "$GITHUB_ENV"
          printf 'TRNM_CI_RECEIPT_DIR=%s\n' "$out" >> "$GITHUB_ENV"
          printf 'CARGO_HOME=%s/cargo-w1-legal-factorial\n' "$RUNNER_TEMP" >> "$GITHUB_ENV"
          printf 'CARGO_TARGET_DIR=%s/target-w1-legal-factorial\n' "$RUNNER_TEMP" >> "$GITHUB_ENV"
          args=(--kind "$SOURCE_KIND" --expected-head "$EXPECTED_HEAD")
          if test "$SOURCE_KIND" = prospective-merge; then
            args+=(--expected-base "$EXPECTED_BASE" --expected-merge "$EXPECTED_SOURCE")
          fi
          python3 scripts/ci/verify_ci_source.py "${args[@]}" --output "$out/source-before.json"
          bash scripts/project-preflight.sh --audit 2>&1 | tee "$out/preflight.log"
      - name: Install exact original compiler and tools
        run: rustup toolchain install 1.95.0 --profile minimal --component rustfmt --component clippy
      - name: Verify retained and factorial readers and command-owner failures
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/ci/test_pon_w1_legal_strategy_reader_v1.py 2>&1 | tee "$OUT/retained-legal-reader-controls.log"
          python3 scripts/ci/test_w1_factorial_native_gate.py
          python3 scripts/ci/test_pon_w1_legal_strategy_reader_v3.py 2>&1 | tee "$OUT/factorial-reader-controls.log"
          python3 scripts/ci/test_run_w1_false_trace_reuse_v1.py 2>&1 | tee "$OUT/runner-controls.log"
          python3 scripts/ci/test_ci_source_integrity.py 2>&1 | tee "$OUT/source-rejection-controls.log"
      - name: Verify actual locked graph and original formatting
        shell: bash
        run: |
          set -euo pipefail
          cargo +1.95.0 metadata --locked --manifest-path trillionnium/Cargo.toml --format-version 1 > "$OUT/cargo-graph.json"
          cargo +1.95.0 fmt --manifest-path trillionnium/Cargo.toml --all -- --check 2>&1 | tee "$OUT/format.log"
      - name: Execute native producer, header, History and CPU cancellation controls
        shell: bash
        run: |
          set -euo pipefail
          cargo +1.95.0 test --locked --release --manifest-path trillionnium/Cargo.toml -p trnm-crypto-primitives --lib pon_work::legal_attempt:: -- --test-threads=1 2>&1 | tee "$OUT/factorial-kernel-tests.log"
          cargo +1.95.0 test --locked --release --manifest-path trillionnium/Cargo.toml -p trnm-pon-node --example pon_w1_legal_strategy_v3 -- --test-threads=1 2>&1 | tee "$OUT/factorial-example-tests.log"
          cargo +1.95.0 test --locked --release --manifest-path trillionnium/Cargo.toml -p trnm-pon-node --test work_header_binding -- --test-threads=1 2>&1 | tee "$OUT/header-binding-tests.log"
          cargo +1.95.0 test --locked --release --manifest-path trillionnium/Cargo.toml -p trnm-pon-node --lib history_w1_ -- --test-threads=1 --nocapture 2>&1 | tee "$OUT/history-w1-tests.log"
          cargo +1.95.0 test --locked --release --manifest-path trillionnium/Cargo.toml -p trnm-pon-node --lib ingress::history_import::tests:: -- --test-threads=1 --nocapture 2>&1 | tee "$OUT/history-import-tests.log"
          cargo +1.95.0 test --locked --release --manifest-path trillionnium/Cargo.toml -p trnm-pon-node --lib ingress::public_v3::scalar_cpu::completion_tests:: -- --test-threads=1 --nocapture 2>&1 | tee "$OUT/cpu-completion-tests.log"
          python3 -B scripts/ci/w1_native_controls.py --group factorial --logs "$OUT" --output "$OUT/factorial-native-controls-completion.json"
          python3 scripts/ci/test_w1_native_roster.py
          python3 scripts/ci/check_w1_native_roster.py --profile factorial-example "$OUT/factorial-example-tests.log"
          python3 scripts/ci/check_w1_native_roster.py --profile history-import "$OUT/history-import-tests.log"
      - name: Prepare pinned provider required by native all-feature controls
        shell: bash
        run: bash scripts/ci/prepare_pq_provider.sh
      - name: Run strict native lint for all affected owners
        shell: bash
        run: |
          set -euo pipefail
          cargo +1.95.0 clippy --locked --manifest-path trillionnium/Cargo.toml -p trnm-crypto-primitives --lib --tests -- -D warnings 2>&1 | tee "$OUT/factorial-kernel-clippy.log"
          cargo +1.95.0 clippy --locked --manifest-path trillionnium/Cargo.toml -p trnm-pon-node --all-targets --all-features -- -D warnings 2>&1 | tee "$OUT/factorial-node-clippy.log"
      - name: Execute all thirty separate v3 shards under the original per-shard budget
        if: always() && steps.source.outcome == 'success'
        run: env -u CARGO_INCREMENTAL python3 scripts/ci/run_w1_false_trace_reuse_v1.py --arch "${{ matrix.arch }}" --legal-strategy-v3
      - name: Verify measured source after execution
        if: always() && steps.source.outcome == 'success'
        shell: bash
        run: |
          set -euo pipefail
          args=(--kind "$SOURCE_KIND" --expected-head "$EXPECTED_HEAD")
          if test "$SOURCE_KIND" = prospective-merge; then
            args+=(--expected-base "$EXPECTED_BASE" --expected-merge "$EXPECTED_SOURCE")
          fi
          python3 scripts/ci/verify_ci_source.py "${args[@]}" --output "$OUT/source-after.json"
      - name: Preserve this lane's actual push source context
        if: always() && github.event_name == 'push'
        shell: bash
        run: |
          set -euo pipefail
          push_context_out="$RUNNER_TEMP/w1-legal-factorial-$SOURCE_KIND-${{ matrix.arch }}-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          mkdir -p "$push_context_out"
          cp "$RUNNER_TEMP/integration-push-context.json" "$push_context_out/push-source-context.json"
      - name: Retain costs, binaries and all failures
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: w1-legal-factorial-${{ matrix.source }}-${{ matrix.arch }}-${{ env.EXPECTED_SOURCE }}-${{ github.run_attempt }}
          path: ${{ runner.temp }}/w1-legal-factorial-${{ matrix.source }}-${{ matrix.arch }}-${{ github.run_id }}-${{ github.run_attempt }}/
          if-no-files-found: error
          retention-days: 30
  fresh-challenge-service:
    needs: push-source-context
    if: ${{ !cancelled() && (github.event_name == 'pull_request' || needs.push-source-context.result == 'success') }}
    name: W1 fresh challenge service (x64, ${{ matrix.source }})
    runs-on: ubuntu-24.04
    timeout-minutes: 55
    strategy:
      fail-fast: false
      matrix:
        source: [head, prospective-merge]
    env:
      SOURCE_KIND: ${{ matrix.source }}
      EXPECTED_SOURCE: ${{ matrix.source == 'head' && (github.event_name == 'push' && needs.push-source-context.outputs.head || github.event.pull_request.head.sha) || (github.event_name == 'push' && needs.push-source-context.outputs.merge || github.sha) }}
      TRNM_EXPECTED_SOURCE_SHA: ${{ matrix.source == 'head' && (github.event_name == 'push' && needs.push-source-context.outputs.head || github.event.pull_request.head.sha) || (github.event_name == 'push' && needs.push-source-context.outputs.merge || github.sha) }}
      EXPECTED_HEAD: ${{ github.event_name == 'push' && needs.push-source-context.outputs.head || github.event.pull_request.head.sha }}
      EXPECTED_BASE: ${{ github.event_name == 'push' && needs.push-source-context.outputs.base || github.event.pull_request.base.sha }}
      EXPECTED_MERGE: ${{ github.event_name == 'push' && needs.push-source-context.outputs.merge || github.sha }}
    steps:
      - name: Checkout exact observed source
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ github.event_name == 'push' && needs.push-source-context.outputs.head || env.EXPECTED_SOURCE }}
          fetch-depth: 0
          persist-credentials: false
      - name: Reproduce the frozen integration-push source
        if: github.event_name == 'push'
        env:
          PUSH_SOURCE_CONTEXT: ${{ needs.push-source-context.outputs.context }}
          PUSH_SOURCE_CONTEXT_SHA256: ${{ needs.push-source-context.outputs.context_sha256 }}
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/ci/integration_push_source.py materialize --kind "$SOURCE_KIND" --context-json "$PUSH_SOURCE_CONTEXT" --context-sha256 "$PUSH_SOURCE_CONTEXT_SHA256" --output "$RUNNER_TEMP/integration-push-context.json"
      - name: Reserve observations and verify ordered source identity
        id: source
        shell: bash
        run: |
          set -euo pipefail
          out="$RUNNER_TEMP/w1-fresh-service-$SOURCE_KIND-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          mkdir "$out"
          printf 'OUT=%s\n' "$out" >> "$GITHUB_ENV"
          printf 'TRNM_CI_RECEIPT_DIR=%s\n' "$out" >> "$GITHUB_ENV"
          printf 'CARGO_HOME=%s/cargo-w1-fresh\n' "$RUNNER_TEMP" >> "$GITHUB_ENV"
          printf 'CARGO_TARGET_DIR=%s/target-w1-fresh\n' "$RUNNER_TEMP" >> "$GITHUB_ENV"
          args=(--kind "$SOURCE_KIND" --expected-head "$EXPECTED_HEAD")
          if test "$SOURCE_KIND" = prospective-merge; then
            args+=(--expected-base "$EXPECTED_BASE" --expected-merge "$EXPECTED_SOURCE")
          fi
          python3 scripts/ci/verify_ci_source.py "${args[@]}" --output "$out/source.json"
          bash scripts/project-preflight.sh --audit 2>&1 | tee "$out/preflight.log"
      - name: Install original pinned compiler
        run: rustup toolchain install 1.95.0 --profile minimal
      - name: Run refusal controls for original Host and fresh successor
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/ci/test_from_zero_host_ci.py 2>&1 | tee "$OUT/original-host-controls.log"
          python3 scripts/ci/test_run_from_zero_native.py 2>&1 | tee "$OUT/original-native-controls.log"
          python3 scripts/ci/test_run_w1_fresh_service_v1.py 2>&1 | tee "$OUT/fresh-service-controls.log"
      - name: Execute original and fresh service with original Host resources
        if: always() && steps.source.outcome == 'success'
        run: python3 scripts/ci/run_from_zero_host.py -- python3 scripts/ci/run_w1_fresh_service_v1.py --out "$OUT/fresh-service"
      - name: Verify observed source after execution
        if: always() && steps.source.outcome == 'success'
        shell: bash
        run: |
          set -euo pipefail
          args=(--kind "$SOURCE_KIND" --expected-head "$EXPECTED_HEAD")
          if test "$SOURCE_KIND" = prospective-merge; then
            args+=(--expected-base "$EXPECTED_BASE" --expected-merge "$EXPECTED_SOURCE")
          fi
          python3 scripts/ci/verify_ci_source.py "${args[@]}" --output "$OUT/source-after.json"
      - name: Preserve this lane's actual push source context
        if: always() && github.event_name == 'push'
        shell: bash
        run: |
          set -euo pipefail
          push_context_out="$RUNNER_TEMP/w1-fresh-service-$SOURCE_KIND-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          mkdir -p "$push_context_out"
          cp "$RUNNER_TEMP/integration-push-context.json" "$push_context_out/push-source-context.json"
      - name: Retain both service outcomes and original Host evidence
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: w1-fresh-service-${{ matrix.source }}-${{ env.EXPECTED_SOURCE }}-${{ github.run_attempt }}
          path: ${{ runner.temp }}/w1-fresh-service-${{ matrix.source }}-${{ github.run_id }}-${{ github.run_attempt }}/
          if-no-files-found: error
          retention-days: 30
  rank-batch-v5:
    needs: push-source-context
    if: ${{ !cancelled() && (github.event_name == 'pull_request' || needs.push-source-context.result == 'success') }}
    name: W1 paid rank and batch v5 (${{ matrix.arch }}, ${{ matrix.source }})
    runs-on: ${{ matrix.runner }}
    timeout-minutes: 55
    strategy:
      fail-fast: false
      matrix:
        arch: [x64, arm64]
        source: [head, prospective-merge]
        include:
          - arch: x64
            runner: ubuntu-24.04
          - arch: arm64
            runner: ubuntu-24.04-arm
    env:
      SOURCE_KIND: ${{ matrix.source }}
      EXPECTED_SOURCE: ${{ matrix.source == 'head' && (github.event_name == 'push' && needs.push-source-context.outputs.head || github.event.pull_request.head.sha) || (github.event_name == 'push' && needs.push-source-context.outputs.merge || github.sha) }}
      EXPECTED_HEAD: ${{ github.event_name == 'push' && needs.push-source-context.outputs.head || github.event.pull_request.head.sha }}
      EXPECTED_BASE: ${{ github.event_name == 'push' && needs.push-source-context.outputs.base || github.event.pull_request.base.sha }}
      EXPECTED_MERGE: ${{ github.event_name == 'push' && needs.push-source-context.outputs.merge || github.sha }}
    steps:
      - name: Checkout exact measured source
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ github.event_name == 'push' && needs.push-source-context.outputs.head || env.EXPECTED_SOURCE }}
          fetch-depth: 0
          persist-credentials: false
      - name: Reproduce the frozen integration-push source
        if: github.event_name == 'push'
        env:
          PUSH_SOURCE_CONTEXT: ${{ needs.push-source-context.outputs.context }}
          PUSH_SOURCE_CONTEXT_SHA256: ${{ needs.push-source-context.outputs.context_sha256 }}
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/ci/integration_push_source.py materialize --kind "$SOURCE_KIND" --context-json "$PUSH_SOURCE_CONTEXT" --context-sha256 "$PUSH_SOURCE_CONTEXT_SHA256" --output "$RUNNER_TEMP/integration-push-context.json"
      - name: Reserve records and verify ordered source identity
        id: source
        shell: bash
        run: |
          set -euo pipefail
          out="$RUNNER_TEMP/w1-rank-batch-$SOURCE_KIND-${{ matrix.arch }}-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          mkdir "$out"
          printf 'OUT=%s\n' "$out" >> "$GITHUB_ENV"
          printf 'CARGO_HOME=%s/cargo-w1-rank-batch\n' "$RUNNER_TEMP" >> "$GITHUB_ENV"
          printf 'CARGO_TARGET_DIR=%s/target-w1-rank-batch\n' "$RUNNER_TEMP" >> "$GITHUB_ENV"
          args=(--kind "$SOURCE_KIND" --expected-head "$EXPECTED_HEAD")
          if test "$SOURCE_KIND" = prospective-merge; then
            args+=(--expected-base "$EXPECTED_BASE" --expected-merge "$EXPECTED_SOURCE")
          fi
          python3 scripts/ci/verify_ci_source.py "${args[@]}" --output "$out/source-before.json"
          bash scripts/project-preflight.sh --audit 2>&1 | tee "$out/preflight.log"
      - name: Install exact original compiler and tools
        run: rustup toolchain install 1.95.0 --profile minimal --component rustfmt --component clippy
      - name: Require reader and real process-owner failure controls
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/ci/test_pon_w1_rank_batch_reader_v5.py 2>&1 | tee "$OUT/reader-controls.log"
          python3 scripts/ci/test_run_w1_rank_batch_v5.py 2>&1 | tee "$OUT/runner-controls.log"
      - name: Verify actual locked graph and formatting
        shell: bash
        run: |
          set -euo pipefail
          cargo +1.95.0 metadata --locked --manifest-path trillionnium/Cargo.toml --format-version 1 > "$OUT/cargo-graph.json"
          cargo +1.95.0 fmt --manifest-path trillionnium/Cargo.toml --all -- --check 2>&1 | tee "$OUT/format.log"
      - name: Execute complete kernel and actual batch controls
        shell: bash
        run: |
          set -euo pipefail
          cargo +1.95.0 test --locked --release --manifest-path trillionnium/Cargo.toml -p trnm-crypto-primitives --lib pon_work::legal_attempt:: -- --test-threads=1 2>&1 | tee "$OUT/kernel-tests.log"
          cargo +1.95.0 test --locked --release --manifest-path trillionnium/Cargo.toml -p trnm-crypto-primitives --example pon_w1_rank_batch_v5 -- --test-threads=1 2>&1 | tee "$OUT/batch-tests.log"
          python3 - "$OUT" <<'PYRANK'
          import re, sys
          from pathlib import Path
          sys.path.insert(0, 'scripts/ci')
          from w1_native_controls import validate_log
          for name, count in [('kernel-tests', 19), ('batch-tests', 9)]:
              raw = (Path(sys.argv[1]) / (name + '.log')).read_text()
              rows = re.findall(r'^test result: ok\. ([0-9]+) passed; 0 failed; ([0-9]+) ignored;', raw, re.M)
              if rows != [(str(count), '0')]:
                  raise SystemExit(name + ': original and new native controls must all execute')
              if name == 'kernel-tests':
                  validate_log('factorial-kernel-tests', raw)
          PYRANK
          cargo +1.95.0 clippy --locked --manifest-path trillionnium/Cargo.toml -p trnm-crypto-primitives --all-targets -- -D warnings 2>&1 | tee "$OUT/clippy.log"
      - name: Execute all sixty-six shards with the original command budgets
        if: always() && steps.source.outcome == 'success'
        run: env -u CARGO_INCREMENTAL python3 scripts/ci/run_w1_rank_batch_v5.py --arch "${{ matrix.arch }}" --expected-commit "$EXPECTED_SOURCE" --output "$OUT/campaign"
      - name: Verify measured source after execution
        if: always() && steps.source.outcome == 'success'
        shell: bash
        run: |
          set -euo pipefail
          args=(--kind "$SOURCE_KIND" --expected-head "$EXPECTED_HEAD")
          if test "$SOURCE_KIND" = prospective-merge; then
            args+=(--expected-base "$EXPECTED_BASE" --expected-merge "$EXPECTED_SOURCE")
          fi
          python3 scripts/ci/verify_ci_source.py "${args[@]}" --output "$OUT/source-after.json"
      - name: Preserve this lane's actual push source context
        if: always() && github.event_name == 'push'
        shell: bash
        run: |
          set -euo pipefail
          push_context_out="$RUNNER_TEMP/w1-rank-batch-$SOURCE_KIND-${{ matrix.arch }}-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          mkdir -p "$push_context_out"
          cp "$RUNNER_TEMP/integration-push-context.json" "$push_context_out/push-source-context.json"
      - name: Retain every cost, binary and failed attempt
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: w1-rank-batch-v5-${{ matrix.source }}-${{ matrix.arch }}-${{ env.EXPECTED_SOURCE }}-${{ github.run_attempt }}
          path: ${{ runner.temp }}/w1-rank-batch-${{ matrix.source }}-${{ matrix.arch }}-${{ github.run_id }}-${{ github.run_attempt }}/
          if-no-files-found: error
          retention-days: 30

edf52aa66d2b46cd8795420ef7c508ea0a3357e9 blob 3515
name: PoN work and time contract V1

on:
  pull_request:

permissions:
  contents: read

jobs:
  work-time-contract:
    name: Work and time contract (${{ matrix.source }})
    runs-on: ubuntu-24.04
    timeout-minutes: 30
    strategy:
      fail-fast: false
      matrix:
        source: [head, prospective-merge]
    env:
      PYTHONDONTWRITEBYTECODE: '1'
      TRNM_SOURCE_KIND: ${{ matrix.source }}
      TRNM_EXPECTED_SOURCE_SHA: ${{ matrix.source == 'head' && github.event.pull_request.head.sha || github.sha }}
      TRNM_EXPECTED_CANDIDATE_SHA: ${{ github.event.pull_request.head.sha }}
      TRNM_EXPECTED_BASE_SHA: ${{ github.event.pull_request.base.sha }}
    steps:
      - name: Checkout exact source
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ env.TRNM_EXPECTED_SOURCE_SHA }}
          fetch-depth: 0
          persist-credentials: false
      - name: Verify full tracked source before execution
        shell: bash
        run: |
          set -euo pipefail
          args=(--kind "$TRNM_SOURCE_KIND" --expected-head "$TRNM_EXPECTED_CANDIDATE_SHA")
          if test "$TRNM_SOURCE_KIND" = prospective-merge; then
            args+=(--expected-base "$TRNM_EXPECTED_BASE_SHA" --expected-merge "$TRNM_EXPECTED_SOURCE_SHA")
          fi
          python3 scripts/ci/verify_ci_source.py "${args[@]}" --output "$RUNNER_TEMP/work-time-source-before.json"
      - name: Check repository boundary and retained source integrity controls
        shell: bash
        run: |
          set -euo pipefail
          bash scripts/project-preflight.sh --audit
          python3 scripts/ci/test_ci_source_integrity.py
      - name: Prepare independent fixed baseline reference
        shell: bash
        run: |
          set -euo pipefail
          baseline="$RUNNER_TEMP/work-time-baseline"
          test ! -e "$baseline"
          git clone --shared --no-checkout . "$baseline"
          git -C "$baseline" sparse-checkout init --no-cone
          git -C "$baseline" sparse-checkout set --no-cone /trillionnium/ /formal/ /config/ /rust-toolchain.toml
          git -C "$baseline" checkout --detach b16bae2824e6c8236ef2011fc93a74df3ac7f039
      - name: Execute named controls and full historical W1 replay
        run: python3 scripts/ci/run_work_time_contract_v1.py --output-dir "$RUNNER_TEMP/work-time-contract" --campaign --frozen-baseline-source "$RUNNER_TEMP/work-time-baseline"
      - name: Verify full tracked source after execution
        if: always()
        shell: bash
        run: |
          set -euo pipefail
          args=(--kind "$TRNM_SOURCE_KIND" --expected-head "$TRNM_EXPECTED_CANDIDATE_SHA")
          if test "$TRNM_SOURCE_KIND" = prospective-merge; then
            args+=(--expected-base "$TRNM_EXPECTED_BASE_SHA" --expected-merge "$TRNM_EXPECTED_SOURCE_SHA")
          fi
          python3 scripts/ci/verify_ci_source.py "${args[@]}" --output "$RUNNER_TEMP/work-time-source-after.json"
      - name: Retain all outcomes and source receipts
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: work-time-contract-${{ matrix.source }}-${{ env.TRNM_EXPECTED_SOURCE_SHA }}-${{ github.run_attempt }}
          path: |
            ${{ runner.temp }}/work-time-source-before.json
            ${{ runner.temp }}/work-time-source-after.json
            ${{ runner.temp }}/work-time-contract/
          if-no-files-found: error
          retention-days: 30

53be8e4d1ee721831662e64d483a1a958d5de041 blob 9375
name: Release finality reference and native baseline
on:
  pull_request:
    paths:
      - formal/release-finality-v2/**
      - config/finality-profile-v1.json
      - config/release-finality-v2.json
      - scripts/ci/test_finality_profile.py
      - scripts/ci/check_required_native_test.py
      - scripts/cell_adoption_readback.py
      - scripts/test_cell_adoption_readback.py
      - scripts/cell_learning_iteration_join.py
      - scripts/test_cell_learning_iteration_join.py
      - scripts/cell_learning_completion_join.py
      - scripts/capture_cell_learning_completion.py
      - scripts/test_cell_learning_completion_join.py
      - scripts/cell_learning_scope_join.py
      - scripts/test_cell_learning_scope_join.py
      - scripts/cell_learning_business_join.py
      - scripts/cell_learning_business_economics.py
      - scripts/test_cell_learning_business_join.py
      - scripts/test_cell_learning_business_economics.py
      - scripts/test_cell_learning_training_no_update_join.py
      - evidence/heplcp03-interop-20261111/**
      - evidence/next-use-provenance-20261110/**
      - evidence/cell-learning-business-readback-20261109/bindings/**
      - evidence/cell-learning-completion-20261108/**
      - evidence/hepta-real-native-adoption-20261108/chain-reader/**
      - evidence/cell-learning-iteration-20261108/native-readbacks/**
      - evidence/cell-adoption-20261108/native-readbacks/**
      - evidence/smollm-cell-replica-research-v1/actual/research-result.json
      - docs/protocol/release-finality-v2/**
      - trillionnium/crates/trnm-pon-node/**
      - trillionnium/crates/trnm-crypto-primitives/**
      - trillionnium/Cargo.toml
      - trillionnium/Cargo.lock
      - .github/workflows/release-finality-reference.yml
permissions:
  contents: read
concurrency:
  group: release-finality-${{ github.event.pull_request.number }}
  cancel-in-progress: false
jobs:
  reference:
    strategy:
      fail-fast: false
      matrix:
        runner: [ubuntu-24.04, ubuntu-24.04-arm]
        lane: [head, prospective-merge]
    runs-on: ${{ matrix.runner }}
    timeout-minutes: 30
    env:
      PYTHONDONTWRITEBYTECODE: "1"
      CARGO_BUILD_JOBS: "2"
      RUST_TEST_THREADS: "1"
      SOURCE: ${{ github.event.pull_request.head.sha }}
      BASE: ${{ github.event.pull_request.base.sha }}
      TESTED: ${{ matrix.lane == 'head' && github.event.pull_request.head.sha || github.sha }}
      LANE: ${{ matrix.lane }}
    steps:
      - uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd
        with:
          ref: ${{ env.TESTED }}
          fetch-depth: 0
          persist-credentials: false
      - name: Verify actual immutable source and unchanged original preflight
        run: |
          set -euo pipefail
          mkdir "$RUNNER_TEMP/release-finality"
          args=(--kind "$LANE" --expected-head "$SOURCE")
          if test "$LANE" = prospective-merge; then
            args+=(--expected-base "$BASE" --expected-merge "$TESTED")
          fi
          python3 scripts/ci/verify_ci_source.py "${args[@]}" --output "$RUNNER_TEMP/release-finality/source-before.json"
          bash scripts/project-preflight.sh --audit
      - name: Install existing frozen conformance environment
        run: |
          set -euo pipefail
          python3 -m venv "$RUNNER_TEMP/finality-env"
          "$RUNNER_TEMP/finality-env/bin/python" -m pip install --disable-pip-version-check --only-binary=:all: -r formal/pon-nakamoto-v1/requirements.txt
      - name: Execute all reference, recovery and separate-reader controls
        run: |
          set -euo pipefail
          py="$RUNNER_TEMP/finality-env/bin/python"
          "$py" scripts/ci/test_finality_profile.py
          "$py" formal/release-finality-v2/run_conformance.py --out "$RUNNER_TEMP/release-finality/conformance"
          "$py" scripts/test_cell_adoption_readback.py -v
          "$py" scripts/test_cell_learning_iteration_join.py -v
          "$py" scripts/test_cell_learning_completion_join.py -v
          "$py" scripts/test_cell_learning_scope_join.py -v
          "$py" scripts/test_cell_learning_training_no_update_join.py -v
      - name: Preserve original signed learning suites and execute actual V3 join
        run: |
          set -euo pipefail
          py="$RUNNER_TEMP/finality-env/bin/python"
          "$py" formal/pon-nakamoto-v1/test_model_generation_sequence.py -v
          "$py" formal/pon-nakamoto-v1/test_model_generation_sequence_context.py -v
          "$py" formal/pon-nakamoto-v1/test_model_generation_sequence_parent.py -v
          "$py" formal/release-finality-v2/check_existing_learning_owner.py
      - name: Build original native pipeline without changing runtime
        env:
          RUSTUP_HOME: ${{ runner.temp }}/release-finality-rustup-${{ github.run_id }}-${{ github.run_attempt }}-${{ matrix.runner }}-${{ matrix.lane }}
        run: |
          set -euo pipefail
          mkdir "$RUSTUP_HOME"
          rustup toolchain install 1.95.0 --profile minimal --component clippy --component rustfmt
          cargo +1.95.0 build --locked --release --manifest-path trillionnium/Cargo.toml -p trnm-pon-node --example continuous_pipeline
          sha256sum trillionnium/target/release/examples/continuous_pipeline > "$RUNNER_TEMP/release-finality/native-binary.sha256"
          rustc +1.95.0 --version > "$RUNNER_TEMP/release-finality/compiler.txt"
          uname -a > "$RUNNER_TEMP/release-finality/environment.txt"
      - name: Require each native certificate and separate-reference selector to execute
        env:
          RUSTUP_HOME: ${{ runner.temp }}/release-finality-rustup-${{ github.run_id }}-${{ github.run_attempt }}-${{ matrix.runner }}-${{ matrix.lane }}
        run: |
          set -euo pipefail
          export TRNM_FINALITY_REFERENCE_PYTHON="$RUNNER_TEMP/finality-env/bin/python"
          overall=0
          for selector in \
            original_reference_signed_fixture_preserves_facts_and_scope \
            native_reader_enforces_adversarial_corpus_without_python \
            unchanged_python_reference_regenerates_exact_fixture_bytes \
            original_python_reader_and_native_reader_agree_on_adversarial_corpus; do
            log="$RUNNER_TEMP/release-finality/$selector.log"
            if ! cargo +1.95.0 test --locked --release --manifest-path trillionnium/Cargo.toml \
              -p trnm-pon-node --test release_finality_v2 "$selector" -- \
              --exact --include-ignored --format pretty --nocapture --test-threads=1 \
              2>&1 | tee "$log"; then overall=1; fi
            if ! python3 scripts/ci/check_required_native_test.py "$log" --test "$selector" \
              > "$RUNNER_TEMP/release-finality/$selector.execution.json"; then overall=1; fi
          done
          exit "$overall"
      - name: Observe every original hot disjoint and growth baseline; preserve failures
        run: |
          # GitHub invokes bash with -e; collect all three outcomes explicitly.
          set +e
          set -uo pipefail
          overall=0
          for pattern in hot disjoint4 growth; do
            timeout 300s trillionnium/target/release/examples/continuous_pipeline \
              "$RUNNER_TEMP/release-finality/$pattern" 8 32 1000 "$pattern" protected \
              > "$RUNNER_TEMP/release-finality/$pattern.stdout" 2> "$RUNNER_TEMP/release-finality/$pattern.stderr"
            code=$?
            printf '%s\n' "$code" > "$RUNNER_TEMP/release-finality/$pattern.exit"
            if test "$code" -ne 0; then overall=1; fi
          done
          exit "$overall"
      - name: Recompute existing native counters without claiming saturation
        if: always()
        run: |
          set -euo pipefail
          "$RUNNER_TEMP/finality-env/bin/python" - "$RUNNER_TEMP/release-finality" <<'PY'
          import json, pathlib, sys
          sys.path.insert(0, 'formal/release-finality-v2')
          from campaign_gate import pipeline_observation
          root=pathlib.Path(sys.argv[1]); observations={}; failed=False
          for pattern in ('hot','disjoint4','growth'):
              source=root/pattern/'summary.json'
              if not source.is_file():
                  observations[pattern]={'status':'not_observed'}; failed=True
              else:
                  observations[pattern]=pipeline_observation(json.loads(source.read_bytes()))
                  failed |= not observations[pattern]['run_passed']
          (root/'pipeline-observations.json').write_text(json.dumps(observations,indent=2)+'\n')
          raise SystemExit(int(failed))
          PY
      - name: Recheck source even after failures
        if: always()
        run: |
          set -euo pipefail
          args=(--kind "$LANE" --expected-head "$SOURCE")
          if test "$LANE" = prospective-merge; then
            args+=(--expected-base "$BASE" --expected-merge "$TESTED")
          fi
          python3 scripts/ci/verify_ci_source.py "${args[@]}" --output "$RUNNER_TEMP/release-finality/source-after.json"
      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        if: always()
        with:
          name: release-finality-${{ matrix.runner }}-${{ matrix.lane }}-${{ github.event.pull_request.head.sha }}
          path: ${{ runner.temp }}/release-finality
          if-no-files-found: error
          retention-days: 30

7837ff18f48b3cb9b0d38f161fc8f27a9fdbf919 blob 35462
name: trnm-required-baseline
on:
  pull_request:
  push:
    branches: [main]
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: portable-${{ github.workflow }}-${{ github.ref }}
  # Preserve running head/merge evidence when a successor enters the queue.
  cancel-in-progress: false
env:
  CI: "true"
  CARGO_INCREMENTAL: "0"
  CARGO_BUILD_JOBS: "2"
  RUST_TEST_THREADS: "1"
  CARGO_TERM_COLOR: never
  PYTHONDONTWRITEBYTECODE: "1"
  TRNM_EXPECTED_SOURCE_SHA: ${{ github.event_name == 'pull_request' && github.event.pull_request.head.sha || github.sha }}
jobs:
  repository-truth:
    name: repository-truth
    runs-on: ubuntu-24.04
    timeout-minutes: 45
    steps:
      - name: Checkout exact candidate
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ env.TRNM_EXPECTED_SOURCE_SHA }}
          fetch-depth: 0
          persist-credentials: false
      - name: Verify immutable source identity
        run: python3 scripts/ci/verify_ci_source.py --kind head --expected-head "$TRNM_EXPECTED_SOURCE_SHA" --output "$RUNNER_TEMP/ci-observations/source.json"
      - name: Set isolated Cargo paths after runner allocation
        shell: bash
        run: |
          set -euo pipefail
          printf 'CARGO_HOME=%s/cargo-%s\n' "$RUNNER_TEMP" "$GITHUB_JOB" >> "$GITHUB_ENV"
          printf 'CARGO_TARGET_DIR=%s/target-%s\n' "$RUNNER_TEMP" "$GITHUB_JOB" >> "$GITHUB_ENV"
          printf 'TRNM_CI_RECEIPT_DIR=%s/ci-observations\n' "$RUNNER_TEMP" >> "$GITHUB_ENV"
      - name: Check PQ provider CI wiring and failure controls
        run: python3 scripts/ci/test_pq_provider_ci.py
      - name: Check original public Host CI ownership and failure controls
        run: python3 scripts/ci/test_from_zero_host_ci.py
      - name: Install isolated runtime material verifier dependency
        shell: bash
        run: |
          set -euo pipefail
          python3 -m venv "$RUNNER_TEMP/runtime-release-env"
          "$RUNNER_TEMP/runtime-release-env/bin/python" -m pip --isolated install --disable-pip-version-check --only-binary=:all: --require-hashes --report "$RUNNER_TEMP/ci-observations/runtime-release-dependencies.json" -r scripts/ci/runtime-release-requirements.txt
          printf 'TRNM_RUNTIME_RELEASE_PYTHON=%s/runtime-release-env/bin/python\n' "$RUNNER_TEMP" >> "$GITHUB_ENV"
      - name: Run actual repository-truth checks
        run: bash scripts/ci/ci_job.sh repository-truth
      - name: Verify source remained unchanged
        if: always()
        run: python3 scripts/ci/verify_ci_source.py --kind head --expected-head "$TRNM_EXPECTED_SOURCE_SHA"
      - name: Retain source and execution observations
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: head-${{ github.job }}-${{ env.TRNM_EXPECTED_SOURCE_SHA }}-${{ github.run_attempt }}
          path: ${{ runner.temp }}/ci-observations/
          if-no-files-found: error
          retention-days: 30
  cross-arch-cost:
    name: cross-arch-cost (${{ matrix.arch }})
    runs-on: ${{ matrix.runner }}
    timeout-minutes: 155
    strategy:
      fail-fast: false
      matrix:
        include:
          - arch: x64
            runner: ubuntu-24.04
          - arch: arm64
            runner: ubuntu-24.04-arm
    env:
      TRNM_COST_RUNNER_LABEL: ${{ matrix.runner }}
    steps:
      - name: Checkout exact candidate
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ env.TRNM_EXPECTED_SOURCE_SHA }}
          fetch-depth: 0
          persist-credentials: false
      - name: Verify immutable source identity
        run: python3 scripts/ci/verify_ci_source.py --kind head --expected-head "$TRNM_EXPECTED_SOURCE_SHA" --output "$RUNNER_TEMP/ci-observations/source.json"
      - name: Set isolated Cargo paths after runner allocation
        shell: bash
        run: |
          set -euo pipefail
          printf 'CARGO_HOME=%s/cargo-%s\n' "$RUNNER_TEMP" "$GITHUB_JOB" >> "$GITHUB_ENV"
          printf 'CARGO_TARGET_DIR=%s/target-%s\n' "$RUNNER_TEMP" "$GITHUB_JOB" >> "$GITHUB_ENV"
          printf 'TRNM_CI_RECEIPT_DIR=%s/ci-observations\n' "$RUNNER_TEMP" >> "$GITHUB_ENV"
      - name: Install pinned native release compiler
        run: rustup toolchain install 1.95.0 --profile minimal
      - name: Install matching native formatter
        run: rustup component add --toolchain 1.95.0 rustfmt
      - name: Execute native release setup and repeated-search costs
        run: env -u CARGO_INCREMENTAL python3 scripts/ci/run_cross_arch_cost.py --arch "${{ matrix.arch }}"
      - name: Execute native zero-matrix locality costs
        if: always()
        run: env -u CARGO_INCREMENTAL python3 scripts/ci/run_cross_arch_cost.py --arch "${{ matrix.arch }}" --suite zero-locality --zero-version 2
      - name: Execute native one-zero rank-one locality costs
        if: always()
        run: env -u CARGO_INCREMENTAL python3 scripts/ci/run_cross_arch_cost.py --arch "${{ matrix.arch }}" --suite one-zero-locality
      - name: Execute native fixed maintenance producer and preparation costs
        if: always()
        run: env -u CARGO_INCREMENTAL python3 scripts/ci/run_cross_arch_cost.py --arch "${{ matrix.arch }}" --suite maintenance-paired
      - name: Execute native legal and late-rejection verifier costs
        if: always()
        run: python3 scripts/pon_work_rejection_report.py --run --out "$TRNM_CI_RECEIPT_DIR/work-rejection"
      - name: Execute exact native from-zero service controls
        if: always()
        run: python3 scripts/ci/run_from_zero_host.py -- python3 scripts/ci/run_from_zero_native.py --out "$TRNM_CI_RECEIPT_DIR/from-zero-native"
      - name: Verify source remained unchanged
        if: always()
        run: python3 scripts/ci/verify_ci_source.py --kind head --expected-head "$TRNM_EXPECTED_SOURCE_SHA"
      - name: Retain native cost successes and failures
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: cost-${{ matrix.arch }}-${{ env.TRNM_EXPECTED_SOURCE_SHA }}-${{ github.run_attempt }}
          path: ${{ runner.temp }}/ci-observations/
          if-no-files-found: error
          retention-days: 30
  cross-arch-w1-reuse-v3:
    name: W1 actual reuse V3 (${{ matrix.arch }}, ${{ matrix.source }})
    if: github.event_name == 'pull_request'
    runs-on: ${{ matrix.runner }}
    timeout-minutes: 155
    strategy:
      fail-fast: false
      matrix:
        arch: [x64, arm64]
        source: [head, prospective-merge]
        include:
          - arch: x64
            runner: ubuntu-24.04
          - arch: arm64
            runner: ubuntu-24.04-arm
    env:
      TRNM_COST_RUNNER_LABEL: ${{ matrix.runner }}
      TRNM_COST_SOURCE_KIND: ${{ matrix.source }}
      TRNM_EXPECTED_SOURCE_SHA: ${{ matrix.source == 'head' && github.event.pull_request.head.sha || github.sha }}
      TRNM_EXPECTED_CANDIDATE_SHA: ${{ github.event.pull_request.head.sha }}
      TRNM_EXPECTED_BASE_SHA: ${{ github.event.pull_request.base.sha }}
    steps:
      - name: Checkout exact candidate
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ env.TRNM_EXPECTED_SOURCE_SHA }}
          fetch-depth: 0
          persist-credentials: false
      - name: Verify V3 exact source and ordered merge before execution
        shell: bash
        run: |
          set -euo pipefail
          args=(--kind "$TRNM_COST_SOURCE_KIND" --expected-head "$TRNM_EXPECTED_CANDIDATE_SHA")
          if test "$TRNM_COST_SOURCE_KIND" = prospective-merge; then
            args+=(--expected-base "$TRNM_EXPECTED_BASE_SHA" --expected-merge "$TRNM_EXPECTED_SOURCE_SHA")
          fi
          python3 scripts/ci/verify_ci_source.py "${args[@]}" --output "$RUNNER_TEMP/ci-observations/source-before.json"
      - name: Check original repository boundary before native V3 build
        run: bash scripts/project-preflight.sh --audit
      - name: Set isolated Cargo paths after runner allocation
        shell: bash
        run: |
          set -euo pipefail
          printf 'CARGO_HOME=%s/cargo-%s\n' "$RUNNER_TEMP" "$GITHUB_JOB" >> "$GITHUB_ENV"
          printf 'CARGO_TARGET_DIR=%s/target-%s\n' "$RUNNER_TEMP" "$GITHUB_JOB" >> "$GITHUB_ENV"
          printf 'TRNM_CI_RECEIPT_DIR=%s/ci-observations\n' "$RUNNER_TEMP" >> "$GITHUB_ENV"
      - name: Install pinned native release compiler
        run: rustup toolchain install 1.95.0 --profile minimal
      - name: Install matching native formatter
        run: rustup component add --toolchain 1.95.0 rustfmt
      - name: Execute the complete native W1 actual reuse V3 grid
        run: env -u CARGO_INCREMENTAL python3 scripts/ci/run_w1_reused_cost_v3.py --arch "${{ matrix.arch }}"
      - name: Verify V3 exact source and ordered merge after execution
        if: always()
        shell: bash
        run: |
          set -euo pipefail
          args=(--kind "$TRNM_COST_SOURCE_KIND" --expected-head "$TRNM_EXPECTED_CANDIDATE_SHA")
          if test "$TRNM_COST_SOURCE_KIND" = prospective-merge; then
            args+=(--expected-base "$TRNM_EXPECTED_BASE_SHA" --expected-merge "$TRNM_EXPECTED_SOURCE_SHA")
          fi
          python3 scripts/ci/verify_ci_source.py "${args[@]}" --output "$RUNNER_TEMP/ci-observations/source-after.json"
      - name: Retain V3 costs including all failed observations
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: w1-reuse-v3-${{ matrix.source }}-${{ matrix.arch }}-${{ env.TRNM_EXPECTED_SOURCE_SHA }}-${{ github.run_attempt }}
          path: ${{ runner.temp }}/ci-observations/
          if-no-files-found: error
          retention-days: 30
  cross-arch-cost-consistency:
    name: cross-arch-cost-consistency
    needs: cross-arch-cost
    if: always()
    runs-on: ubuntu-24.04
    timeout-minutes: 10
    steps:
      - name: Checkout exact candidate
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ env.TRNM_EXPECTED_SOURCE_SHA }}
          fetch-depth: 0
          persist-credentials: false
      - name: Verify immutable source identity
        run: python3 scripts/ci/verify_ci_source.py --kind head --expected-head "$TRNM_EXPECTED_SOURCE_SHA" --output "$RUNNER_TEMP/ci-observations/source.json"
      - name: Retrieve both actual cost observations from this run
        uses: actions/download-artifact@634f93cb2916e3fdff6788551b99b062d0335ce0
        with:
          pattern: cost-*-${{ env.TRNM_EXPECTED_SOURCE_SHA }}-${{ github.run_attempt }}
          path: ${{ runner.temp }}/cost-inputs/
          merge-multiple: false
      - name: Check actual streams and source identity without a speed threshold
        run: python3 scripts/ci/check_cross_arch_cost.py --artifacts "$RUNNER_TEMP/cost-inputs" --expected-source "$TRNM_EXPECTED_SOURCE_SHA" --output "$RUNNER_TEMP/ci-observations/cross-arch-comparison.json"
      - name: Check zero-matrix streams and exact source identity
        if: always()
        run: python3 scripts/ci/check_cross_arch_cost.py --artifacts "$RUNNER_TEMP/cost-inputs" --expected-source "$TRNM_EXPECTED_SOURCE_SHA" --output "$RUNNER_TEMP/ci-observations/cross-arch-zero-locality-comparison.json" --suite zero-locality --zero-version 2
      - name: Check one-zero rank-one streams and exact source identity
        if: always()
        run: python3 scripts/ci/check_cross_arch_cost.py --artifacts "$RUNNER_TEMP/cost-inputs" --expected-source "$TRNM_EXPECTED_SOURCE_SHA" --output "$RUNNER_TEMP/ci-observations/cross-arch-one-zero-locality-comparison.json" --suite one-zero-locality
      - name: Check fixed maintenance streams and exact source identity
        if: always()
        run: python3 scripts/ci/check_cross_arch_cost.py --artifacts "$RUNNER_TEMP/cost-inputs" --expected-source "$TRNM_EXPECTED_SOURCE_SHA" --output "$RUNNER_TEMP/ci-observations/cross-arch-maintenance-comparison.json" --suite maintenance-paired
      - name: Check actual rejection stages and paired native architectures
        if: always()
        run: python3 scripts/pon_work_rejection_report.py --compare "$RUNNER_TEMP/cost-inputs/cost-x64-$TRNM_EXPECTED_SOURCE_SHA-$GITHUB_RUN_ATTEMPT/work-rejection" "$RUNNER_TEMP/cost-inputs/cost-arm64-$TRNM_EXPECTED_SOURCE_SHA-$GITHUB_RUN_ATTEMPT/work-rejection" --expected-source "$TRNM_EXPECTED_SOURCE_SHA" --expected-run "$GITHUB_RUN_ID" --expected-attempt "$GITHUB_RUN_ATTEMPT" --out "$RUNNER_TEMP/ci-observations/work-rejection-comparison"
      - name: Verify source remained unchanged
        if: always()
        run: python3 scripts/ci/verify_ci_source.py --kind head --expected-head "$TRNM_EXPECTED_SOURCE_SHA"
      - name: Retain comparison result including missing or failed architectures
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: cost-consistency-${{ env.TRNM_EXPECTED_SOURCE_SHA }}-${{ github.run_attempt }}
          path: ${{ runner.temp }}/ci-observations/
          if-no-files-found: error
          retention-days: 30
  protocol-contract:
    name: protocol-contract
    runs-on: ubuntu-24.04
    # Hosted orchestration only; native command and business budgets are unchanged.
    timeout-minutes: 240
    steps:
      - name: Checkout exact candidate
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ env.TRNM_EXPECTED_SOURCE_SHA }}
          fetch-depth: 0
          persist-credentials: false
      - name: Verify immutable source identity
        run: python3 scripts/ci/verify_ci_source.py --kind head --expected-head "$TRNM_EXPECTED_SOURCE_SHA" --output "$RUNNER_TEMP/ci-observations/source.json"
      - name: Set isolated Cargo paths after runner allocation
        shell: bash
        run: |
          set -euo pipefail
          printf 'CARGO_HOME=%s/cargo-%s\n' "$RUNNER_TEMP" "$GITHUB_JOB" >> "$GITHUB_ENV"
          printf 'CARGO_TARGET_DIR=%s/target-%s\n' "$RUNNER_TEMP" "$GITHUB_JOB" >> "$GITHUB_ENV"
          printf 'TRNM_CI_RECEIPT_DIR=%s/ci-observations\n' "$RUNNER_TEMP" >> "$GITHUB_ENV"
      - name: Install pinned compiler and tools in isolated hosted runner
        run: |
          rustup toolchain install 1.95.0 --profile minimal --component rustfmt --component clippy
      - name: Install isolated conformance-only Python environment
        run: |
          python3 -m venv "$RUNNER_TEMP/pon-contract-env"
          "$RUNNER_TEMP/pon-contract-env/bin/python" -m pip install --disable-pip-version-check --only-binary=:all: -r formal/pon-nakamoto-v1/requirements.txt
          echo "$RUNNER_TEMP/pon-contract-env/bin" >> "$GITHUB_PATH"
      - name: Prepare pinned OpenSSL 3.5.9 PQ provider
        shell: bash
        run: bash scripts/ci/prepare_pq_provider.sh
      - name: Run actual protocol-contract checks
        run: bash scripts/ci/ci_job.sh protocol-contract
      - name: Verify source remained unchanged
        if: always()
        run: python3 scripts/ci/verify_ci_source.py --kind head --expected-head "$TRNM_EXPECTED_SOURCE_SHA"
      - name: Retain source and execution observations
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: head-${{ github.job }}-${{ env.TRNM_EXPECTED_SOURCE_SHA }}-${{ github.run_attempt }}
          path: ${{ runner.temp }}/ci-observations/
          if-no-files-found: error
          retention-days: 30
  fuzz-smoke:
    name: fuzz-smoke
    runs-on: ubuntu-24.04
    timeout-minutes: 45
    steps:
      - name: Checkout exact candidate
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ env.TRNM_EXPECTED_SOURCE_SHA }}
          fetch-depth: 0
          persist-credentials: false
      - name: Verify immutable source identity
        run: python3 scripts/ci/verify_ci_source.py --kind head --expected-head "$TRNM_EXPECTED_SOURCE_SHA" --output "$RUNNER_TEMP/ci-observations/source.json"
      - name: Set isolated Cargo paths after runner allocation
        shell: bash
        run: |
          set -euo pipefail
          printf 'CARGO_HOME=%s/cargo-%s\n' "$RUNNER_TEMP" "$GITHUB_JOB" >> "$GITHUB_ENV"
          printf 'CARGO_TARGET_DIR=%s/target-%s\n' "$RUNNER_TEMP" "$GITHUB_JOB" >> "$GITHUB_ENV"
          printf 'TRNM_CI_RECEIPT_DIR=%s/ci-observations\n' "$RUNNER_TEMP" >> "$GITHUB_ENV"
      - name: Install pinned compiler and tools in isolated hosted runner
        run: |
          rustup toolchain install 1.95.0 --profile minimal --component rustfmt --component clippy
      - name: Install pinned coverage-guided fuzz tools
        run: bash scripts/ci/install_ci_tools.sh fuzz
      - name: Run actual fuzz-smoke checks
        run: bash scripts/ci/ci_job.sh fuzz-smoke
      - name: Verify source remained unchanged
        if: always()
        run: python3 scripts/ci/verify_ci_source.py --kind head --expected-head "$TRNM_EXPECTED_SOURCE_SHA"
      - name: Retain source and execution observations
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: head-${{ github.job }}-${{ env.TRNM_EXPECTED_SOURCE_SHA }}-${{ github.run_attempt }}
          path: ${{ runner.temp }}/ci-observations/
          if-no-files-found: error
          retention-days: 30
  rust-baseline-shards:
    name: rust-baseline shard (${{ matrix.shard }})
    runs-on: ubuntu-24.04
    timeout-minutes: 180
    strategy:
      fail-fast: false
      matrix:
        shard: [runtime, quality]
    steps:
      - name: Checkout exact candidate
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ env.TRNM_EXPECTED_SOURCE_SHA }}
          fetch-depth: 0
          persist-credentials: false
      - name: Verify immutable source identity
        run: python3 scripts/ci/verify_ci_source.py --kind head --expected-head "$TRNM_EXPECTED_SOURCE_SHA" --output "$RUNNER_TEMP/ci-observations/source.json"
      - name: Set isolated Cargo paths after runner allocation
        shell: bash
        run: |
          set -euo pipefail
          printf 'CARGO_HOME=%s/cargo-%s\n' "$RUNNER_TEMP" "$GITHUB_JOB" >> "$GITHUB_ENV"
          printf 'CARGO_TARGET_DIR=%s/target-%s\n' "$RUNNER_TEMP" "$GITHUB_JOB" >> "$GITHUB_ENV"
          printf 'TRNM_CI_RECEIPT_DIR=%s/ci-observations\n' "$RUNNER_TEMP" >> "$GITHUB_ENV"
      - name: Install pinned compiler and tools in isolated hosted runner
        run: |
          rustup toolchain install 1.95.0 --profile minimal --component rustfmt --component clippy
      - name: Install pinned dependency auditor
        run: bash scripts/ci/install_ci_tools.sh supply-chain
      - name: Install isolated signed-state oracle Python environment
        run: |
          python3 -m venv "$RUNNER_TEMP/pon-state-env"
          "$RUNNER_TEMP/pon-state-env/bin/python" -m pip install --disable-pip-version-check --only-binary=:all: -r formal/pon-nakamoto-v1/requirements.txt
          echo "$RUNNER_TEMP/pon-state-env/bin" >> "$GITHUB_PATH"
      - name: Prepare pinned OpenSSL 3.5.9 PQ provider
        shell: bash
        run: bash scripts/ci/prepare_pq_provider.sh
      - name: Run retained Rust shard
        run: python3 scripts/ci/rust_baseline_shards.py run --kind head --candidate "$TRNM_EXPECTED_SOURCE_SHA" --tested "$TRNM_EXPECTED_SOURCE_SHA" --shard "${{ matrix.shard }}" --output "$RUNNER_TEMP/ci-observations/rust-shard.json"
      - name: Verify source remained unchanged
        if: always()
        run: python3 scripts/ci/verify_ci_source.py --kind head --expected-head "$TRNM_EXPECTED_SOURCE_SHA"
      - name: Retain source and execution observations
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: rust-observations-head-${{ env.TRNM_EXPECTED_SOURCE_SHA }}-${{ github.run_attempt }}-${{ matrix.shard }}
          path: ${{ runner.temp }}/ci-observations/
          if-no-files-found: error
          retention-days: 30
      - name: Retain lightweight exact Rust shard proof
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: rust-shard-head-${{ env.TRNM_EXPECTED_SOURCE_SHA }}-${{ github.run_attempt }}-${{ matrix.shard }}
          path: |
            ${{ runner.temp }}/ci-observations/rust-shard.json
            ${{ runner.temp }}/ci-observations/rust-shard.sh
          if-no-files-found: error
          retention-days: 30
  rust-baseline:
    name: rust-baseline
    needs: rust-baseline-shards
    if: always()
    runs-on: ubuntu-24.04
    timeout-minutes: 180
    env:
      TRNM_RUST_SHARD_RESULT: ${{ needs.rust-baseline-shards.result }}
    steps:
      - name: Checkout exact tested source
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ env.TRNM_EXPECTED_SOURCE_SHA }}
          fetch-depth: 0
          persist-credentials: false
      - name: Verify immutable source identity
        run: python3 scripts/ci/verify_ci_source.py --kind head --expected-head "$TRNM_EXPECTED_SOURCE_SHA" --output "$RUNNER_TEMP/ci-observations/source.json"
      - name: Retrieve both current-run Rust shard observations
        uses: actions/download-artifact@634f93cb2916e3fdff6788551b99b062d0335ce0
        with:
          pattern: rust-shard-head-${{ env.TRNM_EXPECTED_SOURCE_SHA }}-${{ github.run_attempt }}-*
          path: ${{ runner.temp }}/rust-shards/
          merge-multiple: false
      - name: Require both successful exact-source Rust shards
        if: always()
        run: python3 scripts/ci/rust_baseline_shards.py check --kind head --candidate "$TRNM_EXPECTED_SOURCE_SHA" --tested "$TRNM_EXPECTED_SOURCE_SHA" --inputs "$RUNNER_TEMP/rust-shards" --dependency-result "$TRNM_RUST_SHARD_RESULT" --output "$RUNNER_TEMP/ci-observations/rust-fanin.json"
      - name: Verify source remained unchanged
        if: always()
        run: python3 scripts/ci/verify_ci_source.py --kind head --expected-head "$TRNM_EXPECTED_SOURCE_SHA"
      - name: Retain failed and successful Rust fan-in observations
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: rust-fanin-head-${{ env.TRNM_EXPECTED_SOURCE_SHA }}-${{ github.run_attempt }}
          path: ${{ runner.temp }}/ci-observations/
          if-no-files-found: error
          retention-days: 30
  prospective-rust-shards:
    name: prospective Rust shard (${{ matrix.shard }})
    if: github.event_name == 'pull_request'
    runs-on: ubuntu-24.04
    timeout-minutes: 180
    strategy:
      fail-fast: false
      matrix:
        shard: [runtime, quality]
    env:
      TRNM_EXPECTED_SOURCE_SHA: ${{ github.sha }}
      TRNM_EXPECTED_CANDIDATE_SHA: ${{ github.event.pull_request.head.sha }}
      TRNM_EXPECTED_BASE_SHA: ${{ github.event.pull_request.base.sha }}
    steps:
      - name: Checkout exact candidate
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ env.TRNM_EXPECTED_SOURCE_SHA }}
          fetch-depth: 0
          persist-credentials: false
      - name: Verify immutable source identity
        run: python3 scripts/ci/verify_ci_source.py --kind prospective-merge --expected-head "$TRNM_EXPECTED_CANDIDATE_SHA" --expected-base "$TRNM_EXPECTED_BASE_SHA" --expected-merge "$TRNM_EXPECTED_SOURCE_SHA" --output "$RUNNER_TEMP/ci-observations/source.json"
      - name: Set isolated Cargo paths after runner allocation
        shell: bash
        run: |
          set -euo pipefail
          printf 'CARGO_HOME=%s/cargo-%s\n' "$RUNNER_TEMP" "$GITHUB_JOB" >> "$GITHUB_ENV"
          printf 'CARGO_TARGET_DIR=%s/target-%s\n' "$RUNNER_TEMP" "$GITHUB_JOB" >> "$GITHUB_ENV"
          printf 'TRNM_CI_RECEIPT_DIR=%s/ci-observations\n' "$RUNNER_TEMP" >> "$GITHUB_ENV"
      - name: Install pinned compiler and tools in isolated hosted runner
        run: |
          rustup toolchain install 1.95.0 --profile minimal --component rustfmt --component clippy
      - name: Install pinned dependency auditor
        run: bash scripts/ci/install_ci_tools.sh supply-chain
      - name: Install isolated signed-state oracle Python environment
        run: |
          python3 -m venv "$RUNNER_TEMP/pon-state-env"
          "$RUNNER_TEMP/pon-state-env/bin/python" -m pip install --disable-pip-version-check --only-binary=:all: -r formal/pon-nakamoto-v1/requirements.txt
          echo "$RUNNER_TEMP/pon-state-env/bin" >> "$GITHUB_PATH"
      - name: Prepare pinned OpenSSL 3.5.9 PQ provider
        shell: bash
        run: bash scripts/ci/prepare_pq_provider.sh
      - name: Run retained Rust shard
        run: python3 scripts/ci/rust_baseline_shards.py run --kind prospective-merge --candidate "$TRNM_EXPECTED_CANDIDATE_SHA" --base "$TRNM_EXPECTED_BASE_SHA" --tested "$TRNM_EXPECTED_SOURCE_SHA" --shard "${{ matrix.shard }}" --output "$RUNNER_TEMP/ci-observations/rust-shard.json"
      - name: Verify source remained unchanged
        if: always()
        run: python3 scripts/ci/verify_ci_source.py --kind prospective-merge --expected-head "$TRNM_EXPECTED_CANDIDATE_SHA" --expected-base "$TRNM_EXPECTED_BASE_SHA" --expected-merge "$TRNM_EXPECTED_SOURCE_SHA"
      - name: Retain source and execution observations
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: rust-observations-prospective-merge-${{ env.TRNM_EXPECTED_SOURCE_SHA }}-${{ github.run_attempt }}-${{ matrix.shard }}
          path: ${{ runner.temp }}/ci-observations/
          if-no-files-found: error
          retention-days: 30
      - name: Retain lightweight exact Rust shard proof
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: rust-shard-prospective-merge-${{ env.TRNM_EXPECTED_SOURCE_SHA }}-${{ github.run_attempt }}-${{ matrix.shard }}
          path: |
            ${{ runner.temp }}/ci-observations/rust-shard.json
            ${{ runner.temp }}/ci-observations/rust-shard.sh
          if-no-files-found: error
          retention-days: 30
  prospective-rust-baseline:
    name: prospective-merge (rust-baseline)
    needs: prospective-rust-shards
    if: ${{ always() && github.event_name == 'pull_request' }}
    runs-on: ubuntu-24.04
    timeout-minutes: 180
    env:
      TRNM_EXPECTED_SOURCE_SHA: ${{ github.sha }}
      TRNM_EXPECTED_CANDIDATE_SHA: ${{ github.event.pull_request.head.sha }}
      TRNM_EXPECTED_BASE_SHA: ${{ github.event.pull_request.base.sha }}
      TRNM_RUST_SHARD_RESULT: ${{ needs.prospective-rust-shards.result }}
    steps:
      - name: Checkout exact tested source
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ env.TRNM_EXPECTED_SOURCE_SHA }}
          fetch-depth: 0
          persist-credentials: false
      - name: Verify immutable source identity
        run: python3 scripts/ci/verify_ci_source.py --kind prospective-merge --expected-head "$TRNM_EXPECTED_CANDIDATE_SHA" --expected-base "$TRNM_EXPECTED_BASE_SHA" --expected-merge "$TRNM_EXPECTED_SOURCE_SHA" --output "$RUNNER_TEMP/ci-observations/source.json"
      - name: Retrieve both current-run Rust shard observations
        uses: actions/download-artifact@634f93cb2916e3fdff6788551b99b062d0335ce0
        with:
          pattern: rust-shard-prospective-merge-${{ env.TRNM_EXPECTED_SOURCE_SHA }}-${{ github.run_attempt }}-*
          path: ${{ runner.temp }}/rust-shards/
          merge-multiple: false
      - name: Require both successful exact-source Rust shards
        if: always()
        run: python3 scripts/ci/rust_baseline_shards.py check --kind prospective-merge --candidate "$TRNM_EXPECTED_CANDIDATE_SHA" --base "$TRNM_EXPECTED_BASE_SHA" --tested "$TRNM_EXPECTED_SOURCE_SHA" --inputs "$RUNNER_TEMP/rust-shards" --dependency-result "$TRNM_RUST_SHARD_RESULT" --output "$RUNNER_TEMP/ci-observations/rust-fanin.json"
      - name: Verify source remained unchanged
        if: always()
        run: python3 scripts/ci/verify_ci_source.py --kind prospective-merge --expected-head "$TRNM_EXPECTED_CANDIDATE_SHA" --expected-base "$TRNM_EXPECTED_BASE_SHA" --expected-merge "$TRNM_EXPECTED_SOURCE_SHA"
      - name: Retain failed and successful Rust fan-in observations
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: rust-fanin-prospective-merge-${{ env.TRNM_EXPECTED_SOURCE_SHA }}-${{ github.run_attempt }}
          path: ${{ runner.temp }}/ci-observations/
          if-no-files-found: error
          retention-days: 30
  external-evidence-contract:
    name: external-evidence-contract
    runs-on: ubuntu-24.04
    timeout-minutes: 45
    steps:
      - name: Checkout exact candidate
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ env.TRNM_EXPECTED_SOURCE_SHA }}
          fetch-depth: 0
          persist-credentials: false
      - name: Verify immutable source identity
        run: python3 scripts/ci/verify_ci_source.py --kind head --expected-head "$TRNM_EXPECTED_SOURCE_SHA" --output "$RUNNER_TEMP/ci-observations/source.json"
      - name: Set isolated Cargo paths after runner allocation
        shell: bash
        run: |
          set -euo pipefail
          printf 'CARGO_HOME=%s/cargo-%s\n' "$RUNNER_TEMP" "$GITHUB_JOB" >> "$GITHUB_ENV"
          printf 'CARGO_TARGET_DIR=%s/target-%s\n' "$RUNNER_TEMP" "$GITHUB_JOB" >> "$GITHUB_ENV"
          printf 'TRNM_CI_RECEIPT_DIR=%s/ci-observations\n' "$RUNNER_TEMP" >> "$GITHUB_ENV"
      - name: Install isolated evidence-replay Python environment
        run: |
          python3 -m venv "$RUNNER_TEMP/pon-evidence-env"
          "$RUNNER_TEMP/pon-evidence-env/bin/python" -m pip install --disable-pip-version-check --only-binary=:all: -r formal/pon-nakamoto-v1/requirements.txt
          echo "$RUNNER_TEMP/pon-evidence-env/bin" >> "$GITHUB_PATH"
      - name: Run actual external-evidence-contract checks
        run: bash scripts/ci/ci_job.sh external-evidence-contract
      - name: Verify source remained unchanged
        if: always()
        run: python3 scripts/ci/verify_ci_source.py --kind head --expected-head "$TRNM_EXPECTED_SOURCE_SHA"
      - name: Retain source and execution observations
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: head-${{ github.job }}-${{ env.TRNM_EXPECTED_SOURCE_SHA }}-${{ github.run_attempt }}
          path: ${{ runner.temp }}/ci-observations/
          if-no-files-found: error
          retention-days: 30
  prospective-merge:
    name: prospective-merge (${{ matrix.lane }})
    if: github.event_name == 'pull_request'
    runs-on: ubuntu-24.04
    timeout-minutes: ${{ matrix.lane == 'protocol-contract' && 240 || matrix.lane == 'rust-baseline' && 180 || 45 }}
    strategy:
      fail-fast: false
      matrix:
        lane: [repository-truth, protocol-contract, fuzz-smoke, external-evidence-contract]
    env:
      TRNM_EXPECTED_SOURCE_SHA: ${{ github.sha }}
      TRNM_EXPECTED_CANDIDATE_SHA: ${{ github.event.pull_request.head.sha }}
      TRNM_EXPECTED_BASE_SHA: ${{ github.event.pull_request.base.sha }}
    steps:
      - name: Checkout exact prospective merge
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ env.TRNM_EXPECTED_SOURCE_SHA }}
          fetch-depth: 0
          persist-credentials: false
      - name: Verify merge identity and exact ordered parents
        run: python3 scripts/ci/verify_ci_source.py --kind prospective-merge --expected-head "$TRNM_EXPECTED_CANDIDATE_SHA" --expected-base "$TRNM_EXPECTED_BASE_SHA" --expected-merge "$TRNM_EXPECTED_SOURCE_SHA" --output "$RUNNER_TEMP/ci-observations/source.json"
      - name: Set isolated Cargo paths after runner allocation
        shell: bash
        run: |
          set -euo pipefail
          printf 'CARGO_HOME=%s/cargo-%s\n' "$RUNNER_TEMP" "$GITHUB_JOB" >> "$GITHUB_ENV"
          printf 'CARGO_TARGET_DIR=%s/target-%s\n' "$RUNNER_TEMP" "$GITHUB_JOB" >> "$GITHUB_ENV"
          printf 'TRNM_CI_RECEIPT_DIR=%s/ci-observations\n' "$RUNNER_TEMP" >> "$GITHUB_ENV"
      - name: Install pinned compiler and tools in isolated hosted runner
        if: matrix.lane == 'protocol-contract' || matrix.lane == 'fuzz-smoke' || matrix.lane == 'rust-baseline'
        run: rustup toolchain install 1.95.0 --profile minimal --component rustfmt --component clippy
      - name: Install isolated conformance and evidence Python environment
        if: matrix.lane == 'protocol-contract' || matrix.lane == 'external-evidence-contract' || matrix.lane == 'rust-baseline'
        run: |
          python3 -m venv "$RUNNER_TEMP/pon-merge-env"
          "$RUNNER_TEMP/pon-merge-env/bin/python" -m pip install --disable-pip-version-check --only-binary=:all: -r formal/pon-nakamoto-v1/requirements.txt
          echo "$RUNNER_TEMP/pon-merge-env/bin" >> "$GITHUB_PATH"
      - name: Install pinned coverage-guided fuzz tools
        if: matrix.lane == 'fuzz-smoke'
        run: bash scripts/ci/install_ci_tools.sh fuzz
      - name: Install pinned dependency auditor
        if: matrix.lane == 'rust-baseline'
        run: bash scripts/ci/install_ci_tools.sh supply-chain
      - name: Check PQ provider CI wiring and failure controls
        if: matrix.lane == 'repository-truth'
        run: python3 scripts/ci/test_pq_provider_ci.py
      - name: Prepare pinned OpenSSL 3.5.9 PQ provider
        if: matrix.lane == 'protocol-contract'
        shell: bash
        run: bash scripts/ci/prepare_pq_provider.sh
      - name: Install isolated runtime material verifier dependency
        if: matrix.lane == 'repository-truth'
        shell: bash
        run: |
          set -euo pipefail
          python3 -m venv "$RUNNER_TEMP/runtime-release-env"
          "$RUNNER_TEMP/runtime-release-env/bin/python" -m pip --isolated install --disable-pip-version-check --only-binary=:all: --require-hashes --report "$RUNNER_TEMP/ci-observations/runtime-release-dependencies.json" -r scripts/ci/runtime-release-requirements.txt
          printf 'TRNM_RUNTIME_RELEASE_PYTHON=%s/runtime-release-env/bin/python\n' "$RUNNER_TEMP" >> "$GITHUB_ENV"
      - name: Execute the same lane on the prospective merge
        run: bash scripts/ci/ci_job.sh "${{ matrix.lane }}"
      - name: Verify merge source remained unchanged
        if: always()
        run: python3 scripts/ci/verify_ci_source.py --kind prospective-merge --expected-head "$TRNM_EXPECTED_CANDIDATE_SHA" --expected-base "$TRNM_EXPECTED_BASE_SHA" --expected-merge "$TRNM_EXPECTED_SOURCE_SHA"
      - name: Retain source and execution observations
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: merge-${{ matrix.lane }}-${{ env.TRNM_EXPECTED_SOURCE_SHA }}-${{ github.run_attempt }}
          path: ${{ runner.temp }}/ci-observations/
          if-no-files-found: error
          retention-days: 30

