# Real CLI gate environment template
# Usage:
#   cp scripts/v2/worker_real_cli.env.example /tmp/worker_real_cli.env
#   # edit values
#   source /tmp/worker_real_cli.env
#   TRNM_TX_CLI=./scripts/v2/trnm_tx_cli_real_adapter.sh ./scripts/v2/run_worker_receipt_gates_real_cli.sh

# --- Chain/CLI basics ---
export TRNM_TX_BIN="chaind"
export TRNM_CHAIN_ID="trnm-localnet"
export TRNM_RPC="http://127.0.0.1:26657"
export TRNM_KEY_NAME="worker1"
export TRNM_KEYRING_BACKEND="test"
export TRNM_GAS="auto"
export TRNM_GAS_ADJUSTMENT="1.5"
export TRNM_FEES="1000utrnm"
export TRNM_BROADCAST_MODE="sync"

# --- Real tx command mapping (REQUIRED for your chain) ---
# Placeholders supported by adapter:
#   {task_id} {worker} {commit_hash} {nonce} {result_hash} {salt_hex}

# Example (replace module path/flags with your real chain command):
export TRNM_TX_COMMIT_CMD='chaind tx pouw commit-result {task_id} {worker} {commit_hash} {nonce} --from worker1 --keyring-backend test --chain-id trnm-localnet --node http://127.0.0.1:26657 --gas auto --gas-adjustment 1.5 --fees 1000utrnm --broadcast-mode sync -y'
export TRNM_TX_REVEAL_CMD='chaind tx pouw reveal-result {task_id} {result_hash} {salt_hex} --from worker1 --keyring-backend test --chain-id trnm-localnet --node http://127.0.0.1:26657 --gas auto --gas-adjustment 1.5 --fees 1000utrnm --broadcast-mode sync -y'
