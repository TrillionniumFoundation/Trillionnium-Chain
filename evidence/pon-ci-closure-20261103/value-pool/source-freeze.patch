+#[test]
+fn shared_values_keep_every_key_and_its_original_hashes_in_the_same_small_pool() {
+    const BUDGET: usize = 64 * 1024;
+    let encoded = format!("\"{}\"", "x".repeat(4080)).into_bytes();
+    let values: BTreeMap<_, _> = (0..128)
