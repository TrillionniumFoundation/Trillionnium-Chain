  nx2:u64 = int.add.wrap(up2,row2)
  end2:bool = compare.eq(nx2,down2)
  branch end2 down_panel(r2,down2,width2) up_row(r2,nx2,down2,width2)
block down_panel(r3:readbuf,down3:u64,width3:u64)
