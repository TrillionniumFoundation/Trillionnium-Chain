fn sp_excluded(w:mutbuf,n:u64) -> (bool) effects(read,write,trap) entry(entry)
block entry(w:mutbuf,n:u64)
  off:u64 = const() {"value":9400}
  word:u64 = call(w,off) {"function":"tr_get"}
  four:u64 = const() {"value":4}
  three:u64 = const() {"value":3}
  has4:bool = compare.ge(n,four)
  has3:bool = compare.eq(n,three)
  mask4:u64 = const() {"value":4294967295}
  mask3:u64 = const() {"value":16777215}
  low4:u64 = bit.and(word,mask4)
  low3:u64 = bit.and(word,mask3)
  trnm:u64 = const() {"value":1835954804}
  m00:u64 = const() {"value":3158125}
  m04:u64 = const() {"value":3420269}
  m10:u64 = const() {"value":3158381}
  pref:bool = compare.eq(low4,trnm)
  a:bool = compare.eq(low3,m00)
  b:bool = compare.eq(low3,m04)
  c:bool = compare.eq(low3,m10)
  ab:bool = bool.or(a,b)
  abc:bool = bool.or(ab,c)
  no4:bool = bool.and(has4,pref)
  no3:bool = bool.and(has3,abc)
  exclude:bool = bool.or(no4,no3)
  ret(exclude)
end

fn sp_publish(i:readbuf,o:mutbuf,w:mutbuf,n:u64,total:u64,used:u64) -> (u64) effects(read,write,trap) entry(entry)
block entry(i:readbuf,o:mutbuf,w:mutbuf,n:u64,total:u64,used:u64)
  p0:u64 = const() {"value":15552}
  p1:u64 = const() {"value":15560}
  _n:u64 = call(w,p0,n) {"function":"tr_put"}
  _u:u64 = call(w,p1,used) {"function":"tr_put"}
  z:u64 = const() {"value":0}
  jump lanes(i,o,w,total,z)
block lanes(li:readbuf,lo:mutbuf,lw:mutbuf,lt:u64,lx:u64)
  width:u64 = const() {"value":8}
  lane:u64 = int.mul.wrap(lx,width)
  cb:u64 = const() {"value":13496}
  cp:u64 = int.add.wrap(cb,lane)
  raw:u64 = call(lw,cp) {"function":"tr_get"}
  low:u64 = const() {"value":1016}
  high:u64 = const() {"value":1032}
  below:bool = compare.lt(raw,low)
  above:bool = compare.gt(raw,high)
  lo_clip:u64 = select(below,low,raw)
  clip:u64 = select(above,high,lo_clip)
  bias:u64 = const() {"value":1024}
  v:u64 = int.sub.wrap(clip,bias)
  last:u64 = const() {"value":256}
  end:bool = compare.eq(lx,last)
  data_bias:u64 = const() {"value":8}
  final_word:u64 = select(end,data_bias,v)
  ix:u64 = int.add.wrap(lx,width)
  at:usize = int.cast(ix) {"mode":"wrap"}
  mask:u8 = buffer.load(li,at)
  one8:u8 = const() {"value":1}
  enabled:bool = compare.eq(mask,one8)
  zero:u64 = const() {"value":0}
  filtered:u64 = select(enabled,final_word,zero)
  as_is:u64 = const() {"value":15600}
  masked:u64 = const() {"value":17656}
  us:u64 = int.add.wrap(as_is,lane)
  ms:u64 = int.add.wrap(masked,lane)
  _raw:u64 = call(lw,us,final_word) {"function":"tr_put"}
  _mask:u64 = call(lw,ms,filtered) {"function":"tr_put"}
  one:u64 = const() {"value":1}
  next_lane:u64 = int.add.wrap(lx,one)
  branch end copy(lo,lw,lt,zero) lanes(li,lo,lw,lt,next_lane)
block copy(co:mutbuf,cw:mutbuf,ct:u64,cur:u64)
  fixed:u64 = const() {"value":4160}
  is_header:bool = compare.lt(cur,fixed)
  header:u64 = const() {"value":15552}
  norm_select:u64 = const() {"value":1144}
  which:u64 = select(is_header,header,norm_select)
  shifted:u64 = int.add.wrap(which,cur)
  src_index:usize = int.cast(shifted) {"mode":"wrap"}
  dest:usize = int.cast(cur) {"mode":"wrap"}
  b:u8 = buffer.load(cw,src_index)
  _ = buffer.store(co,dest,b)
  one_next:u64 = const() {"value":1}
  next_byte:u64 = int.add.wrap(cur,one_next)
  done:bool = compare.eq(next_byte,ct)
  branch done finish() copy(co,cw,ct,next_byte)
block finish()
  ok:u64 = const() {"value":0}
  ret(ok)
end
