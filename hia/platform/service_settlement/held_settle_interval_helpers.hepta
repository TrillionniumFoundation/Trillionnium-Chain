  branch first initial(r,m,main_end,old_abs,seq) check(r,m,main_end,old_abs,seq)
block initial(ir:readbuf,im:mutbuf,ie:usize,io:u64,is:u64)
  where:u64 = int.cast(ie) {"mode":"wrap"}
  w0:u64 = const() {"value":32}
