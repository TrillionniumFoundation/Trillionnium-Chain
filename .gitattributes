# Observed command logs are byte-exact evidence, not normalized source text.
# Keep trailing bytes and nested test output unchanged; hashes are verified separately.
evidence/pon-v1/native-logs/*.log -text -diff
evidence/pon-v1/campaign-logs/*.log -text -diff
evidence/pon-v1/accepted-block/*.log -text -diff

# Revision3 raw runner logs are immutable bytes, not source formatting input.
evidence/pon-v3/**/*.log -text -whitespace

# Exact raw continuation logs are hash-bound; do not normalize transcript whitespace.
evidence/pon-v4/**/*.log -whitespace

# Preserve exact captured process output, including partial progress lines and trailing blank lines.
evidence/pon-evaluation-bundle-v1/logs/*.log -whitespace

# Byte-exact new contract/cost observations, including the failed fixture preparation.
evidence/pon-contract-authority-v1/**/*.log -text -whitespace

# Client qualification preserves exact successful and failed process output.
evidence/pon-client-confirmation-v1/**/*.log -text -whitespace
