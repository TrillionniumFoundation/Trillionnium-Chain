fn trim_left(start_li:readbuf,start_lp:usize,start_le:usize) -> (usize) effects(read,trap) entry(start)
block start(start_li:readbuf,start_lp:usize,start_le:usize)
  jump loop(start_li,start_lp,start_le)
block loop(li:readbuf,lp:usize,le:usize)
  left_width:usize = call(li,lp,le) {"function":"ws_width"}
  lzero:usize = const() {"value":0}
  advanced:usize = int.add.wrap(lp,left_width)
  can_advance:bool = compare.gt(left_width,lzero)
  branch can_advance loop(li,advanced,le) done(lp)
block done(lret:usize)
  ret(lret)
end
fn trim_right(start_ri:readbuf,start_rs:usize,start_re:usize) -> (usize) effects(read,trap) entry(start)
block start(start_ri:readbuf,start_rs:usize,start_re:usize)
  jump loop(start_ri,start_rs,start_re)
block loop(ri:readbuf,rs:usize,re:usize)
  rone:usize = const() {"value":1}
  jump candidate(ri,rs,re,rone)
block candidate(ci:readbuf,cs:usize,ce:usize,cw:usize)
  remaining:usize = int.sub.wrap(ce,cs)
  fits:bool = compare.ge(remaining,cw)
  branch fits measure(ci,cs,ce,cw) done(ce)
block measure(mi:readbuf,ms:usize,me:usize,mw:usize)
  position:usize = int.sub.wrap(me,mw)
  actual:usize = call(mi,position,me) {"function":"ws_width"}
  match:bool = compare.eq(mw,actual)
  branch match loop(mi,ms,position) wider(mi,ms,me,mw)
block wider(wi:readbuf,ws:usize,we:usize,ww:usize)
  max:usize = const() {"value":3}
  plus_one:usize = const() {"value":1}
  try_more:bool = compare.lt(ww,max)
  new_width:usize = int.add.wrap(ww,plus_one)
  branch try_more candidate(wi,ws,we,new_width) done(we)
block done(rret:usize)
