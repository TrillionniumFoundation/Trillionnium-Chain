hia-asm.v1 hepta.hia.program.v8 trnm_bench_plain_diagnostic_renderer_v2
fn f0(i:readbuf,o:mutbuf,s:mutbuf) -> (u32) effects(read,write,trap) entry(entry)
block entry(i:readbuf,o:mutbuf,s:mutbuf)
  nz:usize = buffer.len(i)
  oz:usize = buffer.len(o)
  at_least:usize = const() {"value":976}
  limit:usize = const() {"value":8192}
  min_ok:bool = compare.ge(nz,at_least)
  max_ok:bool = compare.le(nz,limit)
  valid:bool = bool.and(min_ok,max_ok)
  n:u64 = int.cast(nz) {"mode":"wrap"}
  cap:u64 = int.cast(oz) {"mode":"wrap"}
  branch valid lookup(i,o,n,cap) refuse()
block lookup(r_i:readbuf,r_o:mutbuf,r_n:u64,r_cap:u64)
  z:u64 = const() {"value":0}
  len_off:u64 = const() {"value":8}
  code:u64 = call(r_i,z) {"function":"diag_u16"}
  value_len:u64 = call(r_i,len_off) {"function":"diag_u16"}
  code_limit:u64 = const() {"value":104}
  value_limit:u64 = const() {"value":127}
  code_fit:bool = compare.lt(code,code_limit)
  value_fit:bool = compare.le(value_len,value_limit)
  fit:bool = bool.and(code_fit,value_fit)
  branch fit load_row(r_i,r_o,r_n,r_cap,code,value_len) refuse()
block load_row(l_i:readbuf,l_o:mutbuf,l_n:u64,l_cap:u64,l_code:u64,l_vlen:u64)
  base:u64 = const() {"value":144}
  size:u64 = const() {"value":8}
  index:u64 = int.mul.wrap(l_code,size)
  row:u64 = int.add.wrap(base,index)
  step2:u64 = const() {"value":2}
  step4:u64 = const() {"value":4}
  step6:u64 = const() {"value":6}
  atp:u64 = int.add.wrap(row,step2)
  ats:u64 = int.add.wrap(row,step4)
  atz:u64 = int.add.wrap(row,step6)
  rel:u64 = call(l_i,row) {"function":"diag_u16"}
  a:u64 = call(l_i,atp) {"function":"diag_u16"}
  b:u64 = call(l_i,ats) {"function":"diag_u16"}
  reserved:u64 = call(l_i,atz) {"function":"diag_u16"}
  z_row:u64 = const() {"value":0}
  bare:bool = compare.eq(reserved,z_row)
  nonempty:bool = compare.gt(a,z_row)
  numeric_floor:u64 = const() {"value":64}
  empty_ceiling:u64 = const() {"value":80}
  numeric:bool = compare.ge(l_code,numeric_floor)
  requires_text:bool = compare.ge(l_code,empty_ceiling)
  got_text:bool = compare.gt(l_vlen,z_row)
  token_shape:bool = compare.eq(requires_text,got_text)
  both:bool = bool.and(bare,nonempty)
  shape:bool = bool.and(both,token_shape)
  both_pieces:bool = compare.gt(b,z_row)
  correct_suf:bool = compare.eq(numeric,both_pieces)
  text_valid:bool = bool.and(shape,correct_suf)
  floor_data:u64 = const() {"value":832}
  in_data:bool = compare.ge(rel,floor_data)
  start:u64 = int.add.wrap(base,rel)
  p_end:u64 = int.add.wrap(start,a)
  s_end:u64 = int.add.wrap(p_end,b)
  extent:bool = compare.le(s_end,l_n)
  ab:u64 = int.add.wrap(a,b)
  total:u64 = int.add.wrap(ab,l_vlen)
  fit_out:bool = compare.le(total,l_cap)
  max_output:u64 = const() {"value":2048}
  hard_fit:bool = compare.le(total,max_output)
  data_ok:bool = bool.and(in_data,extent)
  fit_report:bool = bool.and(fit_out,hard_fit)
  fit_both:bool = bool.and(data_ok,fit_report)
  ready:bool = bool.and(text_valid,fit_both)
  branch ready token_check(l_i,l_o,start,p_end,a,b,l_vlen,total,z_row) refuse()
block token_check(t_i:readbuf,t_o:mutbuf,t_start:u64,t_after:u64,t_a:u64,t_b:u64,t_vlen:u64,t_total:u64,t_j:u64)
  arrived:bool = compare.eq(t_j,t_vlen)
  branch arrived render(t_i,t_o,t_start,t_after,t_a,t_b,t_vlen,t_total) token_byte(t_i,t_o,t_start,t_after,t_a,t_b,t_vlen,t_total,t_j)
block token_byte(b_i:readbuf,b_o:mutbuf,b_start:u64,b_after:u64,b_a:u64,b_b:u64,b_vlen:u64,b_total:u64,b_j:u64)
  prefix_byte:u64 = const() {"value":16}
  off_b:u64 = int.add.wrap(prefix_byte,b_j)
  idx_b:usize = int.cast(off_b) {"mode":"wrap"}
  octet_b:u8 = buffer.load(b_i,idx_b)
  min_b:u8 = const() {"value":32}
  max_b:u8 = const() {"value":126}
  min_ok_b:bool = compare.ge(octet_b,min_b)
  max_ok_b:bool = compare.le(octet_b,max_b)
  byte_ok:bool = bool.and(min_ok_b,max_ok_b)
  inc_b:u64 = const() {"value":1}
  next_b:u64 = int.add.wrap(b_j,inc_b)
  branch byte_ok token_check(b_i,b_o,b_start,b_after,b_a,b_b,b_vlen,b_total,next_b) refuse()
block render(e_i:readbuf,e_o:mutbuf,e_start:u64,e_after:u64,e_a:u64,e_b:u64,e_vlen:u64,e_total:u64)
  zero_e:u64 = const() {"value":0}
  token_e:u64 = const() {"value":16}
  _pre:u64 = call(e_i,e_o,e_start,zero_e,e_a) {"function":"diag_copy"}
  suf_at:u64 = call(e_i,e_o,token_e,e_a,e_vlen) {"function":"diag_copy"}
  _suf:u64 = call(e_i,e_o,e_after,suf_at,e_b) {"function":"diag_copy"}
  n_out:u32 = int.cast(e_total) {"mode":"wrap"}
  ret(n_out)
block refuse()
  invalid:u32 = const() {"value":4294967294}
  ret(invalid)
end

fn diag_copy(i:readbuf,o:mutbuf,from:u64,to:u64,n:u64) -> (u64) effects(read,write,trap) entry(entry)
block entry(i:readbuf,o:mutbuf,from:u64,to:u64,n:u64)
  jump loop(i,o,from,to,n)
block loop(l_i:readbuf,l_o:mutbuf,l_r:u64,l_w:u64,l_n:u64)
  z:u64 = const() {"value":0}
  done:bool = compare.eq(l_n,z)
  branch done exit(l_w) byte(l_i,l_o,l_r,l_w,l_n)
block byte(b_i:readbuf,b_o:mutbuf,b_from:u64,b_to:u64,b_count:u64)
  rd:usize = int.cast(b_from) {"mode":"wrap"}
  wt:usize = int.cast(b_to) {"mode":"wrap"}
  v:u8 = buffer.load(b_i,rd)
  _ = buffer.store(b_o,wt,v)
  one:u64 = const() {"value":1}
  next_r:u64 = int.add.wrap(b_from,one)
  next_w:u64 = int.add.wrap(b_to,one)
  remaining:u64 = int.sub.wrap(b_count,one)
  jump loop(b_i,b_o,next_r,next_w,remaining)
block exit(out_end:u64)
  ret(out_end)
end

fn diag_u16(i:readbuf,p:u64) -> (u64) effects(read,trap) entry(entry)
block entry(i:readbuf,p:u64)
  at:usize = int.cast(p) {"mode":"wrap"}
  one:usize = const() {"value":1}
  plus:usize = int.add.wrap(at,one)
  a:u8 = buffer.load(i,at)
  b:u8 = buffer.load(i,plus)
  aa:u64 = int.cast(a) {"mode":"wrap"}
  bb:u64 = int.cast(b) {"mode":"wrap"}
  eight:u64 = const() {"value":8}
  high:u64 = int.shl.checked(bb,eight)
  v:u64 = bit.or(high,aa)
  ret(v)
end
