  ok1:bool = call(mem1,memlim) {"function":"cr_between"}
  ok2:bool = call(mem2,memlim) {"function":"cr_between"}
  ok01:bool = bool.and(ok0,ok1)
  mem_ok:bool = bool.and(ok01,ok2)
  branch mem_ok domain(mi,mo,mn,mf,mc,mem0,mem1,mem2) bad()
block domain(di:readbuf,do_:mutbuf,dn:u64,df:u64,dc:u64,dm0:u64,dm1:u64,dm2:u64)
  rows:bool = call(di,df,dn) {"function":"cr_validate"}
  branch rows capacity(di,do_,dc,df,dm0,dm1,dm2) bad()
block capacity(ci:readbuf,co:mutbuf,cc:u64,cf:u64,cm0:u64,cm1:u64,cm2:u64)
  rem_at:u64 = const() {"value":16}
  rem0:u64 = call(ci,rem_at) {"function":"cp_read"}
  enough_rows:bool = compare.le(cc,rem0)
  active:u64 = select(enough_rows,cc,rem0)
  rem1:u64 = int.sub.wrap(rem0,active)
  head:u64 = const() {"value":40}
  trw:u64 = const() {"value":2096}
  trmw:u64 = const() {"value":24}
  rowbytes:u64 = int.mul.wrap(active,trw)
  tracebytes:u64 = int.mul.wrap(active,trmw)
  m_at:u64 = int.add.wrap(head,rowbytes)
  full:u64 = int.add.wrap(m_at,tracebytes)
  dst:usize = buffer.len(co)
  dst0:u64 = int.cast(dst) {"mode":"wrap"}
  fit:bool = compare.le(full,dst0)
  branch fit write(ci,co,active,cf,head,m_at,cm0,cm1,cm2,rem1) short()
block write(oi:readbuf,oo:mutbuf,oc:u64,of:u64,oh:u64,ot:u64,om0:u64,om1:u64,om2:u64,or_:u64)
  f0_:u64,f1_:u64,f2_:u64 = call(oi,oo,oc,of,oh,ot,om0,om1,om2) {"function":"cr_records"}
  oc_at:u64 = const() {"value":0}
  or_at:u64 = const() {"value":8}
  om_at:u64 = const() {"value":16}
  _oc:u64 = call(oo,oc_at,oc) {"function":"cp_put"}
  _or:u64 = call(oo,or_at,or_) {"function":"cp_put"}
  _om:u64 = call(oo,om_at,f0_,f1_,f2_) {"function":"cr_store3"}
  good:u32 = const() {"value":0}
