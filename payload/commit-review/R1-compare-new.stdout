\"5d9e036f8d409c7a0fad4099f4afb51ad15e37a9\",\n@@ -1820,7 +1820,7 @@\n     \"scripts/ci/test_pon_w1_zero_paired_lazy_v1.py\": \"ae573ceac867b8d7455dc8b612907086233c6b9a\",\n     \"scripts/ci/test_pon_wan_control_domains.py\": \"d2d82bf3fbae926f4ccf3798be2aa2bf50244aed\",\n     \"scripts/ci/test_pon_wan_evidence.py\": \"136db0e99c1b0a0ef9a91d7f7131fa0590432488\",\n-    \"scripts/ci/test_pq_authority_effect_register.py\": \"d6e3ae6e2fcb16ceec62924c9407307feb8cd75d\",\n+    \"scripts/ci/test_pq_authority_effect_register.py\": \"275538b69aeed4bd00fd8197336b866e4e076f7a\",\n     \"scripts/ci/test_pq_authority_surface_scan.py\": \"f9883291a2a844e7347d9cfd26d7c2f46288851b\",\n     \"scripts/ci/test_pq_chain_claim_guard.py\": \"624c16369129f3b8fbc44d4507fb22bc859bff39\",\n     \"scripts/ci/test_pq_content_chain_review.py\": \"a8b4f397afac8db119207e610fb404ba992cd152\",\n@@ -1985,7 +1985,7 @@\n     \"scripts/test_m15_native_fixture_tools.py\": \"b61c09f7e7f1ff3669fb79d980f39fe0c71d4558\",\n     \"scripts/test_w1_generation_target_v2.py\": \"17db3b13592882edc0df711fc1b58a386e73ff85\",\n     \"scripts/test_w1_owned_generation_runtime_v2.py\": \"ae3ae55f0b51becbc2f866cf016fd15f810d598c\",\n-    \"scripts/test_w1_owned_process_collector_v1.py\": \"0c683b183d64d71e8ae6c6f44dca857b4f6e77b3\",\n+    \"scripts/test_w1_owned_process_collector_v1.py\": \"530169ab9de7079958ada8f2f4d66702ea54cca0\",\n     \"scripts/test_w1_owner_cancellation_v1.py\": \"0425cd56beabdbea452873db6cafadb8658b4282\",\n     \"scripts/w1_current_source_observation.py\": \"bfe98a30155bfeb2e8ad209f8ed6ffcfc71f2a6e\",\n     \"scripts/w1_fri_query_replay.py\": \"1a3eafeb4ffaa23907da5eda0ee4baabe943307d\",\n@@ -2374,7 +2374,7 @@\n     \"trillionnium/crates/trnm-pon-node/src/ingress/pq_network/tls/tests.rs\": \"d10b1fda832333d595539668cbae5a9d46d4ed4f\",\n     \"trillionnium/crates/trnm-pon-node/src/ingress/pq_network/tls_endpoint.rs\": \"91a4cced81579c44769abe9b2b1244546c607250\",\n     \"trillionnium/crates/trnm-pon-node/src/ingress/pq_network/tls_profile.rs\": \"3175a397a00274d15baa1e0a1dc4f01eb320b48a\",\n-    \"trillionnium/crates/trnm-pon-node/src/ingress/public_v2.rs\": \"e359ba90bb714c6e04233f32cdd12e817a09ed8b\",\n+    \"trillionnium/crates/trnm-pon-node/src/ingress/public_v2.rs\": \"3a9fbe26283920a77ae4883a46153440abbe7e12\",\n     \"trillionnium/crates/trnm-pon-node/src/ingress/public_v3.rs\": \"b62de39bdba906c9d989498a6299df9a14d900e8\",\n     \"trillionnium/crates/trnm-pon-node/src/ingress/public_v3/caller_grant_tests.rs\": \"d51558492a278d7ac97932f1c8af60eb34790f77\",\n     \"trillionnium/crates/trnm-pon-node/src/ingress/public_v3/canonical_packet.rs\": \"d4ddbdb52d877f5e629002ef45051711f6fa62c3\","},{"sha":"fe36bbf8f1ba9dfb933f5e93f10685be1f7977c2","filename":"docs/development/BRANCH_CONSOLIDATION_AUDIT_20261114.md","status":"modified","additions":48,"deletions":0,"changes":48,"blob_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/blob/5df7ae6f482157c5f7fdcbcd52222117a965053f/docs%2Fdevelopment%2FBRANCH_CONSOLIDATION_AUDIT_20261114.md","raw_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/raw/5df7ae6f482157c5f7fdcbcd52222117a965053f/docs%2Fdevelopment%2FBRANCH_CONSOLIDATION_AUDIT_20261114.md","contents_url":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/contents/docs%2Fdevelopment%2FBRANCH_CONSOLIDATION_AUDIT_20261114.md?ref=5df7ae6f482157c5f7fdcbcd52222117a965053f","patch":"@@ -859,3 +859,51 @@ failures, without inferring that every failure has the same cause. No test\n or producer is altered to make macOS pass. The normal merge is finalized\n after its repository and inventory checks; the original Linux lane must\n validate this merged source separately before publication.\n+\n+### 2026-11-14 reconcile local ABFC and concurrent 2a source\n+\n+This reconciliation selects the reviewed concurrent candidate\n+`2a86462a1ab20c68151719ba4635e3c294391e64` together with the independent\n+local `abfcff23d4e2aab7dfd92dfb34937ec7d6021ead` corrections. It is an\n+integration candidate; main merge, complete remaining historical review and\n+remote branch cleanup remain pending.\n+\n+The 42 active differences were read and independently rebound to native Git\n+bytes. The 298 retained evidence paths and all 327 ZIP members were checked\n+for custody and complete CRC/hash reads. That check does not confer source\n+semantics or successful execution on historical programs. Four metadata\n+files missing from the original-full-lane index were recovered byte for byte\n+from their declared source copies; the original index is unchanged.\n+\n+Select the immutable PublicPolicy hash-prefix cache without changing any\n+domain, resource bytes, framing or six dynamic fields. All 84 existing test\n+definitions remain intact; the three added definitions and structural hash\n+work reduction alone do not prove the four-second target. Preserve the local\n+public_v2 strict-signature completion deadline fix.\n+\n+Select Node store d596dc6 with epoch capture before readiness and same-row\n+work checks before time deferral. The previous local preference for 3bce39ce\n+is withdrawn: an independent SQLite writer can otherwise be captured after\n+readiness, and simultaneous future time can mask a typed local work-integrity\n+fault. Both counterexamples are static; no new exploit, global transaction\n+snapshot, public-listener shutdown or native performance result is asserted.\n+\n+Select the raw fixed historical collector fixture as read-only evidence.\n+Use the remote closed-gate TERM deferral with the composed 16-control suite;\n+its real post-fork refusal keeps raw same-root wait status and requires a\n+recorded causal KILL event for the signal branch. This does not weaken the\n+ordinary exit-125 check, the original kill/grace boundary or cleanup ownership.\n+\n+Use the concurrent current source maps for their exact selected bodies.\n+Retain the earlier FC39 audit and its original failures/passes as historical\n+records; finite PASS results do not prove the two uncovered store schedules.\n+The current authority44 and lifetime20 maps select 5c04c60e; the current QROM\n+comparison still fixes both provenance lock fields 0 and 2. No frozen\n+mathematical claim, historical failure or qualification flag is upgraded.\n+\n+The original 096 protocol head and prospective-merge archives both retain\n+five exit-zero native children, but their pressure confirmations fail\n+CONFIRMATION_TARGET with PUBLIC_REQUEST_DEADLINE. The original 4,000,000,000 ns\n+window and 16 workers are unchanged. The later 2a ARM and x64 cost jobs also\n+report failure; their original artifacts are under separate inspection.\n+No new committed-source gate or native target PASS is claimed by this entry."},{"sha":"8308164308dbaa7504a167f30e0a2ab0fc553227","filename":"docs/development/TRNM_AI_NATIVE_BLOCKCHAIN_DEVELOPMENT_PLAN.md","status":"modified","additions":145,"deletions":0,"changes":145,"blob_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/blob/5df7ae6f482157c5f7fdcbcd52222117a965053f/docs%2Fdevelopment%2FTRNM_AI_NATIVE_BLOCKCHAIN_DEVELOPMENT_PLAN.md","raw_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/raw/5df7ae6f482157c5f7fdcbcd52222117a965053f/docs%2Fdevelopment%2FTRNM_AI_NATIVE_BLOCKCHAIN_DEVELOPMENT_PLAN.md","contents_url":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/contents/docs%2Fdevelopment%2FTRNM_AI_NATIVE_BLOCKCHAIN_DEVELOPMENT_PLAN.md?ref=5df7ae6f482157c5f7fdcbcd52222117a965053f","patch":"@@ -15401,3 +15401,148 @@ store implementation; current PQ correspondence, frozen records and the B1\n historical fixture remain. Only the three selected W1 corpus pins and this\n plan pin change. The resulting commit requires its own original source,\n repository and external-evidence gates before publication and protected merge.\n+\n+### Retained pre-reconciliation audit text\n+\n+The following exact text from local ABFC is retained as historical context.\n+Its then-current FC39 labels do not describe the selection below. Original\n+execution observations keep their original source identities and limits.\n+\n+```text\n+### 2026-11-14 retain the reviewed hash-purpose proof descriptor binding\n+\n+The existing hash-purpose source guard correctly refused the stale proof\n+descriptor identity after the independently reviewed standalone verifier lock\n+alignment. Rebind only that descriptor within the existing 31-path inventory\n+and retain the exact 19-use semantic identity. The descriptor changes only the\n+byte count and digest of its selected W1 implementation map. That map preserves\n+the 16 selected inputs and 140 local-closure inputs, updating the one verifier\n+lock in both inventories with its explicit review record.\n+\n+The selected RISC Zero package versions, sources, checksums and resolved direct\n+dependency edges, proof parameters, expected image and control identities, historical proof materials and unresolved obligations stay\n+unchanged. The hash-purpose inspector still refuses unreviewed source changes\n+or automatic repinning. Its existing 33 finite controls and positive source\n+inspection are the validation scope for this correction; successful inspection\n+continues to report HOLD_NO_GO, unknown security bits and no production\n+activation. Original failed CI records remain valid observations of their\n+original source. This binding supplies no new native execution, complete\n+callgraph review, authenticated history or cryptographic qualification.\n+```\n+\n+```text\n+### Corrective audit checkpoint and remaining consolidation work — 2026-11-14\n+\n+The active local corrective source is\n+`fc39da5f35298ce8a4c34aa5bdb25849648612f9`, tree\n+`20ef410a1ea847a3585de91d5f0a0380009cf874`. The source identity is an\n+audited local checkpoint, not a claim that the protected main branch or remote\n+candidate has advanced. The earlier branch-disposition record describes its\n+frozen inventory; it does not close later semantic review, native validation\n+or branch cleanup. At this checkpoint 28 of the original 325 maximal historical\n+heads remain outside the H229 integration graph and are under separate review.\n+\n+Retain the reviewed current PQ128 correspondence and composition namespaces.\n+Their explicit 21-input correspondence and 66-path composition union preserve\n+the frozen V1 source lock, original numeric assumptions and every null/false\n+qualification field. The current observation, claim-guard and composition\n+suites ran 25, 57 and 60 methods successfully. The budget suite originally\n+ran 57 passes and one error after its old fixture expected a direct V1 report.\n+The narrow adapter now checks the separate current outer record and retains\n+the original V1 helper; its full 58-method rerun passed. The original error\n+remains evidence and is not replaced by that result.\n+\n+Retain the durable-witness readback validation and explicit SQLite connection\n+closure. The complete 77-method readiness suite passed after the closure fix\n+with zero ResourceWarnings; the earlier passing run's warnings remain recorded.\n+SP27 receiver and strata readers now bind the exact prepared child command,\n+integer-zero exit and false timeout fields after the original readback guard.\n+All 36 original methods remain and four controls are added: the complete\n+40-method finite candidate passed, while the original readers failed all\n+40 added tamper subcases. This does not execute a native SP27 campaign or\n+establish the four-second confirmation target.\n+\n+Cost-source receipt equality now requires identical exact JSON value types\n+as well as equal values and the original closed field set. All 27 existing\n+methods remain unchanged and three controls are added. The actual complete\n+30-method suite passed on `fc39da5f`; its 18 reviewed imported-module/data\n+inputs and the full 41,378-entry / 3,992,046,497-byte checkout matched before\n+and after. Earlier Boolean/integer/float substitution failures remain retained.\n+Known timing scopes, original failure denominators, unknown cost values,\n+resource budgets and qualification flags are unchanged.\n+\n+The authority44 and current-lifetime20 maps now bind `fc39da5f`; only the\n+already reviewed Node store bytes differ within either selected inventory\n+from their preceding `5c04c60e` map. The authority lock is\n+`f90e400347b1a1431b845cc41eb89a904a629f6095ae9f2967d69b35809c5f56` and the lifetime contract digest is\n+`ed9d948a4815aa2fdd858acdcda104341ab96fb504a15e761c86ae04d6547c63`. The six-crate QROM145 mapping retains its\n+`5c04c60e` checkpoint and `77f3901f137119ce245bf361990990b51ecb9affdc87f273404c4330a2870ee5`\n+digest because those selected input bytes are unchanged. The current proof\n+descriptor remains `8e95754db175bf8f2c4b3ffc0afe46f7b1eff476479d15fb2c005bf6d79dd0f1`.\n+Its upstream approval list is still empty. Current corpus pins follow only\n+these reviewed source changes and add the four explicit PQ current reader,\n+test and contract paths; all existing required paths remain.\n+\n+Hosted required checks on the unchanged remote `dc42ce4d` candidate still\n+include original failures. The retained four-second service observations\n+confirm the baseline but do not complete independent pressure replay before\n+the existing deadline. Exit-zero native processes do not override that\n+business rejection. Fresh Host checks, deadlines, CPU quota, caller work,\n+test rosters and protected-main requirements remain unchanged. No speculative\n+optimization, archived workload execution, skipped gate, forced update or\n+protection change is authorized by this record.\n+\n+Complete the remaining historical review and current required checks, retain\n+a newly verified full-history archive, merge through the existing protected\n+main process, then verify reference cleanup. These outcomes remain pending;\n+no one-branch remote result, complete-repository qualification or production\n+activation is claimed. This file remains the sole development plan.\n+```\n+\n+### 2026-11-14 reconcile local ABFC and concurrent 2a source\n+\n+This reconciliation selects the reviewed concurrent candidate\n+`2a86462a1ab20c68151719ba4635e3c294391e64` together with the independent\n+local `abfcff23d4e2aab7dfd92dfb34937ec7d6021ead` corrections. It is an\n+integration candidate; main merge, complete remaining historical review and\n+remote branch cleanup remain pending.\n+\n+The 42 active differences were read and independently rebound to native Git\n+bytes. The 298 retained evidence paths and all 327 ZIP members were checked\n+for custody and complete CRC/hash reads. That check does not confer source\n+semantics or successful execution on historical programs. Four metadata\n+files missing from the original-full-lane index were recovered byte for byte\n+from their declared source copies; the original index is unchanged.\n+\n+Select the immutable PublicPolicy hash-prefix cache without changing any\n+domain, resource bytes, framing or six dynamic fields. All 84 existing test\n+definitions remain intact; the three added definitions and structural hash\n+work reduction alone do not prove the four-second target. Preserve the local\n+public_v2 strict-signature completion deadline fix.\n+\n+Select Node store d596dc6 with epoch capture before readiness and same-row\n+work checks before time deferral. The previous local preference for 3bce39ce\n+is withdrawn: an independent SQLite writer can otherwise be captured after\n+readiness, and simultaneous future time can mask a typed local work-integrity\n+fault. Both counterexamples are static; no new exploit, global transaction\n+snapshot, public-listener shutdown or native performance result is asserted.\n+\n+Select the raw fixed historical collector fixture as read-only evidence.\n+Use the remote closed-gate TERM deferral with the composed 16-control suite;\n+its real post-fork refusal keeps raw same-root wait status and requires a\n+recorded causal KILL event for the signal branch. This does not weaken the\n+ordinary exit-125 check, the original kill/grace boundary or cleanup ownership.\n+\n+Use the concurrent current source maps for their exact selected bodies.\n+Retain the earlier FC39 audit and its original failures/passes as historical\n+records; finite PASS results do not prove the two uncovered store schedules.\n+The current authority44 and lifetime20 maps select 5c04c60e; the current QROM\n+comparison still fixes both provenance lock fields 0 and 2. No frozen\n+mathematical claim, historical failure or qualification flag is upgraded.\n+\n+The original 096 protocol head and prospective-merge archives both retain\n+five exit-zero native children, but their pressure confirmations fail\n+CONFIRMATION_TARGET with PUBLIC_REQUEST_DEADLINE. The original 4,000,000,000 ns\n+window and 16 workers are unchanged. The later 2a ARM and x64 cost jobs also\n+report failure; their original artifacts are under separate inspection.\n+No new committed-source gate or native target PASS is claimed by this entry."},{"sha":"94a921086fd5136ae12e3308b7017d6bfc226a40","filename":"docs/security/PQ_AUTHORITY_EFFECT_REGISTER_V1.md","status":"modified","additions":45,"deletions":4,"changes":49,"blob_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/blob/5df7ae6f482157c5f7fdcbcd52222117a965053f/docs%2Fsecurity%2FPQ_AUTHORITY_EFFECT_REGISTER_V1.md","raw_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/raw/5df7ae6f482157c5f7fdcbcd52222117a965053f/docs%2Fsecurity%2FPQ_AUTHORITY_EFFECT_REGISTER_V1.md","contents_url":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/contents/docs%2Fsecurity%2FPQ_AUTHORITY_EFFECT_REGISTER_V1.md?ref=5df7ae6f482157c5f7fdcbcd52222117a965053f","patch":"@@ -4,7 +4,7 @@\n \n The [register](../../config/pon/pq-authority-effects-v1.json) binds seven reviewed\n routes to the current listed source checkpoint\n-`332d7f723d71707d88a2cffa52b3754579a46926`. The\n+`5c04c60e463462d9df8884786e0d5bb32af08a64`. The\n [checker](../../scripts/ci/pq_authority_effect_register.py) enforces their exact\n effect scopes and source sets, and compares 44 actual regular files with a fixed\n reviewed SHA-256 lock. Successful checking reports `source_consistency: PASS`\n@@ -18,7 +18,48 @@ a signature, context comparison, downloaded artifact or certificate observation\n must not be recorded as a different downstream permission. That original source\n inventory did not itself establish a classical bypass of a PQ owner.\n \n-## Current combined-source binding, 2026-11-13\n+## Selected source correspondence after ordering review, 2026-11-14\n+\n+The active 44-path correspondence selects\n+`5c04c60e463462d9df8884786e0d5bb32af08a64` and lock\n+`3113f8e9cd6f8f72d190f55e84b97ab7b04da38cd3ddf86be9ab871fc4743528`.\n+Its selected Node store is 391,470 bytes, SHA-256\n+`5918270368c61b420d26910dc5934714e1423f71c686b2d01f8d2e3ccceb990c`.\n+The earlier FC39 correspondence below remains a historical observation.\n+\n+Further inspection found a foreign SQLite commit window between readiness\n+and a subsequently captured epoch, and a same-row work-corruption case that\n+the early time refusal could mask. The selected store captures the epoch\n+before readiness and checks the visited row's work before time deferral.\n+The old inverse-ordering recommendation is withdrawn. This is a source\n+selection with explicit static counterexamples, not a new native execution\n+or a statement that every caller stops a public listener. Seven routes,\n+44 paths and all false qualification fields retain their original scope.\n+\n+## Historical corrective source binding, 2026-11-14 (superseded)\n+\n+The superseded checkpoint was `fc39da5f35298ce8a4c34aa5bdb25849648612f9`,\n+tree `20ef410a1ea847a3585de91d5f0a0380009cf874`. All 44 selected\n+regular Git blobs were read independently and matched to the checkout.\n+The canonical revision-plus-file lock is `f90e400347b1a1431b845cc41eb89a904a629f6095ae9f2967d69b35809c5f56`.\n+\n+Only `trillionnium/crates/trnm-pon-node/src/store.rs` differs in this\n+inventory from the preceding `5c04c60e463462d9df8884786e0d5bb32af08a64`\n+map: 391,470 bytes / `5918270368c61b420d26910dc5934714e1423f71c686b2d01f8d2e3ccceb990c`\n+become 391,556 bytes /\n+`ae54afb15c78e20b5fbb80c89d2a7346aafb2c20e6a1bf665663adc422625da5`.\n+The other 43 source digests, seven route definitions, exact effect scopes,\n+limits and false qualification fields are unchanged. The manifest, strict\n+reader and independent positive assertions bind the same new lock. The old\n+`5c04c60e` revision is an additional negative control alongside every\n+earlier refusal.\n+\n+This is a curated source-consistency update. It neither authenticates an\n+executor nor establishes a complete call graph, runtime reachability, native\n+execution, whole-chain PQ qualification or production activation. Earlier\n+review and execution records retain their original source identities.\n+\n+## Retained combined-source binding, 2026-11-13\n \n The reviewed source checkpoint is `332d7f723d71707d88a2cffa52b3754579a46926`, tree\n `c93086b354d75827ca96a42c7eaa3f8be8954311`. All 44 selected regular Git\n@@ -606,9 +647,9 @@ The consolidation preserves commits e35cfb3cd85183a3b5beb47ad1287389cc4d1cd5, 49\n \n The incoming sealed-material fixture contains three corrected fixed expected contract hashes for its exact source pair. The current combination additionally contains the reviewed read-only trial-ledger reconciliation command, changing llm_runtime_pilot.py to SHA-256 13e4c11d51931d902483372a9a05c7180333893202ecb1d663d57a83111eccc7. The first integration attempt refused this real producer difference before changing the repository. The final merge rebinds the neural reader and explicit research preparation entry to that exact current pilot and independently derived complete contract. Both original test suites retain their fixed positive identities and all refusal assertions; the prior pilot is an additional explicit refusal. Historical material plan, target and original runtime identities retain their bytes. Both standalone lock blobs already exactly match the reviewed root. Final combined source mappings remain pending; neither this rebind nor preserved historical executions confer native, model, installation or security qualification.\n \n-## Consolidated current source review, 2026-11-14\n+## Selected consolidated source mapping, 2026-11-14\n \n-Current source checkpoint 5c04c60e463462d9df8884786e0d5bb32af08a64 keeps the same seven curated routes and 44\n+The selected mapped source checkpoint 5c04c60e463462d9df8884786e0d5bb32af08a64 keeps the same seven curated routes and 44\n selected paths. Seven selected files changed from the preceding 332d7f72\n review: Cell fetch ordering and controlled cache restoration, the per-call PQ\n account configuration and its controls, Node advisory/store integration, and"},{"sha":"78c21de7954a9c65a751a61e6531d3f325303add","filename":"docs/security/W1_LIFETIME_CURRENT_SOURCE_OBSERVATION_V2.md","status":"modified","additions":50,"deletions":12,"changes":62,"blob_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/blob/5df7ae6f482157c5f7fdcbcd52222117a965053f/docs%2Fsecurity%2FW1_LIFETIME_CURRENT_SOURCE_OBSERVATION_V2.md","raw_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/raw/5df7ae6f482157c5f7fdcbcd52222117a965053f/docs%2Fsecurity%2FW1_LIFETIME_CURRENT_SOURCE_OBSERVATION_V2.md","contents_url":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/contents/docs%2Fsecurity%2FW1_LIFETIME_CURRENT_SOURCE_OBSERVATION_V2.md?ref=5df7ae6f482157c5f7fdcbcd52222117a965053f","patch":"@@ -3,6 +3,42 @@\n Status: **HOLD / NO-GO**. No lifetime bound or cryptographic qualification is\n created by this source-survey continuation of #850.\n \n+## Selected source correspondence after ordering review, 2026-11-14\n+\n+The active 20-path contract selects\n+`5c04c60e463462d9df8884786e0d5bb32af08a64`; its SHA-256 is\n+`bd22f0db32c479dd7d42ae541eeed0ad0c1115d40b88b01d07acefd25930fbb7`.\n+The selected store is 391,470 bytes with SHA-256\n+`5918270368c61b420d26910dc5934714e1423f71c686b2d01f8d2e3ccceb990c`.\n+The preceding FC39 selection is retained below as historical context and is\n+superseded following the readiness/epoch and same-row work/time review.\n+The ordered roster, frozen historical hashes, eight changed-path comparison\n+and every lifetime/qualification limitation remain unchanged.\n+\n+The current QROM report correspondence still permits exactly provenance\n+lock fields 0 and 2, for the verifier and zkVM locks. Guest lock field 1 and\n+all other values remain identical. The older zkVM-only description and the\n+382,866-byte store describe their historical checkpoints.\n+\n+## Historical corrective source binding, 2026-11-14 (superseded)\n+\n+The superseded contract selected `fc39da5f35298ce8a4c34aa5bdb25849648612f9`,\n+tree `20ef410a1ea847a3585de91d5f0a0380009cf874`, with the same\n+ordered 20-path roster and the same 20 historical SHA-256 values.\n+Its SHA-256 is `ed9d948a4815aa2fdd858acdcda104341ab96fb504a15e761c86ae04d6547c63`.\n+All 20 current inputs were independently read from the immutable Git\n+checkpoint and compared with the checkout.\n+\n+Only Node `store.rs` changes from the preceding `5c04c60e` mapping:\n+391,470 bytes / `5918270368c61b420d26910dc5934714e1423f71c686b2d01f8d2e3ccceb990c`\n+become 391,556 bytes /\n+`ae54afb15c78e20b5fbb80c89d2a7346aafb2c20e6a1bf665663adc422625da5`.\n+The historical-versus-current difference list still contains eight paths.\n+The current reader's fixed contract digest and independent positive assertions\n+move together. The frozen `7150d96a` reader, original pins and source refusal,\n+arithmetic evaluator, bounds and all null/false qualification outputs remain\n+unchanged. No historical execution or lifetime failure bound is inferred.\n+\n ## Original failure and preserved contract\n \n On exact #850 source `3898582a321471fc2a6945b37ff4d0cd58c7a255`, hosted\n@@ -21,9 +57,9 @@ The historical job now checks out the known original positive closure source\n to that source. Current jobs must separately retain the real historical V1\n refusal; raising a byte limit or silently replacing its pin is not a repair.\n \n-## Current combined-source binding, 2026-11-13\n+## Retained combined-source binding, 2026-11-13\n \n-The current contract selects `332d7f723d71707d88a2cffa52b3754579a46926`, tree\n+The contract at that retained checkpoint selected `332d7f723d71707d88a2cffa52b3754579a46926`, tree\n `c93086b354d75827ca96a42c7eaa3f8be8954311`. Its 20 regular-file inputs\n were read from the immutable Git revision and matched to the isolated checkout.\n Compared with the previous current checkpoint `975ab0937243949b73cdbea9f13902802bbd7d00`,\n@@ -56,13 +92,13 @@ the general reader cap or relax source identity checks.\n \n The initial V2 contract retained the same 20 selected paths under a new\n namespace. At that initial checkpoint, comparison with V1 found one changed\n-path; the current six-path comparison is recorded above:\n+path; the later six-path comparison at `332d7f72` is retained above:\n \n | Path | Historical SHA-256 | Current SHA-256 |\n |---|---|---|\n | `trillionnium/crates/trnm-pon-node/src/store.rs` | `b712a86b9997a098df5e8257f309d22445b2c749c9aa474457e958a0f65f5153` | `108621f304255841ea2e1a7353858c3f0f5d8cb70a235f6a4aef6d57ebe0c554` |\n \n-The current file is 382,866 bytes and retains both the native work-verification\n+At that initial checkpoint the file was 382,866 bytes and retained both the native work-verification\n and cumulative-required-work anchors used by the selected survey. These\n anchors are source observations, not proofs of complete entry-point coverage,\n runtime behavior, execution cost or consensus security.\n@@ -78,12 +114,14 @@ independent acceptance lines are unchanged; supplied counts remain premises.\n The new output schema is `TRNM-W1-LIFETIME-CURRENT-OBSERVATION2`. Current jobs\n do not compare it to the historical V1 lifetime report. They compare five\n unaffected reports byte for byte. The semantics report has an independent,\n-explicit current comparison: the only reviewed difference is the SHA-256 of\n-`formal/pon-nakamoto-v1/w1_zkvm/Cargo.lock` in its provenance. The current lock\n-adds the `risc0-binfmt` and `sha2` dependency edges to the local\n-`trnm-w1-zk-methods-v2` package; package entries and other report values remain\n-unchanged. Both lock identities and the original report identity are frozen;\n-arbitrary provenance or mathematical-output changes are refused. This is not\n+explicit current comparison in the\n+[QROM mapping](W1_QROM_CURRENT_SOURCE_MAPPING_V2.md). Its current correspondence\n+permits only provenance lock-check SHA fields 0 and 2, for the V2 verifier\n+and zkVM locks, to differ from the frozen report. Both current lock digests\n+are independently fixed. Guest lock field 1, every other report property\n+and all qualification fields must remain identical. The earlier zkVM-only\n+comparison belongs to its retained source checkpoint; it is not the complete\n+current correspondence. This is not\n dependency-graph execution or compiler refinement evidence.\n \n The jobs check complete source identity before and after, and require every\n@@ -106,9 +144,9 @@ quantum auxiliary-state hypotheses, a complete shared-oracle reduction,\n recursive composition and complete lifetime event coverage still require their\n own mathematical and operational evidence.\n \n-## Consolidated current source review, 2026-11-14\n+## Selected consolidated source mapping, 2026-11-14\n \n-Current checkpoint 5c04c60e463462d9df8884786e0d5bb32af08a64 retains the exact ordered 20-path roster and all\n+The selected mapped checkpoint 5c04c60e463462d9df8884786e0d5bb32af08a64 retains the exact ordered 20-path roster and all\n 20 historical SHA-256 values from 7150d96a. Four current rows changed from\n 332d7f72: the crypto Cargo manifest, pon_work.rs, pq_accounts_v2.rs and Node\n store.rs. The historical-versus-current difference list now has eight paths,"},{"sha":"4fa1470c0b21118c20b3561477f9a48775e6631d","filename":"evidence/hash-use-current-source-review-20261114/original-full-lane/README.md","status":"added","additions":7,"deletions":0,"changes":7,"blob_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/blob/5df7ae6f482157c5f7fdcbcd52222117a965053f/evidence%2Fhash-use-current-source-review-20261114%2Foriginal-full-lane%2FREADME.md","raw_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/raw/5df7ae6f482157c5f7fdcbcd52222117a965053f/evidence%2Fhash-use-current-source-review-20261114%2Foriginal-full-lane%2FREADME.md","contents_url":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/contents/evidence%2Fhash-use-current-source-review-20261114%2Foriginal-full-lane%2FREADME.md?ref=5df7ae6f482157c5f7fdcbcd52222117a965053f","patch":"@@ -0,0 +1,7 @@\n+Original failed Linux lane preservation\n+\n+This directory preserves39 original files (400,321 bytes): one summary,36 streams from18 steps, and two source sidecars. Original source7d8d4c59fcd01480a12e1c64835b202079091800 was acquired from a fixed local bundle with expected startdc42ce4df5cff79cc61c5addbaf01074b56b06ca. The repository-truth step failed with exit1 after30.922 seconds within its unchanged2700-second bound. local_bundle_source=true and remote_publication_verified=false remain unchanged.\n+\n+Every original was copied through version-pinned official binary reads and create-only writes, then rehashed locally. ROG commands, writes, source changes, Git operations, and tests were not performed by this preservation task. No standalone steps.json was produced by this run; its18 records are inside summary.json. The configured ci-observations tree listing returned no matching visible files; this record does not claim a hidden/ignored-file audit.\n+\n+This is historical failure evidence. It cannot satisfy any future successful full-lane or hosted qualification requirement."},{"sha":"f6b4744e3487b35cd496cab3b43ee3440ba5df53","filename":"evidence/hash-use-current-source-review-20261114/original-full-lane/copy-plan.json","status":"added","additions":344,"deletions":0,"changes":344,"blob_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/blob/5df7ae6f482157c5f7fdcbcd52222117a965053f/evidence%2Fhash-use-current-source-review-20261114%2Foriginal-full-lane%2Fcopy-plan.json","raw_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/raw/5df7ae6f482157c5f7fdcbcd52222117a965053f/evidence%2Fhash-use-current-source-review-20261114%2Foriginal-full-lane%2Fcopy-plan.json","contents_url":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/contents/evidence%2Fhash-use-current-source-review-20261114%2Foriginal-full-lane%2Fcopy-plan.json?ref=5df7ae6f482157c5f7fdcbcd52222117a965053f","patch":"@@ -0,0 +1,344 @@\n+{\n+  \"ci_observations_bounded_tree_listing\": {\n+    \"content\": [\n+      {\n+        \"text\": \"No files matched pattern \\\"**/*\\\".\",\n+        \"type\": \"text\"\n+      }\n+    ],\n+    \"isError\": false,\n+    \"structuredContent\": null\n+  },\n+  \"ci_observations_initial\": {\n+    \"status\": \"fulfilled\",\n+    \"value\": {\n+      \"content\": [\n+        {\n+          \"text\": \"\",\n+          \"type\": \"text\"\n+        }\n+      ],\n+      \"isError\": false,\n+      \"structuredContent\": null\n+    }\n+  },\n+  \"expected_bytes\": 400321,\n+  \"expected_count\": 39,\n+  \"files\": [\n+    {\n+      \"bytes\": 41,\n+      \"name\": \"initial-head.stdout\",\n+      \"role\": \"step_stdout\",\n+      \"sha256\": \"f8bdb660a523c7aef3c4b0e70725614ec2a0c95f5b916f07d17b970ea4feb079\",\n+      \"source_path\": \"/home/qian-qi/chain-final-consolidation-20261114-root/final-repository-truth-offline-7d8d4c-v1/init