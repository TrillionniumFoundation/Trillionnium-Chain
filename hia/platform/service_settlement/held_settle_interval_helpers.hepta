  ret(yes)
block bad()
  no:bool = const() {"value":false}
  ret(no)
end

fn hfs_sameblock_receipt(r:readbuf,m:mutbuf,n:u64) -> (bool) effects(read,write,trap) entry(entry)
block entry(r:readbuf,m:mutbuf,n:u64)
