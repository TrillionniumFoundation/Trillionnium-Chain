fn cache_valid(database:u64,logical:u64,chunks:u64,manifests:u64) -> (bool) effects() entry(entry)
block entry(database:u64,logical:u64,chunks:u64,manifests:u64)
  min_database:u64 = const() {"value":262144}
  max_database:u64 = const() {"value":2199023255552}
  mask:u64 = const() {"value":4095}
  zero:u64 = const() {"value":0}
  max_logical:u64 = const() {"value":1099511627776}
  max_rows:u64 = const() {"value":1048576}
  db_lower:bool = compare.ge(database,min_database)
  db_upper:bool = compare.le(database,max_database)
  residual:u64 = bit.and(database,mask)
  db_aligned:bool = compare.eq(residual,zero)
  logical_lower:bool = compare.gt(logical,zero)
  logical_upper:bool = compare.le(logical,max_logical)
  chunk_lower:bool = compare.gt(chunks,zero)
  chunk_upper:bool = compare.le(chunks,max_rows)
  manifest_lower:bool = compare.gt(manifests,zero)
  manifest_upper:bool = compare.le(manifests,max_rows)
  db_range:bool = bool.and(db_lower,db_upper)
  db_ok:bool = bool.and(db_range,db_aligned)
  logical_ok:bool = bool.and(logical_lower,logical_upper)
  chunk_ok:bool = bool.and(chunk_lower,chunk_upper)
  manifest_ok:bool = bool.and(manifest_lower,manifest_upper)
  row_ok:bool = bool.and(chunk_ok,manifest_ok)
  capacity_ok:bool = bool.and(db_ok,logical_ok)
  result:bool = bool.and(capacity_ok,row_ok)
  ret(result)
end
