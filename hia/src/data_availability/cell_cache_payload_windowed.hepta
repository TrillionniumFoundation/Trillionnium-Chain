  old_ok_u:bool = compare.le(old_u,limit_u)
  remaining_u:u64 = int.sub.wrap(limit_u,old_u)
  fits_u:bool = compare.le(n_u,remaining_u)
  positive_u:bool = compare.lt(head_u,un)
  cap_ok_u:bool = bool.and(old_ok_u,fits_u)
