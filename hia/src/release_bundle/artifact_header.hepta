  next_shift:u64 = int.add.wrap(rd_shift,rd_eight)
  next_pos:u64 = int.add.wrap(rd_pos,rd_one)
  finished:bool = compare.eq(remaining,rd_zero)
  branch finished done(value) read(rd_input,next_pos,remaining,next_shift,value)
