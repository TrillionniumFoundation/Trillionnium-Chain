  ret(no_code)
end

fn smk_eq(entry_m:mutbuf,entry_a:usize,entry_b:usize,entry_n:u64) -> (bool) effects(read,write,trap) entry(entry)
block entry(entry_m:mutbuf,entry_a:usize,entry_b:usize,entry_n:u64)
  jump loop(entry_m,entry_a,entry_b,entry_n)
block loop(loop_m:mutbuf,loop_a:usize,loop_b:usize,loop_n:u64)
  loop_x:u8 = buffer.load(loop_m,loop_a)
  loop_y:u8 = buffer.load(loop_m,loop_b)
  loop_same:bool = compare.eq(loop_x,loop_y)
  branch loop_same next(loop_m,loop_a,loop_b,loop_n) no()
block next(next_m:mutbuf,next_a:usize,next_b:usize,next_n:u64)
  next_one:usize = const() {"value":1}
  next_off:u64 = const() {"value":1}
  next_zero:u64 = const() {"value":0}
  next_aa:usize = int.add.wrap(next_a,next_one)
  next_bb:usize = int.add.wrap(next_b,next_one)
  next_left:u64 = int.sub.wrap(next_n,next_off)
  next_end:bool = compare.eq(next_left,next_zero)
  branch next_end yes() loop(next_m,next_aa,next_bb,next_left)
block yes()
  yes_code:bool = const() {"value":true}
  ret(yes_code)
block no()
  no_code:bool = const() {"value":false}
  ret(no_code)
end

fn smk_links(entry_m:mutbuf,entry_count:u64) -> (bool) effects(read,write,trap) entry(entry)
block entry(entry_m:mutbuf,entry_count:u64)
  entry_seqa:u64 = const() {"value":4500}
  entry_seq:u64 = call(entry_m,entry_seqa) {"function":"cp_get"}
  entry_sourcea:u64 = const() {"value":4588}
  entry_source:u64 = call(entry_m,entry_sourcea) {"function":"cp_get"}
  entry_targeta:u64 = const() {"value":4596}
  entry_target:u64 = call(entry_m,entry_targeta) {"function":"cp_get"}
  entry_sequence:bool = compare.eq(entry_seq,entry_count)
  entry_range:bool = compare.le(entry_source,entry_target)
  entry_well:bool = bool.and(entry_sequence,entry_range)
  branch entry_well by_count(entry_m,entry_count,entry_source) no()
block by_count(by_count_m:mutbuf,by_count_count:u64,by_count_source:u64)
  by_count_z:u64 = const() {"value":0}
  by_count_first:bool = compare.eq(by_count_count,by_count_z)
  branch by_count_first anchor(by_count_m,by_count_source) successor(by_count_m)
block anchor(anchor_m:mutbuf,anchor_source:u64)
  anchor_zero:u64 = const() {"value":0}
  anchor_starts:bool = compare.eq(anchor_zero,anchor_source)
  anchor_height_a:usize = const() {"value":4508}
  anchor_height_b:usize = const() {"value":6000}
  anchor_height_n:u64 = const() {"value":8}
  anchor_height:bool = call(anchor_m,anchor_height_a,anchor_height_b,anchor_height_n) {"function":"smk_eq"}
  anchor_parent_height_a:usize = const() {"value":4548}
  anchor_parent_height_b:usize = const() {"value":6000}
  anchor_parent_height_n:u64 = const() {"value":8}
  anchor_parent_height:bool = call(anchor_m,anchor_parent_height_a,anchor_parent_height_b,anchor_parent_height_n) {"function":"smk_eq"}
  anchor_block_a:usize = const() {"value":4516}
  anchor_block_b:usize = const() {"value":6008}
  anchor_block_n:u64 = const() {"value":32}
  anchor_block:bool = call(anchor_m,anchor_block_a,anchor_block_b,anchor_block_n) {"function":"smk_eq"}
  anchor_parent_block_a:usize = const() {"value":4556}
  anchor_parent_block_b:usize = const() {"value":6008}
  anchor_parent_block_n:u64 = const() {"value":32}
  anchor_parent_block:bool = call(anchor_m,anchor_parent_block_a,anchor_parent_block_b,anchor_parent_block_n) {"function":"smk_eq"}
  anchor_state_a:usize = const() {"value":4604}
  anchor_state_b:usize = const() {"value":6040}
  anchor_state_n:u64 = const() {"value":32}
  anchor_state:bool = call(anchor_m,anchor_state_a,anchor_state_b,anchor_state_n) {"function":"smk_eq"}
  anchor_root_a:usize = const() {"value":4668}
  anchor_root_b:usize = const() {"value":6072}
  anchor_root_n:u64 = const() {"value":32}
  anchor_root:bool = call(anchor_m,anchor_root_a,anchor_root_b,anchor_root_n) {"function":"smk_eq"}
  anchor_predecessor_a:usize = const() {"value":4732}
  anchor_predecessor_b:usize = const() {"value":6104}
  anchor_predecessor_n:u64 = const() {"value":32}
  anchor_predecessor:bool = call(anchor_m,anchor_predecessor_a,anchor_predecessor_b,anchor_predecessor_n) {"function":"smk_eq"}
  anchor_all0:bool = bool.and(anchor_starts,anchor_height)
  anchor_all1:bool = bool.and(anchor_all0,anchor_parent_height)
  anchor_all2:bool = bool.and(anchor_all1,anchor_block)
  anchor_all3:bool = bool.and(anchor_all2,anchor_parent_block)
  anchor_all4:bool = bool.and(anchor_all3,anchor_state)
  anchor_all5:bool = bool.and(anchor_all4,anchor_root)
  anchor_all6:bool = bool.and(anchor_all5,anchor_predecessor)
  ret(anchor_all6)
block successor(successor_m:mutbuf)
