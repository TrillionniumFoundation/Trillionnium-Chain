fn sr_status(r:readbuf,n:usize,want:u64) -> (bool) effects(read,write,trap) entry(entry)
block entry(r:readbuf,n:usize,want:u64)
  full:usize = const() {"value":24}
  extent_ok:bool = compare.eq(n,full)
  branch extent_ok code(r,want) fail()
block code(in:readbuf,expected:u64)
  start:u64 = const() {"value":0}
  actual:u64 = call(in,start) {"function":"tr_read"}
  matched:bool = compare.eq(actual,expected)
  ret(matched)
block fail()
  invalid:bool = const() {"value":false}
  ret(invalid)
end

fn sr_value(r:readbuf,n:usize,kind:u64) -> (bool) effects(read,write,trap) entry(entry)
block entry(r:readbuf,n:usize,kind:u64)
  code_at:u64 = const() {"value":0}
  type_at:u64 = const() {"value":8}
  extent_at:u64 = const() {"value":16}
  header:u64 = const() {"value":24}
  actual:u64 = call(r,code_at) {"function":"tr_read"}
  sqlite_type:u64 = call(r,type_at) {"function":"tr_read"}
  extent:u64 = call(r,extent_at) {"function":"tr_read"}
  available:u64 = int.cast(n) {"mode":"wrap"}
  payload:u64 = int.sub.wrap(available,header)
  okay:bool = compare.eq(actual,code_at)
  typed:bool = compare.eq(sqlite_type,kind)
  exact:bool = compare.eq(extent,payload)
  typed_ok:bool = bool.and(okay,typed)
  result:bool = bool.and(exact,typed_ok)
  ret(result)
end

