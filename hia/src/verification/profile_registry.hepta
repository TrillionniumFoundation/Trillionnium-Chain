fn vr_prior_identity(input:readbuf,count:u64,proposed:u64) -> (bool) effects(read,trap) entry(entry)
block entry(input:readbuf,count:u64,proposed:u64)
  zero:u64 = const() {"value":0}
  jump loop(input,count,proposed,zero)
block loop(li:readbuf,limit:u64,target:u64,index:u64)
  done:bool = compare.eq(index,limit)
  branch done absent() match(li,limit,target,index)
block match(mi:readbuf,ml:u64,mt:u64,midx:u64)
  row:u64 = call(midx) {"function":"vr_row"}
  id_width:u64 = const() {"value":32}
  id_equal:bool = call(mi,row,mt,id_width) {"function":"vr_compare"}
  version_at:u64 = const() {"value":64}
  version_width:u64 = const() {"value":4}
  existing:u64 = call(mi,row,version_at,version_width) {"function":"vr_read"}
  offered:u64 = call(mi,mt,version_at,version_width) {"function":"vr_read"}
  same_version:bool = compare.eq(existing,offered)
  both:bool = bool.and(id_equal,same_version)
  one:u64 = const() {"value":1}
  next:u64 = int.add.wrap(midx,one)
  branch both found() loop(mi,ml,mt,next)
block found()
  yes:bool = const() {"value":true}
  ret(yes)
block absent()
  no:bool = const() {"value":false}
  ret(no)
end

fn vr_find(input:readbuf,query_id:u64,query_version:u64) -> (u64) effects(read,trap) entry(entry)
block entry(input:readbuf,query_id:u64,query_version:u64)
  zero:u64 = const() {"value":0}
  jump loop(input,query_id,query_version,zero)
block loop(li:readbuf,lid:u64,lv:u64,idx:u64)
  six:u64 = const() {"value":6}
  done:bool = compare.eq(idx,six)
  branch done absent() match(li,lid,lv,idx)
block match(mi:readbuf,mid:u64,mv:u64,midx:u64)
  row:u64 = call(midx) {"function":"vr_row"}
  id_len:u64 = const() {"value":32}
  both_id:bool = call(mi,row,mid,id_len) {"function":"vr_compare"}
