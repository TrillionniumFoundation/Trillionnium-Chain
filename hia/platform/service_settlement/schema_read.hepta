fn ssr_exact_text(entry_r:readbuf,entry_m:mutbuf,entry_n:u64) -> (bool) effects(read,write,trap) entry(entry)
block entry(entry_r:readbuf,entry_m:mutbuf,entry_n:u64)
  entry_c0:u64 = const() {"value":0}
  entry_c8:u64 = const() {"value":8}
  entry_c16:u64 = const() {"value":16}
  entry_text:u64 = const() {"value":3}
  entry_status:u64 = call(entry_r,entry_c0) {"function":"tr_read"}
  entry_status_ok:bool = compare.eq(entry_status,entry_c0)
  entry_kind:u64 = call(entry_r,entry_c8) {"function":"tr_read"}
  entry_kind_ok:bool = compare.eq(entry_kind,entry_text)
  entry_length:u64 = call(entry_r,entry_c16) {"function":"tr_read"}
  entry_length_ok:bool = compare.eq(entry_length,entry_n)
  entry_sk:bool = bool.and(entry_status_ok,entry_kind_ok)
  entry_okay:bool = bool.and(entry_sk,entry_length_ok)
  entry_first:usize = const() {"value":0}
  branch entry_okay check(entry_r,entry_m,entry_n,entry_first) no()
block check(check_r:readbuf,check_m:mutbuf,check_n:u64,check_i:usize)
  check_wide:u64 = int.cast(check_i) {"mode":"wrap"}
  check_more:bool = compare.lt(check_wide,check_n)
  branch check_more byte(check_r,check_m,check_n,check_i) yes()
block byte(byte_r:readbuf,byte_m:mutbuf,byte_n:u64,byte_i:usize)
  byte_head:usize = const() {"value":24}
  byte_start:usize = const() {"value":2048}
  byte_ra:usize = int.add.wrap(byte_i,byte_head)
  byte_ma:usize = int.add.wrap(byte_i,byte_start)
  byte_observed:u8 = buffer.load(byte_r,byte_ra)
  byte_expected:u8 = buffer.load(byte_m,byte_ma)
  byte_same:bool = compare.eq(byte_observed,byte_expected)
  byte_one:usize = const() {"value":1}
  byte_next:usize = int.add.wrap(byte_i,byte_one)
  branch byte_same check(byte_r,byte_m,byte_n,byte_next) no()
block yes()
  yes_value:bool = const() {"value":true}
  ret(yes_value)
block no()
  no_value:bool = const() {"value":false}
  ret(no_value)
end
