  pa_match:bool = call(pa_m,pa_copy,pa_parent,pa_n) {"function":"smk_eq"}
  pa_h_at:u64 = const() {"value":100}
  pa_known:u64 = int.cast(pa_parent) {"mode":"wrap"}
  pa_current:u64 = call(pa_r,pa_h_at) {"function":"tr_read"}
  pa_height:u64 = call(pa_m,pa_known) {"function":"cp_get"}
  pa_unit:u64 = const() {"value":1}
  pa_next:u64 = int.add.wrap(pa_height,pa_unit)
  pa_step:bool = compare.eq(pa_current,pa_next)
  pa_progress:bool = compare.gt(pa_current,pa_height)
  pa_mode_at:u64 = const() {"value":349024}
  pa_mode:u64 = call(pa_m,pa_mode_at) {"function":"cp_get"}
  pa5:u64 = const() {"value":5}
  pa2:u64 = const() {"value":2}
  pa_which:bool = compare.eq(pa_mode,pa5)
  pa_is_second:bool = compare.eq(pa_row,pa2)
  pa_same:bool = bool.and(pa_which,pa_is_second)
  pa_equal:bool = compare.eq(pa_current,pa_height)
  pa_normal:bool = bool.and(pa_step,pa_progress)
  pa_exact:bool = select(pa_same,pa_equal,pa_normal)
  pa_good:bool = bool.and(pa_match,pa_exact)
  branch pa_good terminal(pa_r,pa_m,pa_w,pa_row,pa_last,pa_len) refused()
block terminal(te_r:readbuf,te_m:mutbuf,te_w:mutbuf,te_row:u64,te_last:bool,te_len:u64)
  branch te_last tail(te_r,te_m,te_w,te_row,te_len) save(te_r,te_m,te_w,te_row,te_len)
block tail(ta_r:readbuf,ta_m:mutbuf,ta_w:mutbuf,ta_row:u64,ta_len:u64)
  ta_receipt:usize = const() {"value":100}
  ta_metadata:usize = const() {"value":7010}
  ta_all:u64 = const() {"value":72}
  ta_same:bool = call(ta_r,ta_m,ta_receipt,ta_metadata,ta_all) {"function":"smr_eq_bound"}
  branch ta_same save(ta_r,ta_m,ta_w,ta_row,ta_len) refused()
block save(sv_r:readbuf,sv_m:mutbuf,sv_w:mutbuf,sv_row:u64,sv_len:u64)
  sv_src:u64 = const() {"value":100}
  sv_dst:u64 = const() {"value":354000}
  sv_width:u64 = const() {"value":72}
  sv_added:u64 = call(sv_r,sv_src,sv_m,sv_dst,sv_width) {"function":"cp_copy"}
  jump request(sv_m,sv_w,sv_row,sv_len)
block request(qm:mutbuf,qw:mutbuf,qrow:u64,qlen:u64)
  trust_at:u64 = const() {"value":8224}
  qbase:u64 = const() {"value":360000}
  qlength_at:u64 = const() {"value":349016}
  qhead:u64 = const() {"value":1053}
  qlength:u64 = int.add.wrap(qhead,qlen)
  qlensave:u64 = call(qm,qlength_at,qlength) {"function":"cp_put"}
  qrowseq:u64 = call(qm,qbase,qrow) {"function":"cp_put"}
  payload:u64 = const() {"value":360008}
  trust_n:u64 = const() {"value":882}
  first_end:u64 = call(qm,trust_at,payload,trust_n) {"function":"cp_wcopy"}
  ex_at:usize = const() {"value":140000}
  ex_out:usize = int.cast(first_end) {"mode":"wrap"}
  ex_n:u64 = const() {"value":163}
  x:u64 = call(qw,qm,ex_at,ex_out,ex_n) {"function":"sscid_copy"}
  cmd_at:usize = const() {"value":73728}
  cmd_out:usize = const() {"value":361053}
  y:u64 = call(qw,qm,cmd_at,cmd_out,qlen) {"function":"sscid_copy"}
  awaiting_loc:u64 = const() {"value":349000}
  awaiting:u64 = const() {"value":1}
  marked:u64 = call(qm,awaiting_loc,awaiting) {"function":"cp_put"}
  engine_step:u32 = const() {"value":199}
  ret(engine_step)
block verify(vr0:readbuf,vm0:mutbuf,va0:u64)
  vh_at:u64 = const() {"value":349032}
  vh_old:u64 = call(vm0,vh_at) {"function":"cp_get"}
  vh_one:u64 = const() {"value":1}
  vh_count:u64 = int.add.wrap(vh_old,vh_one)
  vh_first:bool = compare.eq(vh_count,vh_one)
  vh_first_width:usize = const() {"value":1268}
  vh_pair_width:usize = const() {"value":2217}
  vh_same_width:usize = const() {"value":2244}
  vh_mode_at:u64 = const() {"value":349024}
  vh_mode:u64 = call(vm0,vh_mode_at) {"function":"cp_get"}
  vh_five:u64 = const() {"value":5}
  vh_same:bool = compare.eq(vh_mode,vh_five)
  vh_second_width:usize = select(vh_same,vh_same_width,vh_pair_width)
  vh_two:u64 = const() {"value":2}
  vh_second:bool = compare.eq(vh_count,vh_two)
  vh_third_width:usize = const() {"value":3257}
  vh_three:u64 = const() {"value":3}
  vh_is_third:bool = compare.eq(vh_count,vh_three)
  vh_fourth_width:usize = const() {"value":4942}
  vh_late_width:usize = select(vh_is_third,vh_third_width,vh_fourth_width)
  vh_later_width:usize = select(vh_second,vh_second_width,vh_late_width)
  vh_width:usize = select(vh_first,vh_first_width,vh_later_width)
  vh_limit_at:u64 = const() {"value":349024}
  vh_limit:u64 = call(vm0,vh_limit_at) {"function":"cp_get"}
  vh_four:u64 = const() {"value":4}
  vh_extra:usize = const() {"value":32}
  vh_fourcase:bool = compare.eq(vh_limit,vh_four)
  vh_profile:bool = bool.or(vh_fourcase,vh_same)
  vh_plus:usize = int.add.wrap(vh_width,vh_extra)
  vh_need:usize = select(vh_profile,vh_plus,vh_width)
  vh_actual:usize = buffer.len(vr0)
  vh_shaped:bool = compare.eq(vh_actual,vh_need)
  branch vh_shaped replay_shape(vr0,vm0,va0,vh_count,vh_width,vh_profile) refused()
block replay_shape(vs_r:readbuf,vs_m:mutbuf,vs_a:u64,vs_n:u64,vs_len:usize,vs_ex:bool)
  branch vs_ex compare_engine_parent(vs_r,vs_m,vs_a,vs_n,vs_len) compare_replay(vs_r,vs_m,vs_a,vs_n)
block compare_engine_parent(ve_r:readbuf,ve_m:mutbuf,ve_a:u64,ve_n:u64,ve_len:usize)
  ve_valid:bool = call(ve_r,ve_m,ve_n,ve_len) {"function":"hfs_capture_engine"}
  branch ve_valid compare_replay(ve_r,ve_m,ve_a,ve_n) refused()
block compare_replay(kr:readbuf,km:mutbuf,ka:u64,kh:u64)
  zero_k:u64 = const() {"value":0}
  hist:u64 = call(kr,zero_k) {"function":"tr_read"}
  hist_ok:bool = compare.eq(hist,kh)
  ki:usize = const() {"value":8}
  si:usize = const() {"value":176}
  bytes32:u64 = const() {"value":32}
  kid:bool = call(kr,km,ki,si,bytes32) {"function":"smr_eq_bound"}
  rk:usize = const() {"value":40}
  mk:usize = const() {"value":354040}
  root_ok:bool = call(kr,km,rk,mk,bytes32) {"function":"smr_eq_bound"}
  first_pair:bool = bool.and(hist_ok,kid)
  k_all:bool = bool.and(first_pair,root_ok)
  branch k_all compare_tail(kr,km,ka,kh) refused()
block compare_tail(ct_r:readbuf,ct_m:mutbuf,ct_a:u64,ct_h:u64)
  ct_at:u64 = const() {"value":349024}
  ct_profile:u64 = call(ct_m,ct_at) {"function":"cp_get"}
  ct_limit:u64 = call(ct_profile) {"function":"hfs_limit"}
  ct_is_last:bool = compare.eq(ct_h,ct_limit)
  branch ct_is_last compare_state(ct_r,ct_m,ct_a,ct_h) resume(ct_m,ct_a,ct_h)
block compare_state(cs2_r:readbuf,cs2_m:mutbuf,cs2_a:u64,cs2_h:u64)
  ks:usize = const() {"value":72}
  ms:usize = const() {"value":400000}
  cs2_size_at:u64 = const() {"value":349008}
  size_s:u64 = call(cs2_m,cs2_size_at) {"function":"cp_get"}
  state_ok:bool = call(cs2_r,cs2_m,ks,ms,size_s) {"function":"smr_eq_bound"}
  branch state_ok resume(cs2_m,cs2_a,cs2_h) refused()
block resume(um:mutbuf,ua:u64,uh:u64)
  verified_count_at:u64 = const() {"value":349032}
  count_saved:u64 = call(um,verified_count_at,uh) {"function":"cp_put"}
  no_pending:u64 = const() {"value":0}
  recorded:u64 = call(um,ua,no_pending) {"function":"cp_put"}
  resume_sql:u32 = const() {"value":198}
  ret(resume_sql)
block delegate(dr:readbuf,dm:mutbuf,dw:mutbuf,dp:u64)
  prefer:u64 = const() {"value":4}
  rc:u32 = call(dr,dm,dw,prefer) {"function":"sjr_reader"}
  success:u32 = const() {"value":0}
  complete:bool = compare.eq(rc,success)
  vg_at:u64 = const() {"value":349032}
  vl_at:u64 = const() {"value":349024}
  verified_count:u64 = call(dm,vg_at) {"function":"cp_get"}
  exit_profile:u64 = call(dm,vl_at) {"function":"cp_get"}
  limit:u64 = call(exit_profile) {"function":"hfs_limit"}
  verified:bool = compare.eq(verified_count,limit)
  pending_bad:bool = bool.not(verified)
  unsafe_result:bool = bool.and(complete,pending_bad)
  branch unsafe_result refused() reply(rc)
block reply(status:u32)
  ret(status)
block refused()
  err:u32 = const() {"value":100}
  ret(err)
end
