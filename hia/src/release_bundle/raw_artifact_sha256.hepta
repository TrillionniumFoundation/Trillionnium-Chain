  state_digest_at:u64 = const() {"value":1168}
  state_at:u64 = int.add.wrap(state_digest_at,digest_index)
  source_index:usize = int.cast(state_at) {"mode":"wrap"}
  target_index:usize = int.cast(digest_index) {"mode":"wrap"}
  octet:u8 = buffer.load(copy_state,source_index)
  _ = buffer.store(copy_out,target_index,octet)
  digest_byte:u64 = const() {"value":1}
  digest_end:u64 = const() {"value":32}
  next_index:u64 = int.add.wrap(digest_index,digest_byte)
  done:bool = compare.eq(next_index,digest_end)
  branch done success() copy_digest(copy_out,copy_state,next_index)
