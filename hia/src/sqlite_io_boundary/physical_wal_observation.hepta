  a_high:u64 = call(r,a,i_a_high) {"function":"mvp_get"}
  i_b_high:u64 = const() {"value":88}
  b_high:u64 = call(r,b,i_b_high) {"function":"mvp_get"}
  i_a_ord:u64 = const() {"value":96}
  a_ord:u64 = call(r,a,i_a_ord) {"function":"mvp_get"}
  i_b_ord:u64 = const() {"value":96}
  b_ord:u64 = call(r,b,i_b_ord) {"function":"mvp_get"}
  i_a_clean:u64 = const() {"value":104}
  a_clean:u64 = call(r,a,i_a_clean) {"function":"mvp_get"}
