block parse(pi:readbuf,pn:u64,pp:u64,pw:mutbuf,pk:u64,pc:u64)
  value:u64 = call(pi,pp,pn) {"function":"oj_ws"}
  row:u64 = const() {"value":4096}
  end_:u64 = call(pi,pn,value,pw,row) {"function":"hj_entry"}
  sentinel:u64 = const() {"value":18446744073709551615}
  okay:bool = compare.ne(end_,sentinel)
  branch okay store(pi,pn,pw,pk,pc,value,end_) bad()
block store(si:readbuf,sn:u64,sw:mutbuf,sk:u64,sc:u64,sv:u64,se:u64)
  a:u64 = const() {"value":21}
  b:u64 = const() {"value":42}
  q:u64 = int.shl.checked(sv,a)
  p2:u64 = int.shl.checked(se,b)
  kq:u64 = bit.or(sk,q)
  packed:u64 = bit.or(kq,p2)
  next:u64 = call(sw,packed,sc,si,sn) {"function":"ht_insert"}
  at:u64 = const() {"value":8}
  set_:u64 = call(sw,at,next) {"function":"cp_put"}
  ret(se)
block bad()
  fail:u64 = const() {"value":18446744073709551615}
  ret(fail)
end
fn ht_publish(i:readbuf,n:u64,w:mutbuf,o:mutbuf,count:u64) -> (u64) effects(read,write,trap) entry(entry)
block entry(i:readbuf,n:u64,w:mutbuf,o:mutbuf,count:u64)
  z:u64 = const() {"value":0}
  neg:u64 = int.sub.wrap(z,count)
  low:u64 = bit.and(neg,count)
  begin:u64 = int.sub.wrap(count,low)
  jump consolidate(i,n,w,o,count,begin)
block consolidate(ci:readbuf,cn:u64,cw:mutbuf,co:mutbuf,cc:u64,cb:u64)
  cz:u64 = const() {"value":0}
  done_:bool = compare.eq(cb,cz)
  branch done_ emit(cw,co,cc) merge(ci,cn,cw,co,cc,cb)
block merge(mi:readbuf,mn:u64,mw:mutbuf,mo:mutbuf,mc:u64,mb:u64)
  mz:u64 = const() {"value":0}
  minus:u64 = int.sub.wrap(mz,mb)
  span:u64 = bit.and(mb,minus)
  left_:u64 = int.sub.wrap(mb,span)
  glued:u64 = call(mw,left_,mb,mc,mi,mn) {"function":"ht_merge"}
  jump consolidate(mi,mn,mw,mo,mc,left_)
block emit(ew:mutbuf,eo:mutbuf,ec:u64)
  ez:u64 = const() {"value":0}
  jump loop(ew,eo,ec,ez)
block loop(lw:mutbuf,lo:mutbuf,lc:u64,lj:u64)
  more:bool = compare.lt(lj,lc)
  branch more copy(lw,lo,lc,lj) done(lj)
block copy(xw:mutbuf,xo:mutbuf,xc:u64,xj:u64)
  slot:u64 = call(xj) {"function":"ht_slot"}
  index:u64 = call(xw,slot) {"function":"cp_get"}
  pos:u64 = call(index) {"function":"ht_record"}
  row:u64 = call(xw,pos) {"function":"cp_get"}
  a:u64 = const() {"value":1}
  b:u64 = const() {"value":8}
  next_:u64 = int.add.wrap(xj,a)
  out_:u64 = int.mul.wrap(next_,b)
  saved:u64 = call(xo,out_,row) {"function":"cp_put"}
  jump loop(xw,xo,xc,next_)
block done(d:u64)
  ret(d)
end
