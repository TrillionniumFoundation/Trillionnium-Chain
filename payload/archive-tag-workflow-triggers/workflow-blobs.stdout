          assert report['schema'] == 'public-v3-network-only-business-v1'
          assert report['passed'] is True and report['no_local_depletion_hook'] is True
          assert report['business_transactions'] == report['native_verified_confirmed_transactions'] == 24
          assert report['overlapping_false_calls'] > 0
          assert report['full_state_equal'] is True and report['reopen_equal'] is True
          assert report['honest_error'] is None and report['service_error'] is None
          assert all(row['ok'] is True and row['on_time'] is True for row in report['honest_calls'])
          assert all(row['ok'] is False for worker in report['attack_workers'] for row in worker['calls'])
          for key in ('independent_accepted', 'work_profile_qualified', 'resource_fairness_qualified', 'physical_power_loss', 'production_activation'):
