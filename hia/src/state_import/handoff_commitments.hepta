fn f0(raw:readbuf,out:mutbuf,w:mutbuf) -> (u32) effects(read,write,trap) entry(entry)
block entry(raw:readbuf,out:mutbuf,w:mutbuf)
  nu:usize = buffer.len(raw)
  n:u64 = int.cast(nu) {"mode":"wrap"}
  projection:u64 = const() {"value":200}
  source:u64 = const() {"value":272}
  bound:u64 = const() {"value":576}
  is_projection:bool = compare.eq(n,projection)
  is_source:bool = compare.eq(n,source)
  is_bound:bool = compare.eq(n,bound)
  provider_form:bool = bool.or(is_source,is_bound)
  valid:bool = bool.or(is_projection,provider_form)
  branch valid capacity(raw,out,w,is_projection,is_bound) malformed()
block capacity(cr:readbuf,co:mutbuf,cw:mutbuf,cp:bool,cb:bool)
  c_out:usize = buffer.len(co)
  c_work:usize = buffer.len(cw)
  c_min_out:usize = const() {"value":32}
  c_min_work:usize = const() {"value":1616}
  c_fits_out:bool = compare.ge(c_out,c_min_out)
  c_fits_work:bool = compare.ge(c_work,c_min_work)
  c_fits:bool = bool.and(c_fits_out,c_fits_work)
  branch c_fits route(cr,co,cw,cp,cb) short()
block route(rr:readbuf,ro:mutbuf,rw:mutbuf,rp:bool,rb:bool)
  branch rp projection_hash(rr,ro,rw) source_hash(rr,ro,rw,rb)
block projection_hash(pr:readbuf,po:mutbuf,pw:mutbuf)
  p_ok:bool = call(pr,pw) {"function":"mhc_projection"}
  branch p_ok publish(po,pw) internal()
block source_hash(sr:readbuf,so:mutbuf,sw:mutbuf,sb:bool)
  s_ok:bool = call(sr,sw) {"function":"mhc_source"}
  branch s_ok optional_binding(sr,so,sw,sb) internal()
block optional_binding(br:readbuf,bo:mutbuf,bw:mutbuf,bb:bool)
  branch bb bind(br,bo,bw) publish(bo,bw)
block bind(kr:readbuf,ko:mutbuf,kw:mutbuf)
  consistent:bool = call(kr,kw) {"function":"mhc_bind"}
  branch consistent publish(ko,kw) invalid()
block publish(er:mutbuf,ew:mutbuf)
  pos:u64 = const() {"value":1168}
  dst:u64 = const() {"value":0}
  width:u64 = const() {"value":32}
  output:u64 = call(ew,pos,er,dst,width) {"function":"cp_wout"}
  ok:u32 = const() {"value":0}
  ret(ok)
block malformed()
  m:u32 = const() {"value":100}
  ret(m)
block invalid()
  i:u32 = const() {"value":101}
  ret(i)
block short()
  c:u32 = const() {"value":102}
  ret(c)
block internal()
  u:u32 = const() {"value":103}
  ret(u)
end

fn mhc_bind(raw:readbuf,w:mutbuf) -> (bool) effects(read,write,trap) entry(entry)
block entry(raw:readbuf,w:mutbuf)
  zero:u64 = const() {"value":0}
  expected:u64 = const() {"value":304}
  words:u64 = const() {"value":34}
  same:bool = call(raw,zero,expected,words) {"function":"mhc_equal_pack"}
  branch same digests(raw,w) reject()
block digests(dr:readbuf,dw:mutbuf)
  d_claim:u64 = const() {"value":272}
  d_calc:u64 = const() {"value":1168}
  d_len:u64 = const() {"value":4}
  d_zero:u64 = const() {"value":0}
  jump digest_scan(dr,dw,d_claim,d_calc,d_len,d_zero)
block digest_scan(sr:readbuf,sw:mutbuf,sa:u64,sb:u64,sn:u64,sp:u64)
  src:u64 = call(sr,sa) {"function":"tr_read"}
  computed:u64 = call(sw,sb) {"function":"tr_get"}
  s_agree:bool = compare.eq(src,computed)
  s_nonzero:u64 = bit.or(sp,src)
  branch s_agree advance(sr,sw,sa,sb,sn,s_nonzero) reject()
block advance(ar:readbuf,aw:mutbuf,aa:u64,ab:u64,an:u64,ap:u64)
  eight:u64 = const() {"value":8}
  one:u64 = const() {"value":1}
  aa2:u64 = int.add.wrap(aa,eight)
  ab2:u64 = int.add.wrap(ab,eight)
  next:u64 = int.sub.wrap(an,one)
  finish:bool = compare.eq(an,one)
  branch finish nonzero(ap) digest_scan(ar,aw,aa2,ab2,next,ap)
block nonzero(nv:u64)
  z:u64 = const() {"value":0}
  yes:bool = compare.ne(nv,z)
  ret(yes)
block reject()
  no:bool = const() {"value":false}
  ret(no)
end

fn mhc_equal_pack(raw:readbuf,first:u64,second:u64,count:u64) -> (bool) effects(read,write,trap) entry(entry)
block entry(raw:readbuf,first:u64,second:u64,count:u64)
  jump inspect(raw,first,second,count)
block inspect(ir:readbuf,a:u64,b:u64,left:u64)
  x:u64 = call(ir,a) {"function":"tr_read"}
  y:u64 = call(ir,b) {"function":"tr_read"}
  equal:bool = compare.eq(x,y)
  branch equal advance(ir,a,b,left) mismatch()
block advance(ar:readbuf,aa:u64,ab:u64,al:u64)
  eight:u64 = const() {"value":8}
  a_next:u64 = int.add.wrap(aa,eight)
  b_next:u64 = int.add.wrap(ab,eight)
  one:u64 = const() {"value":1}
  pending:u64 = int.sub.wrap(al,one)
  done:bool = compare.eq(al,one)
  branch done matched() inspect(ar,a_next,b_next,pending)
block matched()
  yes:bool = const() {"value":true}
  ret(yes)
block mismatch()
  no:bool = const() {"value":false}
  ret(no)
end

