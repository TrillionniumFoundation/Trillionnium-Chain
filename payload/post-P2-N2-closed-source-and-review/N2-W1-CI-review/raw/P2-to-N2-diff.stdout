+import math
 import os
 from pathlib import Path
 import shutil
@@ -313,6 +314,26 @@ class V2ControlsGateTests(unittest.TestCase):
                 with self.assertRaises(ValueError):
                     gate.validate_process_observation(dict(process, **changes), 0)
 
+        # An exact 120-second endpoint can subtract to slightly more than 120.
+        # This exercises the producer's float arithmetic without extending it.
+        started = 8.000000000000016
+        deadline = started + 120
+        remaining = deadline - started
+        self.assertGreater(remaining, 120)
+        rounded = dict(process, started_monotonic=started, wall_seconds=1,
+                       effective_deadline_monotonic=deadline,
+                       effective_remaining_seconds=remaining)
+        gate.validate_process_observation(rounded, 0)
+        extended = math.nextafter(deadline, math.inf)
+        for changes in (
+                {'effective_deadline_monotonic': extended,
+                 'effective_remaining_seconds': extended - started},
+                {'effective_remaining_seconds': math.nextafter(remaining, 0)},
+                {'wall_seconds': remaining}):
+            with self.subTest(rounding_changes=changes):
+                with self.assertRaises(ValueError):
+                    gate.validate_process_observation(dict(rounded, **changes), 0)
+
     def test_current_stage_cannot_skip_common_settlement_controls(self):
         process = self.current_process()
         for changes in (
diff --git a/scripts/ci/w1_v2_controls_gate.py b/scripts/ci/w1_v2_controls_gate.py
index c4fe91c7cbae9fa6fffce3cd608ce8d0ab906f38..458b9c804efb962ded3871d231368aec163161eb 100644
--- a/scripts/ci/w1_v2_controls_gate.py
+++ b/scripts/ci/w1_v2_controls_gate.py
@@ -71,7 +71,10 @@ def validate_process_observation(process, code, stage_schema=CURRENT_STAGE_SCHEM
         started, wall, deadline, remaining = (process[name] for name in (
             'started_monotonic', 'wall_seconds', 'effective_deadline_monotonic',
             'effective_remaining_seconds'))
-        controls.require(0 < remaining <= 120 and remaining == deadline - started
+        # Use the producer's absolute endpoint arithmetic. Subtracting the
+        # same finite endpoints can round the remaining duration above 120.
+        controls.require(0 < remaining and deadline <= started + 120
+                         and remaining == deadline - started
                          and started + wall < deadline,
                          'current process exceeds its original deadline')
     groups, pid = process['known_owned_groups'], process.get('pid')
