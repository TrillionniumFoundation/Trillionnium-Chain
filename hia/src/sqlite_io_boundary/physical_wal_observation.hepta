  bind:u64 = call(r,p,i_bind) {"function":"mvp_get"}
  i_growth:u64 = const() {"value":128}
  growth:u64 = call(r,p,i_growth) {"function":"mvp_get"}
  i_kind:u64 = const() {"value":136}
  kind:u64 = call(r,p,i_kind) {"function":"mvp_get"}
  zero:u64 = const() {"value":0}
  one:u64 = const() {"value":1}
  mask:u64 = const() {"value":65535}
  file_cap:u64 = const() {"value":16777216}
  ocap:u64 = const() {"value":1024}
  ccap:u64 = const() {"value":256}
  same_fs:bool = compare.eq(root_dev,dev)
  same_dev:bool = compare.eq(dev,receipt_dev)
  same_ino:bool = compare.eq(ino,receipt_ino)
  same_size:bool = compare.eq(size,receipt_size)
  same_blocks:bool = compare.eq(blocks,receipt_blocks)
