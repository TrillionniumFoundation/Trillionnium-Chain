  "joint_budget_scope": "process CPU since native main clock minus mandatory native full-proof observers; includes material, preparation, headers, generation, ordinary logging, cache/material teardown; excludes process startup and final end-row construction/emission",
  "joint_cold_definition": "rebuild prepared product per batch; not a hardware cache flush or previous campaign per-attempt cold",
  "measurement_order": "sequential jobs on one declared CPU; balanced producer order in the short grid; no simultaneous performance runs",
  "paired_identity": "joint producer/mode/width excluded from challenge; parent hot/cold fixed strategy seed match; different strategies may follow different paid native parent histories",
  "parent_budget_scope": "whole native strategy process CPU including context, signed transactions, every bounded original acquisition, research proof, full observers, logging, parent activation, renewals/revocation and context teardown; excludes startup before clock and explicit posthoc reconstruction",
  "parent_shared_input_comparison": "all three policies pay for both registered material alternatives and shared acquisition; fixed maintenance-only does not claim cheapest overall maintenance-only policy",
  "production_activation": false,
  "proof_retention": "all-completed-research-proofs-including-misses",
  "real_training": false,
  "registration_scope": "Frozen source before any performance campaign; earlier tiny runs test correctness only.",
  "schema": "pon-w1-adaptive-joint-plan-v1",
  "screen_policy": "pay to inspect exactly two tasks times width canonical noise candidates; choose minimum popcount then task index then candidate ordinal; no target outcome is read before selection; producer expands noise anew",
  "waited_cpu_endpoint_allowance_ns": 2000
