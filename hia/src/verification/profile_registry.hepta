fn vr_validate(input:readbuf,row:u64) -> (u32,u64) effects(read,trap) entry(entry)
block entry(input:readbuf,row:u64)
  traits_at:u64 = const() {"value":92}
  traits_len:u64 = const() {"value":5}
  tags:u64 = call(input,row,traits_at,traits_len) {"function":"vr_read"}
  lo:u64 = const() {"value":255}
  kind:u64 = bit.and(tags,lo)
  high:u64 = const() {"value":6}
  hole:u64 = const() {"value":4}
  low_enough:bool = compare.le(kind,high)
  registered:bool = compare.ne(kind,hole)
  typed_kind:bool = bool.and(low_enough,registered)
  bad_bits:u64 = const() {"value":1095199817216}
  reserved:u64 = bit.and(tags,bad_bits)
  tag_zero:u64 = const() {"value":0}
  flags_canonical:bool = compare.eq(reserved,tag_zero)
  typed:bool = bool.and(typed_kind,flags_canonical)
  branch typed options(input,row,kind,tags) format_error()
block options(oi:readbuf,orow:u64,okind:u64,otags:u64)
  expiry_at:u64 = const() {"value":76}
  revocation_at:u64 = const() {"value":84}
  wide:u64 = const() {"value":8}
  exp:u64 = call(oi,orow,expiry_at,wide) {"function":"vr_read"}
  revoke:u64 = call(oi,orow,revocation_at,wide) {"function":"vr_read"}
  exp_mask:u64 = const() {"value":65536}
  revoke_mask:u64 = const() {"value":16777216}
  exp_tag:u64 = bit.and(otags,exp_mask)
  revoke_tag:u64 = bit.and(otags,revoke_mask)
  zero_opt:u64 = const() {"value":0}
  exp_present:bool = compare.ne(exp_tag,zero_opt)
  revoke_present:bool = compare.ne(revoke_tag,zero_opt)
  exp_empty:bool = compare.eq(exp,zero_opt)
  revoke_empty:bool = compare.eq(revoke,zero_opt)
  exp_correct:bool = bool.or(exp_present,exp_empty)
  revoke_correct:bool = bool.or(revoke_present,revoke_empty)
  exact:bool = bool.and(exp_correct,revoke_correct)
  branch exact identifiers(oi,orow,okind,otags,exp,revoke,exp_present,revoke_present) format_error()
block identifiers(ii:readbuf,irow:u64,ikind:u64,itags:u64,iexp:u64,irevoke:u64,ihas_exp:bool,ihas_revoke:bool)
  id_ok:bool = call(ii,irow) {"function":"rac_nonzero_digest"}
  add_hash:u64 = const() {"value":32}
  hash_at:u64 = int.add.wrap(irow,add_hash)
  hash_ok:bool = call(ii,hash_at) {"function":"rac_nonzero_digest"}
  both:bool = bool.and(id_ok,hash_ok)
  branch both version(ii,irow,ikind,itags,iexp,irevoke,ihas_exp,ihas_revoke) zero_identifier()
block version(vi:readbuf,vrow:u64,vkind:u64,vtags:u64,vexp:u64,vrev:u64,vhas_exp:bool,vhas_rev:bool)
  version_at:u64 = const() {"value":64}
  vwidth:u64 = const() {"value":4}
  vvalue:u64 = call(vi,vrow,version_at,vwidth) {"function":"vr_read"}
  version_zero:u64 = const() {"value":0}
  positive:bool = compare.ne(vvalue,version_zero)
  branch positive ranges(vi,vrow,vkind,vtags,vexp,vrev,vhas_exp,vhas_rev) zero_version()
block ranges(ri:readbuf,rrow:u64,rkind:u64,rtags:u64,rexp:u64,rrev:u64,rhas_exp:bool,rhas_rev:bool)
  from_at:u64 = const() {"value":68}
  from_w:u64 = const() {"value":8}
  low:u64 = call(ri,rrow,from_at,from_w) {"function":"vr_read"}
  exp_below:bool = compare.lt(rexp,low)
  rev_below:bool = compare.lt(rrev,low)
  exp_bad:bool = bool.and(rhas_exp,exp_below)
  rev_bad:bool = bool.and(rhas_rev,rev_below)
  invalid:bool = bool.or(exp_bad,rev_bad)
  branch invalid bad_height() authority(rkind,rtags)
block authority(akind:u64,atags:u64)
  subjective:u64 = const() {"value":6}
  wants_mask:u64 = const() {"value":4294967296}
  wants:u64 = bit.and(atags,wants_mask)
  empty:u64 = const() {"value":0}
  requests_objective:bool = compare.ne(wants,empty)
  is_subjective:bool = compare.eq(akind,subjective)
  conflict:bool = bool.and(requests_objective,is_subjective)
  branch conflict escalation() validated(akind)
block format_error()
  malformed:u32 = const() {"value":100}
  filler:u64 = const() {"value":0}
  ret(malformed,filler)
block zero_identifier()
  no_id:u32 = const() {"value":1}
  unused_id:u64 = const() {"value":0}
  ret(no_id,unused_id)
block zero_version()
  no_version:u32 = const() {"value":2}
