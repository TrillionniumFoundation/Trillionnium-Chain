  span:u64 = const() {"value":256}
  digit:u64 = int.mul.wrap(index,span)
  key:u64 = int.add.wrap(low,digit)
  row:u64 = call(input,count,key) {"function":"imd_find"}
  ret(row)
end

fn imd_chunks(input:readbuf,count:u64,tail:u64) -> (bool) effects(read,trap) entry(entry)
block entry(input:readbuf,count:u64,tail:u64)
  zero:u64 = const() {"value":0}
  jump each(input,count,tail,zero)
block each(ei:readbuf,en:u64,et:u64,ex:u64)
  row:u64 = call(ei,en,ex) {"function":"imd_chunk_at"}
  no_row:u64 = const() {"value":0}
  found:bool = compare.ne(row,no_row)
  branch found span(ei,en,et,ex,row) bad()
block span(si:readbuf,sn:u64,st:u64,sx:u64,sr:u64)
  eight:u64 = const() {"value":8}
  last_index:u64 = const() {"value":7}
  tail_row:bool = compare.eq(sx,last_index)
  full:u64 = const() {"value":1024}
  n:u64 = select(tail_row,st,full)
  two:u64 = const() {"value":2}
  width:u64 = int.mul.wrap(n,two)
  want_n:u64 = int.shl.checked(width,eight)
  one:u64 = const() {"value":1}
  want:u64 = int.add.wrap(want_n,one)
  h:u64 = int.add.wrap(sr,eight)
  observed:u64 = call(si,h,eight) {"function":"rac_read_le"}
  matches:bool = compare.eq(observed,want)
  branch matches digits(si,sn,st,sx,sr,width,tail_row) bad()
block digits(di:readbuf,dn:u64,dt:u64,dx:u64,dr:u64,dwidth:u64,last:bool)
  payload_rel:u64 = const() {"value":16}
  payload:u64 = int.add.wrap(dr,payload_rel)
  end_at:u64 = int.add.wrap(payload,dwidth)
  good:bool = call(di,payload,end_at) {"function":"imd_digits"}
  one_d:u64 = const() {"value":1}
  next:u64 = int.add.wrap(dx,one_d)
  branch good advance(di,dn,dt,next,last) bad()
block advance(ai:readbuf,an:u64,at:u64,ax:u64,done:bool)
  branch done yes() each(ai,an,at,ax)
block bad()
  no:bool = const() {"value":false}
  ret(no)
block yes()
  valid:bool = const() {"value":true}
  ret(valid)
end

fn imd_digits(input:readbuf,at:u64,stop:u64) -> (bool) effects(read,trap) entry(entry)
block entry(input:readbuf,at:u64,stop:u64)
  jump each(input,at,stop)
block each(ei:readbuf,ea:u64,es:u64)
  value:u64 = call(ei,ea) {"function":"imd_pair"}
  bound:u64 = const() {"value":255}
  acceptable:bool = compare.le(value,bound)
  two:u64 = const() {"value":2}
  next:u64 = int.add.wrap(ea,two)
  done:bool = compare.eq(es,next)
  branch acceptable advance(ei,next,es,done) no()
block advance(ai:readbuf,aa:u64,as_:u64,fin:bool)
  branch fin yes() each(ai,aa,as_)
block yes()
  good:bool = const() {"value":true}
  ret(good)
block no()
  bad:bool = const() {"value":false}
  ret(bad)
end

fn imd_emit(input:readbuf,output:mutbuf,count:u64,tail:u64) -> (u64) effects(read,write,trap) entry(entry)
block entry(input:readbuf,output:mutbuf,count:u64,tail:u64)
  zero:u64 = const() {"value":0}
  jump each(input,output,count,tail,zero,zero)
block each(ei:readbuf,eo:mutbuf,en:u64,et:u64,ex:u64,ep:u64)
  row:u64 = call(ei,en,ex) {"function":"imd_chunk_at"}
  rel:u64 = const() {"value":16}
  payload:u64 = int.add.wrap(row,rel)
  limit:u64 = const() {"value":7}
  last:bool = compare.eq(ex,limit)
  full:u64 = const() {"value":1024}
  length:u64 = select(last,et,full)
  end:u64 = call(ei,eo,payload,ep,length) {"function":"imd_write_hex"}
  one:u64 = const() {"value":1}
  successor:u64 = int.add.wrap(ex,one)
  branch last done(end) each(ei,eo,en,et,successor,end)
block done(n:u64)
  ret(n)
end

fn imd_write_hex(input:readbuf,output:mutbuf,src:u64,dest:u64,len:u64) -> (u64) effects(read,write,trap) entry(entry)
block entry(input:readbuf,output:mutbuf,src:u64,dest:u64,len:u64)
  end:u64 = int.add.wrap(dest,len)
  jump each(input,output,src,dest,end)
block each(ei:readbuf,eo:mutbuf,es:u64,ed:u64,ee:u64)
  value:u64 = call(ei,es) {"function":"imd_pair"}
  byte:u8 = int.cast(value) {"mode":"wrap"}
  position:usize = int.cast(ed) {"mode":"wrap"}
  _ = buffer.store(eo,position,byte)
  one:u64 = const() {"value":1}
  two:u64 = const() {"value":2}
  ns:u64 = int.add.wrap(es,two)
  nd:u64 = int.add.wrap(ed,one)
  done:bool = compare.eq(nd,ee)
  branch done finish(nd) each(ei,eo,ns,nd,ee)
block finish(n:u64)
  ret(n)
end
