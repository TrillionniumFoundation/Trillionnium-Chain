                    'Self::PqNetworkV2 | Self::PqContinuousV3 => format!("{}{}", ddl(), pq_network::DDL),',
                    'Self::PqNetworkV2 => b"native-pq-network-owner-schema-v2",',
                    'Self::PqContinuousV3 => b"native-pq-continuous-owner-schema-v3",'):
