+fn prepare_snapshot_with_sharing(
+    actual_state: &State,
+    previous: &CheckedCommitment,
+    limits: CacheLimits,
+    arithmetic: Option<&FullRootArithmetic>,
+) -> Result<PreparedCommitment> {
