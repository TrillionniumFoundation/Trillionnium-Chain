  signed_max:u64 = const() {"value":9223372036854775807}
  negative:bool = compare.gt(ba,signed_max)
  branch negative sub(bo,first,ba) add(bo,first,ba)
block sub(no:mutbuf,nb:u64,na:u64)
  subzero:u64 = const() {"value":0}
  magnitude:u64 = int.sub.wrap(subzero,na)
  subtraction:u64 = int.sub.wrap(nb,magnitude)
