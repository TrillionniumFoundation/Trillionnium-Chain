  branch exact success() bad()
block success()
  okay:u32 = const() {"value":0}
  ret(okay)
block bad()
  invalid:u32 = const() {"value":100}
  ret(invalid)
block internal()
  hash_failure:u32 = const() {"value":103}
  ret(hash_failure)
end

fn jph_read_u32(w:mutbuf,p:u64,end:u64) -> (u64) effects(read,write,trap) entry(entry)
block entry(w:mutbuf,p:u64,end:u64)
  four:u64 = const() {"value":4}
  next:u64 = int.add.wrap(p,four)
  legal:bool = compare.le(next,end)
  branch legal valid(w,p) bad()
block valid(vw:mutbuf,vp:u64)
  raw:u64 = call(vw,vp) {"function":"cp_get"}
  mask:u64 = const() {"value":4294967295}
