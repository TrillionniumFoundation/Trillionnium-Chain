  jump prefix(entry_i,entry_s,entry_at,entry_extent,entry_out_at,entry_count,entry_covered,entry_zero)
block prefix(prefix_i:readbuf,prefix_s:mutbuf,prefix_at:u64,prefix_extent:u64,prefix_out_at:u64,prefix_count:u64,prefix_covered:u64,prefix_hits:u64)
