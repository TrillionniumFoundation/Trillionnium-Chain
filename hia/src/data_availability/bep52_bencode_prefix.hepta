  delimiter_stop:bool = compare.eq(delimiter_c,delimiter_e)
  branch delimiter_stop prefix(delimiter_r,delimiter_start,delimiter_p) room(delimiter_r,delimiter_n,delimiter_start,delimiter_p)
block room(room_r:readbuf,room_n:u64,room_start:u64,room_p:u64)
  room_cap:u64 = const() {"value":20}
  room_one:u64 = const() {"value":1}
  room_extent:u64 = int.sub.wrap(room_p,room_start)
  room_fits:bool = compare.lt(room_extent,room_cap)
  room_next:u64 = int.add.wrap(room_p,room_one)
  branch room_fits scan(room_r,room_n,room_start,room_next) bound()
block prefix(prefix_r:readbuf,prefix_start:u64,prefix_stop:u64)
  prefix_empty:bool = compare.eq(prefix_start,prefix_stop)
  branch prefix_empty missing_digits() sign(prefix_r,prefix_start,prefix_stop)
block sign(sign_r:readbuf,sign_start:u64,sign_stop:u64)
  sign_one:u64 = const() {"value":1}
  sign_minus:u8 = const() {"value":45}
  buf_at_8:usize = int.cast(sign_start) {"mode":"wrap"}
  sign_c:u8 = buffer.load(sign_r,buf_at_8)
  sign_negative:bool = compare.eq(sign_c,sign_minus)
  sign_after:u64 = int.add.wrap(sign_start,sign_one)
  sign_digits:u64 = select(sign_negative,sign_after,sign_start)
  sign_have:bool = compare.lt(sign_digits,sign_stop)
  branch sign_have digit(sign_r,sign_digits,sign_stop,sign_digits,sign_negative) invalid_digits()
block digit(digit_r:readbuf,digit_start:u64,digit_stop:u64,digit_p:u64,digit_neg:bool)
  buf_at_9:usize = int.cast(digit_p) {"mode":"wrap"}
  digit_c:u8 = buffer.load(digit_r,buf_at_9)
  digit_zero:u8 = const() {"value":48}
  digit_nine:u8 = const() {"value":57}
  digit_lo:bool = compare.ge(digit_c,digit_zero)
  digit_hi:bool = compare.le(digit_c,digit_nine)
  digit_ok:bool = bool.and(digit_lo,digit_hi)
  branch digit_ok digit_next(digit_r,digit_start,digit_stop,digit_p,digit_neg) invalid_digits()
block digit_next(digit_next_r:readbuf,digit_next_start:u64,digit_next_stop:u64,digit_next_p:u64,digit_next_neg:bool)
  digit_next_one:u64 = const() {"value":1}
  digit_next_after:u64 = int.add.wrap(digit_next_p,digit_next_one)
  digit_next_more:bool = compare.lt(digit_next_after,digit_next_stop)
  branch digit_next_more digit(digit_next_r,digit_next_start,digit_next_stop,digit_next_after,digit_next_neg) canonical(digit_next_r,digit_next_start,digit_next_stop,digit_next_neg)
block canonical(canonical_r:readbuf,canonical_start:u64,canonical_stop:u64,canonical_neg:bool)
  canonical_one:u64 = const() {"value":1}
  canonical_zero:u8 = const() {"value":48}
  canonical_n:u64 = int.sub.wrap(canonical_stop,canonical_start)
  buf_at_10:usize = int.cast(canonical_start) {"mode":"wrap"}
  canonical_c:u8 = buffer.load(canonical_r,buf_at_10)
  canonical_zero_first:bool = compare.eq(canonical_c,canonical_zero)
  canonical_multi:bool = compare.gt(canonical_n,canonical_one)
  canonical_bad:bool = bool.and(canonical_multi,canonical_zero_first)
  canonical_negzero:bool = bool.and(canonical_neg,canonical_zero_first)
  branch canonical_bad leading_zero() check_negative(canonical_r,canonical_start,canonical_stop,canonical_neg,canonical_n,canonical_negzero)
block check_negative(check_negative_r:readbuf,check_negative_start:u64,check_negative_stop:u64,check_negative_neg:bool,check_negative_n:u64,check_negative_negzero:bool)
  branch check_negative_negzero negative_zero() numeric_extent(check_negative_r,check_negative_start,check_negative_stop,check_negative_neg,check_negative_n)
block numeric_extent(numeric_extent_r:readbuf,numeric_extent_start:u64,numeric_extent_stop:u64,numeric_extent_neg:bool,numeric_extent_n:u64)
  numeric_extent_nineteen:u64 = const() {"value":19}
  numeric_extent_z:u64 = const() {"value":0}
  numeric_extent_fits:bool = compare.le(numeric_extent_n,numeric_extent_nineteen)
  branch numeric_extent_fits value(numeric_extent_r,numeric_extent_start,numeric_extent_stop,numeric_extent_neg,numeric_extent_z) overflow()
block value(value_r:readbuf,value_p:u64,value_stop:u64,value_neg:bool,value_acc:u64)
  buf_at_11:usize = int.cast(value_p) {"mode":"wrap"}
  value_c:u8 = buffer.load(value_r,buf_at_11)
  value_one:u64 = const() {"value":1}
  value_ten:u64 = const() {"value":10}
  value_zero:u64 = const() {"value":48}
  value_v:u64 = int.cast(value_c) {"mode":"wrap"}
  value_d:u64 = int.sub.wrap(value_v,value_zero)
  value_left:u64 = int.mul.wrap(value_acc,value_ten)
  value_val:u64 = int.add.wrap(value_left,value_d)
  value_next:u64 = int.add.wrap(value_p,value_one)
  value_more:bool = compare.lt(value_next,value_stop)
  branch value_more value(value_r,value_next,value_stop,value_neg,value_val) limit(value_stop,value_neg,value_val)
block limit(limit_stop:u64,limit_neg:bool,limit_acc:u64)
  limit_pos:u64 = const() {"value":9223372036854775807}
  limit_minus:u64 = const() {"value":9223372036854775808}
  limit_cap:u64 = select(limit_neg,limit_minus,limit_pos)
  limit_fits:bool = compare.le(limit_acc,limit_cap)
  branch limit_fits success(limit_stop) overflow()
block success(success_stop:u64)
  success_one:u64 = const() {"value":1}
  success_next:u64 = int.add.wrap(success_stop,success_one)
  success_z:u32 = const() {"value":0}
  ret(success_z,success_next)
block bound()
  bound_s:u32 = const() {"value":26}
  bound_z:u64 = const() {"value":0}
  ret(bound_s,bound_z)
block missing_end()
  missing_end_s:u32 = const() {"value":27}
  missing_end_z:u64 = const() {"value":0}
  ret(missing_end_s,missing_end_z)
block missing_digits()
  missing_digits_s:u32 = const() {"value":28}
  missing_digits_z:u64 = const() {"value":0}
  ret(missing_digits_s,missing_digits_z)
block invalid_digits()
  invalid_digits_s:u32 = const() {"value":29}
  invalid_digits_z:u64 = const() {"value":0}
  ret(invalid_digits_s,invalid_digits_z)
block leading_zero()
  leading_zero_s:u32 = const() {"value":30}
  leading_zero_z:u64 = const() {"value":0}
  ret(leading_zero_s,leading_zero_z)
block negative_zero()
  negative_zero_s:u32 = const() {"value":31}
  negative_zero_z:u64 = const() {"value":0}
  ret(negative_zero_s,negative_zero_z)
block overflow()
  overflow_s:u32 = const() {"value":33}
  overflow_z:u64 = const() {"value":0}
  ret(overflow_s,overflow_z)
end

fn benc_strict_lex(entry_r:readbuf,entry_pa:u64,entry_ea:u64,entry_pb:u64,entry_eb:u64) -> (bool) effects(read,trap) entry(entry)
block entry(entry_r:readbuf,entry_pa:u64,entry_ea:u64,entry_pb:u64,entry_eb:u64)
  jump lex_loop(entry_r,entry_pa,entry_ea,entry_pb,entry_eb)
block lex_loop(lex_r:readbuf,lex_pa:u64,lex_ea:u64,lex_pb:u64,lex_eb:u64)
  entry_more_a:bool = compare.lt(lex_pa,lex_ea)
  entry_more_b:bool = compare.lt(lex_pb,lex_eb)
  entry_both:bool = bool.and(entry_more_a,entry_more_b)
  branch entry_both compare(lex_r,lex_pa,lex_ea,lex_pb,lex_eb) prefix(entry_more_a,entry_more_b)
block compare(compare_r:readbuf,compare_pa:u64,compare_ea:u64,compare_pb:u64,compare_eb:u64)
  compare_one:u64 = const() {"value":1}
  buf_at_12:usize = int.cast(compare_pa) {"mode":"wrap"}
  compare_a:u8 = buffer.load(compare_r,buf_at_12)
  buf_at_13:usize = int.cast(compare_pb) {"mode":"wrap"}
  compare_b:u8 = buffer.load(compare_r,buf_at_13)
  compare_na:u64 = int.add.wrap(compare_pa,compare_one)
  compare_nb:u64 = int.add.wrap(compare_pb,compare_one)
  compare_eq:bool = compare.eq(compare_a,compare_b)
  branch compare_eq lex_loop(compare_r,compare_na,compare_ea,compare_nb,compare_eb) different(compare_a,compare_b)
block different(different_a:u8,different_b:u8)
  different_ok:bool = compare.lt(different_a,different_b)
  ret(different_ok)
block prefix(prefix_more_a:bool,prefix_more_b:bool)
  prefix_ended:bool = bool.not(prefix_more_a)
  prefix_ok:bool = bool.and(prefix_ended,prefix_more_b)
  ret(prefix_ok)
end

