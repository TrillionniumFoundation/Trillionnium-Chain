fn ps_hash(input:readbuf,work:mutbuf,count:u64) -> (u64) effects(read,write,trap) entry(entry)
block entry(input:readbuf,work:mutbuf,count:u64)
  initialized:u64 = call(work) {"function":"tr_sha_init"}
  zero:u64 = const() {"value":0}
  ready:bool = compare.eq(initialized,zero)
  branch ready domain(input,work,count) failed(initialized)
block domain(di:readbuf,dw:mutbuf,dc:u64)
  p0:u64 = const() {"value":1208}
  p1:u64 = const() {"value":1216}
  p2:u64 = const() {"value":1224}
  p3:u64 = const() {"value":1232}
  d0:u64 = const() {"value":7810739491857912404}
  d1:u64 = const() {"value":3409594557391921509}
  d2:u64 = const() {"value":8247626254411852115}
  d3:u64 = const() {"value":13922220047160165}
  _domain0:u64 = call(dw,p0,d0) {"function":"tr_put"}
