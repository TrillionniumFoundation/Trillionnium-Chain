fn capture_byte_count(hex:u64) -> (u64,bool) effects(trap) entry(entry)
block entry(hex:u64)
  one:u64 = const() {"value":1}
  bit:u64 = bit.and(hex,one)
  zero:u64 = const() {"value":0}
  even:bool = compare.eq(bit,zero)
  bytes:u64 = int.shr.checked(hex,one)
  ret(bytes,even)
end
