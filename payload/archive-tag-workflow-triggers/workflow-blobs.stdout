# Execute the original tests without waiting for unrelated 180-minute campaigns.
# Test budgets, workloads and service lifetime remain defined by the unchanged Rust source.
# The original test profile and supplementary release profile retain separate receipts.
"name": "PoN original large-state CPU acceptance"
"on":
  "pull_request": {}
"permissions":
  "contents": "read"
"concurrency":
  "group": "pon-original-large-state-${{ github.ref }}"
  "cancel-in-progress": false
"env":
  "CI": "true"
  "CARGO_INCREMENTAL": "0"
  "CARGO_BUILD_JOBS": "2"
  "RUST_TEST_THREADS": "1"
  "PYTHONDONTWRITEBYTECODE": "1"
"jobs":
  "original-state-and-exit":
    "name": "original state and exit (${{ matrix.runner }}, ${{ matrix.source }}, ${{ matrix.build_profile }})"
    "runs-on": "${{ matrix.runner }}"
    "timeout-minutes": 60
    "strategy":
      "fail-fast": false
      "matrix":
        "runner":
          - "ubuntu-24.04"
          - "ubuntu-24.04-arm"
        "source":
          - "head"
          - "prospective-merge"
        "build_profile":
          - "test"
          - "release"
    "env":
      "EXPECTED_HEAD": "${{ github.event.pull_request.head.sha }}"
      "EXPECTED_BASE": "${{ github.event.pull_request.base.sha }}"
      "EXPECTED_MERGE": "${{ github.sha }}"
      "SOURCE_KIND": "${{ matrix.source }}"
      "TRNM_BUILD_PROFILE": "${{ matrix.build_profile }}"
    "steps":
      -
        "name": "Checkout the exact candidate or actual target merge"
        "uses": "actions/checkout@11d5960a326750d5838078e36cf38b85af677262"
        "with":
          "ref": "${{ matrix.source == 'head' && github.event.pull_request.head.sha || github.sha }}"
          "fetch-depth": 0
          "persist-credentials": false
      -
        "name": "Verify unchanged source and original project boundary"
        "id": "source"
        "shell": "bash"
        "run": |-
          set -euo pipefail
          export TRNM_CI_RECEIPT_DIR="$RUNNER_TEMP/original-large-state-observations"
          mkdir -p "$TRNM_CI_RECEIPT_DIR"
          printf 'TRNM_CI_RECEIPT_DIR=%s\n' "$TRNM_CI_RECEIPT_DIR" >> "$GITHUB_ENV"
          printf 'CARGO_HOME=%s/cargo-original-large-state\n' "$RUNNER_TEMP" >> "$GITHUB_ENV"
          printf 'CARGO_TARGET_DIR=%s/target-original-large-state\n' "$RUNNER_TEMP" >> "$GITHUB_ENV"
          args=(--kind "$SOURCE_KIND" --expected-head "$EXPECTED_HEAD")
          if [ "$SOURCE_KIND" = prospective-merge ]; then
            args+=(--expected-base "$EXPECTED_BASE" --expected-merge "$EXPECTED_MERGE")
          fi
          python3 scripts/ci/verify_ci_source.py "${args[@]}" --output "$TRNM_CI_RECEIPT_DIR/source-before.json"
          bash scripts/project-preflight.sh --audit
      -
        "name": "Install the source-pinned native toolchain"
        "id": "toolchain"
        "run": "rustup toolchain install 1.95.0 --profile minimal --component rustfmt --component clippy"
      -
        "name": "Build the selected unchanged native profile"
        "id": "build"
        "shell": "bash"
        "run": |-
          set -euo pipefail
          rustc +1.95.0 -Vv > "$TRNM_CI_RECEIPT_DIR/rustc.txt"
          cargo +1.95.0 -V > "$TRNM_CI_RECEIPT_DIR/cargo.txt"
          uname -a > "$TRNM_CI_RECEIPT_DIR/host.txt"
          python3 - <<'PY'
          import json, os
          from pathlib import Path
          root = Path(os.environ["TRNM_CI_RECEIPT_DIR"])
          keys = ("CI", "CARGO_HOME", "CARGO_TARGET_DIR", "CARGO_BUILD_JOBS", "CARGO_INCREMENTAL",
                  "RUST_TEST_THREADS", "RUSTFLAGS", "CARGO_ENCODED_RUSTFLAGS", "RUSTC_WRAPPER",
                  "RUSTC_WORKSPACE_WRAPPER", "RUSTC", "CARGO_BUILD_RUSTC", "CARGO_BUILD_RUSTFLAGS",
                  "CARGO_BUILD_TARGET", "CARGO_BUILD_RUSTC_WRAPPER", "CARGO_BUILD_RUSTC_WORKSPACE_WRAPPER")
          env = {key: os.environ.get(key) for key in keys}
          env.update({key: value for key, value in os.environ.items()
                      if key.startswith(("CARGO_PROFILE_RELEASE_", "CARGO_PROFILE_TEST_", "CARGO_PROFILE_DEV_")) or
                      (key.startswith("CARGO_TARGET_") and key.endswith("_RUSTFLAGS"))})
          selected = os.environ["TRNM_BUILD_PROFILE"]
          assert selected in ("test", "release"), "unknown build profile"
          command = ["cargo", "+1.95.0", "test", *(["--release"] if selected == "release" else []), "--locked", "--manifest-path",
                     "trillionnium/Cargo.toml", "-p", "trnm-pon-node", "--lib", "--no-run", "--message-format=json"]
          (root / "build-command.json").write_text(json.dumps({"argv": command, "environment": env, "build_profile": selected,
              "original_test_profile": selected == "test", "release_supplementary": selected == "release"}, indent=2) + "\n")
          overrides = keys[6:]
          assert not any(env.get(key) for key in overrides), "unexpected compiler override"
          assert not any(value for key, value in env.items() if key.startswith("CARGO_TARGET_")
                         and key.endswith("_RUSTFLAGS")), "unexpected target compiler flags"
          assert not any(key.startswith(("CARGO_PROFILE_RELEASE_", "CARGO_PROFILE_TEST_", "CARGO_PROFILE_DEV_"))
                         for key in env), "unexpected build profile override"
          PY
          profile_args=()
          case "$TRNM_BUILD_PROFILE" in
            test) ;;
            release) profile_args=(--release) ;;
            *) exit 2 ;;
          esac
          cargo +1.95.0 test "${profile_args[@]}" --locked --manifest-path trillionnium/Cargo.toml -p trnm-pon-node --lib --no-run --message-format=json > "$TRNM_CI_RECEIPT_DIR/build.jsonl" 2> "$TRNM_CI_RECEIPT_DIR/build.stderr"
          python3 - <<'PY'
          import hashlib, json, os
          from pathlib import Path
          root = Path(os.environ["TRNM_CI_RECEIPT_DIR"])
          rows = [json.loads(line) for line in (root / "build.jsonl").read_text().splitlines()]
          finished = [row for row in rows if row.get("reason") == "build-finished"]
          assert len(finished) == 1 and finished[0]["success"] is True
          artifacts = [row for row in rows if row.get("reason") == "compiler-artifact"
                       and row.get("target", {}).get("name") == "trnm_pon_node"
                       and row.get("profile", {}).get("test") is True and row.get("executable")]
          assert len(artifacts) == 1
          artifact = artifacts[0]
          assert artifact["target"]["kind"] == ["lib"]
          binary = Path(artifact["executable"])
          assert binary.is_absolute() and binary.is_file() and not binary.is_symlink()
          profile = artifact["profile"]
          original_test = os.environ["TRNM_BUILD_PROFILE"] == "test"
          assert profile["opt_level"] == "3"
          assert profile["debug_assertions"] is original_test and profile["overflow_checks"] is original_test
          m06 = [row for row in rows if row.get("reason") == "compiler-artifact"
                 and row.get("target", {}).get("name") == "trnm_mvcc_fee"
                 and row.get("target", {}).get("kind") == ["lib"]
                 and row.get("profile", {}).get("test") is False]
          assert len(m06) == 1, "exact M06 dependency profile required"
          m06_profile = m06[0]["profile"]
          assert m06_profile["opt_level"] == ("1" if original_test else "3")
          assert m06_profile["debug_assertions"] is original_test
          assert m06_profile["overflow_checks"] is original_test
          assert artifact["features"] == ["default"], "expected default features"
          with binary.open("rb") as stream:
              assert stream.read(4) == b"\x7fELF"
              stream.seek(0)
              digest = hashlib.file_digest(stream, "sha256").hexdigest()
          (root / "binary.json").write_text(json.dumps({"artifact": artifact, "sha256": digest,
              "m06_profile": m06_profile, "original_test_profile": original_test,
              "release_supplementary": not original_test,
              "scope": "unchanged CPU-policy workloads and limits; original test and supplementary release are separate denominators"}, indent=2) + "\n")
          (root / "binary.sha256").write_text(digest + "  " + str(binary) + "\n")
          (root / "binary.txt").write_text(str(binary) + "\n")
          PY
      -
        "name": "Run both original CPU budgets and actual reactor-exit regressions"
        "if": "${{ !cancelled() && steps.source.outcome == 'success' && steps.toolchain.outcome == 'success' && steps.build.outcome == 'success' }}"
        "shell": "bash"
        "run": |-
          set -euo pipefail
          binary="$(cat "$TRNM_CI_RECEIPT_DIR/binary.txt")"
          sha256sum -c "$TRNM_CI_RECEIPT_DIR/binary.sha256"
          cd "$GITHUB_WORKSPACE/trillionnium/crates/trnm-pon-node"
          pwd > "$TRNM_CI_RECEIPT_DIR/test-cwd.txt"
          status=0
          printf 'selector\tnative_exit\tlog_exit\treader_exit\n' > "$TRNM_CI_RECEIPT_DIR/test-exits.tsv"
          for selector in \
            store::detached_admission::tests::admitted_custom_genesis_over_eight_mib_keeps_original_held_schedule_and_cpu_owner \
            store::detached_admission::tests::authenticated_large_parent_original_schedule_supplementary_denominator \
            ingress::public_v2::tests::public_loop_exit_records_lifetime_before_internal_stop \
            ingress::public_v2::tests::public_loop_exit_records_external_stop_after_signed_read; do
            name="${selector##*::}"
            log="$TRNM_CI_RECEIPT_DIR/$name.log"
            set +e
            /usr/bin/time -v -o "$TRNM_CI_RECEIPT_DIR/$name.resources.txt" "$binary" "$selector" --exact --nocapture --test-threads=1 2>&1 | tee "$log"
            codes=("${PIPESTATUS[@]}")
            python3 "$GITHUB_WORKSPACE/scripts/ci/check_required_native_test.py" "$log" --test "$selector" > "$TRNM_CI_RECEIPT_DIR/$name.execution.json" 2> "$TRNM_CI_RECEIPT_DIR/$name.execution.stderr"
            reader=$?
            set -e
            printf '%s\t%s\t%s\t%s\n' "$selector" "${codes[0]}" "${codes[1]}" "$reader" >> "$TRNM_CI_RECEIPT_DIR/test-exits.tsv"
            if [ "${codes[0]}" -ne 0 ] || [ "${codes[1]}" -ne 0 ] || [ "$reader" -ne 0 ]; then
              status=1
            fi
          done
          sha256sum -c "$TRNM_CI_RECEIPT_DIR/binary.sha256"
          exit "$status"
      -
        "name": "Reverify exact source after every outcome"
        "if": "always()"
        "shell": "bash"
        "run": |-
          set -euo pipefail
          args=(--kind "$SOURCE_KIND" --expected-head "$EXPECTED_HEAD")
          if [ "$SOURCE_KIND" = prospective-merge ]; then
            args+=(--expected-base "$EXPECTED_BASE" --expected-merge "$EXPECTED_MERGE")
          fi
          python3 scripts/ci/verify_ci_source.py "${args[@]}" --output "$RUNNER_TEMP/original-large-state-observations/source-after.json"
      -
        "name": "Retain actual successes and failures"
        "if": "always()"
        "uses": "actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02"
        "with":
          "name": "original-large-state-${{ matrix.runner }}-${{ matrix.source }}-${{ matrix.build_profile }}-${{ github.event.pull_request.head.sha }}-${{ github.run_attempt }}"
          "path": "${{ runner.temp }}/original-large-state-observations/"
          "if-no-files-found": "error"
          "retention-days": 30

3167d5b6a04a72bc7b5b0b8b9bc2e07ccbf55567 blob 2415
name: PoN original quarter-core feasibility evidence
on:
  pull_request:
    paths:
      - scripts/ci/host_budget_feasibility.py
      - scripts/ci/pq_source_reader.py
      - scripts/ci/test_host_budget_feasibility.py
      - evidence/pon-original-host-cost-20261110/host-phase-summary.json
      - .github/workflows/pon-original-quarter-core-feasibility.yml
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: pon-original-quarter-core-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: false
jobs:
  source-head-observation:
    runs-on: ubuntu-24.04
    timeout-minutes: 10
    env:
      EXPECTED_HEAD: ${{ github.event.pull_request.head.sha || github.sha }}
      PYTHONDONTWRITEBYTECODE: "1"
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ env.EXPECTED_HEAD }}
          persist-credentials: false
      - name: Bind original source and run strict accounting tests
        shell: bash
        run: |
          set -euo pipefail
          test "$(git rev-parse HEAD)" = "$EXPECTED_HEAD"
          test -z "$(git status --porcelain --untracked-files=all)"
          python3 -m unittest discover -s scripts/ci -p test_host_budget_feasibility.py -v
          python3 scripts/ci/host_budget_feasibility.py \
            --source evidence/pon-original-host-cost-20261110/host-phase-summary.json \
            --output "$RUNNER_TEMP/quarter-core-observations.json"
          python3 - "$RUNNER_TEMP/quarter-core-observations.json" <<'PY'
          import json, sys
          o=json.load(open(sys.argv[1]))
          assert o["original_runs"] == 3 and o["original_phases"] == 9
          assert not o["all_original_phase_gates_met"] and not o["production_qualified"]
          assert len(o["rows"]) == 9 and all(not x["original_phase_accepted"] for x in o["rows"])
          PY
          test "$(git rev-parse HEAD)" = "$EXPECTED_HEAD"
          test -z "$(git status --porcelain --untracked-files=all)"
      - name: Retain derived accounting with original failure label
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: pon-original-quarter-core-failure-accounting-${{ env.EXPECTED_HEAD }}
          path: ${{ runner.temp }}/quarter-core-observations.json
          if-no-files-found: warn
          retention-days: 30

5092acc212fd3429d607276a53f0b7d7097e774e blob 29900
# Additional exact-source observation lane. The existing release and required runtime workflows remain unchanged.
# Build the full original workspace graph; execute original CPU tests and selected semantic controls.
# No profile, feature, CPU-budget, service-lifetime or cgroup policy override is introduced.
name: PoN original workspace test-profile CPU acceptance
'on':
  pull_request: {}
permissions:
  contents: read
concurrency:
  group: pon-original-workspace-test-cpu-${{ github.ref }}
  cancel-in-progress: false
env:
  CI: 'true'
  CARGO_INCREMENTAL: '0'
  CARGO_BUILD_JOBS: '2'
  RUST_TEST_THREADS: '1'
  PYTHONDONTWRITEBYTECODE: '1'
jobs:
  original-workspace-state-and-exit:
    name: original workspace test CPU (${{ matrix.runner }}, ${{ matrix.source }})
    runs-on: ${{ matrix.runner }}
    timeout-minutes: 180
    strategy:
      fail-fast: false
      matrix:
        runner:
        - ubuntu-24.04
        - ubuntu-24.04-arm
        source:
        - head
        - prospective-merge
    env:
      EXPECTED_HEAD: ${{ github.event.pull_request.head.sha }}
      EXPECTED_BASE: ${{ github.event.pull_request.base.sha }}
      EXPECTED_MERGE: ${{ github.sha }}
      SOURCE_KIND: ${{ matrix.source }}
    steps:
    - name: Checkout the exact candidate or actual target merge
      uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
      with:
        ref: ${{ matrix.source == 'head' && github.event.pull_request.head.sha || github.sha }}
        fetch-depth: 0
        persist-credentials: false
    - name: Verify unchanged source and original project boundary
      id: source
      shell: bash
      run: |-
        set -euo pipefail
        export TRNM_CI_RECEIPT_DIR="$RUNNER_TEMP/original-workspace-test-cpu-observations"
        mkdir -p "$TRNM_CI_RECEIPT_DIR"
        printf 'TRNM_CI_RECEIPT_DIR=%s\n' "$TRNM_CI_RECEIPT_DIR" >> "$GITHUB_ENV"
        printf 'CARGO_HOME=%s/cargo-original-workspace-test-cpu\n' "$RUNNER_TEMP" >> "$GITHUB_ENV"
        printf 'CARGO_TARGET_DIR=%s/target-original-workspace-test-cpu\n' "$RUNNER_TEMP" >> "$GITHUB_ENV"
        args=(--kind "$SOURCE_KIND" --expected-head "$EXPECTED_HEAD")
        if [ "$SOURCE_KIND" = prospective-merge ]; then
          args+=(--expected-base "$EXPECTED_BASE" --expected-merge "$EXPECTED_MERGE")
        fi
        python3 scripts/ci/verify_ci_source.py "${args[@]}" --output "$TRNM_CI_RECEIPT_DIR/source-before.json"
        bash scripts/project-preflight.sh --audit
        python3 scripts/ci/test_authenticated_suite_count.py
    - name: Install the source-pinned native toolchain
      id: toolchain
      run: rustup toolchain install 1.95.0 --profile minimal --component rustfmt --component clippy
    - name: Prepare the original pinned OpenSSL 3.5.9 PQ provider
      id: pq_provider
      shell: bash
      run: bash scripts/ci/prepare_pq_provider.sh
    - name: Build the original complete workspace in the unchanged test profile
      id: build
      shell: bash
      run: |
        set -euo pipefail
        rustc +1.95.0 -Vv > "$TRNM_CI_RECEIPT_DIR/rustc.txt"
        cargo +1.95.0 -V > "$TRNM_CI_RECEIPT_DIR/cargo.txt"
        rustup which --toolchain 1.95.0 rustc > "$TRNM_CI_RECEIPT_DIR/rustc-path.txt"
        uname -a > "$TRNM_CI_RECEIPT_DIR/host.txt"
        df -h "$RUNNER_TEMP" > "$TRNM_CI_RECEIPT_DIR/build-space-before.txt"
        set +e
        python3 - > "$TRNM_CI_RECEIPT_DIR/build-input-check.stdout" 2> "$TRNM_CI_RECEIPT_DIR/build-input-check.stderr" <<'PYENV'
        import json, os, tomllib
        from pathlib import Path
        root = Path(os.environ["TRNM_CI_RECEIPT_DIR"])
        workspace = Path(os.environ["GITHUB_WORKSPACE"])
        common_keys = ("CI", "CARGO_HOME", "CARGO_TARGET_DIR", "CARGO_BUILD_JOBS",
                       "CARGO_INCREMENTAL", "RUST_TEST_THREADS")
        overrides = ("RUSTFLAGS", "CARGO_ENCODED_RUSTFLAGS", "RUSTC_WRAPPER",
                     "RUSTC_WORKSPACE_WRAPPER", "RUSTC", "RUSTC_BOOTSTRAP", "RUSTDOC",
                     "RUSTDOCFLAGS", "CARGO_ENCODED_RUSTDOCFLAGS", "CARGO_BUILD_RUSTC",
                     "CARGO_BUILD_RUSTDOC", "CARGO_BUILD_RUSTFLAGS", "CARGO_BUILD_TARGET",
                     "CARGO_BUILD_RUSTC_WRAPPER", "CARGO_BUILD_RUSTC_WORKSPACE_WRAPPER")
        provider_keys = ("OPENSSL_DIR", "OPENSSL_STATIC", "OPENSSL_CONF", "OPENSSL_MODULES",
                         "TRNM_PQ_OPENSSL", "TRNM_PQ_OPENSSL_SHA256", "TRNM_PQ_OPENSSL_VERSION")
        env = {key: os.environ.get(key) for key in common_keys + overrides + provider_keys}
        env.update({key: value for key, value in os.environ.items()
                    if key.startswith("CARGO_PROFILE_") or
                    (key.startswith("CARGO_TARGET_") and
                     key.endswith(("_RUSTFLAGS", "_LINKER", "_RUNNER")))})
        command = ["cargo", "+1.95.0", "test", "--locked", "--manifest-path",
                   "trillionnium/Cargo.toml", "--workspace", "--all-targets", "--all-features",
                   "--no-run", "--message-format=json"]
        manifest = tomllib.loads((workspace / "trillionnium/Cargo.toml").read_text())
        test_packages = manifest["profile"]["test"]["package"]
        (root / "build-command.json").write_text(json.dumps({
            "argv": command, "environment": env,
            "process_measurement_wrapper": ["/usr/bin/time", "-v"],
            "rustc_selected_by_rustup": (root / "rustc-path.txt").read_text().strip(),
            "test_profile_packages": {name: test_packages[name]
                for name in ("trnm-pon-node", "trnm-mvcc-fee")},
            "scope": "complete workspace test-profile build; only the named selectors run below"
        }, indent=2) + "\n")
        assert not any(env.get(key) for key in overrides), "unexpected compiler override"
        assert not any(key.startswith("CARGO_PROFILE_") for key in env), "unexpected profile override"
        assert not any(value for key, value in env.items() if key.startswith("CARGO_TARGET_")
                       and key.endswith(("_RUSTFLAGS", "_LINKER", "_RUNNER"))), "unexpected target override"
        for name, opt in (("trnm-pon-node", 3), ("trnm-mvcc-fee", 1)):
            profile = test_packages[name]
            assert profile["opt-level"] == opt
            assert profile["debug-assertions"] is True and profile["overflow-checks"] is True
        provider = json.loads((root / "pq-provider/provider.json").read_text())
        assert provider["result"] == "PREPARED_AND_SMOKE_VERIFIED" and provider["exit_code"] == 0
        assert env["OPENSSL_STATIC"] == "1" and env["TRNM_PQ_OPENSSL_VERSION"] == "3.5.9"
        PYENV
        input_reader=$?
        set -e
        printf '%s\n' "$input_reader" > "$TRNM_CI_RECEIPT_DIR/build-input-check.exit"
        if [ "$input_reader" -ne 0 ]; then
          exit "$input_reader"
        fi
        set +e
        /usr/bin/time -v -o "$TRNM_CI_RECEIPT_DIR/build.resources.txt" cargo +1.95.0 test --locked --manifest-path trillionnium/Cargo.toml --workspace --all-targets --all-features --no-run --message-format=json > "$TRNM_CI_RECEIPT_DIR/build.jsonl" 2> "$TRNM_CI_RECEIPT_DIR/build.stderr"
        build_exit=$?
        printf '%s\n' "$build_exit" > "$TRNM_CI_RECEIPT_DIR/build.exit"
        df -h "$RUNNER_TEMP" > "$TRNM_CI_RECEIPT_DIR/build-space-after.txt"
        set -e
        if [ "$build_exit" -ne 0 ]; then
          exit "$build_exit"
        fi
        set +e
        python3 - > "$TRNM_CI_RECEIPT_DIR/build-artifact-check.json" 2> "$TRNM_CI_RECEIPT_DIR/build-artifact-check.stderr" <<'PYART'
        import hashlib, json, os
        from pathlib import Path
        root = Path(os.environ["TRNM_CI_RECEIPT_DIR"])
        workspace = Path(os.environ["GITHUB_WORKSPACE"]).resolve()
        rows = [json.loads(line) for line in (root / "build.jsonl").read_text().splitlines() if line.strip()]
        finished = [row for row in rows if row.get("reason") == "build-finished"]
        assert len(finished) == 1 and finished[0]["success"] is True
        expected_features = {
            "trnm-pon-node": ["default", "pq-native-openssl", "pq-root-v3"],
            "trnm-mvcc-fee": ["default", "pq-native-openssl"],
        }
        selected = {}
        for crate, target, opt in (("trnm-pon-node", "trnm_pon_node", "3"),
                                   ("trnm-mvcc-fee", "trnm_mvcc_fee", "1")):
            artifacts = [row for row in rows if row.get("reason") == "compiler-artifact"
                         and row.get("target", {}).get("name") == target
                         and row.get("target", {}).get("kind") == ["lib"]]
            assert artifacts, "missing library artifacts for " + crate
            for artifact in artifacts:
                assert Path(artifact["target"]["src_path"]).resolve() == workspace / "trillionnium/crates" / crate / "src/lib.rs"
                profile = artifact["profile"]
                assert profile["opt_level"] == opt, "wrong original test optimization for " + crate
                assert profile["debug_assertions"] is True and profile["overflow_checks"] is True, "test checks disabled for " + crate
                assert artifact["features"] == expected_features[crate], "wrong complete-workspace features for " + crate
            selected[crate] = artifacts
        # Inspect M06's ordinary rlib used as a dependency, not just its separate test executable.
        m06_dependencies = [row for row in selected["trnm-mvcc-fee"]
                            if row["profile"]["test"] is False
                            and any(Path(name).suffix == ".rlib" for name in row["filenames"])]
        assert len(m06_dependencies) == 1, "expected one M06 dependency artifact"
        node_tests = [row for row in selected["trnm-pon-node"]
                      if row["profile"]["test"] is True and row.get("executable")]
        assert len(node_tests) == 1, "expected one native Node library test executable"
        artifact = node_tests[0]
        binary = Path(artifact["executable"])
        target = Path(os.environ["CARGO_TARGET_DIR"]).resolve()
        assert binary.is_absolute() and binary.is_file() and not binary.is_symlink()
        assert binary.resolve().parent == target / "debug/deps", "unexpected executable profile/target directory"
        with binary.open("rb") as stream:
            assert stream.read(4) == b"\x7fELF"
            stream.seek(0)
            digest = hashlib.file_digest(stream, "sha256").hexdigest()
        (root / "binary.json").write_text(json.dumps({
            "artifact": artifact, "sha256": digest,
            "profile_evidence": selected,
            "scope": "original test-profile CPU-policy selectors and native reactor-exit controls; not the complete runtime suite"
        }, indent=2) + "\n")
        (root / "binary.sha256").write_text(digest + "  " + str(binary) + "\n")
        (root / "binary.txt").write_text(str(binary) + "\n")
        m06_tests = [row for row in selected["trnm-mvcc-fee"]
                     if row["profile"]["test"] is True and row.get("executable")]
        assert len(m06_tests) == 1, "expected one M06 library test executable"
        m06_artifact = m06_tests[0]
        m06_binary = Path(m06_artifact["executable"])
        assert m06_binary.is_absolute() and m06_binary.is_file() and not m06_binary.is_symlink()
        assert m06_binary.resolve().parent == target / "debug/deps", "unexpected M06 executable profile/target directory"
        assert m06_binary.resolve() != binary.resolve(), "Node and M06 test executables must be distinct"
        with m06_binary.open("rb") as stream:
            assert stream.read(4) == b"\x7fELF"
            stream.seek(0)
            m06_digest = hashlib.file_digest(stream, "sha256").hexdigest()
        (root / "m06-binary.json").write_text(json.dumps({
            "artifact": m06_artifact, "sha256": m06_digest,
            "dependency_artifact": m06_dependencies[0],
            "package_cwd": str(workspace / "trillionnium/crates/trnm-mvcc-fee"),
            "scope": "selected M06 semantic controls from the same original complete workspace build; not the complete M06/runtime suite"
        }, indent=2) + "\n")
        (root / "m06-binary.sha256").write_text(m06_digest + "  " + str(m06_binary) + "\n")
        (root / "m06-binary.txt").write_text(str(m06_binary) + "\n")
        print(json.dumps({"result": "PASS", "scope": "build profiles, feature sets and ELF identity only",
                          "node_opt_level": "3", "m06_opt_level": "1", "debug_assertions": True,
                          "overflow_checks": True, "features_by_crate": expected_features,
                          "binary_sha256": digest, "m06_binary_sha256": m06_digest}, sort_keys=True))
        PYART
        artifact_reader=$?
        set -e
        printf '%s\n' "$artifact_reader" > "$TRNM_CI_RECEIPT_DIR/build-artifact-check.exit"
        exit "$artifact_reader"
    - name: Execute both original test-profile CPU selectors and reactor-exit controls
      if: ${{ !cancelled() && steps.source.outcome == 'success' && steps.toolchain.outcome == 'success' && steps.pq_provider.outcome == 'success' && steps.build.outcome == 'success' }}
      shell: bash
      run: |-
        set -euo pipefail
        binary="$(cat "$TRNM_CI_RECEIPT_DIR/binary.txt")"
        sha256sum "$binary" > "$TRNM_CI_RECEIPT_DIR/binary-before.sha256"
        set +e
        sha256sum -c "$TRNM_CI_RECEIPT_DIR/binary.sha256" > "$TRNM_CI_RECEIPT_DIR/binary-before.log" 2>&1
        binary_check=$?
        set -e
        printf '%s\n' "$binary_check" > "$TRNM_CI_RECEIPT_DIR/binary-before.exit"
        if [ "$binary_check" -ne 0 ]; then
          exit "$binary_check"
        fi
        cd "$GITHUB_WORKSPACE/trillionnium/crates/trnm-pon-node"
        pwd > "$TRNM_CI_RECEIPT_DIR/test-cwd.txt"
        status=0
        printf 'selector\tnative_exit\tlog_exit\treader_exit\n' > "$TRNM_CI_RECEIPT_DIR/test-exits.tsv"
        for selector in \
          store::detached_admission::tests::admitted_custom_genesis_over_eight_mib_keeps_original_held_schedule_and_cpu_owner \
          store::detached_admission::tests::authenticated_large_parent_original_schedule_supplementary_denominator \
          ingress::public_v2::tests::public_loop_exit_records_lifetime_before_internal_stop \
          ingress::public_v2::tests::public_loop_exit_records_external_stop_after_signed_read; do
          name="${selector##*::}"
          log="$TRNM_CI_RECEIPT_DIR/$name.log"
          set +e
          /usr/bin/time -v -o "$TRNM_CI_RECEIPT_DIR/$name.resources.txt" "$binary" "$selector" --exact --nocapture --test-threads=1 2>&1 | tee "$log"
          codes=("${PIPESTATUS[@]}")
          python3 "$GITHUB_WORKSPACE/scripts/ci/check_required_native_test.py" "$log" --test "$selector" > "$TRNM_CI_RECEIPT_DIR/$name.execution.json" 2> "$TRNM_CI_RECEIPT_DIR/$name.execution.stderr"
          reader=$?
          set -e
          printf '%s\t%s\t%s\t%s\n' "$selector" "${codes[0]}" "${codes[1]}" "$reader" >> "$TRNM_CI_RECEIPT_DIR/test-exits.tsv"
          if [ "${codes[0]}" -ne 0 ] || [ "${codes[1]}" -ne 0 ] || [ "$reader" -ne 0 ]; then
            status=1
          fi
        done
        printf '%s\n' "$status" > "$TRNM_CI_RECEIPT_DIR/test-step.exit"
        exit "$status"
      id: native_tests
    - name: Execute selected arithmetic canonical and reorg semantic controls
      id: semantic_controls
      if: ${{ !cancelled() && steps.build.outcome == 'success' }}
      shell: bash
      run: |
        set -euo pipefail
        controls="$TRNM_CI_RECEIPT_DIR/semantic-controls"
        mkdir -p "$controls"
        node_binary="$(cat "$TRNM_CI_RECEIPT_DIR/binary.txt")"
        m06_binary="$(cat "$TRNM_CI_RECEIPT_DIR/m06-binary.txt")"
        status=0
        printf 'crate\treader_exit\n' > "$controls/elf-before-exits.tsv"
        for crate in node m06; do
          if [ "$crate" = node ]; then
            binary="$node_binary"
            receipt=binary
          else
            binary="$m06_binary"
            receipt=m06-binary
          fi
          sha256sum "$binary" > "$controls/$crate-binary-before.sha256"
          set +e
          sha256sum -c "$TRNM_CI_RECEIPT_DIR/$receipt.sha256" > "$controls/$crate-binary-before.log" 2>&1
          reader=$?
          set -e
          printf '%s\t%s\n' "$crate" "$reader" >> "$controls/elf-before-exits.tsv"
          if [ "$reader" -ne 0 ]; then status=1; fi
        done
        if [ "$status" -ne 0 ]; then
          printf '%s\n' "$status" > "$controls/semantic-step.exit"
          exit "$status"
        fi
        printf 'crate\tnative_exit\tlog_exit\n' > "$controls/registry-exits.tsv"
        for crate in m06 node; do
          if [ "$crate" = m06 ]; then
            binary="$m06_binary"
            cd "$GITHUB_WORKSPACE/trillionnium/crates/trnm-mvcc-fee"
          else
            binary="$node_binary"
            cd "$GITHUB_WORKSPACE/trillionnium/crates/trnm-pon-node"
          fi
          pwd > "$controls/$crate-cwd.txt"
          set +e
          "$binary" --list --format terse 2>&1 | tee "$controls/$crate-registry.log"
          codes=("${PIPESTATUS[@]}")
          set -e
          printf '%s\t%s\t%s\n' "$crate" "${codes[0]}" "${codes[1]}" >> "$controls/registry-exits.tsv"
          if [ "${codes[0]}" -ne 0 ] || [ "${codes[1]}" -ne 0 ]; then status=1; fi
        done
        set +e
        python3 - > "$controls/registry-check.json" 2> "$controls/registry-check.stderr" <<'PYREGISTRY'
        import json, os, re
        from pathlib import Path
        root = Path(os.environ["TRNM_CI_RECEIPT_DIR"]) / "semantic-controls"
        registries = {}
        for crate in ("m06", "node"):
            names = []
            for line in (root / f"{crate}-registry.log").read_text().splitlines():
                match = re.fullmatch(r"([A-Za-z_][A-Za-z0-9_:]*): test", line)
                if match:
                    names.append(match[1])
            assert names and len(names) == len(set(names)), "empty or duplicate libtest registry: " + crate
            registries[crate] = set(names)
        selected = []
        groups = []
        def prefix(crate, group, name, count):
            names = sorted(test for test in registries[crate] if test.startswith(name))
            assert len(names) == count, f"{group}: expected {count} actual registered controls, got {len(names)}"
            groups.append({"crate": crate, "group": group, "prefix": name, "expected_count": count, "tests": names})
            selected.extend((crate, group, test) for test in names)
        def exact(crate, group, names):
            assert names and len(names) == len(set(names))
            assert all(test in registries[crate] for test in names), "missing exact control: " + group
            groups.append({"crate": crate, "group": group, "expected_count": len(names), "tests": names})
            selected.extend((crate, group, test) for test in names)
        prefix("m06", "full-root-arithmetic", "pon_commitment::full_root_arithmetic_tests::", 5)
        exact("m06", "unchanged-canonical-map", [
            "pon_commitment::unchanged_snapshot_tests::unchanged_snapshot_shares_only_after_full_actual_bytes_match",
            "pon_commitment::unchanged_snapshot_tests::unchanged_snapshot_retains_exact_capacity_charges_and_all_budget_boundaries",
            "pon_commitment::unchanged_snapshot_tests::unchanged_snapshot_misleading_root_and_changed_bytes_take_original_repair_path",
            "pon_commitment::unchanged_snapshot_tests::unchanged_snapshot_keeps_late_canonical_errors_before_wire_and_cache_limits",
            "pon_commitment::unchanged_snapshot_tests::unchanged_candidate_early_miss_retains_complete_late_validation",
            "pon_commitment::unchanged_snapshot_tests::unchanged_snapshot_empty_delta_still_checks_the_original_tree_root",
        ])
        exact("node", "account-root-digest", [
            "account_archive_prototype::native_root_digest::tests::native_root_digest_matches_record_and_sparse_references_after_exact_input_changes",
            "account_archive_prototype::native_root_digest::tests::native_root_digest_keeps_original_traversal_cancellation_and_collision_order",
            "account_archive_prototype::native_root_digest::tests::native_root_digest_keeps_fork_shape_and_all_lift_input_relations",
        ])
        exact("node", "growth-return-observations", [
            "store::growth::tests::scale_observation::native_growth_scale_retains_rejected_and_cancelled_admission_returns",
            "store::growth::tests::scale_observation::native_growth_scale_retains_admission_when_activation_returns_error",
        ])
        exact("m06", "canonical-ascii", [
            "pon_executor::root_arithmetic_tests::canonical_ascii_guard_matches_exhaustive_bytes_pairs_and_borrow_chains",
            "pon_executor::root_arithmetic_tests::canonical_ascii_keeps_original_serde_bytes_and_vec_capacities",
            "pon_executor::root_arithmetic_tests::canonical_ascii_into_keeps_reused_capacity_and_failed_input_untouched",
            "pon_executor::root_arithmetic_tests::canonical_ascii_commitment_keeps_late_grammar_before_wire_and_cache_errors",
            "pon_executor::root_arithmetic_tests::arithmetic_root_ascii_encoding_matches_independent_serde_reference",
            "pon_executor::root_arithmetic_tests::arithmetic_root_preserves_complete_grammar_before_all_wire_limits",
            "pon_commitment::bounded_encoding_tests::canonical_ascii_fast_encoding_keeps_direct_serde_budget_decisions_and_charges",
        ])
        prefix("node", "reorg-tail", "store::reorg_readback_tests::", 6)
        exact("node", "direct-append-readback", [
            "store::append_readback_tests::direct_append_keeps_complete_rows_events_state_and_cold_reopen",
            "store::append_readback_tests::direct_append_cancellation_at_each_callback_leaves_no_partial_publication",
        ])
        exact("node", "current-sql-root", [
            "store::detached_admission::tests::large_parent_root_arithmetic_keeps_current_sql_and_original_read_checkpoints",
        ])
        exact("node", "prepared-current-history", [
            "store::historical_commitment_tests::legacy_prepared_history_reads_observe_current_rows_writes_and_rollback",
            "store::historical_commitment_tests::legacy_prepared_history_reads_reprepare_after_schema_and_authorizer_changes",
            "store::historical_commitment_tests::actual_foreign_snapshot_delta_and_root_damage_preserve_original_failures",
        ])
        prefix("node", "postwrite-readback", "store::native_authenticated::post_write_readback::tests::", 25)
        assert len({(crate, test) for crate, group, test in selected}) == len(selected)
        (root / "selected-tests.tsv").write_text("".join(f"{crate}\t{group}\t{test}\n" for crate, group, test in selected))
        print(json.dumps({"result": "PASS", "scope": "exact libtest registry selection only; no execution verdict and not the complete runtime suite",
                          "registry_counts": {crate: len(names) for crate, names in registries.items()},
                          "selected_count": len(selected), "groups": groups}, indent=2))
        PYREGISTRY
        reader=$?
        set -e
        printf '%s\n' "$reader" > "$controls/registry-check.exit"
        if [ "$reader" -ne 0 ]; then status=1; fi
        if [ "$status" -ne 0 ]; then
          printf '%s\n' "$status" > "$controls/semantic-step.exit"
          exit "$status"
        fi
        printf 'crate\tgroup\tselector\tnative_exit\tlog_exit\treader_exit\n' > "$controls/test-exits.tsv"
        expected_count="$(wc -l < "$controls/selected-tests.tsv")"
        index=0
        while IFS=$'\t' read -r crate group selector; do
          if [ "$crate" = m06 ]; then
            binary="$m06_binary"
            cd "$GITHUB_WORKSPACE/trillionnium/crates/trnm-mvcc-fee"
          elif [ "$crate" = node ]; then
            binary="$node_binary"
            cd "$GITHUB_WORKSPACE/trillionnium/crates/trnm-pon-node"
          else
            printf 'unknown selected crate: %s\n' "$crate" >&2
            exit 1
          fi
          index=$((index + 1))
          name="$(printf '%02d-%s-%s' "$index" "$crate" "${selector##*::}")"
          log="$controls/$name.log"
          pwd > "$controls/$name.cwd.txt"
          set +e
          /usr/bin/time -v -o "$controls/$name.resources.txt" "$binary" "$selector" --exact --nocapture --test-threads=1 < /dev/null 2>&1 | tee "$log"
          codes=("${PIPESTATUS[@]}")
          python3 "$GITHUB_WORKSPACE/scripts/ci/check_required_native_test.py" "$log" --test "$selector" > "$controls/$name.execution.json" 2> "$controls/$name.execution.stderr"
          reader=$?
          set -e
          printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$crate" "$group" "$selector" "${codes[0]}" "${codes[1]}" "$reader" >> "$controls/test-exits.tsv"
          if [ "${codes[0]}" -ne 0 ] || [ "${codes[1]}" -ne 0 ] || [ "$reader" -ne 0 ]; then status=1; fi
        done < "$controls/selected-tests.tsv"
        if [ "$index" -eq 0 ] || [ "$index" -ne "$expected_count" ]; then status=1; fi
        printf '%s\n' "$index" > "$controls/executed-selector-count.txt"
        printf '%s\n' "$status" > "$controls/semantic-step.exit"
        exit "$status"
    - name: Observe fixed touched owners across actual account and history growth
      id: growth_scale
      if: ${{ !cancelled() && steps.build.outcome == 'success' }}
      shell: bash
      run: |
        set -euo pipefail
        # Reuse the exact complete-workspace artifact already validated above.
        # The original CPU selectors remain required even when this observation passes.
        binary="$(cat "$TRNM_CI_RECEIPT_DIR/binary.txt")"
        sha256sum -c "$TRNM_CI_RECEIPT_DIR/binary.sha256"
        python3 -m unittest discover -s "$GITHUB_WORKSPACE/scripts/ci" -p test_growth_scale_observation.py -v > "$TRNM_CI_RECEIPT_DIR/growth-scale.reader-controls.log" 2>&1
        selector=store::growth::tests::scale_observation::native_growth_v2_fixed_owner_account_history_scale_observation
        export TRNM_GROWTH_SCALE_OBSERVATION_DIR="$TRNM_CI_RECEIPT_DIR/growth-scale"
        cd "$GITHUB_WORKSPACE/trillionnium/crates/trnm-pon-node"
        set +e
        /usr/bin/time -v -o "$TRNM_CI_RECEIPT_DIR/growth-scale.resources.txt" "$binary" "$selector" --exact --ignored --nocapture --test-threads=1 < /dev/null > "$TRNM_CI_RECEIPT_DIR/growth-scale.log" 2>&1
        native_exit=$?
        python3 "$GITHUB_WORKSPACE/scripts/ci/check_required_native_test.py" "$TRNM_CI_RECEIPT_DIR/growth-scale.log" --test "$selector" > "$TRNM_CI_RECEIPT_DIR/growth-scale.execution.json" 2> "$TRNM_CI_RECEIPT_DIR/growth-scale.execution.stderr"
        execution_reader=$?
        python3 "$GITHUB_WORKSPACE/scripts/ci/check_growth_scale_observation.py" "$TRNM_GROWTH_SCALE_OBSERVATION_DIR" > "$TRNM_CI_RECEIPT_DIR/growth-scale.readback.json" 2> "$TRNM_CI_RECEIPT_DIR/growth-scale.readback.stderr"
        observation_reader=$?
        sha256sum -c "$TRNM_CI_RECEIPT_DIR/binary.sha256" > "$TRNM_CI_RECEIPT_DIR/growth-scale.binary-after.log" 2>&1
        binary_reader=$?
        set -e
        printf 'native_exit=%s\nexecution_reader=%s\nobservation_reader=%s\nbinary_reader=%s\n' "$native_exit" "$execution_reader" "$observation_reader" "$binary_reader" > "$TRNM_CI_RECEIPT_DIR/growth-scale.exits.txt"
        # Emit the bounded reader result for direct readback; retain all raw files
        # and the four original exit checks, including refused observations.
        cat "$TRNM_CI_RECEIPT_DIR/growth-scale.readback.json"
        test "$native_exit" -eq 0 && test "$execution_reader" -eq 0 && test "$observation_reader" -eq 0 && test "$binary_reader" -eq 0
    - name: Recheck the same test ELF after success or failure
      if: ${{ always() && steps.build.outcome == 'success' }}
      shell: bash
      run: |
        set -euo pipefail
        binary="$(cat "$TRNM_CI_RECEIPT_DIR/binary.txt")"
        sha256sum "$binary" > "$TRNM_CI_RECEIPT_DIR/binary-after.sha256"
        set +e
        sha256sum -c "$TRNM_CI_RECEIPT_DIR/binary.sha256" > "$TRNM_CI_RECEIPT_DIR/binary-after.log" 2>&1
        binary_check=$?
        set -e
        printf '%s\n' "$binary_check" > "$TRNM_CI_RECEIPT_DIR/binary-after.exit"
        exit "$binary_check"
    - name: Recheck the same M06 test ELF after success or failure
      if: ${{ always() && steps.build.outcome == 'success' }}
      shell: bash
      run: |
        set -euo pipefail
        binary="$(cat "$TRNM_CI_RECEIPT_DIR/m06-binary.txt")"
        sha256sum "$binary" > "$TRNM_CI_RECEIPT_DIR/m06-binary-after.sha256"
        set +e
        sha256sum -c "$TRNM_CI_RECEIPT_DIR/m06-binary.sha256" > "$TRNM_CI_RECEIPT_DIR/m06-binary-after.log" 2>&1
        binary_check=$?
        set -e
        printf '%s\n' "$binary_check" > "$TRNM_CI_RECEIPT_DIR/m06-binary-after.exit"
        exit "$binary_check"
    - name: Reverify exact source after every outcome
      if: always()
      shell: bash
      run: |-
        set -euo pipefail
        args=(--kind "$SOURCE_KIND" --expected-head "$EXPECTED_HEAD")
        if [ "$SOURCE_KIND" = prospective-merge ]; then
          args+=(--expected-base "$EXPECTED_BASE" --expected-merge "$EXPECTED_MERGE")
        fi
        python3 scripts/ci/verify_ci_source.py "${args[@]}" --output "$RUNNER_TEMP/original-workspace-test-cpu-observations/source-after.json"
    - name: Retain actual successes and failures
      if: always()
      uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
      with:
        name: original-workspace-test-cpu-${{ matrix.runner }}-${{ matrix.source }}-${{ github.event.pull_request.head.sha }}-${{ github.run_attempt }}
        path: ${{ runner.temp }}/original-workspace-test-cpu-observations/
        if-no-files-found: error
        retention-days: 30

3ed5bff6e3ec2a9451cd3834289a5d83b59eb4f5 blob 12058
name: PoN owned process cleanup
on:
  pull_request:
    paths:
      - formal/pon-nakamoto-v1/**
      - scripts/**
      - .github/workflows/pon-owned-process-cleanup.yml
permissions:
  contents: read
jobs:
  aggregate-owner-controls:
    strategy:
      fail-fast: false
      matrix:
        lane: [head, prospective-merge]
    runs-on: ubuntu-24.04
    timeout-minutes: 10
    env:
      SOURCE_SHA: ${{ github.event.pull_request.head.sha }}
      BASE_SHA: ${{ github.event.pull_request.base.sha }}
      TESTED_SHA: ${{ matrix.lane == 'head' && github.event.pull_request.head.sha || github.sha }}
      TEST_LANE: ${{ matrix.lane }}
      PYTHONDONTWRITEBYTECODE: "1"
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
        with:
          ref: ${{ env.TESTED_SHA }}
          fetch-depth: 0
          persist-credentials: false
      - uses: actions/setup-python@a309ff8b426b58ec0e2a45f0f869d46889d02405
        with:
          python-version: "3.12.3"
      - name: Verify actual source and original native ABI
        id: identity
        shell: bash
        run: |
          set -euo pipefail
          mkdir -p "$RUNNER_TEMP/aggregate-owner-controls"
          test "$(git rev-parse HEAD)" = "$TESTED_SHA"
          if test "$TEST_LANE" = head; then
            test "$TESTED_SHA" = "$SOURCE_SHA"
          else
            test "$(git show -s --format=%P HEAD)" = "$BASE_SHA $SOURCE_SHA"
            test "$(git rev-parse HEAD^{tree})" = "$(git merge-tree --write-tree "$BASE_SHA" "$SOURCE_SHA")"
          fi
          git rev-parse HEAD HEAD^{tree} > "$RUNNER_TEMP/aggregate-owner-controls/source-before.txt"
          python -c 'import sys; assert sys.implementation.name == "cpython" and sys.version_info[:3] == (3,12,3)'
          bash scripts/project-preflight.sh --audit
      - name: Execute every original aggregate owner control and charge-wait regression
        shell: bash
        run: |
          set -euo pipefail
          python - <<'PY' 2>&1 | tee "$RUNNER_TEMP/aggregate-owner-controls/tests.log"
          import importlib, json, sys, unittest
          sys.path.insert(0, 'scripts')
          rows = []
          for name, expected in [('test_llm_runtime_kernel_aggregate', 24), ('test_llm_runtime_kernel_diagnostic', 7), ('test_llm_runtime_kernel_counters', 8), ('test_llm_runtime_evidence_pipe', 20), ('test_llm_runtime_terminal_charge_wait', 7)]:
              suite = unittest.defaultTestLoader.loadTestsFromModule(importlib.import_module(name))
              if suite.countTestCases() != expected:
                  raise RuntimeError(f'{name}: expected {expected} tests, found {suite.countTestCases()}')
              result = unittest.TextTestRunner(verbosity=2).run(suite)
              passed = result.wasSuccessful() and result.testsRun == expected and not result.skipped and not result.expectedFailures
              rows.append(dict(module=name, executed=result.testsRun, skipped=len(result.skipped), expected_failures=len(result.expectedFailures), passed=passed))
          print(json.dumps(dict(scope='ordinary native owner with synthetic cgroup counters; no real aggregate/model/resource retirement qualification', results=rows)))
          raise SystemExit(0 if all(row['passed'] for row in rows) else 1)
          PY
      - name: Exercise fresh host namespace contract without creating a native scope
        shell: bash
        run: |
          set -euo pipefail
          python - <<'PY' 2>&1 | tee "$RUNNER_TEMP/aggregate-owner-controls/host-namespace-contract.log"
          import importlib, json, sys, unittest
          sys.path.insert(0, 'scripts')
          suite = unittest.defaultTestLoader.loadTestsFromModule(importlib.import_module('test_llm_runtime_host_scope'))
          if suite.countTestCases() != 29:
              raise RuntimeError('fresh host contract requires all 29 controls')
          result = unittest.TextTestRunner(verbosity=2).run(suite)
          passed = result.wasSuccessful() and result.testsRun == 29 and not result.skipped and not result.expectedFailures
          print(json.dumps(dict(scope='ordinary FD and bounded transport; native scope admission NOT_RUN', executed=result.testsRun, skipped=len(result.skipped), passed=passed)))
          raise SystemExit(0 if passed else 1)
          PY
      - name: Exercise same-owner child preparation without native cgroup effects
        shell: bash
        run: |
          set -euo pipefail
          python - <<'PY' 2>&1 | tee "$RUNNER_TEMP/aggregate-owner-controls/host-child-preparation.log"
          import importlib, json, sys, unittest
          sys.path.insert(0, 'scripts')
          suite = unittest.defaultTestLoader.loadTestsFromModule(importlib.import_module('test_llm_runtime_host_children'))
          if suite.countTestCases() != 9:
              raise RuntimeError('child preparation requires all 9 new controls')
          result = unittest.TextTestRunner(verbosity=2).run(suite)
          passed = result.wasSuccessful() and result.testsRun == 9 and not result.skipped and not result.expectedFailures
          print(json.dumps(dict(scope='ordinary FD and mock manager; native child preparation/birth NOT_RUN', executed=result.testsRun, skipped=len(result.skipped), passed=passed)))
          raise SystemExit(0 if passed else 1)
          PY
      - name: Exercise original native handoff and private host controller mechanics
        shell: bash
        run: |
          set -euo pipefail
          python - <<'PY' 2>&1 | tee "$RUNNER_TEMP/aggregate-owner-controls/host-controller-mechanics.log"
          import importlib, json, sys, unittest
          sys.path.insert(0, 'scripts')
          rows = []
          for name, expected in [('test_llm_runtime_kernel_owned', 16), ('test_llm_runtime_host_controller', 9), ('test_llm_runtime_host_aggregate', 17), ('test_llm_runtime_retirement_slot', 9), ('test_llm_runtime_retirement_publication', 4), ('test_llm_runtime_retirement_activation', 10), ('test_llm_runtime_host_retirement', 7), ('test_llm_runtime_retirement_steps', 4), ('test_llm_runtime_host_u_readback', 15)]:
              suite = unittest.defaultTestLoader.loadTestsFromModule(importlib.import_module(name))
              if suite.countTestCases() != expected:
                  raise RuntimeError(f'{name}: expected {expected} controls, found {suite.countTestCases()}')
              result = unittest.TextTestRunner(verbosity=2).run(suite)
              passed = result.wasSuccessful() and result.testsRun == expected and not result.skipped and not result.expectedFailures
              rows.append(dict(module=name, executed=result.testsRun, skipped=len(result.skipped), passed=passed))
          print(json.dumps(dict(scope='original handoff and ordinary FD/private controller controls; funded native entry and whole-U return NOT_RUN', results=rows)))
          raise SystemExit(0 if all(row['passed'] for row in rows) else 1)
          PY
      - name: Preserve exact source after controls
        if: always() && steps.identity.outcome == 'success'
        shell: bash
        run: |
          set -euo pipefail
          git rev-parse HEAD HEAD^{tree} > "$RUNNER_TEMP/aggregate-owner-controls/source-after.txt"
          cmp "$RUNNER_TEMP/aggregate-owner-controls/source-before.txt" "$RUNNER_TEMP/aggregate-owner-controls/source-after.txt"
          git diff --exit-code
          git diff --cached --exit-code
          test -z "$(git status --porcelain --untracked-files=normal)"
          bash scripts/project-preflight.sh --audit
      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        if: always()
        with:
          name: aggregate-owner-controls-${{ matrix.lane }}-${{ github.run_attempt }}
          path: ${{ runner.temp }}/aggregate-owner-controls/
          if-no-files-found: error
          retention-days: 14
  cleanup:
    strategy:
      fail-fast: false
      matrix:
        runner: [ubuntu-24.04, ubuntu-24.04-arm, macos-15]
        lane: [head, prospective-merge]
    runs-on: ${{ matrix.runner }}
    timeout-minutes: 10
    env:
      SOURCE_SHA: ${{ github.event.pull_request.head.sha }}
      BASE_SHA: ${{ github.event.pull_request.base.sha }}
      TESTED_SHA: ${{ matrix.lane == 'head' && github.event.pull_request.head.sha || github.sha }}
      TEST_LANE: ${{ matrix.lane }}
      PYTHONDONTWRITEBYTECODE: "1"
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
        with:
          ref: ${{ env.TESTED_SHA }}
          fetch-depth: 0
          persist-credentials: false
      - name: Verify actual source and ordered main merge
        id: identity
        shell: bash
        run: |
          set -euo pipefail
          mkdir -p "$RUNNER_TEMP/owned-cleanup"
          test "$(git rev-parse HEAD)" = "$TESTED_SHA"
          if test "$TEST_LANE" = head; then
            test "$TESTED_SHA" = "$SOURCE_SHA"
          else
            test "$(git show -s --format=%P HEAD)" = "$BASE_SHA $SOURCE_SHA"
            test "$(git rev-parse HEAD^{tree})" = "$(git merge-tree --write-tree "$BASE_SHA" "$SOURCE_SHA")"
          fi
          git rev-parse HEAD HEAD^{tree} > "$RUNNER_TEMP/owned-cleanup/source-before.txt"
          bash scripts/project-preflight.sh --audit
      - name: Select the real GNU time observer on macOS
        if: runner.os == 'macOS'
        shell: bash
        run: |
          set -euo pipefail
          if ! brew list --versions gnu-time; then
            HOMEBREW_NO_AUTO_UPDATE=1 brew install gnu-time
          fi
          observer="$(brew --prefix gnu-time)/bin/gtime"
          test -x "$observer"
          printf 'TRNM_GNU_TIME=%s\n' "$observer" >> "$GITHUB_ENV"
          "$observer" --version > "$RUNNER_TEMP/owned-cleanup/gnu-time-version.txt"
      - name: Run complete original owners and every cleanup regression
        shell: bash
        run: |
          set -euo pipefail
          python3 - <<'PY' 2>&1 | tee "$RUNNER_TEMP/owned-cleanup/tests.log"
          import importlib, json, sys, unittest
          sys.path[:0] = ['formal/pon-nakamoto-v1', 'scripts']
          failed = False
          rows = []
          for name, expected in [('test_bounded_process', 26), ('test_bounded_process_cleanup', 12), ('test_bounded_process_darwin', 14), ('test_qualification_runtime', 32)]:
              module = importlib.import_module(name)
              suite = unittest.defaultTestLoader.loadTestsFromModule(module)
              count = suite.countTestCases()
              if count != expected:
                  raise RuntimeError(f'{name}: expected {expected} tests, found {count}')
              result = unittest.TextTestRunner(verbosity=2).run(suite)
              passed = result.wasSuccessful() and result.testsRun == expected and not result.skipped
              failed |= not passed
              rows.append(dict(module=name, executed=result.testsRun, skipped=len(result.skipped), passed=passed))
          print(json.dumps(dict(scope='local POSIX owner only; no work-hardness, independent model, power-loss or WAN acceptance', results=rows)))
          raise SystemExit(1 if failed else 0)
          PY
      - name: Preserve unchanged source and precise scope
        if: always() && steps.identity.outcome == 'success'
        shell: bash
        run: |
          set -euo pipefail
          git rev-parse HEAD HEAD^{tree} > "$RUNNER_TEMP/owned-cleanup/source-after.txt"
          cmp "$RUNNER_TEMP/owned-cleanup/source-before.txt" "$RUNNER_TEMP/owned-cleanup/source-after.txt"
          git diff --exit-code
          git diff --cached --exit-code
          test -z "$(git status --porcelain --untracked-files=normal)"
          bash scripts/project-preflight.sh --audit
      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        if: always()
        with:
          name: owned-cleanup-${{ matrix.runner }}-${{ matrix.lane }}-${{ github.run_attempt }}
          path: ${{ runner.temp }}/owned-cleanup/
          if-no-files-found: error
          retention-days: 14

75a8f1a913f7e9e3ffb2445bed11451d6cb6de1e blob 53627
name: PoN PQ network and rollback witness
on:
  pull_request:
    paths:
      - trillionnium/**
      - config/pon/pq-cross-branch-corpus-v1.json
      - config/pon/pq-system-required-tests-v1.json
      - config/pon/pq-system-supplemental-tests-v1.json
      - config/pon/pq-native-tls-required-tests-v1.json
      - config/pon/pq-native-tls-witness-required-tests-v1.json
      - config/pon/pq-native-tls-endpoint-required-tests-v1.json
      - config/pon/pq-initial-root-material-required-tests-v1.json
      - config/pon/pq-release-authority-required-tests-v2.json
      - formal/pon-nakamoto-v1/pq_root_quorum_research.py
      - formal/pon-nakamoto-v1/test_pq_root_quorum_research.py
      - scripts/ci/check_ci_contract.py
      - scripts/ci/test_ci_contract.py
      - scripts/ci/check_cell_current_api_readback.py
      - scripts/ci/record_pq_native_command.py
      - scripts/ci/pinned_native_process.py
      - scripts/ci/test_record_pq_native_command.py
      - scripts/ci/verify_ci_source.py
      - scripts/ci/check_required_native_test.py
      - scripts/ci/check_cpq1_parameter_observation.py
      - scripts/ci/test_cpq1_parameter_observation.py
      - scripts/ci/check_sqlite_build_requalification.py
      - .github/workflows/pon-pq-system-continuation.yml
permissions:
  contents: read
jobs:
  cpq1-parameters:
    name: CPQ1 complete candidate observations (${{ matrix.runner }}, ${{ matrix.source }})
    strategy:
      fail-fast: false
      matrix:
        runner: [ubuntu-24.04, ubuntu-24.04-arm]
        source: [head, prospective-merge]
    runs-on: ${{ matrix.runner }}
    timeout-minutes: 25
    env:
      CARGO_BUILD_JOBS: "2"
      CARGO_INCREMENTAL: "0"
      PYTHONDONTWRITEBYTECODE: "1"
      SOURCE_KIND: ${{ matrix.source }}
      EXPECTED_HEAD: ${{ github.event.pull_request.head.sha }}
      EXPECTED_BASE: ${{ github.event.pull_request.base.sha }}
      EXPECTED_TESTED: ${{ matrix.source == 'head' && github.event.pull_request.head.sha || github.sha }}
    steps:
      - uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd
        with:
          ref: ${{ matrix.source == 'head' && github.event.pull_request.head.sha || github.sha }}
          fetch-depth: 0
          persist-credentials: false
      - name: Install the original pinned compiler
        run: rustup toolchain install 1.95.0 --profile minimal
      - name: Observe actual CPQ1 APIs and independently recompute every sample
        shell: bash
        run: |
          set -euo pipefail
          out="$RUNNER_TEMP/cpq1-parameter-observations"
          mkdir "$out"
          export CARGO_TARGET_DIR="$RUNNER_TEMP/cpq1-parameter-target"
          source_args=(--kind "$SOURCE_KIND" --candidate "$EXPECTED_HEAD" --tested "$EXPECTED_TESTED")
          if test "$SOURCE_KIND" = prospective-merge; then
            source_args+=(--base "$EXPECTED_BASE")
          fi
          record_host() {
            python3 scripts/ci/record_pq_native_command.py "${source_args[@]}" --label "$1" --output "$out" -- \
              python3 -c 'import json,os,pathlib,platform; root=pathlib.Path("/sys/fs/cgroup"); names=("cpu.max","memory.max","memory.current","memory.events"); print(json.dumps({"schema":"trnm-cpq1-host-context-v1","platform":platform.platform(),"machine":platform.machine(),"cpu_count":os.cpu_count(),"cpu_affinity":sorted(os.sched_getaffinity(0)),"load_average":os.getloadavg(),"cpu_model":next((line.split(":",1)[1].strip() for line in pathlib.Path("/proc/cpuinfo").read_text().splitlines() if line.startswith("model name")),None),"meminfo":pathlib.Path("/proc/meminfo").read_text(),"cgroup":{name:(root/name).read_text().strip() if (root/name).is_file() else None for name in names},"shared_host":True,"original_hardware_or_wan_qualification":False},sort_keys=True))'
          }
          bash scripts/project-preflight.sh --audit
          python3 scripts/ci/record_pq_native_command.py "${source_args[@]}" --label compiler --output "$out" -- rustc +1.95.0 -Vv
          python3 scripts/ci/record_pq_native_command.py "${source_args[@]}" --label cargo-version --output "$out" -- cargo +1.95.0 -V
          python3 scripts/ci/record_pq_native_command.py "${source_args[@]}" --label locked-graph --output "$out" -- \
            cargo +1.95.0 metadata --locked --manifest-path trillionnium/Cargo.toml --format-version 1
          python3 scripts/ci/record_pq_native_command.py "${source_args[@]}" --label reader-negatives --output "$out" -- \
            python3 -m unittest discover -s scripts/ci -p test_cpq1_parameter_observation.py -v
          python3 scripts/ci/record_pq_native_command.py "${source_args[@]}" --label build --output "$out" -- \
            cargo +1.95.0 build --release --locked --manifest-path trillionnium/Cargo.toml -p trnm-crypto-primitives --example pq_profile_bench
          sha256sum "$CARGO_TARGET_DIR/release/examples/pq_profile_bench" > "$out/binary.sha256"
          record_host host-before
          python3 scripts/ci/record_pq_native_command.py "${source_args[@]}" --label cpq1 --output "$out" -- \
            "$CARGO_TARGET_DIR/release/examples/pq_profile_bench" --samples 64
          record_host host-after
          python3 scripts/ci/record_pq_native_command.py "${source_args[@]}" --label independent-readback --output "$out" -- \
            python3 scripts/ci/check_cpq1_parameter_observation.py "$out/cpq1.log"
      - name: Retain complete CPQ1 records including failures
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: cpq1-parameters-${{ matrix.runner }}-${{ matrix.source }}-${{ github.event.pull_request.head.sha }}-${{ github.run_attempt }}
          path: ${{ runner.temp }}/cpq1-parameter-observations/
          if-no-files-found: error
          retention-days: 14
  primitive-interoperability:
    name: ML-DSA independent C implementation (${{ matrix.runner }}, ${{ matrix.source }})
    strategy:
      fail-fast: false
      matrix:
        runner: [ubuntu-24.04, ubuntu-24.04-arm]
        source: [head, prospective-merge]
    runs-on: ${{ matrix.runner }}
    timeout-minutes: 25
    defaults:
      run:
        working-directory: chain
    env:
      CARGO_BUILD_JOBS: "2"
      CARGO_INCREMENTAL: "0"
      PYTHONDONTWRITEBYTECODE: "1"
      SOURCE_KIND: ${{ matrix.source }}
      EXPECTED_HEAD: ${{ github.event.pull_request.head.sha }}
      EXPECTED_BASE: ${{ github.event.pull_request.base.sha }}
      EXPECTED_TESTED: ${{ matrix.source == 'head' && github.event.pull_request.head.sha || github.sha }}
    steps:
      - uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd
        with:
          ref: ${{ matrix.source == 'head' && github.event.pull_request.head.sha || github.sha }}
          fetch-depth: 0
          persist-credentials: false
          path: chain
      - name: Read the exact independent implementation
        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd
        with:
          repository: pq-code-package/mldsa-native
          ref: 834a90d5e846ffa1e1611bd24e160bb2e9b86d35
          fetch-depth: 1
          persist-credentials: false
          path: upstream-mldsa
      - name: Install the original pinned compiler
        run: rustup toolchain install 1.95.0 --profile minimal
      - name: Run independent primitives on the exact candidate
        shell: bash
        run: |
          set -euo pipefail
          out="$RUNNER_TEMP/mldsa-interoperability"
          mkdir "$out"
          export CARGO_TARGET_DIR="$RUNNER_TEMP/mldsa-rust-target"
          source_args=(--kind "$SOURCE_KIND" --candidate "$EXPECTED_HEAD" --tested "$EXPECTED_TESTED")
          if test "$SOURCE_KIND" = prospective-merge; then
            source_args+=(--base "$EXPECTED_BASE")
          fi
          bash scripts/project-preflight.sh --audit
          python3 scripts/ci/record_pq_native_command.py "${source_args[@]}" --label independent-source-guard --output "$out" -- \
            python3 trillionnium/crates/trnm-crypto-primitives/tests/independent_backend/test_mldsa_native_source.py \
            --source "$GITHUB_WORKSPACE/upstream-mldsa"
          python3 scripts/ci/record_pq_native_command.py "${source_args[@]}" --label oracle-build --output "$out" -- \
            cargo +1.95.0 build --locked --manifest-path trillionnium/Cargo.toml -p trnm-crypto-primitives --example pq_message_oracle
          python3 scripts/ci/record_pq_native_command.py "${source_args[@]}" --label tap21-metadata --output "$out" -- \
            cargo +1.95.0 test --locked --manifest-path trillionnium/Cargo.toml -p trnm-crypto-primitives --test tuf_tap21
          python3 scripts/ci/record_pq_native_command.py "${source_args[@]}" --label cell-current-authority --output "$out" -- \
            cargo +1.95.0 test --locked --manifest-path trillionnium/Cargo.toml -p trnm-data-availability cell::pq
          python3 scripts/ci/record_pq_native_command.py "${source_args[@]}" --label cell-current-api-reader-controls --output "$out" -- \
            python3 -m unittest discover -s scripts/ci -p test_ci_contract.py -k CellCurrentApiReadbackTests -v
          python3 scripts/ci/record_pq_native_command.py "${source_args[@]}" --label cell-current-api --output "$out" -- \
            cargo +1.95.0 test --locked --manifest-path trillionnium/Cargo.toml -p trnm-data-availability --doc cell::pq -- --show-output --test-threads=1
          python3 scripts/ci/record_pq_native_command.py "${source_args[@]}" --label cell-current-api-readback --output "$out" -- \
            python3 scripts/ci/check_cell_current_api_readback.py "$out/cell-current-api.log" trillionnium/crates/trnm-data-availability/src/cell/pq.rs
          python3 scripts/ci/record_pq_native_command.py "${source_args[@]}" --label recovery-release-components --output "$out" -- \
            cargo +1.95.0 test --locked --manifest-path trillionnium/Cargo.toml -p trnm-checkpoint-store -p trnm-release-bundle --all-targets --no-fail-fast -- --test-threads=1
          python3 scripts/ci/record_pq_native_command.py "${source_args[@]}" --label independent-c --output "$out" -- \
            python3 trillionnium/crates/trnm-crypto-primitives/tests/independent_backend/mldsa_native_differential.py \
            --source "$GITHUB_WORKSPACE/upstream-mldsa" \
            --chain-oracle "$CARGO_TARGET_DIR/debug/examples/pq_message_oracle" \
            --wycheproof trillionnium/crates/trnm-crypto-primitives/tests/fixtures/wycheproof/mldsa_65_verify_test.json \
            --build-dir "$out/c-build" --report "$out/differential.json"
      - name: Require all release authority and CCH1 controls from the complete Unix registry
        shell: bash
        run: |
          set -euo pipefail
          out="$RUNNER_TEMP/mldsa-interoperability"
          test -d "$out"
          export CARGO_TARGET_DIR="$RUNNER_TEMP/mldsa-rust-target"
          source_args=(--kind "$SOURCE_KIND" --candidate "$EXPECTED_HEAD" --tested "$EXPECTED_TESTED")
          if test "$SOURCE_KIND" = prospective-merge; then
            source_args+=(--base "$EXPECTED_BASE")
          fi
          python3 scripts/ci/record_pq_native_command.py "${source_args[@]}" --label initial-root-release-registry --output "$out" -- \
            cargo +1.95.0 test --locked --manifest-path trillionnium/Cargo.toml -p trnm-release-bundle --lib -- --list
          python3 - config/pon/pq-release-authority-required-tests-v2.json "$out" <<'PY'
          import json
          import re
          import sys
          from pathlib import Path

          manifest = json.loads(Path(sys.argv[1]).read_text())
          counts = {"original_release": 37, "initial_root_material": 6,
                    "quorum_preflight": 9, "cch1_content_binding": 3, "complete_release": 55}
          if (not isinstance(manifest, dict)
                  or manifest.get("schema") != "trnm-pq-release-authority-required-tests-v2"
                  or manifest.get("package") != "trnm-release-bundle"
                  or manifest.get("harness") != "lib"
                  or manifest.get("platform_scope") != "unix"
                  or manifest.get("scope") != "release-authority-initial-root-quorum-and-cch1-content-binding-unix-only"
                  or not isinstance(manifest.get("expected_controls"), dict)
                  or manifest["expected_controls"] != counts
                  or any(type(value) is not int for value in manifest["expected_controls"].values())
                  or any(manifest.get(key) is not False for key in (
                      "authorization_results_cached", "signature_results_cached", "performance_qualified",
                      "production_activation", "consensus_authority", "whole_chain_quantum_security_qualified"))):
              raise SystemExit("release-authority required-control manifest invalid")
          sets = {}
          for key, count in counts.items():
              names = manifest.get(key + "_tests")
              if (not isinstance(names, list) or len(names) != count
                      or any(not isinstance(name, str) or not re.fullmatch(
                          r"[A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)*", name) for name in names)
                      or len(set(names)) != count):
                  raise SystemExit("release-authority required-control names invalid")
              sets[key] = set(names)
          groups = ("original_release", "initial_root_material", "quorum_preflight", "cch1_content_binding")
          if (any(sets[left] & sets[right] for index, left in enumerate(groups)
                  for right in groups[index + 1:])
                  or sets["complete_release"] != set().union(*(sets[group] for group in groups))):
              raise SystemExit("release-authority required-control partition invalid")
          root = Path(sys.argv[2])
          log = (root / "initial-root-release-registry.log").read_text()
          names = re.findall(r"^([A-Za-z0-9_:]+): test$", log, re.M)
          summaries = re.findall(r"^([0-9]+) tests, ([0-9]+) benchmarks$", log, re.M)
          if (len(names) != 55 or len(set(names)) != 55 or set(names) != sets["complete_release"]
                  or summaries != [("55", "0")]):
              raise SystemExit("release-authority actual binary registry differs from the complete required Unix 55")
          prefixes = {"original_release": "original-release", "initial_root_material": "initial-root",
                      "quorum_preflight": "quorum-preflight", "cch1_content_binding": "cch1-content-binding"}
          (root / "release-authority-required.tsv").write_text("".join(
              f"{prefixes[group]}-{index:02d}\t{name}\n"
              for group in groups for index, name in enumerate(manifest[group + "_tests"])))
          print(json.dumps({"scope": "registry-presence-only", "required_controls": counts,
                            "production_activation": False}, sort_keys=True))
          PY
          failed=0
          while IFS=$'\t' read -r label selector; do
            if ! python3 scripts/ci/record_pq_native_command.py "${source_args[@]}" --label "$label" --output "$out" -- \
              cargo +1.95.0 test --locked --manifest-path trillionnium/Cargo.toml -p trnm-release-bundle --lib "$selector" -- --exact --show-output --test-threads=1; then
              failed=1
            elif ! python3 scripts/ci/check_required_native_test.py "$out/$label.log" --test "$selector" > "$out/$label-execution.json"; then
              failed=1
            fi
          done < "$out/release-authority-required.tsv"
          test "$failed" = 0
      - name: Run root-quorum codec and policy test doubles without native crypto claims
        shell: bash
        run: |
          set -euo pipefail
          out="$RUNNER_TEMP/mldsa-interoperability"
          test -d "$out"
          source_args=(--kind "$SOURCE_KIND" --candidate "$EXPECTED_HEAD" --tested "$EXPECTED_TESTED")
          if test "$SOURCE_KIND" = prospective-merge; then
            source_args+=(--base "$EXPECTED_BASE")
          fi
          python3 scripts/ci/record_pq_native_command.py "${source_args[@]}" --label root-quorum-harness --output "$out" -- \
            python3 -B formal/pon-nakamoto-v1/test_pq_root_quorum_research.py -v
          python3 - "$out/root-quorum-harness.log" > "$out/root-quorum-harness-execution.json" <<'PY'
          import hashlib
          import json
          import re
          import sys
          from pathlib import Path

          text = Path(sys.argv[1]).read_text()
          rows = re.findall(r"^(test_[A-Za-z0-9_]+) \(__main__\.RootQuorumResearchTests\.([A-Za-z0-9_]+)\) \.\.\. (.*)$", text, re.M)
          names = [row[0] for row in rows]
          digest = hashlib.sha256(("\n".join(sorted(names)) + "\n").encode()).hexdigest()
          summaries = re.findall(r"^Ran ([0-9]+) tests? in [0-9]+(?:\.[0-9]+)?s$", text, re.M)
          outcomes = re.findall(r"^(?:OK(?: \(.*\))?|FAILED(?: \(.*\))?)$", text, re.M)
          if (len(rows) != 18 or len(set(names)) != 18
                  or any(name != method or outcome != "ok" for name, method, outcome in rows)
                  or digest != "17ed290cc8ad7b988f012f4cd9119c4197ff8ac3d82c1f655525eb09ae27cac5"
                  or summaries != ["18"] or outcomes != ["OK"]):
              raise SystemExit("root-quorum harness requires all 18 exact codec/policy test doubles")
          print(json.dumps({"result": "PASS", "executed_tests": 18,
                            "scope": "python-codec-policy-test-doubles-only",
                            "native_crypto_observed": False, "production_activation": False}, sort_keys=True))
          PY
      - name: Retain independent primitive results including failures
        if: ${{ !cancelled() }}
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: mldsa-independent-${{ matrix.runner }}-${{ matrix.source }}-${{ github.event.pull_request.head.sha }}-${{ github.run_attempt }}
          path: ${{ runner.temp }}/mldsa-interoperability/
          if-no-files-found: error
          retention-days: 14
  tuf-sdk-interoperability:
    name: TAP21 actual SDK interoperability (${{ matrix.runner }}, ${{ matrix.source }})
    strategy:
      fail-fast: false
      matrix:
        runner: [ubuntu-24.04, ubuntu-24.04-arm]
        source: [head, prospective-merge]
    runs-on: ${{ matrix.runner }}
    timeout-minutes: 25
    defaults:
      run:
        working-directory: chain
    env:
      CARGO_BUILD_JOBS: "2"
      CARGO_INCREMENTAL: "0"
      PYTHONDONTWRITEBYTECODE: "1"
      SOURCE_KIND: ${{ matrix.source }}
      EXPECTED_HEAD: ${{ github.event.pull_request.head.sha }}
      EXPECTED_BASE: ${{ github.event.pull_request.base.sha }}
      EXPECTED_TESTED: ${{ matrix.source == 'head' && github.event.pull_request.head.sha || github.sha }}
    steps:
      - uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd
        with:
          ref: ${{ matrix.source == 'head' && github.event.pull_request.head.sha || github.sha }}
          fetch-depth: 0
          persist-credentials: false
          path: chain
      - name: Read the exact supported SDK source
        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd
        with:
          repository: secure-systems-lab/securesystemslib
          ref: 15064ca640222edba024af9f13191fa5dbad3825
          fetch-depth: 1
          persist-credentials: false
          path: upstream-sslib
      - name: Install the original pinned compiler
        run: rustup toolchain install 1.95.0 --profile minimal
      - name: Compare real SDK and product adapter signatures
        shell: bash
        run: |
          set -euo pipefail
          out="$RUNNER_TEMP/tuf-sdk-interoperability"
          mkdir "$out"
          export CARGO_TARGET_DIR="$RUNNER_TEMP/tuf-sdk-rust-target"
          source_args=(--kind "$SOURCE_KIND" --candidate "$EXPECTED_HEAD" --tested "$EXPECTED_TESTED")
          if test "$SOURCE_KIND" = prospective-merge; then
            source_args+=(--base "$EXPECTED_BASE")
          fi
          bash scripts/project-preflight.sh --audit
          python3 -m venv "$RUNNER_TEMP/tuf-sdk-env"
          sdk_python="$RUNNER_TEMP/tuf-sdk-env/bin/python"
          python3 scripts/ci/record_pq_native_command.py "${source_args[@]}" --label sdk-dependencies --output "$out" -- \
            "$sdk_python" -m pip install --disable-pip-version-check --only-binary=:all: --report "$out/dependencies.json" \
            cryptography==50.0.2 cffi==2.1.1 pycparser==3.12
          python3 scripts/ci/record_pq_native_command.py "${source_args[@]}" --label sdk-source-guard --output "$out" -- \
            python3 trillionnium/crates/trnm-crypto-primitives/tests/independent_backend/test_tuf_sdk_source.py \
            --source "$GITHUB_WORKSPACE/upstream-sslib"
          python3 scripts/ci/record_pq_native_command.py "${source_args[@]}" --label sdk-oracle-build --output "$out" -- \
            cargo +1.95.0 build --locked --manifest-path trillionnium/Cargo.toml -p trnm-crypto-primitives --example pq_message_oracle
          python3 scripts/ci/record_pq_native_command.py "${source_args[@]}" --label sdk-interop --output "$out" -- \
            "$sdk_python" trillionnium/crates/trnm-crypto-primitives/tests/independent_backend/tuf_sdk_differential.py \
            --source "$GITHUB_WORKSPACE/upstream-sslib" \
            --chain-oracle "$CARGO_TARGET_DIR/debug/examples/pq_message_oracle" --report "$out/differential.json"
      - name: Retain SDK interoperability including failures
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: tuf-sdk-${{ matrix.runner }}-${{ matrix.source }}-${{ github.event.pull_request.head.sha }}-${{ github.run_attempt }}
          path: ${{ runner.temp }}/tuf-sdk-interoperability/
          if-no-files-found: error
          retention-days: 14
  native:
    name: PQ network and witness (${{ matrix.runner }}, ${{ matrix.source }})
    strategy:
      fail-fast: false
      matrix:
        runner: [ubuntu-24.04, ubuntu-24.04-arm]
        source: [head, prospective-merge]
    runs-on: ${{ matrix.runner }}
    timeout-minutes: 90
    env:
      CARGO_BUILD_JOBS: "2"
      CARGO_INCREMENTAL: "0"
      RUST_TEST_THREADS: "1"
      PYTHONDONTWRITEBYTECODE: "1"
      SOURCE_KIND: ${{ matrix.source }}
      EXPECTED_HEAD: ${{ github.event.pull_request.head.sha }}
      EXPECTED_BASE: ${{ github.event.pull_request.base.sha }}
      EXPECTED_TESTED: ${{ matrix.source == 'head' && github.event.pull_request.head.sha || github.sha }}
    steps:
      - uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd
        with:
          ref: ${{ matrix.source == 'head' && github.event.pull_request.head.sha || github.sha }}
          fetch-depth: 0
          persist-credentials: false
      - name: Prepare exact-source command records
        shell: bash
        run: |
          set -euo pipefail
          out="$RUNNER_TEMP/pq-system-records"
          mkdir "$out"
          echo "PQ_OUT=$out" >> "$GITHUB_ENV"
          echo "CARGO_TARGET_DIR=$RUNNER_TEMP/pq-system-target" >> "$GITHUB_ENV"
          cat > "$out/run-command.sh" <<'SH'
          set -euo pipefail
          label="$1"
          shift
          source_args=(--kind "$SOURCE_KIND" --candidate "$EXPECTED_HEAD" --tested "$EXPECTED_TESTED")
          if test "$SOURCE_KIND" = prospective-merge; then
            source_args+=(--base "$EXPECTED_BASE")
          fi
          command_status=0
          python3 scripts/ci/record_pq_native_command.py "${source_args[@]}" --label "$label" --output "$PQ_OUT" -- "$@" || command_status=$?
          if test -f "$PQ_OUT/$label.log"; then
            if test "$command_status" -ne 0; then
              tail -n 200 "$PQ_OUT/$label.log"
            else
              case "$label" in
                node-lib) sed -n '/test result:/p; /trnm-state-delta-walk-observation-v1/p; /trnm-current-account-.*observation-v1/p' "$PQ_OUT/$label.log" ;;
                cost-*) cat "$PQ_OUT/$label.log" ;;
              esac
            fi
          fi
          exit "$command_status"
          SH
          args=(--kind "$SOURCE_KIND" --expected-head "$EXPECTED_HEAD")
          if test "$SOURCE_KIND" = prospective-merge; then
            args+=(--expected-base "$EXPECTED_BASE" --expected-merge "$EXPECTED_TESTED")
          fi
          python3 scripts/ci/verify_ci_source.py "${args[@]}" --output "$out/source.json"
          bash scripts/project-preflight.sh --audit
      - name: Require retained source and claim controls
        shell: bash
        run: |
          set -euo pipefail
          for test_file in test_ci_source_integrity.py test_record_pq_native_command.py test_pq_research_integration.py test_pq_chain_claim_guard.py test_pq_authority_surface_scan.py; do
            bash "$PQ_OUT/run-command.sh" "${test_file%.py}" python3 -m unittest discover -s scripts/ci -p "$test_file" -v
          done
          bash "$PQ_OUT/run-command.sh" pq-source python3 scripts/ci/check_pq_research_integration.py
          bash "$PQ_OUT/run-command.sh" pq-hold python3 scripts/ci/pq_chain_claim_guard.py
          bash "$PQ_OUT/run-command.sh" repository python3 scripts/ci/check_repository.py
          bash "$PQ_OUT/run-command.sh" inventory python3 scripts/refresh_distributed_source_inventory.py --check
      - name: Install the original pinned compiler
        run: rustup toolchain install 1.95.0 --profile minimal --component rustfmt --component clippy
      - name: Prepare the independently pinned OpenSSL provider
        shell: bash
        run: |
          set -euo pipefail
          export TRNM_CI_RECEIPT_DIR="$PQ_OUT"
          bash scripts/ci/prepare_pq_provider.sh
      - name: Record compiler, exact locked graph and formatting
        id: pq_build
        shell: bash
        run: |
          set -euo pipefail
          bash "$PQ_OUT/run-command.sh" compiler rustc +1.95.0 -Vv
          bash "$PQ_OUT/run-command.sh" locked-graph cargo +1.95.0 metadata --locked --manifest-path trillionnium/Cargo.toml --format-version 1
          bash "$PQ_OUT/run-command.sh" format cargo +1.95.0 fmt --manifest-path trillionnium/Cargo.toml --all -- --check
          bash "$PQ_OUT/run-command.sh" build cargo +1.95.0 test --locked --manifest-path trillionnium/Cargo.toml -p trnm-pon-node --lib --all-features --no-run --message-format=json
      - name: Execute every required native effect and rejection control
        shell: bash
        run: |
          set -euo pipefail
          bash "$PQ_OUT/run-command.sh" native-registry cargo +1.95.0 test --locked --manifest-path trillionnium/Cargo.toml -p trnm-pon-node --lib --all-features -- --list
          python3 - "$PQ_OUT/required-tests.tsv" "$PQ_OUT/native-registry.log" <<'PY'
          import json, re, sys
          from pathlib import Path
          value = json.loads(Path('config/pon/pq-system-required-tests-v1.json').read_text())
          assert value['schema'] == 'trnm-pq-system-required-tests-v1'
          assert all(value.get(key) is False for key in (
              'whole_chain_quantum_security_qualified', 'original_business_budgets_changed'))
          tests = value['tests']
          assert type(value['expected_meaningful_controls']) is int
          assert len(tests) == value['expected_meaningful_controls'] and len(set(tests)) == len(tests)
          assert len(tests) == 52
          assert all(re.fullmatch(r'[A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)*', x) for x in tests)
          assert not set(tests) & set(value['child_process_harnesses_not_counted'])
          registered = re.findall(r'^([A-Za-z0-9_:]+): test$', Path(sys.argv[2]).read_text(), re.M)
          assert len(registered) == len(set(registered)) and all(registered.count(name) == 1 for name in tests)
          with Path(sys.argv[1]).open('x') as output:
              output.write(''.join(f'native-{i:02d}\t{name}\n' for i, name in enumerate(tests)))
          print(json.dumps({'scope': 'registry-presence-only', 'required_controls': 52,
              'whole_chain_quantum_security_qualified': False}, sort_keys=True))
          PY
          failed=0
          while IFS=$'\t' read -r label selector; do
            if ! bash "$PQ_OUT/run-command.sh" "$label" cargo +1.95.0 test --locked --manifest-path trillionnium/Cargo.toml -p trnm-pon-node --lib --all-features "$selector" -- --exact --show-output --test-threads=1; then
              failed=1
            elif ! python3 scripts/ci/check_required_native_test.py "$PQ_OUT/$label.log" --test "$selector" > "$PQ_OUT/$label-execution.json"; then
              failed=1
            fi
          done < "$PQ_OUT/required-tests.tsv"
          test "$failed" = 0
      - name: Execute supplemental account scope and witness retry controls
        if: ${{ !cancelled() && steps.pq_build.outcome == 'success' }}
        shell: bash
        run: |
          set -euo pipefail
          python3 - "$PQ_OUT/supplemental-tests.tsv" <<'PY'
          import json, re, sys
          from pathlib import Path
          retained_path = 'config/pon/pq-system-required-tests-v1.json'
          retained = json.loads(Path(retained_path).read_text())
          value = json.loads(Path('config/pon/pq-system-supplemental-tests-v1.json').read_text())
          assert value['schema'] == 'trnm-pq-system-supplemental-tests-v1'
          assert value['scope'] == 'account-scope-and-witness-retry-provenance-only'
          assert value['whole_chain_quantum_security_qualified'] is False
          assert value['original_business_budgets_changed'] is False
          assert value['retained_roster'] == retained_path
          assert type(value['retained_meaningful_controls']) is int and value['retained_meaningful_controls'] == 52
          assert retained['schema'] == 'trnm-pq-system-required-tests-v1'
          assert retained['expected_meaningful_controls'] == len(retained['tests']) == 52
          tests = value['tests']
          assert type(value['expected_meaningful_controls']) is int and value['expected_meaningful_controls'] == 11
          assert isinstance(tests, list) and len(tests) == len(set(tests)) == 11
          assert all(isinstance(x, str) and re.fullmatch(r'[A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)*', x) for x in tests)
          assert not set(tests) & (set(retained['tests']) | set(retained['child_process_harnesses_not_counted']))
          Path(sys.argv[1]).write_text(''.join(f'native-supplemental-{i:02d}\t{name}\n' for i, name in enumerate(tests)))
          PY
          failed=0
          while IFS=$'\t' read -r label selector; do
            if ! bash "$PQ_OUT/run-command.sh" "$label" cargo +1.95.0 test --locked --manifest-path trillionnium/Cargo.toml -p trnm-pon-node --lib --all-features "$selector" -- --exact --show-output --test-threads=1; then
              failed=1
            elif ! python3 scripts/ci/check_required_native_test.py "$PQ_OUT/$label.log" --test "$selector" > "$PQ_OUT/$label-execution.json"; then
              failed=1
            fi
          done < "$PQ_OUT/supplemental-tests.tsv"
          test "$failed" = 0
      - name: Require admitted migration handoff and checkpoint endpoint ownership
        if: ${{ !cancelled() && steps.pq_build.outcome == 'success' }}
        shell: bash
        run: |
          set -euo pipefail
          failed=0
          for selector in \
            store::pq_migration_inventory::handoff_tests::admitted_restricted_source_handoff_preserves_nonce_liability_and_claim_on_cold_open \
            store::pq_migration_inventory::handoff_tests::admitted_source_handoff_refuses_wrong_registry_pins_and_unsupported_source_rows; do
            label="migration-${selector##*::}"
            if ! bash "$PQ_OUT/run-command.sh" "$label" cargo +1.95.0 test --locked --manifest-path trillionnium/Cargo.toml -p trnm-pon-node --lib --all-features "$selector" -- --exact --show-output --test-threads=1; then
              failed=1
            elif ! python3 scripts/ci/check_required_native_test.py "$PQ_OUT/$label.log" --test "$selector" > "$PQ_OUT/$label-execution.json"; then
              failed=1
            fi
          done
          for selector in \
            rejected_nonprivate_socket_parent_does_not_unlink_existing_listener \
            different_admitted_journal_cannot_replace_a_live_checkpoint_endpoint \
            copied_lease_record_cannot_replace_a_live_checkpoint_endpoint \
            connect_only_probe_preserves_live_owner_and_journal \
            complete_checkpoint_request_rejects_a_copied_lease_replacement; do
            label="checkpoint-$selector"
            if ! bash "$PQ_OUT/run-command.sh" "$label" cargo +1.95.0 test --locked --manifest-path trillionnium/Cargo.toml -p trnm-checkpoint-store --test socket_ownership "$selector" -- --exact --show-output --test-threads=1; then
              failed=1
            elif ! python3 scripts/ci/check_required_native_test.py "$PQ_OUT/$label.log" --test "$selector" > "$PQ_OUT/$label-execution.json"; then
              failed=1
            fi
          done
          for selector in \
            socket_owner_v1::tests::saturated_copied_lease_refuses_without_unlink_and_allows_dead_recovery \
            socket_owner_v1::tests::endpoint_lease_prevents_live_socket_replacement_and_permits_owner_restart \
            socket_owner_v1::probe_policy_tests::connected_listener_is_not_stale \
            socket_owner_v1::probe_policy_tests::explicit_refusal_is_only_recovery_case \
            socket_owner_v1::probe_policy_tests::every_other_error_stays_refused \
            socket_owner_v1::probe_policy_tests::linux_eagain_and_einprogress_are_not_dead_listener \
            socket_owner_v1::unsupported_probe_tests::other_unix_policy_never_probes_or_authorizes_replacement; do
            label="checkpoint-probe-${selector##*::}"
            if ! bash "$PQ_OUT/run-command.sh" "$label" cargo +1.95.0 test --locked --manifest-path trillionnium/Cargo.toml -p trnm-checkpoint-store --lib "$selector" -- --exact --show-output --test-threads=1; then
              failed=1
            elif ! python3 scripts/ci/check_required_native_test.py "$PQ_OUT/$label.log" --test "$selector" > "$PQ_OUT/$label-execution.json"; then
              failed=1
            fi
          done
          test "$failed" = 0
      - name: Execute anchored NPQ6 migration and source-preservation controls
        if: ${{ !cancelled() && steps.pq_build.outcome == 'success' }}
        shell: bash
        run: |
          set -euo pipefail
          failed=0
          for selector in \
            npq6_anchored_claim_preserves_obligations_rotates_and_cold_reopens \
            npq6_migration_requires_both_claim_signatures_and_the_selected_domain \
            admitted_legacy_checkpoint_cannot_drop_unhandled_work_state_for_migration; do
            label="npq6-migration-$selector"
            if ! bash "$PQ_OUT/run-command.sh" "$label" cargo +1.95.0 test --locked --manifest-path trillionnium/Cargo.toml -p trnm-pon-node --test pq_application_migration_v6 "$selector" -- --exact --show-output --test-threads=1; then
              failed=1
            elif ! python3 scripts/ci/check_required_native_test.py "$PQ_OUT/$label.log" --test "$selector" > "$PQ_OUT/$label-execution.json"; then
              failed=1
            fi
          done
          test "$failed" = 0
      - name: Refuse classical submit recovery for retained PQ network owners
        if: ${{ !cancelled() && steps.pq_build.outcome == 'success' }}
        shell: bash
        run: |
          set -euo pipefail
          selector=pq_transport_owner_refuses_classical_submit_recovery_before_connect_and_after_reopen
          bash "$PQ_OUT/run-command.sh" public-submit-pq-owner cargo +1.95.0 test --locked --manifest-path trillionnium/Cargo.toml -p trnm-pon-node --test public_submit_recovery --all-features "$selector" -- --exact --show-output --test-threads=1
          python3 scripts/ci/check_required_native_test.py "$PQ_OUT/public-submit-pq-owner.log" --test "$selector" > "$PQ_OUT/public-submit-pq-owner-execution.json"
          bash "$PQ_OUT/run-command.sh" public-submit-recovery cargo +1.95.0 test --locked --manifest-path trillionnium/Cargo.toml -p trnm-pon-node --test public_submit_recovery --all-features -- --show-output --test-threads=1
      - name: Require native TLS and ordinary binary controls from actual registries
        if: ${{ !cancelled() && steps.pq_build.outcome == 'success' }}
        shell: bash
        run: |
          set -euo pipefail
          manifest=config/pon/pq-native-tls-required-tests-v1.json
          for scope in lib cli feature-off; do
            case "$scope" in
              lib) target=(--lib --all-features) ;;
              cli) target=(--test pq_tls_cli --all-features) ;;
              feature-off) target=(--test pq_tls_feature_gate --no-default-features) ;;
            esac
            bash "$PQ_OUT/run-command.sh" "tls-$scope-registry" cargo +1.95.0 test --locked --manifest-path trillionnium/Cargo.toml -p trnm-pon-node "${target[@]}" -- --list
          done
          python3 - "$manifest" "$PQ_OUT" <<'PY'
          import json, re, sys
          from pathlib import Path
          manifest = json.loads(Path(sys.argv[1]).read_text())
          counts = {'lib': 16, 'cli': 4, 'feature-off': 1}
          if (not isinstance(manifest, dict)
                  or manifest.get('schema') != 'trnm-pq-native-tls-required-tests-v1'
                  or not isinstance(manifest.get('expected_controls'), dict)
                  or manifest.get('expected_controls') != counts
                  or any(type(value) is not int for value in manifest['expected_controls'].values())
                  or not isinstance(manifest.get('scopes'), dict)
                  or set(manifest.get('scopes', {})) != set(counts)
                  or any(manifest.get(key) is not False for key in ('production_activation',
                      'consensus_authority', 'public_wan_accepted', 'whole_chain_quantum_security_qualified'))):
              raise SystemExit('TLS required-control manifest invalid')
          root = Path(sys.argv[2])
          rows = []
          for scope, count in counts.items():
              required = manifest['scopes'][scope]
              if (not isinstance(required, list) or len(required) != count
                      or any(not isinstance(x, str) or not re.fullmatch(r'[A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)*', x) for x in required)
                      or len(set(required)) != count):
                  raise SystemExit('TLS required-control names invalid')
              log = (root / f'tls-{scope}-registry.log').read_text()
              names = re.findall(r'^([A-Za-z0-9_:]+): test$', log, re.M)
              if len(names) != len(set(names)) or any(names.count(name) != 1 for name in required):
                  raise SystemExit('TLS required test absent/duplicated in actual binary registry')
              rows.extend(f'tls-{scope}-{index:02d}\t{scope}\t{name}\n' for index, name in enumerate(required))
          (root / 'tls-required.tsv').write_text(''.join(rows))
          print(json.dumps({'scope':'registry-presence-only','required_controls':counts,'production_activation':False},sort_keys=True))
          PY
          failed=0
          while IFS=$'\t' read -r label scope selector; do
            case "$scope" in
              lib) target=(--lib --all-features) ;;
              cli) target=(--test pq_tls_cli --all-features) ;;
              feature-off) target=(--test pq_tls_feature_gate --no-default-features) ;;
              *) exit 1 ;;
            esac
            if ! bash "$PQ_OUT/run-command.sh" "$label" cargo +1.95.0 test --locked --manifest-path trillionnium/Cargo.toml -p trnm-pon-node "${target[@]}" "$selector" -- --exact --show-output --test-threads=1; then
              failed=1
            elif ! python3 scripts/ci/check_required_native_test.py "$PQ_OUT/$label.log" --test "$selector" > "$PQ_OUT/$label-execution.json"; then
              failed=1
            fi
          done < "$PQ_OUT/tls-required.tsv"
          test "$failed" = 0
      - name: Require the explicit TLS witness CLI controls from the actual binary
        if: ${{ !cancelled() && steps.pq_build.outcome == 'success' }}
        shell: bash
        run: |
          set -euo pipefail
          manifest=config/pon/pq-native-tls-witness-required-tests-v1.json
          bash "$PQ_OUT/run-command.sh" tls-witness-cli-registry cargo +1.95.0 test --locked --manifest-path trillionnium/Cargo.toml -p trnm-pon-node --test pq_tls_witness_cli --all-features -- --list
          python3 - "$manifest" "$PQ_OUT" <<'PY'
          import json, re, sys
          from pathlib import Path
          manifest = json.loads(Path(sys.argv[1]).read_text())
          if (not isinstance(manifest, dict)
                  or manifest.get('schema') != 'trnm-pq-native-tls-witness-required-tests-v1'
                  or manifest.get('harness') != 'pq_tls_witness_cli'
                  or not isinstance(manifest.get('expected_controls'), dict)
                  or manifest['expected_controls'] != {'cli': 5}
                  or type(manifest['expected_controls']['cli']) is not int
                  or not isinstance(manifest.get('scopes'), dict)
                  or set(manifest['scopes']) != {'cli'}
                  or any(manifest.get(key) is not False for key in ('production_activation',
                      'consensus_authority', 'public_wan_accepted', 'whole_chain_quantum_security_qualified',
                      'whole_node_rollback_protection'))):
              raise SystemExit('TLS witness required-control manifest invalid')
          required = manifest['scopes']['cli']
          if (not isinstance(required, list) or len(required) != 5
                  or any(not isinstance(name, str) or not re.fullmatch(r'[A-Za-z_][A-Za-z0-9_]*', name) for name in required)
                  or len(set(required)) != 5):
              raise SystemExit('TLS witness required-control names invalid')
          root = Path(sys.argv[2])
          log = (root / 'tls-witness-cli-registry.log').read_text()
          names = re.findall(r'^([A-Za-z0-9_:]+): test$', log, re.M)
          if len(names) != 5 or len(set(names)) != 5 or set(names) != set(required):
              raise SystemExit('TLS witness actual binary registry differs from the five required controls')
          (root / 'tls-witness-required.tsv').write_text(''.join(
              f'tls-witness-cli-{index:02d}\t{name}\n' for index, name in enumerate(required)))
          print(json.dumps({'scope':'registry-presence-only','required_controls':5,'production_activation':False},sort_keys=True))
          PY
          failed=0
          while IFS=$'\t' read -r label selector; do
            if ! bash "$PQ_OUT/run-command.sh" "$label" cargo +1.95.0 test --locked --manifest-path trillionnium/Cargo.toml -p trnm-pon-node --test pq_tls_witness_cli --all-features "$selector" -- --exact --show-output --test-threads=1; then
              failed=1
            elif ! python3 scripts/ci/check_required_native_test.py "$PQ_OUT/$label.log" --test "$selector" > "$PQ_OUT/$label-execution.json"; then
              failed=1
            fi
          done < "$PQ_OUT/tls-witness-required.tsv"
          test "$failed" = 0
      - name: Require fixed-endpoint TLS controls without replacing loopback or witness controls
        if: ${{ !cancelled() && steps.pq_build.outcome == 'success' }}
        shell: bash
        run: |
          set -euo pipefail
          manifest=config/pon/pq-native-tls-endpoint-required-tests-v1.json
          bash "$PQ_OUT/run-command.sh" tls-endpoint-lib-registry cargo +1.95.0 test --locked --manifest-path trillionnium/Cargo.toml -p trnm-pon-node --lib --all-features -- --list
          bash "$PQ_OUT/run-command.sh" tls-endpoint-cli-registry cargo +1.95.0 test --locked --manifest-path trillionnium/Cargo.toml -p trnm-pon-node --test pq_tls_endpoint_cli --all-features -- --list
          python3 - "$manifest" "$PQ_OUT" <<'PY'
          import json, re, sys
          from pathlib import Path
          manifest = json.loads(Path(sys.argv[1]).read_text())
          counts = {'lib': 8, 'cli': 3}
          if (not isinstance(manifest, dict)
                  or manifest.get('schema') != 'trnm-pq-native-tls-endpoint-required-tests-v1'
                  or manifest.get('expected_controls') != counts
                  or any(type(value) is not int for value in manifest['expected_controls'].values())
                  or not isinstance(manifest.get('scopes'), dict)
                  or set(manifest['scopes']) != set(counts)
                  or any(manifest.get(key) is not False for key in ('production_activation',
                      'consensus_authority', 'public_wan_accepted', 'whole_chain_quantum_security_qualified',
                      'whole_node_rollback_protection'))):
              raise SystemExit('TLS endpoint required-control manifest invalid')
          root = Path(sys.argv[2])
          rows = []
          for scope, count in counts.items():
              required = manifest['scopes'][scope]
              if (not isinstance(required, list) or len(required) != count
                      or any(not isinstance(name, str) or not re.fullmatch(r'[A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)*', name) for name in required)
                      or len(set(required)) != count):
                  raise SystemExit('TLS endpoint required-control names invalid')
              log = (root / f'tls-endpoint-{scope}-registry.log').read_text()
              names = re.findall(r'^([A-Za-z0-9_:]+): test$', log, re.M)
              if len(names) != len(set(names)) or any(names.count(name) != 1 for name in required):
                  raise SystemExit('TLS endpoint test absent/duplicated in actual binary registry')
              if scope == 'cli' and set(names) != set(required):
                  raise SystemExit('TLS endpoint CLI registry differs from required controls')
              rows.extend(f'tls-endpoint-{scope}-{index:02d}\t{scope}\t{name}\n' for index, name in enumerate(required))
          (root / 'tls-endpoint-required.tsv').write_text(''.join(rows))
          print(json.dumps({'scope':'registry-presence-only','required_controls':counts,'production_activation':False},sort_keys=True))
          PY
          failed=0
          while IFS=$'\t' read -r label scope selector; do
            case "$scope" in
              lib) target=(--lib --all-features) ;;
              cli) target=(--test pq_tls_endpoint_cli --all-features) ;;
              *) exit 1 ;;
            esac
            if ! bash "$PQ_OUT/run-command.sh" "$label" cargo +1.95.0 test --locked --manifest-path trillionnium/Cargo.toml -p trnm-pon-node "${target[@]}" "$selector" -- --exact --show-output --test-threads=1; then
              failed=1
            elif ! python3 scripts/ci/check_required_native_test.py "$PQ_OUT/$label.log" --test "$selector" > "$PQ_OUT/$label-execution.json"; then
              failed=1
            fi
          done < "$PQ_OUT/tls-endpoint-required.tsv"
          test "$failed" = 0
      - name: Require original transaction scope controls
        if: ${{ !cancelled() && steps.pq_build.outcome == 'success' }}
        shell: bash
        run: |
          set -euo pipefail
          failed=0
          for selector in \
            transaction_scope::tests::token_controls_cover_sqlite_space_comments_bom_aliases_and_identifier_boundaries \
            transaction_scope::tests::actual_readonly_aba_is_not_an_autocommit_changes_or_schema_identity \
            transaction_scope::tests::already_prepared_cached_end_is_observed_at_execution_and_reuse \
            transaction_scope::tests::savepoint_release_and_rollback_to_are_conservatively_refused \
            transaction_scope::tests::nested_scopes_share_epoch_and_other_connections_do_not_invalidate_reads \
            transaction_scope::tests::explain_does_not_execute_a_transaction_control \
            transaction_scope::tests::replacing_trace_is_detected_by_actual_execution_probe_without_resetting_epoch \
            transaction_scope::tests::overflow_wrong_pid_and_wrong_handle_are_sticky_refusals \
            transaction_scope::tests::dropping_scopes_does_not_drop_or_reinstall_the_connection_observer \
            transaction_scope::tests::actual_write_snapshot_requires_same_live_main_writer \
            transaction_scope::tests::executed_write_epoch_catches_no_row_failed_and_reversed_schema_writes \
            transaction_scope::tests::prepared_write_execution_is_counted_but_explain_is_not_a_write \
            transaction_scope::tests::write_snapshot_rejects_savepoint_aba_and_sticky_observer_failures; do
            label="scope-${selector##*::}"
            if ! bash "$PQ_OUT/run-command.sh" "$label" cargo +1.95.0 test --locked --manifest-path trillionnium/Cargo.toml -p trnm-sqlite-io-boundary --lib --all-features "$selector" -- --exact --show-output --test-threads=1; then
              failed=1
            elif ! python3 scripts/ci/check_required_native_test.py "$PQ_OUT/$label.log" --test "$selector" > "$PQ_OUT/$label-execution.json"; then
              failed=1
            fi
          done
          test "$failed" = 0
      - name: Require actual build-fence cache requalification
        if: ${{ !cancelled() && steps.pq_build.outcome == 'success' }}
        shell: bash
        run: |
          set -euo pipefail
          bash "$PQ_OUT/run-command.sh" sqlite-build-requalification python3 scripts/ci/check_sqlite_build_requalification.py \
            --output "$PQ_OUT/sqlite-build-requalification" --target "$RUNNER_TEMP/sqlite-build-requalification-target" \
            --rustc "$(rustup which --toolchain 1.95.0 rustc)" --cargo "$(rustup which --toolchain 1.95.0 cargo)" --rustup "$(command -v rustup)"
      - name: Preserve native control records before the complete regression
        if: ${{ !cancelled() && steps.pq_build.outcome == 'success' }}
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: pq-system-controls-${{ matrix.runner }}-${{ matrix.source }}-${{ github.event.pull_request.head.sha }}-${{ github.run_attempt }}
          path: ${{ runner.temp }}/pq-system-records/
          if-no-files-found: error
          retention-days: 14
      - name: Preserve the complete original Node library regression suite
        if: ${{ !cancelled() && steps.pq_build.outcome == 'success' }}
        shell: bash
        run: |
          set -euo pipefail
          bash "$PQ_OUT/run-command.sh" node-lib cargo +1.95.0 test --locked --manifest-path trillionnium/Cargo.toml -p trnm-pon-node --lib --all-features -- --show-output --test-threads=1
      - name: Check strict Clippy without rewriting source
        if: ${{ !cancelled() && steps.pq_build.outcome == 'success' }}
        shell: bash
        run: |
          set -euo pipefail
          bash "$PQ_OUT/run-command.sh" clippy cargo +1.95.0 clippy --locked --manifest-path trillionnium/Cargo.toml -p trnm-pon-node --lib --tests --all-features -- -D warnings
      - name: Observe complete component costs with unchanged native budgets
        if: ${{ !cancelled() && steps.pq_build.outcome == 'success' }}
        shell: bash
        run: |
          set -euo pipefail
          export TRNM_PQ_AUTH_COST_DIRECTORY="$PQ_OUT/pq-authentication-cost"
          export TRNM_NATIVE_ROOT_DIGEST_COST_OUTPUT="$PQ_OUT/native-root-digest-cost.jsonl"
          failed=0
          for selector in \
            store::history_page::tests::inline_record_tests::history_inline_record_complete_call_cost \
            ingress::public_v3::pq_identity::verifier_cache::tests::pq_caller_authentication_complete_cost \
            account_archive_prototype::native_root_digest::tests::native_root_digest_paired_complete_root_cost_observation; do
            label="cost-${selector##*::}"
            if ! bash "$PQ_OUT/run-command.sh" "$label" cargo +1.95.0 test --locked --manifest-path trillionnium/Cargo.toml -p trnm-pon-node --lib --all-features "$selector" -- --exact --ignored --show-output --test-threads=1; then
              failed=1
            elif ! python3 scripts/ci/check_required_native_test.py "$PQ_OUT/$label.log" --test "$selector" > "$PQ_OUT/$label-execution.json"; then
              failed=1
            fi
          done
          selector=pon_commitment::unchanged_snapshot_tests::unchanged_snapshot_full_binding_cost
          label="cost-${selector##*::}"
          if ! bash "$PQ_OUT/run-command.sh" "$label" cargo +1.95.0 test --locked --manifest-path trillionnium/Cargo.toml -p trnm-mvcc-fee --lib "$selector" -- --exact --ignored --show-output --test-threads=1; then
            failed=1
          elif ! python3 scripts/ci/check_required_native_test.py "$PQ_OUT/$label.log" --test "$selector" > "$PQ_OUT/$label-execution.json"; then
            failed=1
          fi
          test "$failed" = 0
      - name: Preserve complete records including failures
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: pq-system-${{ matrix.runner }}-${{ matrix.source }}-${{ github.event.pull_request.head.sha }}-${{ github.run_attempt }}
          path: ${{ runner.temp }}/pq-system-records/
          if-no-files-found: error
          retention-days: 14

d44a2288c0ee0a20778df24cd69e9cc300fd8a75 blob 24989
name: PoN priority acceptance
on:
  push:
    branches:
      - fix/chain-six-axis-performance-20261103
  pull_request:
permissions:
  contents: read
concurrency:
  group: pon-priority-${{ github.ref }}
  # Retain an executing source's native evidence; the next candidate waits.
  cancel-in-progress: false
env:
  CI: "true"
  CARGO_INCREMENTAL: "0"
  CARGO_BUILD_JOBS: "2"
  RUST_TEST_THREADS: "1"
  PYTHONDONTWRITEBYTECODE: "1"
jobs:
  push-source-context:
    # Main is observed once when this resolver runs. Rerun the whole workflow;
    # failed-job-only retries cannot borrow a different attempt's source context.
    name: Freeze actual integration push source
    if: github.event_name == 'push'
    runs-on: ubuntu-24.04
    timeout-minutes: 10
    outputs:
      head: ${{ steps.resolve.outputs.head }}
      base: ${{ steps.resolve.outputs.base }}
      merge: ${{ steps.resolve.outputs.merge }}
      context: ${{ steps.resolve.outputs.context }}
      context_sha256: ${{ steps.resolve.outputs.context_sha256 }}
    steps:
      - name: Checkout the immutable push after object
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ github.sha }}
          fetch-depth: 0
          persist-credentials: false
      - name: Freeze the real push and current main without a PR identity
        id: resolve
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/ci/integration_push_source.py resolve --output "$RUNNER_TEMP/integration-push-source/context.json"
      - name: Require source-context refusal controls and unchanged resolver bytes
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/ci/test_integration_push_source.py 2>&1 | tee "$RUNNER_TEMP/integration-push-source/controls.log"
          python3 scripts/ci/verify_ci_source.py --kind head --expected-head "$GITHUB_SHA" --output "$RUNNER_TEMP/integration-push-source/source-after-controls.json"
      - name: Preserve resolved and failed push context
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: integration-push-source-${{ github.run_id }}-${{ github.run_attempt }}
          path: ${{ runner.temp }}/integration-push-source/
          if-no-files-found: error
          retention-days: 30
  retained-pressure-failure:
    runs-on: ubuntu-24.04
    timeout-minutes: 10
    permissions:
      contents: read
      actions: read
    steps:
      - name: Retrieve exact historical failed artifact without reclassifying it
        uses: actions/download-artifact@634f93cb2916e3fdff6788551b99b062d0335ce0
        with:
          artifact-ids: "11531476198"
          run-id: "37730166589"
          github-token: ${{ github.token }}
          path: ${{ runner.temp }}/historical-pressure
      - name: Expose bounded original honest-submit and state diagnostics
        shell: bash
        run: |
          python3 - <<'PY'
          import json, os
          from pathlib import Path
          root = Path(os.environ['RUNNER_TEMP']) / 'historical-pressure'
          source = json.loads((root / 'source.json').read_text())
          assert source['tested_commit'] == '560d44ac28fee7b073d1740e372839ab52f057b6'
          path = root / 'public-v3-from-zero-suite/sustained/report.json'
          assert path.stat().st_size <= 64 * 1024 * 1024
          report = json.loads(path.read_text())
          assert report['schema'] == 'public-v3-sustained-local-from-zero-v1'
          print(json.dumps({'scope': 'immutable historical failure, not current acceptance', 'source': source}))
          for phase in report['phases']:
              result = {key: phase.get(key) for key in (
                  'phase', 'service_target_met', 'invariant_target_met',
                  'full_native_state_equal', 'honest_submissions',
                  'post_pressure_head', 'initial_meter', 'meter_at_traffic_end',
                  'budget_depletion_observed', 'service')}
              text = json.dumps(result, sort_keys=True)
              assert len(text.encode()) <= 256 * 1024
              print(text)
          PY
  native-priorities:
    needs: push-source-context
    if: ${{ !cancelled() && (github.event_name == 'pull_request' || needs.push-source-context.result == 'success') }}
    name: native priorities (${{ matrix.runner }}, ${{ matrix.source }}, ${{ matrix.campaign }})
    runs-on: ${{ matrix.runner }}
    # ARM full-capacity advances about 215 seconds per height; 100 minutes expired during height 20.
    # Use the repository's existing 180-minute rust-baseline budget without changing any gate.
    timeout-minutes: 180
    strategy:
      fail-fast: false
      matrix:
        runner: [ubuntu-24.04, ubuntu-24.04-arm]
        source: [head, prospective-merge]
        # Keep the original full-capacity work separate from short service/model
        # regressions and the original long-history experiment. All three run
        # separately for each architecture/source; none replaces another gate.
        campaign: [service-model, state, history]
    env:
      EXPECTED_HEAD: ${{ github.event_name == 'push' && needs.push-source-context.outputs.head || github.event.pull_request.head.sha }}
      EXPECTED_BASE: ${{ github.event_name == 'push' && needs.push-source-context.outputs.base || github.event.pull_request.base.sha }}
      EXPECTED_MERGE: ${{ github.event_name == 'push' && needs.push-source-context.outputs.merge || github.sha }}
      SOURCE_KIND: ${{ matrix.source }}
      TRNM_EXPECTED_SOURCE_SHA: ${{ matrix.source == 'head' && (github.event_name == 'push' && needs.push-source-context.outputs.head || github.event.pull_request.head.sha) || (github.event_name == 'push' && needs.push-source-context.outputs.merge || github.sha) }}
    steps:
      - name: Checkout the exact candidate or the actual PR target merge
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ github.event_name == 'push' && needs.push-source-context.outputs.head || (matrix.source == 'head' && github.event.pull_request.head.sha || github.sha) }}
          fetch-depth: 0
          persist-credentials: false
      - name: Reproduce the frozen integration-push source
        if: github.event_name == 'push'
        env:
          PUSH_SOURCE_CONTEXT: ${{ needs.push-source-context.outputs.context }}
          PUSH_SOURCE_CONTEXT_SHA256: ${{ needs.push-source-context.outputs.context_sha256 }}
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/ci/integration_push_source.py materialize --kind "$SOURCE_KIND" --context-json "$PUSH_SOURCE_CONTEXT" --context-sha256 "$PUSH_SOURCE_CONTEXT_SHA256" --output "$RUNNER_TEMP/integration-push-context.json"
      - name: Verify source and original project boundary
        id: source
        shell: bash
        run: |
          set -euo pipefail
          export TRNM_CI_RECEIPT_DIR="$RUNNER_TEMP/priority-observations"
          mkdir -p "$TRNM_CI_RECEIPT_DIR"
          printf 'TRNM_CI_RECEIPT_DIR=%s\n' "$TRNM_CI_RECEIPT_DIR" >> "$GITHUB_ENV"
          printf 'CARGO_HOME=%s/cargo-priority\n' "$RUNNER_TEMP" >> "$GITHUB_ENV"
          printf 'CARGO_TARGET_DIR=%s/target-priority\n' "$RUNNER_TEMP" >> "$GITHUB_ENV"
          args=(--kind "$SOURCE_KIND" --expected-head "$EXPECTED_HEAD")
          if [ "$SOURCE_KIND" = prospective-merge ]; then
            args+=(--expected-base "$EXPECTED_BASE" --expected-merge "$EXPECTED_MERGE")
          fi
          python3 scripts/ci/verify_ci_source.py "${args[@]}" --output "$TRNM_CI_RECEIPT_DIR/source.json"
          bash scripts/project-preflight.sh --audit
      - name: Install the source-pinned native toolchain
        id: toolchain
        run: rustup toolchain install 1.95.0 --profile minimal --component rustfmt --component clippy
      - name: Execute original window owner and context-bound consumer controls
        if: ${{ !cancelled() && steps.source.outcome == 'success' && steps.toolchain.outcome == 'success' && matrix.campaign == 'service-model' }}
        shell: bash
        run: |
          set -euo pipefail
          python3 -m venv "$RUNNER_TEMP/model-context-env"
          "$RUNNER_TEMP/model-context-env/bin/python" -m pip install --disable-pip-version-check --only-binary=:all: -r formal/pon-nakamoto-v1/requirements.txt
          "$RUNNER_TEMP/model-context-env/bin/python" formal/pon-nakamoto-v1/test_model_window_history.py -v 2>&1 | tee "$TRNM_CI_RECEIPT_DIR/model-window-original.log"
          "$RUNNER_TEMP/model-context-env/bin/python" formal/pon-nakamoto-v1/test_model_consumer_context.py -v 2>&1 | tee "$TRNM_CI_RECEIPT_DIR/model-consumer-context.log"
          "$RUNNER_TEMP/model-context-env/bin/python" formal/pon-nakamoto-v1/test_model_generation_sequence.py -v 2>&1 | tee "$TRNM_CI_RECEIPT_DIR/model-generation-sequence.log"
          grep -E '^Ran 7 tests in ' "$TRNM_CI_RECEIPT_DIR/model-generation-sequence.log"
          "$RUNNER_TEMP/model-context-env/bin/python" formal/pon-nakamoto-v1/test_model_generation_sequence_context.py -v 2>&1 | tee "$TRNM_CI_RECEIPT_DIR/model-generation-context.log"
          grep -E '^Ran 8 tests in ' "$TRNM_CI_RECEIPT_DIR/model-generation-context.log"
      - name: Execute original release from-zero controls
        if: ${{ !cancelled() && steps.source.outcome == 'success' && steps.toolchain.outcome == 'success' && matrix.campaign == 'service-model' }}
        run: python3 scripts/ci/run_from_zero_host.py -- python3 scripts/ci/run_from_zero_native.py --out "$TRNM_CI_RECEIPT_DIR/from-zero-native"
      - name: Execute actual CLI observation boundaries and retain every child result
        if: ${{ !cancelled() && steps.source.outcome == 'success' && steps.toolchain.outcome == 'success' && matrix.campaign == 'service-model' }}
        shell: bash
        run: |
          set -euo pipefail
          export PUBLIC_REQUEST_OBSERVATION_CLI_EVIDENCE_DIR="$TRNM_CI_RECEIPT_DIR/observation-cli"
          mkdir -p "$PUBLIC_REQUEST_OBSERVATION_CLI_EVIDENCE_DIR"
          for selector in \
            actual_opt_in_capture_and_default_output_keep_the_same_public_context \
            retention_loss_is_explicit_and_pre_join_kill_does_not_publish_completion \
            option_and_create_new_nofollow_refusals_precede_node_open \
            configured_capacity_crosses_previous_limit_and_keeps_exact_current_maximum \
            post_join_output_failure_preserves_service_facts_and_native_store \
            joined_miner_failure_still_exports_facts_before_error_propagation; do
            log="$TRNM_CI_RECEIPT_DIR/observation-$selector.log"
            cargo +1.95.0 test --release --locked --manifest-path trillionnium/Cargo.toml -p trnm-pon-node --test public_v3_observation_cli "$selector" -- --exact --show-output 2>&1 | tee "$log"
            python3 scripts/ci/check_required_native_test.py "$log" --test "$selector"
          done
      - name: Execute isolated original debug pressure regression
        if: ${{ !cancelled() && steps.source.outcome == 'success' && steps.toolchain.outcome == 'success' && matrix.campaign == 'service-model' }}
        shell: bash
        run: |
          set -euo pipefail
          export TRNM_PUBLIC_V3_FROM_ZERO_DIR="$TRNM_CI_RECEIPT_DIR/debug-from-zero"
          cargo +1.95.0 test --locked --manifest-path trillionnium/Cargo.toml -p trnm-pon-node --test public_v3_from_zero from_zero_service_shares_cpu_with_honest_work_and_reopened_owner -- --exact --show-output 2>&1 | tee "$TRNM_CI_RECEIPT_DIR/debug-pressure.log"
          python3 scripts/ci/check_required_native_test.py "$TRNM_CI_RECEIPT_DIR/debug-pressure.log" --test from_zero_service_shares_cpu_with_honest_work_and_reopened_owner
          python3 - "$TRNM_PUBLIC_V3_FROM_ZERO_DIR" <<'PY'
          import json, sys
          from pathlib import Path
          sys.path.insert(0, 'scripts/ci')
          from run_from_zero_native import validate_service_report, validate_sustained_report
          root = Path(sys.argv[1])
          print(json.dumps({'finite': validate_service_report(root / 'report.json'),
                            'sustained': validate_sustained_report(root / 'sustained/report.json')}))
          PY
      - name: Execute original public service cancellation and actual CPU accounting controls
        if: ${{ !cancelled() && steps.source.outcome == 'success' && steps.toolchain.outcome == 'success' && matrix.campaign == 'service-model' }}
        shell: bash
        run: |
          set -euo pipefail
          cargo +1.95.0 test --locked --manifest-path trillionnium/Cargo.toml -p trnm-pon-node --lib 'ingress::public_v3::' -- --show-output 2>&1 | tee "$TRNM_CI_RECEIPT_DIR/resource-controls.log"
          grep -E '^test ingress::public_v3::scalar_cpu::request_owned_reserve_tests::.* \.\.\. ok$' "$TRNM_CI_RECEIPT_DIR/resource-controls.log" > "$TRNM_CI_RECEIPT_DIR/reserve-selectors.log"
          test "$(wc -l < "$TRNM_CI_RECEIPT_DIR/reserve-selectors.log")" -eq 9
          grep -E '^test ingress::public_v3::scalar_cpu::final_samples_tests::.* \.\.\. ok$' "$TRNM_CI_RECEIPT_DIR/resource-controls.log" > "$TRNM_CI_RECEIPT_DIR/final-sample-selectors.log"
          test "$(wc -l < "$TRNM_CI_RECEIPT_DIR/final-sample-selectors.log")" -eq 4
          grep -E '^test result: ok\. [1-9][0-9]* passed; 0 failed;' "$TRNM_CI_RECEIPT_DIR/resource-controls.log"
      - name: Reject valid W1 state-root replay without durable admission
        if: ${{ !cancelled() && steps.source.outcome == 'success' && steps.toolchain.outcome == 'success' && matrix.campaign == 'service-model' }}
        shell: bash
        run: |
          set -euo pipefail
          selector=valid_work_state_root_replays_are_paid_without_admission
          log="$TRNM_CI_RECEIPT_DIR/valid-work-root-rejection.log"
          cargo +1.95.0 test --release --locked --manifest-path trillionnium/Cargo.toml -p trnm-pon-node --test public_v3_multiprocess "$selector" -- --exact --show-output --test-threads=1 2>&1 | tee "$log"
          python3 scripts/ci/check_required_native_test.py "$log" --test "$selector"
      - name: Require actual shared CPU depletion and native public recovery
        if: ${{ !cancelled() && steps.source.outcome == 'success' && steps.toolchain.outcome == 'success' && matrix.campaign == 'service-model' }}
        shell: bash
        run: |
          set -euo pipefail
          export TRNM_PUBLIC_V3_DEPLETION_DIR="$TRNM_CI_RECEIPT_DIR/actual-cpu-depletion"
          selector=actual_depletion::actual_replay_depletion_public_recovery_and_same_epoch_reopen
          cargo +1.95.0 test --release --locked --manifest-path trillionnium/Cargo.toml -p trnm-pon-node --test public_v3_request_accounting "$selector" -- --exact --show-output 2>&1 | tee "$TRNM_CI_RECEIPT_DIR/actual-cpu-depletion.log"
          python3 scripts/ci/check_required_native_test.py "$TRNM_CI_RECEIPT_DIR/actual-cpu-depletion.log" --test "$selector"
          python3 - <<'PYDEPLETION'
          import json, os
          from pathlib import Path
          path = Path(os.environ['TRNM_PUBLIC_V3_DEPLETION_DIR']) / 'report.json'
          assert path.stat().st_size <= 4 * 1024 * 1024
          report = json.loads(path.read_text())
          assert report['schema'] == 'public-v3-actual-local-replay-depletion-v1'
          assert report['passed'] is True and len(report['rounds']) == 3
          for row in report['rounds']:
              assert row['local_pressure']['depletion_observed'] is True
              assert row['local_pressure']['cap_reached'] is False
              for key in ('honest_acknowledged', 'submit_on_time', 'head_on_time', 'active_packet_equal'):
                  assert row[key] is True
          for key in ('full_native_state_equal', 'reopen_state_equal', 'same_cpu_epoch_across_reopen'):
              assert report[key] is True
          for key in ('public_hostile_saturation_qualified', 'work_profile_qualified',
                      'resource_fairness_qualified', 'independent_accepted',
                      'physical_power_loss', 'production_activation'):
              assert report[key] is False
          print(json.dumps({'scope': report['scope'], 'rounds': 3, 'passed': True}))
          PYDEPLETION
      - name: Execute real native model lifecycle and adverse decisions
        if: ${{ !cancelled() && steps.source.outcome == 'success' && steps.toolchain.outcome == 'success' && matrix.campaign == 'service-model' }}
        shell: bash
        run: |
          set -euo pipefail
          cargo +1.95.0 test --release --locked --manifest-path trillionnium/Cargo.toml -p trnm-pon-node --test model_evidence_v3 --test model_composition_v4 -- --nocapture 2>&1 | tee "$TRNM_CI_RECEIPT_DIR/model-regressions.log"
