      "3874:                    )?",
      "3875:                    .snapshot;",
      "3876:                if self.state_backend == StateBackend::AuthenticatedV1 {",
      "3877:                    native_authenticated::verify_state_with_readback(",
      "3878:                        &self.db,",
      "3879:                        &self.settings,",
      "3880:                        cur,",
      "3881:                        &state,",
      "3882:                        progress,",
      "3883:                        Some(&self.authenticated_arithmetic),",
      "3884:                        readback.as_deref_mut(),",
      "3885:                    )?;",
      "3886:                }",
      "3887:                break (state, commitment);",
      "3888:            }",
      "3889:            path.push(cur)?;",
      "3890:            count = count.checked_add(1).ok_or(\"ANCESTRY_LIMIT\")?;",
      "3891:            cur = self.parent(cur)?;",
      "3892:        };",
      "3893:        for replay_index in 0..count {",
      "3894:            progress()?;",
      "3895:            let id = path.pop()?.ok_or(\"ANCESTRY_LIMIT\")?;",
      "3896:            for (index, (key, before, after)) in self",
      "3897:                .delta_rows_with_progress(id, progress)?",
      "3898:                .into_iter()",
      "3899:                .enumerate()",
      "3900:            {",
      "3901:                if index.is_multiple_of(256) {",
      "3902:                    progress()?;",
      "3903:                }",
      "3904:                ensure(",
      "3905:                    state.get(&key).map(canonical).transpose()? == before,",
      "3906:                    \"UNDO_ROOT\",",
      "3907:                )",
      "3908:                .map_err(Error::local_integrity)?;",
      "3909:                if let Some(bytes) = after {",
      "3910:                    state.insert(",
      "3911:                        key,",
      "3912:                        serde_json::from_slice(&bytes)",
      "3913:                            .map_err(|error| Error::from(error).local_integrity())?,",
      "3914:                    );",
      "3915:                } else {",
      "3916:                    state.remove(&key);",
      "3917:                }",
      "3918:            }",
      "3919:            commitment = self",
      "3920:                .checked_historical_commitment(",
      "3921:                    id,",
      "3922:                    &state,",
      "3923:                    self.record(id)?.root,",
      "3924:                    commitment.as_ref(),",
      "3925:                    prefer_replay_prefix && replay_index < 6,",
      "3926:                )?",
      "3927:                .snapshot;",
      "3928:            continuity_v1::check_state(&state, self.record(id)?.height, &self.settings.app)",
      "3929:                .map_err(|error| Error::from(error).local_integrity())?;",
      "3930:            if self.state_backend == StateBackend::AuthenticatedV1 {",
      "3931:                native_authenticated::verify_state_with_readback(",
      "3932:                    &self.db,",
      "3933:                    &self.settings,",
      "3934:                    id,",
      "3935:                    &state,",
      "3936:                    progress,",
      "3937:                    Some(&self.authenticated_arithmetic),",
      "3938:                    readback.as_deref_mut(),",
