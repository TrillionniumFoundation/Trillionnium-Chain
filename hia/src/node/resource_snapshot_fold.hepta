block available(ki:readbuf,ko:mutbuf,ka:mutbuf,kp:usize,ktc:u64,kti:u64,kgc:u64,kgi:u64,kcc:u64,kci:u64,klc:u64,kli:u64)
  free_c:bool = compare.le(kcc,klc)
  free_i:bool = compare.le(kci,kli)
  has_free:bool = bool.and(free_c,free_i)
  branch has_free present(ki,ko,ka,kp,ktc,kti,kgc,kgi,kcc,kci,klc,kli) unavailable(ki,ko,ka,kp,ktc,kti,kgc,kgi)
block present(yi:readbuf,yo:mutbuf,ya:mutbuf,yp:usize,ytc:u64,yti:u64,ygc:u64,ygi:u64,ycc:u64,yci:u64,ylc:u64,yli:u64)
  some:u64 = const() {"value":1}
  some_at_offset:usize = const() {"value":64}
  some_at:usize = int.add.wrap(yp,some_at_offset)
  _some:u32 = call(ya,some_at,some) {"function":"cw_store64"}
  avail_c:u64 = int.sub.wrap(ylc,ycc)
  avail_i:u64 = int.sub.wrap(yli,yci)
  avail_c_at_offset:usize = const() {"value":72}
  avail_c_at:usize = int.add.wrap(yp,avail_c_at_offset)
  _available_cpu:u32 = call(ya,avail_c_at,avail_c) {"function":"cw_store64"}
  avail_i_at_offset:usize = const() {"value":80}
  avail_i_at:usize = int.add.wrap(yp,avail_i_at_offset)
  _available_io:u32 = call(ya,avail_i_at,avail_i) {"function":"cw_store64"}
  jump next_lane(yi,yo,ya,yp,ytc,yti,ygc,ygi)
block unavailable(vi2:readbuf,vo2:mutbuf,va2:mutbuf,vp2:usize,vtc:u64,vti:u64,vgc:u64,vgi:u64)
  fallback_off:usize = const() {"value":312}
  fallback_word:u64 = const() {"value":1}
  _unavailable:u32 = call(va2,fallback_off,fallback_word) {"function":"cw_store64"}
  jump next_lane(vi2,vo2,va2,vp2,vtc,vti,vgc,vgi)
block next_lane(ni:readbuf,no:mutbuf,na:mutbuf,np:usize,ntc:u64,nti:u64,ngc:u64,ngi:u64)
  next_lane_pos_offset:usize = const() {"value":104}
  next_lane_pos:usize = int.add.wrap(np,next_lane_pos_offset)
  lanes_end:usize = const() {"value":312}
  last_lane:bool = compare.eq(next_lane_pos,lanes_end)
  branch last_lane bound(ni,no,na,ntc,nti,ngc,ngi) lane_sum(ni,no,na,next_lane_pos,ntc,nti,ngc,ngi)
block bound(bi2:readbuf,bo2:mutbuf,ba2:mutbuf,btc:u64,bti:u64,bgc:u64,bgi:u64)
  header_at:usize = const() {"value":0}
  overshoot_c_at_offset:usize = const() {"value":64}
  overshoot_c_at:usize = int.add.wrap(header_at,overshoot_c_at_offset)
  overshoot_c:u64 = call(bi2,overshoot_c_at) {"function":"cw_read64"}
  overshoot_i_at_offset:usize = const() {"value":72}
  overshoot_i_at:usize = int.add.wrap(header_at,overshoot_i_at_offset)
  overshoot_i:u64 = call(bi2,overshoot_i_at) {"function":"cw_read64"}
  bound_cpu:u64 = int.add.wrap(bgc,overshoot_c)
  bound_io:u64 = int.add.wrap(bgi,overshoot_i)
  threshold_c:bool = compare.le(btc,bound_cpu)
  threshold_i:bool = compare.le(bti,bound_io)
  bounded:bool = bool.and(threshold_c,threshold_i)
  branch bounded bounded_result(bo2,ba2) output_size(bo2,ba2)
block bounded_result(uo2:mutbuf,ua2:mutbuf)
  bound_off:usize = const() {"value":320}
  bound_yes:u64 = const() {"value":1}
  _bound:u32 = call(ua2,bound_off,bound_yes) {"function":"cw_store64"}
  jump output_size(uo2,ua2)
block output_size(oo:mutbuf,oa:mutbuf)
  output_need:usize = const() {"value":328}
  output_available:usize = buffer.len(oo)
  output_p:usize = const() {"value":0}
  output_fits:bool = compare.ge(output_available,output_need)
  branch output_fits copy(oo,oa,output_p,output_need) short()
block copy(co2:mutbuf,ca2:mutbuf,cp2:usize,ce2:usize)
  byte_word:u64 = call(ca2,cp2) {"function":"cw_load64"}
  _output_write:u32 = call(co2,cp2,byte_word) {"function":"cw_store64"}
  next_copy_offset:usize = const() {"value":8}
  next_copy:usize = int.add.wrap(cp2,next_copy_offset)
  copy_done:bool = compare.eq(next_copy,ce2)
  branch copy_done success() copy(co2,ca2,next_copy,ce2)
block success()
  status_success:u32 = const() {"value":0}
  ret(status_success)
block bad()
  status_bad:u32 = const() {"value":1}
  ret(status_bad)
block short()
  status_short:u32 = const() {"value":2}
  ret(status_short)
block overflow()
  status_overflow:u32 = const() {"value":32}
  ret(status_overflow)
block missing()
  status_missing:u32 = const() {"value":33}
  ret(status_missing)
end
fn ns_add(a:mutbuf,p:usize,x:u64,y:u64) -> (bool) effects(read,write,trap) entry(entry)
block entry(a:mutbuf,p:usize,x:u64,y:u64)
  sum:u64 = int.add.wrap(x,y)
  ok:bool = compare.ge(sum,x)
  branch ok good(a,p,sum) no()
block good(ga:mutbuf,gp:usize,gs:u64)
  _sum:u32 = call(ga,gp,gs) {"function":"cw_store64"}
  yes:bool = const() {"value":true}
  ret(yes)
block no()
  never:bool = const() {"value":false}
  ret(never)
end
