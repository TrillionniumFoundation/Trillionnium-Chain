  left:u64 = bit.or(init,first)
  right:u64 = bit.or(second,third)
  all:u64 = bit.or(left,right)
  ret(all)
end

fn dpp_publish(w:mutbuf,o:mutbuf,from:u64,dest:u64,n:u64) -> (u64) effects(read,write,trap) entry(entry)
block entry(w:mutbuf,o:mutbuf,from:u64,dest:u64,n:u64)
  zero:u64 = const() {"value":0}
  jump next(w,o,from,dest,n,zero)
block next(ww:mutbuf,oo:mutbuf,f:u64,d:u64,k:u64,i:u64)
  more:bool = compare.lt(i,k)
  branch more byte(ww,oo,f,d,k,i) done()
block byte(wb:mutbuf,ob:mutbuf,fb:u64,db:u64,kb:u64,ib:u64)
  rawf:u64 = int.add.wrap(fb,ib)
  rawd:u64 = int.add.wrap(db,ib)
  sa:usize = int.cast(rawf) {"mode":"wrap"}
  da:usize = int.cast(rawd) {"mode":"wrap"}
  b:u8 = buffer.load(wb,sa)
  _ = buffer.store(ob,da,b)
  one:u64 = const() {"value":1}
  step:u64 = int.add.wrap(ib,one)
  jump next(wb,ob,fb,db,kb,step)
block done()
  ok:u64 = const() {"value":0}
  ret(ok)
end

fn dpp_committee(r:readbuf,w:mutbuf,n:u64) -> (u32) effects(read,write,trap) entry(entry)
block entry(r:readbuf,w:mutbuf,n:u64)
  min:u64 = const() {"value":133}
  max:u64 = const() {"value":1048576}
  enough:bool = compare.ge(n,min)
  bounded:bool = compare.le(n,max)
  good:bool = bool.and(enough,bounded)
  branch good header(r,w,n) shape()
block header(r1:readbuf,w1:mutbuf,n1:u64)
  len_at:u64 = const() {"value":36}
  len:u64 = call(r1,len_at) {"function":"daav_u32"}
  min1:u64 = const() {"value":133}
  room:u64 = int.sub.wrap(n1,min1)
  fit:bool = compare.le(len,room)
  branch fit context_version(r1,w1,n1,len) shape()
block context_version(rv:readbuf,wv:mutbuf,nv:u64,lenv:u64)
  schema_at:u64 = const() {"value":2}
  schema_mask:u64 = const() {"value":65535}
  startv:u64 = const() {"value":40}
  version_at:u64 = int.add.wrap(startv,lenv)
  schema:u64 = call(rv,schema_at,schema_mask) {"function":"dab_number"}
  protocol:u64 = call(rv,version_at) {"function":"daav_u32"}
  onev:u64 = const() {"value":1}
  same_s:bool = compare.eq(schema,onev)
  same_p:bool = compare.eq(protocol,onev)
  valid_v:bool = bool.and(same_s,same_p)
  branch valid_v chain_shape(rv,wv,nv,lenv,startv) version_error()
block chain_shape(rp:readbuf,wp:mutbuf,np:u64,lenp:u64,cp:u64)
  minp:u64 = const() {"value":1}
  maxp:u64 = const() {"value":128}
  lowp:bool = compare.ge(lenp,minp)
  highp:bool = compare.le(lenp,maxp)
  valid_p:bool = bool.and(lowp,highp)
  branch valid_p chain_content(rp,wp,np,lenp,cp) chain_error()
block chain_content(rq:readbuf,wq:mutbuf,nq:u64,lenq:u64,cq:u64)
  ascii_q:bool = call(rq,cq,lenq) {"function":"dab_ascii"}
  branch ascii_q namespace(rq,wq,nq,lenq) chain_error()
block namespace(rt:readbuf,wt:mutbuf,nt:u64,lent:u64)
  nt_bias:u64 = const() {"value":76}
  ns_at:u64 = int.add.wrap(lent,nt_bias)
  ns_at_us:usize = int.cast(ns_at) {"mode":"wrap"}
  kind:u8 = buffer.load(rt,ns_at_us)
  allowed:u8 = const() {"value":0}
  is_tx:bool = compare.eq(kind,allowed)
  branch is_tx bounds(rt,wt,nt,lent) namespace_error(kind)
block bounds(ru:readbuf,wu:mutbuf,nu:u64,lenu:u64)
  tail:u64 = const() {"value":28}
  bounds_at:u64 = int.sub.wrap(nu,tail)
  valid_u:bool = call(ru,bounds_at) {"function":"dai_bounds"}
  branch valid_u rows(ru,wu,nu,lenu) bounds_error()
block rows(r2:readbuf,w2:mutbuf,n2:u64,len2:u64)
  bias2:u64 = const() {"value":85}
  count_at:u64 = int.add.wrap(len2,bias2)
  count:u64 = call(r2,count_at) {"function":"daav_u32"}
  floor2:u64 = const() {"value":0}
  empty:bool = compare.eq(count,floor2)
  branch empty empty_shape(n2,count_at) capacity(r2,w2,n2,count_at,count)
block empty_shape(total_empty:u64,count_empty:u64)
  after_count_and_tail:u64 = const() {"value":48}
  exact_empty:u64 = int.add.wrap(count_empty,after_count_and_tail)
  empty_fits:bool = compare.eq(exact_empty,total_empty)
  branch empty_fits bad_empty() shape()
block capacity(r3:readbuf,w3:mutbuf,n3:u64,at3:u64,count3:u64)
  max3:u64 = const() {"value":32}
  cap3:usize = const() {"value":141536}
  actual3:usize = buffer.len(w3)
  good3:bool = compare.le(count3,max3)
  scratch3:bool = compare.ge(actual3,cap3)
  branch good3 work(r3,w3,n3,at3,count3,scratch3) shape()
block work(r4:readbuf,w4:mutbuf,n4:u64,at4:u64,count4:u64,room4:bool)
  plus4:u64 = const() {"value":4}
  tail4:u64 = const() {"value":44}
  start4:u64 = int.add.wrap(at4,plus4)
  end4:u64 = int.sub.wrap(n4,tail4)
  branch room4 loop(r4,w4,n4,start4,end4,count4) short()
block loop(r5:readbuf,w5:mutbuf,len5:u64,start5:u64,end5:u64,count5:u64)
  z5:u64 = const() {"value":0}
  jump member(r5,w5,len5,start5,end5,count5,z5,z5,z5,z5)
block member(r6:readbuf,w6:mutbuf,len6:u64,at6:u64,end6:u64,count6:u64,i6:u64,prev6:u64,lo6:u64,hi6:u64)
  hash6:u64 = call(r6,at6,end6) {"function":"dac_member_extent"}
  z6:u64 = const() {"value":0}
  good6:bool = compare.ne(hash6,z6)
  branch good6 checked(r6,w6,len6,at6,end6,count6,i6,prev6,lo6,hi6,hash6) shape()
block checked(r7:readbuf,w7:mutbuf,len7:u64,at7:u64,end7:u64,count7:u64,i7:u64,prev7:u64,lo7:u64,hi7:u64,hash7:u64)
  verdict:u32 = call(r7,w7,at7,hash7) {"function":"dac_member"}
  z7:u32 = const() {"value":0}
  valid7:bool = compare.eq(verdict,z7)
  branch valid7 ordering(r7,w7,len7,at7,end7,count7,i7,prev7,lo7,hi7,hash7) code(verdict)
block ordering(r8:readbuf,w8:mutbuf,len8:u64,at8:u64,end8:u64,count8:u64,i8:u64,prev8:u64,lo8:u64,hi8:u64,hash8:u64)
  z8:u64 = const() {"value":0}
  first8:bool = compare.eq(i8,z8)
  branch first8 unique(r8,w8,len8,at8,end8,count8,i8,lo8,hi8,hash8) ordered(r8,w8,len8,at8,end8,count8,i8,prev8,lo8,hi8,hash8)
block ordered(r9:readbuf,w9:mutbuf,len9:u64,at9:u64,end9:u64,count9:u64,i9:u64,prev9:u64,lo9:u64,hi9:u64,hash9:u64)
  asc9:bool = call(r9,prev9,hash9) {"function":"dac_lex_less"}
  branch asc9 unique(r9,w9,len9,at9,end9,count9,i9,lo9,hi9,hash9) order_error()
block unique(ra:readbuf,wa:mutbuf,lena:u64,ata:u64,enda:u64,counta:u64,ia:u64,loa:u64,hia:u64,hasha:u64)
  ka:u64 = const() {"value":2}
  keya:u64 = int.add.wrap(ata,ka)
  okay:bool = call(ra,wa,keya,ia) {"function":"dac_store_unique"}
  branch okay add_weight(ra,wa,lena,ata,enda,counta,ia,loa,hia,hasha) order_error()
block add_weight(rb:readbuf,wb:mutbuf,lenb:u64,atb:u64,endb:u64,countb:u64,ib:u64,lob:u64,hib:u64,hashb:u64)
  d1:u64 = const() {"value":34}
  d2:u64 = const() {"value":42}
  p1:u64 = int.add.wrap(atb,d1)
  p2:u64 = int.add.wrap(atb,d2)
  a:u64 = call(rb,p1) {"function":"tr_read"}
  b:u64 = call(rb,p2) {"function":"tr_read"}
  lo:u64 = int.add.wrap(lob,a)
  carry_b:bool = compare.lt(lo,lob)
  one:u64 = const() {"value":1}
  zero:u64 = const() {"value":0}
  carry:u64 = select(carry_b,one,zero)
  h:u64 = int.add.wrap(hib,b)
  hi:u64 = int.add.wrap(h,carry)
  overflow1:bool = compare.lt(h,hib)
  overflow2:bool = compare.lt(hi,h)
  overflow:bool = bool.or(overflow1,overflow2)
  branch overflow sum_error() advance(rb,wb,lenb,endb,countb,ib,hashb,lo,hi)
block advance(rc:readbuf,wc:mutbuf,lenc:u64,endc:u64,countc:u64,ic:u64,hashc:u64,loc:u64,hic:u64)
  onec:u64 = const() {"value":1}
  hash_bytes:u64 = const() {"value":32}
  nextc:u64 = int.add.wrap(ic,onec)
  movec:u64 = int.add.wrap(hashc,hash_bytes)
  morec:bool = compare.lt(nextc,countc)
  branch morec member(rc,wc,lenc,movec,endc,countc,nextc,hashc,loc,hic) extent(rc,wc,lenc,endc,movec,loc,hic)
block extent(rd:readbuf,wd:mutbuf,lend:u64,endd:u64,prevd:u64,lod:u64,hid:u64)
  exactd:bool = compare.eq(prevd,endd)
  branch exactd threshold(rd,wd,lend,endd,lod,hid) shape()
block threshold(re:readbuf,we:mutbuf,ne:u64,ende:u64,loe:u64,hie:u64)
  max_re:u64 = const() {"value":9223372036854775807}
  fits_re:bool = compare.le(hie,max_re)
  branch fits_re expected(re,we,ne,ende,loe,hie) arithmetic_error()
block expected(rx:readbuf,wx:mutbuf,nx:u64,endx:u64,lox:u64,hix:u64)
  base_x:u64 = const() {"value":140512}
  hi_x:u64 = const() {"value":140520}
  eight_x:u64 = const() {"value":8}
  high_at_x:u64 = int.add.wrap(endx,eight_x)
  _threshold:u64 = call(wx,base_x,lox,hix) {"function":"dac_threshold"}
  should_low:u64 = call(wx,base_x) {"function":"tr_get"}
  should_hi:u64 = call(wx,hi_x) {"function":"tr_get"}
  got_low:u64 = call(rx,endx) {"function":"tr_read"}
  got_hi:u64 = call(rx,high_at_x) {"function":"tr_read"}
  low_same:bool = compare.eq(should_low,got_low)
  hi_same:bool = compare.eq(should_hi,got_hi)
  same_x:bool = bool.and(low_same,hi_same)
  branch same_x digest(rx,wx,nx) threshold_error()
block digest(rz:readbuf,wz:mutbuf,nz:u64)
  z_z:u64 = const() {"value":0}
  a_z:u64 = call(wz) {"function":"tr_sha_init"}
  b_z:u64 = call(wz) {"function":"dai_domain"}
  c_z:u64 = call(rz,z_z,nz,wz) {"function":"tr_sha_update"}
  d_z:u64 = call(wz) {"function":"tr_sha_final"}
  l_z:u64 = bit.or(a_z,b_z)
  h_z:u64 = bit.or(c_z,d_z)
  all_z:u64 = bit.or(l_z,h_z)
  okay_z:bool = compare.eq(all_z,z_z)
  branch okay_z publish() internal()
block publish()
  okay_s:u32 = const() {"value":0}
  ret(okay_s)
block shape()
  shape_c:u32 = const() {"value":100}
  ret(shape_c)
block short()
  short_c:u32 = const() {"value":102}
  ret(short_c)
block internal()
