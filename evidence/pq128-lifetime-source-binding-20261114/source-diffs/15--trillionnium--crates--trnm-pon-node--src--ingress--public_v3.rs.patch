+        &intake.read_grants,
+        &intake.body_pool,
+    )?
+    else {
+        return Ok(None);
+    };
+    let caller = caller
+        .map(|caller| intake.reserve_caller_mutation(caller))
+        .transpose()?;
+    Ok(Some((
+        PaidLanePermit {
+            _global: lane,
+            _caller: caller,
+        },
+        body,
+    )))
