  one_s:u64 = const() {"value":1}
  close:u64 = const() {"value":125}
  wrote:u64 = call(sw,sd,one_s,close) {"function":"value_word"}
  total:u64 = int.add.wrap(sd,wrote)
  length:u64 = int.sub.wrap(total,eight_s)
  capacity_n:usize = buffer.len(so)
  cap:u64 = int.cast(capacity_n) {"mode":"wrap"}
  good:bool = compare.le(total,cap)
