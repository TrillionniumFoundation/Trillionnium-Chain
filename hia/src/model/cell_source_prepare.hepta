fn sp_mask(i:readbuf) -> (bool) effects(read,trap) entry(entry)
block entry(i:readbuf)
  lo:usize = const() {"value":8}
  jump mask(i,lo)
block mask(mi:readbuf,mp:usize)
  b:u8 = buffer.load(mi,mp)
  one:u8 = const() {"value":1}
  within:bool = compare.le(b,one)
  branch within next(mi,mp,b) no()
block next(ni:readbuf,np:usize,nb:u8)
  last:usize = const() {"value":264}
  done:bool = compare.eq(np,last)
  one_step:usize = const() {"value":1}
  forward:usize = int.add.wrap(np,one_step)
  branch done yes(nb) mask(ni,forward)
block yes(y:u8)
  mask_on:u8 = const() {"value":1}
  bias:bool = compare.eq(y,mask_on)
  ret(bias)
block no()
  bad:bool = const() {"value":false}
  ret(bad)
end

fn sp_decode(i:readbuf,w:mutbuf,n:usize) -> (bool) effects(read,write,trap) entry(entry)
