# Trillionnium 200-step automation pipeline (parameterized)
# The historical 200 invocations are retained as fail-fast loops over canonical blocks.
# Protocol, benchmark, and security gates remain in their original order.

# Baseline protocol/benchmark gate block repeated eight times (steps 1-80)
bash -lc 'set -e; cd trillionnium; for _ in 1 2 3 4 5 6 7 8; do ./scripts/run_v1_protocol_gates.sh; PATH="/opt/homebrew/opt/rustup/bin:$PATH" cargo test --workspace --quiet; ./scripts/check_event_fields.sh; ./scripts/check_event_replay_smoke.sh; ./scripts/check_parallel_flaky.sh; ./scripts/run_bench_matrix.sh; ./scripts/run_bench_mixed_matrix.sh; ./scripts/run_bench_regression_matrix.sh; ./scripts/check_aggressive_regression.sh; ./scripts/testnet_preflight.sh; done'

# Challenge/demo/report/experiment block repeated five times (steps 81-140)
bash -lc 'set -e; for _ in 1 2 3 4 5; do bash ./scripts/challenge_reexec_template_smoke.sh; bash ./scripts/worker_onchain_contract_smoke.sh; bash ./scripts/demo_storyline.sh; (cd trillionnium && ./scripts/nightly_attribution.sh && python3 ./scripts/render_nightly_summary.py && python3 ./scripts/summarize_aggressive_profile.py && python3 ./scripts/executor_profile_report.py && ./scripts/enforce_ci_thresholds.sh && ./scripts/run_executor_strategy_experiment.sh && ./scripts/run_executor_hotspot_experiment.sh && ./scripts/run_hot_bucket_sweep.sh && ./scripts/run_auto_adaptive_threshold_sweep.sh); done'

# Regression/report/security block repeated four times (steps 141-200)
bash -lc 'set -e; for _ in 1 2 3 4; do (cd trillionnium && TXS_LIST="10000" KEYS_LIST="64 128 256 512 1024" ./scripts/run_bench_regression_matrix.sh && TXS_LIST="20000" KEYS_LIST="64 128 256 512 1024" ./scripts/run_bench_regression_matrix.sh && TXS_LIST="40000" KEYS_LIST="64 128 256 512 1024" ./scripts/run_bench_regression_matrix.sh && TXS_LIST="10000" KEYS_LIST="2000 1000 500 200 100" ./scripts/run_bench_regression_mixed_sweep.sh && TXS_LIST="20000" KEYS_LIST="2000 1000 500 200 100" ./scripts/run_bench_regression_mixed_sweep.sh && TXS_LIST="40000" KEYS_LIST="2000 1000 500 200 100" ./scripts/run_bench_regression_mixed_sweep.sh && python3 ./scripts/analyze_mixed_sweep_correlation.py && python3 ./scripts/analyze_aggressive_scan_correlation.py && python3 ./scripts/suggest_auto_adaptive_thresholds.py && ./scripts/check_nightly_green_streak.sh ProfAlexQI TrillionniumChain 3 && ./scripts/nightly_attribution.sh && python3 ./scripts/render_nightly_summary.py && python3 ./scripts/summarize_aggressive_profile.py && python3 ./scripts/executor_profile_report.py && ./scripts/testnet_preflight.sh); done'
