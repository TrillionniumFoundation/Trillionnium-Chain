+from pathlib import Path
+import json,os,sys,threading,time
+root=Path(sys.argv[1])
+def wait(name):
+    while not (root/name).exists(): time.sleep(0.0002)
+t=threading.Thread(target=lambda:wait('release-worker')); t.start()
