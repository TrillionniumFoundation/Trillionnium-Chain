  c32:u64 = const() {"value":32}
  same:bool = call(cr,cm,ce,at,c32) {"function":"smr_eq_bound"}
  branch same store(cr,cm,cs) bad()
block store(sr:readbuf,sm:mutbuf,si:u64)
  roots:u64 = const() {"value":441000}
  r_from:u64 = const() {"value":40}
  extent:u64 = const() {"value":32}
  off:u64 = int.mul.wrap(si,extent)
  to:u64 = int.add.wrap(roots,off)
  saved:u64 = call(sr,r_from,sm,to,extent) {"function":"cp_copy"}
