  at1:u64 = const() {"value":1216}
  word1:u64 = const() {"value":7451607104633074292}
  _dom1:u64 = call(work,at1,word1) {"function":"tr_put"}
  at2:u64 = const() {"value":1224}
  word2:u64 = const() {"value":7290886271549071730}
  _dom2:u64 = call(work,at2,word2) {"function":"tr_put"}
  at3:u64 = const() {"value":1232}
  word3:u64 = const() {"value":8030531063714377848}
  _dom3:u64 = call(work,at3,word3) {"function":"tr_put"}
  at4:u64 = const() {"value":1240}
  word4:u64 = const() {"value":813051511}
  _dom4:u64 = call(work,at4,word4) {"function":"tr_put"}
  dom_bytes:u64 = const() {"value":36}
  result_dom:u64 = call(work,at0,dom_bytes) {"function":"tr_sha_update_work"}
  zero:u64 = const() {"value":0}
  result_ns:u64 = call(input,work,zero,nlen) {"function":"r_part"}
  result_key:u64 = call(input,work,nlen,klen) {"function":"r_part"}
  result_val:u64 = call(input,work,val_at,vlen) {"function":"r_part"}
  result_final:u64 = call(work) {"function":"tr_sha_final"}
  st0:u64 = bit.or(result_init,result_dom)
  st1:u64 = bit.or(result_ns,result_key)
  st2:u64 = bit.or(result_val,result_final)
  st3:u64 = bit.or(st0,st1)
  all:u64 = bit.or(st3,st2)
  ok:bool = compare.eq(all,zero)
  ret(ok)
end

fn r_part(part_input:readbuf,part_work:mutbuf,offset:u64,length:u64) -> (u64) effects(read,write,trap) entry(entry)
