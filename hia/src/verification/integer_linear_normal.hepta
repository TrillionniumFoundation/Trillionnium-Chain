  jump measure(ai,ao,next,total)
block capacity(ci:readbuf,co:mutbuf,cl:u64)
  available:usize = buffer.len(co)
  count:usize = int.cast(cl) {"mode":"wrap"}
  enough:bool = compare.ge(available,count)
  branch enough report(ci,co,cl) capacity_error()
block report(ri:readbuf,ro:mutbuf,rl:u64)
  _prefix_end:usize = call(ro) {"function":"iln_prefix"}
  at0:usize = call(ri,ro) {"function":"iln_hex"}
  at1:usize = call(ro,at0) {"function":"iln_middle"}
  in0:usize = const() {"value":40}
  at2:usize = call(ri,ro,in0,at1) {"function":"iln_row"}
  at3:usize = call(ro,at2) {"function":"iln_comma"}
  in1:usize = const() {"value":1068}
  at4:usize = call(ri,ro,in1,at3) {"function":"iln_row"}
