  lim:u64 = const() {"value":16}
  aok:bool = compare.lt(a,lim)
  bok:bool = compare.lt(b,lim)
  ok:bool = bool.and(aok,bok)
  branch ok stage(pi,pw,after_first,pr,pe,a,b) no()
block stage(si:readbuf,sw:mutbuf,sp:usize,sr:usize,se:usize,sa:u64,sb:u64)
  four:u64 = const() {"value":4}
  nib:u64 = int.shl.checked(sa,four)
  word:u64 = bit.or(nib,sb)
  ch:u8 = int.cast(word) {"mode":"wrap"}
  _ = buffer.store(sw,sr,ch)
  one_step:usize = const() {"value":1}
  next_in:usize = int.add.wrap(sp,one_step)
  next_out:usize = int.add.wrap(sr,one_step)
  end:bool = compare.eq(next_in,se)
  branch end yes() pair(si,sw,next_in,next_out,se)
block yes()
  ok_flag:bool = const() {"value":true}
  ret(ok_flag)
block no()
