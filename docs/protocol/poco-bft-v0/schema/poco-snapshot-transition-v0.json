      },
      "payload": {
        "encoding": "CEV0",
        "fields": [
          {"name": "consumer_id", "type": "Bytes", "semantic": "id", "minimum_bytes": 1, "maximum_bytes": 128},
          {"name": "provider_id", "type": "Bytes", "semantic": "id", "minimum_bytes": 1, "maximum_bytes": 128},
          {"name": "task_id", "type": "Bytes", "semantic": "id", "minimum_bytes": 1, "maximum_bytes": 128},
          {"name": "output_commitment", "type": "Hash32", "exact_bytes": 32},
          {"name": "billing_start_height", "type": "u64"},
          {"name": "billing_end_height", "type": "u64"},
