fn ims_value_envelope(input:readbuf, start:u64, length:u64) -> (bool) effects(read,trap) entry(entry)
block entry(input:readbuf, start:u64, length:u64)
  four:u64 = const() {"value":4}
  five:u64 = const() {"value":5}
  nine:u64 = const() {"value":9}
  eight:u8 = const() {"value":8}
  want:u64 = const() {"value":827610698}
  magic:u64 = call(input,start,four) {"function":"rac_read_le"}
  tag_pos:u64 = int.add.wrap(start,four)
  tag_at:usize = int.cast(tag_pos) {"mode":"wrap"}
  tag:u8 = buffer.load(input,tag_at)
  decl_at:u64 = int.add.wrap(start,five)
  declared:u64 = call(input,decl_at,four) {"function":"rac_read_le"}
  expected:u64 = int.sub.wrap(length,nine)
  ok1:bool = compare.eq(magic,want)
  ok2:bool = compare.le(tag,eight)
  ok3:bool = compare.eq(declared,expected)
  a:bool = bool.and(ok1,ok2)
  yes:bool = bool.and(a,ok3)
  ret(yes)
end

fn ims_key_less(input:readbuf, previous:u64, pn:u64, next:u64, nn:u64) -> (bool) effects(read,trap) entry(entry)
block entry(input:readbuf, previous:u64, pn:u64, next:u64, nn:u64)
  prev_short:bool = compare.lt(pn,nn)
  common:u64 = select(prev_short,pn,nn)
  jump digits(input,previous,next,common,prev_short)
block digits(di:readbuf,dp:u64,dn:u64,dr:u64,ds:bool)
  z:u64 = const() {"value":0}
  more:bool = compare.ne(dr,z)
  branch more compare_bytes(di,dp,dn,dr,ds) final_order(ds)
block compare_bytes(ci:readbuf,cp:u64,cn:u64,cr:u64,cs:bool)
  at_p:usize = int.cast(cp) {"mode":"wrap"}
  at_n:usize = int.cast(cn) {"mode":"wrap"}
  p:u8 = buffer.load(ci,at_p)
  n:u8 = buffer.load(ci,at_n)
  equal:bool = compare.eq(p,n)
  less:bool = compare.lt(p,n)
  branch equal advance(ci,cp,cn,cr,cs) final_order(less)
block advance(ai:readbuf,ap:u64,an:u64,ar:u64,as:bool)
  one:u64 = const() {"value":1}
  np:u64 = int.add.wrap(ap,one)
  nn2:u64 = int.add.wrap(an,one)
  left:u64 = int.sub.wrap(ar,one)
  jump digits(ai,np,nn2,left,as)
block final_order(yes:bool)
  ret(yes)
end

fn ims_namespace(input:readbuf, key:u64, n:u64) -> (u64) effects(read,trap) entry(entry)
block entry(input:readbuf, key:u64, n:u64)
  prefix:u64 = const() {"value":81}
  long_enough:bool = compare.ge(n,prefix)
  branch long_enough common(input,key) other()
block common(fi:readbuf,fk:u64)
  eight:u64 = const() {"value":8}
  six:u64 = const() {"value":6}
  fourteen:u64 = const() {"value":14}
  two:u64 = const() {"value":2}
  b:u64 = int.add.wrap(fk,eight)
  c:u64 = int.add.wrap(fk,fourteen)
  a0:u64 = call(fi,fk,eight) {"function":"rac_read_le"}
  a1:u64 = call(fi,b,six) {"function":"rac_read_le"}
  a2:u64 = call(fi,c,two) {"function":"rac_read_le"}
  c0:u64 = const() {"value":7867069886725253484}
  c1:u64 = const() {"value":129937464190063}
  v2:u64 = const() {"value":14898}
  v3:u64 = const() {"value":14899}
  m0:bool = compare.eq(a0,c0)
  m1:bool = compare.eq(a1,c1)
  old:bool = compare.eq(a2,v2)
  newer:bool = compare.eq(a2,v3)
  m2:bool = bool.or(old,newer)
  shared:bool = bool.and(m0,m1)
  ok:bool = bool.and(shared,m2)
  tag2:u64 = const() {"value":2}
  tag3:u64 = const() {"value":3}
  tag:u64 = select(old,tag2,tag3)
  branch ok start_bytes(fi,fk,tag) other()
block start_bytes(si:readbuf,sk:u64,sv:u64)
  id_start:u64 = const() {"value":8}
  sixteen:u64 = const() {"value":16}
  hex_key:u64 = int.add.wrap(sk,sixteen)
  jump digits(si,id_start,hex_key,sv)
block digits(di:readbuf,dp:u64,dh:u64,dv:u64)
  stop:u64 = const() {"value":40}
  done:bool = compare.eq(dp,stop)
  branch done terminator(di,dh,dv) digit(di,dp,dh,dv)
block digit(gi:readbuf,gp:u64,gh:u64,gv:u64)
  one:u64 = const() {"value":1}
  two_g:u64 = const() {"value":2}
  shift:u64 = const() {"value":4}
  mask:u64 = const() {"value":15}
  high_at:usize = int.cast(gh) {"mode":"wrap"}
  low_off:u64 = int.add.wrap(gh,one)
  low_at:usize = int.cast(low_off) {"mode":"wrap"}
  by:usize = int.cast(gp) {"mode":"wrap"}
  value:u8 = buffer.load(gi,by)
  x:u64 = int.cast(value) {"mode":"wrap"}
  hn:u64 = int.shr.checked(x,shift)
  ln:u64 = bit.and(x,mask)
  hex_h:u8 = call(hn) {"function":"ims_hex"}
  hex_l:u8 = call(ln) {"function":"ims_hex"}
  found_h:u8 = buffer.load(gi,high_at)
  found_l:u8 = buffer.load(gi,low_at)
  h_ok:bool = compare.eq(hex_h,found_h)
  l_ok:bool = compare.eq(hex_l,found_l)
  matches:bool = bool.and(h_ok,l_ok)
  np:u64 = int.add.wrap(gp,one)
  nh:u64 = int.add.wrap(gh,two_g)
  branch matches digits(gi,np,nh,gv) other()
block terminator(ti:readbuf,tp:u64,tv:u64)
  at:usize = int.cast(tp) {"mode":"wrap"}
  colon:u8 = const() {"value":58}
  ch:u8 = buffer.load(ti,at)
  correct:bool = compare.eq(ch,colon)
  tag0:u64 = const() {"value":0}
  result:u64 = select(correct,tv,tag0)
  ret(result)
block other()
  none:u64 = const() {"value":0}
  ret(none)
end

fn ims_hex(n:u64) -> (u8) effects() entry(entry)
block entry(n:u64)
  nine:u64 = const() {"value":9}
  digit:bool = compare.le(n,nine)
  d:u64 = const() {"value":48}
  f:u64 = const() {"value":87}
  base:u64 = select(digit,d,f)
  ascii:u64 = int.add.wrap(base,n)
  result:u8 = int.cast(ascii) {"mode":"wrap"}
  ret(result)
end

fn ims_write(out:mutbuf, at:u64, value:u64) -> (u64) effects(write,trap) entry(entry)
block entry(out:mutbuf, at:u64, value:u64)
  zero:u64 = const() {"value":0}
  jump write(out,at,value,zero)
block write(wo:mutbuf,wp:u64,wv:u64,wn:u64)
  ix:usize = int.cast(wp) {"mode":"wrap"}
  byte:u8 = int.cast(wv) {"mode":"wrap"}
  _ = buffer.store(wo,ix,byte)
  one:u64 = const() {"value":1}
  eight:u64 = const() {"value":8}
  next_v:u64 = int.shr.checked(wv,eight)
  next_p:u64 = int.add.wrap(wp,one)
  next_n:u64 = int.add.wrap(wn,one)
  done:bool = compare.eq(next_n,eight)
  branch done final_count(next_n) write(wo,next_p,next_v,next_n)
block final_count(n:u64)
  ret(n)
end
