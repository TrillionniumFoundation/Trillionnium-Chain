  branch present_ hash_room(ai,ao,aw,ab,ar,af,ac,ap,payload_n) digest_missing()
block hash_room(hi:readbuf,ho:mutbuf,hw:mutbuf,hb:u64,hr:u64,hf:u64,hc:u64,hp:u64,hn:u64)
  have:usize = buffer.len(hw)
