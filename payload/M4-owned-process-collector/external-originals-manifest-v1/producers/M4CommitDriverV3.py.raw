import pathlib,subprocess,os,json,datetime,hashlib
W=pathlib.Path("/private/tmp/chain-M4-owned-process-collector-20261114")
E=pathlib.Path("/private/tmp/chain-M4-owned-process-collector-review-20261114-v1")
D=W/"docs/audit/20261114-m4-closed-exec-gate"
O=E/"commit-v3";O.mkdir(exist_ok=False);H="1a7afcdb820b051d1e4bfde3d436f96fc050c487"
env=dict(os.environ,PATH="/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin",GIT_NO_LAZY_FETCH="1",GIT_OPTIONAL_LOCKS="0",GIT_NO_REPLACE_OBJECTS="1",PYTHONDONTWRITEBYTECODE="1")
def git(*args):return subprocess.check_output(["/usr/bin/git","-C",str(W),*args],env=env,timeout=60)
def run(args,label,timeout=60):
 p=subprocess.run(args,cwd=W,env=env,stdout=subprocess.PIPE,stderr=subprocess.PIPE,timeout=timeout)
 for suffix,r in (("stdout",p.stdout),("stderr",p.stderr)):(O/(label+"."+suffix)).write_bytes(r)
 assert p.returncode==0,(label,p.returncode,p.stderr.decode())
 return p.stdout
def dump(p,obj):
 r=(json.dumps(obj,indent=2)+"\n").encode();p.write_bytes(r);return {"path":str(p),"bytes":len(r),"sha256":hashlib.sha256(r).hexdigest()}
assert git("rev-parse","HEAD").decode().strip()==H
run(["bash","scripts/project-preflight.sh"],"preflight-before-carrier")
rawpath=D/"initial-staged-patch-whitespace.stdout.raw";original=rawpath.read_bytes()
assert original==(E/"commit-v1/staged-diff-check.stdout").read_bytes()
attempts=[]
for name in ("commit-v1","commit-v2"):
 p=E/name/"staged-diff-check.stdout";r=p.read_bytes()
 attempts.append({"source_path":str(p),"exit_code":2,"bytes":len(r),"sha256":hashlib.sha256(r).hexdigest(),"stdout":r.decode(),"cause":"unchanged unified-diff context space stored in an evidence text carrier; production source whitespace was not failing"})
target=D/"staging-failure-observations.json";assert not target.exists()
dump(target,{"schema":"trnm-M4-original-staging-failure-carriers-v1","observations":attempts,"original_external_bytes_unchanged":True})
rawpath.unlink()
entries=[]
for p in sorted(D.iterdir()):
 if p.name=="EVIDENCE_INDEX.json":continue
 r=p.read_bytes();entries.append({"path":p.name,"bytes":len(r),"sha256":hashlib.sha256(r).hexdigest()})
dump(D/"EVIDENCE_INDEX.json",{"schema":"trnm-M4-component-evidence-index-v3","base":H,"files":entries,"linux_execution_included":"original failed full lane only; no changed-source Linux run"})
source=["scripts/w1_owned_process_collector_v1.py","scripts/test_w1_owned_process_collector_v1.py"]
allowed=source+[str(f.relative_to(W)) for f in sorted(D.iterdir())]
run(["/usr/bin/git","add","-A","--",str(D.relative_to(W))],"git-add-component")
assert set(git("diff","--cached","--name-only").decode().splitlines())==set(allowed)
assert not git("diff","--name-only")
run(["/usr/bin/git","diff","--cached","--check"],"staged-diff-check")
run(["bash","scripts/project-preflight.sh","--staged"],"preflight-staged")
staged=git("diff","--cached","--binary","--full-index");(O/"staged.patch").write_bytes(staged)
run(["/usr/bin/git","commit","-m","fix(ci): preserve closed exec gate refusal before cleanup escalation"],"git-commit",120)
head=git("rev-parse","HEAD").decode().strip();tree=git("rev-parse","HEAD^{tree}").decode().strip()
assert git("rev-parse","HEAD^").decode().strip()==H and not git("status","--porcelain=v1")
patch=git("diff","--binary","--full-index",H,head);assert patch==staged;(O/"commit.patch").write_bytes(patch)
(O/"commit-object.raw").write_bytes(git("cat-file","commit",head))
rows=[]
for path in allowed:
 r=git("show",head+":"+path);rows.append({"path":path,"bytes":len(r),"sha256":hashlib.sha256(r).hexdigest(),"git_blob":git("rev-parse",head+":"+path).decode().strip()})
static=json.loads((E/"commit-v2/static-summary.json").read_text())
s={"schema":"trnm-M4-closed-gate-component-commit-v3","head":head,"tree":tree,"parent":H,"branch":git("branch","--show-current").decode().strip(),"clean":True,"paths":rows,"runtime_patch_matches_approved_design":True,"original14_source_and_ast_preserved":True,"added_deterministic_signal_controls":2,"portable_mock_create_true":True,"syntax_compilation_passed":True,"staged_preflight_passed":True,"changed_source_linux_tests_executed":False,"full_lane_passed":False,"remote_write":False,"coordinator_linux_validation_pending":True,"patch":{"path":str(O/"commit.patch"),"bytes":len(patch),"sha256":hashlib.sha256(patch).hexdigest()},"two_source_patch":static["current_patch"],"committed_at":datetime.datetime.now(datetime.timezone.utc).isoformat()}
info=dump(O/"commit-summary.json",s)
print(json.dumps({"summary":info,"head":head,"tree":tree,"parent":H,"path_count":len(rows),"source_files":rows[:2],"patch":s["patch"],"two_source_patch":s["two_source_patch"],"clean":True}))
