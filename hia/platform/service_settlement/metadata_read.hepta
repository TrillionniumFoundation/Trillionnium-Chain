fn smr_field(entry_r:readbuf,entry_n:u64,entry_k:u64,entry_fixed:u64) -> (bool) effects(read,write,trap) entry(entry)
block entry(entry_r:readbuf,entry_n:u64,entry_k:u64,entry_fixed:u64)
  entry_zero:u64 = const() {"value":0}
  entry_kind_at:u64 = const() {"value":8}
  entry_span_at:u64 = const() {"value":16}
  entry_header:u64 = const() {"value":24}
  entry_limit:u64 = const() {"value":1048576}
  entry_status:u64 = call(entry_r,entry_zero) {"function":"tr_read"}
  entry_kind:u64 = call(entry_r,entry_kind_at) {"function":"tr_read"}
  entry_len:u64 = call(entry_r,entry_span_at) {"function":"tr_read"}
  entry_payload:u64 = int.sub.wrap(entry_n,entry_header)
  entry_code:bool = compare.eq(entry_status,entry_zero)
  entry_shape:bool = compare.eq(entry_kind,entry_k)
  entry_exact:bool = compare.eq(entry_len,entry_payload)
  entry_width:bool = compare.eq(entry_len,entry_fixed)
  entry_variable:bool = compare.eq(entry_fixed,entry_zero)
  entry_field:bool = bool.or(entry_width,entry_variable)
  entry_under:bool = compare.le(entry_n,entry_limit)
  entry_match:bool = bool.and(entry_code,entry_shape)
  entry_sized:bool = bool.and(entry_exact,entry_field)
  entry_checked:bool = bool.and(entry_match,entry_sized)
  entry_valid:bool = bool.and(entry_checked,entry_under)
  ret(entry_valid)
end

fn smr_eq_bound(entry_r:readbuf,entry_m:mutbuf,entry_a:usize,entry_b:usize,entry_n:u64) -> (bool) effects(read,write,trap) entry(entry)
block entry(entry_r:readbuf,entry_m:mutbuf,entry_a:usize,entry_b:usize,entry_n:u64)
  entry_z:u64 = const() {"value":0}
  entry_done:bool = compare.eq(entry_n,entry_z)
  branch entry_done yes() check(entry_r,entry_m,entry_a,entry_b,entry_n)
block check(check_r:readbuf,check_m:mutbuf,check_a:usize,check_b:usize,check_n:u64)
  check_left:u8 = buffer.load(check_r,check_a)
  check_right:u8 = buffer.load(check_m,check_b)
  check_same:bool = compare.eq(check_left,check_right)
  branch check_same next(check_r,check_m,check_a,check_b,check_n) no()
block next(next_r:readbuf,next_m:mutbuf,next_a:usize,next_b:usize,next_n:u64)
  next_one:usize = const() {"value":1}
  next_decrement:u64 = const() {"value":1}
  next_zero:u64 = const() {"value":0}
  next_aa:usize = int.add.wrap(next_a,next_one)
  next_bb:usize = int.add.wrap(next_b,next_one)
  next_left:u64 = int.sub.wrap(next_n,next_decrement)
  next_done:bool = compare.eq(next_left,next_zero)
  branch next_done yes() check(next_r,next_m,next_aa,next_bb,next_left)
block yes()
  yes_v:bool = const() {"value":true}
  ret(yes_v)
block no()
  no_v:bool = const() {"value":false}
  ret(no_v)
end

