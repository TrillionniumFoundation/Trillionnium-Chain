{
  "schema": "trnm_public_testnet_slo_v1",
  "status": "unverified_design_draft",
  "enforced": false,
  "measurement": {
    "commit_latency": {
      "start": "local_monotonic_time_when_a_complete_valid_proposal_block_is_received",
      "end": "local_monotonic_time_after_application_commit_and_cometbft_state_persistence_complete",
      "eligible_samples": "non_catchup_commits_from_healthy_validators_only",
      "window_seconds": 900,
      "minimum_samples": 1000,
      "percentile_algorithm": "nearest_rank_ceiling_no_interpolation"
    },
    "recovery": {
      "start": "orchestrator_acknowledges_the_fault_or_restore_action",
      "end": "target_is_within_one_block_of_network_head_and_remains_so_for_60_seconds",
      "clock": "orchestrator_monotonic_clock"
    },
    "storage": {
      "window_seconds": 86400,
      "included_paths": [
        "cometbft_blockstore_and_state",
        "application_sqlite_wal_and_shm",
        "application_snapshots",
        "indexer_state"
      ],
      "calculation": "end_allocated_bytes_minus_start_allocated_bytes_on_identical_volumes"
    }
  },
  "finality": {
    "conflicting_final_blocks_max": 0,
    "commit_latency_p95_ms_max": 5000,
    "commit_latency_p99_ms_max": 10000
  },
  "recovery": {
    "single_validator_rejoin_seconds_max": 300,
    "snapshot_restore_seconds_max": 900,
    "validator_replacement_seconds_max": 1800
  },
  "storage": {
    "daily_growth_gib_max": 20,
    "minimum_free_space_percent": 20
  },
  "soak": {
    "foundation_seconds_min": 259200,
    "release_candidate_seconds_min": 604800
  }
}
