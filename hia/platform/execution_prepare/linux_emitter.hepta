fn emit_le(o0:mutbuf,pos0:usize,word0:u64,count0:usize) -> (usize) effects(write,trap) entry(e0)
block e0(o0:mutbuf,pos0:usize,word0:u64,count0:usize)
  index0:usize = const() {"value":0}
  jump e1(o0,pos0,word0,count0,index0)
block e1(o1:mutbuf,pos1:usize,word1:u64,count1:usize,index1:usize)
  done1:bool = compare.eq(index1,count1)
  branch done1 e3(pos1) e2(o1,pos1,word1,count1,index1)
block e2(o2:mutbuf,pos2:usize,word2:u64,count2:usize,index2:usize)
  byte2:u8 = int.cast(word2) {"mode":"wrap"}
  _ = buffer.store(o2,pos2,byte2)
  one2:usize = const() {"value":1}
  eight2:u64 = const() {"value":8}
  nextpos2:usize = int.add.checked(pos2,one2)
  nextindex2:usize = int.add.checked(index2,one2)
  nextword2:u64 = int.shr.checked(word2,eight2)
  jump e1(o2,nextpos2,nextword2,count2,nextindex2)
block e3(finalpos3:usize)
  ret(finalpos3)
end
fn read_le(s0:readbuf,p0:usize) -> (usize) effects(read,trap) entry(r0)
block r0(s0:readbuf,p0:usize)
  zero:u64 = const() {"value":0}
  initial:usize = const() {"value":0}
  jump r1(s0,p0,initial,zero)
block r1(s1:readbuf,p1:usize,i1:usize,v1:u64)
  eight1:usize = const() {"value":8}
  more1:bool = compare.lt(i1,eight1)
  branch more1 r2(s1,p1,i1,v1) r3(v1)
block r2(s2:readbuf,p2:usize,i2:usize,v2:u64)
  at2:usize = int.add.checked(p2,i2)
  b2:u8 = buffer.load(s2,at2)
  w2:u64 = int.cast(b2) {"mode":"wrap"}
  width2:usize = const() {"value":8}
  shift2:usize = int.mul.checked(i2,width2)
  shift64:u64 = int.cast(shift2) {"mode":"wrap"}
  word2:u64 = int.shl.checked(w2,shift64)
  combined2:u64 = bit.or(v2,word2)
  one2:usize = const() {"value":1}
  next2:usize = int.add.checked(i2,one2)
  jump r1(s2,p2,next2,combined2)
block r3(v3:u64)
  out3:usize = int.cast(v3) {"mode":"wrap"}
  ret(out3)
