fn hf_decode(raw:readbuf,state:mutbuf,count:u64) -> (bool) effects(read,write,trap) entry(entry)
block entry(raw:readbuf,state:mutbuf,count:u64)
  begin:u64 = const() {"value":24}
  stage:u64 = const() {"value":4096}
  jump hex_pairs(raw,state,begin,stage,count)
block hex_pairs(hr:readbuf,hs:mutbuf,i:u64,j:u64,n:u64)
  one:u64 = const() {"value":1}
  second:u64 = int.add.wrap(i,one)
  ia:usize = int.cast(i) {"mode":"wrap"}
  ib:usize = int.cast(second) {"mode":"wrap"}
  high:u8 = buffer.load(hr,ia)
  low:u8 = buffer.load(hr,ib)
  byte:u64 = call(high,low) {"function":"rc_octet"}
  limit:u64 = const() {"value":255}
  valid:bool = compare.le(byte,limit)
  branch valid save(hr,hs,second,j,n,byte) failure()
block save(sr:readbuf,sm:mutbuf,si:u64,sj:u64,sn:u64,byte_s:u64)
  pos:usize = int.cast(sj) {"mode":"wrap"}
  value:u8 = int.cast(byte_s) {"mode":"wrap"}
  _ = buffer.store(sm,pos,value)
  step:u64 = const() {"value":1}
  next_i:u64 = int.add.wrap(si,step)
  next_j:u64 = int.add.wrap(sj,step)
  left:u64 = int.sub.wrap(sn,step)
  done:bool = compare.eq(sn,step)
  branch done success() hex_pairs(sr,sm,next_i,next_j,left)
block success()
  yes:bool = const() {"value":true}
  ret(yes)
block failure()
  no:bool = const() {"value":false}
  ret(no)
end

fn hf_record(state:mutbuf,work:mutbuf,extent:u64) -> (bool) effects(read,write,trap) entry(entry)
block entry(state:mutbuf,work:mutbuf,extent:u64)
  magic_at:u64 = const() {"value":4136}
  header:u64 = call(state,magic_at) {"function":"cp_get"}
  mask:u64 = const() {"value":281474976710655}
  prefix:u64 = bit.and(header,mask)
  magic:u64 = const() {"value":1100691228749}
  rev_sql_at:u64 = const() {"value":4096}
  rev_raw_at:u64 = const() {"value":4143}
  rev_sql:u64 = call(state,rev_sql_at) {"function":"cp_get"}
  rev_raw:u64 = call(state,rev_raw_at) {"function":"cp_get"}
  bound:bool = compare.eq(rev_sql,rev_raw)
  header_ok:bool = compare.eq(prefix,magic)
  framed:bool = bool.and(bound,header_ok)
  branch framed profile(state,work,extent) bad()
block profile(ps:mutbuf,pw:mutbuf,n:u64)
  compact_width:u64 = const() {"value":423}
  compact:bool = compare.eq(n,compact_width)
  branch compact shape(ps,pw,n) noncompact(ps,pw,n)
block noncompact(ncs:mutbuf,ncw:mutbuf,ncn:u64)
  installed_width:u64 = const() {"value":799}
  installed_record:bool = compare.eq(ncn,installed_width)
  branch installed_record installed(ncs,ncw,ncn) fenced(ncs,ncw,ncn)
block installed(ins:mutbuf,inw:mutbuf,inn:u64)
  unfenced:bool = const() {"value":false}
  shape_ok_installed:bool = call(ins,unfenced) {"function":"hf_installed_shape"}
  yes_o:bool = const() {"value":true}
  branch shape_ok_installed phase_fields(ins,inw,yes_o,inn) bad()
block fenced(fs:mutbuf,fw:mutbuf,fnn:u64)
  state_at_f:usize = const() {"value":4142}
  state_f:u8 = buffer.load(fs,state_at_f)
  fence_tag:u8 = const() {"value":255}
  is_fenced:bool = compare.eq(state_f,fence_tag)
  branch is_fenced fence_profile(fs,fw,fnn) bad()
block fence_profile(fps:mutbuf,fpw:mutbuf,fpn:u64)
  fence_small:u64 = const() {"value":455}
  is_fence_small:bool = compare.eq(fpn,fence_small)
  branch is_fence_small fenced_compact(fps,fpw,fpn) fenced_install(fps,fpw,fpn)
block fenced_compact(fcs:mutbuf,fcw:mutbuf,fcn:u64)
  valid_shape:bool = call(fcs) {"function":"hf_fenced_compact"}
  branch valid_shape fence_target(fcs,fcw,fcn) bad()
block fence_target(fts:mutbuf,ftw:mutbuf,ftn:u64)
  target_at:u64 = const() {"value":4311}
  has_target:bool = call(fts,target_at) {"function":"hf_nonzero"}
  jump phase_fields(fts,ftw,has_target,ftn)
block fenced_install(fis:mutbuf,fiw:mutbuf,fin:u64)
  width_fi:u64 = const() {"value":831}
  valid_fi_extent:bool = compare.eq(fin,width_fi)
  branch valid_fi_extent fenced_install_fields(fis,fiw,fin) bad()
block fenced_install_fields(fisf:mutbuf,fiwf:mutbuf,finf:u64)
  yes_f:bool = const() {"value":true}
  shape_fi:bool = call(fisf,yes_f) {"function":"hf_installed_shape"}
  branch shape_fi phase_fields(fisf,fiwf,yes_f,finf) bad()
block shape(ss:mutbuf,sw:mutbuf,ssn:u64)
  state_at:usize = const() {"value":4142}
  state_code:u8 = buffer.load(ss,state_at)
  verified:u8 = const() {"value":1}
  projected:u8 = const() {"value":2}
  is_verified:bool = compare.eq(state_code,verified)
  is_projected:bool = compare.eq(state_code,projected)
  known:bool = bool.or(is_verified,is_projected)
  optional_at:u64 = const() {"value":4479}
  options:u64 = call(ss,optional_at) {"function":"cp_get"}
  zero:u64 = const() {"value":0}
  no_options:bool = compare.eq(options,zero)
  shape_ok:bool = bool.and(known,no_options)
  branch shape_ok phase_fields(ss,sw,is_projected,ssn) bad()
block phase_fields(ms:mutbuf,mw:mutbuf,require_target:bool,sized:u64)
  checked:bool = call(ms,require_target) {"function":"hf_fields"}
  branch checked commit(ms,mw,sized) bad()
block commit(cs:mutbuf,cw:mutbuf,sized_c:u64)
  valid:bool = call(cs,cw,sized_c) {"function":"hf_digest"}
  ret(valid)
block bad()
  refused:bool = const() {"value":false}
  ret(refused)
end

fn hf_fields(state:mutbuf,projected:bool) -> (bool) effects(read,write,trap) entry(entry)
block entry(state:mutbuf,projected:bool)
  f0:u64 = const() {"value":4151}
  field0:bool = call(state,f0) {"function":"hf_nonzero"}
  valid0:bool = bool.and(field0,field0)
  f1:u64 = const() {"value":4183}
  field1:bool = call(state,f1) {"function":"hf_nonzero"}
  valid1:bool = bool.and(field1,field1)
  linked1:bool = bool.and(valid1,valid0)
  f2:u64 = const() {"value":4215}
  field2:bool = call(state,f2) {"function":"hf_nonzero"}
  valid2:bool = bool.and(field2,field2)
  linked2:bool = bool.and(valid2,linked1)
  f3:u64 = const() {"value":4247}
  field3:bool = call(state,f3) {"function":"hf_nonzero"}
  valid3:bool = bool.and(field3,field3)
  linked3:bool = bool.and(valid3,linked2)
  f4:u64 = const() {"value":4279}
  field4:bool = call(state,f4) {"function":"hf_nonzero"}
  valid4:bool = bool.and(field4,field4)
  linked4:bool = bool.and(valid4,linked3)
  f5:u64 = const() {"value":4311}
  field5:bool = call(state,f5) {"function":"hf_nonzero"}
  valid5:bool = compare.eq(field5,projected)
  linked5:bool = bool.and(valid5,linked4)
  f6:u64 = const() {"value":4343}
  field6:bool = call(state,f6) {"function":"hf_nonzero"}
  valid6:bool = compare.eq(field6,projected)
  linked6:bool = bool.and(valid6,linked5)
  f7:u64 = const() {"value":4375}
  field7:bool = call(state,f7) {"function":"hf_nonzero"}
  valid7:bool = compare.eq(field7,projected)
  linked7:bool = bool.and(valid7,linked6)
  f8:u64 = const() {"value":4407}
  field8:bool = call(state,f8) {"function":"hf_nonzero"}
  valid8:bool = bool.and(field8,field8)
  linked8:bool = bool.and(valid8,linked7)
  f9:u64 = const() {"value":4439}
  field9:bool = call(state,f9) {"function":"hf_nonzero"}
  valid9:bool = compare.eq(field9,projected)
  linked9:bool = bool.and(valid9,linked8)

  ret(linked9)
end

fn hf_nonzero(state:mutbuf,source:u64) -> (bool) effects(read,write,trap) entry(entry)
block entry(state:mutbuf,source:u64)
  step:u64 = const() {"value":8}
  plus1:u64 = int.add.wrap(source,step)
  plus2:u64 = int.add.wrap(plus1,step)
  plus3:u64 = int.add.wrap(plus2,step)
  a:u64 = call(state,source) {"function":"cp_get"}
  b:u64 = call(state,plus1) {"function":"cp_get"}
  c:u64 = call(state,plus2) {"function":"cp_get"}
  d:u64 = call(state,plus3) {"function":"cp_get"}
  ab:u64 = bit.or(a,b)
  cd:u64 = bit.or(c,d)
  sum:u64 = bit.or(ab,cd)
  zero:u64 = const() {"value":0}
  present:bool = compare.ne(sum,zero)
  ret(present)
end

fn hf_digest(state:mutbuf,work:mutbuf,projected_bytes:u64) -> (bool) effects(read,write,trap) entry(entry)
block entry(state:mutbuf,work:mutbuf,projected_bytes:u64)
  init:u64 = call(work) {"function":"tr_sha_init"}
  pos0:u64 = const() {"value":1208}
  word0:u64 = const() {"value":2305843009213693952}
  _write0:u64 = call(work,pos0,word0) {"function":"tr_put"}
  pos8:u64 = const() {"value":1216}
  word8:u64 = const() {"value":7451607104633074292}
  _write8:u64 = call(work,pos8,word8) {"function":"tr_put"}
  pos16:u64 = const() {"value":1224}
  word16:u64 = const() {"value":7507059053662855538}
  _write16:u64 = call(work,pos16,word16) {"function":"tr_put"}
  pos24:u64 = const() {"value":1232}
  word24:u64 = const() {"value":8227344684417314401}
  _write24:u64 = call(work,pos24,word24) {"function":"tr_put"}
  pos32:u64 = const() {"value":1240}
  word32:u64 = const() {"value":3492029570023908197}
  _write32:u64 = call(work,pos32,word32) {"function":"tr_put"}
  pos40:u64 = const() {"value":1248}
  word40:u64 = const() {"value":6845752908579864576}
  _write40:u64 = call(work,pos40,word40) {"function":"tr_put"}
  length_position:u64 = const() {"value":1248}
  outer_fields:u64 = const() {"value":72}
  record_len:u64 = int.sub.wrap(projected_bytes,outer_fields)
  low_mask:u64 = const() {"value":255}
  eight_prefix:u64 = const() {"value":8}
  low_shift:u64 = const() {"value":56}
  high_shift:u64 = const() {"value":48}
  low_len:u64 = bit.and(record_len,low_mask)
  high_len:u64 = int.shr.checked(record_len,eight_prefix)
  low_be:u64 = int.shl.checked(low_len,low_shift)
  high_be:u64 = int.shl.checked(high_len,high_shift)
  encoded_length:u64 = bit.or(low_be,high_be)
  _record_len:u64 = call(work,length_position,encoded_length) {"function":"tr_put"}
  record:u64 = const() {"value":4136}
  payload:u64 = const() {"value":1256}
  start:u64 = const() {"value":1208}
  prefix_n:u64 = const() {"value":48}
  total:u64 = int.add.wrap(prefix_n,record_len)

  _copy:u64 = call(state,record,work,payload,record_len) {"function":"cp_wout"}
  absorb:u64 = call(work,start,total) {"function":"tr_sha_update_work"}
  sealed:u64 = call(work) {"function":"tr_sha_final"}
  ia:u64 = bit.or(init,absorb)
  all:u64 = bit.or(ia,sealed)
  zero:u64 = const() {"value":0}
  okay:bool = compare.eq(all,zero)
  branch okay digest_matches(state,work,record_len) bad()
block digest_matches(ds:mutbuf,dw:mutbuf,encoded_body:u64)
  record_base:u64 = const() {"value":4136}
  embedded:u64 = int.add.wrap(record_base,encoded_body)
  sql:u64 = const() {"value":4104}
  actual:u64 = const() {"value":1168}
  span:u64 = const() {"value":32}
  jump compare_words(ds,dw,embedded,sql,actual,span)
block compare_words(xs:mutbuf,xw:mutbuf,a:u64,b:u64,k:u64,left:u64)
  from_record:u64 = call(xs,a) {"function":"cp_get"}
  from_column:u64 = call(xs,b) {"function":"cp_get"}
  calculated:u64 = call(xw,k) {"function":"tr_get"}
  first:bool = compare.eq(from_record,calculated)
  second:bool = compare.eq(from_column,calculated)
  match_both:bool = bool.and(first,second)
  branch match_both next(xs,xw,a,b,k,left) bad()
block next(ns:mutbuf,nw:mutbuf,na:u64,nb:u64,nk:u64,nleft:u64)
  eight:u64 = const() {"value":8}
  a1:u64 = int.add.wrap(na,eight)
  b1:u64 = int.add.wrap(nb,eight)
  k1:u64 = int.add.wrap(nk,eight)
  remains:u64 = int.sub.wrap(nleft,eight)
  done:bool = compare.eq(nleft,eight)
  branch done good() compare_words(ns,nw,a1,b1,k1,remains)
block good()
  yes:bool = const() {"value":true}
  ret(yes)
block bad()
  no:bool = const() {"value":false}
  ret(no)
end

fn hf_installed_shape(state:mutbuf,fenced:bool) -> (bool) effects(read,write,trap) entry(entry)
block entry(state:mutbuf,fenced:bool)
  state_at:usize = const() {"value":4142}
  phase:u8 = buffer.load(state,state_at)
  installed:u8 = const() {"value":3}
  cas:u8 = const() {"value":4}
  is_install:bool = compare.eq(phase,installed)
  is_cas:bool = compare.eq(phase,cas)
  standard_phase:bool = bool.or(is_install,is_cas)
  fenced_tag:u8 = const() {"value":255}
  fenced_phase:bool = compare.eq(phase,fenced_tag)
  valid_phase:bool = select(fenced,fenced_phase,standard_phase)
  flag_at0:usize = const() {"value":4479}
  flag_val0:u8 = buffer.load(state,flag_at0)
  expected0:u8 = const() {"value":1}
  exact_flag0:bool = compare.eq(flag_val0,expected0)
  conjunction0:bool = bool.and(exact_flag0,valid_phase)
  flag_at1:usize = const() {"value":4512}
  flag_val1:u8 = buffer.load(state,flag_at1)
  expected1:u8 = const() {"value":1}
  exact_flag1:bool = compare.eq(flag_val1,expected1)
  conjunction1:bool = bool.and(exact_flag1,conjunction0)
  flag_at2:usize = const() {"value":4617}
  flag_val2:u8 = buffer.load(state,flag_at2)
  expected2:u8 = const() {"value":1}
  exact_flag2:bool = compare.eq(flag_val2,expected2)
  conjunction2:bool = bool.and(exact_flag2,conjunction1)
  flag_at3:usize = const() {"value":4858}
  flag_val3:u8 = buffer.load(state,flag_at3)
  expected3:u8 = const() {"value":0}
  exact_flag3:bool = compare.eq(flag_val3,expected3)
  conjunction3:bool = bool.and(exact_flag3,conjunction2)
  flag_at4:usize = const() {"value":4859}
  flag_val4:u8 = buffer.load(state,flag_at4)
  expected4:u8 = const() {"value":0}
  exact_flag4:bool = compare.eq(flag_val4,expected4)
  conjunction4:bool = bool.and(exact_flag4,conjunction3)
  flag_at5:usize = const() {"value":4860}
  flag_val5:u8 = buffer.load(state,flag_at5)
  expected5:u8 = const() {"value":0}
  exact_flag5:bool = compare.eq(flag_val5,expected5)
  conjunction5:bool = bool.and(exact_flag5,conjunction4)
  flag_at6:usize = const() {"value":4861}
  flag_val6:u8 = buffer.load(state,flag_at6)
  expected6:u8 = const() {"value":0}
  exact_flag6:bool = compare.eq(flag_val6,expected6)
  conjunction6:bool = bool.and(exact_flag6,conjunction5)
  flag_at7:usize = const() {"value":4862}
  flag_val7:u8 = buffer.load(state,flag_at7)
  has_reason:u8 = const() {"value":1}
  no_reason:u8 = const() {"value":0}
  expected7:u8 = select(fenced,has_reason,no_reason)
  exact_flag7:bool = compare.eq(flag_val7,expected7)
  conjunction7:bool = bool.and(exact_flag7,conjunction6)
  branch conjunction7 reason(state,fenced) bad()
block reason(rs:mutbuf,rf:bool)
  branch rf nonzero_reason(rs) link(rs)
block nonzero_reason(nrs:mutbuf)
  reason_at:u64 = const() {"value":4863}
  nonzero:bool = call(nrs,reason_at) {"function":"hf_nonzero"}
  branch nonzero link(nrs) bad()
block link(fs:mutbuf)
  okay:bool = call(fs) {"function":"hf_installed_fields"}
  ret(okay)
block bad()
  refused:bool = const() {"value":false}
  ret(refused)
end

fn hf_installed_fields(state:mutbuf) -> (bool) effects(read,write,trap) entry(entry)
block entry(state:mutbuf)
  a0:u64 = const() {"value":4279}
  b0:u64 = const() {"value":4513}
  same0:bool = call(state,a0,b0) {"function":"hf_same32"}
  a1:u64 = const() {"value":4439}
  b1:u64 = const() {"value":4545}
  same1:bool = call(state,a1,b1) {"function":"hf_same32"}
  both1:bool = bool.and(same1,same0)
  a2:u64 = const() {"value":4151}
  b2:u64 = const() {"value":4618}
  same2:bool = call(state,a2,b2) {"function":"hf_same32"}
  both2:bool = bool.and(same2,both1)
  a3:u64 = const() {"value":4183}
  b3:u64 = const() {"value":4650}
  same3:bool = call(state,a3,b3) {"function":"hf_same32"}
  both3:bool = bool.and(same3,both2)
  a4:u64 = const() {"value":4247}
  b4:u64 = const() {"value":4682}
  same4:bool = call(state,a4,b4) {"function":"hf_same32"}
  both4:bool = bool.and(same4,both3)
  a5:u64 = const() {"value":4311}
  b5:u64 = const() {"value":4714}
  same5:bool = call(state,a5,b5) {"function":"hf_same32"}
  both5:bool = bool.and(same5,both4)
  a6:u64 = const() {"value":4375}
  b6:u64 = const() {"value":4746}
  same6:bool = call(state,a6,b6) {"function":"hf_same32"}
  both6:bool = bool.and(same6,both5)
  a7:u64 = const() {"value":4439}
  b7:u64 = const() {"value":4778}
  same7:bool = call(state,a7,b7) {"function":"hf_same32"}
  both7:bool = bool.and(same7,both6)
  a8:u64 = const() {"value":4585}
  b8:u64 = const() {"value":4826}
  same8:bool = call(state,a8,b8) {"function":"hf_same32"}
  both8:bool = bool.and(same8,both7)
  identity:u64 = const() {"value":4480}
  delta:u64 = const() {"value":4585}
  installed_generation:u64 = const() {"value":4577}
  read_generation:u64 = const() {"value":4818}

  identity_valid:bool = call(state,identity) {"function":"hf_nonzero"}
  delta_valid:bool = call(state,delta) {"function":"hf_nonzero"}
  ig:u64 = call(state,installed_generation) {"function":"cp_get"}
  rg:u64 = call(state,read_generation) {"function":"cp_get"}
  generations_agree:bool = compare.eq(ig,rg)
  zero:u64 = const() {"value":0}
  committed_generation:bool = compare.ne(ig,zero)
  linkage:bool = bool.and(generations_agree,committed_generation)
  committed:bool = bool.and(identity_valid,delta_valid)
  phase_link:bool = bool.and(linkage,committed)
  exact:bool = bool.and(both8,phase_link)
  ret(exact)
end

fn hf_same32(state:mutbuf,a:u64,b:u64) -> (bool) effects(read,write,trap) entry(entry)
block entry(state:mutbuf,a:u64,b:u64)
  length:u64 = const() {"value":32}
  jump word(state,a,b,length)
block word(ws:mutbuf,wa:u64,wb:u64,left:u64)
  left_word:u64 = call(ws,wa) {"function":"cp_get"}
  right_word:u64 = call(ws,wb) {"function":"cp_get"}
  same:bool = compare.eq(left_word,right_word)
  branch same advance(ws,wa,wb,left) bad()
block advance(xs:mutbuf,xa:u64,xb:u64,remaining:u64)
  eight:u64 = const() {"value":8}
  next_a:u64 = int.add.wrap(xa,eight)
  next_b:u64 = int.add.wrap(xb,eight)
  next_n:u64 = int.sub.wrap(remaining,eight)
  done:bool = compare.eq(remaining,eight)
  branch done good() word(xs,next_a,next_b,next_n)
block good()
  yes:bool = const() {"value":true}
  ret(yes)
block bad()
  no:bool = const() {"value":false}
  ret(no)
end

fn hf_fenced_compact(state:mutbuf) -> (bool) effects(read,write,trap) entry(entry)
block entry(state:mutbuf)
  options_at:u64 = const() {"value":4479}
  flags:u64 = call(state,options_at) {"function":"cp_get"}
  desired:u64 = const() {"value":72057594037927936}
  options:bool = compare.eq(flags,desired)
  reason_at:u64 = const() {"value":4487}
  reason:bool = call(state,reason_at) {"function":"hf_nonzero"}
  valid:bool = bool.and(options,reason)
  ret(valid)
end
