import pathlib,json,hashlib,datetime,re
D=pathlib.Path("/home/qian-qi/chain-final-consolidation-20261114-root/final-repository-truth-offline-1a7afc-v1")
checks={"summary.json":"61322d80d4bb3439f2115d62b50ff3c0be42e9b10bf17f82193d5d01935a71e6","repository-truth.stdout":"103863fcecd7456ed019a94de45fc5bc6e4e15a178db37e624a7f755b204daad","repository-truth.stderr":"8b7647848e125604935e9cdd7659e4c81cd7ad519cba149c0ce4cf2d4fc72edf"}
out={"schema":"trnm-M4-original-lane-readonly-failure-extract-v1","observed_at":datetime.datetime.now(datetime.timezone.utc).isoformat(),"files":[]}
for n,h in checks.items():
 p=D/n;r=p.read_bytes();assert hashlib.sha256(r).hexdigest()==h
 lines=r.decode().splitlines()
 windows=[]
 for i,line in enumerate(lines):
  if ("test_actual_post_fork_identity_failure_reaps_gated_root_without_exec" in line or "AssertionError: -15 != 125" in line or "AssertionError: 125 != -15" in line):
   lo=max(0,i-4);hi=min(len(lines),i+10)
   windows.append({"first_line":lo+1,"lines":lines[lo:hi]})
 out["files"].append({"path":str(p),"bytes":len(r),"sha256":h,"total_lines":len(lines),"windows":windows})
print(json.dumps(out))