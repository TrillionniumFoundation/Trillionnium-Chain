  d:usize = int.cast(at_s) {"mode":"wrap"}
  saved:u64 = call(sw,sm,digest,d,n) {"function":"sscid_copy"}
  final_i:u64 = const() {"value":4}
  done:bool = compare.eq(si,final_i)
  branch done next_marker(sm) advance(sm,sw,si,se)
block advance(am:mutbuf,aw:mutbuf,ai:u64,ae:u64)
  three:u64 = const() {"value":3}
  one_a:u64 = const() {"value":1}
  first:u64 = const() {"value":153}
  last:u64 = const() {"value":185}
  final_added:bool = compare.eq(ai,three)
  extent:u64 = select(final_added,last,first)
  next_count:u64 = int.add.wrap(ai,one_a)
  next_end:u64 = int.add.wrap(ae,extent)
  jump loop(am,aw,next_count,next_end)
block next_marker(nm:mutbuf)
