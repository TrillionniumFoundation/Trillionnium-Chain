  ss_classic:bool = compare.eq(ss_workload,ss_zero)
  ss_uses_auto:bool = compare.eq(ss_strategy,ss_auto)
  ss_uses_aggressive:bool = compare.eq(ss_strategy,ss_aggressive)
  ss_adaptive_or_greedy:bool = bool.or(ss_uses_auto,ss_uses_aggressive)
  ss_marked:bool = bool.not(ss_unmarked)
  ss_mark_denied:bool = bool.and(ss_adaptive_or_greedy,ss_marked)
  ss_denied:bool = bool.or(ss_other_denied,ss_mark_denied)
  ss_nonclassic:bool = bool.not(ss_classic)
