# macOS
.DS_Store

# Build artifacts
/build/
/dist/
/contracts/target/
/trillionnium/target/
/trillionnium/run/
/trillionnium/release/

# Runtime logs
*.log
!legacy/**/chain.log
!legacy/**/worker.log

# Root runtime outputs
/run/

# Local runtime data
/data/

# Worker local state
/worker/.worker.lock
/worker/config.yaml
/worker/proto_out/
/worker/worker.log
/worker/worker_state.json

# Local chain proto/codegen artifacts
/chain/proto/buf.gen.local.*.yaml
/chain/third_party/
/chain/vendor/
/chain/_proto_vendor_backup/

# Local legacy archive (kept outside git history)
/legacy/

# Local auto-iterate control files
/.auto-iterate.lock
/.auto-iterate.pause
/.auto-iterate.stop
