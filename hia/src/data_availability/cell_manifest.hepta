  valid:bool = compare.eq(code,success)
  branch valid room(input,output,scratch,length) failure(code)
block room(ri:readbuf,ro:mutbuf,rs:mutbuf,rn:u64)
  work_size:usize = buffer.len(rs)
  min_work:usize = const() {"value":1232}
  enough_work:bool = compare.ge(work_size,min_work)
  digest_bytes:u64 = const() {"value":32}
  full:u64 = int.add.wrap(rn,digest_bytes)
  needed:usize = int.cast(full) {"mode":"wrap"}
  available:usize = buffer.len(ro)
  enough_out:bool = compare.ge(available,needed)
  fits:bool = bool.and(enough_work,enough_out)
  branch fits hash(ri,ro,rs,rn) capacity()
block hash(hi:readbuf,ho:mutbuf,hs:mutbuf,hn:u64)
  origin:u64 = const() {"value":0}
  code_h:u64 = call(hi,origin,hn,hs) {"function":"cm_hash"}
  zero_h:u64 = const() {"value":0}
  hashed:bool = compare.eq(code_h,zero_h)
  branch hashed output_result(hi,ho,hs,hn) internal()
block output_result(oi:readbuf,oo:mutbuf,os:mutbuf,on:u64)
  start:u64 = const() {"value":0}
  offset:u64 = call(os,oo,start) {"function":"sb_copy_digest"}
  _written:u64 = call(oi,oo,start,offset,on) {"function":"rac_copy"}
  okay:u32 = const() {"value":0}
  ret(okay)
block capacity()
  cap:u32 = const() {"value":102}
  ret(cap)
block internal()
  err:u32 = const() {"value":103}
  ret(err)
block failure(value:u32)
