+#[cfg(test)]
+mod error_state_preservation_regression_tests {
+    use super::*;
+
+    fn bytes(sim: &MissionSimV1) -> Vec<u8> {
+        serde_json::to_vec(sim).expect("simulation serializes")
+    }
+
+    #[test]
+    fn rejected_player_order_preserves_complete_simulation_state() {
+        let mut sim = MissionSimV1::from_seed(crate::tests::seed()).expect("seed is valid");
+        let before = bytes(&sim);
+        let mut order = RtsFrameOrder::new(
+            1,
+            "not-the-player",
+            vec![sim.party[0].unit_id.clone()],
+            RtsOrderKind::Ability,
+            trnm_rts_protocol::RtsOrderSource::LocalInput,
+        );
+        order.target_rule_id = Some("invalid-authority".to_string());
+        assert!(sim.issue_order(order).is_err());
+        assert_eq!(before, bytes(&sim));
+    }
+
+    #[test]
+    fn failed_pvp_partition_preserves_party_and_snapshot_hash() {
+        let mut sim = MissionSimV1::from_seed(crate::tests::seed()).expect("seed is valid");
+        let all_party = sim
+            .party
+            .iter()
+            .map(|unit| unit.unit_id.clone())
+            .collect::<BTreeSet<_>>();
+        let before = bytes(&sim);
+        let before_hash = sim.snapshot_hash().expect("snapshot hashes");
+        assert!(sim.enable_human_enemy_authority(&all_party).is_err());
+        assert_eq!(before, bytes(&sim));
+        assert_eq!(before_hash, sim.snapshot_hash().expect("snapshot still hashes"));
+    }
+
+    #[test]
+    fn failed_construction_preserves_resources_replay_and_random_cursor() {
+        let mut sim = MissionSimV1::from_seed(crate::tests::seed()).expect("seed is valid");
+        sim.resources_available = 0;
+        let before = bytes(&sim);
+        let builder = sim.party[0].unit_id.clone();
+        let mut order = RtsFrameOrder::new(
+            1,
+            "player",
+            vec![builder],
+            RtsOrderKind::Build,
+            trnm_rts_protocol::RtsOrderSource::LocalInput,
+        );
+        order.target_tile = Some(trnm_rts_protocol::RtsTile::new(2, 2));
+        order.target_rule_id = Some("field_barricade".to_string());
+        assert!(sim.issue_order(order).is_err());
+        assert_eq!(before, bytes(&sim));
+    }
+}
