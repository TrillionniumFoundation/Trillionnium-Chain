fn suri_literal(octet:u8,index:usize,first_slash:bool) -> (bool) effects() entry(entry)
block entry(octet:u8,index:usize,first_slash:bool)
  digit_min:u8 = const() {"value":48}
  digit_max:u8 = const() {"value":57}
  digit_above:bool = compare.ge(octet,digit_min)
  digit_below:bool = compare.le(octet,digit_max)
  digit_ok:bool = bool.and(digit_above,digit_below)
  lower_min:u8 = const() {"value":97}
  lower_max:u8 = const() {"value":122}
  lower_above:bool = compare.ge(octet,lower_min)
  lower_below:bool = compare.le(octet,lower_max)
  lower_ok:bool = bool.and(lower_above,lower_below)
  upper_min:u8 = const() {"value":65}
  upper_max:u8 = const() {"value":90}
  upper_above:bool = compare.ge(octet,upper_min)
  upper_below:bool = compare.le(octet,upper_max)
  upper_ok:bool = bool.and(upper_above,upper_below)
  slash_byte:u8 = const() {"value":47}
  slash:bool = compare.eq(octet,slash_byte)
  dot_byte:u8 = const() {"value":46}
  dot:bool = compare.eq(octet,dot_byte)
  underscore_byte:u8 = const() {"value":95}
  underscore:bool = compare.eq(octet,underscore_byte)
  hyphen_byte:u8 = const() {"value":45}
  hyphen:bool = compare.eq(octet,hyphen_byte)
  second:usize = const() {"value":1}
  at_second:bool = compare.eq(index,second)
  leading_pair:bool = bool.and(first_slash,at_second)
  authority:bool = bool.and(leading_pair,slash)
  not_authority:bool = bool.not(authority)
  punctuation_1:bool = bool.or(slash,dot)
  punctuation_2:bool = bool.or(underscore,hyphen)
  punctuation:bool = bool.or(punctuation_1,punctuation_2)
  letters:bool = bool.or(lower_ok,upper_ok)
  alnum:bool = bool.or(letters,digit_ok)
  plain:bool = bool.or(alnum,punctuation)
  literal:bool = bool.and(plain,not_authority)
  ret(literal)
end

