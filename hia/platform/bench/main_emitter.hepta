fn f0(payload:readbuf,image:mutbuf,scratch:mutbuf) -> (u32) effects(read,write,trap) entry(entry)
block entry(payload:readbuf,image:mutbuf,scratch:mutbuf)
  n:usize = buffer.len(payload)
  cap:usize = buffer.len(image)
  zero:usize = const() {"value":0}
  limit:usize = const() {"value":950272}
  prefix:usize = const() {"value":3344}
  nonempty:bool = compare.gt(n,zero)
  bounded:bool = compare.le(n,limit)
  valid:bool = bool.and(nonempty,bounded)
  need:usize = int.add.wrap(n,prefix)
  fits:bool = compare.ge(cap,need)
  ready:bool = bool.and(valid,fits)
  need_u64:u64 = int.cast(need) {"mode":"wrap"}
  branch ready header(payload,image,n,need_u64) refuse()
block header(h_src:readbuf,h_out:mutbuf,h_n:usize,h_need:u64)
