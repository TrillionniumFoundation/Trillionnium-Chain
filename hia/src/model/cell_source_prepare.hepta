  space:bool = compare.eq(v,blank)
  white:bool = bool.or(range,space)
  one:u64 = const() {"value":1}
  next:u64 = int.add.wrap(cp,one)
  branch white gap(cw,next,cd,ce) nonwhite(cw,next,cd,ce,cg,v)
block gap(gw:mutbuf,gp:u64,gd:u64,ge:u64)
  base:u64 = const() {"value":5304}
  fresh:bool = compare.ne(gd,base)
  jump scan(gw,gp,gd,ge,fresh)
block nonwhite(nw:mutbuf,np:u64,nd:u64,ne:u64,ng:bool,nv:u8)
  branch ng spacer(nw,np,nd,ne,nv) out(nw,np,nd,ne,nv)
block spacer(pw:mutbuf,pp:u64,pd:u64,pe:u64,pv:u8)
