  ss_check_footprint:bool = bool.and(ss_unmarked,ss_uses_footprint)
  ss_auto:u64 = const() {"value":5}
  ss_workload_at:u64 = const() {"value":48}
  ss_aggressive:u64 = const() {"value":6}
