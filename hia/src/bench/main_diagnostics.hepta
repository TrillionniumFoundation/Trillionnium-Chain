  step4:u64 = const() {"value":4}
  step6:u64 = const() {"value":6}
  atp:u64 = int.add.wrap(row,step2)
  ats:u64 = int.add.wrap(row,step4)
  atz:u64 = int.add.wrap(row,step6)
  rel:u64 = call(l_i,row) {"function":"diag_u16"}
