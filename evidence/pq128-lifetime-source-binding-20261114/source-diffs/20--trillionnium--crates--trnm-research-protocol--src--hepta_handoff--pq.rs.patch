+    /// Read caller-trusted time after one actual ML-DSA verification.
+    ///
+    /// Both the owner admission and the independently pinned authority must
+    /// still be live at that later reading. The callback must read current
+    /// trusted time; no signed field or cached observation can supply it.
+    /// This remains a point-in-time research observation. Before any effect,
+    /// the receiving owner must obtain its current withdrawal and journal
+    /// state; this method creates no FinalUse or execution capability.
+    pub fn verify_for_context_with_fresh_time(
+        &self,
+        pins: &PqHeptaAuthoritySetV2,
+        expected_chain_id: &str,
+        expected_admission: &HeptaArtifactAdmissionV1,
+        now_unix_s: u64,
+        after_verify_unix_s: impl FnOnce() -> u64,
+    ) -> Result<(), PqHeptaHandoffError> {
+        self.verify_for_context(pins, expected_chain_id, expected_admission, now_unix_s)?;
+        let current = after_verify_unix_s();
+        if current < now_unix_s {
+            return Err(PqHeptaHandoffError::TimeMovedBackwards);
+        }
+        // Admission expiry is inclusive; the current authority's expiry and
+        // revocation boundaries are exclusive. Retain both existing contracts.
+        expected_admission.validate_at(current)?;
+        pins.authorized(self, current)?;
+        Ok(())
+    }
+
+    /// Parse only the current bounded THP2 wire, then verify current external
+    /// owner and authority pins before observing time again. The untrusted
+    /// envelope never chooses its own key or grants authority to the parser.
+    pub fn decode_for_context_with_fresh_time(
+        wire: &[u8],
+        pins: &PqHeptaAuthoritySetV2,
+        expected_chain_id: &str,
+        expected_admission: &HeptaArtifactAdmissionV1,
+        now_unix_s: u64,
+        after_verify_unix_s: impl FnOnce() -> u64,
+    ) -> Result<Self, PqHeptaHandoffError> {
+        let signed = Self::decode_untrusted(wire)?;
+        signed.verify_for_context_with_fresh_time(
+            pins,
+            expected_chain_id,
+            expected_admission,
+            now_unix_s,
+            after_verify_unix_s,
+        )?;
+        Ok(signed)
+    }
+
