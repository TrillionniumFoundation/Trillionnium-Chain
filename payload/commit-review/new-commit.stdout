d818024e921fbca0c38bfacc\",\n+      \"declared_pin\": {\n+        \"bytes\": 23468,\n+        \"sha256\": \"de64c85b8a961bf5cf3b5df2e445b9992edaa20ad818024e921fbca0c38bfacc\"\n+      },\n+      \"declared_pin_matches_last_mapping_commit\": true,\n+      \"declared_uses\": [\n+        \"model-declared-transitive-graph\"\n+      ],\n+      \"disposition\": \"unchanged-exact-raw\",\n+      \"last_mapping_blob\": \"9840744362447c406d7eab7554a53f53635e748c\",\n+      \"last_mapping_bytes\": 23468,\n+      \"last_mapping_commit\": \"57b069ae1e7ed32ff95e4f2a18a74d5eadcda550\",\n+      \"last_mapping_sha256\": \"de64c85b8a961bf5cf3b5df2e445b9992edaa20ad818024e921fbca0c38bfacc\",\n+      \"path\": \"trillionnium/crates/trnm-data-availability/src/cell/content_graph_v3.rs\",\n+      \"reason\": \"Declared bytes and SHA-256 match both the historical 57b069ae blob and the exact current 7d8d4c Git blob/regular worktree bytes.\",\n+      \"selected_source_commits\": []\n+    },\n+    {\n+      \"current_blob\": \"ea12a52cbcadeefded2108c7682f3c90f58d3588\",\n+      \"current_bytes\": 10548,\n+      \"current_commit\": \"7d8d4c59fcd01480a12e1c64835b202079091800\",\n+      \"current_equals_dc42\": true,\n+      \"current_matches_declared_pin\": true,\n+      \"current_raw_equals_worktree\": true,\n+      \"current_sha256\": \"7ff08fc23a7086a1a74671f85afd2f3919b982c11c0f0c3e69054fcc5ddbdc5b\",\n+      \"declared_pin\": {\n+        \"bytes\": 10548,\n+        \"sha256\": \"7ff08fc23a7086a1a74671f85afd2f3919b982c11c0f0c3e69054fcc5ddbdc5b\"\n+      },\n+      \"declared_pin_matches_last_mapping_commit\": true,\n+      \"declared_uses\": [\n+        \"migration-bounded-state-history\"\n+      ],\n+      \"disposition\": \"unchanged-exact-raw\",\n+      \"last_mapping_blob\": \"ea12a52cbcadeefded2108c7682f3c90f58d3588\",\n+      \"last_mapping_bytes\": 10548,\n+      \"last_mapping_commit\": \"57b069ae1e7ed32ff95e4f2a18a74d5eadcda550\",\n+      \"last_mapping_sha256\": \"7ff08fc23a7086a1a74671f85afd2f3919b982c11c0f0c3e69054fcc5ddbdc5b\",\n+      \"path\": \"trillionnium/crates/trnm-mvcc-fee/src/content_commitment_v1/history_v2.rs\",\n+      \"reason\": \"Declared bytes and SHA-256 match both the historical 57b069ae blob and the exact current 7d8d4c Git blob/regular worktree bytes.\",\n+      \"selected_source_commits\": []\n+    },\n+    {\n+      \"current_blob\": \"d596dc6bab16698cd18bcc15bcbbe1fafedf603e\",\n+      \"current_bytes\": 391470,\n+      \"current_commit\": \"7d8d4c59fcd01480a12e1c64835b202079091800\",\n+      \"current_equals_dc42\": true,\n+      \"current_matches_declared_pin\": false,\n+      \"current_path_history\": {\n+        \"bytes\": 1281,\n+        \"path\": \"/private/tmp/chain-hash-use-current-binding-evidence-20261114/readonly-pin-audit-v1/changed/trillionnium--crates--trnm-pon-node--src--store.rs.history\",\n+        \"sha256\": \"9b3a19d72f7a275dae91597cc814dcf1bc6b5eb503834bc8009750ee22686915\"\n+      },\n+      \"current_raw_equals_worktree\": true,\n+      \"current_sha256\": \"5918270368c61b420d26910dc5934714e1423f71c686b2d01f8d2e3ccceb990c\",\n+      \"declared_pin\": {\n+        \"bytes\": 387798,\n+        \"sha256\": \"df2e303798678fe0b7437cf707bdc1d9cd6559ece47fcf2dd8c7ba8de0b29a17\"\n+      },\n+      \"declared_pin_matches_last_mapping_commit\": true,\n+      \"declared_uses\": [\n+        \"migration-bounded-state-history\"\n+      ],\n+      \"disposition\": \"manually-reviewed-current-binding-with-retained-semantics\",\n+      \"full_blob_delta\": {\n+        \"bytes\": 10268,\n+        \"path\": \"/private/tmp/chain-hash-use-current-binding-evidence-20261114/readonly-pin-audit-v1/changed/trillionnium--crates--trnm-pon-node--src--store.rs.patch\",\n+        \"sha256\": \"e26f4e88d7b58b78e545954f3e12b1ef9f5fdbd2069b79cfc38c7f187fb5e47f\"\n+      },\n+      \"last_mapping_blob\": \"6ef5f01142a33eace66256dd6ecc81d34681d194\",\n+      \"last_mapping_bytes\": 387798,\n+      \"last_mapping_commit\": \"57b069ae1e7ed32ff95e4f2a18a74d5eadcda550\",\n+      \"last_mapping_sha256\": \"df2e303798678fe0b7437cf707bdc1d9cd6559ece47fcf2dd8c7ba8de0b29a17\",\n+      \"path\": \"trillionnium/crates/trnm-pon-node/src/store.rs\",\n+      \"reason\": \"The full delta adds TLS owner admission checks, shared read-transaction rollback fencing, lazy bounded ancestry spooling with progress, read-only Q4 advice, and confirmation chainwork/storage-epoch checks. The declared CMH2 implementation in store/migration_history_v2.rs and MVCC history_v2.rs is unchanged. No CMH2 serialization, hash domain, digest width, 32-block/32-MiB boundary or migration authorization field is changed by this delta; new APIs remain outside this finite review.\",\n+      \"retained_full_patch\": \"source-deltas/trillionnium--crates--trnm-pon-node--src--store.rs.patch\",\n+      \"selected_source_commits\": [\n+        \"687141e74aca9249ac8bec79d2b4116999683cae\",\n+        \"83612992abd90de344be699e8cf1a90e609480f5\",\n+        \"bc5f9d4bf9ceebd2ba0e91b2e8c9d7358a964736\",\n+        \"b89f78cdb702ede1f2a4a98502667929a5f77a2d\",\n+        \"182c3925d0ac0a65512b8c7419b670f3c847a902\"\n+      ]\n+    },\n+    {\n+      \"current_blob\": \"0464ba286dde87d859bbe70234d803cc5d9f1e96\",\n+      \"current_bytes\": 13942,\n+      \"current_commit\": \"7d8d4c59fcd01480a12e1c64835b202079091800\",\n+      \"current_equals_dc42\": true,\n+      \"current_matches_declared_pin\": true,\n+      \"current_raw_equals_worktree\": true,\n+      \"current_sha256\": \"afcb6583ba4367325f2ea540f389a50700a6136decddd280e34b0686abf05156\",\n+      \"declared_pin\": {\n+        \"bytes\": 13942,\n+        \"sha256\": \"afcb6583ba4367325f2ea540f389a50700a6136decddd280e34b0686abf05156\"\n+      },\n+      \"declared_pin_matches_last_mapping_commit\": true,\n+      \"declared_uses\": [\n+        \"migration-bounded-state-history\"\n+      ],\n+      \"disposition\": \"unchanged-exact-raw\",\n+      \"last_mapping_blob\": \"0464ba286dde87d859bbe70234d803cc5d9f1e96\",\n+      \"last_mapping_bytes\": 13942,\n+      \"last_mapping_commit\": \"57b069ae1e7ed32ff95e4f2a18a74d5eadcda550\",\n+      \"last_mapping_sha256\": \"afcb6583ba4367325f2ea540f389a50700a6136decddd280e34b0686abf05156\",\n+      \"path\": \"trillionnium/crates/trnm-pon-node/src/store/migration_history_v2.rs\",\n+      \"reason\": \"Declared bytes and SHA-256 match both the historical 57b069ae blob and the exact current 7d8d4c Git blob/regular worktree bytes.\",\n+      \"selected_source_commits\": []\n+    }\n+  ],\n+  \"schema\": \"hash-use-manual-current-source-review-v1\",\n+  \"semantics_sha256_unchanged\": \"29189f8e96a255472577479d46204b2b403a1f8e27806da6aa616e417ced0b5b\",\n+  \"source_roster_unchanged\": true,\n+  \"unchanged\": 25,\n+  \"use_roster_unchanged\": true,\n+  \"validation_summary_sha256\": \"bab2fb51c8b5cb3976e40fefeadb8f4771e475c90dd2bae524ccf445d2f9809c\"\n+}"},{"sha":"61204438376681f108ced4b0f0eac2070e88b6f4","filename":"evidence/hash-use-current-source-review-20261114/source-deltas/config--pon--pq-proof-profile-binding-v1.json.patch","status":"added","additions":15,"deletions":0,"changes":15,"blob_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/blob/5df7ae6f482157c5f7fdcbcd52222117a965053f/evidence%2Fhash-use-current-source-review-20261114%2Fsource-deltas%2Fconfig--pon--pq-proof-profile-binding-v1.json.patch","raw_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/raw/5df7ae6f482157c5f7fdcbcd52222117a965053f/evidence%2Fhash-use-current-source-review-20261114%2Fsource-deltas%2Fconfig--pon--pq-proof-profile-binding-v1.json.patch","contents_url":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/contents/evidence%2Fhash-use-current-source-review-20261114%2Fsource-deltas%2Fconfig--pon--pq-proof-profile-binding-v1.json.patch?ref=5df7ae6f482157c5f7fdcbcd52222117a965053f","patch":"@@ -0,0 +1,15 @@\n+diff --git a/304e81508897d7d865ea79d2cb4b25235ccb9d2f b/7714b037c3a752bdf11c7baf55723d27d90c8e8e\n+index 304e81508..7714b037c 100644\n+--- a/304e81508897d7d865ea79d2cb4b25235ccb9d2f\n++++ b/7714b037c3a752bdf11c7baf55723d27d90c8e8e\n+@@ -4,8 +4,8 @@\n+   \"selected_profile_id\": \"trnm-w1-risc0-3.0.6-poseidon2-join-v2\",\n+   \"mapping_contract\": {\n+     \"path\": \"config/pon/w1-qrom-implementation-current-v2.json\",\n+-    \"bytes\": 46786,\n+-    \"sha256\": \"27cabbd49a12d1f0381fe5c89351888b26d8cc83b95e44dcd1dddb9b97ae7934\"\n++    \"bytes\": 50313,\n++    \"sha256\": \"77f3901f137119ce245bf361990990b51ecb9affdc87f273404c4330a2870ee5\"\n+   },\n+   \"system_lifetime_register\": {\n+     \"path\": \"config/pon/pq128-lifetime-budget-v1.json\","},{"sha":"d5b675ac5d5d0983dbaad0b4915fcad6c751815d","filename":"evidence/hash-use-current-source-review-20261114/source-deltas/trillionnium--crates--trnm-crypto-primitives--src--pon_work.rs.patch","status":"added","additions":92,"deletions":0,"changes":92,"blob_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/blob/5df7ae6f482157c5f7fdcbcd52222117a965053f/evidence%2Fhash-use-current-source-review-20261114%2Fsource-deltas%2Ftrillionnium--crates--trnm-crypto-primitives--src--pon_work.rs.patch","raw_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/raw/5df7ae6f482157c5f7fdcbcd52222117a965053f/evidence%2Fhash-use-current-source-review-20261114%2Fsource-deltas%2Ftrillionnium--crates--trnm-crypto-primitives--src--pon_work.rs.patch","contents_url":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/contents/evidence%2Fhash-use-current-source-review-20261114%2Fsource-deltas%2Ftrillionnium--crates--trnm-crypto-primitives--src--pon_work.rs.patch?ref=5df7ae6f482157c5f7fdcbcd52222117a965053f","patch":"@@ -0,0 +1,92 @@\n+diff --git a/ce1608248d2ee67ed8f5d82a2c5f15942689139b b/b89112abb32b692c83cf94a3e85fce58c5798628\n+index ce1608248..b89112abb 100644\n+--- a/ce1608248d2ee67ed8f5d82a2c5f15942689139b\n++++ b/b89112abb32b692c83cf94a3e85fce58c5798628\n+@@ -10,12 +10,16 @@ pub mod blocked_zero_paired;\n+ pub mod facts;\n+ mod integer_paired;\n+ pub mod legal_attempt;\n++pub mod low_rank_prefix;\n+ pub mod maintenance_limb;\n+ pub mod maintenance_periodic;\n+ pub mod maintenance_prefix;\n+ pub mod paired_product;\n+ pub mod rejection_cache;\n++#[cfg(test)]\n++mod statement_boundaries;\n+ pub mod structured;\n++pub mod task_product_facts;\n+ \n+ pub const PROFILE: &str = \"pon-matmul-transcript-64-v1\";\n+ pub const N: usize = 64;\n+@@ -185,6 +189,43 @@ pub fn task_id(a: &[u32], b: &[u32]) -> Result<Hash, WorkError> {\n+     validate(b)?;\n+     Ok(hash(b\"task\", &[&field_bytes(a), &field_bytes(b)]))\n+ }\n++/// Same task bytes with cooperative owner checkpoints; cancellation is never a\n++/// statement that the task relation is invalid. The original entry stays intact.\n++pub fn task_id_with_progress<E>(\n++    a: &[u32],\n++    b: &[u32],\n++    progress: &mut impl FnMut(u64) -> Result<(), E>,\n++) -> Result<Hash, VerificationError<E>> {\n++    let mut completed = 0;\n++    for values in [a, b] {\n++        if values.len() != CELLS {\n++            return Err(WorkError::Length.into());\n++        }\n++        for chunk in values.chunks(256) {\n++            progress(completed).map_err(VerificationError::Cancelled)?;\n++            if chunk.iter().any(|v| u128::from(*v) >= Q) {\n++                return Err(WorkError::Field.into());\n++            }\n++            completed += chunk.len() as u64;\n++        }\n++    }\n++    let mut h = Sha256::new();\n++    h.update(b\"TRNM-PON1\\0\");\n++    h.update(4u16.to_le_bytes());\n++    h.update(b\"task\");\n++    for values in [a, b] {\n++        h.update(((CELLS * 4) as u32).to_le_bytes());\n++        for chunk in values.chunks(256) {\n++            progress(completed).map_err(VerificationError::Cancelled)?;\n++            for value in chunk {\n++                h.update(value.to_le_bytes());\n++            }\n++            completed += chunk.len() as u64;\n++        }\n++    }\n++    progress(completed).map_err(VerificationError::Cancelled)?;\n++    Ok(h.finalize().into())\n++}\n+ fn expand(challenge: Hash, label: u8, len: usize) -> Result<Vec<u32>, WorkError> {\n+     relation_only(expand_with_progress(\n+         challenge,\n+@@ -773,12 +814,25 @@ fn verify_with_kernel<E>(\n+     bytes: &[u8],\n+     progress: &mut impl FnMut(VerificationProgress) -> Result<(), E>,\n+     kernel: VerificationKernel,\n++) -> Result<VerifiedWork, VerificationError<E>> {\n++    let checked = checked_proof_inputs(challenge, expected_task, target, bytes, kernel)?;\n++    verify_checked_with_kernel(challenge, bytes, progress, kernel, checked)\n++}\n++\n++// Private continuation of the native verifier. Only the current invocation's\n++// checked statement/inputs may enter: callers cannot supply a cached verdict.\n++fn verify_checked_with_kernel<E>(\n++    challenge: Hash,\n++    bytes: &[u8],\n++    progress: &mut impl FnMut(VerificationProgress) -> Result<(), E>,\n++    kernel: VerificationKernel,\n++    checked: CheckedProofInputs,\n+ ) -> Result<VerifiedWork, VerificationError<E>> {\n+     let CheckedProofInputs {\n+         matrices,\n+         actual_task,\n+         ticket,\n+-    } = checked_proof_inputs(challenge, expected_task, target, bytes, kernel)?;\n++    } = checked;\n+     let (a, tail) = matrices.split_at(CELLS);\n+     let (b, claimed) = tail.split_at(CELLS);\n+     let claimed_bytes = &bytes[4 + 2 * CELLS * 4..4 + 3 * CELLS * 4];"},{"sha":"6c55c7bea891df034c44422337459b9806ce1fd9","filename":"evidence/hash-use-current-source-review-20261114/source-deltas/trillionnium--crates--trnm-data-availability--src--cell--store.rs.patch","status":"added","additions":46,"deletions":0,"changes":46,"blob_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/blob/5df7ae6f482157c5f7fdcbcd52222117a965053f/evidence%2Fhash-use-current-source-review-20261114%2Fsource-deltas%2Ftrillionnium--crates--trnm-data-availability--src--cell--store.rs.patch","raw_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/raw/5df7ae6f482157c5f7fdcbcd52222117a965053f/evidence%2Fhash-use-current-source-review-20261114%2Fsource-deltas%2Ftrillionnium--crates--trnm-data-availability--src--cell--store.rs.patch","contents_url":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/contents/evidence%2Fhash-use-current-source-review-20261114%2Fsource-deltas%2Ftrillionnium--crates--trnm-data-availability--src--cell--store.rs.patch?ref=5df7ae6f482157c5f7fdcbcd52222117a965053f","patch":"@@ -0,0 +1,46 @@\n+diff --git a/066bd942ef123d879679b7ba6fd684ddad046642 b/eb18bccfc79019c6fe2a8231c7ad92f90991bfcd\n+index 066bd942e..eb18bccfc 100644\n+--- a/066bd942ef123d879679b7ba6fd684ddad046642\n++++ b/eb18bccfc79019c6fe2a8231c7ad92f90991bfcd\n+@@ -42,8 +42,8 @@ pub struct CellReleaseLimitsV1 {\n+ pub struct CellStoreV1 {\n+     connection: Connection,\n+     read_only: bool,\n+-    config: super::CellCacheConfigV4,\n+-    path: PathBuf,\n++    pub(super) config: super::CellCacheConfigV4,\n++    pub(super) path: PathBuf,\n+     writer_identity: Option<File>,\n+ }\n+ \n+@@ -435,6 +435,30 @@ impl CellStoreV1 {\n+         Ok(None)\n+     }\n+ \n++    /// Private runtime consumer only. This deletes disposable cache rows after\n++    /// their exact bytes were fsynced to the admitted destination. It does not\n++    /// retire a provider lease, retention row, release authority or disk charge.\n++    #[cfg(unix)]\n++    pub(super) fn retire_consumed_runtime_segment(\n++        &self,\n++        manifest: &CellManifestV1,\n++        deadline: Instant,\n++    ) -> CellResultV1<()> {\n++        self.write_with_deadline(Some(deadline), |connection| {\n++            for chunk in manifest.chunks() {\n++                connection.execute(\n++                    \"DELETE FROM cell_chunks_v1 WHERE hash=?1\",\n++                    [chunk.sha256.as_slice()],\n++                )?;\n++            }\n++            connection.execute(\n++                \"DELETE FROM cell_manifests_v1 WHERE id=?1\",\n++                [manifest.id().as_slice()],\n++            )?;\n++            Ok(())\n++        })\n++    }\n++\n+     pub fn pack_file(\n+         &self,\n+         path: &Path,"},{"sha":"45cb28165fcaa872d9f33b5c058a25ce3498cfa0","filename":"evidence/hash-use-current-source-review-20261114/source-deltas/trillionnium--crates--trnm-data-availability--src--cell.rs.patch","status":"added","additions":63,"deletions":0,"changes":63,"blob_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/blob/5df7ae6f482157c5f7fdcbcd52222117a965053f/evidence%2Fhash-use-current-source-review-20261114%2Fsource-deltas%2Ftrillionnium--crates--trnm-data-availability--src--cell.rs.patch","raw_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/raw/5df7ae6f482157c5f7fdcbcd52222117a965053f/evidence%2Fhash-use-current-source-review-20261114%2Fsource-deltas%2Ftrillionnium--crates--trnm-data-availability--src--cell.rs.patch","contents_url":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/contents/evidence%2Fhash-use-current-source-review-20261114%2Fsource-deltas%2Ftrillionnium--crates--trnm-data-availability--src--cell.rs.patch?ref=5df7ae6f482157c5f7fdcbcd52222117a965053f","patch":"@@ -0,0 +1,63 @@\n+diff --git a/55cd859ca445af11ed47ddd5dfeefe45f614f9b6 b/5dfe1c4fe26b53940cdfedea887bab08cc6bcd26\n+index 55cd859ca..5dfe1c4fe 100644\n+--- a/55cd859ca445af11ed47ddd5dfeefe45f614f9b6\n++++ b/5dfe1c4fe26b53940cdfedea887bab08cc6bcd26\n+@@ -35,6 +35,8 @@ mod release_snapshot;\n+ mod residency;\n+ mod retained;\n+ mod retention;\n++#[cfg(unix)]\n++mod runtime_root;\n+ mod snapshot_schedule;\n+ mod store;\n+ mod tensor;\n+@@ -62,10 +64,12 @@ pub use bep52::{\n+     MAX_CELL_BEP52_METAINFO_BYTES_V1, MAX_CELL_BEP52_PROOF_BYTES_V1,\n+ };\n+ pub use bep52_peer::{\n+-    fetch_cell_bep52, fetch_cell_bep52_with_content, query_cell_bep52_dht_peers,\n+-    CellBep52DhtHintsV1, CellBep52DhtNodeHintV1, CellBep52FetchReportV1, CellBep52PeerLimitsV1,\n+-    CellBep52PeerSessionV1, CellBep52PeerUsageV1, CellBep52SeedV1, CELL_BEP52_PEER_PROFILE_V1,\n+-    MAX_CELL_BEP52_DHT_RESPONSE_BYTES_V1, MAX_CELL_BEP52_PEER_FRAME_BYTES_V1,\n++    fetch_cell_bep52, fetch_cell_bep52_with_content, lookup_cell_bep52_dht_peers,\n++    query_cell_bep52_dht_peers, CellBep52DhtEndpointPolicyV1, CellBep52DhtHintsV1,\n++    CellBep52DhtLookupReportV1, CellBep52DhtLookupStopV1, CellBep52DhtNodeHintV1,\n++    CellBep52FetchReportV1, CellBep52PeerLimitsV1, CellBep52PeerSessionV1, CellBep52PeerUsageV1,\n++    CellBep52SeedV1, CELL_BEP52_PEER_PROFILE_V1, MAX_CELL_BEP52_DHT_RESPONSE_BYTES_V1,\n++    MAX_CELL_BEP52_PEER_FRAME_BYTES_V1,\n+ };\n+ pub use bep52_peer::{\n+     CellBep52ReleaseLimitsV2, CellBep52ReleasePlanV2, CellBep52ReleaseReadUsageV2,\n+@@ -111,13 +115,13 @@ pub use custody::{\n+ };\n+ pub use delta::{fetch_delta_to_file, CellChunkDeltaV1, CellDeltaPlanV1, MAX_CELL_DELTA_BYTES_V1};\n+ pub use erasure::{\n+-    restore_cell_paged_version_to_cache_v2, CellPagedRetainedShardPlanFileV2,\n+-    CellPagedRetainedShardPlanRequestV2, CellPagedRetainedShardPlanV2,\n+-    CellPagedShardRestoreBudgetV2, CellPagedShardRestoreLimitsV2, CellPagedShardRestoreReadbackV2,\n+-    CellPagedShardRestoreRequestV2, CellPagedShardRestoreUsageV2, CellRetainedShardChunkV1,\n+-    CellRetainedShardPagePinV2, CellRetainedShardPageV2, CellRetainedShardPlanFileV1,\n+-    CellRetainedShardPlanRequestV1, CellRetainedShardPlanV1, CellRetainedShardRootV1,\n+-    MAX_CELL_PAGED_RETAINED_CHUNKS_V2, MAX_CELL_RETAINED_SHARD_CHUNKS_V1,\n++    restore_cell_paged_version_to_cache_controlled_v2, restore_cell_paged_version_to_cache_v2,\n++    CellPagedRetainedShardPlanFileV2, CellPagedRetainedShardPlanRequestV2,\n++    CellPagedRetainedShardPlanV2, CellPagedShardRestoreBudgetV2, CellPagedShardRestoreLimitsV2,\n++    CellPagedShardRestoreReadbackV2, CellPagedShardRestoreRequestV2, CellPagedShardRestoreUsageV2,\n++    CellRetainedShardChunkV1, CellRetainedShardPagePinV2, CellRetainedShardPageV2,\n++    CellRetainedShardPlanFileV1, CellRetainedShardPlanRequestV1, CellRetainedShardPlanV1,\n++    CellRetainedShardRootV1, MAX_CELL_PAGED_RETAINED_CHUNKS_V2, MAX_CELL_RETAINED_SHARD_CHUNKS_V1,\n+     MAX_CELL_RETAINED_SHARD_PAGES_V2, MAX_CELL_RETAINED_SHARD_PLAN_BYTES_V1,\n+     MAX_CELL_RETAINED_SHARD_ROOTS_V1, MAX_CELL_RETAINED_SHARD_ROOT_BYTES_V2,\n+ };\n+@@ -208,6 +212,11 @@ pub use residency::{CellSealedLoaderBundleV1, CellSealedLoaderFileV1, CellSealed\n+ pub use retention::{\n+     CellRetentionConfigV1, CellRetentionContractV1, CellRetentionReadbackV1, CellRetentionStoreV1,\n+ };\n++#[cfg(unix)]\n++pub use runtime_root::{\n++    materialize_runtime_root_v1, runtime_files_root_v1, CellRuntimeFileV1, CellRuntimeLimitsV1,\n++    CellRuntimeMaterializationV1, CellRuntimePlanV1, CellRuntimeRoleV1,\n++};\n+ pub use store::{CellReleaseLimitsV1, CellStoreV1};\n+ pub use tensor::{\n+     CellTensorContractV1, CellTensorDTypeV1, CellTensorFileV1, CellTensorModelManifestV1,"},{"sha":"aab655afe6f2194039d09c3dc564935bf0aaae67","filename":"evidence/hash-use-current-source-review-20261114/source-deltas/trillionnium--crates--trnm-pon-node--src--lib.rs.patch","status":"added","additions":34,"deletions":0,"changes":34,"blob_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/blob/5df7ae6f482157c5f7fdcbcd52222117a965053f/evidence%2Fhash-use-current-source-review-20261114%2Fsource-deltas%2Ftrillionnium--crates--trnm-pon-node--src--lib.rs.patch","raw_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/raw/5df7ae6f482157c5f7fdcbcd52222117a965053f/evidence%2Fhash-use-current-source-review-20261114%2Fsource-deltas%2Ftrillionnium--crates--trnm-pon-node--src--lib.rs.patch","contents_url":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/contents/evidence%2Fhash-use-current-source-review-20261114%2Fsource-deltas%2Ftrillionnium--crates--trnm-pon-node--src--lib.rs.patch?ref=5df7ae6f482157c5f7fdcbcd52222117a965053f","patch":"@@ -0,0 +1,34 @@\n+diff --git a/aafd91425cbde49bbb368f47f5c4a17c3b2b85bf b/594d06db78ce4d3b3d5c417f6abe3a0a93b3df6b\n+index aafd91425..594d06db7 100644\n+--- a/aafd91425cbde49bbb368f47f5c4a17c3b2b85bf\n++++ b/594d06db78ce4d3b3d5c417f6abe3a0a93b3df6b\n+@@ -22,6 +22,9 @@ pub mod operator_continuous_controller;\n+ mod operator_continuous_cpu;\n+ mod operator_continuous_history;\n+ mod operator_continuous_lease;\n++pub use operator_continuous_lease::{\n++    forecast_q4_renewal_window, Q4RenewalForecast, Q4RenewalPhase,\n++};\n+ pub mod operator_continuous_policy;\n+ pub mod operator_continuous_pool;\n+ mod operator_continuous_recipient;\n+@@ -41,6 +44,8 @@ pub mod release_finality;\n+ pub mod release_owner;\n+ /// Opt-in bounded work-schedule checks; never selected by native admission.\n+ pub mod research_work_schedule;\n++/// Explicit finite cross-process resource reservations for a fixed local Node.\n++pub mod resource_owner_v1;\n+ #[cfg(all(target_os = \"linux\", feature = \"pq-root-v3\"))]\n+ pub mod root_recovery_v3;\n+ mod store;\n+@@ -78,8 +83,8 @@ pub use store::native_owner_observation::{\n+     MAX_CENSUS_PACKET_BYTES,\n+ };\n+ pub use store::packet_observation::{\n+-    observe_existing_packet, PacketObservationBackend,\n+-    DEFAULT_PACKET_OBSERVATION_SNAPSHOT_BYTE_LIMIT,\n++    observe_existing_packet, observe_existing_packet_owned, PacketObservationBackend,\n++    PacketObservationResourceContractV1, DEFAULT_PACKET_OBSERVATION_SNAPSHOT_BYTE_LIMIT,\n+ };\n+ pub use store::pinned_account_query::PinnedNativeAccountQuery;\n+ pub use store::storage_service::{"},{"sha":"732b89aa2adfec34fd9244f0b8906629b1f16042","filename":"evidence/hash-use-current-source-review-20261114/source-deltas/trillionnium--crates--trnm-pon-node--src--store.rs.patch","status":"added","additions":223,"deletions":0,"changes":223,"blob_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/blob/5df7ae6f482157c5f7fdcbcd52222117a965053f/evidence%2Fhash-use-current-source-review-20261114%2Fsource-deltas%2Ftrillionnium--crates--trnm-pon-node--src--store.rs.patch","raw_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/raw/5df7ae6f482157c5f7fdcbcd52222117a965053f/evidence%2Fhash-use-current-source-review-20261114%2Fsource-deltas%2Ftrillionnium--crates--trnm-pon-node--src--store.rs.patch","contents_url":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/contents/evidence%2Fhash-use-current-source-review-20261114%2Fsource-deltas%2Ftrillionnium--crates--trnm-pon-node--src--store.rs.patch?ref=5df7ae6f482157c5f7fdcbcd52222117a965053f","patch":"@@ -0,0 +1,223 @@\n+diff --git a/6ef5f01142a33eace66256dd6ecc81d34681d194 b/d596dc6bab16698cd18bcc15bcbbe1fafedf603e\n+index 6ef5f0114..d596dc6ba 100644\n+--- a/6ef5f01142a33eace66256dd6ecc81d34681d194\n++++ b/d596dc6bab16698cd18bcc15bcbbe1fafedf603e\n+@@ -11,6 +11,8 @@ pub(crate) mod authenticated_state;\n+ #[cfg(test)]\n+ mod canonical_row_reuse_tests;\n+ pub mod capacity_observation;\n++#[cfg(test)]\n++mod confirmation_chainwork_tests;\n+ pub mod demand_evidence;\n+ pub mod evaluation_observation;\n+ pub mod evaluation_round_observation;\n+@@ -1844,6 +1846,13 @@ impl Node {\n+                 ),\n+             \"PQ_EXISTING_OWNER_BACKEND\",\n+         )?;\n++        if let Some(policy) = owners.pq_network.as_deref() {\n++            ensure(\n++                !crate::ingress::pq_network::policy_record_requires_endpoint_witness(policy)?\n++                    || (state_backend == StateBackend::PqWitnessV4 && owners.pq_witness.is_some()),\n++                \"PQ_TLS_ENDPOINT_WITNESS_REQUIRED\",\n++            )?;\n++        }\n+         ensure(\n+             !authenticated_migration_pending(path)?,\n+             \"NATIVE_STATE_MIGRATION_PENDING\",\n+@@ -2389,27 +2398,18 @@ impl Node {\n+         }\n+         progress(NativeAccountProofProgress::BeforeRead)?;\n+         self.namespace()?;\n+-        let tx = self.db.unchecked_transaction()?;\n+-        let read_changes = tx.total_changes();\n+-        self.storage_context()?;\n+-        let (checkpoint, _) = self.checked_account_query_checkpoint(&tx, block, progress)?;\n+-        let (proof, observation) =\n+-            multiproof::from_native_database(&tx, &checkpoint, owners, &|point| {\n+-                progress(NativeAccountProofProgress::Proof(point))\n+-                    .map_err(NativeAccountProofFailure::Control)\n+-            })\n+-            .map_err(NativeAccountProofFailure::into_error)?;\n+-        progress(NativeAccountProofProgress::BeforeOutput)?;\n+-        // A completed read has no write authority. Count same-connection row\n+-        // writes, including a write that a callback subsequently restores.\n+-        // This is a local ownership fence, not an external-writer attestation.\n+-        if tx.total_changes() != read_changes {\n+-            self.invalidate_commitment();\n+-            return Err(Error::from(\"NATIVE_ACCOUNT_PROOF_WRITE\").local_integrity());\n+-        }\n+-        // Never commit a query transaction (including uncounted schema changes).\n+-        tx.rollback()?;\n+-        Ok((checkpoint, proof, observation))\n++        self.with_account_query_snapshot(|db| {\n++            self.storage_context()?;\n++            let (checkpoint, _) = self.checked_account_query_checkpoint(db, block, progress)?;\n++            let (proof, observation) =\n++                multiproof::from_native_database(db, &checkpoint, owners, &|point| {\n++                    progress(NativeAccountProofProgress::Proof(point))\n++                        .map_err(NativeAccountProofFailure::Control)\n++                })\n++                .map_err(NativeAccountProofFailure::into_error)?;\n++            progress(NativeAccountProofProgress::BeforeOutput)?;\n++            Ok((checkpoint, proof, observation))\n++        })\n+     }\n+     fn decode_replay_row(row: ReplayRow) -> Result<PeerReplayStateV0> {\n+         let chain = IoDigest32V0::new(bytes32(row.0)?)\n+@@ -3994,7 +3994,7 @@ impl Node {\n+         if tip == self.active()?.0 {\n+             return Ok(self.read_active_with_readback(progress, readback)?.2);\n+         }\n+-        let mut path = reverse_path::ReversePath::new(tempfile::tempfile()?);\n++        let mut path = reverse_path::ReversePath::new_lazy();\n+         let mut count = 0u64;\n+         let mut prefer_replay_prefix = false;\n+         let mut cur = tip;\n+@@ -4049,13 +4049,12 @@ impl Node {\n+                 }\n+                 break (state, commitment);\n+             }\n+-            path.push(cur)?;\n++            path.push_with(cur, tempfile::tempfile)?;\n+             count = count.checked_add(1).ok_or(\"ANCESTRY_LIMIT\")?;\n+             cur = self.parent(cur)?;\n+         };\n+         for replay_index in 0..count {\n+-            progress()?;\n+-            let id = path.pop()?.ok_or(\"ANCESTRY_LIMIT\")?;\n++            let id = path.pop_with_progress(progress)?.ok_or(\"ANCESTRY_LIMIT\")?;\n+             for (index, (key, before, after)) in self\n+                 .delta_rows_with_progress(id, progress)?\n+                 .into_iter()\n+@@ -5461,6 +5460,45 @@ impl Node {\n+     pub fn parent_height(&self, parent: Hash) -> Result<u64> {\n+         Ok(self.record(parent)?.height)\n+     }\n++    /// Active-branch read-only Q4 forecast. Unlike the generic time-only\n++    /// advisor this reads and checks the ACTUAL current parent, authenticated\n++    /// lifecycle/source statement and its verified state root first.\n++    /// There is no signing, dispatch, slot reservation, inclusion guarantee,\n++    /// permission to retry Unknown effects, or mining-mode substitution.\n++    /// Reorganization or a changed local generation invalidates the advice.\n++    pub fn forecast_q4_renewal_from_active(\n++        &self,\n++        task: Hash,\n++        proposed_lease: &trnm_protocol::qualified_work_task::lifecycle_v2::DemandLeaseV2,\n++        assumed_queue_lag_blocks: u64,\n++        assumed_safety_margin_blocks: u64,\n++    ) -> Result<(Hash, u64, crate::Q4RenewalForecast)> {\n++        ensure(\n++            matches!(\n++                self.settings.task_profile(),\n++                OVERLAP_TASK_PROFILE | CONTINUITY_TASK_PROFILE\n++            ),\n++            \"Q4_FORECAST_PROFILE\",\n++        )?;\n++        let (tip, generation, state) = self.read_active()?;\n++        let next_height = self.record(tip)?.height.checked_add(1).ok_or(\"HEIGHT\")?;\n++        let actual_lease =\n++            qualified_task_lifecycle::eligible_task(&state, task, next_height, &self.settings.app)?;\n++        let forecast = crate::forecast_q4_renewal_window(\n++            actual_lease.lease(),\n++            proposed_lease,\n++            next_height,\n++            assumed_queue_lag_blocks,\n++            assumed_safety_margin_blocks,\n++        )\n++        .map_err(|_| Error::from(\"Q4_FORECAST_REFUSED\"))?;\n++        ensure(\n++            self.active()? == (tip, generation),\n++            \"ACTIVE_GENERATION_CONFLICT\",\n++        )?;\n++        Ok((tip, generation, forecast))\n++    }\n++\n+     pub fn lifecycle_task_lease(\n+         &self,\n+         parent: Hash,\n+@@ -6821,6 +6859,11 @@ impl Node {\n+             self.state_backend != StateBackend::PermanentAccountGrowthV2,\n+             \"GROWTH_USE_CONFIRMATION_PROGRESS\",\n+         )?;\n++        // A successful observation must use one unchanged local storage epoch.\n++        // The owner excludes cooperating writers; these counters additionally\n++        // detect callback writes and commits by independent SQLite connections.\n++        // They do not authenticate arbitrary out-of-band filesystem mutation.\n++        let epoch = self.admission_state_epoch()?;\n+         self.ready()?;\n+         let (tip, generation, _) = self.read_active_with_progress(&mut || progress(0))?;\n+         let mut included = BTreeMap::new();\n+@@ -6844,6 +6887,8 @@ impl Node {\n+         }\n+         let observed = self.record(tip)?;\n+         let mut current = tip;\n++        let mut expected_height = observed.height;\n++        let mut expected_work = observed.work;\n+         let mut found = BTreeSet::new();\n+         let mut checked = 0u64;\n+         let bound = observed_now as u128 + self.settings.limit(\"future_skew_seconds\")? as u128;\n+@@ -6851,14 +6896,49 @@ impl Node {\n+             // The prior query has ended before cancellation or caller code runs.\n+             progress(checked)?;\n+             let (parent, count) = self.visit_header_batch(current, &mut |id, link| {\n+-                if included.contains_key(&id) {\n++                let required =\n++                    consensus::required_work(link.header.target).map_err(Error::local_integrity)?;\n++                let cumulative = link\n++                    .parent_work\n++                    .checked_add(required)\n++                    .map_err(Error::local_integrity)?;\n++                ensure(\n++                    link.record.height == expected_height\n++                        && link.record.work == expected_work\n++                        && link.record.work == cumulative,\n++                    \"STORAGE_PACKET\",\n++                )\n++                .map_err(Error::local_integrity)?;\n++                if let Some((row, _, _)) = included.get(&id) {\n++                    ensure(\n++                        row.height == link.record.height && row.work == link.record.work,\n++                        \"STORAGE_PACKET\",\n++                    )\n++                    .map_err(Error::local_integrity)?;\n+                     found.insert(id);\n+                 }\n+-                ensure(link.header.timestamp as u128 <= bound, \"TIME_DEFERRED\")\n++                ensure(link.header.timestamp as u128 <= bound, \"TIME_DEFERRED\")?;\n++                expected_height = link\n++                    .record\n++                    .height\n++                    .checked_sub(1)\n++                    .ok_or_else(|| Error::from(\"ANCESTRY_HEIGHT\").local_integrity())?;\n++                expected_work = link.parent_work;\n++                Ok(())\n+             })?;\n+             current = parent;\n+             checked = checked.checked_add(count).ok_or(\"ANCESTRY_LIMIT\")?;\n+         }\n++        let genesis = self.record(current).map_err(Error::local_integrity)?;\n++        ensure(\n++            genesis.parent.is_none()\n++                && genesis.height == 0\n++                && genesis.work == Work::default()\n++                && expected_height == 0\n++                && expected_work == genesis.work,\n++            \"STORAGE_PACKET\",\n++        )\n++        .map_err(Error::local_integrity)?;\n+         let depth_required = self.settings.limit(\"confirmation_depth\")?;\n+         let multiplier = self.settings.limit(\"confirmation_work_multiplier\")?;\n+         let mut observations = Vec::with_capacity(queries.len());\n+@@ -6895,7 +6975,10 @@ impl Node {\n+             });\n+         }\n+         progress(checked)?;\n+-        ensure(self.active()? == (tip, generation), \"STALE_VIEW\")?;\n++        ensure(\n++            self.active()? == (tip, generation) && self.admission_state_epoch()? == epoch,\n++            \"STALE_VIEW\",\n++        )?;\n+         Ok(ConfirmationBatch {\n+             observations,\n+             ancestry_checked: checked,"},{"sha":"e69de29bb2d1d6434b8b29ae775ad8c2e48c5391","filename":"evidence/hash-use-current-source-review-20261114/validation-v1/actual-ci-contract.stderr","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/blob/5df7ae6f482157c5f7fdcbcd52222117a965053f/evidence%2Fhash-use-current-source-review-20261114%2Fvalidation-v1%2Factual-ci-contract.stderr","raw_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/raw/5df7ae6f482157c5f7fdcbcd52222117a965053f/evid