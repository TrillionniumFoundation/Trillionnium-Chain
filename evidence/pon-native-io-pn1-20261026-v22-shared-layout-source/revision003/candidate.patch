+            &write,
+            &f.node.settings,
+            f.block,
+            &mut || {
+                calls += 1;
+                Ok(())
+            },
+            &f.node.authenticated_arithmetic,
+        )
+        .unwrap();
+        let mut index = 0usize;
+        let error = load(
+            &write,
+            &f.node.settings,
+            f.block,
+            &mut || {
+                index += 1;
+                if index == calls {
+                    if corrupt {
+                        f.node.db.execute(
+                            "UPDATE archive_nodes SET data=X'7b7d' WHERE id=?",
+                            [root.as_slice()],
+                        )?;
+                    } else {
+                        f.node
+                            .db
+                            .execute("DELETE FROM archive_nodes WHERE id=?", [root.as_slice()])?;
