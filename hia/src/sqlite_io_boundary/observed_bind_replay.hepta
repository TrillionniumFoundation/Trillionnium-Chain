  have_b:bool = compare.ne(psecond,b0)
  a_dev:bool = compare.eq(first_dev,new_dev)
  a_ino:bool = compare.eq(first_ino,new_ino)
  b_dev:bool = compare.eq(second_dev,new_dev)
  b_ino:bool = compare.eq(second_ino,new_ino)
