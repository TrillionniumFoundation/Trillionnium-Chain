fn vr_compare(input:readbuf,left:u64,right:u64,width:u64) -> (bool) effects(read,trap) entry(entry)
block entry(input:readbuf,left:u64,right:u64,width:u64)
  order:u64 = call(input,left,right,width,width) {"function":"sb_compare"}
  equal:u64 = const() {"value":1}
  same:bool = compare.eq(order,equal)
