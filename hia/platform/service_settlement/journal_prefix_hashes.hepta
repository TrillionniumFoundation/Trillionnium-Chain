  stride:u64 = const() {"value":32}
  roots:u64 = const() {"value":3000}
  offset:u64 = int.mul.wrap(si,stride)
  at_s:u64 = int.add.wrap(roots,offset)
  saved:u64 = call(sw,root,at_s,stride) {"function":"cp_wcopy"}
  done:bool = compare.eq(si,sc)
  branch done ending(se,sp) receipt(sw,se,sc,sp,si)
block receipt(rw:mutbuf,re:u64,rc:u64,rp:u64,ri:u64)
  row_n:u64 = call(rw,rp,re) {"function":"jph_read_u32"}
  normal:u64 = const() {"value":149}
  settled:u64 = const() {"value":181}
  a:bool = compare.eq(row_n,normal)
  b:bool = compare.eq(row_n,settled)
  recognized:bool = bool.or(a,b)
  branch recognized advance(rw,re,rc,rp,ri,row_n) bad()
block advance(aw:mutbuf,ae:u64,ac:u64,ap:u64,ai:u64,ar:u64)
  one_a:u64 = const() {"value":1}
  four_a:u64 = const() {"value":4}
  row_w:u64 = int.add.wrap(ar,four_a)
  next:u64 = int.add.wrap(ap,row_w)
  i_next:u64 = int.add.wrap(ai,one_a)
  in_scope:bool = compare.le(next,ae)
  branch in_scope loop(aw,ae,ac,next,i_next) bad()
