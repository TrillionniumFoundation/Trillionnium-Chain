+        check_deadline(deadline)?;
+        validate_schema(&self.connection)?;
+        let original = self.required_row(operation)?;
+        let count: u64 = self
+            .connection
+            .query_row("SELECT count(*) FROM repairs", [], |row| row.get(0))?;
