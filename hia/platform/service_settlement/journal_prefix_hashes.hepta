  ret(word)
block bad()
  sentinel:u64 = const() {"value":18446744073709551615}
  ret(sentinel)
end

fn jph_hash(w:mutbuf,from:u64,until:u64,count:u64) -> (bool) effects(read,write,trap) entry(entry)
block entry(w:mutbuf,from:u64,until:u64,count:u64)
  prefix:bool = call(w,count) {"function":"sjr_prefix"}
  length:u64 = int.sub.wrap(until,from)
