fn vr_resolve(input:readbuf,row:u64,asked:u64,height_at:u64) -> (u32) effects(read,trap) entry(entry)
block entry(input:readbuf,row:u64,asked:u64,height_at:u64)
  id_width:u64 = const() {"value":32}
  stored:u64 = int.add.wrap(row,id_width)
  hash_same:bool = call(input,stored,asked,id_width) {"function":"vr_compare"}
  branch hash_same enabled(input,row,height_at) hash_mismatch()
block enabled(ei:readbuf,erow:u64,eheight_at:u64)
  flags_at:u64 = const() {"value":93}
  flag_width:u64 = const() {"value":4}
  flags:u64 = call(ei,erow,flags_at,flag_width) {"function":"vr_read"}
  one:u64 = const() {"value":1}
  is_enabled:u64 = bit.and(flags,one)
  ready:bool = compare.eq(is_enabled,one)
  branch ready validity(ei,erow,flags,eheight_at) disabled()
block validity(vi:readbuf,vrow:u64,vflags:u64,queried:u64)
  width:u64 = const() {"value":8}
  height:u64 = call(vi,queried,width) {"function":"rac_read_le"}
  valid_at:u64 = const() {"value":68}
  valid_from:u64 = call(vi,vrow,valid_at,width) {"function":"vr_read"}
  future:bool = compare.lt(height,valid_from)
  branch future not_yet() expiry(vi,vrow,vflags,height,width)
block expiry(xi:readbuf,xrow:u64,xf:u64,xheight:u64,xw:u64)
  expiration_at:u64 = const() {"value":76}
  expiration:u64 = call(xi,xrow,expiration_at,xw) {"function":"vr_read"}
  eflag:u64 = const() {"value":256}
  ebit:u64 = bit.and(xf,eflag)
  has_exp:bool = compare.eq(ebit,eflag)
  after_expiry:bool = compare.gt(xheight,expiration)
  closed:bool = bool.and(has_exp,after_expiry)
  branch closed expired() revocation(xi,xrow,xf,xheight,xw)
block revocation(ri:readbuf,rrow:u64,rf:u64,rheight:u64,rwidth:u64)
  revoke_at:u64 = const() {"value":84}
  revoked_at:u64 = call(ri,rrow,revoke_at,rwidth) {"function":"vr_read"}
  rflag:u64 = const() {"value":65536}
  rbit:u64 = bit.and(rf,rflag)
  has_revoke:bool = compare.eq(rbit,rflag)
  reached:bool = compare.ge(rheight,revoked_at)
  lost:bool = bool.and(has_revoke,reached)
  branch lost revoked() accept()
block hash_mismatch()
  bad_hash:u32 = const() {"value":8}
  ret(bad_hash)
block disabled()
  not_enabled:u32 = const() {"value":9}
  ret(not_enabled)
block not_yet()
  premature:u32 = const() {"value":10}
  ret(premature)
block expired()
  too_late:u32 = const() {"value":11}
  ret(too_late)
block revoked()
  not_current:u32 = const() {"value":12}
  ret(not_current)
block accept()
  ok:u32 = const() {"value":0}
  ret(ok)
end
