fn archive_u32(raw:readbuf,offset:u64) -> (u64) effects(read,write,trap) entry(entry)
block entry(raw:readbuf,offset:u64)
  next:u64 = const() {"value":0}
  result:u64 = const() {"value":0}
  jump loop(raw,offset,next,result)
block loop(r:readbuf,p:u64,count:u64,acc:u64)
  i:u64 = int.add.wrap(p,count)
  at:usize = int.cast(i) {"mode":"wrap"}
  b:u8 = buffer.load(r,at)
  bb:u64 = int.cast(b) {"mode":"wrap"}
  eight8:u64 = const() {"value":8}
  shift:u64 = int.mul.wrap(count,eight8)
  word:u64 = int.shl.checked(bb,shift)
  accum:u64 = bit.or(acc,word)
  one_one:u64 = const() {"value":1}
  again:u64 = int.add.wrap(count,one_one)
  four:u64 = const() {"value":4}
  more:bool = compare.lt(again,four)
  branch more loop(r,p,again,accum) done(accum)
block done(answer:u64)
  ret(answer)
end

fn archive_equal(input:readbuf,left:u64,right:u64,n:u64) -> (bool) effects(read,write,trap) entry(entry)
