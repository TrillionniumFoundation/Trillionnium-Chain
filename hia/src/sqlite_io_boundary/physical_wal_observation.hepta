  a_ops:u64 = call(r,a,i_a_ops) {"function":"mvp_get"}
  i_b_ops:u64 = const() {"value":112}
  b_ops:u64 = call(r,b,i_b_ops) {"function":"mvp_get"}
  i_a_growth:u64 = const() {"value":128}
  a_growth:u64 = call(r,a,i_a_growth) {"function":"mvp_get"}
  i_b_growth:u64 = const() {"value":128}
  b_growth:u64 = call(r,b,i_b_growth) {"function":"mvp_get"}
