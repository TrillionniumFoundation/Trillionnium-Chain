fn root_compare_literal(r:readbuf,w:mutbuf,a:u64,b:u64,n:u64) -> (bool) effects(read,write,trap) entry(entry)
block entry(r:readbuf,w:mutbuf,a:u64,b:u64,n:u64)
  zero:u64 = const() {"value":0}
  jump loop(r,w,a,b,n,zero)
block loop(lr:readbuf,lw:mutbuf,la:u64,lb:u64,ln:u64,li:u64)
  more:bool = compare.lt(li,ln)
  branch more byte(lr,lw,la,lb,ln,li) yes()
block byte(br:readbuf,bw:mutbuf,ba:u64,bb:u64,bn:u64,bi:u64)
  ro:u64 = int.add.wrap(ba,bi)
  wo:u64 = int.add.wrap(bb,bi)
  x_at:usize = int.cast(ro) {"mode":"wrap"}
  y_at:usize = int.cast(wo) {"mode":"wrap"}
  a0:u8 = buffer.load(br,x_at)
  b0:u8 = buffer.load(bw,y_at)
  same:bool = compare.eq(a0,b0)
  inc:u64 = const() {"value":1}
  next:u64 = int.add.wrap(bi,inc)
  branch same loop(br,bw,ba,bb,bn,next) no()
block no()
  failure:bool = const() {"value":false}
  ret(failure)
block yes()
  okay:bool = const() {"value":true}
  ret(okay)
end

