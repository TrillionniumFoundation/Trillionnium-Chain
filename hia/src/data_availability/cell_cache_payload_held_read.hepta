  ok_feed:bool = compare.eq(feed,good0)
  branch ok_feed hash_end(yi,yo,yw,yb,yr,yf,yc,yp,yn) internal()
block hash_end(ei:readbuf,eo:mutbuf,ew:mutbuf,eb:u64,er:u64,ef:u64,ec:u64,ep:u64,en:u64)
  end:u64 = call(ew) {"function":"tr_sha_final"}
  eq0:u64 = const() {"value":0}
  good:bool = compare.eq(end,eq0)
  branch good equal(ei,eo,ew,eb,er,ef,ec,ep,en) internal()
block equal(di:readbuf,do:mutbuf,dw:mutbuf,db:u64,dr:u64,df:u64,dc:u64,dp:u64,dn:u64)
  four:u64 = const() {"value":4}
  digest_pos:u64 = int.add.wrap(dr,four)
  out_digest:u64 = const() {"value":1168}
  hash_bytes:u64 = const() {"value":32}
  same:u64 = call(di,digest_pos,dw,out_digest,hash_bytes) {"function":"ca_equal"}
  eq1:u64 = const() {"value":1}
  valid_hash:bool = compare.eq(same,eq1)
  branch valid_hash extent(di,do,db,dr,df,dc,dp,dn,four) digest_missing()
block extent(xi:readbuf,xo:mutbuf,xb:u64,xr:u64,xf:u64,xc:u64,xp:u64,xn:u64,x4:u64)
  expected:u64 = call(xi,xr,x4) {"function":"ca_read_be"}
  valid_length:bool = compare.eq(expected,xn)
  branch valid_length read_room(xi,xo,xb,xf,xc,xp) chunk_length()
block read_room(ri:readbuf,ro:mutbuf,rb:u64,rf:u64,rcount:u64,rp:u64)
  header:u64 = const() {"value":16}
  required:u64 = int.add.wrap(header,rcount)
