  idx:usize = int.cast(pos) {"mode":"wrap"}
  _ = buffer.store(bw,idx,octet)
  one:u64 = const() {"value":1}
  next:u64 = int.add.wrap(bi,one)
  jump loop(bw,ba,bv,next)
block done(di:u64)
  ret(di)
end
