fn hfs_limit(profile:u64) -> (u64) effects() entry(entry)
block entry(profile:u64)
  pair:u64 = const() {"value":2}
  need_pair:bool = call(profile) {"function":"hfs_same_profile"}
  limit:u64 = select(need_pair,pair,profile)
  variable:u64 = const() {"value":6}
  one:u64 = const() {"value":1}
  is_variable:bool = compare.eq(profile,variable)
  rows:u64 = select(is_variable,one,limit)
  var_pair:u64 = const() {"value":7}
  is_var_pair:bool = compare.eq(profile,var_pair)
  result:u64 = select(is_var_pair,pair,rows)
  var_settle:u64 = const() {"value":8}
  four:u64 = const() {"value":4}
  old_var_settle:bool = compare.eq(profile,var_settle)
  plan_mixed:bool = call(profile) {"function":"hfs_mixed_plan_profile"}
  is_var_settle:bool = bool.or(old_var_settle,plan_mixed)
  final:u64 = select(is_var_settle,four,result)
  linear:bool = call(profile) {"function":"hfs_linear3"}
  three:u64 = const() {"value":3}
  rows3:u64 = select(linear,three,final)
  ret(rows3)
end

fn hfs_same_profile(profile:u64) -> (bool) effects() entry(entry)
block entry(profile:u64)
  fixed:u64 = const() {"value":5}
  measured:u64 = const() {"value":11}
  old:bool = compare.eq(profile,fixed)
  sized:bool = compare.eq(profile,measured)
  same:bool = bool.or(old,sized)
  ret(same)
end

fn hfs_variable(profile:u64) -> (bool) effects() entry(entry)
block entry(profile:u64)
  single:u64 = const() {"value":6}
  pair:u64 = const() {"value":7}
  is_one:bool = compare.eq(profile,single)
  is_two:bool = compare.eq(profile,pair)
  mixed:u64 = const() {"value":8}
  legacy_mixed:bool = compare.eq(profile,mixed)
  is_plan:bool = call(profile) {"function":"hfs_mixed_plan_profile"}
  is_mixed:bool = bool.or(legacy_mixed,is_plan)
  old:bool = bool.or(is_one,is_two)
  measured:bool = bool.or(old,is_mixed)
  linear:bool = call(profile) {"function":"hfs_linear_profile"}
  original:bool = bool.or(measured,linear)
  generic_same:u64 = const() {"value":11}
  is_generic_same:bool = compare.eq(profile,generic_same)
  variable:bool = bool.or(original,is_generic_same)
  ret(variable)
end

fn hfs_settled(profile:u64) -> (bool) effects() entry(entry)
block entry(profile:u64)
  fixed:u64 = const() {"value":4}
  measured:u64 = const() {"value":8}
  is_fixed:bool = compare.eq(profile,fixed)
  is_measured:bool = compare.eq(profile,measured)
  known:bool = bool.or(is_fixed,is_measured)
  is_plan:bool = call(profile) {"function":"hfs_mixed_plan_profile"}
  proof:bool = bool.or(known,is_plan)
  ret(proof)
end

fn hfs_linear3(profile:u64) -> (bool) effects() entry(entry)
block entry(profile:u64)
  stage:u64 = const() {"value":9}
