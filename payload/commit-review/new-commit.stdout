d7c5139499f46cd0009baf92acd9dedc046b36b5d260585287cdc8d9fe2542b\"\n+    },\n+    {\n+      \"bytes\": 5688,\n+      \"path\": \"f2/validation/source-inputs-before.json\",\n+      \"sha256\": \"fd7c5139499f46cd0009baf92acd9dedc046b36b5d260585287cdc8d9fe2542b\"\n+    },\n+    {\n+      \"bytes\": 6213,\n+      \"path\": \"f2/validation/steps-progress.json\",\n+      \"sha256\": \"40c0616c300567fa4d9eb4471dca82fe6207aed8b0e76b1240be64588c24c555\"\n+    },\n+    {\n+      \"bytes\": 7489,\n+      \"path\": \"f2/validation/summary.json\",\n+      \"sha256\": \"f6cf7c529788fa3f70fe4878f7c8076cf6f494d6c7e00e489897e9a6531511d0\"\n+    },\n+    {\n+      \"bytes\": 13956,\n+      \"path\": \"historical/JOINT_CONSENSUS_QUALIFICATION_V1-2bb56596.md.original\",\n+      \"sha256\": \"cd4908e6e71297dd40b76c1703f04ae3430eb80a4850ec851086a3de71ced04b\"\n+    },\n+    {\n+      \"bytes\": 10339,\n+      \"path\": \"historical/joint-consensus-qualification-v1-2bb56596.json\",\n+      \"sha256\": \"1d348836abf36a39f4a88871a8601277b9355e7e74871e4fc9e1171854606d77\"\n+    },\n+    {\n+      \"bytes\": 19966,\n+      \"path\": \"historical/joint_consensus_qualification-2bb56596.py.original\",\n+      \"sha256\": \"cdb6ab9a38fa0f944f91aee96f7ad15af4721c5891d90758d9d9f297636e9240\"\n+    },\n+    {\n+      \"bytes\": 15583,\n+      \"path\": \"historical/test_joint_consensus_qualification-2bb56596.py.original\",\n+      \"sha256\": \"84ac587d02fae45062fb6b914d50eb478c4fe1df429898cdebb24a95959f879e\"\n+    }\n+  ],\n+  \"hosted_pass\": false,\n+  \"qualification_granted\": false,\n+  \"schema\": \"fixed-joint-F2-evidence-index-v1\",\n+  \"scope\": \"F2 source review, original historical inputs and targeted validation; the original F1 index and files are unchanged.\",\n+  \"source_checkpoint\": \"2d9baf313e54e49a4507c5057578e89ddbe7a1b6\",\n+  \"source_pin_count\": 23,\n+  \"targeted_validation_input_count\": 35\n+}"},{"sha":"1356d1892b69c456a032b101d453252119fe5c92","filename":"evidence/pon-fixed-joint-source-binding-20261114/f2/README.md","status":"added","additions":30,"deletions":0,"changes":30,"blob_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/blob/5df7ae6f482157c5f7fdcbcd52222117a965053f/evidence%2Fpon-fixed-joint-source-binding-20261114%2Ff2%2FREADME.md","raw_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/raw/5df7ae6f482157c5f7fdcbcd52222117a965053f/evidence%2Fpon-fixed-joint-source-binding-20261114%2Ff2%2FREADME.md","contents_url":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/contents/evidence%2Fpon-fixed-joint-source-binding-20261114%2Ff2%2FREADME.md?ref=5df7ae6f482157c5f7fdcbcd52222117a965053f","patch":"@@ -0,0 +1,30 @@\n+# F2 joint-contract source binding\n+\n+The 23 listed inputs are reviewed against actual F1 source commit `2d9baf313e54e49a4507c5057578e89ddbe7a1b6`.\n+Four inputs differ from the historical 2bb56596 source, including the committed\n+F1 fixed-probability JSON; nineteen are unchanged. The reader's independent\n+revision and map constants change with this reviewed mapping. No probability,\n+cost, native runtime, configuration parameter, limit or qualification changes.\n+\n+The original 35 test methods remain. Exactly one method adapts its required\n+current revision and adds the old 2bb56596 revision to the rejection cases.\n+The other 34 methods are AST-identical. The old contract, reader, tests and\n+document are preserved under `../historical/`; original Linux source-mismatch\n+failures are preserved under `../original-diagnostics/`.\n+\n+`source-review/all-23-inputs-review.json` records every old and current Git OID,\n+length and SHA-256. `reviewed-source-deltas.zip` preserves all four complete\n+patches. `minimal-change-proof.json` records the exact adaptation boundary.\n+Focused validation results are recorded separately; none grants production or\n+hosted qualification.\n+\n+## Targeted validation\n+\n+All 35 retained methods passed with the recorded macOS Python command. The\n+actual production CLI returned contract_validation=PASS and HOLD_NO_GO;\n+--require-qualified exited 3 with REFUSED_UNPROVED_JOINT_CONSENSUS. Direct calls\n+to the same production reader rejected both the original historical revision\n+and the old map paired with the current revision. All 35 explicitly named\n+inputs matched before and after validation. Exact commands, raw streams and\n+scope are recorded in validation/summary.json. This is not a full Linux lane\n+or hosted qualification."},{"sha":"afdf31678c2ce6fced5a999abef1d5ac4c6d0d9d","filename":"evidence/pon-fixed-joint-source-binding-20261114/f2/source-review/all-23-inputs-review.json","status":"added","additions":439,"deletions":0,"changes":439,"blob_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/blob/5df7ae6f482157c5f7fdcbcd52222117a965053f/evidence%2Fpon-fixed-joint-source-binding-20261114%2Ff2%2Fsource-review%2Fall-23-inputs-review.json","raw_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/raw/5df7ae6f482157c5f7fdcbcd52222117a965053f/evidence%2Fpon-fixed-joint-source-binding-20261114%2Ff2%2Fsource-review%2Fall-23-inputs-review.json","contents_url":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/contents/evidence%2Fpon-fixed-joint-source-binding-20261114%2Ff2%2Fsource-review%2Fall-23-inputs-review.json?ref=5df7ae6f482157c5f7fdcbcd52222117a965053f","patch":"@@ -0,0 +1,439 @@\n+{\n+  \"H1_intersection\": [],\n+  \"changed_count\": 4,\n+  \"expected_mapping_leaf_changes\": 5,\n+  \"historical_checkpoint\": \"2bb56596e637908c44b5a2ef5984c9c37c7d3cc8\",\n+  \"independent_reader_constants_to_change\": [\n+    \"REVIEWED_NATIVE_COMMIT\",\n+    \"REVIEWED_SOURCE_MAP_SHA256\"\n+  ],\n+  \"mathematical_parameters_changed\": false,\n+  \"new_source_map_sha256\": \"5fd6aea2f2d1a6a3831853f54c8cc6e83cc8233cc61ab97a01a8e482749be674\",\n+  \"old_source_map_sha256\": \"c142b6758d90e01e1960dc5f7fb110209fa9fd40c25fca22f4010acbc085a459\",