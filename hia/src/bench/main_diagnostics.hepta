  code_limit:u64 = const() {"value":104}
  value_limit:u64 = const() {"value":127}
  code_fit:bool = compare.lt(code,code_limit)
  value_fit:bool = compare.le(value_len,value_limit)
  fit:bool = bool.and(code_fit,value_fit)
  branch fit load_row(r_i,r_o,r_s,r_n,r_cap,code,value_len) refuse()
block load_row(l_i:readbuf,l_o:mutbuf,l_s:mutbuf,l_n:u64,l_cap:u64,l_code:u64,l_vlen:u64)
