+/// Compare the actual canonical output without retaining another encoding.
+/// Validation still visits the complete value before any byte comparison. A
+/// mismatch is only a comparison result, never a canonical/wire acceptance.
+pub(crate) fn canonical_matches(v: &Value, expected: &[u8]) -> Result<bool> {
+    validate_canonical(v)?;
+    if let Some(value) = unescaped_string(v) {
+        return Ok(expected.first() == Some(&b'"')
+            && expected.last() == Some(&b'"')
+            && expected.get(1..expected.len().saturating_sub(1)) == Some(value.as_bytes()));
+    }
+    struct Compare<'a> {
+        expected: &'a [u8],
+        offset: usize,
+        equal: bool,
+    }
+    impl std::io::Write for Compare<'_> {
+        fn write(&mut self, bytes: &[u8]) -> std::io::Result<usize> {
+            let end = self.offset.saturating_add(bytes.len());
+            self.equal &= self.expected.get(self.offset..end) == Some(bytes);
+            self.offset = end;
+            Ok(bytes.len())
+        }
+        fn flush(&mut self) -> std::io::Result<()> {
+            Ok(())
+        }
+    }
+    let mut compared = Compare {
+        expected,
+        offset: 0,
+        equal: true,
+    };
+    serde_json::to_writer(&mut compared, v).map_err(|_| "NONCANONICAL")?;
+    Ok(compared.equal && compared.offset == expected.len())
+}
