te/EVIDENCE_INDEX.json","status":"added","additions":92,"deletions":0,"changes":92,"blob_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/blob/5df7ae6f482157c5f7fdcbcd52222117a965053f/docs%2Faudit%2F20261114-m4-closed-exec-gate%2FEVIDENCE_INDEX.json","raw_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/raw/5df7ae6f482157c5f7fdcbcd52222117a965053f/docs%2Faudit%2F20261114-m4-closed-exec-gate%2FEVIDENCE_INDEX.json","contents_url":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/contents/docs%2Faudit%2F20261114-m4-closed-exec-gate%2FEVIDENCE_INDEX.json?ref=5df7ae6f482157c5f7fdcbcd52222117a965053f","patch":"@@ -0,0 +1,92 @@\n+{\n+  \"schema\": \"trnm-M4-component-evidence-index-v3\",\n+  \"base\": \"1a7afcdb820b051d1e4bfde3d436f96fc050c487\",\n+  \"files\": [\n+    {\n+      \"path\": \"README.md\",\n+      \"bytes\": 3285,\n+      \"sha256\": \"85685ace94a88ae4f055eec6311effa678b47b10e2c4a2783c0e0ea5c5a1078b\"\n+    },\n+    {\n+      \"path\": \"original-failure-extract.json\",\n+      \"bytes\": 6337,\n+      \"sha256\": \"c59d9e7fcd3fb25f84199bdb066ef5f4fc563d3e2edeff0d92c761c0debf73c7\"\n+    },\n+    {\n+      \"path\": \"original-relevant-functions.json\",\n+      \"bytes\": 12788,\n+      \"sha256\": \"e6cec3f95ade7cd6da7c7777af0ce31821a0cbfa01cc9bfa22a8ca0efdea19c3\"\n+    },\n+    {\n+      \"path\": \"original-repository-truth-1a7afc-failure-v1.zip\",\n+      \"bytes\": 152665,\n+      \"sha256\": \"c67721b25a546d73b25b498c6afbeb1e6338fb267eea202403d2e167f2bf469a\"\n+    },\n+    {\n+      \"path\": \"original-run-EVIDENCE_INDEX.json\",\n+      \"bytes\": 14929,\n+      \"sha256\": \"d9be663934186c7c79b68f408841a2bc686b33a47dfba569307c3ad5f436b66e\"\n+    },\n+    {\n+      \"path\": \"original-run-copy-verification.json\",\n+      \"bytes\": 2793,\n+      \"sha256\": \"f296c259e471a0bf1fce198b36482cba809f0bb784007242803000bc9507e4c1\"\n+    },\n+    {\n+      \"path\": \"original-run-package-summary.json\",\n+      \"bytes\": 1111,\n+      \"sha256\": \"bff939e4545e35a75cb31991a4e2864c41dde622f097562901aec40be3415dcf\"\n+    },\n+    {\n+      \"path\": \"original14-source-ast-proof.json\",\n+      \"bytes\": 5423,\n+      \"sha256\": \"d383d2a4588d1c02c8e583b053a0f2671df7c5cb7aa393f874b149c9cf50581c\"\n+    },\n+    {\n+      \"path\": \"preflight-before-edit-summary.json\",\n+      \"bytes\": 835,\n+      \"sha256\": \"1ebaa4450d80a580b1f9d5513e2fddf31337d0a41254cec020820562dfa7a826\"\n+    },\n+    {\n+      \"path\": \"preflight-before-edit.stderr.raw\",\n+      \"bytes\": 253,\n+      \"sha256\": \"7aba2ef6719a8e581c9042bb0116e857656e02a73790192ddd4fc0d3f96bf2b9\"\n+    },\n+    {\n+      \"path\": \"preflight-correct-python.stderr.raw\",\n+      \"bytes\": 0,\n+      \"sha256\": \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\"\n+    },\n+    {\n+      \"path\": \"preflight-correct-python.stdout.raw\",\n+      \"bytes\": 169,\n+      \"sha256\": \"c8ca234dafb06196cc5ec4cd28e7e15562d459b828cc2953a129a510fa75ea17\"\n+    },\n+    {\n+      \"path\": \"source-and-tests-current.patch.json\",\n+      \"bytes\": 6831,\n+      \"sha256\": \"d4479ff677a44f4561b17922ae3ce5420034fe55de05997db4200f6776430c56\"\n+    },\n+    {\n+      \"path\": \"source-and-tests-initial.patch.json\",\n+      \"bytes\": 6681,\n+      \"sha256\": \"4e4f76f335dfa7a237f8f0aa07984a90234a4cb93b0e129075ed1e11455e7159\"\n+    },\n+    {\n+      \"path\": \"source-static-validation-v2.json\",\n+      \"bytes\": 1581,\n+      \"sha256\": \"4c231364a4c90bf99af5d71cb1b6a579679dcef51c7add290a8db84622234970\"\n+    },\n+    {\n+      \"path\": \"source-static-validation.json\",\n+      \"bytes\": 1392,\n+      \"sha256\": \"23096bd61d45ccfda5e169e9c142dcb45348a19c48ea16e90969ed4f4da113ea\"\n+    },\n+    {\n+      \"path\": \"staging-failure-observations.json\",\n+      \"bytes\": 2000,\n+      \"sha256\": \"1994d4d8cff284975e1c47475a6b0286fe5f26dc0a109425f16ac0d9c3a8f2ae\"\n+    }\n+  ],\n+  \"linux_execution_included\": \"original failed full lane only; no changed-source Linux run\"\n+}"},{"sha":"29770b41ad3acf4e075bbe4adb1c50caf54b651c","filename":"docs/audit/20261114-m4-closed-exec-gate/README.md","status":"added","additions":15,"deletions":0,"changes":15,"blob_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/blob/5df7ae6f482157c5f7fdcbcd52222117a965053f/docs%2Faudit%2F20261114-m4-closed-exec-gate%2FREADME.md","raw_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/raw/5df7ae6f482157c5f7fdcbcd52222117a965053f/docs%2Faudit%2F20261114-m4-closed-exec-gate%2FREADME.md","contents_url":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/contents/docs%2Faudit%2F20261114-m4-closed-exec-gate%2FREADME.md?ref=5df7ae6f482157c5f7fdcbcd52222117a965053f","patch":"@@ -0,0 +1,15 @@\n+# Closed exec gate cleanup ordering\n+\n+The original Linux repository-truth run at commit 1a7afcdb820b051d1e4bfde3d436f96fc050c487 failed the post-fork identity-error control: the collector wrapper returned 125, while the actual gated root was reaped with -15 instead of its own gate-refusal exit 125. The original suite reported 13 passes and one failure. The retained [failure extract](original-failure-extract.json) identifies the immutable complete log and exact lines; it is not a replacement for the coordinator's full raw receipt.\n+\n+Closing the gate writer makes EOF available. The child still needs scheduling to read it and exit. The parent's first cleanup pass previously sent SIGTERM immediately, so it could overtake that refusal. The fix records successful closure of the parent gate writer and defers only SIGTERM to this exact never-released root. Its original SIGKILL escalation remains at the lesser of 250 ms and half the original cleanup grace. Total cleanup grace, absolute deadline, all descendant signals, released-root signals and actual wait4 status remain unchanged. A writer close that failed does not establish the deferral condition.\n+\n+The [current exact patch carrier](source-and-tests-current.patch.json) changes only this ordering and adds two deterministic signal-boundary controls. The new controls use a fixed clock and signal recorder to force the race window and exact original escalation boundary. They are not native process execution observations. The [preservation proof](original14-source-ast-proof.json) shows all 14 original test methods retain identical source and AST.\n+\n+Only syntax compilation and preflight were performed when this component was committed. The original Linux suite, now 16 methods, and the complete repository-truth lane remain for coordinator execution. No Linux pass, resource billing, production activation or four-second confirmation result is claimed here. The first Mac preflight used an older default Python without tomllib; its failure is retained. The same original preflight succeeded using the already installed Homebrew Python, without dependency installation or source changes to the gate.\n+\n+The sole development plan and global corpus are maintained by the coordinator. This record grants no new execution, retry, payment or cleanup authority.\n+\n+The [complete original failed run](original-repository-truth-1a7afc-failure-v1.zip), [original member index](original-run-EVIDENCE_INDEX.json), [package summary](original-run-package-summary.json) and [verified copy receipt](original-run-copy-verification.json) retain the coordinator's 42-member package. It contains 39 original execution files plus the original driver, packager and index. The original failure remains a failure; this copy does not qualify the changed collector or a later full lane.\n+\n+The two new signal recorders explicitly use create=True so their logic does not depend on macOS exposing Linux pidfd_send_signal. Production requirements and all original Linux controls remain unchanged. The initial static patch is retained in a separate exact JSON carrier. The first staging check rejected unified-diff context spaces in the plain patch copy; the JSON carriers preserve its complete original bytes and SHA without weakening Git whitespace checks."},{"sha":"e826e0ab8bf8e884011830a3b0327f9b38a32d3b","filename":"docs/audit/20261114-m4-closed-exec-gate/original-failure-extract.json","status":"added","additions":98,"deletions":0,"changes":98,"blob_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/blob/5df7ae6f482157c5f7fdcbcd52222117a965053f/docs%2Faudit%2F20261114-m4-closed-exec-gate%2Foriginal-failure-extract.json","raw_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/raw/5df7ae6f482157c5f7fdcbcd52222117a965053f/docs%2Faudit%2F20261114-m4-closed-exec-gate%2Foriginal-failure-extract.json","contents_url":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/contents/docs%2Faudit%2F20261114-m4-closed-exec-gate%2Foriginal-failure-extract.json?ref=5df7ae6f482157c5f7fdcbcd52222117a965053f","patch":"@@ -0,0 +1,98 @@\n+{\n+  \"schema\": \"trnm-M4-original-lane-readonly-failure-extract-v1\",\n+  \"observed_at\": \"2026-11-14T08:36:17.968894+00:00\",\n+  \"files\": [\n+    {\n+      \"path\": \"/home/qian-qi/chain-final-consolidation-20261114-root/final-repository-truth-offline-1a7afc-v1/summary.json\",\n+      \"bytes\": 21435,\n+      \"sha256\": \"61322d80d4bb3439f2115d62b50ff3c0be42e9b10bf17f82193d5d01935a71e6\",\n+      \"total_lines\": 455,\n+      \"windows\": []\n+    },\n+    {\n+      \"path\": \"/home/qian-qi/chain-final-consolidation-20261114-root/final-repository-truth-offline-1a7afc-v1/repository-truth.stdout\",\n+      \"bytes\": 357530,\n+      \"sha256\": \"103863fcecd7456ed019a94de45fc5bc6e4e15a178db37e624a7f755b204daad\",\n+      \"total_lines\": 6143,\n+      \"windows\": [\n+        {\n+          \"first_line\": 6122,\n+          \"lines\": [\n+            \"test_actual_internal_popen_status_and_external_sibling_are_preserved (__main__.CollectorControls.test_actual_internal_popen_status_and_external_sibling_are_preserved) ... ok\",\n+            \"test_actual_original_timeout_reaps_after_root_has_exited (__main__.CollectorControls.test_actual_original_timeout_reaps_after_root_has_exited) ... ok\",\n+            \"test_actual_output_limit_is_bounded_and_fails_without_losing_root_status (__main__.CollectorControls.test_actual_output_limit_is_bounded_and_fails_without_losing_root_status) ... ok\",\n+            \"test_actual_owner_lost_is_cleaned_without_treating_successful_root_as_success (__main__.CollectorControls.test_actual_owner_lost_is_cleaned_without_treating_successful_root_as_success) ... ok\",\n+            \"test_actual_post_fork_identity_failure_reaps_gated_root_without_exec (__main__.CollectorControls.test_actual_post_fork_identity_failure_reaps_gated_root_without_exec) ... FAIL\",\n+            \"test_actual_root_signal_is_not_translated_to_success (__main__.CollectorControls.test_actual_root_signal_is_not_translated_to_success) ... ok\",\n+            \"test_original_clock_gate_and_nonlinux_never_execute_payload (__main__.CollectorControls.test_original_clock_gate_and_nonlinux_never_execute_payload) ... ok\",\n+            \"test_reader_strict_types_identity_clock_and_actual_terminal_binding (__main__.CollectorControls.test_reader_strict_types_identity_clock_and_actual_terminal_binding) ... ok\",\n+            \"test_real_pidfd_rejects_wrong_birth_and_fifo_reads_do_not_block (__main__.CollectorControls.test_real_pidfd_rejects_wrong_birth_and_fifo_reads_do_not_block) ... ok\",\n+            \"\",\n+            \"======================================================================\",\n+            \"FAIL: test_actual_post_fork_identity_failure_reaps_gated_root_without_exec (__main__.CollectorControls.test_actual_post_fork_identity_failure_reaps_gated_root_without_exec)\",\n+            \"----------------------------------------------------------------------\",\n+            \"Traceback (most recent call last):\"\n+          ]\n+        },\n+        {\n+          \"first_line\": 6129,\n+          \"lines\": [\n+            \"test_reader_strict_types_identity_clock_and_actual_terminal_binding (__main__.CollectorControls.test_reader_strict_types_identity_clock_and_actual_terminal_binding) ... ok\",\n+            \"test_real_pidfd_rejects_wrong_birth_and_fifo_reads_do_not_block (__main__.CollectorControls.test_real_pidfd_rejects_wrong_birth_and_fifo_reads_do_not_block) ... ok\",\n+            \"\",\n+            \"======================================================================\",\n+            \"FAIL: test_actual_post_fork_identity_failure_reaps_gated_root_without_exec (__main__.CollectorControls.test_actual_post_fork_identity_failure_reaps_gated_root_without_exec)\",\n+            \"----------------------------------------------------------------------\",\n+            \"Traceback (most recent call last):\",\n+            \"  File \\\"/home/qian-qi/chain-final-consolidation-20261114-root/source/scripts/test_w1_owned_process_collector_v1.py\\\", line 304, in test_actual_post_fork_identity_failure_reaps_gated_root_without_exec\",\n+            \"    self.assertEqual(result[\\\"result\\\"][\\\"root_returncode\\\"], 125)\",\n+            \"AssertionError: -15 != 125\",\n+            \"\",\n+            \"----------------------------------------------------------------------\",\n+            \"Ran 14 tests in 2.796s\",\n+            \"\"\n+          ]\n+        },\n+        {\n+          \"first_line\": 6132,\n+          \"lines\": [\n+            \"======================================================================\",\n+            \"FAIL: test_actual_post_fork_identity_failure_reaps_gated_root_without_exec (__main__.CollectorControls.test_actual_post_fork_identity_failure_reaps_gated_root_without_exec)\",\n+            \"----------------------------------------------------------------------\",\n+            \"Traceback (most recent call last):\",\n+            \"  File \\\"/home/qian-qi/chain-final-consolidation-20261114-root/source/scripts/test_w1_owned_process_collector_v1.py\\\", line 304, in test_actual_post_fork_identity_failure_reaps_gated_root_without_exec\",\n+            \"    self.assertEqual(result[\\\"result\\\"][\\\"root_returncode\\\"], 125)\",\n+            \"AssertionError: -15 != 125\",\n+            \"\",\n+            \"----------------------------------------------------------------------\",\n+            \"Ran 14 tests in 2.796s\",\n+            \"\",\n+            \"FAILED (failures=1)\"\n+          ]\n+        },\n+        {\n+          \"first_line\": 6134,\n+          \"lines\": [\n+            \"----------------------------------------------------------------------\",\n+            \"Traceback (most recent call last):\",\n+            \"  File \\\"/home/qian-qi/chain-final-consolidation-20261114-root/source/scripts/test_w1_owned_process_collector_v1.py\\\", line 304, in test_actual_post_fork_identity_failure_reaps_gated_root_without_exec\",\n+            \"    self.assertEqual(result[\\\"result\\\"][\\\"root_returncode\\\"], 125)\",\n+            \"AssertionError: -15 != 125\",\n+            \"\",\n+            \"----------------------------------------------------------------------\",\n+            \"Ran 14 tests in 2.796s\",\n+            \"\",\n+            \"FAILED (failures=1)\"\n+          ]\n+        }\n+      ]\n+    },\n+    {\n+      \"path\": \"/home/qian-qi/chain-final-consolidation-20261114-root/final-repository-truth-offline-1a7afc-v1/repository-truth.stderr\",\n+      \"bytes\": 313662,\n+      \"sha256\": \"8b7647848e125604935e9cdd7659e4c81cd7ad519cba149c0ce4cf2d4fc72edf\",\n+      \"total_lines\": 2361,\n+      \"windows\": []\n+    }\n+  ]\n+}"},{"sha":"4887874834dea9a288019125b0b8c2180b15d064","filename":"docs/audit/20261114-m4-closed-exec-gate/original-relevant-functions.json","status":"added","additions":32,"deletions":0,"changes":32,"blob_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/blob/5df7ae6f482157c5f7fdcbcd52222117a965053f/docs%2Faudit%2F20261114-m4-closed-exec-gate%2Foriginal-relevant-functions.json","raw_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/raw/5df7ae6f482157c5f7fdcbcd52222117a965053f/docs%2Faudit%2F20261114-m4-closed-exec-gate%2Foriginal-relevant-functions.json","contents_url":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/contents/docs%2Faudit%2F20261114-m4-closed-exec-gate%2Foriginal-relevant-functions.json?ref=5df7ae6f482157c5f7fdcbcd52222117a965053f","patch":"@@ -0,0 +1,32 @@\n+[\n+  {\n+    \"function\": \"main\",\n+    \"first_line\": 845,\n+    \"last_line\": 904,\n+    \"source\": \"def main(argv=None):\\n    parser = argparse.ArgumentParser(description=__doc__)\\n    parser.add_argument(\\\"--out\\\", type=Path, required=True)\\n    parser.add_argument(\\\"--deadline-monotonic-ns\\\", type=int, required=True)\\n    parser.add_argument(\\\"--deadline-boot-id\\\", required=True)\\n    parser.add_argument(\\\"--cleanup-grace-seconds\\\", type=float, default=3)\\n    parser.add_argument(\\\"--executable-sha256\\\", required=True)\\n    parser.add_argument(\\\"--cwd\\\", type=Path, required=True)\\n    parser.add_argument(\\\"--max-log-bytes\\\", type=int, default=1024 * 1024)\\n    parser.add_argument(\\\"--max-processes\\\", type=int, default=256)\\n    parser.add_argument(\\\"--env\\\", action=\\\"append\\\", default=[])\\n    parser.add_argument(\\\"command\\\", nargs=argparse.REMAINDER)\\n    args = parser.parse_args(argv)\\n    if args.command[:1] == [\\\"--\\\"]:\\n        args.command = args.command[1:]\\n    require(args.command and len(args.command) <= 512 and sum(len(x) for x in args.command) <= 65536, \\\"bounded command required\\\")\\n    require(args.out.is_absolute() and args.cwd.is_absolute() and args.cwd.is_dir(), \\\"absolute new output/cwd required\\\")\\n    require(math.isfinite(args.cleanup_grace_seconds) and .1 <= args.cleanup_grace_seconds <= 30, \\\"bounded cleanup grace required\\\")\\n    require(1024 <= args.max_log_bytes <= 16 * 1024 * 1024 and 4 <= args.max_processes <= 4096, \\\"bounded log/process limits required\\\")\\n    args.out.mkdir(parents=False, exist_ok=False)\\n    collector = None\\n    try:\\n        enable_subreaper()\\n        # This dedicated executable owns no pre-existing children or useful\\n        # inherited descriptors. Never keep caller capabilities alive in it.\\n        for value in os.listdir(\\\"/proc/self/fd\\\"):\\n            fd = int(value)\\n            if fd > 2:\\n                try:\\n                    os.close(fd)\\n                except OSError:\\n                    pass\\n        require(boot_id() == args.deadline_boot_id and time.monotonic_ns() < args.deadline_monotonic_ns,\\n                \\\"original boot/deadline mismatch; no deadline rebasing\\\")\\n        # Independent executable: discard every inherited non-stdio descriptor.\\n        for value in os.listdir(\\\"/proc/self/fd\\\"):\\n            fd = int(value)\\n            if fd > 2:\\n                try:\\n                    os.close(fd)\\n                except OSError:\\n                    pass\\n        collector = Collector(args)\\n        try:\\n            collector.launch()\\n        except BaseException as error:\\n            collector.error = f\\\"{type(error).__name__}: {error}\\\"\\n            if collector.root_pid is None:\\n                raise\\n            collector.stop(\\\"launch-error\\\")\\n        collector.loop()\\n        return collector.finish()\\n    except BaseException as error:\\n        write_new(args.out / \\\"collector-failure.json\\\", {\\\"schema\\\": SCHEMA + \\\"/failure\\\", \\\"error\\\": f\\\"{type(error).__name__}: {error}\\\",\\n                                                       \\\"collector_wait_domain_reaped\\\": False, \\\"gpu_ns\\\": None,\\n                                                       \\\"can_authorize_payment\\\": False, \\\"may_dispatch_again\\\": False})\\n        return 125\\n    finally:\\n        if collector is not None:\\n            collector.close()\"\n+  },\n+  {\n+    \"function\": \"__init__\",\n+    \"first_line\": 196,\n+    \"last_line\": 229,\n+    \"source\": \"def __init__(self, args):\\n        self.args = args\\n        self.out = args.out\\n        self.started = time.monotonic_ns()\\n        self.boot = boot_id()\\n        self.identity = process_identity(os.getpid(), self.boot)\\n        self.owner = process_identity(os.getppid(), self.boot)\\n        self.owner_fd = stable_pidfd(self.owner, self.boot)\\n        self.deadline = args.deadline_monotonic_ns\\n        self.signal_received = None\\n        self.cause = None\\n        self.error = None\\n        self.cleanup_started = None\\n        self.owned = {}\\n        self.observations = []\\n        self.reaped = []\\n        self.root = None\\n        self.root_pid = None\\n        self.root_returncode = None\\n        self.root_exec_released = False\\n        self.echild = None\\n        self.records_truncated = False\\n        self.events_count = 0\\n        self.events_bytes = 0\\n        self.events = (self.out / \\\"events.jsonl\\\").open(\\\"xb\\\")\\n        self.selector = selectors.DefaultSelector()\\n        self.streams = {}\\n        self.exec_fd = None\\n        self.before = cgroup_snapshot()\\n        self.intent_pin = None\\n        self.discovery_mode = (\\\"task-children\\\" if Path(f\\\"/proc/self/task/{os.getpid()}/children\\\").is_file()\\n                               else \\\"bounded-proc-stat-index\\\")\\n        for sig in CANCEL_SIGNALS:\\n            signal.signal(sig, self.receive_signal)\"\n+  },\n+  {\n+    \"function\": \"signal_owned\",\n+    \"first_line\": 393,\n+    \"last_line\": 406,\n+    \"source\": \"def signal_owned(self):\\n        elapsed = time.monotonic_ns() - self.cleanup_started\\n        sig = signal.SIGKILL if elapsed >= min(250_000_000, int(self.args.cleanup_grace_seconds * 500_000_000)) else signal.SIGTERM\\n        for item in list(self.owned.values()):\\n            if sig in item[\\\"signals\\\"]:\\n                continue\\n            item[\\\"signals\\\"].add(sig)\\n            try:\\n                signal.pidfd_send_signal(item[\\\"pidfd\\\"], sig)\\n                outcome = \\\"sent\\\"\\n            except ProcessLookupError:\\n                outcome = \\\"already-exited\\\"\\n            self.emit(\\\"signal\\\", {\\\"identity\\\": item[\\\"identity\\\"], \\\"signal\\\": sig, \\\"outcome\\\": outcome,\\n                                 \\\"binding\\\": \\\"retained pidfd; no kill(pid) or killpg fallback\\\"})\"\n+  },\n+  {\n+    \"function\": \"launch\",\n+    \"first_line\": 430,\n+    \"last_line\": 509,\n+    \"source\": \"def launch(self):\\n        executable = Path(self.args.command[0])\\n        require(executable.is_absolute() and not executable.is_symlink(), \\\"absolute regular ELF executable required\\\")\\n        self.exec_fd = os.open(executable, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW | os.O_NONBLOCK)\\n        info = os.fstat(self.exec_fd)\\n        require(stat.S_ISREG(info.st_mode) and os.pread(self.exec_fd, 4, 0) == b\\\"\\\\x7fELF\\\", \\\"pinned ELF required; run scripts via pinned Python\\\")\\n        require(fd_digest(self.exec_fd) == self.args.executable_sha256, \\\"executable SHA-256 mismatch\\\")\\n        self.executable_info = (info.st_dev, info.st_ino, info.st_size, info.st_mtime_ns, info.st_ctime_ns)\\n        env = {\\\"PATH\\\": \\\"/usr/bin:/bin\\\", \\\"LANG\\\": \\\"C\\\", \\\"LC_ALL\\\": \\\"C\\\", \\\"PYTHONDONTWRITEBYTECODE\\\": \\\"1\\\"}\\n        for raw in self.args.env:\\n            key, separator, value = raw.partition(\\\"=\\\")\\n            require(separator and key in {\\\"PATH\\\", \\\"LANG\\\", \\\"LC_ALL\\\", \\\"TMPDIR\\\", \\\"RAYON_NUM_THREADS\\\", \\\"RUST_LOG\\\", \\\"RISC0_HOME\\\", \\\"PYTHONDONTWRITEBYTECODE\\\"}\\n                    and \\\"\\\\x00\\\" not in value and len(value) <= 4096, \\\"explicit bounded environment key required\\\")\\n            env[key] = value\\n        intent = {\\\"schema\\\": SCHEMA + \\\"/intent\\\", \\\"collector_identity\\\": self.identity, \\\"owner_identity\\\": self.owner,\\n                  \\\"original_deadline_monotonic_ns\\\": self.deadline, \\\"original_boot_id\\\": self.boot,\\n                  \\\"started_monotonic_ns\\\": self.started,\\n                  \\\"command\\\": self.args.command, \\\"cwd\\\": str(self.args.cwd), \\\"environment\\\": env,\\n                  \\\"executable_sha256\\\": self.args.executable_sha256, \\\"executable_stat\\\": list(self.executable_info),\\n                  \\\"subreaper_readback\\\": True, \\\"initial_wait_domain_empty\\\": True,\\n                  \\\"process_discovery_mode\\\": self.discovery_mode,\\n                  \\\"max_log_bytes_per_stream\\\": self.args.max_log_bytes, \\\"max_process_records\\\": self.args.max_processes,\\n                  \\\"cleanup_grace_seconds\\\": self.args.cleanup_grace_seconds, \\\"cgroup_before\\\": self.before,\\n                  \\\"gpu_ns\\\": None, \\\"can_authorize_payment\\\": False}\\n        self.intent_pin = write_new(self.out / \\\"intent.json\\\", intent)\\n        self.emit(\\\"intent\\\", self.intent_pin)\\n        readers, writers = {}, {}\\n        for name in (\\\"stdout\\\", \\\"stderr\\\"):\\n            reader, writer = os.pipe2(os.O_CLOEXEC)\\n            readers[name], writers[name] = reader, writer\\n            os.set_blocking(reader, False)\\n            self.streams[name] = {\\\"file\\\": (self.out / (name + \\\".log\\\")).open(\\\"xb\\\"),\\n                                  \\\"seen_bytes\\\": 0, \\\"stored_bytes\\\": 0, \\\"truncated\\\": False, \\\"eof\\\": False}\\n            self.selector.register(reader, selectors.EVENT_READ, name)\\n        gate_reader, gate_writer = os.pipe2(os.O_CLOEXEC)\\n        require(time.monotonic_ns() < self.deadline and not fd_ready(self.owner_fd) and self.signal_received is None,\\n                \\\"owner/deadline/cancel pre-exec gate failed\\\")\\n        pid = os.fork()\\n        if pid == 0:\\n            try:\\n                for sig in (*CANCEL_SIGNALS, signal.SIGCHLD):\\n                    signal.signal(sig, signal.SIG_DFL)\\n                signal.signal(signal.SIGPIPE, signal.SIG_DFL)\\n                os.setsid()\\n                null = os.open(\\\"/dev/null\\\", os.O_RDONLY)\\n                os.dup2(null, 0)\\n                os.dup2(writers[\\\"stdout\\\"], 1)\\n                os.dup2(writers[\\\"stderr\\\"], 2)\\n                keep = {0, 1, 2, self.exec_fd, gate_reader}\\n                for value in os.listdir(\\\"/proc/self/fd\\\"):\\n                    fd = int(value)\\n                    if fd not in keep:\\n                        try:\\n                            os.close(fd)\\n                        except OSError:\\n                            pass\\n                if os.read(gate_reader, 1) != b\\\"G\\\":\\n                    os._exit(125)\\n                os.close(gate_reader)\\n                os.chdir(self.args.cwd)\\n                os.execve(self.exec_fd, self.args.command, env)\\n            except BaseException as error:\\n                os.write(2, (f\\\"collector exec failed: {type(error).__name__}: {error}\\\\n\\\").encode()[:4096])\\n                os._exit(126)\\n        self.root_pid = pid\\n        os.close(gate_reader)\\n        for writer in writers.values():\\n            os.close(writer)\\n        try:\\n            self.root = process_identity(pid, self.boot)\\n            self.remember(self.root, {\\\"kind\\\": \\\"fork-gated-root\\\"})\\n            self.emit(\\\"root-created\\\", self.root)\\n            if time.monotonic_ns() >= self.deadline or self.signal_received is not None or fd_ready(self.owner_fd):\\n                self.stop(\\\"pre-exec-gate-closed\\\")\\n            else:\\n                os.write(gate_writer, b\\\"G\\\")\\n                self.root_exec_released = True\\n                self.emit(\\\"root-exec-released\\\", {\\\"identity\\\": self.root})\\n        finally:\\n            os.close(gate_writer)\"\n+  },\n+  {\n+    \"function\": \"loop\",\n+    \"first_line\": 511,\n+    \"last_line\": 546,\n+    \"source\": \"def loop(self):\\n        while True:\\n            now = time.monotonic_ns()\\n            if self.signal_received is not None:\\n                self.stop(\\\"cancelled\\\")\\n            if fd_ready(self.owner_fd):\\n                self.stop(\\\"owner-lost\\\")\\n            if now >= self.deadline:\\n                self.stop(\\\"original-deadline\\\")\\n            try:\\n                done = self.reap_available()\\n                if done:\\n                    self.emit(\\\"wait-domain-empty\\\", self.echild)\\n                    break\\n                self.discover()\\n                if self.cause is not None:\\n                    self.signal_owned()\\n                self.drain(.02)\\n            except (OSError, ValueError, RuntimeError) as error:\\n                self.error = self.error or f\\\"{type(error).__name__}: {error}\\\"\\n                self.stop(\\\"collector-error\\\")\\n                # Existing pidfds remain usable even when /proc traversal fails.\\n                self.signal_owned()\\n                self.drain(.02)\\n            if self.cleanup_started is not None and time.monotonic_ns() >= self.cleanup_started + int(self.args.cleanup_grace_seconds * 1e9):\\n                self.error = self.error or \\\"cleanup grace exhausted without confirmed ECHILD\\\"\\n                break\\n        # With ECHILD the finite command tree has closed its pipe ends. Do not\\n        # block on a pipe exported to an external process: drain is bounded.\\n        for _ in range(16):\\n            self.drain(0)\\n            if all(value[\\\"eof\\\"] for value in self.streams.values()):\\n                break\\n        if not all(value[\\\"eof\\\"] for value in self.streams.values()):\\n            self.error = self.error or \\\"output EOF unavailable after bounded terminal drain\\\"\\n            self.stop(\\\"output-closure-unknown\\\")\"\n+  }\n+]"},{"sha":"f1f247d747e7d3d090b8c843cdb619fa6ca378c7","filename":"docs/audit/20261114-m4-closed-exec-gate/original-repository-truth-1a7afc-failure-v1.zip","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/blob/5df7ae6f482157c5f7fdcbcd52222117a965053f/docs%2Faudit%2F20261114-m4-closed-exec-gate%2Foriginal-repository-truth-1a7afc-failure-v1.zip","raw_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/raw/5df7ae6f482157c5f7fdcbcd52222117a965053f/docs%2Faudit%2F20261114-m4-closed-exec-gate%2Foriginal-repository-truth-1a7afc-failure-v1.zip","contents_url":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/contents/docs%2Faudit%2F20261114-m4-closed-exec-gate%2Foriginal-repository-truth-1a7afc-failure-v1.zip?ref=5df7ae6f482157c5f7fdcbcd52222117a965053f"},{"sha":"3f061f7016b9ec34d401f6121b4c372d4419fb5b","filename":"docs/audit/20261114-m4-closed-exec-gate/original-run-EVIDENCE_INDEX.json","status":"added","additions":386,"deletions":0,"changes":386,"blob_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/blob/5df7ae6f482157c5f7fdcbcd52222117a965053f/docs%2Faudit%2F20261114-m4-closed-exec-gate%2Foriginal-run-EVIDENCE_INDEX.json","raw_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/raw/5df7ae6f482157c5f7fdcbcd52222117a965053f/docs%2Faudit%2F20261114-m4-closed-exec-gate%2Foriginal-run-EVIDENCE_INDEX.json","contents_url":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/contents/docs%2Faudit%2F20261114-m4-closed-exec-gate%2Foriginal-run-EVIDENCE_INDEX.json?ref=5df7ae6f482157c5f7fdcbcd52222117a965053f","patch":"@@ -0,0 +1,386 @@\n+{\n+  \"files\": [\n+    {\n+      \"bytes\": 0,\n+     