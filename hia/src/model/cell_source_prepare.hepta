fn sp_class(v:u8) -> (u64) effects() entry(entry)
block entry(v:u8)
  upper_a:u8 = const() {"value":65}
  upper_z:u8 = const() {"value":90}
  lower_a:u8 = const() {"value":97}
  lower_z:u8 = const() {"value":122}
  digit_0:u8 = const() {"value":48}
  digit_9:u8 = const() {"value":57}
  us:u8 = const() {"value":95}
  upper0:bool = compare.ge(v,upper_a)
  upper1:bool = compare.le(v,upper_z)
  lower0:bool = compare.ge(v,lower_a)
  lower1:bool = compare.le(v,lower_z)
  digit0:bool = compare.ge(v,digit_0)
  digit1:bool = compare.le(v,digit_9)
  upper:bool = bool.and(upper0,upper1)
  lower:bool = bool.and(lower0,lower1)
  digit:bool = bool.and(digit0,digit1)
  underscore:bool = compare.eq(v,us)
  low:bool = bool.or(lower,underscore)
  z:u64 = const() {"value":0}
  one:u64 = const() {"value":1}
  two:u64 = const() {"value":2}
  three:u64 = const() {"value":3}
  d:u64 = select(digit,one,z)
  l:u64 = select(low,two,d)
  c:u64 = select(upper,three,l)
  ret(c)
end

fn sp_tokens(w:mutbuf,n:u64) -> (u64) effects(read,write,trap) entry(entry)
