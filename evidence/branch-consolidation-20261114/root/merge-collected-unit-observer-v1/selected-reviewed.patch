+        observer = fixture.Observer(UNIT)
+        argv = [sys.executable, "-B", "-c", "import time;time.sleep(10)"]
+        with patch.object(fixture, "QUERY_SECONDS", 0.1), self.assertRaises(ValueError):
+            observer.query("negative-control", argv)
