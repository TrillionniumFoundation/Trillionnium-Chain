fn tmd_value(r:readbuf,w:mutbuf,i:u64,n:u64,o:u64,t:u64) -> (u64,u64) effects(read,write,trap) entry(entry)
block entry(r:readbuf,w:mutbuf,i:u64,n:u64,o:u64,t:u64)
  room:u64 = int.sub.wrap(n,i)
  eight:u64 = const() {"value":8}
  enough:bool = compare.le(eight,room)
  branch enough read(r,w,i,n,o,t) reject()
block read(rr:readbuf,rw:mutbuf,ri:u64,rn:u64,ro:u64,rt:u64)
  eight_r:u64 = const() {"value":8}
  at:u64 = int.add.wrap(ri,eight_r)
  v:u64 = call(rr,ri) {"function":"tr_read"}
  zero:u64 = const() {"value":0}
  string:bool = compare.eq(rt,zero)
  branch string text(rr,rw,at,rn,ro,v) other(rr,rw,at,rn,ro,rt,v)
block text(tr:readbuf,tw:mutbuf,ti:u64,tn:u64,to:u64,tv:u64)
  max:u64 = const() {"value":256}
  space:u64 = int.sub.wrap(tn,ti)
  cap:bool = compare.le(tv,max)
  fits:bool = compare.le(tv,space)
  both:bool = bool.and(cap,fits)
  branch both ascii(tr,tw,ti,to,tv) reject()
block ascii(ar:readbuf,aw:mutbuf,ai:u64,ao:u64,av:u64)
  past:u64 = int.add.wrap(ai,av)
  good:bool = call(ar,ai,past) {"function":"csv_ascii"}
  branch good text_write(ar,aw,ai,past,ao) reject()
block text_write(wr:readbuf,ww:mutbuf,wi:u64,wp:u64,wo:u64)
  wrote:u64 = call(wr,ww,wo,wp,wi) {"function":"mje_string"}
  ret(wp,wrote)
block other(orr:readbuf,ow:mutbuf,oi:u64,on:u64,oo:u64,ot:u64,ov:u64)
  array:u64 = const() {"value":4}
  is_array:bool = compare.eq(ot,array)
  branch is_array pair(orr,ow,oi,on,oo,ov) scalar(ow,oi,oo,ot,ov)
block scalar(sr:mutbuf,si:u64,so:u64,st:u64,sv:u64)
  u8t:u64 = const() {"value":2}
  is_u8:bool = compare.eq(st,u8t)
  max_u8:u64 = const() {"value":255}
  overflow:bool = compare.gt(sv,max_u8)
  bad_u8:bool = bool.and(is_u8,overflow)
  branch bad_u8 reject() sign(sr,si,so,st,sv)
block sign(sw:mutbuf,sni:u64,sno:u64,snt:u64,snv:u64)
  signed:u64 = const() {"value":3}
  sign_bit:u64 = const() {"value":9223372036854775808}
  high:bool = compare.le(sign_bit,snv)
  is_signed:bool = compare.eq(snt,signed)
  neg:bool = bool.and(high,is_signed)
  branch neg negative(sw,sni,sno,snv) decimal(sw,sni,sno,snv)
block negative(nw:mutbuf,nni:u64,nno:u64,nnv:u64)
  z:u64 = const() {"value":0}
  one_n:u64 = const() {"value":1}
  minus:u64 = const() {"value":45}
  written:u64 = call(nw,nno,one_n,minus) {"function":"value_word"}
  negpos:u64 = int.add.wrap(nno,written)
  magnitude:u64 = int.sub.wrap(z,nnv)
  jump decimal(nw,nni,negpos,magnitude)
block decimal(dw:mutbuf,di:u64,do_:u64,dv:u64)
  true_d:bool = const() {"value":true}
  end_d:u64 = call(dw,do_,dv,true_d) {"function":"wa_decimal"}
  ret(di,end_d)
block pair(pr:readbuf,pw:mutbuf,pi:u64,pn:u64,po:u64,pv:u64)
  available:u64 = int.sub.wrap(pn,pi)
  stride:u64 = const() {"value":8}
  okay:bool = compare.le(stride,available)
  branch okay pair_emit(pr,pw,pi,po,pv) reject()
block pair_emit(er:readbuf,ew:mutbuf,ei:u64,eo:u64,ev:u64)
  one_e:u64 = const() {"value":1}
  eight_e:u64 = const() {"value":8}
  l:u64 = const() {"value":91}
  comma:u64 = const() {"value":44}
  rbr:u64 = const() {"value":93}
  yes:bool = const() {"value":true}
  length0:u64 = call(ew,eo,one_e,l) {"function":"value_word"}
  p0:u64 = int.add.wrap(eo,length0)
  p1:u64 = call(ew,p0,ev,yes) {"function":"wa_decimal"}
  length1:u64 = call(ew,p1,one_e,comma) {"function":"value_word"}
  p2:u64 = int.add.wrap(p1,length1)
  v2:u64 = call(er,ei) {"function":"tr_read"}
  p3:u64 = call(ew,p2,v2,yes) {"function":"wa_decimal"}
  length2:u64 = call(ew,p3,one_e,rbr) {"function":"value_word"}
  p4:u64 = int.add.wrap(p3,length2)
  next_e:u64 = int.add.wrap(ei,eight_e)
  ret(next_e,p4)
block reject()
  k:u64 = const() {"value":0}
  ret(k,k)
end
