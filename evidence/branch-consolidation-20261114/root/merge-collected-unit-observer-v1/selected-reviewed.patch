+            original_status=$?
+            trap - EXIT INT TERM
+            set +e
+            # systemd owns termination/collection. A failed create may be a foreign name.
+            # Observe only; a live or unreadable unit remains a cleanup failure.
+            /usr/bin/python3 -B "$GITHUB_WORKSPACE/scripts/ci/check_collected_unit_empty_v1.py" \
