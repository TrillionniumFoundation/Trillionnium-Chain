  first_value:i64 = select(second,mid,lo)
  third:bool = compare.gt(hi,first_value)
  result:u64 = select(third,two,first_idx)
  ret(result)
end

fn rio_emit(r:readbuf,o:mutbuf,x:u64,out:u64) -> (u64) effects(read,write,trap) entry(entry)
block entry(r:readbuf,o:mutbuf,x:u64,out:u64)
