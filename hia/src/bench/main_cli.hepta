  branch corrected_mode corrected_domain(o_wc,is_classic,fits_fanout) ordinary_domain(o_wc,is_classic,fits_fanout)
block ordinary_domain(od_o:mutbuf,od_classic:bool,od_fanout:bool)
  branch od_classic success() parity_domain(od_o,od_fanout)
block corrected_domain(cd_o:mutbuf,cd_classic:bool,cd_fanout:bool)
  branch cd_classic fail() corrected_policy(cd_o,cd_fanout)
block corrected_policy(cp_o:mutbuf,cp_fanout:bool)
  cp_at0:u64 = const() {"value":0}
  cp_at8:u64 = const() {"value":8}
  cp_at32:u64 = const() {"value":32}
  cp_at40:u64 = const() {"value":40}
  cp_at48:u64 = const() {"value":48}
  cp_at64:u64 = const() {"value":64}
  cp_n:u64 = call(cp_o,cp_at0) {"function":"bench_get"}
  cp_k:u64 = call(cp_o,cp_at8) {"function":"bench_get"}
  cp_r:u64 = call(cp_o,cp_at32) {"function":"bench_get"}
  cp_w:u64 = call(cp_o,cp_at40) {"function":"bench_get"}
  cp_kind:u64 = call(cp_o,cp_at48) {"function":"bench_get"}
  cp_strategy:u64 = call(cp_o,cp_at64) {"function":"bench_get"}
  cp_n0:u64 = const() {"value":20000}
  cp_k0:u64 = const() {"value":2000}
  cp_r0:u64 = const() {"value":3}
  cp_w0:u64 = const() {"value":1}
  cp_hot:u64 = const() {"value":2}
  cp_interleave:u64 = const() {"value":4}
  cp_n_match:bool = compare.eq(cp_n,cp_n0)
  cp_k_match:bool = compare.eq(cp_k,cp_k0)
  cp_r_match:bool = compare.eq(cp_r,cp_r0)
  cp_w_match:bool = compare.eq(cp_w,cp_w0)
  cp_dimensions:bool = bool.and(cp_n_match,cp_k_match)
  cp_accesses:bool = bool.and(cp_r_match,cp_w_match)
  cp_default:bool = bool.and(cp_dimensions,cp_accesses)
