rl":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/contents/evidence%2Fpon-fixed-joint-source-binding-20261114%2Ff2%2Fvalidation%2Fhistorical-revision-and-map-refusal.stdout?ref=5df7ae6f482157c5f7fdcbcd52222117a965053f","patch":"@@ -0,0 +1 @@\n+{\"controls\": [{\"actual_error\": \"REVIEWED_SOURCE\", \"case\": \"old-revision\", \"refused\": true}, {\"actual_error\": \"REVIEWED_SOURCE_MAP\", \"case\": \"old-map-with-current-revision\", \"refused\": true}], \"production_reader_used\": true, \"qualification_granted\": false, \"schema\": \"joint-old-revision-and-map-refusal-v1\"}"},{"sha":"95b889b44ae2ebcfa9b6973b70191c26a512edca","filename":"evidence/pon-fixed-joint-source-binding-20261114/f2/validation/old-mapping-control.py","status":"added","additions":26,"deletions":0,"changes":26,"blob_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/blob/5df7ae6f482157c5f7fdcbcd52222117a965053f/evidence%2Fpon-fixed-joint-source-binding-20261114%2Ff2%2Fvalidation%2Fold-mapping-control.py","raw_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/raw/5df7ae6f482157c5f7fdcbcd52222117a965053f/evidence%2Fpon-fixed-joint-source-binding-20261114%2Ff2%2Fvalidation%2Fold-mapping-control.py","contents_url":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/contents/evidence%2Fpon-fixed-joint-source-binding-20261114%2Ff2%2Fvalidation%2Fold-mapping-control.py?ref=5df7ae6f482157c5f7fdcbcd52222117a965053f","patch":"@@ -0,0 +1,26 @@\n+from pathlib import Path\n+import json,sys,tempfile\n+root=Path(sys.argv[1])\n+sys.path.insert(0,str(root/'formal/pon-nakamoto-v1'))\n+import joint_consensus_qualification as q\n+old=q.strict_json((root/'evidence/pon-fixed-joint-source-binding-20261114/historical/joint-consensus-qualification-v1-2bb56596.json').read_bytes())\n+out=[]\n+with tempfile.TemporaryDirectory(prefix='joint-old-map-') as directory:\n+    temp=Path(directory)\n+    paths=set(q.SOURCE_PATHS)|{q.MANIFEST}|{p for p,_ in q.OBLIGATIONS.values()}\n+    for p in paths:\n+        dest=temp/p\n+        dest.parent.mkdir(parents=True,exist_ok=True)\n+        dest.write_bytes((root/p).read_bytes())\n+    for label,code in [('old-revision','REVIEWED_SOURCE'),('old-map-with-current-revision','REVIEWED_SOURCE_MAP')]:\n+        if label=='old-map-with-current-revision':\n+            old['reviewed_native_source_commit']=q.REVIEWED_NATIVE_COMMIT\n+        (temp/q.MANIFEST).write_text(json.dumps(old))\n+        try:\n+            q.inspect(temp)\n+        except q.QualificationError as error:\n+            assert str(error)==code,(label,str(error))\n+            out.append({'case':label,'actual_error':str(error),'refused':True})\n+        else:\n+            raise AssertionError(label+' unexpectedly accepted')\n+print(json.dumps({'schema':'joint-old-revision-and-map-refusal-v1','controls':out,'production_reader_used':True,'qualification_granted':False},sort_keys=True))"},{"sha":"9b46f88d651046dc59a001928151b89d8232ba45","filename":"evidence/pon-fixed-joint-source-binding-20261114/f2/validation/original-joint-controls-35.stderr","status":"added","additions":40,"deletions":0,"changes":40,"blob_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/blob/5df7ae6f482157c5f7fdcbcd52222117a965053f/evidence%2Fpon-fixed-joint-source-binding-20261114%2Ff2%2Fvalidation%2Foriginal-joint-controls-35.stderr","raw_url":"https://github.com/TrillionniumFoundation/Trillionnium-Chain/raw/5df7ae6f482157c5f7fdcbcd52222117a965053f/evidence%2Fpon-fixed-joint-source-binding-20261114%2Ff2%2Fvalidation%2Foriginal-joint-controls-35.stderr","contents_url":"https://api.github.com/repos/TrillionniumFoundation/Trillionnium-Chain/contents/evidence%2Fpon-fixed-joint-source-binding-20261114%2Ff2%2Fvalidation%2Foriginal-joint-controls-35.stderr?ref=5df7ae6f482157c5f7fdcbcd52222117a965053f","patch":"@@ -0,0 +1,40 @@\n+test_actual_active_owner_cannot_be_created_by_json (test_joint_consensus_qualification.JointQualifi