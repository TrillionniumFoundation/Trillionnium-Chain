  valid_w:bool = compare.le(wabs,w_bound)
  m_bound:u64 = const() {"value":9223372036854775807}
  valid_m:bool = compare.le(mabs,m_bound)
  valid_gradient:bool = compare.le(gabs,vg)
  valid_mask:bool = compare.le(mask,v_one)
  m0:bool = compare.eq(m,v_zero)
  v_some:bool = compare.eq(vp,v_one)
  canonical_m:bool = bool.or(m0,v_some)
  low_gradient:u64 = bit.and(gabs,v_one)
  valid_even:bool = compare.eq(low_gradient,v_zero)
