{
  "schema": "trnm.hia.private-stack-abi.v1",
  "target": "x86_64-linux-gnu",
  "entry": "f0(readbuf, mutbuf, mutbuf) -> u32",
  "registers": ["rdi", "rsi", "rdx", "rcx", "r8", "r9"],
  "private_stack_bytes": 1048576,
  "guard_bytes_each_side": 4096,
  "mapping_bytes": 1056768,
  "prefix_bytes": 288,
  "maximum_native_image_bytes": 524288,
  "errors": {
    "mmap": "0x80001000 | errno",
    "mprotect": "0x80002000 | errno",
