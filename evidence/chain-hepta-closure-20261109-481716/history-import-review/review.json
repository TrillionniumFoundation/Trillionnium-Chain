  "new_findings": [
    {
      "id": "commit-is-full-persistence",
      "fact": "Packet commit begins after the successful BeforePersistence hook and runs through persistence, complete stored-byte/state readback, final owner/active-state fences and the transaction API. Its 9.26–9.74 s sum is not SQLite COMMIT time."
    },
    {
      "id": "unique-last-page-activation",
      "fact": "One submit_result per seven selected packets, only at history_index 6, calls activate_packet after admission using the same operation and original deadline; it spans 5.30–5.44 s."
    },
    {
      "id": "cpu-wait-is-not-all-wait",
      "fact": "Explicit CpuWait observes begin_cpu only. After full W1 verified completion, exclusive History checkpoints can sleep in observe_with_control for up to 5 ms per iteration under the original 0.25 CPU-second/second refill and deadline. These waits remain inside the surrounding admission/activation spans; current retained data does not quantify them."
    },
    {
      "id": "exclusive-owner",
      "fact": "The campaign wrapper passes Owner::Exclusive, so the shared Node mutex try_lock wait branch is not executed here. Other locks, IO waits and scheduler delays are not ruled out."
    },
    {
      "id": "existing-observability",
      "fact": "Unchanged native code already records 16 nested History stage totals and four actual Transaction::commit API sites in phase before/after snapshots. V2 omits those snapshots; their values cannot be reconstructed from V2."
    },
    {
      "id": "network-denominator",
      "fact": "0.081–0.143 s sums the seven associated Request::History protected RPC wrapper intervals (elapsed_wall_ns), including some caller-side result/request serialization, not pure network RTT. The round also runs Submit requests for seven business packets (retries allowed), then separate confirmation; this is not total round network time."
    }
  ],
