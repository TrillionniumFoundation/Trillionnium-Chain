  branch valid shape(hi,ho,hn,hf,c) bad()
block shape(si:readbuf,so:mutbuf,sn:u64,sf:u64,sc:u64)
  row:u64 = const() {"value":2192}
  bytes_:u64 = int.mul.wrap(sc,row)
