{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trillionnium.org/schemas/current-snapshot-v1.schema.json",
  "title": "TRNM Current Snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "as_of",
    "repository",
    "default_branch",
    "default_branch_head_observed",
    "latest_candidate",
    "assessed_plan_source",
    "documentation_upgrade",
    "machine_truth",
    "current_promotion_critical_stack",
    "truth_rule"
  ],
  "properties": {
    "schema": { "const": "trnm-current-snapshot-v1" },
    "as_of": { "type": "string", "format": "date" },
    "repository": { "const": "TrillionniumFoundation/Trillionnium-Chain" },
    "default_branch": { "type": "string", "minLength": 1 },
    "default_branch_head_observed": { "$ref": "#/$defs/sha40" },
    "latest_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "commit", "tree", "pull_request", "status", "checks"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "commit": { "$ref": "#/$defs/sha40" },
        "tree": { "$ref": "#/$defs/sha40" },
        "pull_request": { "type": "integer", "minimum": 1 },
        "status": { "enum": ["draft-candidate-unaccepted", "candidate-unaccepted", "tested-unaccepted", "accepted"] },
        "checks": { "type": "string", "minLength": 1 }
      }
    },
    "assessed_plan_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "commit", "tree", "authority_status"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "commit": { "$ref": "#/$defs/sha40" },
        "tree": { "$ref": "#/$defs/sha40" },
        "authority_status": { "type": "string", "minLength": 1 }
      }
    },
    "documentation_upgrade": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "base_commit", "classification"],
      "properties": {
        "branch": { "type": "string", "minLength": 1 },
        "base_commit": { "$ref": "#/$defs/sha40" },
        "classification": { "const": "subordinate-documentation-candidate" }
      }
    },
    "machine_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "consensus_mainline", "production_candidate", "production_consensus_activation", "v1_normative_freeze", "v1_node_support", "v1_release_ready"],
      "properties": {
        "stage": { "type": "string", "minLength": 1 },
        "consensus_mainline": { "const": "native-poco-bft" },
        "production_candidate": { "const": false },
        "production_consensus_activation": { "const": false },
        "v1_normative_freeze": { "const": false },
        "v1_node_support": { "const": false },
        "v1_release_ready": { "const": false }
      }
    },
    "current_promotion_critical_stack": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "truth_rule": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "sha40": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
  }
}
