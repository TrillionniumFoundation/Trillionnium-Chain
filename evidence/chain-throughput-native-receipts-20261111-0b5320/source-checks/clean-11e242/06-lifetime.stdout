riment": {"horizon": "UNSPECIFIED: no finite deployment lifetime or stopping rule is qualified; include prior preprocessing and surviving authority after retirement.", "id": "trnm-pq128-proposed-lifetime-experiment-v1", "model": "quantum-adaptive-lifetime", "profile": "pon-nakamoto-v1-pq-research-native-pnw1", "source_revision": "5ec9b4490fbfd22df4527e3b75ec74d6986572cf"}, "manifest_sha256": "053dc8c470fdffcd34951ad50fc4735629459a446993ea1eff988ddf0c1b7191", "model_arithmetic_sum": null, "note": "Exact arithmetic over declared inputs only. References, source hashes and node logs do not prove a PQ128 security claim; no unconditional bound or activation is produced.", "obligations": [{"obligation": "Prove the complete whole-chain bad-event reduction, including shared-model replacement/hybrid errors; the eight audit categories alone do not establish coverage.", "term_id": null}, {"obligation": "Independently establish applicability of each theorem to the pinned implementation and the common adaptive quantum experiment, including legal auxiliary quantum states and preprocessing.", "term_id": null}, {"obligation": "Discharge external assumptions; unmodeled implementation failures and simultaneous custodian compromise have no invented probability.", "term_id": null}, {"obligation": "Concrete quantum multi-user/multi-message forgery bound is not instantiated.", "term_id": "signature-lifetime-unqualified"}, {"obligation": "Map all key epochs, signing/verification interfaces and contextual authority entrypoints; NIST categories do not supply epsilon.", "term_id": "signature-lifetime-unqualified"}, {"obligation": "Complete per-purpose encoding, binding and actual shared-hash construction mapping is missing.", "term_id": "commitment-lifetime-unqualified"}, {"obligation": "Include preprocessing/advice, multi-target dimensions and joint model replacement; an unrestricted compressor attack is not a complete W1 forgery.", "term_id": "commitment-lifetime-unqualified"}, {"obligation": "Native PNW1 relation-to-implementation and complete input binding need independent qualification.", "term_id": "proof-lifetime-unqualified"}, {"obligation": "Any separate succinct backend needs its own exact PCS/Fiat-Shamir/recursive quantum proof; no P3 or RISC0 component estimate is imported.", "term_id": "proof-lifetime-unqualified"}, {"obligation": "Cheapest legal quantum strategy and actual resource-to-query reduction remain open.", "term_id": "ledger-lifetime-unqualified"}, {"obligation": "Specify network, resource, stopping/confirmation rule and adaptive branch history together; correct W1 evaluation is not a work-cost lower bound.", "term_id": "ledger-lifetime-unqualified"}, {"obligation": "Concrete composed KEM/authentication/session game and actual deployed interfaces are not qualified.", "term_id": "transport-lifetime-unqualified"}, {"obligation": "Include failed sessions, identity selection, replay/eclipsing and verifier-resource assumptions; do not substitute observed sessions for all adversary queries.", "term_id": "transport-lifetime-unqualified"}, {"obligation": "Full-state recovery/migration and independent monotonic witness assumptions remain unproved.", "term_id": "recovery-lifetime-unqualified"}, {"obligation": "Retain consumed effects, revoked generations and unknown-provider effects across chain reorg and full-machine rollback; no invented custody-failure probability.", "term_id": "recovery-lifetime-unqualified"}, {"obligation": "Independent root/quorum/revocation and current loaded-byte FinalUse composition are not qualified.", "term_id": "release-lifetime-unqualified"}, {"obligation": "A historical valid signature or successful download does not prove current execution authority or actual model use.", "term_id": "release-lifetime-unqualified"}, {"obligation": "Complete cross-owner refinement, independent evaluation/custody and external effect binding remain unqualified.", "term_id": "application-lifetime-unqualified"}, {"obligation": "Sep